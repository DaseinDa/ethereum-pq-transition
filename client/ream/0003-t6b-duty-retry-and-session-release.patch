+impl Drop for Inner {
+    fn drop(&mut self) { self.release_owner(); }
+}
+
+// N1 lab (2026-11-02): Engines alive in this process, so that a clean exit can release their owner files
+// even when the runtime could not be shut down and Drop never runs.
+static LIVE_ENGINES: std::sync::Mutex<Vec<std::sync::Weak<Inner>>> = std::sync::Mutex::new(Vec::new());
+
+/// Called by the binary just before `process::exit` after a clean shutdown. For each Engine still alive it
+/// takes the writer lock that the signing fence holds, keeps the lock and the Engine until the process exits,
+/// and applies Drop's rule to the owner file. An Engine whose writer is busy keeps its owner file.
+pub fn release_owned_sessions() {
+    let live = LIVE_ENGINES.lock().map(|engines| engines.clone()).unwrap_or_default();
+    for engine in live.iter().filter_map(std::sync::Weak::upgrade) {
+        // The guard is forgotten, so the writer stays locked until the process exits.
+        let locked = match engine.writer.try_lock() {
+            Ok(guard) => { std::mem::forget(guard); true }
+            Err(_) => false,
+        };
+        if locked {
+            engine.release_owner();
+            std::mem::forget(engine);
+        }
+    }
+}
+
