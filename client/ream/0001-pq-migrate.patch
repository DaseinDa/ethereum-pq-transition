+        drop(h);
+        let h = SigningHistory::open(&f.path(), [7; 32], &bindings()).unwrap();
+        assert_eq!(
+            h.sign(
+                &[2; 52],
+                0,
+                Role::Proposal,
+                101,
+                [3; 32],
+                || panic!("must not re-sign"),
+                |s| s == signature
+            )
+            .unwrap(),
+            signature
+        );
+        assert!(sign(&h, 101, 4).is_err());
+        assert!(sign(&h, 100, 3).is_err()); // chain/head rollback does not roll history back
+    }
+    #[test]
+    fn reservation_survives_failure_and_restart() {
+        let f = Fixture::new();
+        let h = create(&f);
+        assert!(
