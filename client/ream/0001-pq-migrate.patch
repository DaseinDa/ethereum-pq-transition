+        let mut changed = bindings();
+        changed[0].interval.end += 1;
+        assert!(SigningHistory::open(&f.path(), [7; 32], &changed).is_err());
+        assert!(
+            SigningHistory::create_for_fresh_public_test_keys(&f.path(), [7; 32], &bindings())
