new file mode 100644
index 0000000000000000000000000000000000000000..10f519a85871373d57d8ec21810ec9631548a6d8
--- /dev/null
+++ b/crates/common/reth/src/external.rs
@@ -0,0 +1,732 @@
+//! Experimental external Engine transport. It NEVER authorizes a signing duty.
+//!
+//! Sidecars use hash-addressed public files plus bounded peer HTTP retrieval.
+//! This is not a Lean gossip extension or a signing/readiness certificate.
+//! Missing sidecars defer import. Only no-blob payloads are supported here.
+use std::{collections::HashMap, fs, io::Write, net::IpAddr, path::PathBuf,
+    sync::{Arc, atomic::{AtomicBool, AtomicU64, Ordering}}, time::Duration};
+
+use alloy_primitives::{B256, Bytes, hex};
+use alloy_rpc_types_engine::{CancunPayloadFields, ExecutionData, ExecutionPayload,
+    ExecutionPayloadSidecar, ExecutionPayloadV3, ForkchoiceState, ForkchoiceUpdated,
+    PayloadId, PayloadStatus, PraguePayloadFields};
+use anyhow::{Context, anyhow, ensure};
+use jsonwebtoken::{EncodingKey, Header, encode};
+use reqwest::{Client, Url};
+use reth_ethereum::engine::EthPayloadAttributes;
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+use sha2::{Digest, Sha256};
+use tokio::sync::Mutex;
+
+#[derive(Clone, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct ExternalEngineConfig {
+    pub profile: String,
+    pub engine_url: String,
+    pub rpc_url: String,
+    pub jwt_path: PathBuf,
+    pub session_path: PathBuf,
+    pub materials_directory: PathBuf,
+    /// Public availability peers, never Engine endpoints or a validity oracle.
+    #[serde(default)]
+    pub material_peers: Vec<String>,
+    pub chain_id: u64,
+    pub anchor_cl_root: B256,
+    pub anchor_el_hash: B256,
+    pub anchor_state_root: B256,
+    pub timeout_seconds: u64,
+    pub exclusive_unsigned_instance: bool,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields, rename_all = "camelCase")]
+pub struct PayloadMaterials {
+    pub block_hash: B256,
+    pub parent_beacon_block_root: B256,
+    pub versioned_hashes: Vec<B256>,
+    pub execution_requests: Vec<Bytes>,
+}
+
+impl PayloadMaterials {
+    pub fn validate(&self, block_hash: B256, parent_root: B256) -> anyhow::Result<()> {
+        ensure!(self.block_hash == block_hash && self.parent_beacon_block_root == parent_root,
+            "payload material identity mismatch");
+        ensure!(self.versioned_hashes.is_empty(), "blob sidecars are unsupported");
+        let mut previous = None;
+        for request in &self.execution_requests {
+            ensure!(request.len() > 1, "empty/type-only execution request is not canonical");
+            let kind = request[0];
+            ensure!(kind <= 2 && previous.is_none_or(|p| p < kind),
+                "execution request types must be supported and strictly increasing");
+            previous = Some(kind);
+        }
+        Ok(())
+    }
+
+    pub fn sidecar(&self) -> ExecutionPayloadSidecar {
+        ExecutionPayloadSidecar::v4(CancunPayloadFields {
+            parent_beacon_block_root: self.parent_beacon_block_root,
+            versioned_hashes: self.versioned_hashes.clone(),
+        }, PraguePayloadFields::new(self.execution_requests.clone()))
+    }
+}
+
+struct Inner {
+    config: ExternalEngineConfig,
+    client: Client,
+    key: EncodingKey,
+    session_hash: [u8; 32],
+    quarantine: AtomicBool,
+    next_id: AtomicU64,
+    writer: Mutex<()>,
+    builds: Mutex<HashMap<PayloadId, (ForkchoiceState, EthPayloadAttributes)>>,
+    owner_path: PathBuf,
+    observed_instance: Mutex<Option<B256>>,
+}
+
+impl Drop for Inner {
+    fn drop(&mut self) {
+        // Preserve both blockers after uncertainty, even if writing quarantine
+        // failed. A clean completed session alone may release local ownership.
+        if !self.quarantine.load(Ordering::SeqCst)
+            && !self.config.session_path.with_extension("quarantine").exists() {
+            if fs::remove_file(&self.owner_path).is_ok() {
+                let _ = sync_parent(&self.owner_path);
+            }
+        }
+    }
+}
+
+#[derive(Clone)]
+pub struct ExternalEngine(Arc<Inner>);
+
+/// Cancellation drops futures without returning an error. Keep the session
+/// fenced whenever an RPC has not completed all response and identity checks.
+struct RpcInFlight<'a> {
+    engine: &'a ExternalEngine,
+    armed: bool,
+}
+
+impl Drop for RpcInFlight<'_> {
+    fn drop(&mut self) {
+        if self.armed { self.engine.quarantine(); }
+    }
+}
+
+impl std::fmt::Debug for ExternalEngine {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("ExternalEngine").field("signing_permitted", &false).finish()
+    }
+}
+
+pub(crate) fn endpoint(value: &str) -> anyhow::Result<Url> {
+    let url = Url::parse(value)?;
+    let address: IpAddr = url.host_str().unwrap_or("").trim_matches(['[', ']']).parse()
+        .context("literal loopback IP required")?;
+    ensure!(matches!(url.scheme(), "http" | "https") && address.is_loopback()
+        && url.port().is_some() && url.username().is_empty() && url.password().is_none()
+        && url.query().is_none() && url.fragment().is_none() && url.path() == "/",
+        "explicit loopback endpoint required");
+    Ok(url)
+}
+
+fn sync_parent(path: &std::path::Path) -> anyhow::Result<()> {
+    let parent = path.parent().ok_or_else(|| anyhow!("session file has no parent directory"))?;
+    fs::File::open(parent)?.sync_all()?;
+    Ok(())
+}
+
+fn create_session_owner(path: &std::path::Path) -> anyhow::Result<()> {
+    let mut owner = fs::OpenOptions::new().write(true).create_new(true).open(path)?;
+    owner.write_all(b"exclusive unsigned experimental Engine caller\n")?;
+    owner.sync_all()?;
+    sync_parent(path)?;
+    Ok(())
+}
+
+pub fn require_valid(status: &PayloadStatus, expected: B256) -> anyhow::Result<()> {
+    ensure!(status.is_valid() && status.latest_valid_hash == Some(expected)
+        && status.status.validation_error().is_none(), "Engine VALID/hash postcondition failed");
+    Ok(())
+}
+
+fn quarantine_on_error<T>(result: anyhow::Result<T>, quarantine: impl FnOnce()) -> anyhow::Result<T> {
+    if result.is_err() { quarantine(); }
+    result
+}
+
+fn parse_import_status(raw: Value, expected: B256) -> anyhow::Result<PayloadStatus> {
+    if raw["status"] == "VALID" {
+        ensure!(raw["validationError"].is_null(), "VALID validationError mismatch");
+    }
+    let status: PayloadStatus = serde_json::from_value(raw)?;
+    if status.is_valid() { require_valid(&status, expected)?; }
+    // INVALID is a well-formed rejection, not uncertain transport or a broken
+    // reply contract. Callers still MUST require VALID before persisting CL data.
+    Ok(status)
+}
+
+fn validate_build_envelope(envelope: Value, state: ForkchoiceState,
+    attributes: &EthPayloadAttributes) -> anyhow::Result<(ExecutionData, PayloadMaterials)> {
+    let payload: ExecutionPayloadV3 = serde_json::from_value(envelope["executionPayload"].clone())?;
+    let v1 = &payload.payload_inner.payload_inner;
+    ensure!(v1.parent_hash == state.head_block_hash && v1.timestamp == attributes.timestamp
+        && v1.prev_randao == attributes.prev_randao && v1.fee_recipient == attributes.suggested_fee_recipient
+        && Some(&payload.payload_inner.withdrawals) == attributes.withdrawals.as_ref(), "BuildContext mismatch");
+    ensure!(payload.blob_gas_used == 0 && v1.transactions.iter().all(|tx| tx.first() != Some(&3)),
+        "blob payload unsupported; excessBlobGas may remain nonzero");
+    for key in ["commitments", "proofs", "blobs"] {
+        ensure!(envelope["blobsBundle"][key].as_array().is_some_and(Vec::is_empty), "blob bundle absent/nonempty");
+    }
+    ensure!(envelope["shouldOverrideBuilder"].as_bool().is_some() && envelope["blockValue"].is_string(),
+        "incomplete getPayload envelope");
+    let material = PayloadMaterials {block_hash: v1.block_hash,
+        parent_beacon_block_root: attributes.parent_beacon_block_root.ok_or_else(|| anyhow!("parent CL root missing"))?,
+        versioned_hashes: vec![], execution_requests: serde_json::from_value(envelope["executionRequests"].clone())?};
+    material.validate(material.block_hash, material.parent_beacon_block_root)?;
+    Ok((ExecutionData::new(ExecutionPayload::V3(payload), material.sidecar()), material))
+}
+
+impl ExternalEngine {
+    pub async fn connect(config: ExternalEngineConfig) -> anyhow::Result<Self> {
+        ensure!((config.profile == "pq-migrate-external-engine-unsigned-v1" && config.exclusive_unsigned_instance)
+            || (config.profile == "pq-lean-fenced-v1" && !config.exclusive_unsigned_instance), "profile/authority mismatch");
+        ensure!(config.chain_id > 1 && (1..=60).contains(&config.timeout_seconds),
+            "mainnet/zero chain or unbounded timeout forbidden");
+        ensure!(!config.anchor_cl_root.is_zero() && !config.anchor_el_hash.is_zero()
+            && !config.anchor_state_root.is_zero(), "nonzero fixed CL/EL anchor required");
+        endpoint(&config.engine_url)?;
+        endpoint(&config.rpc_url)?;
+        ensure!(config.material_peers.len() <= 4, "at most four material peers");
+        for peer in &config.material_peers { endpoint(peer)?; }
+        let raw = fs::read_to_string(&config.jwt_path)?;
+        let secret = hex::decode(raw.trim().trim_start_matches("0x"))?;
+        ensure!(secret.len() == 32, "JWT secret must be 32 bytes");
+        let session = fs::read(&config.session_path)?;
+        ensure!(!session.is_empty() && session.len() <= 4096, "explicit session token required");
+        let marker = config.session_path.with_extension("quarantine");
+        ensure!(!marker.exists(), "session is quarantined; stop old Engine before new session");
+        let client = Client::builder().no_proxy().redirect(reqwest::redirect::Policy::none())
+            .timeout(Duration::from_secs(config.timeout_seconds)).build()?;
+        fs::create_dir_all(&config.materials_directory)?;
+        let owner_path = config.session_path.with_extension("owner");
+        // A sync failure must return before the first RPC. On uncertainty the
+        // already-synced owner is retained even if the quarantine write fails.
+        create_session_owner(&owner_path)?;
+        let this = Self(Arc::new(Inner {config, client, key: EncodingKey::from_secret(&secret),
+            session_hash: Sha256::digest(&session).into(), quarantine: AtomicBool::new(false),
+            next_id: AtomicU64::new(1), writer: Mutex::new(()), builds: Mutex::new(HashMap::new()), owner_path, observed_instance: Mutex::new(None)}));
+        let _writer = this.0.writer.lock().await;
+        let chain = this.rpc(false, "eth_chainId", json!([])).await?;
+        ensure!(chain == json!(format!("0x{:x}", this.0.config.chain_id)), "unexpected execution chain");
+        this.check_quiescent().await?;
+        let anchor = this.rpc(false, "eth_getBlockByHash", json!([this.0.config.anchor_el_hash, false])).await?;
+        ensure!(anchor.get("hash") == Some(&json!(this.0.config.anchor_el_hash))
+            && anchor.get("stateRoot") == Some(&json!(this.0.config.anchor_state_root)), "anchor unavailable/mismatched");
+        let caps = this.rpc(true, "engine_exchangeCapabilities", json!([["engine_forkchoiceUpdatedV3",
+            "engine_getPayloadV5", "engine_newPayloadV4"]])).await?;
+        for method in ["engine_forkchoiceUpdatedV3", "engine_getPayloadV5", "engine_newPayloadV4"] {
+            ensure!(caps.as_array().is_some_and(|a| a.contains(&json!(method))), "Engine tuple unavailable");
+        }
+        drop(_writer);
+        Ok(this)
+    }
+
+    pub fn anchor_el_hash(&self) -> B256 { self.0.config.anchor_el_hash }
+    pub fn is_anchor(&self, root: B256) -> bool { root == self.0.config.anchor_cl_root }
+    pub fn resolve_el_hash(&self, root: B256, claimed: B256) -> anyhow::Result<B256> {
+        if root == self.0.config.anchor_cl_root {
+            ensure!(claimed.is_zero() || claimed == self.0.config.anchor_el_hash, "anchor payload mismatch");
+            return Ok(self.0.config.anchor_el_hash);
+        }
+        ensure!(!claimed.is_zero(), "zero EL hash outside explicitly pinned CL anchor");
+        Ok(claimed)
+    }
+    pub fn signing_identity(&self) -> B256 {
+        let c=&self.0.config;let mut h=Sha256::new();h.update(b"PQ-LEAN-FENCED-v1");
+        h.update(c.chain_id.to_be_bytes());h.update(c.anchor_cl_root);h.update(c.anchor_el_hash);h.update(c.anchor_state_root);
+        B256::from_slice(&h.finalize())
+    }
+    pub fn signing_permitted(&self) -> bool { self.0.config.profile == "pq-lean-fenced-v1" && !self.0.quarantine.load(Ordering::SeqCst) }
+
+    fn check_session(&self) -> anyhow::Result<()> {
+        ensure!(!self.0.quarantine.load(Ordering::SeqCst)
+            && !self.0.config.session_path.with_extension("quarantine").exists(), "Engine session quarantined");
+        let current = fs::read(&self.0.config.session_path)?;
+        ensure!(<[u8; 32]>::from(Sha256::digest(current)) == self.0.session_hash, "Engine session identity changed");
+        Ok(())
+    }
+    fn quarantine(&self) {
+        self.0.quarantine.store(true, Ordering::SeqCst);
+        let marker = self.0.config.session_path.with_extension("quarantine");
+        let persist = || -> anyhow::Result<()> {
+            let mut file = fs::OpenOptions::new().write(true).create(true).truncate(true).open(&marker)?;
+            file.write_all(b"Stop/isolate the old Engine before a new session. Signing remains disabled.\n")?;
+            file.sync_all()?;
+            sync_parent(&marker)
+        };
+        // The atomic flag makes Inner::drop retain the owner on every failure.
+        let _ = persist();
+    }
+
+    async fn rpc(&self, auth: bool, method: &str, params: Value) -> anyhow::Result<Value> {
+        let mut flight = RpcInFlight {engine: self, armed: true};
+        let result = self.rpc_inner(auth, method, params).await;
+        if result.is_ok() { flight.armed = false; }
+        result
+    }
+    async fn rpc_inner(&self, auth: bool, method: &str, params: Value) -> anyhow::Result<Value> {
+        self.check_session()?;
+        let id = self.0.next_id.fetch_add(1, Ordering::SeqCst);
+        let url = if auth { &self.0.config.engine_url } else { &self.0.config.rpc_url };
+        let mut request = self.0.client.post(url).json(&json!({"jsonrpc":"2.0", "id":id,
+            "method":method, "params":params}));
+        if auth {
+            let token = encode(&Header::default(), &json!({"iat": jsonwebtoken::get_current_timestamp()}), &self.0.key)?;
+            request = request.bearer_auth(token);
+        }
+        let mut response = request.send().await.context("Engine HTTP outcome uncertain")?;
+        ensure!(response.status().as_u16() == 200, "Engine HTTP status rejected (body withheld)");
+        let mut body = Vec::new();
+        while let Some(chunk) = response.chunk().await? {
+            ensure!(body.len() + chunk.len() <= 16 * 1024 * 1024, "Engine response exceeds limit");
+            body.extend_from_slice(&chunk);
+        }
+        self.check_session()?;
+        let value: Value = serde_json::from_slice(&body)?;
+        let object = value.as_object().ok_or_else(|| anyhow!("non-object RPC response"))?;
+        ensure!(object.len() == 3 && value.get("jsonrpc") == Some(&json!("2.0"))
+            && value.get("id") == Some(&json!(id)) && value.get("result").is_some()
+            && value.get("error").is_none(), "RPC error or response identity mismatch (body withheld)");
+        self.check_session()?;
+        Ok(value["result"].clone())
+    }
+
+    async fn check_quiescent(&self) -> anyhow::Result<()> {
+        ensure!(self.rpc(false,"net_peerCount",json!([])).await?==json!("0x0"),"EL peers must be disabled in this local profile");
+        // A signed duty additionally holds geth's actual mutation locks. Index
+        // construction at genesis is not a chain-head authorization mechanism.
+        if !self.signing_permitted() {
+            ensure!(self.rpc(false,"eth_syncing",json!([])).await?==json!(false),"unsigned Engine is syncing");
+        }
+        Ok(())
+    }
+
+    pub async fn with_signing_fence<T>(&self,state:ForkchoiceState,sign:impl FnOnce(B256,u64)->anyhow::Result<T>) -> anyhow::Result<T> {
+        ensure!(self.signing_permitted(),"signed profile unavailable");
+        let _writer=self.0.writer.lock().await;
+        let mut flight=RpcInFlight{engine:self,armed:true};
+        let result=async {
+            self.check_session()?;
+            let mut h=Sha256::new();h.update(self.0.session_hash);
+            h.update(self.0.next_id.load(Ordering::SeqCst).to_be_bytes());
+            let request=B256::from_slice(&h.finalize());
+            let reply=self.rpc(true,"engine_pqBeginSigningV1",json!([request,state])).await?;
+            let instance=validate_applied_snapshot(&reply,request,state)?;
+            let mut previous=self.0.observed_instance.lock().await;
+            ensure!(previous.is_none_or(|id|id==instance),"EL process changed within signing session");
+            *previous=Some(instance);drop(previous);
+            let generation=u64::from_be_bytes(self.0.session_hash[..8].try_into().unwrap()).max(1);
+            // No await between authorization, fsync reservation and XMSS signing.
+            let signed=sign(request,generation);
+            let released=self.rpc(true,"engine_pqEndSigningV1",json!([instance,request])).await?;
+            ensure!(released==json!(true),"fence release not acknowledged");
+            Ok(signed)
+        }.await;
+        if result.is_ok(){flight.armed=false;}
+        quarantine_on_error(result,||self.quarantine())?
+    }
+
+    async fn read_targets(&self, state: ForkchoiceState) -> anyhow::Result<Value> {
+        let mut observed = serde_json::Map::new();
+        for (tag, expected) in [("latest", state.head_block_hash), ("safe", state.safe_block_hash),
+            ("finalized", state.finalized_block_hash)] {
+            ensure!(!expected.is_zero(), "all three targets must be explicit");
+            let block = self.rpc(false, "eth_getBlockByNumber", json!([tag, false])).await?;
+            ensure!(block.get("hash") == Some(&json!(expected)), "FCU target not observed");
+            observed.insert(tag.into(), json!({"hash": block["hash"], "number": block["number"],
+                "stateRoot": block["stateRoot"]}));
+        }
+        Ok(Value::Object(observed))
+    }
+
+    /// Quiescent diagnostic only. Not a concurrent coherent-read certificate.
+    pub async fn observe_targets(&self, state: ForkchoiceState) -> anyhow::Result<Value> {
+        let _writer = self.0.writer.lock().await;
+        let result = async {
+            self.check_quiescent().await?;
+            let observed = self.read_targets(state).await?;
+            self.check_quiescent().await?;
+            Ok(observed)
+        }.await;
+        if result.is_err() { self.quarantine(); }
+        result
+    }
+
+    pub async fn update_forkchoice(&self, state: ForkchoiceState,
+        attributes: Option<EthPayloadAttributes>) -> anyhow::Result<ForkchoiceUpdated> {
+        let _writer = self.0.writer.lock().await;
+        let result = async {
+            self.check_quiescent().await?;
+            let raw = self.rpc(true, "engine_forkchoiceUpdatedV3", json!([state, attributes])).await?;
+            ensure!(raw["payloadStatus"]["validationError"].is_null(), "VALID response has validationError");
+            let response: ForkchoiceUpdated = serde_json::from_value(raw)?;
+            require_valid(&response.payload_status, state.head_block_hash)?;
+            self.read_targets(state).await?;
+            self.check_quiescent().await?;
+            if let Some(attributes) = attributes {
+                let id = response.payload_id.ok_or_else(|| anyhow!("build FCU returned no payload ID"))?;
+                self.0.builds.lock().await.insert(id, (state, attributes));
+            }
+            Ok(response)
+        }.await;
+        if result.is_err() { self.quarantine(); }
+        result
+    }
+
+    /// One atomic geth observation. This does NOT fence later Engine/CL
+    /// mutations and MUST NOT be converted directly into a signing permit.
+    pub async fn applied_snapshot(&self, state: ForkchoiceState) -> anyhow::Result<Value> {
+        let _writer = self.0.writer.lock().await;
+        let result = async {
+            self.check_quiescent().await?;
+            let mut hasher = Sha256::new();
+            hasher.update(self.0.session_hash);
+            hasher.update(self.0.next_id.load(Ordering::SeqCst).to_be_bytes());
+            let request = B256::from_slice(&hasher.finalize());
+            let value = self.rpc(true, "engine_pqAppliedStateV1", json!([request, state])).await?;
+            let instance = validate_applied_snapshot(&value, request, state)?;
+            let mut previous = self.0.observed_instance.lock().await;
+            ensure!(previous.is_none_or(|id| id == instance),
+                "geth process changed inside the same Engine session");
+            *previous = Some(instance);
+            self.check_quiescent().await?;
+            Ok(value)
+        }.await;
+        quarantine_on_error(result, || self.quarantine())
+    }
+
+    pub fn material(&self, block_hash: B256, parent_root: B256) -> anyhow::Result<PayloadMaterials> {
+        let path = self.0.config.materials_directory.join(format!("{block_hash:x}.json"));
+        use std::io::Read;
+        let file = fs::File::open(path).context("PENDING: execution material unavailable; no empty fallback")?;
+        ensure!(file.metadata()?.is_file(), "material is not a regular file");
+        let mut raw = Vec::new();
+        file.take(2 * 1024 * 1024 + 1).read_to_end(&mut raw)?;
+        ensure!(raw.len() <= 2 * 1024 * 1024, "execution material exceeds local bound");
+        let material: PayloadMaterials = serde_json::from_slice(&raw)?;
+        material.validate(block_hash, parent_root)?;
+        Ok(material)
+    }
+    pub(crate) fn publish_material(&self, material: &PayloadMaterials) -> anyhow::Result<()> {
+        let path = self.0.config.materials_directory.join(format!("{:x}.json", material.block_hash));
+        let bytes = serde_json::to_vec(material)?;
+        if path.exists() {
+            ensure!(fs::read(path)? == bytes, "conflicting material for the same payload hash");
+            return Ok(());
+        }
+        let temporary = path.with_extension("pending");
+        let mut file = fs::OpenOptions::new().write(true).create_new(true).open(&temporary)?;
+        file.write_all(&bytes)?;
+        file.sync_all()?;
+        fs::rename(temporary, &path)?;
+        sync_parent(&path)?;
+        Ok(())
+    }
+
+    pub async fn complete_data(&self,
+        payload: &ream_execution_rpc_types::electra::execution_payload::ExecutionPayload,
+        parent_root: B256) -> anyhow::Result<ExecutionData> {
+        // Bad/missing peer data is availability failure, never an Engine-session
+        // failure, permanent CL invalidity, or permission to use empty requests.
+        if let Ok(material) = self.material(payload.block_hash, parent_root) {
+            if let Ok(data) = crate::material_transport::bind(payload, parent_root, &material) {
+                return Ok(data);
+            }
+        }
+        let (data, material) = crate::material_transport::fetch(
+            &self.0.client, &self.0.config.material_peers, payload, parent_root).await?;
+        // The complete header hash authenticates the requests bytes under the
+        // same hash assumption as the payload. Execution qualification still
+        // requires newPayloadV4 VALID and exact latestValidHash below.
+        self.publish_material(&material)?;
+        Ok(data)
+    }
+
+    pub async fn build_payload(&self, id: PayloadId) -> anyhow::Result<ExecutionData> {
+        let _writer = self.0.writer.lock().await;
+        let result = async {
+            let (state, attributes) = self.0.builds.lock().await.remove(&id)
+                .ok_or_else(|| anyhow!("payload ID has no current-session BuildContext"))?;
+            let envelope = self.rpc(true, "engine_getPayloadV5", json!([id])).await?;
+            let (data, material) = validate_build_envelope(envelope, state, &attributes)?;
+            self.publish_material(&material)?;
+            Ok(data)
+        }.await;
+        // An HTTP success is not a successful build. Context, envelope, and
+        // persistence failures must invalidate this session just like RPC failures.
+        quarantine_on_error(result, || self.quarantine())
+    }
+
+    pub async fn import_payload(&self, data: ExecutionData) -> anyhow::Result<PayloadStatus> {
+        let _writer = self.0.writer.lock().await;
+        let result = async {
+            let ExecutionPayload::V3(payload) = &data.payload else { return Err(anyhow!("only payload V3 supported")); };
+            let requests = data.sidecar.requests().ok_or_else(|| anyhow!("missing actual executionRequests bytes"))?;
+            let versions = data.sidecar.versioned_hashes().ok_or_else(|| anyhow!("missing versioned hashes"))?;
+            ensure!(versions.is_empty() && payload.blob_gas_used == 0, "blob payload unsupported");
+            let parent = data.sidecar.parent_beacon_block_root().ok_or_else(|| anyhow!("missing parent CL root"))?;
+            let raw = self.rpc(true, "engine_newPayloadV4", json!([payload, versions, parent, requests])).await?;
+            parse_import_status(raw, payload.payload_inner.payload_inner.block_hash)
+        }.await;
+        quarantine_on_error(result, || self.quarantine())
+    }
+}
+
+fn validate_applied_snapshot(value: &Value, request: B256,
+    targets: ForkchoiceState) -> anyhow::Result<B256> {
+    ensure!(value.as_object().is_some_and(|o| o.len() == 3)
+        && value["request"] == json!(request) && value["applied"] == json!(targets),
+        "applied-state response/request/targets mismatch");
+    let instance: B256 = serde_json::from_value(value["instance"].clone())?;
+    ensure!(!instance.is_zero(), "missing geth process identity");
+    Ok(instance)
+}
