+        for slot in [99, 100, 103, 104, u64::from(u32::MAX) + 1] {
+            assert!(checked_slot(slot, 0..u64::MAX, 100..104, 101..103).is_err());
+        }
+        assert_eq!(
+            checked_slot(
+                u32::MAX.into(),
+                0..(1u64 << 32),
+                0..(1u64 << 32),
+                0..(1u64 << 32)
+            )
+            .unwrap(),
+            u32::MAX
