+//! Model-level scheduler checks. The fake service never returns a signed block.
+use std::{sync::{Arc,atomic::{AtomicUsize,Ordering}},time::{SystemTime,UNIX_EPOCH}};
+use ream_chain_lean::{messages::{LeanChainServiceMessage,ServiceResponse,PendingDutyRecomputation},signer::ProposalSigner};
+use ream_network_spec::networks::{LeanNetworkSpec,set_lean_network_spec};
+use ream_validator_lean::service::build_block;
+use tokio::sync::mpsc;
+
+async fn refused_case(slot:u64,kind:u8)->usize {
+ let(tx,mut rx)=mpsc::unbounded_channel();let count=Arc::new(AtomicUsize::new(0));let seen=count.clone();
+ let server=tokio::spawn(async move {
+  while let Some(message)=rx.recv().await {
+   match message {
+    LeanChainServiceMessage::ProduceSignedBlock{sender,..}=>{
+     seen.fetch_add(1,Ordering::SeqCst);
+     let error=match kind {
+      0=>anyhow::Error::new(PendingDutyRecomputation),
+      1=>anyhow::anyhow!("uncertain Engine result"),
+      _=>anyhow::anyhow!("attestation signing boundary failed: {}",PendingDutyRecomputation),
+     };
+     let _=sender.send(ServiceResponse::Err(error));
+    },
+    _=>panic!("a refusal must not publish a block"),
+   }
+  }
+ });
+ build_block(tx,slot,0,Arc::new(ProposalSigner::new(vec![]))).await;
+ server.await.unwrap();count.load(Ordering::SeqCst)
+}
+
+#[tokio::test]
+async fn retry_only_typed_presigning_deferral_and_never_past_the_bound_or_slot() {
+ let now=SystemTime::now().duration_since(UNIX_EPOCH).unwrap().as_secs();
+ let mut spec=LeanNetworkSpec::default();spec.genesis_time=now-600;spec.seconds_per_slot=60;spec.num_validators=1;set_lean_network_spec(Arc::new(spec));
+ assert_eq!(refused_case(10,0).await,3,"a persistent scheduling deferral has a finite request bound");
+ assert_eq!(refused_case(10,1).await,1,"uncertain Engine failures are not retried");
+ assert_eq!(refused_case(10,2).await,1,"a partly signed boundary cannot expose retryability");
+ assert_eq!(refused_case(9,0).await,1,"expired duties are not retried");
+}
