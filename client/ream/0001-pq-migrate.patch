new file mode 100644
index 0000000000000000000000000000000000000000..b39f189be8631cd8ad1fb98a08b33b1d36956736
--- /dev/null
+++ b/crates/common/reth/examples/external_probe.rs
@@ -0,0 +1,80 @@
+//! Real two-Engine probe, no Lean signing/validation/finality claim.
+//! Usage: external_probe CONFIG_A CONFIG_B PAYLOAD_ATTRIBUTES_JSON
+use std::{fs, path::PathBuf};
+use alloy_primitives::B256;
+use alloy_rpc_types_engine::{ExecutionPayload, ForkchoiceState};
+use anyhow::{Context, ensure};
+use ream_reth_engine::external::{ExternalEngine, ExternalEngineConfig, require_valid};
+use reth_ethereum::engine::EthPayloadAttributes;
+use serde_json::json;
+
+#[tokio::main]
+async fn main() -> anyhow::Result<()> {
+    let paths: Vec<PathBuf> = std::env::args_os().skip(1).map(PathBuf::from).collect();
+    ensure!(paths.len() == 3, "expected CONFIG_A CONFIG_B PAYLOAD_ATTRIBUTES_JSON");
+    let a_config: ExternalEngineConfig = serde_json::from_slice(&fs::read(&paths[0])?)?;
+    let b_config: ExternalEngineConfig = serde_json::from_slice(&fs::read(&paths[1])?)?;
+    ensure!(a_config.anchor_el_hash == b_config.anchor_el_hash
+        && a_config.anchor_cl_root == b_config.anchor_cl_root
+        && a_config.anchor_state_root == b_config.anchor_state_root
+        && a_config.engine_url != b_config.engine_url && a_config.rpc_url != b_config.rpc_url,
+        "two independent endpoints must share explicit anchors");
+    let anchor = a_config.anchor_el_hash;
+    let attributes: EthPayloadAttributes = serde_json::from_slice(&fs::read(&paths[2])?)?;
+    ensure!(attributes.parent_beacon_block_root == Some(a_config.anchor_cl_root), "context root differs from pinned CL anchor");
+    let a = ExternalEngine::connect(a_config).await.context("connect A")?;
+    let b = ExternalEngine::connect(b_config).await.context("connect B")?;
+    let parent = ForkchoiceState {head_block_hash: anchor, safe_block_hash: anchor, finalized_block_hash: anchor};
+    b.update_forkchoice(parent, None).await.context("B parent FCU")?;
+    let build = a.update_forkchoice(parent, Some(attributes)).await.context("A build FCU")?;
+    let data = a.build_payload(build.payload_id.context("missing payload ID")?).await?;
+    ensure!(data.transaction_count() == 0, "this probe allows no user transactions");
+    let child = data.block_hash();
+    let requests = data.sidecar.requests().context("execution requests bytes missing")?;
+    let request_bytes = serde_json::to_value(requests)?;
+    let mut bad_data = data.clone();
+    let ExecutionPayload::V3(bad_payload) = &mut bad_data.payload else {
+        anyhow::bail!("probe requires payload V3")
+    };
+    let changed_root = B256::repeat_byte(0xfa);
+    ensure!(bad_payload.payload_inner.payload_inner.state_root != changed_root,
+        "negative control must change state root");
+    bad_payload.payload_inner.payload_inner.state_root = changed_root;
+    ensure!(bad_data.block_hash() == child, "negative control must retain original block hash");
+    let b_bad_status = b.import_payload(bad_data).await.context("B bad state-root control")?;
+    ensure!(b_bad_status.is_invalid(), "B must explicitly reject changed state root with original hash");
+    let b_bad_observation = b.observe_targets(parent).await.context("B rejection must retain parent")?;
+    let a_status = a.import_payload(data.clone()).await.context("A newPayload")?;
+    // Reconstruct on B through its configured public HTTP peer. The original
+    // in-memory A sidecar is not passed into B's production conversion path.
+    let payload = ream_reth_engine::payload::to_ream_execution_payload(&data)?;
+    let from_peer = b.complete_data(&payload, data.parent_beacon_block_root().context("parent root")?).await?;
+    ensure!(serde_json::to_value(&from_peer)? == serde_json::to_value(&data)?, "B peer transport changed the complete execution data");
+    let b_status = b.import_payload(from_peer).await.context("B independent newPayload")?;
+    require_valid(&a_status, child)?;
+    require_valid(&b_status, child)?;
+    let a_import_observation = a.observe_targets(parent).await.context("A import must not select head")?;
+    let b_import_observation = b.observe_targets(parent).await.context("B import must not select head")?;
+    let target = ForkchoiceState {head_block_hash: child, safe_block_hash: anchor, finalized_block_hash: anchor};
+    let a_fcu = a.update_forkchoice(target, None).await.context("A child FCU and readback")?;
+    let b_fcu = b.update_forkchoice(target, None).await.context("B child FCU and readback")?;
+    let a_selected = a.observe_targets(target).await?;
+    let b_selected = b.observe_targets(target).await?;
+    let a_applied = a.applied_snapshot(target).await?;
+    let b_applied = b.applied_snapshot(target).await?;
+    ensure!(a_applied["instance"] != b_applied["instance"], "nodes must be different processes");
+    println!("{}", serde_json::to_string_pretty(&json!({
+
+        "scope":"real Rust Engine adapter, two unsigned geth endpoints; no Lean import or consensus finality",
+        "status":"PASS", "anchor":anchor, "child":child, "executionRequests":request_bytes,
+        "badStateRootB":b_bad_status, "afterBadStateRootB":b_bad_observation,
+        "newPayloadA":a_status, "newPayloadB":b_status, "fcuA":a_fcu, "fcuB":b_fcu,
+        "afterImportA":a_import_observation, "afterImportB":b_import_observation,
+        "selectedA":a_selected, "selectedB":b_selected,
+        "coherentAppliedA":a_applied, "coherentAppliedB":b_applied,
+        "materialTransport":"B fetched public sidecar from A HTTP endpoint; complete header bound before Engine import",
+        "signingPermittedA":a.signing_permitted(), "signingPermittedB":b.signing_permitted(),
+        "readback":"serialized local caller under operator-enforced quiescence, not atomic concurrent snapshot"
+    }))?);
+    Ok(())
+}
