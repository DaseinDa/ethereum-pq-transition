+//! Durable local XMSS consumption authority, independent of chain databases.
+//! This does not detect restoration of an older copy of the entire authority.
+//! Recovery must establish history continuity before opening this signer.
+use std::{
+    collections::{BTreeMap, BTreeSet},
+    fs::{File, OpenOptions},
+    io::{Read, Seek, SeekFrom, Write},
+    ops::Range,
+    path::Path,
+    sync::Mutex,
+};
+
+const MAGIC: &[u8] = b"PQ-REAM-SIGNER-v1\n";
+const MAX_BYTES: u64 = 64 * 1024 * 1024;
+const SIGNATURE_BYTES: usize = 2536;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Role {
+    Attestation = 0,
+    Proposal = 1,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Binding {
+    pub public_key: [u8; 52],
+    pub validator_index: u64,
+    pub role: Role,
+    // A finite local operating bound, not a replacement consensus schedule.
+    pub interval: Range<u64>,
+}
+
+#[derive(Debug)]
+pub struct HistoryError(pub String);
+
+impl std::fmt::Display for HistoryError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "{}", self.0)
+    }
+}
+impl std::error::Error for HistoryError {}
+impl From<std::io::Error> for HistoryError {
+    fn from(value: std::io::Error) -> Self {
+        Self(value.to_string())
+    }
+}
+
+type Result<T> = std::result::Result<T, HistoryError>;
+fn reject(message: &str) -> HistoryError {
+    HistoryError(message.to_owned())
+}
+
+pub fn checked_slot(
+    slot: u64,
+    activation: Range<u64>,
+    prepared: Range<u64>,
+    local: Range<u64>,
+) -> Result<u32> {
+    let epoch = u32::try_from(slot).map_err(|_| reject("slot exceeds uint32"))?;
+    if !activation.contains(&slot) || !prepared.contains(&slot) || !local.contains(&slot) {
+        return Err(reject("slot outside activation/prepared/local interval"));
+    }
+    Ok(epoch)
+}
+
+fn header(network: [u8; 32], bindings: &[Binding]) -> Result<Vec<u8>> {
+    if network == [0; 32] || bindings.is_empty() || bindings.len() > 64 {
+        return Err(reject(
+            "nonzero network identity and 1..64 role keys required",
+        ));
+    }
+    let mut keys = BTreeSet::new();
+    let mut roles = BTreeSet::new();
+    let mut bytes = MAGIC.to_vec();
+    bytes.extend_from_slice(&network);
+    bytes.extend_from_slice(&(bindings.len() as u32).to_le_bytes());
+    for b in bindings {
+        if b.interval.start >= b.interval.end
+            || b.interval.end > u64::from(u32::MAX) + 1
+            || b.public_key == [0; 52]
+            || !keys.insert(b.public_key)
+            || !roles.insert((b.validator_index, b.role as u8))
+        {
+            return Err(reject("duplicate/invalid role key or local interval"));
+        }
+        bytes.extend_from_slice(&b.public_key);
+        bytes.extend_from_slice(&b.validator_index.to_le_bytes());
+        bytes.push(b.role as u8);
+        bytes.extend_from_slice(&b.interval.start.to_le_bytes());
+        bytes.extend_from_slice(&b.interval.end.to_le_bytes());
+    }
+    // Require both roles for each enrolled validator. Public key identity is
+    // unique across roles and validators; changing labels cannot reset a key.
+    if roles
+        .iter()
+        .any(|(index, role)| !roles.contains(&(*index, 1 - *role)))
+    {
+        return Err(reject(
+            "validator must have distinct attestation and proposal keys",
+        ));
+    }
+    Ok(bytes)
+}
+
+#[derive(Clone)]
+struct Entry {
+    root: [u8; 32],
+    signature: Option<Vec<u8>>,
+}
+struct State {
+    file: File, // lifetime-exclusive lock, also excludes another process
+    entries: BTreeMap<(u32, u32), Entry>,
+    high_water: BTreeMap<u32, u32>,
+    poisoned: bool,
+}
+pub struct SigningHistory {
+    bindings: Vec<Binding>,
+    state: Mutex<State>,
+}
+
+impl SigningHistory {
+    /// Read-only preflight for fresh provisioning. This runs the same header
+    /// checks as creation, before callers reserve any key-directory guards.
+    /// It does not establish key freshness or authorize history recreation.
+    pub fn validate_bindings(network: [u8; 32], bindings: &[Binding]) -> Result<()> {
+        header(network, bindings).map(|_| ())
+    }
+
+    /// Only the fresh synthetic-key provisioning path may call this. Never
+    /// call it after importing a seed/key, after a reorg, or after history loss.
+    /// The file is create_new and a missing parent is not silently created.
+    pub fn create_for_fresh_public_test_keys(
+        path: &Path,
+        network: [u8; 32],
+        bindings: &[Binding],
+    ) -> Result<Self> {
+        Self::create_new_authority(path, network, bindings)
+    }
+
+    /// Isolated unit-test authority for already public, previously used fixture
+    /// keys. This proves local adapter behavior, NOT safe enrollment or key
+    /// history continuity. This entry point is absent from production builds.
+    #[cfg(test)]
+    pub(crate) fn create_for_public_fixture_component_only(
+        path: &Path,
+        network: [u8; 32],
+        bindings: &[Binding],
+    ) -> Result<Self> {
+        Self::create_new_authority(path, network, bindings)
+    }
+
+    fn create_new_authority(path: &Path, network: [u8; 32], bindings: &[Binding]) -> Result<Self> {
+        let data = header(network, bindings)?;
+        let mut options = OpenOptions::new();
+        options.read(true).write(true).create_new(true);
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::OpenOptionsExt;
+            options.mode(0o600);
+        }
+        let mut file = options.open(path)?;
+        file.try_lock()
+            .map_err(|e| reject(&format!("history lock unavailable: {e}")))?;
+        file.write_all(&data)?;
+        file.sync_all()?;
+        // Persist the new directory entry before this authority can sign.
+        File::open(
+            path.parent()
+                .ok_or_else(|| reject("history needs parent"))?,
+        )?
+        .sync_all()?;
+        Ok(Self {
+            bindings: bindings.to_vec(),
+            state: Mutex::new(State {
+                file,
+                entries: BTreeMap::new(),
+                high_water: BTreeMap::new(),
+                poisoned: false,
+            }),
+        })
+    }
+
+    /// No create flag: missing history stops signing. The caller must separately
+    /// establish that this is the latest authority; a stale complete copy is
+    /// indistinguishable locally and is not authorized merely by this method.
+    pub fn open(path: &Path, network: [u8; 32], bindings: &[Binding]) -> Result<Self> {
+        let expected = header(network, bindings)?;
+        let mut file = OpenOptions::new().read(true).write(true).open(path)?;
+        file.try_lock()
+            .map_err(|e| reject(&format!("history lock unavailable: {e}")))?;
+        let metadata = file.metadata()?;
+        if !metadata.is_file() || metadata.len() > MAX_BYTES {
+            return Err(reject("invalid or oversized history file"));
+        }
+        let mut bytes = Vec::new();
+        file.read_to_end(&mut bytes)?;
+        if !bytes.starts_with(&expected) {
+            return Err(reject("history network/key/role/interval identity differs"));
+        }
+        let mut state = State {
+            file,
+            entries: BTreeMap::new(),
+            high_water: BTreeMap::new(),
+            poisoned: false,
+        };
+        let mut position = expected.len();
+        while position < bytes.len() {
+            // kind + binding + slot + root + length; truncation always refuses.
+            if bytes.len() - position < 45 {
+                return Err(reject("partial history record; recovery required"));
+            }
+            let kind = bytes[position];
+            let index = u32::from_le_bytes(bytes[position + 1..position + 5].try_into().unwrap());
+            let slot = u32::from_le_bytes(bytes[position + 5..position + 9].try_into().unwrap());
+            let root: [u8; 32] = bytes[position + 9..position + 41].try_into().unwrap();
+            let size = u32::from_le_bytes(bytes[position + 41..position + 45].try_into().unwrap())
+                as usize;
+            position += 45;
+            let binding = bindings
+                .get(index as usize)
+                .ok_or_else(|| reject("invalid binding in history"))?;
+            if !binding.interval.contains(&u64::from(slot))
+                || size > SIGNATURE_BYTES
+                || bytes.len() - position < size
+            {
+                return Err(reject("invalid history record interval/size"));
+            }
+            match kind {
+                1 if size == 0 => {
+                    if state.entries.contains_key(&(index, slot))
+                        || state
+                            .high_water
+                            .get(&index)
+                            .is_some_and(|last| slot <= *last)
+                    {
+                        return Err(reject("duplicate/nonmonotone reservation in history"));
+                    }
+                    state.entries.insert(
+                        (index, slot),
+                        Entry {
+                            root,
+                            signature: None,
+                        },
+                    );
+                    state.high_water.insert(index, slot);
+                }
+                2 if size == SIGNATURE_BYTES => {
+                    let entry = state
+                        .entries
+                        .get_mut(&(index, slot))
+                        .ok_or_else(|| reject("signature without reservation"))?;
+                    if entry.root != root || entry.signature.is_some() {
+                        return Err(reject("signature differs from reservation"));
+                    }
+                    entry.signature = Some(bytes[position..position + size].to_vec());
+                }
+                _ => return Err(reject("invalid history record kind/length")),
+            }
+            position += size;
+        }
+        Ok(Self {
+            bindings: bindings.to_vec(),
+            state: Mutex::new(state),
+        })
+    }
+
+    pub fn binding(&self, public_key: &[u8; 52], validator: u64, role: Role) -> Result<&Binding> {
+        self.bindings
+            .iter()
+            .find(|b| {
+                b.public_key == *public_key && b.validator_index == validator && b.role == role
+            })
+            .ok_or_else(|| reject("key/validator/role not enrolled in history"))
+    }
+
+    /// The unchanged cryptographic signer is invoked only after reservation is
+    /// durable. Both new and cached signatures are verified before release.
+    /// The caller must already hold a matching, live Engine readiness permit.
+    pub fn sign<S, V>(
+        &self,
+        public_key: &[u8; 52],
+        validator: u64,
+        role: Role,
+        slot: u32,
+        root: [u8; 32],
+        sign: S,
+        verify: V,
+    ) -> Result<Vec<u8>>
+    where
+        S: FnOnce() -> Result<Vec<u8>>,
+        V: Fn(&[u8]) -> bool,
+    {
+        let binding = self.binding(public_key, validator, role)?;
+        if !binding.interval.contains(&u64::from(slot)) {
+            return Err(reject("slot outside enrolled operating interval"));
+        }
+        let index = self
+            .bindings
+            .iter()
+            .position(|b| b.public_key == *public_key)
+            .unwrap() as u32;
+        let mut state = self
+            .state
+            .lock()
+            .map_err(|_| reject("history mutex poisoned"))?;
+        if state.poisoned {
+            return Err(reject("history I/O uncertain; recovery required"));
+        }
+        if let Some(entry) = state.entries.get(&(index, slot)) {
+            if entry.root != root {
+                return Err(reject("different root for consumed key/slot"));
+            }
+            let signature = entry
+                .signature
+                .as_ref()
+                .ok_or_else(|| reject("reserved slot has no durable signature; do not re-sign"))?;
+            if !verify(signature) {
+                return Err(reject("cached signature verification failed"));
+            }
+            return Ok(signature.clone());
+        }
+        if state
+            .high_water
+            .get(&index)
+            .is_some_and(|last| slot <= *last)
+        {
+            return Err(reject("slot precedes signing high-water mark"));
+        }
+        append(&mut state, 1, index, slot, root, &[])?;
+        state.entries.insert(
+            (index, slot),
+            Entry {
+                root,
+                signature: None,
+            },
+        );
+        state.high_water.insert(index, slot);
+        let signature = sign()?; // failure leaves reservation consumed
+        if signature.len() != SIGNATURE_BYTES || !verify(&signature) {
+            return Err(reject("new signature verification failed; slot consumed"));
+        }
+        append(&mut state, 2, index, slot, root, &signature)?;
+        state.entries.get_mut(&(index, slot)).unwrap().signature = Some(signature.clone());
+        Ok(signature)
+    }
+}
+
+fn append(
+    state: &mut State,
+    kind: u8,
+    index: u32,
+    slot: u32,
+    root: [u8; 32],
+    signature: &[u8],
+) -> Result<()> {
+    let mut bytes = vec![kind];
+    bytes.extend_from_slice(&index.to_le_bytes());
+    bytes.extend_from_slice(&slot.to_le_bytes());
+    bytes.extend_from_slice(&root);
+    bytes.extend_from_slice(&(signature.len() as u32).to_le_bytes());
+    bytes.extend_from_slice(signature);
+    // Any I/O failure disables further signing in this process. A truncated
+    // record disables restart; a complete reservation remains burned.
+    state.poisoned = true;
+    if state.file.metadata()?.len() + bytes.len() as u64 > MAX_BYTES {
+        return Err(reject("finite signing-history capacity reached"));
+    }
+    state.file.seek(SeekFrom::End(0))?;
+    state.file.write_all(&bytes)?;
+    state.file.sync_all()?;
+    state.poisoned = false;
+    Ok(())
+}
