+    /// A local HTTP component fixture. It reads the complete request body, then
+    /// either replies or deliberately withholds its response. It is not geth.
+    fn local_rpc_fixture(response: Option<Value>) -> (String, tokio::sync::oneshot::Receiver<()>,
+        std::sync::mpsc::Sender<()>, std::thread::JoinHandle<()>) {
+        use std::io::Read;
+        let listener = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
+        let url = format!("http://{}/", listener.local_addr().unwrap());
+        let (received_tx, received_rx) = tokio::sync::oneshot::channel();
+        let (release_tx, release_rx) = std::sync::mpsc::channel();
+        let server = std::thread::spawn(move || {
+            let (mut socket, _) = listener.accept().unwrap();
+            socket.set_read_timeout(Some(Duration::from_secs(5))).unwrap();
+            let mut bytes = Vec::new();
+            loop {
+                let mut buffer = [0; 1024];
+                let count = socket.read(&mut buffer).unwrap();
+                assert!(count > 0);
+                bytes.extend_from_slice(&buffer[..count]);
+                assert!(bytes.len() < 65536);
+                if let Some(end) = bytes.windows(4).position(|part| part == b"\r\n\r\n") {
+                    let headers = String::from_utf8_lossy(&bytes[..end]).to_ascii_lowercase();
+                    let length: usize = headers.lines().find_map(|line| line.strip_prefix("content-length:"))
+                        .unwrap().trim().parse().unwrap();
+                    if bytes.len() >= end + 4 + length { break; }
+                }
+            }
+            received_tx.send(()).unwrap();
+            if let Some(result) = response {
+                let body = serde_json::to_vec(&json!({"jsonrpc":"2.0", "id":1, "result":result})).unwrap();
+                write!(socket, "HTTP/1.1 200 OK\r\nContent-Length: {}\r\nContent-Type: application/json\r\nConnection: close\r\n\r\n", body.len()).unwrap();
+                socket.write_all(&body).unwrap();
+            } else {
+                let _ = release_rx.recv_timeout(Duration::from_secs(5));
+            }
+        });
+        (url, received_rx, release_tx, server)
+    }
+
+    #[tokio::test]
+    async fn external_rpc_cancelled_after_send_quarantines_session() {
+        let (url, received, release, server) = local_rpc_fixture(None);
+        let (fixture, engine) = RpcFixture::engine(url);
+        let caller = engine.clone();
+        let task = tokio::spawn(async move {
+            caller.rpc(true, "engine_forkchoiceUpdatedV3", json!([{}, null])).await
+        });
+        tokio::time::timeout(Duration::from_secs(5), received).await.unwrap().unwrap();
+        task.abort();
+        assert!(task.await.unwrap_err().is_cancelled());
+        assert!(engine.check_session().is_err());
+        assert!(fixture.session.with_extension("quarantine").is_file());
+        drop(engine);
+        assert!(fixture.owner.is_file(), "dropping uncertain session must retain its owner blocker");
+        release.send(()).unwrap();
+        server.join().unwrap();
+    }
+
+    #[tokio::test]
+    async fn external_rpc_complete_invalid_reply_keeps_session_usable() {
+        let (url, received, _release, server) = local_rpc_fixture(Some(json!({"status":"INVALID",
+            "latestValidHash":null, "validationError":"component negative control"})));
+        let (fixture, engine) = RpcFixture::engine(url);
+        let raw = engine.rpc(true, "engine_newPayloadV4", json!([])).await.unwrap();
+        received.await.unwrap();
+        assert!(parse_import_status(raw, B256::repeat_byte(1)).unwrap().is_invalid());
+        assert!(engine.check_session().is_ok());
+        assert!(!fixture.session.with_extension("quarantine").exists());
+        drop(engine);
+        assert!(!fixture.owner.exists(), "clean completed session may release local ownership");
+        server.join().unwrap();
+    }
+
+    #[test]
+    fn external_quarantine_write_failure_retains_synced_owner() {
+        let (fixture, engine) = RpcFixture::engine("http://127.0.0.1:8551/".into());
+        // A directory at this path forces marker-file creation to fail.
+        fs::create_dir(fixture.session.with_extension("quarantine")).unwrap();
+        engine.quarantine();
+        assert!(engine.0.quarantine.load(Ordering::SeqCst));
+        drop(engine);
+        assert!(fixture.owner.is_file());
+    }
+}
