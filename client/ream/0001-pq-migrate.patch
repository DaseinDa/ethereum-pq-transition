+//! Verify public signing-history records without loading any private key.
+use std::{fs,collections::BTreeMap};
+use anyhow::{ensure,Result};
+use ream_post_quantum_crypto::leansig::{public_key::PublicKey,signature::Signature};
+use alloy_primitives::FixedBytes;
+fn main()->Result<()> {
+ let args:Vec<_>=std::env::args().collect();let b=fs::read(&args[1])?;let magic=b"PQ-REAM-SIGNER-v1\n";
+ ensure!(b.starts_with(magic),"history magic");let mut pos=magic.len()+32;
+ let count=u32::from_le_bytes(b[pos..pos+4].try_into()?) as usize;pos+=4;ensure!(count<=64,"binding count");
+ let mut keys=vec![];
+ for _ in 0..count {keys.push(PublicKey::new(FixedBytes::from_slice(&b[pos..pos+52])));pos+=77;}
+ let mut seen=BTreeMap::new();let mut high=BTreeMap::new();let mut signatures=0;let mut rows=vec![];
+ while pos<b.len(){
+  ensure!(b.len()-pos>=45,"truncated record");let kind=b[pos];
+  let key=u32::from_le_bytes(b[pos+1..pos+5].try_into()?);let slot=u32::from_le_bytes(b[pos+5..pos+9].try_into()?);
+  let root:[u8;32]=b[pos+9..pos+41].try_into()?;let len=u32::from_le_bytes(b[pos+41..pos+45].try_into()?) as usize;pos+=45;
+  ensure!((key as usize)<keys.len() && pos+len<=b.len(),"record bounds");
+  if kind==1 {ensure!(len==0 && !seen.contains_key(&(key,slot)),"duplicate reservation");ensure!(high.get(&key).is_none_or(|last|slot>*last),"index rollback");high.insert(key,slot);seen.insert((key,slot),(root,false));}
+  else {ensure!(kind==2 && len==2536,"signature kind/size");let entry=seen.get_mut(&(key,slot)).ok_or_else(||anyhow::anyhow!("signature lacks durable reservation"))?;ensure!(entry.0==root && !entry.1,"conflicting/duplicate signature");let sig=Signature::from(&b[pos..pos+len]);ensure!(sig.verify(&keys[key as usize],slot,&root)?,"XMSS verification");let mut wrong=root;wrong[0]^=1;ensure!(!sig.verify(&keys[key as usize],slot,&wrong)?,"modified root accepted");entry.1=true;signatures+=1;}
+  rows.push(serde_json::json!({"kind":kind,"key":key,"slot":slot,"root":format!("{}",alloy_primitives::B256::from(root))}));pos+=len;
+ }
