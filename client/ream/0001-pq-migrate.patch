diff --git a/crates/common/chain/lean/examples/export_signed.rs b/crates/common/chain/lean/examples/export_signed.rs
new file mode 100644
index 0000000000000000000000000000000000000000..ad2261b864b45f7886160343d1c675b2cc869c23
--- /dev/null
+++ b/crates/common/chain/lean/examples/export_signed.rs
@@ -0,0 +1,34 @@
+//! Run only on a COPY of stopped public experiment databases.
+use std::{fs,path::PathBuf};
+use anyhow::{ensure,Result};
+use ream_storage::{db::ReamDB,tables::{field::REDBField,table::REDBTable}};
+use ssz::Encode;
+use tree_hash::TreeHash;
+fn main()->Result<()> {
+ let a:Vec<_>=std::env::args().collect();let input=PathBuf::from(&a[1]);ensure!(input.is_dir(),"existing database copy required");let out=PathBuf::from(&a[2]);fs::create_dir(&out)?;
+ let db=ReamDB::new(input)?.init_lean_db()?;let mut records=vec![];
+ // The children index is pruned at finalization. Scan stored blocks so the
+ // finalized migration-bearing envelopes are exported too.
+ for block in db.block_provider().get_all_blocks(0)? {
+  let root=block.block.tree_hash_root();
+  ensure!(db.block_provider().get(root)?.is_some_and(|stored|stored==block),"stored block root mismatch");
+  let qualified=db.execution_qualified(root)?;
+  if block.block.slot>0 {let parent=db.state_provider().get(block.block.parent_root)?.ok_or_else(||anyhow::anyhow!("parent state missing"))?;ensure!(block.verify_signatures(&parent,true)?,"Type2 envelope rejected");ensure!(qualified,"exported non-genesis block lacks EL qualification");}
+  let name=format!("{}",root);fs::write(out.join(format!("{name}.ssz")),block.as_ssz_bytes())?;fs::write(out.join(format!("{name}.json")),serde_json::to_vec_pretty(&block)?)?;
+  records.push(serde_json::json!({"root":root,"slot":block.block.slot,"qualified":qualified,"envelopeVerified":block.block.slot>0,"bytes":block.as_ssz_bytes().len()}));
+ }
+ let head=db.head_provider().get()?;let state=db.state_provider().get(head)?.ok_or_else(||anyhow::anyhow!("head state missing"))?;
+ let mut cache=vec![];
+ for (key,proofs) in db.latest_known_aggregated_payloads_provider().iter()? {
+  for proof in proofs {
+   let keys=proof.to_validator_indices().iter().map(|i|state.validators[*i as usize].attestation_public_key.clone()).collect::<Vec<_>>();
+   let valid=ream_post_quantum_crypto::lean_multisig::type_2::type_1_from_wire(&proof.proof,&keys).and_then(|p|{
+    let data=db.attestation_data_by_root_provider().get(key.data_root)?.ok_or_else(||anyhow::anyhow!("cached proof has no data"))?;
+    ensure!(p.info.without_pubkeys.message==key.data_root.0 && p.info.without_pubkeys.slot==u32::try_from(data.slot)?,"cached proof message/epoch mismatch");
+    ream_post_quantum_crypto::lean_multisig::type_2::type_1_verify(&p)
+   });
+   cache.push(serde_json::json!({"dataRoot":key.data_root,"validator":key.validator_id,"bytes":proof.proof.len(),"verification":valid.map(|_|"PASS".to_string()).unwrap_or_else(|e|e.to_string())}));
+  }
+ }
+ let summary=serde_json::json!({"head":head,"finalized":db.latest_finalized_provider().get()?,"blocks":records,"cachedProofs":cache});fs::write(out.join("index.json"),serde_json::to_vec_pretty(&summary)?)?;println!("{}",summary);Ok(())
+}
diff --git a/crates/common/chain/lean/examples/profile_tool.rs b/crates/common/chain/lean/examples/profile_tool.rs
new file mode 100644
index 0000000000000000000000000000000000000000..4832dd3d03177590e9db27b89243d5114728bf35
--- /dev/null
+++ b/crates/common/chain/lean/examples/profile_tool.rs
@@ -0,0 +1,39 @@
+use std::{fs,path::PathBuf,sync::Arc};
+use alloy_primitives::B256;
+use ream_chain_lean::{signer::ProposalSigner,signing_history::SigningHistory};
+use ream_keystore::lean_keystore::ValidatorKeystore;
+use ream_consensus_lean::validator::Validator;
+use ream_post_quantum_crypto::leansig::{private_key::PrivateKey,public_key::PublicKey};
+use tree_hash::TreeHash;
+fn main()->anyhow::Result<()> {
+ let args:Vec<_>=std::env::args().collect();let keydir=PathBuf::from(&args[2]);
+ let read_pub=|role:&str|->anyhow::Result<PublicKey>{Ok(PublicKey::new(alloy_primitives::FixedBytes::from_slice(&fs::read(keydir.join(format!("{role}.pub")))?)))};
+ let ap=read_pub("attestation")?;let pp=read_pub("proposal")?;
+ match args[1].as_str() {
+  "peer"=>{
+   let pair=libp2p_identity::secp256k1::Keypair::generate();
+   let key=B256::from_slice(&pair.secret().to_bytes());
+   let mut f=fs::OpenOptions::new().write(true).create_new(true).open(&args[3])?;
+   use std::io::Write;write!(f,"{:x}",key)?;f.sync_all()?;
+   println!("{}",libp2p_identity::Keypair::from(pair).public().to_peer_id());
+  },
+  "genesis"=>{
+   let time:u64=args[3].parse()?;
+   let(block,state)=ream_fork_choice_lean::genesis::setup_genesis(time,vec![Validator{index:0,attestation_public_key:ap,proposal_public_key:pp}]);
+   println!("{}",serde_json::json!({"clRoot":block.tree_hash_root(),"clStateRoot":state.tree_hash_root(),"genesisTime":time}));
+  },
+  "history"=>{
+   let path=PathBuf::from(&args[3]);let network:B256=args[4].parse()?;
+   // Provisioning is explicit, once for this fresh public key pair. Never called
+   // at validator startup, after a restart, or after loss of history.
+   let _guard=fs::OpenOptions::new().create_new(true).write(true).open(keydir.join("history-provisioned-once"))?;
+   let keys=vec![Arc::new(ValidatorKeystore{index:0,attestation_public_key:ap,proposal_public_key:pp,
+    attestation_private_key:PrivateKey::from_bytes(&fs::read(keydir.join("attestation.ssz"))?)?,
+    proposal_private_key:PrivateKey::from_bytes(&fs::read(keydir.join("proposal.ssz"))?)?})];
+   let bindings=ProposalSigner::bindings(&keys,0..4096)?;
+   let _history=SigningHistory::create_for_fresh_public_test_keys(&path,network.0,&bindings)?;
+   println!("fresh authority created");
+  },_=>anyhow::bail!("genesis or history subcommand required")
+ }
+ Ok(())
+}
