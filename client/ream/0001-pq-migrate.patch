new file mode 100644
index 0000000000000000000000000000000000000000..bde95238765593a6ad834d1fc931a5209e3a719f
--- /dev/null
+++ b/crates/common/chain/lean/tests/qualification.rs
@@ -0,0 +1,38 @@
+//! Model-level regressions for refusing incomplete execution state and for
+//! preserving persisted pointers. Synthetic blocks here are NOT accepted blocks.
+use alloy_primitives::B256;
+use ream_consensus_lean::{attestation::AttestationData,checkpoint::Checkpoint};
+use ream_fork_choice_lean::store::Store;
+use ream_storage::tables::{field::REDBField,table::REDBTable};
+use tree_hash::TreeHash;
+
+#[tokio::test]
+async fn missing_execution_backend_cannot_authorize_any_vote_dependency() {
+ let store=ream_test_utils::store::sample_store(1).await;
+ let root=store.store.lock().await.head_provider().get().unwrap();
+ let data=AttestationData{slot:1,head:Checkpoint{root,slot:0},source:Checkpoint{root,slot:0},target:Checkpoint{root,slot:0}};
+ assert!(store.require_execution_eligible(root).await.is_err());
+ assert!(store.require_vote_eligible(&data).await.is_err());
+ let mut overflow=data;overflow.slot=u64::from(u32::MAX)+1;
+ assert!(store.require_vote_eligible(&overflow).await.unwrap_err().to_string().contains("XMSS"));
+}
+
+#[tokio::test]
+async fn restart_preserves_head_and_rejects_changed_genesis() {
+ let store=ream_test_utils::store::sample_store(1).await;
+ let db=store.store.lock().await.clone();
+ let root=db.head_provider().get().unwrap();
+ let anchor=db.block_provider().get(root).unwrap().unwrap();
+ let state=db.state_provider().get(root).unwrap().unwrap();
+ let mut later=anchor.clone();later.block.slot=2;later.block.parent_root=root;
+ let later_root=later.block.tree_hash_root();
+ db.block_provider().insert(later_root,later).unwrap();
+ db.state_provider().insert(later_root,state.clone()).unwrap();
+ db.head_provider().insert(later_root).unwrap();
+ let restored=Store::get_forkchoice_store(anchor.clone(),state.clone(),db.clone(),None,None).unwrap();
+ assert_eq!(restored.store.lock().await.head_provider().get().unwrap(),later_root);
+ assert_eq!(restored.store.lock().await.latest_finalized_provider().get().unwrap().root,root);
+ assert!(restored.require_execution_eligible(later_root).await.is_err(),"a persisted block without EL qualification is not permission");
+ let mut changed=anchor;changed.block.state_root=B256::repeat_byte(9);
+ assert!(Store::get_forkchoice_store(changed,state,db,None,None).is_err());
+}
