index 0000000000000000000000000000000000000000..6c4a1d0350c30e1e0ad0317363d998fe7fd7c984
--- /dev/null
+++ b/crates/common/chain/lean/src/coordinator.rs
@@ -0,0 +1,105 @@
+//! Serialized live duties. No permit leaves the store writer/EL-fence scope.
+use super::*;
+use anyhow::ensure;
+use crate::signer::{ReadinessBinding, SigningPermit};
+use crate::signing_history::Role;
+
+impl LeanChainService {
+    fn check_duty(&self, slot:u64) -> anyhow::Result<()> {
+        ensure!(self.sync_status == SyncStatus::Synced && !self.duties_paused,
+            "sync/recovery revokes signing readiness");
+        ensure!(slot > 0 && get_current_slot()==slot, "duty slot is not current");
+        // A queued event may require recomputing fork choice. Do not sign first.
+        if !self.receiver.is_empty(){return Err(crate::messages::PendingDutyRecomputation.into());}
+        Ok(())
+    }
+
+    pub(super) async fn coordinated_proposal(&mut self, slot:u64) -> anyhow::Result<SignedBlock> {
+        self.check_duty(slot)?;
+        let signer=self.signer.clone().ok_or_else(||anyhow!("signer authority absent"))?;
+        let handle=self.reth_handle.clone().ok_or_else(||anyhow!("external Engine absent"))?;
+        ensure!(handle.signing_permitted(), "fenced profile required");
+        ensure!(handle.signing_identity()==Some(signer.network_identity()),"signer history is bound to another CL/EL profile");
+        let spec=lean_network_spec();
+        let proposer=slot % spec.num_validators;
+        ensure!(signer.has_validator(proposer),"not local proposer");
+        // Background sync and aggregation also require this writer. They cannot
+        // revise the selected state between building and durable reservation.
+        let mut store=self.store.write().await;
+        let parent=store.get_proposal_head(slot).await?;
+        let finalized=store.store.lock().await.latest_finalized_provider().get()?.root;
+        let targets=store.execution_targets(parent,finalized).await?;
+        let attrs=build_payload_attributes(slot,parent,spec.genesis_time,spec.seconds_per_slot);
+        let answer=handle.update_forkchoice(targets,Some(attrs.clone())).await?;
+        let payload_id=answer.payload_id.ok_or_else(||anyhow!("build has no payload id"))?;
+        // getPayload resolves AND stops geth's builder. An immediate call can
+        // choose its prebuilt empty payload while valid pool work is in flight.
+        // This bounded local scheduling window is not an execution certificate.
+        // Parent, slot, queued events and applied targets are all rechecked below.
+        let build_window=Duration::from_millis(spec.seconds_per_slot.saturating_mul(100).min(1000));
+        tokio::time::sleep(build_window).await;
+        self.check_duty(slot)?;
+        let execution=handle.build_payload(payload_id).await?;
+        let payload=to_ream_execution_payload(&execution)?;
+        ensure!(payload.parent_hash==targets.head_block_hash && payload.timestamp==attrs.timestamp,
+            "payload escaped immutable build context");
+        let candidate=store.produce_block_with_signatures_with_payload(slot,proposer,payload).await?;
+        ensure!(candidate.block.parent_root==parent,"proposal parent changed after build");
+        store.require_execution_eligible(parent).await?;
+        for a in &candidate.block.body.attestations {store.require_vote_eligible(&a.message).await?;}
+        let mut parent_state=store.store.lock().await.state_provider().get(parent)?
+            .ok_or_else(||anyhow!("parent state missing"))?;
+        parent_state.state_transition(&candidate.block,true)?;
+        let status=handle.import_payload(execution).await?;
+        ream_reth_engine::external::require_valid(&status,candidate.block.body.execution_payload.block_hash)?;
+        let current=store.store.lock().await.head_provider().get()?;
+        ensure!(current==parent,"selected head changed during build");
+        self.check_duty(slot)?;
+        let root=candidate.block.tree_hash_root();
+        let revision=self.duty_revision;
+        let signed=handle.with_signing_fence(targets, |request,generation| {
+            self.check_duty(slot)?;
+            let mut permit=SigningPermit::authorized(ReadinessBinding {
+                network_identity:signer.network_identity(),generation,revision,
+                request_id:request,role:Role::Proposal,validator_index:proposer,slot,message_root:root,
+            });
+            Ok(signer.sign_with_permit(&mut permit)?)
+        }).await?;
+        tracing::info!(slot,proposer,?root,?parent,revision,?payload_id,"COORDINATED_XMSS_PROPOSAL_RESERVED");
+        drop(store);
+        // The XMSS resource is already consumed. A failed/late aggregation must
+        // never release it. Ordinary ingress verifies the resulting Type-2 proof.
+        tokio::task::spawn_blocking(move || crate::assemble::assemble_signed_block(signed,proposer,candidate,slot))
+            .await.map_err(|e|anyhow!("aggregate worker failed: {e}"))?
+    }
+
+    pub(super) async fn coordinated_attestations(&mut self,slot:u64) -> anyhow::Result<Vec<SignedAttestation>> {
+        self.check_duty(slot)?;
+        let signer=self.signer.clone().ok_or_else(||anyhow!("signer authority absent"))?;
+        let handle=self.reth_handle.clone().ok_or_else(||anyhow!("external Engine absent"))?;
+        ensure!(handle.signing_permitted(),"fenced profile required");
+        ensure!(handle.signing_identity()==Some(signer.network_identity()),"signer history is bound to another CL/EL profile");
+        let store=self.store.write().await;
+        store.update_head().await?;
+        let data=store.produce_attestation_data(slot).await?;
+        store.require_vote_eligible(&data).await?;
+        let finalized=store.store.lock().await.latest_finalized_provider().get()?.root;
+        let targets=store.execution_targets(data.head.root,finalized).await?;
+        let root=data.tree_hash_root();let revision=self.duty_revision;
+        handle.with_signing_fence(targets,|request,generation| {
+            self.check_duty(slot)?;
+            let mut output=Vec::new();
+            for index in signer.validator_indices() {
+                self.check_duty(slot)?;
+                let mut permit=SigningPermit::authorized(ReadinessBinding {
+                    network_identity:signer.network_identity(),generation,revision,
+                    request_id:request,role:Role::Attestation,validator_index:index,slot,message_root:root,
+                });
+                let signature=signer.sign_with_permit(&mut permit)?.signature;
+                output.push(SignedAttestation{validator_id:index,message:data.clone(),signature});
+            }
+            tracing::info!(slot,?root,revision,count=output.len(),"COORDINATED_XMSS_ATTESTATIONS_RESERVED");
+            Ok(output)
+        }).await.map_err(|e|anyhow!("attestation signing boundary failed: {e:#}"))
+    }
+}
