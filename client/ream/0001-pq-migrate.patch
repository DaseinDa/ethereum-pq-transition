diff --git a/crates/common/chain/lean/src/signer.rs b/crates/common/chain/lean/src/signer.rs
new file mode 100644
index 0000000000000000000000000000000000000000..98614350590ae4881faa461652e853c85cc0e1f3
--- /dev/null
+++ b/crates/common/chain/lean/src/signer.rs
@@ -0,0 +1,432 @@
+use std::{
+    ops::Range,
+    path::{Path, PathBuf},
+    sync::Arc,
+};
+
+use alloy_primitives::B256;
+use ream_keystore::lean_keystore::ValidatorKeystore;
+use ream_post_quantum_crypto::leansig::{
+    private_key::PrivateKey, public_key::PublicKey, signature::Signature,
+};
+use serde::Deserialize;
+
+use crate::signing_history::{Binding, HistoryError, Role, SigningHistory, checked_slot};
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct ProposalSignature {
+    pub public_key: PublicKey,
+    pub signature: Signature,
+    pub epoch: u32,
+}
+
+#[derive(Debug, thiserror::Error)]
+pub enum ProposalSignerError {
+    #[error("key for validator {validator_index} was not found")]
+    ValidatorNotFound { validator_index: u64 },
+    #[error("slot {slot} cannot be represented as an XMSS epoch")]
+    SlotOverflow { slot: u64 },
+    #[error(
+        "slot {slot} outside validator {validator_index}'s activation interval {activation_start}..{activation_end}"
+    )]
+    SlotOutsideActivationInterval {
+        validator_index: u64,
+        slot: u64,
+        activation_start: u64,
+        activation_end: u64,
+    },
+    #[error("no live serialized Engine/CL readiness permit; signing disabled")]
+    ReadinessUnavailable,
+    #[error("attestation data slot differs from the authorized slot")]
+    AttestationSlotMismatch,
+    #[error("signing refused: {0}")]
+    Safety(String),
+}
+
+impl ProposalSignerError {
+    pub fn code(&self) -> &'static str {
+        match self {
+            Self::ValidatorNotFound { .. } => "validator_not_found",
+            Self::SlotOverflow { .. } => "slot_overflow",
+            Self::SlotOutsideActivationInterval { .. } => "slot_outside_activation_interval",
+            Self::ReadinessUnavailable => "readiness_unavailable",
+            Self::AttestationSlotMismatch => "attestation_slot_mismatch",
+            Self::Safety(_) => "signer_safety_refused",
+        }
+    }
+}
+impl From<HistoryError> for ProposalSignerError {
+    fn from(value: HistoryError) -> Self {
+        Self::Safety(value.0)
+    }
+}
+
+/// Exact requested operation. These fields alone confer no signing authority.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct ReadinessBinding {
+    pub network_identity: B256,
+    pub generation: u64,
+    pub revision: u64,
+    pub request_id: B256,
+    pub role: Role,
+    pub validator_index: u64,
+    pub slot: u64,
+    pub message_root: B256,
+}
+
+/// Not constructible from JSON, an environment boolean or an Engine status.
+/// Construction is private to the chain crate. The coordinator holds the CL
+/// writer and the geth mutation fence through durable reservation and signing.
+/// Arbitrary RPC roots and the legacy public methods cannot create a permit.
+pub struct SigningPermit {
+    binding: ReadinessBinding,
+    consumed: bool,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct RuntimeConfig {
+    format: u32,
+    network_identity: B256,
+    history: PathBuf,
+    start_slot: u64,
+    end_slot: u64,
+}
+
+pub struct ProposalSigner {
+    keystores: Vec<Arc<ValidatorKeystore>>,
+    history: Option<SigningHistory>,
+    network_identity: B256,
+}
+
+impl SigningPermit {
+    // Only the chain crate's serialized coordinator can create this capability.
+    pub(crate) fn authorized(binding: ReadinessBinding) -> Self { Self { binding, consumed: false } }
+}
+impl ProposalSigner {
+    pub fn network_identity(&self) -> B256 { self.network_identity }
+
+    /// An unconfigured observer can inspect duties, but cannot sign.
+    pub fn new(keystores: Vec<Arc<ValidatorKeystore>>) -> Self {
+        Self {
+            keystores,
+            history: None,
+            network_identity: B256::ZERO,
+        }
+    }
+
+    pub fn from_runtime_config(
+        keystores: Vec<Arc<ValidatorKeystore>>,
+        path: &Path,
+    ) -> anyhow::Result<Self> {
+        if !path.is_absolute() {
+            anyhow::bail!("signer config path must be absolute");
+        }
+        let config: RuntimeConfig = serde_json::from_slice(&std::fs::read(path)?)?;
+        if config.format != 1
+            || config.network_identity == B256::ZERO
+            || !config.history.is_absolute()
+        {
+            anyhow::bail!("invalid explicit signer history configuration");
+        }
+        let bindings = Self::bindings(&keystores, config.start_slot..config.end_slot)?;
+        let history = SigningHistory::open(&config.history, config.network_identity.0, &bindings)?;
+        Ok(Self {
+            keystores,
+            history: Some(history),
+            network_identity: config.network_identity,
+        })
+    }
+
+    /// Used by separately authorized fresh PUBLIC synthetic-key provisioning.
+    /// No key generation, enrollment or history recreation occurs at startup.
+    pub fn bindings(
+        keystores: &[Arc<ValidatorKeystore>],
+        local: Range<u64>,
+    ) -> anyhow::Result<Vec<Binding>> {
+        if local.start >= local.end || local.end > (1u64 << 32) {
+            anyhow::bail!("invalid local signing interval");
+        }
+        let mut bindings = Vec::new();
+        for key in keystores {
+            for (role, public, private) in [
+                (
+                    Role::Attestation,
+                    key.attestation_public_key,
+                    &key.attestation_private_key,
+                ),
+                (
+                    Role::Proposal,
+                    key.proposal_public_key,
+                    &key.proposal_private_key,
+                ),
+            ] {
+                let active = private.get_activation_interval();
+                let prepared = private.get_prepared_interval();
+                if local.start < active.start
+                    || local.end > active.end
+                    || local.start < prepared.start
+                    || local.end > prepared.end
+                {
+                    anyhow::bail!(
+                        "explicit local interval exceeds actual ordinary key activation/preparation"
+                    );
+                }
+                bindings.push(Binding {
+                    public_key: public.inner.0,
+                    validator_index: key.index,
+                    role,
+                    interval: local.clone(),
+                });
+            }
+        }
+        Ok(bindings)
+    }
+
+    pub fn first_validator_index(&self) -> Option<u64> {
+        self.keystores.first().map(|key| key.index)
+    }
+    pub fn validator_indices(&self) -> impl Iterator<Item = u64> + '_ {
+        self.keystores.iter().map(|key| key.index)
+    }
+    pub fn keystores(&self) -> &[Arc<ValidatorKeystore>] {
+        &self.keystores
+    }
+    pub fn has_validator(&self, index: u64) -> bool {
+        self.keystore(index).is_some()
+    }
+
+    /// Kept as the shared production/test-driver boundary. An arbitrary root
+    /// from an RPC request is not itself permission to spend a one-time key.
+    pub fn sign_proposal(
+        &self,
+        validator_index: u64,
+        slot: u64,
+        block_root: &B256,
+    ) -> Result<ProposalSignature, ProposalSignerError> {
+        self.sign_role(validator_index, slot, block_root, Role::Proposal, None)
+    }
+    pub fn sign_attestation(
+        &self,
+        validator_index: u64,
+        slot: u64,
+        data_slot: u64,
+        message_root: &B256,
+    ) -> Result<ProposalSignature, ProposalSignerError> {
+        if slot != data_slot {
+            return Err(ProposalSignerError::AttestationSlotMismatch);
+        }
+        self.sign_role(validator_index, slot, message_root, Role::Attestation, None)
+    }
+
+    pub fn sign_with_permit(
+        &self,
+        permit: &mut SigningPermit,
+    ) -> Result<ProposalSignature, ProposalSignerError> {
+        let requested = permit.binding.clone();
+        self.sign_role(
+            requested.validator_index,
+            requested.slot,
+            &requested.message_root,
+            requested.role,
+            Some(permit),
+        )
+    }
+
+    fn sign_role(
+        &self,
+        validator_index: u64,
+        slot: u64,
+        root: &B256,
+        role: Role,
+        permit: Option<&mut SigningPermit>,
+    ) -> Result<ProposalSignature, ProposalSignerError> {
+        let key = self
+            .keystore(validator_index)
+            .ok_or(ProposalSignerError::ValidatorNotFound { validator_index })?;
+        let (public, private): (PublicKey, &PrivateKey) = match role {
+            Role::Proposal => (key.proposal_public_key, &key.proposal_private_key),
+            Role::Attestation => (key.attestation_public_key, &key.attestation_private_key),
+        };
+        let epoch = u32::try_from(slot).map_err(|_| ProposalSignerError::SlotOverflow { slot })?;
+        let active = private.get_activation_interval();
+        if !active.contains(&slot) {
+            return Err(ProposalSignerError::SlotOutsideActivationInterval {
+                validator_index,
+                slot,
+                activation_start: active.start,
+                activation_end: active.end,
+            });
+        }
+        let permit = permit.ok_or(ProposalSignerError::ReadinessUnavailable)?;
+        if permit.consumed
+            || permit.binding.network_identity != self.network_identity
+            || permit.binding.generation == 0
+            || permit.binding.revision == 0
+            || permit.binding.request_id == B256::ZERO
+            || permit.binding.role != role
+            || permit.binding.validator_index != validator_index
+            || permit.binding.slot != slot
+            || permit.binding.message_root != *root
+        {
+            return Err(ProposalSignerError::ReadinessUnavailable);
+        }
+        permit.consumed = true;
+        let history = self
+            .history
+            .as_ref()
+            .ok_or_else(|| ProposalSignerError::Safety("history unavailable".into()))?;
+        let binding = history.binding(&public.inner.0, validator_index, role)?;
+        checked_slot(
+            slot,
+            active,
+            private.get_prepared_interval(),
+            binding.interval.clone(),
+        )?;
+        let bytes = history.sign(
+            &public.inner.0,
+            validator_index,
+            role,
+            epoch,
+            root.0,
+            || {
+                private
+                    .sign(root, epoch)
+                    .map(|signature| signature.inner.to_vec())
+                    .map_err(|err| HistoryError(err.to_string()))
+            },
+            |bytes| {
+                Signature::from(bytes)
+                    .verify(&public, epoch, &root.0)
+                    .unwrap_or(false)
+            },
+        )?;
+        Ok(ProposalSignature {
+            public_key: public,
+            signature: Signature::from(bytes.as_slice()),
+            epoch,
+        })
+    }
+
+    fn keystore(&self, index: u64) -> Option<&ValidatorKeystore> {
+        self.keystores
+            .iter()
+            .find(|key| key.index == index)
+            .map(AsRef::as_ref)
+    }
+}
