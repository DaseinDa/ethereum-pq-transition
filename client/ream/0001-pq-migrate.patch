diff --git a/crates/common/chain/lean/examples/profile_tool_three.rs b/crates/common/chain/lean/examples/profile_tool_three.rs
new file mode 100644
index 0000000000000000000000000000000000000000..3a685d11bd4ea13abceca7edd88490ce96045532
--- /dev/null
+++ b/crates/common/chain/lean/examples/profile_tool_three.rs
@@ -0,0 +1,299 @@
+//! Fresh public test provisioning only; never repairs or recreates an authority.
+use alloy_primitives::{B256, FixedBytes};
+use ream_chain_lean::{
+    signer::ProposalSigner,
+    signing_history::{Binding, SigningHistory},
+};
+use ream_consensus_lean::validator::Validator;
+use ream_keystore::lean_keystore::ValidatorKeystore;
+use ream_post_quantum_crypto::leansig::{private_key::PrivateKey, public_key::PublicKey};
+use std::{
+    collections::BTreeSet,
+    fs,
+    path::{Path, PathBuf},
+    sync::Arc,
+};
+use tree_hash::TreeHash;
+fn public(dir: &Path, role: &str) -> anyhow::Result<PublicKey> {
+    let bytes = fs::read(dir.join(format!("{role}.pub")))?;
+    anyhow::ensure!(bytes.len() == 52, "public key length");
+    Ok(PublicKey::new(FixedBytes::from_slice(&bytes)))
+}
+// All semantic checks and reads precede the first create_new. Once the
+// creation pass starts, an I/O/race failure still leaves its guards in place:
+// an ambiguous authority must never become eligible for a reset.
+fn provision_history(
+    entries: &[(PathBuf, u64)],
+    path: &Path,
+    network: [u8; 32],
+    bindings: &[Binding],
+) -> anyhow::Result<SigningHistory> {
+    let mut directories = BTreeSet::new();
+    let mut indices = BTreeSet::new();
+    let mut guards = Vec::new();
+    for (directory, index) in entries {
+        let directory = fs::canonicalize(directory)?;
+        anyhow::ensure!(directory.is_dir(), "key path must be a directory");
+        anyhow::ensure!(
+            directories.insert(directory.clone()),
+            "key directory bound more than once"
+        );
+        anyhow::ensure!(indices.insert(*index), "Lean index bound more than once");
+        let guard = directory.join("history-provisioned-once");
+        require_absent(&guard)?;
+        guards.push(guard);
+    }
+    anyhow::ensure!(
+        indices
+            == bindings
+                .iter()
+                .map(|binding| binding.validator_index)
+                .collect::<BTreeSet<_>>(),
+        "directory indices differ from signing-history bindings"
+    );
+    SigningHistory::validate_bindings(network, bindings)?;
+    let parent = path
+        .parent()
+        .filter(|parent| !parent.as_os_str().is_empty())
+        .unwrap_or_else(|| Path::new("."));
+    let parent = fs::canonicalize(parent)?;
+    anyhow::ensure!(parent.is_dir(), "history parent is not a directory");
+    let history_path = parent.join(
+        path.file_name()
+            .ok_or_else(|| anyhow::anyhow!("history file name required"))?,
+    );
+    require_absent(&history_path)?;
+    anyhow::ensure!(
+        !guards.contains(&history_path),
+        "history path collides with a key-directory guard"
+    );
+
+    for guard_path in guards {
+        let guard = fs::OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .open(&guard_path)?;
+        guard.sync_all()?;
+        fs::File::open(guard_path.parent().expect("guard has a directory"))?.sync_all()?;
+    }
+    Ok(SigningHistory::create_for_fresh_public_test_keys(
+        &history_path,
+        network,
+        bindings,
+    )?)
+}
+
+fn require_absent(path: &Path) -> anyhow::Result<()> {
+    match fs::symlink_metadata(path) {
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(()),
+        Err(error) => Err(error.into()),
+        Ok(_) => anyhow::bail!("provisioning path already exists: {}", path.display()),
+    }
+}
+
+fn main() -> anyhow::Result<()> {
+    let a: Vec<String> = std::env::args().collect();
+    let first = PathBuf::from(&a[2]);
+    match a[1].as_str() {
+        "genesis" => {
+            let mut dirs = vec![first];
+            dirs.extend(a[4..].iter().map(PathBuf::from));
+            let validators = dirs
+                .iter()
+                .enumerate()
+                .map(|(i, d)| {
+                    Ok(Validator {
+                        index: i as u64,
+                        attestation_public_key: public(d, "attestation")?,
+                        proposal_public_key: public(d, "proposal")?,
+                    })
+                })
+                .collect::<anyhow::Result<Vec<_>>>()?;
+            let (block, state) =
+                ream_fork_choice_lean::genesis::setup_genesis(a[3].parse()?, validators);
+            println!(
+                "{}",
+                serde_json::json!({"clRoot":block.tree_hash_root(),"clStateRoot":state.tree_hash_root(),"genesisTime":a[3].parse::<u64>()?})
+            );
+        }
+        "history" => {
+            let mut entries = vec![(first, a[5].parse::<u64>()?)];
+            anyhow::ensure!(
+                a[6..].len() % 2 == 0,
+                "additional directory/index pairs required"
+            );
+            for pair in a[6..].chunks(2) {
+                entries.push((PathBuf::from(&pair[0]), pair[1].parse()?));
+            }
+            let network: B256 = a[4].parse()?;
+            // Decode every key and check its usable interval before reserving
+            // any directory. A malformed later input must not consume earlier ones.
+            let mut keys = vec![];
+            for (d, i) in &entries {
+                keys.push(Arc::new(ValidatorKeystore {
+                    index: *i,
+                    attestation_public_key: public(d, "attestation")?,
+                    proposal_public_key: public(d, "proposal")?,
+                    attestation_private_key: PrivateKey::from_bytes(&fs::read(
+                        d.join("attestation.ssz"),
+                    )?)?,
+                    proposal_private_key: PrivateKey::from_bytes(&fs::read(
+                        d.join("proposal.ssz"),
+                    )?)?,
+                }));
+            }
+            let bindings = ProposalSigner::bindings(&keys, 0..4096)?;
+            let _history = provision_history(&entries, Path::new(&a[3]), network.0, &bindings)?;
+            println!("fresh authority created");
+        }
+        _ => anyhow::bail!("genesis or history required"),
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use ream_chain_lean::signing_history::Role;
+    use std::sync::atomic::{AtomicU64, Ordering};
+
+    static NEXT_FIXTURE: AtomicU64 = AtomicU64::new(0);
+    const NETWORK: [u8; 32] = [7; 32];
+
+    struct Fixture {
+        root: PathBuf,
+        entries: Vec<(PathBuf, u64)>,
+        bindings: Vec<Binding>,
+        history: PathBuf,
+    }
+
+    impl Fixture {
+        fn new() -> Self {
+            let root = std::env::temp_dir().join(format!(
+                "pq-profile-history-{}-{}",
+                std::process::id(),
+                NEXT_FIXTURE.fetch_add(1, Ordering::Relaxed)
+            ));
+            fs::create_dir(&root).unwrap();
+            let entries = vec![(root.join("first"), 3), (root.join("second"), 9)];
+            let mut bindings = Vec::new();
+            for (position, (directory, index)) in entries.iter().enumerate() {
+                fs::create_dir(directory).unwrap();
+                for (role_index, role) in
+                    [Role::Attestation, Role::Proposal].into_iter().enumerate()
+                {
+                    // Storage/provisioning test bytes only: no private keys,
+                    // signing, key enrollment, or XMSS security claim.
+                    bindings.push(Binding {
+                        public_key: [(position * 2 + role_index + 1) as u8; 52],
+                        validator_index: *index,
+                        role,
+                        interval: 0..4096,
+                    });
+                }
+            }
+            let history = root.join("history.bin");
+            Self {
+                root,
+                entries,
+                bindings,
+                history,
+            }
+        }
+
+        fn rejected_then_corrected(&self, entries: &[(PathBuf, u64)], bindings: &[Binding]) {
+            assert!(provision_history(entries, &self.history, NETWORK, bindings).is_err());
+            assert!(!self.history.exists());
+            for (directory, _) in &self.entries {
+                assert!(!directory.join("history-provisioned-once").exists());
+            }
+            let history = provision_history(&self.entries, &self.history, NETWORK, &self.bindings)
+                .expect("corrected bindings must remain provisionable");
+            assert!(self.history.is_file());
+            for (directory, _) in &self.entries {
+                assert!(directory.join("history-provisioned-once").is_file());
+            }
+            drop(history);
+            SigningHistory::open(&self.history, NETWORK, &self.bindings)
+                .expect("created authority must have the corrected header");
+        }
+    }
+
+    impl Drop for Fixture {
+        fn drop(&mut self) {
+            fs::remove_dir_all(&self.root).unwrap();
+        }
+    }
+
+    #[test]
+    fn duplicate_key_tuple_leaves_no_guards_and_corrected_retry_succeeds() {
+        let fixture = Fixture::new();
+        let mut bindings = fixture.bindings.clone();
+        bindings[2].public_key = bindings[0].public_key;
+        bindings[3].public_key = bindings[1].public_key;
+        fixture.rejected_then_corrected(&fixture.entries, &bindings);
+    }
+
+    #[test]
+    fn duplicate_index_leaves_no_guards_and_corrected_retry_succeeds() {
+        let fixture = Fixture::new();
+        let mut entries = fixture.entries.clone();
+        entries[1].1 = entries[0].1;
+        let mut bindings = fixture.bindings.clone();
+        bindings[2].validator_index = entries[0].1;
+        bindings[3].validator_index = entries[0].1;
+        fixture.rejected_then_corrected(&entries, &bindings);
+    }
+
+    #[test]
+    fn aliased_directory_leaves_no_guards_and_corrected_retry_succeeds() {
+        let fixture = Fixture::new();
+        let mut entries = fixture.entries.clone();
+        entries[1].0 = entries[0].0.join(".");
+        fixture.rejected_then_corrected(&entries, &fixture.bindings);
+    }
+
+    #[test]
+    fn mismatched_binding_index_leaves_no_guards_and_corrected_retry_succeeds() {
+        let fixture = Fixture::new();
+        let mut bindings = fixture.bindings.clone();
+        bindings[2].validator_index = 10;
+        bindings[3].validator_index = 10;
+        fixture.rejected_then_corrected(&fixture.entries, &bindings);
+    }
+
+    #[test]
+    fn cross_role_key_alias_leaves_no_guards_and_corrected_retry_succeeds() {
+        let fixture = Fixture::new();
+        let mut bindings = fixture.bindings.clone();
+        bindings[3].public_key = bindings[0].public_key;
+        fixture.rejected_then_corrected(&fixture.entries, &bindings);
+    }
+
+    #[test]
+    fn later_existing_guard_does_not_consume_earlier_directory() {
+        let fixture = Fixture::new();
+        let existing = fixture.entries[1].0.join("history-provisioned-once");
+        fs::write(&existing, b"previous provisioning").unwrap();
+        assert!(
+            provision_history(
+                &fixture.entries,
+                &fixture.history,
+                NETWORK,
+                &fixture.bindings,
+            )
+            .is_err()
+        );
+        assert!(!fixture.history.exists());
+        assert!(
+            !fixture.entries[0]
+                .0
+                .join("history-provisioned-once")
+                .exists()
+        );
+        assert_eq!(
+            fs::read(existing).unwrap().as_slice(),
+            b"previous provisioning"
+        );
+    }
+}
