+            h.sign(
+                &[2; 52],
+                0,
+                Role::Proposal,
+                101,
+                [3; 32],
+                || Ok(vec![3; SIGNATURE_BYTES]),
+                |_| false
+            )
+            .is_err()
+        );
+        assert!(sign(&h, 101, 3).is_err());
+        drop(h);
+        OpenOptions::new()
+            .append(true)
+            .open(f.path())
+            .unwrap()
+            .write_all(&[1, 2, 3])
+            .unwrap();
+        assert!(SigningHistory::open(&f.path(), [7; 32], &bindings()).is_err());
+    }
+    #[test]
+    fn whole_authority_rollback_is_explicitly_not_detected() {
+        let f = Fixture::new();
+        let h = create(&f);
+        let before = std::fs::read(f.path()).unwrap();
+        sign(&h, 101, 3).unwrap();
+        drop(h);
+        std::fs::write(f.path(), before).unwrap();
+        let stale = SigningHistory::open(&f.path(), [7; 32], &bindings()).unwrap();
+        assert!(sign(&stale, 101, 4).is_ok()); // counterexample; not a safety pass
+    }
+
+    #[test]
+    fn child_process_probe() {
+        // Only the subprocess harness sets these inputs. A normal test run does
+        // no child work; the parent test checks actual process exit statuses.
+        let Ok(path) = std::env::var("PQ_HISTORY_TEST_PATH") else {
+            return;
+        };
+        let action = std::env::var("PQ_HISTORY_TEST_ACTION").unwrap();
+        let opened = SigningHistory::open(Path::new(&path), [7; 32], &bindings());
+        if action == "locked" {
+            std::process::exit(if opened.is_err() { 81 } else { 82 });
+        }
+        let history = opened.unwrap();
+        let _ = history.sign(
+            &[2; 52],
+            0,
+            Role::Proposal,
+            101,
+            [3; 32],
+            || {
+                if action == "after-reservation" {
+                    std::process::exit(83);
+                }
+                Ok(vec![3; SIGNATURE_BYTES])
+            },
+            |_| {
+                if action == "after-sign-before-save" {
+                    std::process::exit(84);
+                }
+                true
+            },
+        );
+        panic!("child unexpectedly returned");
+    }
+
+    #[test]
+    fn cross_process_lock_and_abrupt_exits_leave_slots_burned() {
+        fn child(path: &Path, action: &str, expected: i32) {
+            // libtest names omit the crate name. Preserve any enclosing module
+            // so this harness works both standalone and inside ream_validator_lean.
+            let (_, test_module) = module_path!().split_once("::").unwrap();
+            let child_test = format!("{test_module}::child_process_probe");
+            let status = std::process::Command::new(std::env::current_exe().unwrap())
+                .args(["--exact", &child_test, "--test-threads", "1"])
+                .env("PQ_HISTORY_TEST_PATH", path)
+                .env("PQ_HISTORY_TEST_ACTION", action)
+                .status()
+                .unwrap();
+            assert_eq!(status.code(), Some(expected));
+        }
+        let locked = Fixture::new();
+        let authority = create(&locked);
+        child(&locked.path(), "locked", 81);
+        drop(authority);
+        for (action, code) in [("after-reservation", 83), ("after-sign-before-save", 84)] {
+            let f = Fixture::new();
+            drop(create(&f));
+            child(&f.path(), action, code);
+            let recovered = SigningHistory::open(&f.path(), [7; 32], &bindings()).unwrap();
+            assert!(sign(&recovered, 101, 3).is_err());
+            assert!(sign(&recovered, 101, 4).is_err());
+            assert!(sign(&recovered, 102, 4).is_ok());
+        }
+    }
+}
