+//! Public, untrusted availability transport. No signing/readiness authority.
+use alloy_primitives::B256;
+use alloy_rpc_types_engine::ExecutionData;
+use anyhow::{anyhow, ensure};
+use ream_execution_rpc_types::electra::execution_payload::ExecutionPayload;
+use reqwest::Client;
+use std::time::Duration;
+use crate::{external::PayloadMaterials, payload::from_ream_execution_payload};
+
+pub const MAX_MATERIAL_BYTES: usize = 2 * 1024 * 1024;
+
+/// Hash raw transaction bytes, including PQ transaction types unknown to alloy.
+/// This binds every header field and actual EIP-7685 request bytes; it does NOT
+/// replace execution by geth or claim validity of the advertised state root.
+pub fn bind(payload: &ExecutionPayload, parent: B256,
+    material: &PayloadMaterials) -> anyhow::Result<ExecutionData> {
+    let data = from_ream_execution_payload(payload, parent, material)?;
+    let block = data.clone().into_block_raw()?;
+    ensure!(block.header.hash_slow() == payload.block_hash,
+        "untrusted material does not reconstruct the authenticated payload hash");
+    Ok(data)
+}
+
+pub async fn fetch(client: &Client, peers: &[String], payload: &ExecutionPayload,
+    parent: B256) -> anyhow::Result<(ExecutionData, PayloadMaterials)> {
+    ensure!(peers.len() <= 4, "too many material peers");
+    tokio::time::timeout(Duration::from_secs(4), async {
+        for peer in peers {
+            let url = super::external::endpoint(peer)?;
+            let url = url.join(&format!("{:x}.json", payload.block_hash))?;
+            let attempt = async {
+                let mut reply = client.get(url).timeout(Duration::from_secs(1)).send().await?;
+                ensure!(reply.status().as_u16() == 200, "material unavailable");
+                ensure!(reply.content_length().is_none_or(|n| n <= MAX_MATERIAL_BYTES as u64),
+                    "material too large");
+                let mut bytes = Vec::new();
+                while let Some(chunk) = reply.chunk().await? {
+                    ensure!(bytes.len() + chunk.len() <= MAX_MATERIAL_BYTES, "material too large");
+                    bytes.extend_from_slice(&chunk);
+                }
+                let material: PayloadMaterials = serde_json::from_slice(&bytes)?;
+                let data = bind(payload, parent, &material)?;
+                Ok::<_, anyhow::Error>((data, material))
+            }.await;
+            // A malformed first peer cannot poison the cache or suppress a
+            // valid later peer. Never attach the Engine JWT to public requests.
+            if let Ok(result) = attempt { return Ok(result); }
+        }
+        Err(anyhow!("PENDING: no peer supplied hash-bound execution material"))
+    }).await.map_err(|_| anyhow!("PENDING: execution material deadline exceeded"))?
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use alloy_primitives::Bytes;
+    use std::{io::{Read, Write}, net::TcpListener, thread};
+
+    fn fixture() -> (ExecutionPayload, PayloadMaterials) {
+        let mut payload = ExecutionPayload::default();
+        payload.base_fee_per_gas = alloy_primitives::U256::from(1u64);
+        // Deliberately opaque PQ-type bytes exercise hash preservation without
+        // pretending these model bytes are a valid migration transaction.
+        payload.transactions = ssz_types::VariableList::new(vec![
+            ssz_types::VariableList::new(vec![0x7e, 0xc0]).unwrap()
+        ]).unwrap();
+        let mut material = PayloadMaterials {block_hash: B256::ZERO,
+            parent_beacon_block_root: B256::repeat_byte(2), versioned_hashes: vec![],
+            execution_requests: vec![Bytes::from(vec![1, 0xaa])]};
+        let data = from_ream_execution_payload(&payload, material.parent_beacon_block_root, &material).unwrap();
+        payload.block_hash = data.into_block_raw().unwrap().header.hash_slow();
+        material.block_hash = payload.block_hash;
+        (payload, material)
+    }
+
+    fn serve(body: Vec<u8>, oversized: bool) -> (String, thread::JoinHandle<()>) {
+        let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+        let url = format!("http://{}/", listener.local_addr().unwrap());
+        let handle = thread::spawn(move || {
+            let (mut socket, _) = listener.accept().unwrap();
+            socket.set_read_timeout(Some(Duration::from_secs(5))).unwrap();
+            let mut request = Vec::new();
+            loop {
+                let mut buf = [0; 1024];
+                let n = socket.read(&mut buf).unwrap();
+                assert!(n != 0);
+                request.extend_from_slice(&buf[..n]);
+                assert!(request.len() <= 16384);
+                if request.windows(4).any(|s| s == b"\r\n\r\n") { break; }
+            }
+            let request = String::from_utf8(request).unwrap().to_lowercase();
+            assert!(request.starts_with("get /"));
+            assert!(!request.contains("authorization:"));
+            write!(socket, "HTTP/1.1 200 OK\r\nContent-Length: {}\r\nConnection: close\r\n\r\n",
+                if oversized { MAX_MATERIAL_BYTES + 1 } else { body.len() }).unwrap();
+            let _ = socket.write_all(&body);
+        });
+        (url, handle)
+    }
+
+    #[tokio::test]
+    async fn real_http_bad_peer_then_good_preserves_requests() {
+        let (payload, material) = fixture();
+        let mut wrong = material.clone();
+        wrong.execution_requests[0] = Bytes::from(vec![1, 0xbb]);
+        let (bad, a) = serve(serde_json::to_vec(&wrong).unwrap(), false);
+        let (good, b) = serve(serde_json::to_vec(&material).unwrap(), false);
+        let client = Client::builder().no_proxy().redirect(reqwest::redirect::Policy::none()).build().unwrap();
+        let (data, got) = fetch(&client, &[bad, good], &payload, material.parent_beacon_block_root).await.unwrap();
+        assert_eq!(got, material);
+        assert_eq!(data.block_hash(), payload.block_hash);
+        a.join().unwrap(); b.join().unwrap();
+    }
+
+    #[tokio::test]
+    async fn real_http_oversize_is_pending_not_empty_fallback() {
+        let (payload, material) = fixture();
+        let (bad, a) = serve(vec![], true);
+        let client = Client::builder().no_proxy().redirect(reqwest::redirect::Policy::none()).build().unwrap();
+        let err = fetch(&client, &[bad], &payload, material.parent_beacon_block_root).await.unwrap_err();
+        assert!(err.to_string().contains("PENDING"));
+        a.join().unwrap();
+    }
+
+    #[test]
+    fn material_identity_and_complete_header_are_bound() {
+        let (payload, material) = fixture();
+        bind(&payload, material.parent_beacon_block_root, &material).unwrap();
+        let mut changed = material.clone(); changed.execution_requests.clear();
+        assert!(bind(&payload, material.parent_beacon_block_root, &changed).is_err());
+        assert!(bind(&payload, B256::repeat_byte(9), &material).is_err());
+        let mut changed_payload = payload.clone(); changed_payload.state_root = B256::repeat_byte(3);
+        assert!(bind(&changed_payload, material.parent_beacon_block_root, &material).is_err());
+    }
+}
