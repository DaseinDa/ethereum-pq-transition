--- /dev/null
+++ b/crates/crypto/post_quantum/examples/fresh_public_keys.rs
@@ -0,0 +1,19 @@
+//! Explicit fresh PUBLIC synthetic keys at ordinary upstream devnet5 parameters.
+use std::{path::PathBuf,fs,time::Instant};
+use ream_post_quantum_crypto::leansig::private_key::PrivateKey;
+fn main()->anyhow::Result<()> {
+ let out=PathBuf::from(std::env::args().nth(1).expect("new public output directory"));
+ fs::create_dir(&out)?;
+ let seed_file=PathBuf::from(std::env::args().nth(2).expect("PUBLIC 64-byte seed file"));
+ let seeds=fs::read(seed_file)?;anyhow::ensure!(seeds.len()==64,"two independent public seeds required");
+ for (index,role) in ["attestation","proposal"].iter().enumerate() {
+  let started=Instant::now();
+  println!("ordinary key generation started: {role}");
+  let (public,private)=PrivateKey::generate_key_pair_from_seed(seeds[index*32..index*32+32].try_into()?,0,262144);
+  fs::write(out.join(format!("{role}.ssz")),private.to_bytes())?;
+  fs::write(out.join(format!("{role}.pub")),public.inner.as_slice())?;
+  fs::write(out.join(format!("{role}-generation.txt")),format!("seconds={}\nactivation={:?}\nprepared={:?}\n",started.elapsed().as_secs_f64(),private.get_activation_interval(),private.get_prepared_interval()))?;
+  println!("ordinary key generation complete: {role}, {:?}, {:?}",started.elapsed(),private.get_activation_interval());
+ }
+ Ok(())
+}
