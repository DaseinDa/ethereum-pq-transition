+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package eth
+
+import (
+	"bytes"
+	"maps"
+	"math/big"
+	"strings"
+	"testing"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/consensus/beacon"
+	"github.com/ethereum/go-ethereum/consensus/ethash"
+	"github.com/ethereum/go-ethereum/core"
+	"github.com/ethereum/go-ethereum/core/rawdb"
+	"github.com/ethereum/go-ethereum/core/state"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/eth/ethconfig"
+	"github.com/ethereum/go-ethereum/ethdb"
+	"github.com/ethereum/go-ethereum/node"
+	"github.com/ethereum/go-ethereum/p2p"
+	"github.com/ethereum/go-ethereum/triedb"
+	"github.com/ethereum/go-ethereum/triedb/pathdb"
+)
+
+// Start-up check S8 (spec section 24.6 rule 3) through the node's real start
+// path, eth.New on a datadir as geth runs it, on the client's F profile with T0
+// at its genesis timestamp 0. TB-6: a genesis whose allocation lacks
+// PQ_REGISTRY is refused with a start-up error naming that address, on a new
+// datadir and again on the existing one, with no block processed and no image
+// written into the genesis state; so is an existing datadir whose path scheme
+// no longer holds the genesis state. TB-5: the genesis holding both images
+// starts. S7 runs first and needs the native F verifier, so this skips without it.
+func TestPQGenesisImagesNodeStart(t *testing.T) {
+	if err := core.CheckPQFullVerifierConfig(pqL2Config().PQMigrate.FullResearch); err != nil {
+		t.Skipf("S7 refuses first without the native F verifier (%v): build with -tags pq_final", err)
+	}
+	p := pqL2Config().PQMigrate
+	registry, facts := p.Registry, p.FactRegistry
+	// A balance, as every genesis file states one: geth cannot read back a
+	// stored allocation whose account has none.
+	image := types.Account{Code: []byte{0}, Nonce: 1, Balance: new(big.Int)}
+	genesis := func(alloc types.GenesisAlloc) *core.Genesis {
+		maps.Copy(alloc, core.SystemContractAllocs())
+		return &core.Genesis{Config: pqL2Config(), GasLimit: 30000000, Alloc: alloc}
+	}
+	refused := func(t *testing.T, err error) {
+		t.Helper()
+		if err == nil || !strings.Contains(err.Error(), "start-up check S8") || !strings.Contains(err.Error(), "PQ_REGISTRY "+registry.Hex()+" is absent") {
+			t.Fatalf("not refused by S8 on PQ_REGISTRY %s: %v", registry.Hex(), err)
+		}
+	}
+
+	t.Run("TB-5", func(t *testing.T) {
+		if err := s8Start(t, t.TempDir(), genesis(types.GenesisAlloc{registry: image, facts: image})); err != nil {
+			t.Fatalf("refused: %v", err)
+		}
+	})
+
+	t.Run("TB-6/new-and-existing-datadir", func(t *testing.T) {
+		datadir := t.TempDir()
+		gspec := genesis(types.GenesisAlloc{facts: image})
+		want := gspec.ToBlock()
+		refused(t, s8Start(t, datadir, gspec))
+		refused(t, s8Start(t, datadir, nil)) // the genesis from the database only, as after geth init
+		s8Datadir(t, datadir, func(db ethdb.Database) {
+			if rawdb.ReadHeadBlockHash(db) != want.Hash() || rawdb.ReadCanonicalHash(db, 1) != (common.Hash{}) {
+				t.Fatal("the head is not the genesis: a block was processed")
+			}
+			stored, err := core.ReadGenesis(db)
+			if err != nil || stored.ToBlock().Hash() != want.Hash() {
+				t.Fatal("the stored genesis is not the one written", err)
+			}
+			if _, ok := stored.Alloc[registry]; ok {
+				t.Fatal("an image was written into the stored allocation")
+			}
+			config := triedb.HashDefaults
+			if rawdb.ReadStateScheme(db) == rawdb.PathScheme {
+				config = &triedb.Config{PathDB: pathdb.ReadOnly}
+			}
+			tdb := triedb.NewDatabase(db, config)
+			defer tdb.Close()
+			s, err := state.New(want.Root(), state.NewDatabase(tdb, state.NewCodeDB(db)))
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(s.GetCode(registry)) != 0 || s.GetNonce(registry) != 0 || !bytes.Equal(s.GetCode(facts), []byte{0}) || s.Error() != nil {
+				t.Fatal("the genesis state changed: an image was injected")
+			}
+		})
+	})
+
+	t.Run("TB-6/existing-datadir-genesis-state-pruned", func(t *testing.T) {
+		datadir := t.TempDir()
+		gspec := genesis(types.GenesisAlloc{facts: image})
+		_, blocks, _ := core.GenerateChainWithGenesis(gspec, beacon.New(ethash.NewFaker()), 140, nil)
+		head := blocks[len(blocks)-1].Hash()
+		n := s8Node(t, datadir)
+		db, err := n.OpenDatabaseWithOptions("chaindata", node.DatabaseOptions{Cache: 16, Handles: 16})
+		if err != nil {
+			t.Fatal(err)
+		}
+		options := core.DefaultConfig().WithStateScheme(rawdb.PathScheme)
+		options.TrieJournalDirectory = n.ResolvePath("triedb") // where eth.New keeps the journal
+		chain, err := core.NewBlockChain(db, gspec, beacon.New(ethash.NewFaker()), options)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if i, err := chain.InsertChain(blocks); err != nil {
+			t.Fatalf("import failed at %d: %v", i, err)
+		}
+		if _, err := chain.StateAt(chain.Genesis().Header()); err == nil {
+			t.Fatal("the path scheme still holds the genesis state; the case is not reached")
+		}
+		chain.Stop()
+		n.Close()
+		refused(t, s8Start(t, datadir, nil))
+		s8Datadir(t, datadir, func(db ethdb.Database) {
+			if rawdb.ReadHeadBlockHash(db) != head || rawdb.ReadCanonicalHash(db, uint64(len(blocks)+1)) != (common.Hash{}) {
+				t.Fatal("the head moved: a block was processed or rewound")
+			}
+		})
+	})
+}
+
+func s8Node(t *testing.T, datadir string) *node.Node {
+	t.Helper()
+	n, err := node.New(&node.Config{Name: "geth", DataDir: datadir, P2P: p2p.Config{NoDiscovery: true, NoDial: true, MaxPeers: 0}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return n
+}
+
+// s8Start runs eth.New on datadir; when it succeeds, the node starts and closes.
+func s8Start(t *testing.T, datadir string, genesis *core.Genesis) error {
+	t.Helper()
+	n := s8Node(t, datadir)
+	defer n.Close()
+	cfg := ethconfig.Defaults
+	cfg.Genesis = genesis
+	cfg.SyncMode = ethconfig.FullSync
+	cfg.DatabaseCache, cfg.DatabaseHandles = 16, 16
+	cfg.TrieCleanCache, cfg.TrieDirtyCache, cfg.SnapshotCache = 16, 16, 0
+	if _, err := New(n, &cfg); err != nil {
+		return err
+	}
+	if err := n.Start(); err != nil {
+		t.Fatal(err)
+	}
+	return nil
+}
+
+// s8Datadir opens the chain database of datadir read-only for inspection.
+func s8Datadir(t *testing.T, datadir string, inspect func(ethdb.Database)) {
+	t.Helper()
+	n := s8Node(t, datadir)
+	defer n.Close()
+	db, err := n.OpenDatabaseWithOptions("chaindata", node.DatabaseOptions{ReadOnly: true, Cache: 16, Handles: 16})
+	if err != nil {
+		t.Fatal(err)
+	}
+	inspect(db)
+}
