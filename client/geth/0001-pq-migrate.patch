+func TestPQFinalPublicOverrideDeadline(t *testing.T) {
+	for _, closed := range []bool{false, true} {
+		t.Run(fmt.Sprintf("closed-%t", closed), func(t *testing.T) {
+			tx, s, evm, h := finalPublicFixture(t, 1)
+			p, _ := tx.AsPQMigrate()
+			cfg := evm.ChainConfig().PQMigrate
+			cfg.T = h.Time - cfg.W
+			cfg.T0 = cfg.T - 100
+			cfg.ReceivingTime = cfg.T0
+			if !closed {
+				cfg.T++
+			}
+			writePQRecord(s, cfg.Registry, p.LegacyAddress, PQRecord{Mode: 1, AlgID: 1, EnrolledAt: cfg.T - 10, MigrationNonce: p.MigrationNonce, Commit: common.Hash{0x99}})
+			s.SetTxContext(tx.Hash(), 0, 1)
+			_, err := ApplyMessage(evm, &Message{PQTransaction: tx, GasLimit: tx.Gas()}, NewGasPool(h.GasLimit))
+			if closed {
+				if pqMigrationErrorName(err) != "OVERRIDE_WINDOW_CLOSED" {
+					t.Fatal(err)
+				}
+			} else if err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}
