+func TestPQFactRegistryDispatchFailures(t *testing.T) {
+	for _, name := range []string{"short", "long", "selector", "unknown_version", "wrong_caller", "wrong_code", "zero_code_hash", "not_active", "sunset", "zero_sunset", "value", "callcode", "delegatecall", "static", "inherited_static", "oog", "sentry", "noncanonical_slot"} {
+		t.Run(name, func(t *testing.T) {
+			evm, db := pqTestEVM(t, pqToyVerifier(false, false), common.Hash{}, false, false)
+			input, caller, value := pqRegisterInput(), pqTestVerifier, new(uint256.Int)
+			budget, want, burn := NewGasBudget(50000, 0), error(ErrExecutionReverted), false
+			v := evm.chainConfig.PQMigrate.FactVerifiers[1]
+			switch name {
+			case "short":
+				input = input[:39]
+			case "long":
+				input = append(input, 0)
+			case "selector":
+				input[0] ^= 1
+			case "unknown_version":
+				input[7] = 2
+			case "wrong_caller":
+				caller = pqTestSender
+			case "wrong_code":
+				db.SetCode(caller, []byte{byte(STOP)}, tracing.CodeChangeUnspecified)
+			case "zero_code_hash":
+				v.CodeHash = common.Hash{}
+			case "not_active":
+				v.Activation = 1001
+			case "sunset":
+				v.Sunset = 1000
+			case "zero_sunset":
+				v.Sunset = 0
+			case "value":
+				value.SetUint64(1)
+			case "static", "inherited_static":
+				want, burn = ErrWriteProtection, true
+			case "oog":
+				budget, want, burn = NewGasBudget(22099, 0), ErrOutOfGas, true
+			case "sentry":
+				budget, want, burn = NewGasBudget(4400, 0), nil, true
+			case "noncanonical_slot":
+				db.SetState(pqTestRegistry, pqTestFact, common.HexToHash("0x0100000000000000000000000000000000000000000000000000"))
+			}
+			evm.chainConfig.PQMigrate.FactVerifiers[1] = v
+			old := db.GetState(pqTestRegistry, pqTestFact)
+			var ret []byte
+			var left GasBudget
+			var err error
+			switch name {
