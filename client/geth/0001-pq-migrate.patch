+	changes := map[string]func(*params.PQFullResearchConfig){
+		"gas-cap":              func(f *params.PQFullResearchConfig) { f.TxGasCap = params.MaxTxGas + 1 },
+		"algorithm":            func(f *params.PQFullResearchConfig) { f.NativeAlgorithmDigest[0] ^= 1 },
+		"worker-sha-forbidden": func(f *params.PQFullResearchConfig) { f.VerifierSHA[0] = 1 },
+		"backend":              func(f *params.PQFullResearchConfig) { f.Backend = "unknown" },
+		"proof-bound":          func(f *params.PQFullResearchConfig) { f.MaxProofBytes++ },
+		"tx-bound":             func(f *params.PQFullResearchConfig) { f.MaxTxBytes++ },
+		"image":                func(f *params.PQFullResearchConfig) { f.ImageID[0] ^= 1 },
+	}
+	for name, edit := range changes {
+		t.Run(name, func(t *testing.T) {
+			c := nativeTestChain()
+			edit(c.PQMigrate.FullResearch)
+			if c.CheckConfigForkOrder() == nil {
+				t.Fatal("invalid native profile accepted")
+			}
+		})
+	}
+}
+
+func TestPQNativeUnavailableFailsClosed(t *testing.T) {
+	if _, available := pqNativeIdentityJSON(); available {
+		t.Skip("native-linked build; no-library path covered by separate untagged build")
+	}
+	t.Setenv("PQ_FULL_VERIFIER_PATH", "/must/not/be/used")
+	err := VerifyPQFull(nativeTestProfile(), make([]byte, 198), []byte{1})
+	if !errors.Is(err, ErrPQFullUnavailable) || errors.Is(err, ErrPQInvalidFullProof) {
+		t.Fatalf("no native library misclassified: %v", err)
+	}
+}
+
+func TestPQNativeGasCapStateExecutionAndEncoding(t *testing.T) {
+	cfg := nativeTestChain()
+	// Even a locally mutated configuration cannot revive the old exemption.
+	cfg.PQMigrate.FullResearch.TxGasCap = 64000000
+	s, err := state.New(types.EmptyRootHash, state.NewDatabaseForTesting())
+	if err != nil {
+		t.Fatal(err)
+	}
+	owner := common.HexToAddress("1234")
+	s.SetBalance(owner, uint256.NewInt(2000000000000000000), tracing.BalanceChangeUnspecified)
+	s.SetCode(cfg.PQMigrate.Registry, []byte{0}, tracing.CodeChangeUnspecified)
+	s.SetNonce(cfg.PQMigrate.Registry, 1, tracing.NonceChangeUnspecified)
+	p := &types.PQMigrateTx{ChainID: new(big.Int).SetUint64(params.PQR1ChainID), LegacyAddress: owner, AlgID: 1, PQPKCommit: common.HexToHash("01"), Expiry: 2000,
+		MaxAccountFee: big.NewInt(100000000000000000), GasTipCap: big.NewInt(1), GasFeeCap: big.NewInt(1000000000), Gas: params.MaxTxGas,
+		VerifierVersion: params.PQR1Version, ProofCarrier: types.PQMigrationCarrier{Proof: []byte{1}}}
+	h := &types.Header{Number: big.NewInt(1), Time: 1000, GasLimit: 30000000, BaseFee: big.NewInt(1), Difficulty: new(big.Int)}
+	// This is a state precheck, deliberately not acceptance of a fake proof.
+	if err := ValidatePQMigrateState(types.NewTx(p), s.Copy(), h, cfg); err != nil {
+		t.Fatal("cap boundary precheck", err)
+	}
+	p.Gas++
+	tx := types.NewTx(p)
+	raw, err := tx.MarshalBinary()
+	if err != nil {
+		t.Fatal(err)
+	}
+	decoded := new(types.Transaction)
+	if err = decoded.UnmarshalBinary(raw); err != nil {
+		t.Fatal(err)
+	}
+	js, err := json.Marshal(tx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	fromJSON := new(types.Transaction)
+	if err = json.Unmarshal(js, fromJSON); err != nil {
+		t.Fatal(err)
+	}
+	for _, item := range []*types.Transaction{tx, decoded, fromJSON} {
+		if err := ValidatePQMigrateState(item, s.Copy(), h, cfg); !errors.Is(err, ErrGasLimitTooHigh) {
+			t.Fatalf("gas cap not enforced: %v", err)
+		}
+	}
+	random := common.Hash{}
+	evm := vm.NewEVM(vm.BlockContext{CanTransfer: CanTransfer, Transfer: Transfer, GetHash: func(uint64) common.Hash { return common.Hash{} },
+		BlockNumber: h.Number, Time: h.Time, Difficulty: h.Difficulty, BaseFee: h.BaseFee, GasLimit: h.GasLimit, Random: &random}, s, cfg, vm.Config{})
+	defer evm.Release()
+	before := s.IntermediateRoot(evm.GetRules())
+	gp := NewGasPool(h.GasLimit)
+	_, err = ApplyMessage(evm, &Message{PQTransaction: tx}, gp)
+	if !errors.Is(err, ErrGasLimitTooHigh) {
+		t.Fatalf("execution cap: %v", err)
+	}
+	if s.IntermediateRoot(evm.GetRules()) != before || gp.Gas() != h.GasLimit {
+		t.Fatal("over-cap attempt changed state or gas pool")
+	}
+}
+
+func TestPQNativeActualReceipt(t *testing.T) {
+	proofPath, piPath := os.Getenv("PQ_NATIVE_PROOF"), os.Getenv("PQ_NATIVE_PI")
+	if proofPath == "" || piPath == "" {
+		t.Skip("requires frozen actual Succinct proof and 198-byte PI")
+	}
+	if _, ok := pqNativeIdentityJSON(); !ok {
+		t.Fatal("actual receipt regression requires native-linked build")
+	}
+	proof, err := os.ReadFile(proofPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	pi, err := os.ReadFile(piPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(pi) != 198 {
+		t.Fatal("PI length")
+	}
+	t.Setenv("PQ_FULL_VERIFIER_PATH", "/nonexistent/no-worker-fallback")
+	t.Setenv("RISC0_DEV_MODE", "1") // Native compile/context must ignore this request.
+	f := nativeTestProfile()
+	if err := VerifyPQFull(f, pi, proof); err != nil {
+		t.Fatal("actual native verification", err)
+	}
+	for _, offset := range []int{0, 32, 64, 84, 92, 93, 125, 129, 137, 169, 170, 190} {
+		changed := bytes.Clone(pi)
+		changed[offset] ^= 1
+		if err := VerifyPQFull(f, changed, proof); !errors.Is(err, ErrPQInvalidFullProof) {
+			t.Fatalf("PI offset %d not rejected: %v", offset, err)
+		}
+	}
+	for name, altered := range map[string][]byte{"trailing": append(bytes.Clone(proof), 0), "truncated": proof[:len(proof)-1], "malformed": {1, 2, 3}} {
+		if err := VerifyPQFull(f, pi, altered); !errors.Is(err, ErrPQInvalidFullProof) {
+			t.Fatalf("%s not rejected: %v", name, err)
+		}
+	}
+	wrong := *f
+	wrong.ImageID[0] ^= 1
+	if err := VerifyPQFull(&wrong, pi, proof); !errors.Is(err, ErrPQFullUnavailable) {
+		t.Fatalf("wrong configured ImageID accepted: %v", err)
+	}
+	for _, name := range []string{"PQ_NATIVE_COMPOSITE", "PQ_NATIVE_FAKE", "PQ_NATIVE_GROTH16"} {
+		path := os.Getenv(name)
+		if path == "" {
+			t.Logf("%s not provided; Rust ABI corpus separately covers this case", name)
+			continue
+		}
+		other, err := os.ReadFile(path)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := VerifyPQFull(f, pi, other); !errors.Is(err, ErrPQInvalidFullProof) {
+			t.Fatalf("%s accepted: %v", name, err)
+		}
+	}
+	t.Logf("actual backend: Succinct=%d bytes, complete PI=%d bytes, in-process ABI; no target security/hiding claim", len(proof), len(pi))
+}
