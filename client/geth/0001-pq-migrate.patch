+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package catalyst
+
+import (
+	"errors"
+	"github.com/ethereum/go-ethereum/beacon/engine"
+	"github.com/ethereum/go-ethereum/common"
+	"os"
+	"path/filepath"
+	"sync"
+)
+
+type pqFence struct {
+	request common.Hash
+	release func()
+	path    string
+}
+
+var pqFences = struct {
+	sync.Mutex
+	active map[*ConsensusAPI]pqFence
+}{active: make(map[*ConsensusAPI]pqFence)}
+
+func pqSyncParent(path string) error {
+	d, err := os.Open(filepath.Dir(path))
+	if err != nil {
+		return err
+	}
+	defer d.Close()
+	return d.Sync()
+}
+
+// Explicit research method, JWT-authenticated. No TTL unlock: a lost response
+// or client crash must stop duties, and the durable marker prevents EL restart
+// from invalidating an outstanding fence. Ordinary Engine methods keep their
+// locks and cannot cross this fence. This never changes fork-choice targets.
+func (api *ConsensusAPI) PqBeginSigningV1(request common.Hash, expected engine.ForkchoiceStateV1) (PQAppliedState, error) {
+	p := os.Getenv("PQ_LEAN_FENCE_PATH")
+	if !filepath.IsAbs(p) || request == (common.Hash{}) || expected.HeadBlockHash == (common.Hash{}) || expected.SafeBlockHash == (common.Hash{}) || expected.FinalizedBlockHash == (common.Hash{}) {
+		return PQAppliedState{}, errors.New("explicit fence path/request/targets required")
+	}
+	pqFences.Lock()
+	defer pqFences.Unlock()
+	if _, ok := pqFences.active[api]; ok {
+		return PQAppliedState{}, errors.New("fence already active")
+	}
+	api.forkchoiceLock.Lock()
+	api.newPayloadLock.Lock()
+	h, s, f, unlock, err := api.eth.BlockChain().PQHoldSigningHeads()
+	if err != nil {
+		api.newPayloadLock.Unlock()
+		api.forkchoiceLock.Unlock()
+		return PQAppliedState{}, err
+	}
+	release := func() { unlock(); api.newPayloadLock.Unlock(); api.forkchoiceLock.Unlock() }
+	actual := engine.ForkchoiceStateV1{HeadBlockHash: h, SafeBlockHash: s, FinalizedBlockHash: f}
+	if actual != expected {
+		release()
+		return PQAppliedState{}, errors.New("fence targets not applied")
+	}
+	// Install the in-memory fence first. Any persistence uncertainty is fail-stop.
+	pqFences.active[api] = pqFence{request: request, release: release, path: p}
+	marker, err := os.OpenFile(p, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0600)
+	if err != nil {
+		return PQAppliedState{}, err
+	}
+	_, err = marker.WriteString(pqInstance().Hex() + "\n" + request.Hex() + "\n")
+	if err == nil {
+		err = marker.Sync()
+	}
+	closeErr := marker.Close()
+	if err == nil {
+		err = closeErr
+	}
+	if err == nil {
+		err = pqSyncParent(p)
+	}
+	if err != nil {
+		return PQAppliedState{}, err
+	}
+	return PQAppliedState{Instance: pqInstance(), Request: request, Applied: actual}, nil
+}
+
+func (api *ConsensusAPI) PqEndSigningV1(instance common.Hash, request common.Hash) (bool, error) {
+	pqFences.Lock()
+	defer pqFences.Unlock()
+	f, ok := pqFences.active[api]
+	if !ok || instance != pqInstance() || request != f.request {
+		return false, errors.New("wrong or missing fence identity")
+	}
+	if err := os.Remove(f.path); err != nil {
+		return false, err
+	}
+	if err := pqSyncParent(f.path); err != nil {
+		return false, err
+	}
+	delete(pqFences.active, api)
+	f.release()
+	return true, nil
+}
