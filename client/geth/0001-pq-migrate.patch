diff --git a/core/pq_migrate.go b/core/pq_migrate.go
new file mode 100644
index 0000000000000000000000000000000000000000..4d36ff08f4d231ac6b845d0c71629b1d62b2379a
--- /dev/null
+++ b/core/pq_migrate.go
@@ -0,0 +1,371 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+// Research-only Route A single. No proof-verification bypass exists.
+package core
+
+import (
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"math"
+	"math/big"
+	"time"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core/state"
+	"github.com/ethereum/go-ethereum/core/tracing"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/core/vm"
+	"github.com/ethereum/go-ethereum/crypto"
+	"github.com/ethereum/go-ethereum/log"
+	"github.com/ethereum/go-ethereum/params"
+	"github.com/holiman/uint256"
+)
+
+type PQMigrationError struct {
+	Name  string
+	Code  uint16
+	Cause error
+}
+
+func (e *PQMigrationError) Error() string           { return fmt.Sprintf("%s (0x%04x)", e.Name, e.Code) }
+func (e *PQMigrationError) ErrorCode() int          { return int(e.Code) }
+func (e *PQMigrationError) Unwrap() error           { return e.Cause }
+func pqMigrateError(name string, code uint16) error { return &PQMigrationError{Name: name, Code: code} }
+
+type pqMigrationExecution struct {
+	tx            *types.PQMigrateTx
+	previous      PQRecord
+	next          PQRecord
+	gasUsed       uint64
+	reimbursement *uint256.Int
+}
+
+// ValidatePQMigrateState performs canonical, configuration, time, account,
+// balance, intrinsic-gas and real sponsor-signature checks, but NOT Full.
+// It is a precheck only, never authorization to insert or execute a transaction.
+// Callers outside execution must supply a disposable StateDB copy. It is the
+// pool's call site, so the sponsor signature may be taken from the negative cache.
+func ValidatePQMigrateState(tx *types.Transaction, s *state.StateDB, h *types.Header, c *params.ChainConfig) error {
+	_, err := validatePQMigrateStateWith(tx, s, h, c, verifyPQMigrationSignatureAt)
+	return err
+}
+
+// ValidatePQMigrateStateWithSponsorPolicy runs pool-only cheap sponsor checks
+// before the actual sponsor signature. A policy callback cannot authorize a
+// transaction: all state checks and the real signature still have to pass.
+func ValidatePQMigrateStateWithSponsorPolicy(tx *types.Transaction, s *state.StateDB, h *types.Header, c *params.ChainConfig, policy func() error) error {
+	_, err := validatePQMigrateStateWith(tx, s, h, c, verifyPQMigrationSignatureAt, policy)
+	return err
+}
+
+func ValidatePQMigrateForPool(tx *types.Transaction, s *state.StateDB, h *types.Header, c *params.ChainConfig) error {
+	if err := ValidatePQMigrateState(tx, s, h, c); err != nil {
+		return err
+	}
+	return ValidatePQMigrateProof(tx, c, "admission")
+}
+
+// ValidatePQMigrateProof is only the pure last check. It cannot replace the
+// preceding state/time/sponsor checks. Backend failure is propagated unchanged
+// so it is distinguishable from a determinate cryptographic rejection.
+func ValidatePQMigrateProof(tx *types.Transaction, c *params.ChainConfig, context string) error {
+	p, ok := tx.AsPQMigrate()
+	if !ok || c == nil || c.PQMigrate == nil || c.PQMigrate.FullResearch == nil {
+		return errors.New("PQ_FULL_RESEARCH_DISABLED")
+	}
+	if err := p.ValidateShape(); err != nil {
+		return err
+	}
+	f := c.PQMigrate.FullResearch
+	if p.VerifierVersion != f.Version || p.ProofCarrier.Route != 0 {
+		return pqMigrateError("WRONG_VERIFIER_VERSION", 0x0006)
+	}
+	if uint64(len(p.ProofCarrier.Proof)) > f.MaxProofBytes {
+		return pqMigrateError("PROOF_TOO_LARGE", 0x0008)
+	}
+	pi := p.PublicInputs()
+	start := time.Now()
+	err := VerifyPQFull(f, pi, p.ProofCarrier.Proof)
+	log.Info("PQ Full check", "context", context, "tx", tx.Hash(), "pi", crypto.Keccak256Hash(pi), "proof", crypto.Keccak256Hash(p.ProofCarrier.Proof), "duration", time.Since(start), "err", err)
+	if errors.Is(err, ErrPQInvalidFullProof) {
+		return &PQMigrationError{Name: "INVALID_PROOF", Code: 0x0402, Cause: err}
+	}
+	return err
+}
+func pqRecordWord(r PQRecord) common.Hash {
+	var w common.Hash
+	w[31], w[30] = r.Mode, r.AlgID
+	binary.BigEndian.PutUint64(w[22:30], r.EnrolledAt)
+	binary.BigEndian.PutUint64(w[14:22], r.MigrationNonce)
+	return w
+}
+func pqColdWriteGas(before, after common.Hash) uint64 {
+	if before == after {
+		return 2200
+	}
+	if before == (common.Hash{}) {
+		return 22100
+	}
+	return 5000
+}
+
+// ValidatePQMigrateOwnerState checks only the owner gate and migration nonce.
+// Pool reset uses it before attributing failures to a sponsor. Passing this
+// precheck does not authorize a transaction: fees, signatures and proof remain.
+func ValidatePQMigrateOwnerState(p *types.PQMigrateTx, s vm.StateDB, h *types.Header, c *params.ChainConfig) error {
+	if p == nil {
+		return ErrTxTypeNotSupported
+	}
+	if c == nil || c.PQMigrate == nil || h == nil {
+		return pqMigrateError("FORK_NOT_ACTIVE", 0x0001)
+	}
+	return validatePQMigrateOwnerState(p, ReadPQRecord(s, c.PQMigrate.Registry, p.LegacyAddress), s.GetCode(p.LegacyAddress), h.Time, c.PQMigrate)
+}
+
+func validatePQMigrateOwnerState(p *types.PQMigrateTx, r PQRecord, code []byte, timestamp uint64, cfg *params.PQMigrateConfig) error {
+	if timestamp < cfg.T0 {
+		return pqMigrateError("FORK_NOT_ACTIVE", 0x0001)
+	}
+	switch r.Mode {
+	case 2, 3:
+		if r.Mode != 2 || len(code) != 0 {
+			return pqMigrateError("ALREADY_MIGRATED", 0x0103)
+		}
+	case 1:
+		start := max(r.EnrolledAt, cfg.T)
+		// Use a difference rather than overflowing max(enrolledAt,T)+W.
+		if timestamp >= start && timestamp-start >= cfg.W {
+			return pqMigrateError("OVERRIDE_WINDOW_CLOSED", 0x0104)
+		}
+	case 0:
+		if _, delegated := types.ParseDelegation(code); len(code) != 0 && !delegated {
+			return pqMigrateError("NOT_AN_EOA", 0x0102)
+		}
+		if timestamp < cfg.T && !cfg.LegacySeedProofFromT0 {
+			return pqMigrateError("FORK_NOT_ACTIVE", 0x0001)
+		}
+		if r != (PQRecord{}) {
+			return errors.New("BAD_REGISTRY_STATE")
+		}
+	default:
+		return errors.New("BAD_REGISTRY_STATE")
+	}
+	if r.MigrationNonce == math.MaxUint64 || p.MigrationNonce != r.MigrationNonce {
+		return pqMigrateError("WRONG_MIGRATION_NONCE", 0x0105)
+	}
+	return nil
+}
+
+// validatePQMigrateState is the check of block building and import, which
+// verifies the sponsor signature again (spec l. 2808).
+func validatePQMigrateState(tx *types.Transaction, s vm.StateDB, h *types.Header, c *params.ChainConfig) (*pqMigrationExecution, error) {
+	return validatePQMigrateStateWith(tx, s, h, c, verifyPQMigrationSignatureInBlock)
+}
+func validatePQMigrateStateWith(tx *types.Transaction, s vm.StateDB, h *types.Header, c *params.ChainConfig, checkSig pqSignatureCheck, sponsorPolicy ...func() error) (*pqMigrationExecution, error) {
+	p, ok := tx.AsPQMigrate()
+	if !ok {
+		return nil, ErrTxTypeNotSupported
+	}
+	if c == nil || c.PQMigrate == nil || h.Time < c.PQMigrate.T0 {
+		return nil, pqMigrateError("FORK_NOT_ACTIVE", 0x0001)
+	}
+	if err := p.ValidateShape(); err != nil {
+		return nil, pqMigrateError("NON_CANONICAL_ENCODING", 0x0003)
+	}
+	cfg := c.PQMigrate
+	f := cfg.FullResearch
+	if f == nil {
+		return nil, errors.New("PQ_FULL_RESEARCH_DISABLED")
+	}
+	if c.IsAmsterdam(h.Number, h.Time) || c.IsEIP4762(h.Number, h.Time) || !c.IsOsaka(h.Number, h.Time) {
+		return nil, errors.New("PQ_RESEARCH_UNSUPPORTED_FORK")
+	}
+	if uint64(len(p.ProofCarrier.Proof)) > f.MaxProofBytes {
+		return nil, pqMigrateError("PROOF_TOO_LARGE", 0x0008)
+	}
+	if p.AlgID != 1 {
+		return nil, pqMigrateError("UNSUPPORTED_PQ_SCHEME", 0x0007)
+	}
+	if uint64(tx.Size()) > f.MaxTxBytes {
+		return nil, errors.New("PQ_TX_TOO_LARGE")
+	}
+	if p.ChainID.Cmp(c.ChainID) != 0 {
+		return nil, pqMigrateError("WRONG_CHAIN_ID", 0x0004)
+	}
+	if p.VerifierVersion != f.Version || h.Time < f.Activation || h.Time >= f.Sunset || p.ProofCarrier.Route != 0 {
+		return nil, pqMigrateError("WRONG_VERIFIER_VERSION", 0x0006)
+	}
+	if h.Time > p.Expiry {
+		return nil, pqMigrateError("PROOF_EXPIRED", 0x0201)
+	}
+	// Subtraction after the lower-bound check never wraps at uint64 boundaries.
+	if p.Expiry-h.Time > f.ProofLifetime {
+		return nil, pqMigrateError("EXPIRY_TOO_FAR", 0x0202)
+	}
+	pqWarm(s, cfg.Registry, p.LegacyAddress, true)
+	r := ReadPQRecord(s, cfg.Registry, p.LegacyAddress)
+	code := s.GetCode(p.LegacyAddress)
+	if err := validatePQMigrateOwnerState(p, r, code, h.Time, cfg); err != nil {
+		return nil, err
+	}
+	sponsor := p.SponsorOption
+	payer := p.LegacyAddress
+	if sponsor != nil {
+		payer = sponsor.Sponsor
+		pqWarm(s, cfg.Registry, payer, true)
+		if !PQActivated(s, cfg, payer) {
+			return nil, pqMigrateError("NOT_PQ_ACCOUNT", 0x0106)
+		}
+		if h.Time > sponsor.ValidUntil {
+			return nil, pqMigrateError("SPONSOR_EXPIRED", 0x0309)
+		}
+	}
+	need := new(big.Int).Mul(new(big.Int).SetUint64(p.Gas), p.GasFeeCap)
+	// Shape validation makes an absent sponsor exactly mode 0. Its gross
+	// maximum debit is authorized by PI, including when the product exceeds
+	// uint256; neither a later refund nor a coinbase credit can satisfy it.
+	if sponsor == nil && need.Cmp(p.MaxAccountFee) > 0 {
+		return nil, pqMigrateError("FEE_CAP_EXCEEDED", 0x0301)
+	}
+	if need.BitLen() > 256 || s.GetBalance(payer).CmpBig(need) < 0 {
+		return nil, pqMigrateError("INSUFFICIENT_FEE_BALANCE", 0x0302)
+	}
+	if p.GasTipCap.Cmp(p.GasFeeCap) > 0 {
+		return nil, ErrTipAboveFeeCap
+	}
+	if h.BaseFee != nil && p.GasFeeCap.Cmp(h.BaseFee) < 0 {
+		return nil, ErrFeeCapTooLow
+	}
+	if p.Gas > params.MaxTxGas || p.Gas > f.TxGasCap {
+		return nil, ErrGasLimitTooHigh
+	}
+	next := PQRecord{Mode: 2, AlgID: p.AlgID, EnrolledAt: r.EnrolledAt, MigrationNonce: r.MigrationNonce + 1, Commit: p.PQPKCommit}
+	writeGas := pqColdWriteGas(pqRecordWord(r), pqRecordWord(next)) + pqColdWriteGas(r.Commit, next.Commit)
+	var tokens uint64
+	for _, b := range p.ProofCarrier.Proof {
+		if b == 0 {
+			tokens++
+		} else {
+			tokens += 4
+		}
+	}
+	var signatureGas uint64
+	if sponsor != nil {
+		signatureGas = PQSignatureGas
+		for _, b := range sponsor.Signature {
+			if b == 0 {
+				tokens++
+			} else {
+				tokens += 4
+			}
+		}
+	}
+	if f.VerifyGas > math.MaxUint64-21000-signatureGas-writeGas || tokens > (math.MaxUint64-21000-f.VerifyGas-signatureGas-writeGas)/10 {
+		return nil, ErrGasUintOverflow
+	}
+	used := uint64(21000) + max(4*tokens+f.VerifyGas+signatureGas+writeGas, 10*tokens)
+	if p.Gas < used {
+		return nil, fmt.Errorf("%w: have %d want %d", ErrIntrinsicGas, p.Gas, used)
+	}
+	reimburse := new(uint256.Int)
+	if sponsor != nil {
+		for _, policy := range sponsorPolicy {
+			if err := policy(); err != nil {
+				return nil, err
+			}
+		}
+		// Pure FIPS 204, actual current sponsor key. No caller-supplied key, no
+		// prehash variant, and no signature cache keyed just by transaction hash.
+		sponsorCode := s.GetCode(sponsor.Sponsor)
+		if !checkSig(c, h, sponsorCode[3:], "ETH-PQ-SPONSOR/v1", p.SponsorSigningHash(), sponsor.Signature) {
+			return nil, pqMigrateError("BAD_SPONSOR_SIG", 0x0403)
+		}
+		if h.Time <= p.FeeAuthUntil && (p.FeeMode == 3 || (p.FeeMode == 1 && sponsor.Sponsor == p.FeeSponsor)) {
+			reimburse.Set(s.GetBalance(p.LegacyAddress))
+			cap := uint256.MustFromBig(p.MaxAccountFee)
+			if reimburse.Cmp(cap) > 0 {
+				reimburse.Set(cap)
+			}
+		}
+	}
+	return &pqMigrationExecution{p, r, next, used, reimburse}, nil
+}
+
+// applyPQMigrate is called by ApplyMessage for both building and importing.
+// There is no ordinary nonce check/write, no EVM call, and no fabricated signer.
+func applyPQMigrate(evm *vm.EVM, msg *Message, gp *GasPool) (*ExecutionResult, error) {
+	tx := msg.PQTransaction
+	p, ok := tx.AsPQMigrate()
+	if !ok {
+		return nil, ErrTxTypeNotSupported
+	}
+	if err := p.ValidateShape(); err != nil {
+		return nil, err
+	}
+	s := evm.StateDB
+	c := evm.ChainConfig()
+	// Exactly one Prepare, preceding all stateful validity reads. No access list
+	// is carried by 0x7e, so the storage-key access set starts empty.
+	s.Prepare(evm.GetRules(), p.LegacyAddress, evm.Context.Coinbase, tx.To(), vm.ActivePrecompiles(evm.GetRules()), nil)
+	snapshot := s.Snapshot()
+	h := &types.Header{Number: evm.Context.BlockNumber, Time: evm.Context.Time, BaseFee: evm.Context.BaseFee, Difficulty: new(big.Int)}
+	plan, err := validatePQMigrateState(tx, s, h, c)
+	if err == nil {
+		err = ValidatePQMigrateProof(tx, c, "execution")
+	}
+	if err != nil {
+		s.RevertToSnapshot(snapshot)
+		return nil, err
+	}
+	beforeGas := gp.Snapshot()
+	if err = gp.CheckGasLegacy(p.Gas); err != nil {
+		s.RevertToSnapshot(snapshot)
+		return nil, err
+	}
+	if err = gp.ChargeGasLegacy(p.Gas-plan.gasUsed, plan.gasUsed); err != nil {
+		gp.Set(beforeGas)
+		s.RevertToSnapshot(snapshot)
+		return nil, err
+	}
+	payer := p.LegacyAddress
+	if p.SponsorOption != nil {
+		payer = p.SponsorOption.Sponsor
+	}
+	price := new(big.Int).Set(p.GasFeeCap)
+	if h.BaseFee != nil {
+		candidate := new(big.Int).Add(h.BaseFee, p.GasTipCap)
+		if candidate.Cmp(price) < 0 {
+			price = candidate
+		}
+	}
+	bought := new(uint256.Int).Mul(uint256.NewInt(p.Gas), uint256.MustFromBig(price))
+	s.SubBalance(payer, bought, tracing.BalanceDecreaseGasBuy)
+	if !plan.reimbursement.IsZero() {
+		s.SubBalance(p.LegacyAddress, plan.reimbursement, tracing.BalanceChangeTransfer)
+		s.AddBalance(payer, plan.reimbursement, tracing.BalanceChangeTransfer)
+	}
+	writePQRecord(s, c.PQMigrate.Registry, p.LegacyAddress, plan.next)
+	s.SetCode(p.LegacyAddress, nil, tracing.CodeChangeUnspecified)
+	data := make([]byte, 160)
+	data[31] = plan.next.AlgID
+	copy(data[32:64], plan.next.Commit[:])
+	binary.BigEndian.PutUint64(data[88:96], plan.next.MigrationNonce)
+	if plan.previous.Mode == 1 {
+		data[127] = 1
+	}
+	if plan.previous.Mode == 2 {
+		data[159] = 1
+	}
+	s.AddLog(&types.Log{Address: c.PQMigrate.Registry, Topics: []common.Hash{crypto.Keccak256Hash([]byte("Migrated(address,uint8,bytes32,uint64,bool,bool)")), common.BytesToHash(p.LegacyAddress[:])}, Data: data})
+	returned := new(uint256.Int).Mul(uint256.NewInt(p.Gas-plan.gasUsed), uint256.MustFromBig(price))
+	s.AddBalance(payer, returned, tracing.BalanceIncreaseGasReturn)
+	tip := new(big.Int).Set(price)
+	if h.BaseFee != nil {
+		tip.Sub(tip, h.BaseFee)
+	}
+	reward := new(uint256.Int).Mul(uint256.NewInt(plan.gasUsed), uint256.MustFromBig(tip))
+	s.AddBalance(evm.Context.Coinbase, reward, tracing.BalanceIncreaseRewardTransactionFee)
+	return &ExecutionResult{UsedGas: plan.gasUsed, MaxUsedGas: plan.gasUsed}, nil
+}
