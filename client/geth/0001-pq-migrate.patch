+	bc := &BlockChain{db: db, triedb: td, chainConfig: cfg}
+	if bc.PQBridgeStateReady(anchor) {
+		t.Fatal("root-only H accepted without trust")
+	}
+	pqRuntimeRecord(t, db, cfg)
+	if !bc.PQBridgeStateReady(anchor) {
+		t.Fatal("authenticated fixed H not ready")
+	}
+	child := types.NewBlockWithHeader(&types.Header{ParentHash: anchor.Hash(), Number: new(big.Int).SetUint64(params.PQBridgeAnchorNumber + 1), Time: 1753185612, Difficulty: big.NewInt(0), Root: types.EmptyRootHash, ReceiptHash: types.EmptyReceiptsHash})
