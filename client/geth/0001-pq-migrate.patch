@@ -0,0 +1,186 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package legacypool
+
+import (
+	"encoding/binary"
+	"errors"
+	"math/big"
+	"sync/atomic"
+	"testing"
+
+	"github.com/cloudflare/circl/sign/mldsa/mldsa44"
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core"
+	"github.com/ethereum/go-ethereum/core/tracing"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/crypto"
+	"github.com/ethereum/go-ethereum/params"
+	"github.com/holiman/uint256"
+)
+
+func heldAuthorityRecord(p *LegacyPool, owner common.Address, pk *mldsa44.PublicKey, mode byte, migrationNonce uint64, activated bool) {
+	slot, commitment := core.PQRecordSlots(owner)
+	word := common.Hash{}
+	word[31], word[30] = mode, 1
+	binary.BigEndian.PutUint64(word[14:22], migrationNonce)
+	p.currentState.SetState(p.chainconfig.PQMigrate.Registry, slot, word)
+	p.currentState.SetState(p.chainconfig.PQMigrate.Registry, commitment, core.PQKeyCommit(1, pk.Bytes()))
+	var code []byte
+	if activated {
+		code = append([]byte{0xef, 1, 1}, pk.Bytes()...)
+	}
+	p.currentState.SetCode(owner, code, tracing.CodeChangeUnspecified)
+}
+
+func heldAuthorityTx(t *testing.T, cfg *params.ChainConfig, owner common.Address, pk *mldsa44.PublicKey, sk *mldsa44.PrivateKey, nonce uint64, activate bool) *types.Transaction {
+	t.Helper()
+	pq := &types.PQTx{ChainID: cfg.ChainID, From: owner, Nonce: nonce, GasTipCap: big.NewInt(1), GasFeeCap: big.NewInt(1), Gas: 1000000, To: common.Address{}, Value: new(big.Int), AlgID: 1, Signature: make([]byte, mldsa44.SignatureSize)}
+	if activate {
+		pq.PublicKey = [][]byte{pk.Bytes()}
+	}
+	digest := pq.SigningHash()
+	tag := []byte("ETH-PQ-TX/v1")
+	if err := mldsa44.SignTo(sk, append(append([]byte{}, tag...), digest[:]...), tag, false, pq.Signature); err != nil {
+		t.Fatal(err)
+	}
+	return types.NewTx(pq)
+}
+
+// These transactions remain in the pool throughout the head change: none is
+// mined or reinjected. Real ML-DSA signatures distinguish stale key authority
+// from an ordinary nonce change. The registry fixtures model the post-write
+// state; migration proofs and the rotation EVM transition are tested elsewhere.
+func TestPQHeldAuthorityRevalidated(t *testing.T) {
+	for _, transition := range []string{"override", "rotation"} {
+		t.Run(transition, func(t *testing.T) {
+			cfg := *params.TestChainConfig
+			cfg.PQMigrate = &params.PQMigrateConfig{T0: 100, T: 2000, PoolSlotSeconds: 12, Registry: common.HexToAddress("800"), MaxPayloadBytes: 1048576}
+			p, _ := setupPoolWithConfig(&cfg)
+			defer p.Close()
+			owner := common.HexToAddress("1234")
+			oldSeed, newSeed := [mldsa44.SeedSize]byte{0x81}, [mldsa44.SeedSize]byte{0x82}
+			oldPK, oldSK := mldsa44.NewKeyFromSeed(&oldSeed)
+			newPK, newSK := mldsa44.NewKeyFromSeed(&newSeed)
+			p.currentState.SetBalance(owner, uint256.NewInt(1000000000), tracing.BalanceChangeUnspecified)
+			initialNonce := uint64(2)
+			mode := byte(1)
+			if transition == "rotation" {
+				initialNonce, mode = 1, 2
+			}
+			p.currentState.SetNonce(owner, initialNonce, tracing.NonceChangeUnspecified)
+			heldAuthorityRecord(p, owner, oldPK, mode, 1, true)
+			row7Reset(t, p, 200)
+			pending := heldAuthorityTx(t, &cfg, owner, oldPK, oldSK, 2, false)
+			gapped := heldAuthorityTx(t, &cfg, owner, oldPK, oldSK, 10, false)
+			row7Add(t, p, pending, gapped)
+			row7Reset(t, p, 212)
+			if p.Get(pending.Hash()) == nil || p.Get(gapped.Hash()) == nil {
+				t.Fatal("unchanged authority or nonce gap was evicted")
+			}
+
+			// Override leaves nonce 2 unchanged. Rotation consumes nonce 1,
+			// so neither held transaction is stale by its ordinary nonce.
+			p.currentState.SetNonce(owner, 2, tracing.NonceChangeUnspecified)
+			heldAuthorityRecord(p, owner, newPK, 2, 2, transition == "rotation")
+			row7Reset(t, p, 224)
+			if p.Get(pending.Hash()) != nil || p.Get(gapped.Hash()) != nil {
+				t.Fatal("continuously held old-key transaction survived reset")
+			}
+			if count, queued := p.Stats(); count != 0 || queued != 0 || p.Nonce(owner) != 2 {
+				t.Fatalf("stale nonce reservation: pending=%d queued=%d next=%d", count, queued, p.Nonce(owner))
+			}
+			replacement := heldAuthorityTx(t, &cfg, owner, newPK, newSK, 2, transition == "override")
+			row7Add(t, p, replacement)
+			if count, queued := p.Stats(); count != 1 || queued != 0 {
+				t.Fatalf("owner could not use the same nonce and fees: %d/%d", count, queued)
+			}
+			if p.currentState.GetNonce(owner) != 2 {
+				t.Fatal("pool revalidation changed the account nonce")
+			}
+		})
+	}
+}
+
+func TestPQHeldAuthorityLocalStateFailureIsNotRejection(t *testing.T) {
+	cfg := *params.TestChainConfig
+	cfg.PQMigrate = &params.PQMigrateConfig{T0: 100, T: 2000, PoolSlotSeconds: 12, Registry: common.HexToAddress("800"), MaxPayloadBytes: 1048576}
+	p, _ := setupPoolWithConfig(&cfg)
+	defer p.Close()
+	owner := common.HexToAddress("1234")
+	seed := [mldsa44.SeedSize]byte{0x83}
+	pk, sk := mldsa44.NewKeyFromSeed(&seed)
+	p.currentState.SetBalance(owner, uint256.NewInt(1000000000), tracing.BalanceChangeUnspecified)
+	heldAuthorityRecord(p, owner, pk, 2, 1, true)
+	row7Reset(t, p, 200)
+	tx := heldAuthorityTx(t, &cfg, owner, pk, sk, 0, false)
+	row7Add(t, p, tx)
+	p.mu.Lock()
+	p.currentState.SetCode(owner, nil, tracing.CodeChangeUnspecified)
+	p.currentState.SetExternalError(errors.New("test missing registry data"))
+	p.evictPQLegacy()
+	p.mu.Unlock()
+	if p.Get(tx.Hash()) == nil {
+		t.Fatal("local state failure was classified as lost authority")
+	}
+}
+
+// A base-fee rise changes executability, not the authenticated account key.
+// Admission performs one real ML-DSA check; two unchanged heads reuse it.
+func TestPQHeldAuthorityIgnoresBaseFeeAndCachesSignature(t *testing.T) {
+	for _, kind := range []string{"activated", "activation", "first-spend"} {
+		t.Run(kind, func(t *testing.T) {
+			cfg := *params.TestChainConfig
+			cfg.PQMigrate = &params.PQMigrateConfig{T0: 100, T: 2000, PoolSlotSeconds: 12, Registry: common.HexToAddress("800"), MaxPayloadBytes: 131072}
+			p, _ := setupPoolWithConfig(&cfg)
+			defer p.Close()
+			seed := [mldsa44.SeedSize]byte{0x91}
+			pk, sk := mldsa44.NewKeyFromSeed(&seed)
+			owner := common.HexToAddress("1234")
+			if kind == "first-spend" {
+				owner = common.BytesToAddress(crypto.Keccak256([]byte("PQ-ADDR"), []byte{1}, pk.Bytes())[12:])
+			}
+			p.currentState.SetBalance(owner, uint256.NewInt(1000000000), tracing.BalanceChangeUnspecified)
+			if kind != "first-spend" {
+				heldAuthorityRecord(p, owner, pk, 2, 1, kind == "activated")
+			}
+			row7Reset(t, p, 200)
+			var calls atomic.Uint64
+			realCheck := p.pqSignatureCheck
+			p.pqSignatureCheck = func(c *params.ChainConfig, h *types.Header, pk []byte, tag string, d common.Hash, sig []byte) bool {
+				calls.Add(1)
+				return realCheck(c, h, pk, tag, d, sig)
+			}
+			tx := heldAuthorityTx(t, &cfg, owner, pk, sk, 0, kind != "activated")
+			row7Add(t, p, tx)
+			if calls.Load() != 1 {
+				t.Fatalf("admission signature checks=%d", calls.Load())
+			}
+			for _, at := range []uint64{212, 224} {
+				head := types.CopyHeader(p.currentHead.Load())
+				head.Time = at
+				head.BaseFee = big.NewInt(2)
+				<-p.requestReset(nil, head)
+				if p.Get(tx.Hash()) == nil {
+					t.Fatal("base-fee rise evicted held PQ authority")
+				}
+				if calls.Load() != 1 {
+					t.Fatalf("unchanged authority was reverified: %d", calls.Load())
+				}
+				if err := validatePoolInternals(p); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if kind == "activated" {
+				replacementSeed := [mldsa44.SeedSize]byte{0x92}
+				newPK, _ := mldsa44.NewKeyFromSeed(&replacementSeed)
+				heldAuthorityRecord(p, owner, newPK, 2, 2, true)
+				row7Reset(t, p, 236)
+				if p.Get(tx.Hash()) != nil || calls.Load() != 2 {
+					t.Fatalf("changed key reused successful signature: retained=%t checks=%d", p.Get(tx.Hash()) != nil, calls.Load())
+				}
+			}
+		})
+	}
+}
