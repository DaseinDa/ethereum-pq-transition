+	gql "github.com/graph-gophers/graphql-go"
+)
+
+func TestPQBatchGraphQLSubmissionAndDestination(t *testing.T) {
+	batch := &types.PQBatchTx{ChainID: big.NewInt(13378), Sponsor: common.Address{9}, SponsorValidUntil: 100,
+		GasTipCap: big.NewInt(1), GasFeeCap: big.NewInt(2), Gas: 16000000, VerifierVersion: 0x80000008,
+		ProofCarrier: types.PQMigrationCarrier{Proof: []byte("dispatch-only fixture")}}
+	for i := byte(1); i <= 4; i++ {
+		batch.Entries = append(batch.Entries, types.PQBatchEntry{LegacyAddress: common.Address{i}, AlgID: 1, PQPKCommit: common.Hash{i}, Expiry: 100, MaxAccountFee: new(big.Int), FeeMode: 2})
+	}
+	tx := types.NewTx(batch)
+	raw, err := tx.MarshalBinary()
+	if err != nil {
+		t.Fatal(err)
+	}
+	backend := new(pqGraphBackend)
+	schema, err := gql.ParseSchema(schema, &Resolver{backend: backend})
+	if err != nil {
+		t.Fatal(err)
+	}
+	result := schema.Exec(context.Background(), `mutation { sendRawTransaction(data: "`+hexutil.Encode(raw)+`") }`, "", nil)
+	if len(result.Errors) != 1 || result.Errors[0].Extensions["reason"] != "WRONG_MIGRATION_NONCE" || backend.calls != 1 {
+		t.Fatalf("batch dispatch: %+v", result)
+	}
+	resolved := &Transaction{tx: tx, hash: tx.Hash()}
+	if resolved.To(context.Background(), BlockNumberArgs{}) != nil {
+		t.Fatal("batch has no destination")
+	}
+}
