+package pqpool
+
+// Historical external-worker/Composite mode-0 component fixtures. This file
+// shares the pq_historical tag with actualHistoricalProfile's definition in
+// full_integration_test.go. Current-F admission and held-reset boundaries live
+// in pq_final_boundaries_test.go; these archived helpers are not default tests.
+import (
+	"bytes"
+	"crypto/sha256"
