+func TestPQBridgeEngineMissingNodeSamePayloadRetry(t *testing.T) {
+	repo := os.Getenv("PQ_BRIDGE_TEST_ROOT")
+	if repo == "" {
+		t.Skip("set PQ_BRIDGE_TEST_ROOT to the frozen state-bridge workspace")
+	}
+	if os.Getenv("PQ_FULL_VERIFIER_PATH") == "" {
+		t.Skip("set PQ_FULL_VERIFIER_PATH for the legacy bridge worker")
+	}
+	t.Setenv("RISC0_DEV_MODE", "0")
+	aDir, bDir := bridgeTestImport(t, repo, "A"), bridgeTestImport(t, repo, "B")
+	a, ea := bridgeTestStart(t, aDir)
+	defer a.Close()
+	b, eb := bridgeTestStart(t, bDir)
+	defer func() {
+		if b != nil {
+			b.Close()
+		}
+	}()
+	if ea.BlockChain().CurrentBlock().Hash() != params.PQBridgeAnchorHash || eb.BlockChain().CurrentBlock().Hash() != params.PQBridgeAnchorHash {
+		t.Fatal("not at fixed real anchor")
+	}
+	apiA, apiB := newConsensusAPIWithoutHeartbeat(ea), newConsensusAPIWithoutHeartbeat(eb)
+	timestamp := ea.BlockChain().Config().PQMigrate.T0 + 12
+	beaconRoot := crypto.Keccak256Hash([]byte("public-engine-retry-fixture"))
+	attributes := &engine.PayloadAttributes{Timestamp: timestamp,
+		Random:                crypto.Keccak256Hash([]byte("public-engine-randao-fixture")),
+		SuggestedFeeRecipient: common.HexToAddress("0xdadb0d80178819f2319190d340ce9a924f783711"),
+		Withdrawals:           []*types.Withdrawal{}, BeaconRoot: &beaconRoot}
+	envelope, err := assembleEnvelope(apiA, params.PQBridgeAnchorHash, attributes)
+	if err != nil {
+		t.Fatal(err)
+	}
+	payload := envelope.ExecutionPayload
+	requests := make([]hexutil.Bytes, len(envelope.Requests))
+	for i, request := range envelope.Requests {
+		requests[i] = request
+	}
+	if len(payload.Transactions) != 0 || len(payload.Withdrawals) != 0 {
+		t.Fatal("this regression must use an empty first child")
+	}
+	key, original := bridgeTestRequiredNode(t, repo, timestamp)
+	if actual := rawdb.ReadLegacyTrieNode(eb.ChainDb(), key); !bytes.Equal(actual, original) {
+		t.Fatal("original fixed-H node differs from RPC proof")
+	}
+	if err = eb.ChainDb().Delete(key[:]); err != nil {
+		t.Fatal(err)
+	}
+	if len(rawdb.ReadLegacyTrieNode(eb.ChainDb(), key)) != 0 {
+		t.Fatal("node deletion did not take effect")
+	}
+	first, err := apiB.NewPayloadV4(context.Background(), *payload, []common.Hash{}, &beaconRoot, requests)
+	if err != nil || first.Status != engine.SYNCING {
+		t.Fatalf("missing node: want SYNCING without error, got %+v, %v", first, err)
+	}
+	if eb.BlockChain().CurrentBlock().Hash() != params.PQBridgeAnchorHash {
+		t.Fatal("failed attempt advanced head")
+	}
+	if eb.BlockChain().GetBlockByHash(payload.BlockHash) != nil {
+		t.Fatal("failed attempt stored a block")
+	}
+	if rawdb.ReadBadBlock(eb.ChainDb(), payload.BlockHash) != nil {
+		t.Fatal("missing data written to bad-block store")
+	}
+	if apiB.checkInvalidAncestor(payload.BlockHash, payload.BlockHash) != nil {
+		t.Fatal("missing data entered Engine invalid cache")
+	}
+	rawdb.WriteLegacyTrieNode(eb.ChainDb(), key, original)
+	second, err := apiB.NewPayloadV4(context.Background(), *payload, []common.Hash{}, &beaconRoot, requests)
+	if err != nil || second.Status != engine.VALID {
+		t.Fatalf("same payload after supplementation: want VALID, got %+v, %v", second, err)
+	}
+	imported := eb.BlockChain().GetBlockByHash(payload.BlockHash)
+	if imported == nil || !eb.BlockChain().PQBridgeStateReady(imported) {
+		t.Fatal("successful retry has no durable execution record")
+	}
+	if eb.BlockChain().CurrentBlock().Hash() != params.PQBridgeAnchorHash {
+		t.Fatal("newPayload unexpectedly changed canonical head")
+	}
+	choice, err := apiB.ForkchoiceUpdatedV3(context.Background(), engine.ForkchoiceStateV1{
+		HeadBlockHash: payload.BlockHash, SafeBlockHash: params.PQBridgeAnchorHash,
+		FinalizedBlockHash: params.PQBridgeAnchorHash}, nil)
+	if err != nil || choice.PayloadStatus.Status != engine.VALID {
+		t.Fatalf("forkchoice: %+v %v", choice, err)
+	}
+	if eb.BlockChain().CurrentBlock().Hash() != payload.BlockHash {
+		t.Fatal("successful forkchoice did not advance head")
+	}
+	t.Logf("PQ_BRIDGE_ENGINE_RETRY anchor=%s payload=%s missing_node=%s first=%s second=%s badblock=false invalid_cache=false root=%s", params.PQBridgeAnchorHash, payload.BlockHash, key, first.Status, second.Status, payload.StateRoot)
+	// Keep header/body/state root, but simulate loss of the local execution
+	// marker. The known-block shortcut must not accept it without execution.
+	marker := append([]byte("pq-bridge-executed-v1:"), payload.BlockHash[:]...)
+	if err = eb.ChainDb().Delete(marker); err != nil {
+		t.Fatal(err)
+	}
+	if err = eb.ChainDb().Delete(key[:]); err != nil {
+		t.Fatal(err)
+	}
+	if err = eb.ChainDb().SyncKeyValue(); err != nil {
+		t.Fatal(err)
+	}
+	if err = b.Close(); err != nil {
+		t.Fatal(err)
+	}
+	b = nil
+	b, eb = bridgeTestStart(t, bDir)
+	apiB = newConsensusAPIWithoutHeartbeat(eb)
+	known := eb.BlockChain().GetBlockByHash(payload.BlockHash)
+	if known == nil || eb.BlockChain().PQBridgeStateReady(known) {
+		t.Fatal("marker fault did not create a known but non-durable block")
+	}
+	knownFirst, err := apiB.NewPayloadV4(context.Background(), *payload, []common.Hash{}, &beaconRoot, requests)
+	if err != nil || knownFirst.Status != engine.SYNCING {
+		t.Fatalf("known block bypassed required execution: %+v %v", knownFirst, err)
+	}
+	if rawdb.ReadBadBlock(eb.ChainDb(), payload.BlockHash) != nil || apiB.checkInvalidAncestor(payload.BlockHash, payload.BlockHash) != nil {
+		t.Fatal("known-block retry entered invalid cache")
+	}
+	rawdb.WriteLegacyTrieNode(eb.ChainDb(), key, original)
+	knownSecond, err := apiB.NewPayloadV4(context.Background(), *payload, []common.Hash{}, &beaconRoot, requests)
+	if err != nil || knownSecond.Status != engine.VALID {
+		t.Fatalf("known block did not reexecute after repair: %+v %v", knownSecond, err)
+	}
+	if !eb.BlockChain().PQBridgeStateReady(eb.BlockChain().GetBlockByHash(payload.BlockHash)) {
+		t.Fatal("execution did not restore durable marker")
+	}
+	t.Logf("PQ_BRIDGE_KNOWN_RETRY payload=%s first=%s second=%s restarted=true marker_restored=true", payload.BlockHash, knownFirst.Status, knownSecond.Status)
+}
+
+func TestPQBridgeEngineForkchoiceMissingBodyRetry(t *testing.T) {
+	repo := os.Getenv("PQ_BRIDGE_TEST_ROOT")
+	if repo == "" {
+		t.Skip("set PQ_BRIDGE_TEST_ROOT to the frozen state-bridge workspace")
+	}
+	if os.Getenv("PQ_FULL_VERIFIER_PATH") == "" {
+		t.Skip("set PQ_FULL_VERIFIER_PATH for the legacy bridge worker")
+	}
+	t.Setenv("RISC0_DEV_MODE", "0")
+	aDir, bDir := bridgeTestImport(t, repo, "fork-A"), bridgeTestImport(t, repo, "fork-B")
+	a, ea := bridgeTestStart(t, aDir)
+	defer a.Close()
+	b, eb := bridgeTestStart(t, bDir)
+	defer func() {
+		if b != nil {
+			b.Close()
+		}
+	}()
+	apiA, apiB := newConsensusAPIWithoutHeartbeat(ea), newConsensusAPIWithoutHeartbeat(eb)
+	t0 := ea.BlockChain().Config().PQMigrate.T0
+	build := func(parent common.Hash, timestamp uint64, label string) (*engine.ExecutionPayloadEnvelope, common.Hash) {
+		beaconRoot := crypto.Keccak256Hash([]byte(label))
+		envelope, err := assembleEnvelope(apiA, parent, &engine.PayloadAttributes{
+			Timestamp: timestamp, Random: crypto.Keccak256Hash([]byte("public-fcu-randao")),
+			SuggestedFeeRecipient: common.HexToAddress("0xdadb0d80178819f2319190d340ce9a924f783711"),
+			Withdrawals:           []*types.Withdrawal{}, BeaconRoot: &beaconRoot})
+		if err != nil {
+			t.Fatal(err)
+		}
+		return envelope, beaconRoot
+	}
+	importPayload := func(api *ConsensusAPI, envelope *engine.ExecutionPayloadEnvelope, beaconRoot common.Hash) {
+		requests := make([]hexutil.Bytes, len(envelope.Requests))
+		for i, request := range envelope.Requests {
+			requests[i] = request
+		}
+		status, err := api.NewPayloadV4(context.Background(), *envelope.ExecutionPayload, []common.Hash{}, &beaconRoot, requests)
+		if err != nil || status.Status != engine.VALID {
+			t.Fatalf("valid fixture import: %+v %v", status, err)
+		}
+	}
+	choose := func(api *ConsensusAPI, hash common.Hash) (engine.ForkChoiceResponse, error) {
+		return api.ForkchoiceUpdatedV3(context.Background(), engine.ForkchoiceStateV1{
+			HeadBlockHash: hash, SafeBlockHash: params.PQBridgeAnchorHash,
+			FinalizedBlockHash: params.PQBridgeAnchorHash}, nil)
+	}
+	main, mainBeacon := build(params.PQBridgeAnchorHash, t0+12, "public-main-branch")
+	importPayload(apiB, main, mainBeacon)
+	if status, err := choose(apiB, main.ExecutionPayload.BlockHash); err != nil || status.PayloadStatus.Status != engine.VALID {
+		t.Fatalf("initial head: %+v %v", status, err)
+	}
+	side1, sideBeacon1 := build(params.PQBridgeAnchorHash, t0+12, "public-side-branch-1")
+	importPayload(apiA, side1, sideBeacon1)
+	importPayload(apiB, side1, sideBeacon1)
+	if status, err := choose(apiA, side1.ExecutionPayload.BlockHash); err != nil || status.PayloadStatus.Status != engine.VALID {
+		t.Fatalf("builder side head: %+v %v", status, err)
+	}
+	side2, sideBeacon2 := build(side1.ExecutionPayload.BlockHash, t0+24, "public-side-branch-2")
+	importPayload(apiB, side2, sideBeacon2)
+	sideBlock := eb.BlockChain().GetBlockByHash(side1.ExecutionPayload.BlockHash)
+	if sideBlock == nil {
+		t.Fatal("side block missing before fault injection")
+	}
+	if err := b.Close(); err != nil {
+		t.Fatal(err)
+	}
+	b = nil
+	// Reopen clears the block caches. Only this test's noncanonical body is removed.
+	kv, err := pebble.New(filepath.Join(bDir, "geth", "chaindata"), 64, 64, "pq-fcu-test", false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	db := rawdb.NewDatabase(kv)
+	rawdb.DeleteBody(db, sideBlock.Hash(), sideBlock.NumberU64())
+	if err = db.SyncKeyValue(); err != nil {
+		db.Close()
+		t.Fatal(err)
+	}
+	if err = db.Close(); err != nil {
+		t.Fatal(err)
+	}
+	b, eb = bridgeTestStart(t, bDir)
+	apiB = newConsensusAPIWithoutHeartbeat(eb)
+	if eb.BlockChain().CurrentBlock().Hash() != main.ExecutionPayload.BlockHash {
+		t.Fatal("restart changed canonical head")
+	}
+	first, err := choose(apiB, side2.ExecutionPayload.BlockHash)
+	if err != nil || first.PayloadStatus.Status != engine.SYNCING {
+		t.Fatalf("missing branch body must be SYNCING: %+v %v", first, err)
+	}
+	if eb.BlockChain().CurrentBlock().Hash() != main.ExecutionPayload.BlockHash {
+		t.Fatal("missing body advanced canonical head")
+	}
+	if rawdb.ReadBadBlock(eb.ChainDb(), side2.ExecutionPayload.BlockHash) != nil || apiB.checkInvalidAncestor(side2.ExecutionPayload.BlockHash, side2.ExecutionPayload.BlockHash) != nil {
+		t.Fatal("missing body treated as bad block")
+	}
+	rawdb.WriteBody(eb.ChainDb(), sideBlock.Hash(), sideBlock.NumberU64(), sideBlock.Body())
+	second, err := choose(apiB, side2.ExecutionPayload.BlockHash)
+	if err != nil || second.PayloadStatus.Status != engine.VALID {
+		t.Fatalf("same forkchoice after body repair: %+v %v", second, err)
+	}
+	if eb.BlockChain().CurrentBlock().Hash() != side2.ExecutionPayload.BlockHash {
+		t.Fatal("repaired forkchoice did not advance head")
+	}
+	t.Logf("PQ_BRIDGE_FCU_RETRY head_before=%s target=%s missing_body=%s first=%s second=%s badblock=false invalid_cache=false", main.ExecutionPayload.BlockHash, side2.ExecutionPayload.BlockHash, sideBlock.Hash(), first.PayloadStatus.Status, second.PayloadStatus.Status)
+}
+
+func TestPQBridgeEngineBuilderMissingNodeClassification(t *testing.T) {
+	repo := os.Getenv("PQ_BRIDGE_TEST_ROOT")
+	if repo == "" {
+		t.Skip("set PQ_BRIDGE_TEST_ROOT to the frozen state-bridge workspace")
+	}
+	if os.Getenv("PQ_FULL_VERIFIER_PATH") == "" {
+		t.Skip("set PQ_FULL_VERIFIER_PATH for the legacy bridge worker")
+	}
+	t.Setenv("RISC0_DEV_MODE", "0")
+	datadir := bridgeTestImport(t, repo, "builder")
+	n, e := bridgeTestStart(t, datadir)
+	defer n.Close()
+	api := newConsensusAPIWithoutHeartbeat(e)
+	timestamp := e.BlockChain().Config().PQMigrate.T0 + 12
+	key, original := bridgeTestRequiredNode(t, repo, timestamp)
+	if err := e.ChainDb().Delete(key[:]); err != nil {
+		t.Fatal(err)
+	}
+	beaconRoot := crypto.Keccak256Hash([]byte("public-builder-missing-node"))
+	state := engine.ForkchoiceStateV1{HeadBlockHash: params.PQBridgeAnchorHash, SafeBlockHash: params.PQBridgeAnchorHash, FinalizedBlockHash: params.PQBridgeAnchorHash}
+	attributes := &engine.PayloadAttributes{Timestamp: timestamp,
+		Random:                crypto.Keccak256Hash([]byte("public-builder-randao")),
+		SuggestedFeeRecipient: common.HexToAddress("0xdadb0d80178819f2319190d340ce9a924f783711"),
+		Withdrawals:           []*types.Withdrawal{}, BeaconRoot: &beaconRoot}
+	first, err := api.ForkchoiceUpdatedV3(context.Background(), state, attributes)
+	if first.PayloadID != nil {
+		t.Fatal("missing node produced a payload")
+	}
+	code := 0
+	if rpcError, ok := err.(interface{ ErrorCode() int }); ok {
+		code = rpcError.ErrorCode()
+	}
+	t.Logf("PQ_BRIDGE_BUILD_MISSING status=%s error_code=%d error=%v", first.PayloadStatus.Status, code, err)
+	if code != -32603 || first.PayloadStatus.Status != "" {
+		t.Fatalf("local missing node must be an internal error without a validity decision: %+v %v", first, err)
+	}
+	if e.BlockChain().CurrentBlock().Hash() != params.PQBridgeAnchorHash {
+		t.Fatal("failed build advanced head")
+	}
+	rawdb.WriteLegacyTrieNode(e.ChainDb(), key, original)
+	second, err := api.ForkchoiceUpdatedV3(context.Background(), state, attributes)
+	if err != nil || second.PayloadStatus.Status != engine.VALID || second.PayloadID == nil {
+		t.Fatalf("same attributes after supplementation: %+v %v", second, err)
+	}
+	t.Logf("PQ_BRIDGE_BUILD_RETRY status=%s payload_id=%s", second.PayloadStatus.Status, second.PayloadID.String())
+}
