+func finalStateSign(t *testing.T, p *types.PQMigrateTx, seedByte byte) *types.Transaction {
+	t.Helper()
+	var seed [32]byte
+	for i := range seed {
+		seed[i] = seedByte
+	}
+	_, sk := mldsa44.NewKeyFromSeed(&seed)
+	d := p.SponsorSigningHash()
+	p.SponsorOption.Signature = make([]byte, mldsa44.SignatureSize)
+	tag := []byte("ETH-PQ-SPONSOR/v1")
+	if e := mldsa44.SignTo(sk, append(tag, d[:]...), tag, false, p.SponsorOption.Signature); e != nil {
+		t.Fatal(e)
+	}
+	return types.NewTx(p)
