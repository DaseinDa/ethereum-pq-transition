@@ -0,0 +1,95 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package types
+
+import (
+	"bytes"
+	"encoding/binary"
+	"encoding/json"
+	"fmt"
+	"github.com/ethereum/go-ethereum/common"
+	"math/big"
+	"testing"
+)
+
+func batchWireFixture() *PQBatchTx {
+	p := &PQBatchTx{ChainID: big.NewInt(13378), Sponsor: common.HexToAddress("9876"), SponsorNonce: 1, SponsorValidUntil: 99, GasTipCap: big.NewInt(1), GasFeeCap: big.NewInt(2), Gas: 16777216, VerifierVersion: 0x80000008, ProofCarrier: PQMigrationCarrier{Proof: []byte("encoding-only, not a proof")}}
+	for i := 1; i <= 4; i++ {
+		p.Entries = append(p.Entries, PQBatchEntry{LegacyAddress: common.BytesToAddress([]byte{byte(i)}), AlgID: 1, PQPKCommit: common.BytesToHash([]byte{byte(i)}), Expiry: 100, MaxAccountFee: new(big.Int), FeeMode: 2})
+	}
+	return p
+}
+func TestPQBatchWireAndStatement(t *testing.T) {
+	p := batchWireFixture()
+	if err := p.ValidateShape(); err != nil {
+		t.Fatal(err)
+	}
+	tx := NewTx(p)
+	raw, err := tx.MarshalBinary()
+	if err != nil {
+		t.Fatal(err)
+	}
+	var decoded Transaction
+	if err = decoded.UnmarshalBinary(raw); err != nil {
+		t.Fatal(err)
+	}
+	again, _ := decoded.MarshalBinary()
+	if !bytes.Equal(raw, again) || raw[0] != 0x7f {
+		t.Fatal("canonical roundtrip")
+	}
+	pi := p.PublicInputs()
+	if len(pi) != 798 || binary.BigEndian.Uint16(pi) != 4 || binary.BigEndian.Uint32(pi[2:]) != 0x80000008 {
+		t.Fatal("raw statement header")
+	}
+	for i, e := range p.Entries {
+		if !bytes.Equal(pi[6+i*198:6+(i+1)*198], e.Migration(p.ChainID, p.VerifierVersion).PublicInputs()) {
+			t.Fatal("PI order")
+		}
+	}
+	b, err := json.Marshal(tx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var fromJSON Transaction
+	if err = json.Unmarshal(b, &fromJSON); err != nil || fromJSON.Hash() != tx.Hash() {
+		t.Fatal("RPC JSON roundtrip", err)
+	}
+	h := p.SponsorSigningHash()
+	p.SponsorNonce++
+	if p.SponsorSigningHash() == h {
+		t.Fatal("nonce not signed")
+	}
+}
+func TestPQBatchShapeRejections(t *testing.T) {
+	cases := map[string]func(*PQBatchTx){"owner-is-payer": func(p *PQBatchTx) { p.Sponsor = p.Entries[0].LegacyAddress }, "duplicate": func(p *PQBatchTx) { p.Entries[1] = p.Entries[0] }, "zero-commit": func(p *PQBatchTx) { p.Entries[0].PQPKCommit = common.Hash{} }, "mode-zero": func(p *PQBatchTx) { p.Entries[0].FeeMode = 0 }, "sponsor-window": func(p *PQBatchTx) { p.SponsorValidUntil = 101 }, "empty": func(p *PQBatchTx) { p.Entries = nil }, "fee-fields": func(p *PQBatchTx) { p.Entries[0].FeeAuthUntil = 1 }, "route-A-facts": func(p *PQBatchTx) { p.ProofCarrier.FactRefs = []common.Hash{{1}} }}
+	for name, edit := range cases {
+		t.Run(name, func(t *testing.T) {
+			p := batchWireFixture()
+			edit(p)
+			if p.ValidateShape() == nil {
+				t.Fatal("accepted malformed batch")
+			}
+		})
+	}
+}
+
+func TestPQBatchFixedCountDecode(t *testing.T) {
+	for count := 1; count <= 3; count++ {
+		t.Run(fmt.Sprint(count), func(t *testing.T) {
+			b := batchWireFixture()
+			b.Entries = b.Entries[:count]
+			if err := b.ValidateShape(); err == nil || err.Error() != "NON_CANONICAL_ENCODING" {
+				t.Fatal("shape", err)
+			}
+			raw, err := NewTx(b).MarshalBinary()
+			if err != nil {
+				t.Fatal(err)
+			}
+			var decoded Transaction
+			if err = decoded.UnmarshalBinary(raw); err == nil || err.Error() != "NON_CANONICAL_ENCODING" {
+				t.Fatal("decode", err)
+			}
+		})
+	}
+}
diff --git a/core/types/pq_batch_tx.go b/core/types/pq_batch_tx.go
new file mode 100644
index 0000000000000000000000000000000000000000..54e13e8417496f5cf1d88dbd3e4dd6f213d72026
--- /dev/null
+++ b/core/types/pq_batch_tx.go
@@ -0,0 +1,154 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package types
+
+import (
+	"bytes"
+	"encoding/binary"
+	"encoding/json"
+	"errors"
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/common/hexutil"
+	"github.com/ethereum/go-ethereum/crypto"
+	"github.com/ethereum/go-ethereum/rlp"
+	"math/big"
+)
+
+const PQBatchTxType = 0x7f
+
+// The deployed C verifier authenticates exactly four ordered PI198 records.
+const PQBatchOwnerCount = 4
+
+type PQBatchEntry struct {
+	LegacyAddress  common.Address
+	MigrationNonce uint64
+	AlgID          uint8
+	PQPKCommit     common.Hash
+	Expiry         uint64
+	MaxAccountFee  *big.Int
+	FeeMode        uint8
+	FeeSponsor     common.Address
+	FeeAuthUntil   uint64
+}
+type PQBatchTx struct {
+	ChainID           *big.Int
+	Sponsor           common.Address
+	SponsorNonce      uint64
+	SponsorValidUntil uint64
+	SponsorSignature  []byte
+	GasTipCap         *big.Int
+	GasFeeCap         *big.Int
+	Gas               uint64
+	VerifierVersion   uint32
+	Entries           []PQBatchEntry
+	ProofCarrier      PQMigrationCarrier
+}
+
+func (e PQBatchEntry) Migration(chain *big.Int, version uint32) *PQMigrateTx {
+	return &PQMigrateTx{ChainID: chain, VerifierVersion: version, LegacyAddress: e.LegacyAddress, MigrationNonce: e.MigrationNonce, AlgID: e.AlgID, PQPKCommit: e.PQPKCommit, Expiry: e.Expiry, MaxAccountFee: e.MaxAccountFee, FeeMode: e.FeeMode, FeeSponsor: e.FeeSponsor, FeeAuthUntil: e.FeeAuthUntil}
+}
+func (p *PQBatchTx) ValidateShape() error {
+	bad := errors.New("NON_CANONICAL_ENCODING")
+	if !pqUint256(p.ChainID) || !pqUint256(p.GasTipCap) || !pqUint256(p.GasFeeCap) || len(p.Entries) != PQBatchOwnerCount {
+		return bad
+	}
+	seen := make(map[common.Address]bool)
+	var expiry uint64
+	for _, e := range p.Entries {
+		if seen[e.LegacyAddress] || e.LegacyAddress == p.Sponsor || e.FeeMode == 0 {
+			return bad
+		}
+		seen[e.LegacyAddress] = true
+		// Reuse precisely the single PI fee-shape rules, without its per-entry sponsor horizon.
+		m := e.Migration(p.ChainID, p.VerifierVersion)
+		m.GasTipCap = p.GasTipCap
+		m.GasFeeCap = p.GasFeeCap
+		m.SponsorOption = &PQMigrationSponsor{Sponsor: p.Sponsor}
+		if m.ValidateShape() != nil {
+			return bad
+		}
+		expiry = max(expiry, e.Expiry)
+	}
+	if p.SponsorValidUntil > expiry {
+		return bad
+	}
+	if p.ProofCarrier.Route > 1 || (p.ProofCarrier.Route == 0 && len(p.ProofCarrier.FactRefs) != 0) {
+		return bad
+	}
+	return nil
+}
+func (p *PQBatchTx) PublicInputs() []byte {
+	b := make([]byte, 6, 6+198*len(p.Entries))
+	binary.BigEndian.PutUint16(b, uint16(len(p.Entries)))
+	binary.BigEndian.PutUint32(b[2:], p.VerifierVersion)
+	for _, e := range p.Entries {
+		b = append(b, e.Migration(p.ChainID, p.VerifierVersion).PublicInputs()...)
+	}
+	return b
+}
+
+// The Keccak identifier is never substituted for the transcript's raw statement.
+func (p *PQBatchTx) BatchID() common.Hash            { return crypto.Keccak256Hash(p.PublicInputs()) }
+func (p *PQBatchTx) SponsorSigningHash() common.Hash { return p.sigHash(p.ChainID) }
+func (p *PQBatchTx) copy() TxData {
+	b, e := rlp.EncodeToBytes(p)
+	if e != nil {
+		panic(e)
+	}
+	var c PQBatchTx
+	if e = rlp.DecodeBytes(b, &c); e != nil {
+		panic(e)
+	}
+	return &c
+}
+func (p *PQBatchTx) txType() byte           { return PQBatchTxType }
+func (p *PQBatchTx) chainID() *big.Int      { return p.ChainID }
+func (p *PQBatchTx) accessList() AccessList { return nil }
+func (p *PQBatchTx) data() []byte           { return nil }
+func (p *PQBatchTx) gas() uint64            { return p.Gas }
+func (p *PQBatchTx) gasPrice() *big.Int     { return p.GasFeeCap }
+func (p *PQBatchTx) gasTipCap() *big.Int    { return p.GasTipCap }
+func (p *PQBatchTx) gasFeeCap() *big.Int    { return p.GasFeeCap }
+func (p *PQBatchTx) value() *big.Int        { return new(big.Int) }
+func (p *PQBatchTx) nonce() uint64          { return p.SponsorNonce }
+func (p *PQBatchTx) to() *common.Address    { return &common.Address{} }
+func (p *PQBatchTx) effectiveGasPrice(dst, base *big.Int) *big.Int {
+	return pqEffective(dst, p.GasFeeCap, p.GasTipCap, base)
+}
+func (p *PQBatchTx) rawSignatureValues() (v, r, s *big.Int) {
+	return new(big.Int), new(big.Int), new(big.Int)
+}
+func (p *PQBatchTx) setSignatureValues(chain, v, r, s *big.Int) { p.ChainID = new(big.Int).Set(chain) }
+func (p *PQBatchTx) encode(b *bytes.Buffer) error               { return rlp.Encode(b, p) }
+func (p *PQBatchTx) decode(b []byte) error {
+	if e := rlp.DecodeBytes(b, p); e != nil {
+		return errors.New("NON_CANONICAL_ENCODING")
+	}
+	return p.ValidateShape()
+}
+func (p *PQBatchTx) sigHash(chain *big.Int) common.Hash {
+	c := *p
+	c.ChainID = chain
+	c.SponsorSignature = nil
+	return prefixedRlpHash(PQBatchTxType, &c)
+}
+func (tx *Transaction) AsPQBatch() (*PQBatchTx, bool) { p, ok := tx.inner.(*PQBatchTx); return p, ok }
+func (tx *Transaction) marshalPQBatchJSON() ([]byte, error) {
+	p, _ := tx.AsPQBatch()
+	raw, _ := tx.MarshalBinary()
+	return json.Marshal(map[string]any{"type": hexutil.Uint64(PQBatchTxType), "hash": tx.Hash(), "raw": hexutil.Bytes(raw), "batchId": p.BatchID(), "chainId": (*hexutil.Big)(p.ChainID), "from": p.Sponsor, "nonce": hexutil.Uint64(p.SponsorNonce), "gas": hexutil.Uint64(p.Gas), "maxFeePerGas": (*hexutil.Big)(p.GasFeeCap), "maxPriorityFeePerGas": (*hexutil.Big)(p.GasTipCap), "input": hexutil.Bytes{}, "to": nil, "value": hexutil.Uint64(0)})
+}
+func decodePQBatchJSON(input []byte) (TxData, error) {
+	var j struct {
+		Raw hexutil.Bytes `json:"raw"`
+	}
+	if e := json.Unmarshal(input, &j); e != nil {
+		return nil, e
+	}
+	if len(j.Raw) == 0 || j.Raw[0] != PQBatchTxType {
+		return nil, errors.New("missing canonical batch raw bytes")
+	}
+	var p PQBatchTx
+	return &p, p.decode(j.Raw[1:])
+}
