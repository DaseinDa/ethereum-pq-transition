+	cfg.PQMigrate = &params.PQMigrateConfig{T0: 0, T: 1792108800, W: 31536000, ReceivingTime: 0, MaxPayloadBytes: 131072, Registry: common.HexToAddress("800"), FactRegistry: common.HexToAddress("801"), FullResearch: &params.PQFullResearchConfig{Version: 0x80000002, Activation: 0, Sunset: 1792800000, ProofLifetime: 604800, MaxProofBytes: 2 << 20, MaxTxBytes: 3 << 20, TxGasCap: params.MaxTxGas, VerifyGas: 5500000, ImageID: common.HexToHash(id.Image), GuestSHA: common.HexToHash(id.Guest), VerifierSHA: got}}
