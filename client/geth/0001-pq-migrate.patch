new file mode 100644
index 0000000000000000000000000000000000000000..dd5b50acf0d42fdfd1022fa24e2e8cdd7519f5eb
--- /dev/null
+++ b/core/pq_signing_fence.go
@@ -0,0 +1,43 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package core
+
+import (
+	"errors"
+	"github.com/ethereum/go-ethereum/common"
+	"os"
+	"path/filepath"
+)
+
+// A missing release is never repaired at startup. Recovery must stop the old
+// signer and establish signing-history continuity before an operator clears it.
+func PQCheckSigningFenceRecovery() error {
+	p := os.Getenv("PQ_LEAN_FENCE_PATH")
+	if p == "" {
+		return nil
+	}
+	if !filepath.IsAbs(p) {
+		return errors.New("PQ fence path must be absolute")
+	}
+	_, err := os.Lstat(p)
+	if !os.IsNotExist(err) {
+		return errors.New("PQ signing fence unresolved; startup refused")
+	}
+	return nil
+}
+
+// Caller holds Engine forkchoiceLock and newPayloadLock. Holding chainmu also
+// excludes sync insertion, SetHead and SetCanonical until durable reservation
+// and the actual XMSS signature have completed in the CL actor.
+func (bc *BlockChain) PQHoldSigningHeads() (common.Hash, common.Hash, common.Hash, func(), error) {
+	if !bc.chainmu.TryLock() {
+		return common.Hash{}, common.Hash{}, common.Hash{}, nil, errors.New("chain stopped")
+	}
+	h, s, f := bc.CurrentBlock(), bc.CurrentSafeBlock(), bc.CurrentFinalBlock()
+	if h == nil || s == nil || f == nil {
+		bc.chainmu.Unlock()
+		return common.Hash{}, common.Hash{}, common.Hash{}, nil, errors.New("incomplete heads")
+	}
+	return h.Hash(), s.Hash(), f.Hash(), bc.chainmu.Unlock, nil
+}
