+
+func r5Word(n int) []byte            { return common.LeftPadBytes(uint256.NewInt(uint64(n)).Bytes(), 32) }
+func r5Bytes(parts ...[]byte) []byte { return bytes.Join(parts, nil) }
+func r5Key() (*mldsa44.PublicKey, *mldsa44.PrivateKey) {
+	var seed [32]byte // public test-only seed
+	seed[0] = 0x55
+	return mldsa44.NewKeyFromSeed(&seed)
+}
+func r5Sig(t *testing.T, sk *mldsa44.PrivateKey, tag string, h common.Hash) []byte {
+	t.Helper()
+	sig := make([]byte, mldsa44.SignatureSize)
+	if err := mldsa44.SignTo(sk, append([]byte(tag), h[:]...), []byte(tag), false, sig); err != nil {
+		t.Fatal(err)
+	}
+	return sig
+}
+func r5HashInput(h common.Hash, sig []byte) []byte {
+	return r5Bytes([]byte{0x16, 0x26, 0xba, 0x7e}, h[:], r5Word(64), r5Word(len(sig)), sig)
+}
+func r5DataInput(data, sig []byte) []byte {
+	pad := (32 - len(data)%32) % 32
+	return r5Bytes([]byte{0x20, 0xc1, 0x3b, 0x0b}, r5Word(64), r5Word(96+len(data)+pad), r5Word(len(data)), data, make([]byte, pad), r5Word(len(sig)), sig)
+}
