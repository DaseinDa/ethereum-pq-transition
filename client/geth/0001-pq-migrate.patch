+	"github.com/ethereum/go-ethereum/rlp"
+	"github.com/holiman/uint256"
+)
+
+func realBatchPool(t *testing.T) (*Pool, *componentChain, *types.Transaction, txpool.Reserver) {
+	t.Helper()
+	tx, now := pqtest.Batch(t)
+	return batchPoolFor(t, tx, now)
+}
+
+func batchPoolFor(t *testing.T, tx *types.Transaction, now uint64) (*Pool, *componentChain, *types.Transaction, txpool.Reserver) {
+	t.Helper()
+	b, _ := tx.AsPQBatch()
+	p, c, _ := componentPool(t)
+	c.cfg.ChainID = new(big.Int).Set(b.ChainID)
+	c.cfg.AmsterdamTime, c.cfg.BogotaTime, c.cfg.UBTTime = nil, nil, nil
+	c.cfg.PQMigrate.T0, c.cfg.PQMigrate.ReceivingTime, c.cfg.PQMigrate.T = now-100, now-100, now-50
+	c.cfg.PQMigrate.LegacySeedProofFromT0 = true
+	c.cfg.PQMigrate.FullResearch = &params.PQFullResearchConfig{Backend: params.PQFinalBackend, Version: b.VerifierVersion, NativeAlgorithmDigest: params.PQFinalAlgorithmDigest, FinalKeyDigest: params.PQFinalKeyDigest,
+		Sunset: ^uint64(0), ProofLifetime: 604800, MaxProofBytes: params.PQFinalMaxProofBytes, MaxTxBytes: params.PQFinalMaxTxBytes, TxGasCap: params.MaxTxGas, VerifyGas: params.PQFinalVerifyGas}
+	c.cfg.PQMigrate.AggregateResearch = &params.PQAggregateResearchConfig{Key: params.PQAggregateKey, VerifyGas: params.PQAggregateVerifyGas, NMax: 4, MaxTxBytes: params.PQAggregateMaxTxBytes}
+	pk := pqtest.SponsorPublicKey()
+	k, k1 := core.PQRecordSlots(b.Sponsor)
+	var word common.Hash
+	word[31], word[30] = 3, 1
+	c.s.SetState(c.cfg.PQMigrate.Registry, k, word)
+	c.s.SetState(c.cfg.PQMigrate.Registry, k1, core.PQKeyCommit(1, pk))
+	c.s.SetCode(b.Sponsor, append([]byte{0xef, 1, 1}, pk...), tracing.CodeChangeUnspecified)
+	c.s.SetBalance(b.Sponsor, uint256.MustFromBig(new(big.Int).Mul(big.NewInt(10), big.NewInt(params.Ether))), tracing.BalanceChangeUnspecified)
+	c.s.SetNonce(b.Sponsor, b.SponsorNonce, tracing.NonceChangeUnspecified)
+	p.head = &types.Header{Number: big.NewInt(0), Time: now, GasLimit: 45000000, GasUsed: 22500000, BaseFee: big.NewInt(params.GWei), Difficulty: new(big.Int)}
+	p.state = c.s.Copy()
+	tracker := txpool.NewReservationTracker()
+	p.reserver = tracker.NewHandle(0)
+	return p, c, tx, tracker.NewHandle(1)
+}
+
+func TestPQBatchPoolRealAdmissionRetentionAndReservation(t *testing.T) {
+	p, c, tx, ordinary := realBatchPool(t)
+	b, _ := tx.AsPQBatch()
+	if err := p.Add([]*types.Transaction{tx}, true)[0]; err != nil {
+		t.Fatal(err)
+	}
+	if err := ordinary.Hold(b.Sponsor); !errors.Is(err, txpool.ErrAlreadyReserved) {
+		t.Fatal("ordinary pool reserved batch payer", err)
+	}
+	if err := p.Add([]*types.Transaction{tx}, true)[0]; !errors.Is(err, txpool.ErrAlreadyKnown) {
+		t.Fatal("duplicate", err)
+	}
+	if _, remembered := p.diagnostics[tx.Hash()]; remembered || p.sources["local"].failures != 0 {
+		t.Fatal("duplicate recorded a rejection or source strike")
+	}
+	if p.Nonce(b.Sponsor) != b.SponsorNonce+1 {
+		t.Fatal("pending nonce")
+	}
+	for _, e := range b.Entries {
+		k, k1 := core.PQRecordSlots(e.LegacyAddress)
+		var w common.Hash
+		w[31], w[30] = 2, 1
+		binary.BigEndian.PutUint64(w[14:22], 1)
+		c.s.SetState(c.cfg.PQMigrate.Registry, k, w)
+		c.s.SetState(c.cfg.PQMigrate.Registry, k1, e.PQPKCommit)
+	}
+	old := p.head
+	head := types.CopyHeader(old)
+	head.Number = big.NewInt(1)
+	head.ParentHash = old.Hash()
+	head.Time += 12
+	p.Reset(old, head)
+	if !p.Has(tx.Hash()) {
+		t.Fatal("entry staleness evicted a retained batch")
+	}
+	pending, n := p.Pending(txpool.PendingFilter{ExcludePQ: true})
+	if n != 1 || len(pending[b.Sponsor]) != 1 {
+		t.Fatal("nonce-ordered builder path")
+	}
+	if _, n = p.Pending(txpool.PendingFilter{OnlyPQ: true}); n != 0 {
+		t.Fatal("batch sent to nonce-less builder")
+	}
+	p.Clear()
+	p.state = c.s.Copy()
+	err := p.Add([]*types.Transaction{tx}, true)[0]
+	var rejected *core.PQMigrationError
+	if !errors.As(err, &rejected) || rejected.Code != 0x0307 {
+		t.Fatal("known-stale admission", err)
+	}
+	if err = ordinary.Hold(b.Sponsor); err != nil {
+		t.Fatal("reservation leaked", err)
+	}
+}
+
+func TestPQBatchPoolRealInvalidAndNonceGap(t *testing.T) {
+	for _, name := range []string{"bad-proof", "bad-pi-order", "nonce-gap", "over-gas"} {
+		t.Run(name, func(t *testing.T) {
+			p, _, tx, _ := realBatchPool(t)
+			b, _ := tx.AsPQBatch()
+			switch name {
+			case "bad-proof":
+				b.ProofCarrier.Proof[len(b.ProofCarrier.Proof)-1] ^= 1
+			case "bad-pi-order":
+				b.Entries[0], b.Entries[1] = b.Entries[1], b.Entries[0]
+			case "nonce-gap":
+				b.SponsorNonce++
+			case "over-gas":
+				b.Gas = params.MaxTxGas + 1
+			}
+			tx = pqtest.SignBatch(t, b)
+			err := p.Add([]*types.Transaction{tx}, true)[0]
+			wantFailures := 0
+			if name == "over-gas" {
+				if !errors.Is(err, core.ErrGasLimitTooHigh) {
+					t.Fatal("wrong gas error", err)
+				}
+			} else {
+				want := uint16(0x0402)
+				if name == "nonce-gap" {
+					want = 0x0308
+				} else {
+					wantFailures = 1
+				}
+				var failure *core.PQMigrationError
+				if !errors.As(err, &failure) || failure.Code != want {
+					t.Fatalf("want %04x, got %v", want, err)
+				}
+			}
+			if source := p.sources["local"]; source == nil || source.failures != wantFailures {
+				t.Fatalf("source strikes: %#v, want %d", source, wantFailures)
+			}
+			if p.Has(tx.Hash()) {
+				t.Fatal("invalid batch retained")
+			}
+		})
+	}
+}
+
+func TestPQBatchDeferredReservationAndExpiry(t *testing.T) {
+	p, _, tx, ordinary := realBatchPool(t)
+	b, _ := tx.AsPQBatch()
+	// A held reorg candidate has no proof verdict yet and is never Pending.
+	p.deferBatch(tx)
+	if err := ordinary.Hold(b.Sponsor); !errors.Is(err, txpool.ErrAlreadyReserved) {
+		t.Fatal("deferred reservation", err)
+	}
+	if _, n := p.Pending(txpool.PendingFilter{ExcludePQ: true}); n != 0 {
+		t.Fatal("unverified deferred batch announced")
+	}
+	h := p.nextHeader()
+	h.Time = b.SponsorValidUntil
+	p.pruneBatchReset(h)
+	if p.batches[tx.Hash()] != nil || p.Has(tx.Hash()) || len(p.bans) != 0 {
+		t.Fatal("entry expiry retained or banned sponsor")
+	}
+	if err := ordinary.Hold(b.Sponsor); err != nil {
+		t.Fatal("expiry leaked reservation", err)
+	}
+}
+
+func TestPQBatchDeferredVisibilityUntilResetAdmission(t *testing.T) {
+	p, _, tx, _ := realBatchPool(t)
+	b, _ := tx.AsPQBatch()
+	p.deferBatch(tx)
+	if p.Has(tx.Hash()) || p.Get(tx.Hash()) != nil || p.GetRLP(tx.Hash(), 0) != nil || p.GetMetadata(tx.Hash()) != nil {
+		t.Fatal("unverified held batch exposed through serving interfaces")
+	}
+	pending, queued := p.Content()
+	if p.Status(tx.Hash()) != txpool.TxStatusQueued || len(pending[b.Sponsor]) != 0 || len(queued[b.Sponsor]) != 1 || queued[b.Sponsor][0].Hash() != tx.Hash() {
+		t.Fatal("deferred batch missing from local queued diagnostics")
+	}
+	// Same-head Reset retries full admission, including the real C proof.
+	p.Reset(p.head, p.head)
+	if !p.Has(tx.Hash()) || p.Get(tx.Hash()) == nil || p.Get(tx.Hash()).Hash() != tx.Hash() || p.GetMetadata(tx.Hash()) == nil {
+		t.Fatal("admitted retry absent from serving interfaces")
+	}
+	var decoded types.Transaction
+	if err := rlp.DecodeBytes(p.GetRLP(tx.Hash(), 0), &decoded); err != nil || decoded.Hash() != tx.Hash() {
+		t.Fatal("admitted retry RLP", err)
+	}
+	pending, queued = p.Content()
+	if p.Status(tx.Hash()) != txpool.TxStatusPending || len(pending[b.Sponsor]) != 1 || pending[b.Sponsor][0].Hash() != tx.Hash() || len(queued[b.Sponsor]) != 0 {
+		t.Fatal("admitted retry did not transition to pending")
+	}
+}
+
+// No proof or signature verifier is reached: each candidate fails an earlier
+// sponsor-policy check, and every pair checks the prescribed first failure.
+func TestPQBatchSponsorConditionOrder(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		want uint16
+	}{
+		{"activation-before-expiry", 0x0106}, {"expiry-before-nonce", 0x0309},
+		{"nonce-before-balance", 0x0308}, {"balance-before-count", 0x0302},
+		{"count-before-horizon", 0x0303}, {"horizon-before-ban", 0x0309},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			p, c, _ := componentPool(t)
+			c.cfg.PQMigrate.AggregateResearch = &params.PQAggregateResearchConfig{NMax: 4, MaxTxBytes: params.PQAggregateMaxTxBytes}
+			h := p.nextHeader()
+			b := &types.PQBatchTx{ChainID: c.cfg.ChainID, Sponsor: addr(20), SponsorValidUntil: h.Time + 10000,
+				GasTipCap: big.NewInt(1), GasFeeCap: big.NewInt(2), Gas: params.MaxTxGas, VerifierVersion: c.cfg.PQMigrate.FullResearch.Version,
+				ProofCarrier: types.PQMigrationCarrier{Proof: []byte("not verified")}}
+			for i := byte(1); i <= 4; i++ {
+				b.Entries = append(b.Entries, types.PQBatchEntry{LegacyAddress: addr(i), AlgID: 1, PQPKCommit: common.Hash{i}, Expiry: h.Time + 10000, MaxAccountFee: new(big.Int), FeeMode: 2})
+			}
+			switch tc.name {
+			case "activation-before-expiry":
+				p.state.SetCode(b.Sponsor, nil, tracing.CodeChangeUnspecified)
+				b.SponsorValidUntil = h.Time - 1
+			case "expiry-before-nonce":
+				b.SponsorValidUntil = h.Time - 1
+				b.SponsorNonce = 1
+			case "nonce-before-balance":
+				b.SponsorNonce = 1
+				p.state.SetBalance(b.Sponsor, new(uint256.Int), tracing.BalanceChangeUnspecified)
+			case "balance-before-count":
+				p.state.SetBalance(b.Sponsor, new(uint256.Int), tracing.BalanceChangeUnspecified)
+				p.cfg.MaxSponsored = 0
+			case "count-before-horizon":
+				p.cfg.MaxSponsored = 0
+				b.SponsorValidUntil = h.Time
+			case "horizon-before-ban":
+				b.SponsorValidUntil = h.Time
+				p.bans[b.Sponsor] = time.Now().Add(time.Hour)
+			}
+			err := p.addBatch(types.NewTx(b), true)
+			var failure *core.PQMigrationError
+			if !errors.As(err, &failure) || failure.Code != tc.want {
+				t.Fatalf("want %04x, got %v", tc.want, err)
+			}
+		})
+	}
+}
+
+// A signed component envelope, with a deliberately non-proof carrier. Its
+// sponsor checks are real; only tests naming the private proof seam accept it.
+func componentBatchEnvelope(t *testing.T) (*types.Transaction, uint64) {
+	t.Helper()
+	now := uint64(1000)
+	b := &types.PQBatchTx{ChainID: big.NewInt(13375), Sponsor: addr(90), SponsorValidUntil: now + 3600,
+		GasTipCap: big.NewInt(params.GWei), GasFeeCap: big.NewInt(10 * params.GWei), Gas: 16000000,
+		VerifierVersion: params.PQFinalVersion, ProofCarrier: types.PQMigrationCarrier{Proof: []byte("policy-only, not a C proof")}}
+	for i := byte(1); i <= 4; i++ {
+		b.Entries = append(b.Entries, types.PQBatchEntry{LegacyAddress: addr(i), AlgID: 1, PQPKCommit: common.Hash{i}, Expiry: now + 7200, MaxAccountFee: new(big.Int), FeeMode: 2})
+	}
+	return pqtest.SignBatch(t, b), now
+}
+
+func TestPQBatchDuplicateKnownWithoutDiagnosticsOrStrike(t *testing.T) {
+	for _, admitted := range []bool{false, true} {
+		t.Run(fmt.Sprintf("admitted-%v", admitted), func(t *testing.T) {
+			tx, now := componentBatchEnvelope(t)
+			p, _, _, _ := batchPoolFor(t, tx, now)
+			if admitted {
+				// Only setup uses the explicit proof seam; duplicate submission
+				// below must return before any signature or proof evaluation.
+				if err := p.addBatchWithProof(tx, true, func(*types.Transaction, *params.ChainConfig) error { return nil }); err != nil {
+					t.Fatal(err)
+				}
+			} else {
+				p.deferBatch(tx)
+			}
+			bytesBefore := p.batchBytes
+			if err := p.AddFrom("duplicate", []*types.Transaction{tx}, true)[0]; !errors.Is(err, txpool.ErrAlreadyKnown) {
+				t.Fatal("identical batch was treated as replacement", err)
+			}
+			if _, remembered := p.diagnostics[tx.Hash()]; remembered || p.diagnosticOrder != 0 || p.sources["duplicate"] != nil {
+				t.Fatal("duplicate entered diagnostic/source accounting")
+			}
+			if len(p.batches) != 1 || p.batchBytes != bytesBefore || p.batches[tx.Hash()].admitted != admitted {
+				t.Fatal("duplicate changed retained batch")
+			}
+		})
+	}
+}
+
+func TestPQBatchFeeAuthorizationDoesNotBoundSponsor(t *testing.T) {
+	for _, mode := range []uint8{1, 3} {
+		for _, expired := range []bool{false, true} {
+			t.Run(fmt.Sprintf("mode%d-expired%v", mode, expired), func(t *testing.T) {
+				tx, now := componentBatchEnvelope(t)
+				p, _, _, _ := batchPoolFor(t, tx, now)
+				b, _ := tx.AsPQBatch()
+				entry := &b.Entries[0]
+				entry.FeeMode, entry.MaxAccountFee, entry.FeeAuthUntil = mode, big.NewInt(100), p.nextHeader().Time+1
+				if mode == 1 {
+					entry.FeeSponsor = b.Sponsor
+				}
+				if expired {
+					entry.FeeAuthUntil = p.nextHeader().Time - 1
+				}
+				tx = pqtest.SignBatch(t, b)
+				calls := 0
+				err := p.addBatchWithProof(tx, true, func(*types.Transaction, *params.ChainConfig) error { calls++; return nil })
+				if err != nil || calls != 1 {
+					t.Fatal("entry fee deadline became sponsor gate", err, calls)
+				}
+				if !p.Has(tx.Hash()) || p.Nonce(b.Sponsor) != 1 {
+					t.Fatal("fee-lapsed batch not admitted")
+				}
+				// Execution's zero reimbursement at deadline+1 is separately
+				// asserted by core.TestPQBatchReimbursementBalanceDeadlineAndRecipient.
+			})
+		}
+	}
+}
+
+func TestPQBatchFixedCountBeforeVerificationOrStrike(t *testing.T) {
+	for count := 1; count <= 3; count++ {
+		t.Run(fmt.Sprint(count), func(t *testing.T) {
+			tx, now := componentBatchEnvelope(t)
+			p, _, _, _ := batchPoolFor(t, tx, now)
+			b, _ := tx.AsPQBatch()
+			b.Entries = b.Entries[:count]
+			b.SponsorSignature = nil // Would fail ML-DSA if shape did not precede it.
+			tx = types.NewTx(b)
+			calls := 0
+			err := p.addBatchWithProof(tx, true, func(*types.Transaction, *params.ChainConfig) error { calls++; return nil })
+			var failure *core.PQMigrationError
+			if !errors.As(err, &failure) || failure.Code != 3 || calls != 0 {
+				t.Fatal("shape/proof order", err, calls)
+			}
+			err = p.AddFrom("shape-test", []*types.Transaction{tx}, true)[0]
+			if !errors.As(err, &failure) || failure.Code != 3 || p.sources["shape-test"] != nil || p.Has(tx.Hash()) {
+				t.Fatal("shape rejection charged verification strike", err)
+			}
+		})
+	}
+}
+
+func TestPQBatchPoolSuccessfulFeeBumpKeepsReservation(t *testing.T) {
+	p, _, tx, ordinary := realBatchPool(t)
+	b, _ := tx.AsPQBatch()
+	if err := p.Add([]*types.Transaction{tx}, true)[0]; err != nil {
+		t.Fatal(err)
+	}
+	owned := types.NewTx(b)
+	replacement, _ := owned.AsPQBatch()
+	replacement.GasTipCap = new(big.Int).Mul(replacement.GasTipCap, big.NewInt(2))
+	replacement.GasFeeCap = new(big.Int).Mul(replacement.GasFeeCap, big.NewInt(2))
+	next := pqtest.SignBatch(t, replacement)
+	if err := p.Add([]*types.Transaction{next}, true)[0]; err != nil {
+		t.Fatal("exact twofold replacement", err)
+	}
+	if p.Has(tx.Hash()) || !p.Has(next.Hash()) || len(p.batches) != 1 || p.batchBytes != next.Size() || p.Nonce(b.Sponsor) != b.SponsorNonce+1 {
+		t.Fatal("replacement accounting")
+	}
+	if err := ordinary.Hold(b.Sponsor); !errors.Is(err, txpool.ErrAlreadyReserved) {
+		t.Fatal("replacement lost sponsor reservation", err)
+	}
+	if p.sources["local"].failures != 0 {
+		t.Fatal("replacement charged a strike")
+	}
+	p.Clear()
+	if err := ordinary.Hold(b.Sponsor); err != nil {
+		t.Fatal("replacement leaked reservation", err)
+	}
+}
