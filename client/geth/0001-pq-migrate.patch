+func TestPQN1RequestGateRealContracts(t *testing.T) {
+	pk, _ := r5Key()
+	marker := append([]byte{0xef, 1, 1}, pk.Bytes()...)
+	for _, contract := range []struct {
+		name string
+		addr common.Address
+		code []byte
+		size int
+	}{{"7002", params.WithdrawalQueueAddress, params.WithdrawalQueueCode, 56}, {"7251", params.ConsolidationQueueAddress, params.ConsolidationQueueCode, 96}} {
+		for _, tc := range []struct {
+			name           string
+			now, enrolled  uint64
+			mode           byte
+			code           []byte
+			deny, fee, sys bool
+		}{
+			{name: "preT0", now: 99}, {name: "LEGACY-at-T0", now: 100, deny: true}, {name: "LEGACY-after-T", now: 500, deny: true},
+			{name: "7702-LEGACY", now: 100, code: types.AddressToDelegation(common.HexToAddress("3333")), deny: true},
+			{name: "ENROLLED-empty", now: 299, enrolled: 100, mode: 1, deny: true},
+			{name: "ENROLLED-activated-marker", now: 299, enrolled: 100, mode: 1, code: marker, deny: true},
+			{name: "ENROLLED-at-deadline", now: 300, enrolled: 100, mode: 1, code: marker},
+			{name: "ENROLLED-after-deadline", now: 301, enrolled: 100, mode: 1},
+			{name: "ENROLLED-late-before-deadline", now: 349, enrolled: 250, mode: 1, deny: true},
+			{name: "ENROLLED-late-at-deadline", now: 350, enrolled: 250, mode: 1},
+			{name: "BY_PROOF-empty", now: 100, mode: 2}, {name: "BY_PROOF-marker", now: 100, mode: 2, code: marker},
+			{name: "NATIVE-marker", now: 100, mode: 3, code: marker}, {name: "contract-LEGACY", now: 100, code: []byte{0}},
+			{name: "contract-ENROLLED", now: 100, mode: 1, code: []byte{0}},
+			{name: "LEGACY-fee-read", now: 100, fee: true}, {name: "ENROLLED-marker-fee-read", now: 100, mode: 1, code: marker, fee: true},
+			{name: "system", now: 100, sys: true},
+		} {
+			t.Run(contract.name+"/"+tc.name, func(t *testing.T) {
+				evm, s, _, sender := pqRecoveryFixture(t, tc.now)
+				evm.chainConfig.PQMigrate.W = 100
+				if tc.sys {
+					sender = params.SystemAddress
+				}
+				s.SetBalance(sender, uint256.NewInt(1000000), tracing.BalanceChangeUnspecified)
+				s.SetCode(sender, tc.code, tracing.CodeChangeUnspecified)
+				word := common.Hash{31: tc.mode}
+				binary.BigEndian.PutUint64(word[22:30], tc.enrolled)
+				s.SetState(evm.chainConfig.PQMigrate.Registry, pqAuthoritySlot(sender), word)
+				s.SetCode(contract.addr, contract.code, tracing.CodeChangeUnspecified)
+				input := bytes.Repeat([]byte{0x42}, contract.size)
+				value := uint256.NewInt(1)
+				if tc.fee {
+					input = nil
+					value.Clear()
+				}
+				if tc.sys {
+					value.Clear()
+				}
+				balance := new(uint256.Int).Set(s.GetBalance(sender))
+				budget := NewGasBudget(500000, 0)
+				out, _, err := evm.Call(sender, contract.addr, input, budget, value)
+				if tc.deny {
+					if !errors.Is(err, ErrExecutionReverted) || len(out) != 0 {
+						t.Fatalf("wanted empty REVERT, %x %v", out, err)
+					}
+					if s.GetState(contract.addr, common.HexToHash("1")) != (common.Hash{}) || s.GetState(contract.addr, common.HexToHash("3")) != (common.Hash{}) || s.GetBalance(sender).Cmp(balance) != 0 {
+						t.Fatal("rejected request changed queue or balance")
+					}
+				} else {
+					if err != nil {
+						t.Fatal(err)
+					}
+					if tc.fee {
+						if len(out) != 32 || out[31] != 1 {
+							t.Fatalf("fee changed: %x", out)
+						}
+					} else if !tc.sys {
+						if s.GetState(contract.addr, common.HexToHash("1")) != common.HexToHash("1") || s.GetState(contract.addr, common.HexToHash("3")) != common.HexToHash("1") {
+							t.Fatal("request did not enter actual upstream queue")
+						}
+						// Upstream system dequeues the authentic source address, without registry gating.
+						drained, _, e := evm.Call(params.SystemAddress, contract.addr, nil, budget, new(uint256.Int))
+						if e != nil || len(drained) != contract.size+20 || !bytes.Equal(drained[:20], sender[:]) {
+							t.Fatalf("system/source mismatch %x %v", drained, e)
+						}
+					}
+				}
+			})
+		}
+	}
