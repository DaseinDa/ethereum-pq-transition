+func TestPQBatchRejectsWholeInvalidWithoutStateChange(t *testing.T) {
+	for _, name := range []string{"bad-proof", "bad-pi-order", "nonce-gap", "over-gas"} {
+		t.Run(name, func(t *testing.T) {
+			original, s, evm, h := batchFixture(t)
+			originalBatch, _ := original.AsPQBatch()
+			tx := types.NewTx(originalBatch)
+			b, _ := tx.AsPQBatch()
+			switch name {
+			case "bad-proof":
+				b.ProofCarrier.Proof[len(b.ProofCarrier.Proof)-1] ^= 1
+			case "bad-pi-order":
+				b.Entries[0], b.Entries[1] = b.Entries[1], b.Entries[0]
+			case "nonce-gap":
+				b.SponsorNonce++
+			case "over-gas":
+				b.Gas = params.MaxTxGas + 1
+			}
+			tx = pqtest.SignBatch(t, b)
+			before := new(uint256.Int).Set(s.GetBalance(b.Sponsor))
+			nonce := s.GetNonce(b.Sponsor)
+			_, err := ApplyMessage(evm, &Message{PQTransaction: tx, GasLimit: b.Gas}, NewGasPool(h.GasLimit))
+			if name == "over-gas" {
+				if !errors.Is(err, ErrGasLimitTooHigh) {
+					t.Fatal("wrong gas rejection", err)
+				}
+			} else {
+				want := uint16(0x0402)
+				if name == "nonce-gap" {
+					want = 0x0308
+				}
+				var failure *PQMigrationError
+				if !errors.As(err, &failure) || failure.Code != want {
+					t.Fatalf("want %04x, got %v", want, err)
+				}
+			}
+			if before.Cmp(s.GetBalance(b.Sponsor)) != 0 || nonce != s.GetNonce(b.Sponsor) {
+				t.Fatal("invalid whole transaction charged")
+			}
+			for _, e := range b.Entries {
+				if ReadPQRecord(s, evm.ChainConfig().PQMigrate.Registry, e.LegacyAddress) != (PQRecord{}) {
+					t.Fatal("invalid batch wrote owner")
+				}
+			}
+		})
+	}
