+		t.Fatal("matching durable execution not accepted")
+	}
+	raw, err := db.Get(pqExecutedStateKey(child.Hash()))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var original pqExecutedStateRecord
+	if err = json.Unmarshal(raw, &original); err != nil {
