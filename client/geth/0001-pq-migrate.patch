+// The real migration carrier of the F client's two-node run (public test
+// material; tx 0x9eeeeb07...) and that run's genesis, pinned by SHA-256.
+const (
+	pqL2CarrierSHA = "d6709ae3d2c4a4f4bc6ae4479cca326628643c205904b342a1946821adcb71fe"
+	pqL2GenesisSHA = "ac4be32b3f5e7d3275df2fc27d8e2f68cec6349f9ee80551ac52437396b84c55"
+	pqL2CarrierLen = 187992
+	pqL2Window     = 128 * 1024 // geth's 128 KiB defaults (fetch batch, legacy pool)
