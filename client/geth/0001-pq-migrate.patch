+	writePQRecord(s, cfg.PQMigrate.Registry, b.Sponsor, PQRecord{Mode: 3, AlgID: 1, MigrationNonce: 1, Commit: PQKeyCommit(1, pk)})
+	s.SetCode(b.Sponsor, append([]byte{0xef, 1, 1}, pk...), tracing.CodeChangeUnspecified)
+	s.SetNonce(b.Sponsor, b.SponsorNonce, tracing.NonceChangeUnspecified)
+	s.SetBalance(b.Sponsor, uint256.MustFromBig(new(big.Int).Mul(big.NewInt(10), big.NewInt(params.Ether))), tracing.BalanceChangeUnspecified)
+	for _, e := range b.Entries {
+		s.SetBalance(e.LegacyAddress, uint256.NewInt(2_000_000_000_000_000_000), tracing.BalanceChangeUnspecified)
+		s.SetNonce(e.LegacyAddress, 9, tracing.NonceChangeUnspecified)
