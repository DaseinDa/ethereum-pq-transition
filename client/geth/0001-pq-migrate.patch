+// pqL2Node is one in-process eth node: a real chain and a handler over the
+// given pools, accepting transactions (synced).
+type pqL2Node struct {
+	chain   *core.BlockChain
+	handler *handler
+	pool    txPool
+	blobs   blobPool
+	close   func()
+}
+
+func newPQL2Node(t *testing.T, gspec *core.Genesis, blocks []*types.Block, pools func(*core.BlockChain) (txPool, blobPool, func())) *pqL2Node {
+	t.Helper()
+	db := rawdb.NewMemoryDatabase()
+	chain, err := core.NewBlockChain(db, gspec, beacon.New(ethash.NewFaker()), nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(blocks) > 0 {
+		if _, err := chain.InsertChain(blocks); err != nil {
+			t.Fatal(err)
+		}
+	}
+	pool, blobs, closePools := pools(chain)
+	h, err := newHandler(&handlerConfig{Database: db, Chain: chain, TxPool: pool, BlobPool: blobs, Network: 1, Sync: ethconfig.FullSync, BloomCache: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	h.Start(1000)
+	h.synced.Store(true)
+	return &pqL2Node{chain: chain, handler: h, pool: pool, blobs: blobs, close: func() { h.Stop(); closePools(); chain.Stop() }}
+}
+
+// pqL2Connect peers a and b over an in-memory pipe at the given eth version.
+// Each side's eth.Peer carries the chain configuration, as the production
+// protocol constructor passes it (MakeProtocols), unless bare is set.
+// It returns b's recorder of what a sent and a's recorder of what b sent.
+func pqL2Connect(t *testing.T, a, b *pqL2Node, version uint, bare bool) (atob, btoa *pqL2Wire, done func()) {
+	t.Helper()
+	pipeA, pipeB := p2p.MsgPipe()
+	atob, btoa = &pqL2Wire{MsgReadWriter: pipeB, version: version}, &pqL2Wire{MsgReadWriter: pipeA, version: version}
+	cfgA, cfgB := a.chain.Config(), b.chain.Config()
+	if bare {
+		cfgB = nil
+	}
+	peerAtA := eth.NewPeer(version, p2p.NewPeerPipe(enode.ID{2}, "", nil, pipeA), btoa, a.pool, a.blobs, cfgA) // a's view of b
+	peerAtB := eth.NewPeer(version, p2p.NewPeerPipe(enode.ID{1}, "", nil, pipeB), atob, b.pool, b.blobs, cfgB) // b's view of a
+	go a.handler.runEthPeer(peerAtA, func(peer *eth.Peer) error { return eth.Handle((*ethHandler)(a.handler), peer) })
+	go b.handler.runEthPeer(peerAtB, func(peer *eth.Peer) error { return eth.Handle((*ethHandler)(b.handler), peer) })
+	pqL2Wait(t, 5*time.Second, "handshake", func() bool { return a.handler.peers.len() == 1 && b.handler.peers.len() == 1 })
+	return atob, btoa, func() { peerAtA.Close(); peerAtB.Close(); pipeA.Close(); pipeB.Close() }
+}
+
+func pqL2Wait(t *testing.T, limit time.Duration, what string, cond func() bool) {
+	t.Helper()
+	for deadline := time.Now().Add(limit); !cond(); time.Sleep(20 * time.Millisecond) {
+		if time.Now().After(deadline) {
+			t.Fatalf("timed out waiting for %s", what)
+		}
+	}
+}
+
+// pqL2Propagated asserts the announce-and-fetch path for one carrier: a
+// announced it (type 0x7e and its true size) and never broadcast it in full,
+// b requested it, a's response carried it in one message larger than the
+// 128 KiB window, and it is in b's pool.
+func pqL2Propagated(t *testing.T, atob, btoa *pqL2Wire, b *pqL2Node, tx *types.Transaction) {
+	t.Helper()
+	pqL2Wait(t, 15*time.Second, fmt.Sprintf("%d-byte carrier in the peer's pool", tx.Size()), func() bool { return b.pool.Has(tx.Hash()) })
+	if bc := atob.find(eth.TransactionsMsg, tx.Hash()); len(bc) != 0 {
+		t.Fatalf("carrier broadcast in full (%d Transactions messages)", len(bc))
+	}
+	anns := atob.find(eth.NewPooledTransactionHashesMsg, tx.Hash())
+	if len(anns) == 0 {
+		t.Fatal("carrier not announced")
+	}
+	var annSize uint32
+	for i, h := range anns[0].txs {
+		if h == tx.Hash() {
+			if anns[0].kinds[i] != types.PQMigrateTxType || uint64(anns[0].sizes[i]) != tx.Size() {
+				t.Fatalf("announced type %#x size %d, want 0x7e %d", anns[0].kinds[i], anns[0].sizes[i], tx.Size())
+			}
+			annSize = anns[0].sizes[i]
+		}
+	}
+	reqs := btoa.find(eth.GetPooledTransactionsMsg, tx.Hash())
+	resp := atob.find(eth.PooledTransactionsMsg, tx.Hash())
+	if len(reqs) != 1 || len(reqs[0].txs) != 1 || len(resp) != 1 || resp[0].size <= pqL2Window || uint64(resp[0].size) < tx.Size() {
+		t.Fatalf("requests %d responses %d (response bytes %v)", len(reqs), len(resp), resp)
+	}
+	if meta := b.pool.GetMetadata(tx.Hash()); meta == nil || meta.Type != types.PQMigrateTxType || meta.Size != tx.Size() {
+		t.Fatalf("peer's pool metadata %+v", meta)
+	}
+	t.Logf("%d-byte carrier %x: announced (type 0x7e, size %d), requested alone, delivered in one %d-byte PooledTransactions message, in the peer's pool",
+		tx.Size(), tx.Hash().Bytes()[:4], annSize, resp[0].size)
+}
+
+// L2 mechanics: the eth layer moves 0x7e carriers above 128 KiB by announce
+// and requested fetch, on every supported eth version, with a pool that only
+// applies the raw bound (no proof verification):
+// (iii) a carrier above the 199,332-byte bound, announced truthfully by a
+// peer whose own pool admits it, is neither fetched nor admitted, and that
+// peer stays connected; (i) the real 187,992-byte carrier and (ii) one at
+// the bound then propagate over the same connection.
+func TestPQL2CarrierPropagationMechanics(t *testing.T) {
+	carrier := pqL2Carrier(t)
+	atBound := pqL2Resized(t, carrier, params.PQFinalMaxTxBytes)
+	over := pqL2Resized(t, carrier, params.PQFinalMaxTxBytes+1)
+	cfg := pqL2Config()
+	gspec := &core.Genesis{Config: cfg, GasLimit: 45_000_000, BaseFee: big.NewInt(params.InitialBaseFee), Difficulty: common.Big0, Alloc: core.SystemContractAllocs()}
+	mock := func(bound uint64) func(*core.BlockChain) (txPool, blobPool, func()) {
+		return func(*core.BlockChain) (txPool, blobPool, func()) { p := newPQL2Pool(bound); return p, p, func() {} }
+	}
+	for _, version := range eth.ProtocolVersions {
+		t.Run(fmt.Sprintf("eth%d", version), func(t *testing.T) {
+			// a's pool is permissive (an honest peer with a larger local bound);
+			// b's pool and b's fetcher apply the profile's 199,332-byte bound.
+			a := newPQL2Node(t, gspec, nil, mock(math.MaxUint64))
+			defer a.close()
+			b := newPQL2Node(t, gspec, nil, mock(params.PQFinalMaxTxBytes))
+			defer b.close()
+			atob, btoa, done := pqL2Connect(t, a, b, version, false)
+			defer done()
+
+			// (iii) above the bound.
+			if errs := a.pool.Add([]*types.Transaction{over}, false); errs[0] != nil {
+				t.Fatal(errs[0])
+			}
+			pqL2Wait(t, 5*time.Second, "announcement of the over-bound carrier", func() bool {
+				return len(atob.find(eth.NewPooledTransactionHashesMsg, over.Hash())) == 1
+			})
+			time.Sleep(2 * time.Second) // well past the fetcher's 500 ms arrival wait
+			if n := len(btoa.find(eth.GetPooledTransactionsMsg, over.Hash())); n != 0 || b.pool.Has(over.Hash()) || b.pool.(*pqL2Pool).attempts(over.Hash()) != 0 {
+				t.Fatalf("over-bound carrier fetched (%d requests) or offered to the pool", n)
+			}
+			if a.handler.peers.len() != 1 || b.handler.peers.len() != 1 {
+				t.Fatal("honest sender of the over-bound announcement disconnected")
+			}
+			t.Logf("%d-byte carrier announced, not requested, not admitted; peers still connected", over.Size())
+
+			// (i) the real carrier, then (ii) the bound, on the same connection.
+			for _, tx := range []*types.Transaction{carrier, atBound} {
+				if errs := a.pool.Add([]*types.Transaction{tx}, false); errs[0] != nil {
+					t.Fatal(errs[0])
+				}
+				pqL2Propagated(t, atob, btoa, b, tx)
+			}
+			if a.handler.peers.len() != 1 || b.handler.peers.len() != 1 {
+				t.Fatal("a peer was disconnected")
+			}
+		})
+	}
+	// Control: the same exchange where b's eth.Peer lacks the chain
+	// configuration (as the generic eth test harness builds peers) fails at a
+	// layer on the path: b cannot match the response to a tracked full-proof
+	// request, rejects it and drops a. This keeps the observables honest.
+	t.Run("control-untracked-response", func(t *testing.T) {
+		a := newPQL2Node(t, gspec, nil, mock(math.MaxUint64))
+		defer a.close()
+		b := newPQL2Node(t, gspec, nil, mock(params.PQFinalMaxTxBytes))
+		defer b.close()
+		atob, _, done := pqL2Connect(t, a, b, eth.ETH72, true)
+		defer done()
+		if errs := a.pool.Add([]*types.Transaction{carrier}, false); errs[0] != nil {
+			t.Fatal(errs[0])
+		}
+		pqL2Wait(t, 15*time.Second, "the response", func() bool { return len(atob.find(eth.PooledTransactionsMsg, carrier.Hash())) == 1 })
+		pqL2Wait(t, 5*time.Second, "the drop", func() bool { return b.handler.peers.len() == 0 })
+		if b.pool.Has(carrier.Hash()) {
+			t.Fatal("untracked full-proof response admitted")
+		}
+		t.Logf("control: response without a tracked request rejected, peer dropped, carrier not admitted")
+	})
+}
+
+// pqL2RealPools is the node's production pool set: legacypool, blobpool and
+// the real pqpool (actual state checks and native F verification).
+func pqL2RealPools(t *testing.T) func(*core.BlockChain) (txPool, blobPool, func()) {
+	return func(chain *core.BlockChain) (txPool, blobPool, func()) {
+		legacyCfg := legacypool.DefaultConfig
+		legacyCfg.Journal = ""
+		legacy := legacypool.New(legacyCfg, chain)
+		blobs := blobpool.New(blobpool.Config{Datadir: t.TempDir()}, chain, legacy.HasPendingAuth)
+		pqCfg := pqpool.DefaultConfig
+		pqCfg.Datadir = t.TempDir()
+		pool, err := txpool.New(1, chain, []txpool.SubPool{legacy, blobs, pqpool.New(pqCfg, chain)})
+		if err != nil {
+			t.Fatal(err)
+		}
+		return pool, blobs, func() { pool.Close() }
+	}
+}
