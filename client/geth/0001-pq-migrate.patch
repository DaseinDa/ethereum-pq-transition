@@ -0,0 +1,88 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package legacypool
+
+import (
+	"context"
+	"math/big"
+	"testing"
+
+	"github.com/cloudflare/circl/sign/mldsa/mldsa44"
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core"
+	"github.com/ethereum/go-ethereum/core/tracing"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/core/vm"
+	"github.com/ethereum/go-ethereum/crypto"
+	"github.com/ethereum/go-ethereum/internal/pqtest"
+	"github.com/ethereum/go-ethereum/params"
+	"github.com/holiman/uint256"
+)
+
+// Real F migration, ECDSA sender and ML-DSA enrollment. Neither held transaction
+// is included; reset must evict both when the pre-T proof changes authority.
+func TestPQLegacyResetAfterPreTProof(t *testing.T) {
+	migration, now := pqtest.SingleF(t, 0)
+	m, _ := migration.AsPQMigrate()
+	// Public BIP39 fixture, m/44'/60'/0'/0/0 (abandon x11 + about).
+	key, err := crypto.HexToECDSA("1ab42cc412b618bdea3a599e3c9bae199ebf030895b039e9db1e30dafb12b727")
+	if err != nil {
+		t.Fatal(err)
+	}
+	owner := crypto.PubkeyToAddress(key.PublicKey)
+	if owner != m.LegacyAddress || m.MigrationNonce != 0 {
+		t.Fatal("unexpected public F owner fixture")
+	}
+	cfg := *params.AllDevChainProtocolChanges
+	cfg.AmsterdamTime, cfg.BogotaTime, cfg.UBTTime = nil, nil, nil
+	cfg.ChainID = new(big.Int).Set(m.ChainID)
+	cfg.PQMigrate = &params.PQMigrateConfig{T0: now - 100, ReceivingTime: now - 100, T: now + 3600, W: 31536000, LegacySeedProofFromT0: true, PoolSlotSeconds: 12, Registry: common.HexToAddress("800"), FactRegistry: common.HexToAddress("801"), MaxPayloadBytes: 131072,
+		FullResearch: &params.PQFullResearchConfig{Backend: params.PQFinalBackend, Version: params.PQFinalVersion, NativeAlgorithmDigest: params.PQFinalAlgorithmDigest, FinalKeyDigest: params.PQFinalKeyDigest, Sunset: ^uint64(0), ProofLifetime: 604800, MaxProofBytes: params.PQFinalMaxProofBytes, MaxTxBytes: params.PQFinalMaxTxBytes, TxGasCap: params.MaxTxGas, VerifyGas: params.PQFinalVerifyGas}}
+	p, _ := setupPoolWithConfig(&cfg)
+	defer p.Close()
+	p.currentState.SetBalance(owner, uint256.NewInt(2000000000000000000), tracing.BalanceChangeUnspecified)
+	p.currentState.SetCode(cfg.PQMigrate.Registry, []byte{0}, tracing.CodeChangeUnspecified)
+	p.currentState.SetNonce(cfg.PQMigrate.Registry, 1, tracing.NonceChangeUnspecified)
+	row7Reset(t, p, now-12)
+	recipient := common.Address{}
+	plain, err := types.SignTx(types.NewTx(&types.DynamicFeeTx{ChainID: cfg.ChainID, Nonce: 0, GasTipCap: big.NewInt(1), GasFeeCap: big.NewInt(1), Gas: 21000, To: &recipient, Value: new(big.Int)}), types.LatestSignerForChainID(cfg.ChainID), key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	seed := [mldsa44.SeedSize]byte{0xa5}
+	pk, sk := mldsa44.NewKeyFromSeed(&seed)
+	en := &types.PQEnrollTx{ChainID: cfg.ChainID, Nonce: 1, GasTipCap: big.NewInt(1), GasFeeCap: big.NewInt(1), Gas: 1000000, AlgID: 1, PublicKey: pk.Bytes(), PoPSignature: make([]byte, mldsa44.SignatureSize)}
+	digest := core.PQEnrollmentDigest(cfg.ChainID, owner, en.Nonce, 1, en.PublicKey)
+	tag := []byte("ETH-PQ-ENROLL-POP/v1")
+	if err := mldsa44.SignTo(sk, append(append([]byte{}, tag...), digest[:]...), tag, false, en.PoPSignature); err != nil {
+		t.Fatal(err)
+	}
+	digest = en.SigningHash()
+	sig, err := crypto.Sign(digest[:], key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	en.R, en.S, en.V = new(big.Int).SetBytes(sig[:32]), new(big.Int).SetBytes(sig[32:64]), new(big.Int).SetUint64(uint64(sig[64]))
+	enroll := types.NewTx(en)
+	row7Add(t, p, plain, enroll)
+	head := &types.Header{Number: big.NewInt(1), Time: now, BaseFee: big.NewInt(1), GasLimit: 60000000, Difficulty: new(big.Int)}
+	random := common.Hash{}
+	evm := vm.NewEVM(vm.BlockContext{CanTransfer: core.CanTransfer, Transfer: core.Transfer, GetHash: func(uint64) common.Hash { return common.Hash{} }, BlockNumber: head.Number, Time: head.Time, BaseFee: head.BaseFee, GasLimit: head.GasLimit, Difficulty: head.Difficulty, Random: &random}, p.currentState, &cfg, vm.Config{})
+	defer evm.Release()
+	p.currentState.SetTxContext(migration.Hash(), 0, 0)
+	receipt, _, err := core.ApplyTransaction(context.Background(), evm, core.NewGasPool(head.GasLimit), p.currentState, head, migration)
+	if err != nil || receipt.Status != types.ReceiptStatusSuccessful {
+		t.Fatalf("pre-T proof transition: %v", err)
+	}
+	if record := core.ReadPQRecord(p.currentState, cfg.PQMigrate.Registry, owner); record.Mode != 2 || record.MigrationNonce != 1 {
+		t.Fatalf("migration record: %+v", record)
+	}
+	row7Reset(t, p, now)
+	if p.Get(plain.Hash()) != nil || p.Get(enroll.Hash()) != nil {
+		t.Fatal("pre-T proof left old ECDSA or enrollment authority in pool")
+	}
+	if pending, queued := p.Stats(); pending+queued != 0 {
+		t.Fatalf("stale pending=%d queued=%d", pending, queued)
+	}
+}
