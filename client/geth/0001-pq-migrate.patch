+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package legacypool
+
+import (
+	"errors"
+	"fmt"
+	"testing"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core"
+	"github.com/ethereum/go-ethereum/core/tracing"
+	"github.com/ethereum/go-ethereum/core/txpool"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/crypto"
+	"github.com/ethereum/go-ethereum/params"
+	"github.com/holiman/uint256"
+)
+
+// Real signed legacy envelope and real R1 checks, with a component StateDB.
+// Both pool implementations obtain the same time from txpool.PQPoolTime.
+func TestPQLegacySharedClockFreezeBoundary(t *testing.T) {
+	for _, slot := range []uint64{6, 12} {
+		t.Run(fmt.Sprint(slot), func(t *testing.T) {
+			cfg := *params.TestChainConfig
+			cfg.PQMigrate = &params.PQMigrateConfig{T0: 0, T: 1012, PoolSlotSeconds: slot, Registry: common.HexToAddress("800")}
+			pool, key := setupPoolWithConfig(&cfg)
+			defer pool.Close()
+			pool.mu.Lock()
+			defer pool.mu.Unlock()
+			pool.currentState.SetBalance(crypto.PubkeyToAddress(key.PublicKey), uint256.NewInt(1000000000), tracing.BalanceChangeUnspecified)
+			tx := transaction(0, 21000, key)
+			head := types.CopyHeader(pool.currentHead.Load())
+			head.Time = cfg.PQMigrate.T - slot - 1
+			pool.currentHead.Store(head)
+			if txpool.PQPoolTime(head, &cfg) != cfg.PQMigrate.T-1 {
+				t.Fatal("unexpected common clock")
+			}
+			if err := pool.validateTx(tx); err != nil {
+				t.Fatalf("T-1 should accept ordinary authority: %v", err)
+			}
+			head = types.CopyHeader(head)
+			head.Time++
+			pool.currentHead.Store(head)
+			if err := pool.validateTx(tx); !errors.Is(err, core.ErrECDSADisabled) {
+				t.Fatalf("T equality did not reject legacy envelope on %ds slots: %v", slot, err)
+			}
+			t.Logf("real signed legacy envelope, slot=%d: pool time T-1 accepted; T rejected ECDSA_DISABLED", slot)
+		})
+	}
+}
