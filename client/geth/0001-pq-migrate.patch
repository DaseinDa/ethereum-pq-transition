+)
+
+// pqStandInLibrary declares R-1's identity for the native library and accepts
+// every proof. It lets a sponsored 0x7e reach a block in both builds, since no
+// sponsored proof exists; nothing here verifies a proof, and no result of this
+// file is evidence about one.
+func pqStandInLibrary(t *testing.T, guest common.Hash) {
+	t.Helper()
+	saved := pqNativeLibrary
+	t.Cleanup(func() { pqNativeLibrary = saved })
+	identity := fmt.Sprintf(`{"native_algorithm_digest":%q,"algorithm_document_canonical":true,"native_algorithm_digest_hash":"keccak256","image_id":%q,"guest_sha256":%q,"dev_mode":false,"groth16":false}`,
+		params.PQSuccinctAlgorithmDigest.Hex(), params.PQSuccinctImageID.Hex(), guest.Hex())
+	pqNativeLibrary.identity = func() (string, bool) { return identity, true }
+	pqNativeLibrary.verify = func([]byte, []byte) int { return 0 }
+}
+
+const pqSigBlockT = 25 // after block 2 (time 20), at or before block 3 (time 30)
+
+func pqSeedKey(b byte) (*mldsa44.PublicKey, *mldsa44.PrivateKey) {
+	var seed [mldsa44.SeedSize]byte // public synthetic test seeds only
+	for i := range seed {
+		seed[i] = b
+	}
+	return mldsa44.NewKeyFromSeed(&seed)
+}
+
+func pqSignTag(t *testing.T, sk *mldsa44.PrivateKey, tag string, digest common.Hash) []byte {
+	t.Helper()
+	sig := make([]byte, mldsa44.SignatureSize)
+	if err := mldsa44.SignTo(sk, append([]byte(tag), digest[:]...), []byte(tag), false, sig); err != nil {
+		t.Fatal(err)
+	}
+	return sig
+}
+
+// pqSigBlockFixture is a three-block chain whose transactions carry real
+// ML-DSA-44 signatures: block 1 a 0x7d enrolling L1 and the 0x7c creating the
+// native sponsor S, block 2 the 0x7c activating L1, block 3 a 0x7e of a LEGACY
+// address sponsored by S (fee mode 2).
+type pqSigBlockFixture struct {
+	cfg     *params.ChainConfig
+	gspec   *Genesis
+	txs     [][]*types.Transaction
+	poison  []common.Hash // failure keys of the four valid signature inputs
+	epoch   string        // the cache epoch of the fork of every block
+	l1, l4  common.Address
+	sponsor common.Address
+	pk1     []byte
+	pkS     []byte
+	bad     *mldsa44.PrivateKey
+	badPK   []byte
+	enroll  func(from common.Address, pop *mldsa44.PrivateKey) *types.Transaction
+	pqTx    func(from common.Address, nonce uint64, pk []byte, key *mldsa44.PrivateKey) *types.Transaction
+	migrate func(legacy common.Address, key *mldsa44.PrivateKey) *types.Transaction
+}
+
+func newPQSigBlockFixture(t *testing.T) *pqSigBlockFixture {
+	t.Helper()
+	guest := common.HexToHash("222f5a31d92e9fd062749f6b83b7f811d810a6cb4fbee222081bb2e41550f72e")
+	pqStandInLibrary(t, guest)
+	cfg := *params.MergedTestChainConfig
+	cfg.ChainID = new(big.Int).SetUint64(params.PQR1ChainID)
+	cfg.PQMigrate = &params.PQMigrateConfig{T: pqSigBlockT, W: 31536000, MaxPayloadBytes: 131072,
+		Registry: common.HexToAddress("800"), FactRegistry: common.HexToAddress("801"),
+		FullResearch: &params.PQFullResearchConfig{Backend: params.PQSuccinctNativeBackend, NativeAlgorithmDigest: params.PQSuccinctAlgorithmDigest,
+			Version: params.PQR1Version, Sunset: 10000000, ProofLifetime: 604800,
+			MaxProofBytes: params.PQSuccinctMaxProofBytes, MaxTxBytes: params.PQSuccinctMaxTxBytes, TxGasCap: params.MaxTxGas, VerifyGas: 5500000,
+			ImageID: params.PQSuccinctImageID, GuestSHA: guest}}
+	if err := cfg.CheckConfigForkOrder(); err != nil {
+		t.Fatal(err)
+	}
+	if cfg.LatestFork(10) != cfg.LatestFork(30) {
+		t.Fatal("blocks 1-3 must share one fork")
+	}
+	f := &pqSigBlockFixture{cfg: &cfg, epoch: "FIPS204-pure-ML-DSA-44/" + cfg.LatestFork(10).String()}
+	key1, _ := crypto.HexToECDSA("8a1f9a8f95be41cd7ccb6168179afb4504aefe388d1e14474d32c45c72ce7b7a")
+	key4, _ := crypto.HexToECDSA("b71c71a67e1177ad4e901695e1b4b9ee17ae16c6668d313eac2f96dbcda3f291")
+	f.l1, f.l4 = crypto.PubkeyToAddress(key1.PublicKey), crypto.PubkeyToAddress(key4.PublicKey)
+	ecdsaKeys := map[common.Address]*ecdsa.PrivateKey{f.l1: key1, f.l4: key4}
+	pk1, sk1 := pqSeedKey(0x31)
+	pkS, skS := pqSeedKey(0x32)
+	pkN, _ := pqSeedKey(0x33)
+	badPK, bad := pqSeedKey(0x34)
+	f.pk1, f.pkS, f.bad, f.badPK = pk1.Bytes(), pkS.Bytes(), bad, badPK.Bytes()
+	f.sponsor = common.BytesToAddress(crypto.Keccak256([]byte("PQ-ADDR"), []byte{1}, pkS.Bytes())[12:])
+	chainID := cfg.ChainID
+	tip, fee := big.NewInt(params.GWei), big.NewInt(10*params.GWei)
+	recipient := common.HexToAddress("7777777777777777777777777777777777777777")
+
+	f.enroll = func(from common.Address, pop *mldsa44.PrivateKey) *types.Transaction {
+		en := &types.PQEnrollTx{ChainID: chainID, GasTipCap: tip, GasFeeCap: fee, Gas: 500000, AlgID: 1, PublicKey: pk1.Bytes()}
+		en.PoPSignature = pqSignTag(t, pop, "ETH-PQ-ENROLL-POP/v1", PQEnrollmentDigest(chainID, from, 0, 1, en.PublicKey))
+		h := en.SigningHash()
+		sig, err := crypto.Sign(h[:], ecdsaKeys[from])
+		if err != nil {
+			t.Fatal(err)
+		}
+		en.R, en.S, en.V = new(big.Int).SetBytes(sig[:32]), new(big.Int).SetBytes(sig[32:64]), new(big.Int).SetUint64(uint64(sig[64]))
+		return types.NewTx(en)
+	}
+	f.pqTx = func(from common.Address, nonce uint64, pk []byte, key *mldsa44.PrivateKey) *types.Transaction {
+		p := &types.PQTx{ChainID: chainID, From: from, Nonce: nonce, GasTipCap: tip, GasFeeCap: fee, Gas: 1000000, To: recipient, Value: new(big.Int), AlgID: 1}
+		if pk != nil {
+			p.PublicKey = [][]byte{pk}
+		}
+		p.Signature = pqSignTag(t, key, "ETH-PQ-TX/v1", p.SigningHash())
+		return types.NewTx(p)
+	}
+	f.migrate = func(legacy common.Address, key *mldsa44.PrivateKey) *types.Transaction {
+		m := &types.PQMigrateTx{ChainID: chainID, LegacyAddress: legacy, AlgID: 1, PQPKCommit: PQKeyCommit(1, pkN.Bytes()),
+			Expiry: 1000, MaxAccountFee: new(big.Int), FeeMode: 2, GasTipCap: tip, GasFeeCap: fee, Gas: 6000000,
+			SponsorOption: &types.PQMigrationSponsor{Sponsor: f.sponsor, ValidUntil: 1000}, VerifierVersion: params.PQR1Version,
+			ProofCarrier: types.PQMigrationCarrier{Proof: []byte("stand-in proof: accepted by the stand-in library only")}}
+		m.SponsorOption.Signature = pqSignTag(t, key, "ETH-PQ-SPONSOR/v1", m.SponsorSigningHash())
+		return types.NewTx(m)
+	}
+
+	enroll := f.enroll(f.l1, sk1)
+	create := f.pqTx(f.sponsor, 0, pkS.Bytes(), skS)
+	activate := f.pqTx(f.l1, 1, pk1.Bytes(), sk1)
+	recovery := f.migrate(common.HexToAddress("7e00000000000000000000000000000000000001"), skS)
+	f.txs = [][]*types.Transaction{{enroll, create}, {activate}, {recovery}}
+	en, _ := enroll.AsPQEnroll()
+	cr, _ := create.AsPQTx()
+	ac, _ := activate.AsPQTx()
+	mi, _ := recovery.AsPQMigrate()
+	f.poison = []common.Hash{
+		pqSignatureFailureKey(pk1.Bytes(), "ETH-PQ-ENROLL-POP/v1", PQEnrollmentDigest(chainID, f.l1, 0, 1, en.PublicKey), en.PoPSignature),
+		pqSignatureFailureKey(pkS.Bytes(), "ETH-PQ-TX/v1", cr.SigningHash(), cr.Signature),
+		pqSignatureFailureKey(pk1.Bytes(), "ETH-PQ-TX/v1", ac.SigningHash(), ac.Signature),
+		pqSignatureFailureKey(pkS.Bytes(), "ETH-PQ-SPONSOR/v1", mi.SponsorSigningHash(), mi.SponsorOption.Signature),
+	}
+	funds := new(big.Int).Mul(big.NewInt(10), big.NewInt(params.Ether))
+	f.gspec = &Genesis{Config: &cfg, GasLimit: 60000000, Alloc: withSystemContracts(types.GenesisAlloc{
+		f.l1:                       {Balance: funds},
+		f.l4:                       {Balance: funds},
+		f.sponsor:                  {Balance: funds},
+		cfg.PQMigrate.Registry:     {Code: []byte{0}, Nonce: 1, Balance: new(big.Int)},
+		cfg.PQMigrate.FactRegistry: {Code: []byte{0}, Nonce: 1, Balance: new(big.Int)},
+	})}
+	return f
+}
+
+// build runs block building (BlockGen.AddTx, that is ApplyMessage) and returns
+// a transaction it refused as an error instead of a panic.
+func (f *pqSigBlockFixture) build() (blocks []*types.Block, err error) {
+	defer func() {
+		if r := recover(); r != nil {
+			blocks, err = nil, fmt.Errorf("block building refused a transaction: %v", r)
+		}
+	}()
+	_, blocks, _ = GenerateChainWithGenesis(f.gspec, beacon.New(ethash.NewFaker()), len(f.txs), func(i int, b *BlockGen) {
+		for _, tx := range f.txs[i] {
+			b.AddTx(tx)
+		}
+	})
+	return blocks, nil
+}
+
+// insert imports blocks into a fresh chain (InsertChain, through ApplyMessage).
+func (f *pqSigBlockFixture) insert(t *testing.T, blocks []*types.Block) (*BlockChain, error) {
+	t.Helper()
+	chain, err := NewBlockChain(rawdb.NewMemoryDatabase(), f.gspec, beacon.New(ethash.NewFaker()), nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(chain.Stop)
+	if n, err := chain.InsertChain(blocks); err != nil {
+		return chain, fmt.Errorf("block %d: %w", n, err)
+	}
+	return chain, nil
+}
+
+// replaced returns block b with its transaction j replaced; header fields other
+// than the body commitments are kept, so only the new transaction can fail.
+func replaced(b *types.Block, j int, tx *types.Transaction) *types.Block {
+	txs := append([]*types.Transaction(nil), b.Transactions()...)
+	txs[j] = tx
+	return types.NewBlock(b.Header(), &types.Body{Transactions: txs, Withdrawals: b.Withdrawals()}, nil, trie.NewStackTrie(nil))
+}
+
+// Spec l. 2808 and l. 2895 (defect (h) of section 22.7): block building and
+// import never consult the ML-DSA-44 negative signature cache and verify each
+// signature again, while the pool call sites keep using it (section 20.3,
+// N-1, N-3, N-4 and N-5). A lookup is counted where it reaches the cache's
+// verifier: on an empty cache every lookup of a valid signature does.
+func TestPQSignatureCacheBlockPathsNotConsulted(t *testing.T) {
+	f := newPQSigBlockFixture(t)
+	saved := pqSignatureFailures
+	t.Cleanup(func() { pqSignatureFailures = saved })
+	// Block import runs a prefetcher beside the processor, so lookups may come
+	// from two goroutines.
+	var lookups atomic.Int64
+	counting := func() {
+		lookups.Store(0)
+		pqSignatureFailures = newPQSignatureFailureCache(1024, func(pk []byte, tag string, d common.Hash, sig []byte) bool {
+			lookups.Add(1)
+			return verifyPQMigrationSignatureUncached(pk, tag, d, sig)
+		})
+	}
+	poisoned := func() {
+		counting()
+		pqSignatureFailures.epoch = f.epoch
+		for _, key := range f.poison {
+			pqSignatureFailures.entries.Add(key, struct{}{})
+		}
+	}
+
+	t.Run("build-no-lookup", func(t *testing.T) {
+		counting()
+		if _, err := f.build(); err != nil {
+			t.Fatal(err)
+		}
+		if n := lookups.Load(); n != 0 {
+			t.Fatalf("block building consulted the negative cache: %d lookups for 4 signatures", n)
+		}
+	})
+	t.Run("build-verifies-again", func(t *testing.T) {
+		poisoned()
+		if _, err := f.build(); err != nil {
+			t.Fatalf("block building took a signature result from the cache: %v", err)
+		}
+	})
+	pqSignatureFailures = newPQSignatureFailureCache(1024, verifyPQMigrationSignatureUncached)
+	blocks, err := f.build()
+	if err != nil || len(blocks) != 3 {
+		t.Fatal("fixture chain", err)
+	}
+	t.Run("import-no-lookup", func(t *testing.T) {
+		counting()
+		if _, err := f.insert(t, blocks); err != nil {
+			t.Fatal(err)
+		}
+		if n := lookups.Load(); n != 0 {
+			t.Fatalf("block import consulted the negative cache: %d lookups for 4 signatures", n)
+		}
+	})
+	t.Run("import-verifies-again", func(t *testing.T) {
+		poisoned()
+		if _, err := f.insert(t, blocks); err != nil {
+			t.Fatalf("block import took a signature result from the cache: %v", err)
+		}
+	})
+	// Control: not consulting the cache must not mean not verifying.
+	t.Run("import-rejects-bad-signature", func(t *testing.T) {
+		for _, c := range []struct {
+			name   string
+			block  int
+			index  int
+			tx     *types.Transaction
+			reason string
+		}{
+			{"0x7d-pop", 0, 0, f.enroll(f.l1, f.bad), "BAD_POP"},
+			{"0x7c-native", 0, 1, f.pqTx(f.sponsor, 0, f.pkS, f.bad), "BAD_PQ_SIG"},
+			{"0x7c-activation", 1, 0, f.pqTx(f.l1, 1, f.pk1, f.bad), "BAD_PQ_SIG"},
+			{"0x7e-sponsor", 2, 0, f.migrate(common.HexToAddress("7e00000000000000000000000000000000000001"), f.bad), "BAD_SPONSOR_SIG"},
+		} {
+			t.Run(c.name, func(t *testing.T) {
+				counting()
+				chain := append(append([]*types.Block(nil), blocks[:c.block]...), replaced(blocks[c.block], c.index, c.tx))
+				if _, err := f.insert(t, chain); err == nil || !strings.Contains(err.Error(), c.reason) {
+					t.Fatalf("bad signature not rejected at import with %s: %v", c.reason, err)
+				}
+			})
+		}
+	})
+
+	// The pool call sites (ValidatePQTransaction for the nonce-ordered subpool,
+	// ValidatePQMigrateState for the pqpool) still use the cache.
+	pqSignatureFailures = newPQSignatureFailureCache(1024, verifyPQMigrationSignatureUncached)
+	chain, err := f.insert(t, blocks)
+	if err != nil {
+		t.Fatal(err)
+	}
+	head, err := chain.State()
+	if err != nil {
+		t.Fatal(err)
+	}
+	at := func(time uint64) *types.Header {
+		return &types.Header{Number: big.NewInt(4), Time: time, BaseFee: big.NewInt(params.InitialBaseFee), Difficulty: new(big.Int)}
+	}
+	spend := f.pqTx(f.l1, 2, nil, f.bad) // signed with a key L1 does not hold
+	check := func(t *testing.T, s *state.StateDB, c *params.ChainConfig, h *types.Header, tx *types.Transaction, want string, wantLookups int64) {
+		t.Helper()
+		var err error
+		if tx.Type() == types.PQMigrateTxType {
+			err = ValidatePQMigrateState(tx, s.Copy(), h, c)
+		} else {
+			err = ValidatePQTransaction(s.Copy(), c, h, tx, false)
+		}
+		if got := fmt.Sprint(err); (want == "" && err != nil) || (want != "" && got != want) {
+			t.Fatalf("pool check: got %v, want %q", err, want)
+		}
+		if n := lookups.Load(); n != wantLookups {
+			t.Fatalf("pool verifications: got %d, want %d", n, wantLookups)
+		}
+	}
+	t.Run("pool-N3-same-key-cached", func(t *testing.T) {
+		counting()
+		check(t, head, f.cfg, at(40), spend, "BAD_PQ_SIG", 1)
+		check(t, head, f.cfg, at(40), spend, "BAD_PQ_SIG", 1)
+		check(t, head, f.cfg, at(40), f.migrate(common.HexToAddress("7e00000000000000000000000000000000000002"), f.bad), "BAD_SPONSOR_SIG (0x0403)", 2)
+		check(t, head, f.cfg, at(40), f.migrate(common.HexToAddress("7e00000000000000000000000000000000000002"), f.bad), "BAD_SPONSOR_SIG (0x0403)", 2)
+		check(t, head, f.cfg, at(20), f.enroll(f.l4, f.bad), "BAD_POP", 3)
+		check(t, head, f.cfg, at(20), f.enroll(f.l4, f.bad), "BAD_POP", 3)
+	})
+	t.Run("pool-N1-other-key-verified", func(t *testing.T) {
+		counting()
+		check(t, head, f.cfg, at(40), spend, "BAD_PQ_SIG", 1)
+		rotated := head.Copy() // the key change a rotate would make, written directly
+		rotated.SetCode(f.l1, append([]byte{0xef, 1, 1}, f.badPK...), tracing.CodeChangeUnspecified)
+		r := ReadPQRecord(rotated, f.cfg.PQMigrate.Registry, f.l1)
+		r.Commit = PQKeyCommit(1, f.badPK)
+		writePQRecord(rotated, f.cfg.PQMigrate.Registry, f.l1, r)
+		check(t, rotated, f.cfg, at(40), spend, "", 2)
+	})
+	t.Run("pool-N4-other-tag-verified", func(t *testing.T) {
+		counting()
+		p, _ := spend.AsPQTx()
+		for i, tag := range []string{"ETH-PQ-TX/v1", "ETH-PQ-SPONSOR/v1", "ETH-PQ-TX/v1", "ETH-PQ-SPONSOR/v1"} {
+			if verifyPQMigrationSignatureAt(f.cfg, at(40), f.pk1, tag, p.SigningHash(), p.Signature) || lookups.Load() != int64(min(i+1, 2)) {
+				t.Fatalf("tag %s: lookups=%d", tag, lookups.Load())
+			}
+		}
+	})
+	t.Run("pool-N5-fork-not-consulted", func(t *testing.T) {
+		counting()
+		forked := *f.cfg
+		bpo1 := uint64(50)
+		forked.BPO1Time = &bpo1
+		check(t, head, &forked, at(40), spend, "BAD_PQ_SIG", 1)
+		check(t, head, &forked, at(40), spend, "BAD_PQ_SIG", 1)
+		check(t, head, &forked, at(50), spend, "BAD_PQ_SIG", 2) // after the fork
+		check(t, head, &forked, at(40), spend, "BAD_PQ_SIG", 3) // back across it
+	})
+}
diff --git a/core/pq_signature_cache_test.go b/core/pq_signature_cache_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..8c29cdf1123aa8d2c2b6fcbce47ef2a66141b62f
--- /dev/null
+++ b/core/pq_signature_cache_test.go
@@ -0,0 +1,123 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package core
+
+import (
+	"bytes"
+	"sync"
+	"sync/atomic"
+	"testing"
+
+	"github.com/cloudflare/circl/sign/mldsa/mldsa44"
+	"github.com/ethereum/go-ethereum/common"
+)
+
+func pqCacheVector(t *testing.T) ([]byte, []byte, string, common.Hash, []byte) {
+	t.Helper()
+	var a, b [mldsa44.SeedSize]byte // Public synthetic test keys only.
+	b[0] = 1
+	pkA, _ := mldsa44.NewKeyFromSeed(&a)
+	pkB, skB := mldsa44.NewKeyFromSeed(&b)
+	tag, digest := "ETH-PQ-SPONSOR/v1", common.HexToHash("1234")
+	sig := make([]byte, mldsa44.SignatureSize)
+	if err := mldsa44.SignTo(skB, append([]byte(tag), digest[:]...), []byte(tag), false, sig); err != nil {
+		t.Fatal(err)
+	}
+	return pkA.Bytes(), pkB.Bytes(), tag, digest, sig
+}
+
+func TestPQSignatureCacheCompleteInvocation(t *testing.T) {
+	pkA, pkB, tag, digest, sig := pqCacheVector(t)
+	calls := 0
+	c := newPQSignatureFailureCache(16, func(pk []byte, tag string, d common.Hash, sig []byte) bool {
+		calls++
+		return verifyPQMigrationSignatureUncached(pk, tag, d, sig)
+	})
+	if c.verify("fork1", pkA, tag, digest, sig) || c.verify("fork1", pkA, tag, digest, sig) || calls != 1 {
+		t.Fatalf("repeated bad signature must fail with one verification, calls=%d", calls)
+	}
+	// Same signature/digest/account nonce after rotation or reorg: a different
+	// current key must be checked, and this real ML-DSA signature is now valid.
+	if !c.verify("fork1", pkB, tag, digest, sig) || calls != 2 {
+		t.Fatal("old-key failure poisoned new-key verification")
+	}
+	if !c.verify("fork1", pkB, tag, digest, sig) || calls != 3 {
+		t.Fatal("success must not enter the failure cache")
+	}
+	otherDigest := digest
+	otherDigest[0] ^= 1
+	otherSig := bytes.Clone(sig)
+	otherSig[0] ^= 1
+	for _, v := range []struct {
+		tag    string
+		digest common.Hash
+		sig    []byte
+	}{
+		{tag + "x", digest, sig}, {tag, otherDigest, sig}, {tag, digest, otherSig},
+	} {
+		before := calls
+		if c.verify("fork1", pkA, v.tag, v.digest, v.sig) || calls != before+1 {
+			t.Fatal("changed invocation improperly reused failure")
+		}
+		if c.verify("fork1", pkA, v.tag, v.digest, v.sig) || calls != before+1 {
+			t.Fatal("exact failure was not cached")
+		}
+	}
+	t.Logf("real ML-DSA: repeats avoided, key/tag/digest/signature separated; verifier calls=%d", calls)
+}
+
+func TestPQSignatureCacheBoundForkAndMalformed(t *testing.T) {
+	pk, _, tag, digest, sig := pqCacheVector(t)
+	calls := 0
+	c := newPQSignatureFailureCache(2, func([]byte, string, common.Hash, []byte) bool { calls++; return false })
+	for i := byte(0); i < 3; i++ {
+		digest[0] = i
+		c.verify("fork1", pk, tag, digest, sig)
+	}
+	if c.entries.Len() != 2 || calls != 3 {
+		t.Fatal("cache not bounded")
+	}
+	digest[0] = 0
+	c.verify("fork1", pk, tag, digest, sig)
+	if calls != 4 {
+		t.Fatal("oldest entry not evicted")
+	}
+	c.verify("fork2", pk, tag, digest, sig)
+	c.verify("fork1", pk, tag, digest, sig)
+	if calls != 6 || c.entries.Len() != 1 {
+		t.Fatal("fork transition/reorg did not purge")
+	}
+	if c.verify("fork1", pk[:1], tag, digest, sig) || c.verify("fork1", pk, tag, digest, sig[:1]) || c.verify("fork1", pk, string(make([]byte, 256)), digest, sig) || calls != 6 {
+		t.Fatal("malformed sizes reached expensive check")
+	}
+}
+
+func TestPQSignatureCacheConcurrentEpochChange(t *testing.T) {
+	pk, _, tag, digest, sig := pqCacheVector(t)
+	started, finish := make(chan struct{}), make(chan struct{})
+	var calls atomic.Int64
+	c := newPQSignatureFailureCache(8, func([]byte, string, common.Hash, []byte) bool {
+		if calls.Add(1) == 1 {
+			close(started)
+			<-finish
+		}
+		return false
+	})
+	var wg sync.WaitGroup
+	wg.Add(1)
+	go func() { defer wg.Done(); c.verify("old", pk, tag, digest, sig) }()
+	<-started
+	other := digest
+	other[0] ^= 1
+	c.verify("new", pk, tag, other, sig)
+	close(finish)
+	wg.Wait()
+	if c.entries.Len() != 1 {
+		t.Fatal("old result inserted after fork purge")
+	}
+	c.verify("new", pk, tag, digest, sig)
+	if calls.Load() != 3 {
+		t.Fatal("stale in-flight result was reused")
+	}
+}
