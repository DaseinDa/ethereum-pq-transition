@@ -0,0 +1,34 @@
+//go:build cgo && pq_native
+
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package core
+
+/*
+#cgo LDFLAGS: -l:libpq_succinct_native.a -ldl -lpthread -lm
+#include <stdint.h>
+#include <stddef.h>
+extern int32_t pq_verify_succinct_v1(const uint8_t*, size_t, const uint8_t*, size_t);
+extern const char* pq_succinct_identity_v1(void);
+*/
+import "C"
+
+import "unsafe"
+
+func pqNativeIdentityJSON() (string, bool) {
+	p := C.pq_succinct_identity_v1()
+	if p == nil {
+		return "", false
+	}
+	return C.GoString(p), true
+}
+
+func pqNativeVerify(proof, pi []byte) int {
+	if len(proof) == 0 || len(pi) != 198 {
+		return 1
+	}
+	return int(C.pq_verify_succinct_v1(
+		(*C.uint8_t)(unsafe.Pointer(&proof[0])), C.size_t(len(proof)),
+		(*C.uint8_t)(unsafe.Pointer(&pi[0])), C.size_t(len(pi))))
+}
