+func TestPQPoolProofCacheNegativeAndLocalFailure(t *testing.T) {
+	t.Run("negative-source-budget", func(t *testing.T) {
+		p, _, calls := componentPool(t)
+		tx := componentTx(1, 20, 2, 20)
+		p.checkProof = func(*types.Transaction, *params.ChainConfig, string) error {
+			*calls++
+			return core.ErrPQInvalidFullProof
+		}
+		for i := 0; i < 4; i++ {
+			if err := add(p, tx); !errors.Is(err, core.ErrPQInvalidFullProof) {
+				t.Fatal(err)
+			}
+		}
+		if *calls != 1 || p.proofCacheNegativeHits != 3 || p.sources["rpc:component"].failures != 4 {
+			t.Fatal("negative cache avoided source accounting or repeated verifier")
+		}
+		if err := add(p, tx); !errors.Is(err, txpool.ErrPQSourceBudget) {
+			t.Fatal("invalid budget not enforced", err)
+		}
+		good := changed(tx, func(m *types.PQMigrateTx) { m.ProofCarrier.Proof[0] ^= 1 })
+		p.checkProof = func(*types.Transaction, *params.ChainConfig, string) error { *calls++; return nil }
+		if err := p.AddFrom("other-source", []*types.Transaction{good}, true)[0]; err != nil {
+			t.Fatal("negative PI/address poisoning", err)
+		}
+		if *calls != 2 {
+			t.Fatal("different proof did not verify")
+		}
+	})
+	for name, failure := range map[string]error{
+		"worker":    core.ErrPQFullUnavailable,
+		"timeout":   fmt.Errorf("timeout: %w", core.ErrPQFullUnavailable),
+		"local-io":  errors.New("local IO failure"),
+		"state":     ErrLocalUnavailable,
+		"ambiguous": errors.Join(core.ErrPQInvalidFullProof, core.ErrPQFullUnavailable),
+	} {
+		t.Run(name, func(t *testing.T) {
+			p, _, calls := componentPool(t)
+			tx := componentTx(1, 20, 2, 20)
+			p.checkProof = func(*types.Transaction, *params.ChainConfig, string) error { *calls++; return failure }
+			for i := 0; i < 2; i++ {
+				if err := add(p, tx); err == nil {
+					t.Fatal("local failure accepted")
+				}
+			}
+			if *calls != 2 || p.negativeCache.len() != 0 || p.positiveCache.len() != 0 {
+				t.Fatal("local failure poisoned cache")
+			}
+			p.checkProof = func(*types.Transaction, *params.ChainConfig, string) error { *calls++; return nil }
+			if err := add(p, tx); err != nil {
+				t.Fatal("repair failed", err)
+			}
+			if *calls != 3 {
+				t.Fatal("repair bypassed verifier")
+			}
+		})
+	}
+}
+
+func TestPQPoolProofCacheBoundedAndVersionSunset(t *testing.T) {
+	p, c, _ := componentPool(t)
+	p.positiveCache = newProofResultCache(2*proofCacheEntryBytes + 1)
+	p.negativeCache = newProofResultCache(proofCacheEntryBytes)
+	tx := componentTx(1, 20, 2, 20)
+	for i := byte(1); i <= 3; i++ {
+		if err := p.verifyProofCached(componentTx(i, 20, 2, 20), "test", "test"); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if p.positiveCache.len() != 2 || p.positiveCache.bytes() > p.positiveCache.limit || p.positiveCache.has(p.proofResultKey(tx)) {
+		t.Fatal("positive LRU byte bound")
+	}
+	p.checkProof = func(*types.Transaction, *params.ChainConfig, string) error { return core.ErrPQInvalidFullProof }
+	for i := byte(4); i <= 6; i++ {
+		p.verifyProofCached(componentTx(i, 20, 2, 20), "test", "test")
+	}
+	if p.negativeCache.len() != 1 || p.positiveCache.len() != 2 {
+		t.Fatal("negative flood evicted positive results or exceeded cap")
+	}
+	c.cfg.PQMigrate.FullResearch.Version++
+	p.pruneProofCaches()
+	if p.positiveCache.len() != 0 || p.negativeCache.len() != 0 {
+		t.Fatal("retired version retained")
+	}
+	c.cfg.PQMigrate.FullResearch.Version--
+	p.positiveCache.add(p.proofResultKey(tx), c.cfg.PQMigrate.FullResearch.Version, p.nextHeader().Time)
+	p.pruneProofCaches()
+	if p.positiveCache.len() != 0 {
+		t.Fatal("sunset equality retained")
+	}
+	zero := newProofResultCache(proofCacheEntryBytes - 1)
+	zero.add(common.Hash{}, 1, math.MaxUint64)
+	if zero.len() != 0 {
+		t.Fatal("undersized cache accepted entry")
+	}
+}
+
+func TestPQPoolSharedClockSlotAndSponsorBoundary(t *testing.T) {
+	for _, slot := range []uint64{6, 12} {
+		t.Run(fmt.Sprint(slot), func(t *testing.T) {
+			p, c, calls := componentPool(t)
+			c.cfg.PQMigrate.PoolSlotSeconds = slot
+			if p.nextHeader().Time != txpool.PQPoolTime(p.head, c.cfg) || p.nextHeader().Time != 1000+slot || p.sponsorHorizon() != 10*slot {
+				t.Fatal("pool clock/horizon differs from shared consensus slot")
+			}
+			boundary := 1000 + slot + 10*slot
+			bad := changed(componentTx(1, 20, 2, 20), func(m *types.PQMigrateTx) { m.SponsorOption.ValidUntil = boundary - 1 })
+			if err := add(p, bad); !errors.Is(err, ErrSponsorHorizon) {
+				t.Fatal(err)
+			}
+			good := changed(componentTx(1, 20, 2, 20), func(m *types.PQMigrateTx) { m.SponsorOption.ValidUntil = boundary })
+			if err := add(p, good); err != nil {
+				t.Fatal(err)
+			}
+			if *calls != 1 {
+				t.Fatal("horizon failed after expensive check")
+			}
+			p.head.Time = math.MaxUint64 - slot + 1
+			if p.nextHeader().Time != math.MaxUint64 {
+				t.Fatal("clock overflow")
+			}
+		})
+	}
+}
