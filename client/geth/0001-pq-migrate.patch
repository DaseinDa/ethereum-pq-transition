+)
+
+type mode0RealChain struct {
+	cfg *params.ChainConfig
+	s   *state.StateDB
+}
+
+func (c *mode0RealChain) Config() *params.ChainConfig                   { return c.cfg }
+func (c *mode0RealChain) StateAt(*types.Header) (*state.StateDB, error) { return c.s.Copy(), nil }
+func (c *mode0RealChain) GetBlock(common.Hash, uint64) *types.Block     { return nil }
+
+func mode0PoolHash(t *testing.T, value, name string) common.Hash {
+	t.Helper()
+	b, err := hex.DecodeString(strings.TrimPrefix(value, "0x"))
+	if err != nil || len(b) != 32 {
+		t.Fatalf("missing or invalid fixed %s", name)
+	}
+	return common.BytesToHash(b)
+}
+
+func mode0RealPool(t *testing.T) (*Pool, *mode0RealChain, *types.Transaction) {
+	t.Helper()
+	actualHistoricalProfile(t)
+	dir := os.Getenv("PQ_MODE0_FIXTURES")
+	if dir == "" || os.Getenv("PQ_FULL_VERIFIER_PATH") == "" {
+		t.Fatal("PQ_MODE0_FIXTURES and PQ_FULL_VERIFIER_PATH required; no mock/skip fallback")
+	}
+	t.Setenv("RISC0_DEV_MODE", "0")
+	b, err := os.ReadFile(filepath.Join(dir, "config.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var f struct {
+		Image        string `json:"image_id"`
+		Guest        string `json:"guest_sha256"`
+		Worker       string `json:"verifier_sha256"`
+		PI           string `json:"expected_pi_sha256"`
+		Sunset       uint64 `json:"version_sunset"`
+		Lifetime     uint64 `json:"proof_max_lifetime"`
+		Registry     string `json:"registry"`
+		FactRegistry string `json:"fact_registry"`
+	}
+	if err = json.Unmarshal(b, &f); err != nil {
+		t.Fatal(err)
+	}
+	raw, err := os.ReadFile(filepath.Join(dir, "mode0.bin"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	tx := new(types.Transaction)
+	if err = tx.UnmarshalBinary(raw); err != nil {
+		t.Fatal(err)
+	}
+	again, err := tx.MarshalBinary()
+	if err != nil || !bytes.Equal(raw, again) {
+		t.Fatal("mode0 raw not canonical")
+	}
+	if tx.Gas() > params.MaxTxGas {
+		t.Skip("historical Composite carrier exceeds standard gas cap; not current execution evidence")
+	}
+	m, ok := tx.AsPQMigrate()
+	if !ok || m.FeeMode != 0 || m.SponsorOption != nil || m.LaneAuthOption != nil || m.ProofCarrier.Route != 0 || m.MigrationNonce != 0 {
+		t.Fatal("expected mode0 Route A nonce0")
+	}
+	if len(m.PublicInputs()) != 198 || common.Hash(sha256.Sum256(m.PublicInputs())) != mode0PoolHash(t, f.PI, "PI SHA-256") {
+		t.Fatal("fixed full PI mismatch")
+	}
+	if m.Expiry < 3600 || f.Sunset <= m.Expiry || f.Lifetime < 3600 {
+		t.Fatal("fixture time configuration")
+	}
+	cfg := *params.AllDevChainProtocolChanges
+	cfg.ChainID = new(big.Int).Set(m.ChainID)
+	cfg.AmsterdamTime, cfg.BogotaTime, cfg.UBTTime = nil, nil, nil
+	cfg.PQMigrate = &params.PQMigrateConfig{T0: 0, T: m.Expiry - 3600, W: 31536000, ReceivingTime: 0, MaxPayloadBytes: 131072,
+		Registry: common.HexToAddress(f.Registry), FactRegistry: common.HexToAddress(f.FactRegistry),
+		FullResearch: &params.PQFullResearchConfig{Version: m.VerifierVersion, Activation: 0, Sunset: f.Sunset, ProofLifetime: f.Lifetime,
+			MaxProofBytes: 2 << 20, MaxTxBytes: 3 << 20, TxGasCap: params.MaxTxGas, VerifyGas: 5500000,
+			ImageID: mode0PoolHash(t, f.Image, "ImageID"), GuestSHA: mode0PoolHash(t, f.Guest, "guest SHA-256"), VerifierSHA: mode0PoolHash(t, f.Worker, "worker SHA-256")}}
+	if cfg.PQMigrate.Registry == (common.Address{}) || cfg.PQMigrate.FactRegistry == (common.Address{}) {
+		t.Fatal("fixed Registry addresses missing")
+	}
+	if err = cfg.CheckConfigForkOrder(); err != nil {
+		t.Fatal(err)
+	}
+	if err = core.CheckPQFullVerifierConfig(cfg.PQMigrate.FullResearch); err != nil {
+		t.Fatal(err)
+	}
+	s, err := state.New(types.EmptyRootHash, state.NewDatabaseForTesting())
+	if err != nil {
+		t.Fatal(err)
+	}
+	s.SetCode(cfg.PQMigrate.Registry, []byte{0}, tracing.CodeChangeUnspecified)
+	s.SetNonce(cfg.PQMigrate.Registry, 1, tracing.NonceChangeUnspecified)
+	s.SetBalance(m.LegacyAddress, uint256.NewInt(2000000000000000000), tracing.BalanceChangeUnspecified)
+	s.SetNonce(m.LegacyAddress, 9234, tracing.NonceChangeUnspecified)
+	c := &mode0RealChain{cfg: &cfg, s: s}
+	policy := DefaultConfig
+	policy.Datadir = t.TempDir()
+	p := New(policy, c) // Deliberately never replace checkState or checkProof.
+	h := &types.Header{Number: big.NewInt(1), Time: cfg.PQMigrate.T, GasLimit: 120000000, GasUsed: 60000000, BaseFee: big.NewInt(1000000000), Difficulty: new(big.Int)}
+	if err = p.Init(1, h, nil); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { p.Close() })
+	return p, c, tx
+}
+
+func mode0PoolEdit(tx *types.Transaction, edit func(*types.PQMigrateTx)) *types.Transaction {
+	m, _ := tx.AsPQMigrate()
+	own := types.NewTx(m)
+	m, _ = own.AsPQMigrate()
+	edit(m)
+	return types.NewTx(m)
+}
+func mode0Add(p *Pool, tx *types.Transaction) error {
+	return p.AddFrom("mode0-real", []*types.Transaction{tx}, true)[0]
+}
+func mode0Pending(t *testing.T, p *Pool, want int) {
+	t.Helper()
+	_, n := p.Pending(txpool.PendingFilter{OnlyPQ: true})
+	if n != want {
+		t.Fatalf("Pending=%d want=%d", n, want)
+	}
+}
+
+func TestPQMode0PoolActualFullAdmission(t *testing.T) {
+	p, c, tx := mode0RealPool(t)
+	m, _ := tx.AsPQMigrate()
+	before, _ := tx.MarshalBinary()
+	if err := mode0Add(p, tx); err != nil {
+		t.Fatal(err)
+	}
+	after, _ := tx.MarshalBinary()
+	got := p.Get(tx.Hash())
+	if got == nil {
+		t.Fatal("actual Full admission missing disk body")
+	}
+	rebuilt, _ := got.MarshalBinary()
+	if !bytes.Equal(before, after) || !bytes.Equal(before, rebuilt) || len(p.entries) != 1 || len(p.bodies) != 1 || len(p.entries[tx.Hash()].template.ProofCarrier.Proof) != 0 {
+		t.Fatal("canonical caller/disk proof storage")
+	}
+	if p.entries[tx.Hash()].key != (versionKey{legacy: m.LegacyAddress, payer: m.LegacyAddress}) || p.Nonce(m.LegacyAddress) != 0 || c.s.GetNonce(m.LegacyAddress) != 9234 || core.ReadPQRecord(c.s, c.cfg.PQMigrate.Registry, m.LegacyAddress).MigrationNonce != 0 {
+		t.Fatal("owner payer or ordinary nonce/state modified by pool")
+	}
+	mode0Pending(t, p, 1)
+	t.Logf("default real state/Full hooks accepted owner-keyed mode0, tx=%s rawBytes=%d proofBytes=%d; no sponsor account or signature", tx.Hash(), tx.Size(), len(m.ProofCarrier.Proof))
+}
+
+func TestPQMode0PoolActualFullReplacementAtomic(t *testing.T) {
+	p, _, tx := mode0RealPool(t)
+	old := mode0PoolEdit(tx, func(m *types.PQMigrateTx) {
+		m.GasFeeCap.Div(m.GasFeeCap, big.NewInt(2))
+		m.GasTipCap.Div(m.GasTipCap, big.NewInt(2))
+	})
+	if err := mode0Add(p, old); err != nil {
+		t.Fatal(err)
+	}
+	bad := mode0PoolEdit(tx, func(m *types.PQMigrateTx) { m.ProofCarrier.Proof[len(m.ProofCarrier.Proof)-1] ^= 1 })
+	if err := mode0Add(p, bad); !errors.Is(err, core.ErrPQInvalidFullProof) || errors.Is(err, core.ErrPQFullUnavailable) {
+		t.Fatalf("actual bad proof: %v", err)
+	}
+	if !p.Has(old.Hash()) || p.Has(bad.Hash()) || len(p.bodies) != 1 {
+		t.Fatal("failed Full displaced valid owner version")
+	}
+	if err := mode0Add(p, tx); err != nil {
+		t.Fatal(err)
+	}
+	if p.Has(old.Hash()) || !p.Has(tx.Hash()) || len(p.entries) != 1 || len(p.bodies) != 1 {
+		t.Fatal("valid Full replacement not atomic")
+	}
+	mode0Pending(t, p, 1)
+}
+
+func TestPQMode0PoolFeeBoundaries(t *testing.T) {
+	for _, shortBalance := range []bool{false, true} {
+		t.Run(map[bool]string{false: "cap_exceeded", true: "balance_short"}[shortBalance], func(t *testing.T) {
+			p, c, tx := mode0RealPool(t)
+			want := "FEE_CAP_EXCEEDED"
+			if shortBalance {
+				m, _ := tx.AsPQMigrate()
+				need := liability(m)
+				need.Sub(need, big.NewInt(1))
+				c.s.SetBalance(m.LegacyAddress, uint256.MustFromBig(need), tracing.BalanceChangeUnspecified)
+				p.state = c.s.Copy()
+				want = "INSUFFICIENT_FEE_BALANCE"
+			} else {
+				tx = mode0PoolEdit(tx, func(m *types.PQMigrateTx) { m.Gas++ })
+			}
+			if err := mode0Add(p, tx); errorName(err) != want {
+				t.Fatalf("have %v want %s", err, want)
+			}
+			mode0Pending(t, p, 0)
+			if len(p.bodies) != 0 || p.sources["mode0-real"].failures != 0 {
+				t.Fatal("fee precheck created proof body or consumed invalid-proof budget")
+			}
+			t.Log("state/fee precheck only; no Full verification claimed for rejected input")
+		})
+	}
+}
+
+func TestPQMode0PoolBalanceChangeRevalidated(t *testing.T) {
+	p, c, tx := mode0RealPool(t)
+	if err := mode0Add(p, tx); err != nil {
+		t.Fatal(err)
+	}
+	m, _ := tx.AsPQMigrate()
+	need := liability(m)
+	need.Sub(need, big.NewInt(1))
+	c.s.SetBalance(m.LegacyAddress, uint256.MustFromBig(need), tracing.BalanceChangeUnspecified)
+	p.Reset(p.head, p.head)
+	mode0Pending(t, p, 0)
+	if p.Has(tx.Hash()) || len(p.bodies) != 0 || len(p.bans) != 0 || len(p.deferred) != 0 {
+		t.Fatal("insolvent owner not evicted cleanly, or incorrectly sponsor-banned")
+	}
+}
+
+func TestPQMode0PoolMigrationNonceChangeRevalidated(t *testing.T) {
+	p, c, tx := mode0RealPool(t)
+	if err := mode0Add(p, tx); err != nil {
+		t.Fatal(err)
+	}
+	m, _ := tx.AsPQMigrate()
+	a, b := core.PQRecordSlots(m.LegacyAddress)
+	word := common.Hash{}
+	word[31] = 2
+	word[30] = 1
+	binary.BigEndian.PutUint64(word[14:22], 1)
+	c.s.SetState(c.cfg.PQMigrate.Registry, a, word)
+	c.s.SetState(c.cfg.PQMigrate.Registry, b, m.PQPKCommit)
+	p.Reset(p.head, p.head)
+	mode0Pending(t, p, 0)
+	if p.Has(tx.Hash()) || len(p.bodies) != 0 || c.s.GetNonce(m.LegacyAddress) != 9234 {
+		t.Fatal("consumed migration nonce retained or ordinary nonce changed")
+	}
+}
+
+func TestPQMode0PoolWorkerFailureDeferredAndRetry(t *testing.T) {
+	p, _, tx := mode0RealPool(t)
+	worker := os.Getenv("PQ_FULL_VERIFIER_PATH")
+	t.Setenv("PQ_FULL_VERIFIER_PATH", filepath.Join(t.TempDir(), "missing-worker"))
+	if err := mode0Add(p, tx); !errors.Is(err, core.ErrPQFullUnavailable) {
+		t.Fatal(err)
+	}
+	mode0Pending(t, p, 0)
+	if p.sources["mode0-real"].failures != 0 || len(p.bodies) != 0 {
+		t.Fatal("outage treated as bad proof or accepted")
+	}
+	// Initial Add returns a retryable local diagnostic, not a persistence
+	// promise. Restore the worker and explicitly resubmit that first attempt.
+	t.Setenv("PQ_FULL_VERIFIER_PATH", worker)
+	if err := mode0Add(p, tx); err != nil {
+		t.Fatal(err)
+	}
+	// Force a cache miss: successful pure results need no repeated worker call.
+	p.positiveCache = newProofResultCache(p.cfg.PositiveCacheBytes)
+	t.Setenv("PQ_FULL_VERIFIER_PATH", filepath.Join(t.TempDir(), "missing-worker-again"))
+	p.Reset(p.head, p.head)
+	mode0Pending(t, p, 0)
+	if len(p.deferred) != 1 || p.sources["mode0-real"].failures != 0 {
+		t.Fatal("previously admitted candidate not quarantined without invalid-proof penalty")
+	}
+	t.Setenv("PQ_FULL_VERIFIER_PATH", worker)
+	p.Reset(p.head, p.head)
+	mode0Pending(t, p, 1)
+	if len(p.deferred) != 0 || !p.Has(tx.Hash()) {
+		t.Fatal("restored real verifier did not revalidate deferred mode0")
+	}
+	t.Log("initial outage returned local retry; later admitted outage quarantined; restored actual Full accepted on Reset")
+}
