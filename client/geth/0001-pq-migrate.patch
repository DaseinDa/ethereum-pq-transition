+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package params
+
+import (
+	"fmt"
+	"github.com/ethereum/go-ethereum/common"
+)
+
+// Isolated F research profile. This does not allocate a production version.
+const PQFinalBackend = "l5-f-native-v1"
+const PQFinalVersion uint32 = 0x80000008
+const PQFinalMaxProofBytes uint64 = 196608
+
+// Same Route A canonical envelope at the reduced proof bound: 196608 + 2724.
+const PQFinalMaxTxBytes uint64 = 199332
+
+// Portable-client calibration: median gas/ns of ecrecover and two pairing
+// precompiles, multiplied by median F time, rounded upward to 1,000 gas.
+// Ten process samples on one machine; see bench/verification-gas. Research only.
+const PQFinalVerifyGas uint64 = 5666000
+
+var PQFinalAlgorithmDigest = common.HexToHash("0xead4fbe86b8ecd319816fc7999e0b3d44b8a7756d38744459fd3ab4c277f5afd")
+var PQFinalKeyDigest = common.HexToHash("0xed2fcf813b942404729da7827c4743020dae8d89ebbc206e5bee7718503df3f2")
+var PQFinalBKeyDigest = common.HexToHash("0x415bf19b5b55f7acd0b793c2ea45aef7923e3e640fdce2e81fc9fb350fdcf490")
+var PQFinalL0KeyDigest = common.HexToHash("0x6537a5af9b10f1599a151c024c549cad3740b95f9bc026b658b927a81ca20372")
+
+func (f *PQFullResearchConfig) researchVersion() uint32 {
+	if f.Backend == PQFinalBackend {
+		return PQFinalVersion
+	}
+	return PQR1Version
+}
+func (f *PQFullResearchConfig) validateFinalBackend() error {
+	if f.Version != PQFinalVersion || f.NativeAlgorithmDigest != PQFinalAlgorithmDigest || f.FinalKeyDigest != PQFinalKeyDigest ||
+		f.MaxProofBytes != PQFinalMaxProofBytes || f.MaxTxBytes != PQFinalMaxTxBytes || f.VerifyGas != PQFinalVerifyGas ||
+		f.ImageID != (common.Hash{}) || f.GuestSHA != (common.Hash{}) || f.VerifierSHA != (common.Hash{}) {
+		return fmt.Errorf("unsupported F native identity/bounds")
+	}
+	return nil
+}
