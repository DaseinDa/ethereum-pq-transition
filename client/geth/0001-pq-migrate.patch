+func TestPQBatchEntrySkipReceiptsAndRecoveryWritePrices(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		code   uint16
+		writes uint64
+	}{
+		{"legacy-before-T", 1, 0}, {"expired", 0x0201, 0}, {"native", 0x0103, 0},
+		{"contract", 0x0102, 0}, {"closed-override", 0x0104, 0}, {"wrong-nonce", 0x0105, 0},
+		{"override", 0, 10000}, {"recommit", 0, 7200},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			b, s, cfg, h, sign := batchStateFixture(t)
+			e := &b.Entries[0]
+			e.FeeMode, e.MaxAccountFee, e.FeeAuthUntil = 3, big.NewInt(100), h.Time
+			s.SetBalance(e.LegacyAddress, uint256.NewInt(150), tracing.BalanceChangeUnspecified)
+			old := PQRecord{}
+			switch tc.name {
+			case "legacy-before-T":
+				cfg.PQMigrate.LegacySeedProofFromT0 = false
+				// Other entries are enrolled, so only the LEGACY entry is skipped.
+				for _, other := range b.Entries[1:] {
+					writePQRecord(s, cfg.PQMigrate.Registry, other.LegacyAddress, PQRecord{Mode: 1, AlgID: 1, Commit: common.Hash{99}})
+				}
+			case "expired":
+				e.Expiry, e.FeeAuthUntil = h.Time-1, h.Time-1
+			case "native":
+				old = PQRecord{Mode: 3, AlgID: 1, Commit: common.Hash{99}}
+			case "contract":
+				s.SetCode(e.LegacyAddress, []byte{0x60, 0}, tracing.CodeChangeUnspecified)
+			case "closed-override":
+				cfg.PQMigrate.T, cfg.PQMigrate.W = 100, 50
+				old = PQRecord{Mode: 1, AlgID: 1, EnrolledAt: 100, Commit: common.Hash{99}}
+			case "wrong-nonce":
+				e.MigrationNonce = 1
+			case "override":
+				old = PQRecord{Mode: 1, AlgID: 1, Commit: common.Hash{99}}
+			case "recommit":
+				old = PQRecord{Mode: 2, AlgID: 1, MigrationNonce: 1, Commit: e.PQPKCommit}
+				e.MigrationNonce = 1
+			}
+			if old != (PQRecord{}) {
+				writePQRecord(s, cfg.PQMigrate.Registry, e.LegacyAddress, old)
+			}
+			tx := sign(b)
+			plan, err := validatePQBatch(tx, s, h, cfg, false, verifyPQMigrationSignatureInBlock)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if plan.skip[0] != tc.code {
+				t.Fatal("first failure", plan.skip[0], tc.code)
+			}
+			otherWrites := uint64(3 * 44200)
+			if tc.name == "legacy-before-T" {
+				otherWrites = 3 * 10000
+			}
+			if plan.used != batchExpectedGas(t, b, otherWrites+tc.writes) {
+				t.Fatal("cold write pricing", plan.used)
+			}
+			s.SetTxContext(tx.Hash(), 0, 1)
+			beforeSponsor := new(uint256.Int).Set(s.GetBalance(b.Sponsor))
+			applyPQBatchPlan(s, tx, h, cfg.PQMigrate, plan)
+			logs := s.GetLogs(tx.Hash(), h.Number.Uint64(), common.Hash{}, h.Time)
+			if len(logs) != 4 {
+				t.Fatal("receipt count")
+			}
+			assertBatchLog(t, logs[0], cfg.PQMigrate.Registry, *e, 0, tc.code, old.MigrationNonce+1, tc.name == "override", tc.name == "recommit")
+			wantFee := uint64(100)
+			if tc.code != 0 {
+				wantFee = 0
+				if ReadPQRecord(s, cfg.PQMigrate.Registry, e.LegacyAddress) != old {
+					t.Fatal("skip wrote registry")
+				}
+			}
+			if s.GetBalance(e.LegacyAddress).Uint64() != 150-wantFee {
+				t.Fatal("skip/recovery reimbursement")
+			}
+			wantSponsor := new(uint256.Int).Sub(beforeSponsor, uint256.NewInt(2*plan.used))
+			wantSponsor.Add(wantSponsor, uint256.NewInt(wantFee))
+			if s.GetBalance(b.Sponsor).Cmp(wantSponsor) != 0 || s.GetBalance(h.Coinbase).Uint64() != plan.used {
+				t.Fatal("skip/recovery payer accounting")
+			}
+		})
+	}
+}
