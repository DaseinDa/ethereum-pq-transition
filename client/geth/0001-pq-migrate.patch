@@ -0,0 +1,25 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package core
+
+import (
+	"errors"
+	"github.com/ethereum/go-ethereum/common"
+)
+
+// PQAppliedExecutionHeads is meaningful only while the caller also holds the
+// Engine forkchoice lock: SetSafe/SetFinalized are serialized by that lock,
+// whereas canonicalization, rewinds and sync insertion use chainmu.
+// It is an instantaneous observation, not a lease preventing future mutation.
+func (bc *BlockChain) PQAppliedExecutionHeads() (common.Hash, common.Hash, common.Hash, error) {
+	if !bc.chainmu.TryLock() {
+		return common.Hash{}, common.Hash{}, common.Hash{}, errors.New("chain stopped")
+	}
+	defer bc.chainmu.Unlock()
+	head, safe, final := bc.CurrentBlock(), bc.CurrentSafeBlock(), bc.CurrentFinalBlock()
+	if head == nil || safe == nil || final == nil {
+		return common.Hash{}, common.Hash{}, common.Hash{}, errors.New("applied execution pointers incomplete")
+	}
+	return head.Hash(), safe.Hash(), final.Hash(), nil
+}
