+// These are deterministic policy/locking fixtures. Their synthetic proof and
+// signature hooks are NOT cryptographic or full-backend evidence.
+func componentBlock(parent *types.Block, extra string, txs ...*types.Transaction) *types.Block {
+	h := &types.Header{Number: big.NewInt(1), Time: 1000, GasLimit: 120000000, GasUsed: 60000000, BaseFee: big.NewInt(1), Difficulty: new(big.Int), Extra: []byte(extra)}
+	if parent != nil {
+		h.ParentHash = parent.Hash()
+		h.Number = new(big.Int).Add(parent.Number(), big.NewInt(1))
+		h.Time = parent.Time() + 12
+	}
+	return types.NewBlock(h, &types.Body{Transactions: txs}, nil, trie.NewStackTrie(nil))
+}
+func componentFork(t *testing.T, txs ...*types.Transaction) (*Pool, *componentChain, *int, *types.Block, *types.Block, *types.Block) {
+	t.Helper()
+	p, c, calls := componentPool(t)
+	commonBlock := componentBlock(nil, "common")
+	old := componentBlock(commonBlock, "old", txs...)
+	next := componentBlock(commonBlock, "new")
+	c.blocks = map[common.Hash]*types.Block{commonBlock.Hash(): commonBlock, old.Hash(): old, next.Hash(): next}
+	p.head = old.Header()
+	return p, c, calls, commonBlock, old, next
+}
+func componentNoPendingOrDeferred(t *testing.T, p *Pool, calls *int) {
+	t.Helper()
+	if len(p.entries) != 0 || len(p.deferred) != 0 || *calls != 0 {
+		t.Fatalf("partial scan was admitted/verified: pending=%d deferred=%d calls=%d", len(p.entries), len(p.deferred), *calls)
+	}
+}
+func TestPQPoolComponentReorgScan(t *testing.T) {
+	t.Run("whole-difference-and-feed", func(t *testing.T) {
+		a, b := componentTx(1, 20, 2, 20), componentTx(2, 21, 2, 20)
+		p, c, calls, commonBlock, old, next := componentFork(t, a, b)
+		next = componentBlock(commonBlock, "new-with-a", a)
+		c.blocks[next.Hash()] = next
+		all := make(chan core.NewTxsEvent, 2)
+		external := make(chan core.NewTxsEvent, 2)
+		subA := p.SubscribeTransactions(all, true)
+		defer subA.Unsubscribe()
+		subE := p.SubscribeTransactions(external, false)
+		defer subE.Unsubscribe()
+		p.Reset(old.Header(), next.Header())
+		if p.Has(a.Hash()) || !p.Has(b.Hash()) || *calls != 1 {
+			t.Fatal("old minus new raw-hash difference incorrect", *calls)
+		}
+		select {
+		case ev := <-all:
+			if len(ev.Txs) != 1 || ev.Txs[0].Hash() != b.Hash() {
+				t.Fatal("wrong reorg event")
+			}
+		default:
+			t.Fatal("missing subscriber reorg event")
+		}
+		select {
+		case <-external:
+			t.Fatal("reorg tx regossiped as newly discovered")
+		default:
+		}
+		t.Logf("component hooks only: common=%s old=%s new=%s orphan=%s identical-new=%s; one reorgs=true event, zero discovery=false event", commonBlock.Hash(), old.Hash(), next.Hash(), b.Hash(), a.Hash())
+	})
+	for _, reason := range []string{"missing-parent", "depth", "scan", "candidate-count", "bytes"} {
+		t.Run(reason, func(t *testing.T) {
+			a, b := componentTx(1, 20, 2, 20), componentTx(2, 21, 2, 20)
+			p, c, calls, commonBlock, old, next := componentFork(t, a, b)
+			switch reason {
+			case "missing-parent":
+				delete(c.blocks, commonBlock.Hash())
+				// Both tips one level above an unavailable shared ancestor.
+				h := old.Header()
+				h.ParentHash = common.HexToHash("bad1")
+				old = types.NewBlockWithHeader(h).WithBody(*old.Body())
+				c.blocks[old.Hash()] = old
+				p.head = old.Header()
+			case "depth":
+				p.cfg.MaxReorgDepth = 1
+				old2 := componentBlock(old, "old-2")
+				c.blocks[old2.Hash()] = old2
+				old = old2
+				p.head = old.Header()
+			case "scan":
+				p.cfg.MaxReorgScan = 1
+			case "candidate-count":
+				p.cfg.MaxReorgCandidates = 1
+			case "bytes":
+				p.cfg.MaxReorgBytes = 1
+			}
+			p.Reset(old.Header(), next.Header())
+			componentNoPendingOrDeferred(t, p, calls)
+			if p.head.Hash() != next.Hash() {
+				t.Fatal("resource-bound scan failure prevented following canonical head")
+			}
+			t.Logf("component hooks only: %s rejected entire discovery; no partial Full calls/slots; new head accepted locally=%s", reason, next.Hash())
+		})
+	}
+}
+func TestPQPoolComponentReorgStateAndUnavailable(t *testing.T) {
+	t.Run("current-state-rejection", func(t *testing.T) {
+		tx := componentTx(1, 20, 2, 20)
+		p, _, calls, _, old, next := componentFork(t, tx)
+		p.checkState = func(*types.Transaction, *state.StateDB, *types.Header, *params.ChainConfig) error {
+			return &core.PQMigrationError{Name: "NOT_RECOVERABLE", Code: 0x0101}
+		}
+		p.Reset(old.Header(), next.Header())
+		componentNoPendingOrDeferred(t, p, calls)
+		t.Log("component state hook NOT_RECOVERABLE: current new-head gate before Full; no Pending/deferred")
+	})
+	for _, reason := range []string{"unavailable", "verification-budget"} {
+		t.Run(reason, func(t *testing.T) {
+			tx := componentTx(1, 20, 2, 20)
+			p, _, _, _, old, next := componentFork(t, tx)
+			if reason == "unavailable" {
+				p.checkProof = func(*types.Transaction, *params.ChainConfig, string) error { return core.ErrPQFullUnavailable }
+			} else {
+				p.cfg.VerificationBurst = 1
+				p.verifyCount = 1
+				p.verifyStart = time.Now()
+			}
+			p.Reset(old.Header(), next.Header())
+			if p.Has(tx.Hash()) || p.deferred[tx.Hash()] == nil || len(p.bans) != 0 {
+				t.Fatal("local condition was eligible/lost/banned")
+			}
+			for _, budget := range p.sources {
+				if budget.failures != 0 {
+					t.Fatal("local condition counted INVALID")
+				}
+			}
+			p.checkProof = func(*types.Transaction, *params.ChainConfig, string) error { return nil }
+			p.verifyStart = time.Time{}
+			p.Reset(next.Header(), next.Header())
+			if !p.Has(tx.Hash()) || len(p.deferred) != 0 {
+				t.Fatal("local dependency repair did not readmit")
+			}
+			t.Log("component only:", reason, "quarantine was not Pending and not INVALID; fresh full hook after repair")
+		})
+	}
+}
+
+func TestPQPoolComponentConcurrentAddResetClose(t *testing.T) {
+	p, c, _ := componentPool(t)
+	c.blocks = make(map[common.Hash]*types.Block)
+	h := types.CopyHeader(p.head)
+	start := make(chan struct{})
+	var wg sync.WaitGroup
+	for i := 0; i < 12; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			<-start
+			for j := 0; j < 12; j++ {
+				switch i % 3 {
+				case 0:
+					_ = p.AddFrom("concurrent", []*types.Transaction{componentTx(byte(1+i), byte(20+i), 2, 20)}, true)
+				case 1:
+					p.Reset(h, h)
+				case 2:
+					_, _ = p.Pending(txpool.PendingFilter{OnlyPQ: true})
+					_ = p.Has(common.Hash{})
+				}
+			}
+		}(i)
+	}
+	wg.Add(1)
+	go func() { defer wg.Done(); <-start; _ = p.Close() }()
+	close(start)
+	done := make(chan struct{})
+	go func() { wg.Wait(); close(done) }()
+	select {
+	case <-done:
+	case <-time.After(10 * time.Second):
+		t.Fatal("concurrent Add/Reset/Close deadlocked")
+	}
+	err := add(p, componentTx(19, 39, 2, 20))
+	if !errors.Is(err, ErrLocalUnavailable) {
+		t.Fatalf("closed pool admitted candidate: %v", err)
+	}
+	if _, n := p.Pending(txpool.PendingFilter{OnlyPQ: true}); n != 0 {
+		t.Fatal("closed pool left eligible Pending")
+	}
+	t.Log("component hooks only: concurrent Add/Reset/Pending/Has/Close terminated, post-Close admission rejected; run with -race for data-race evidence")
+}
+
+func TestPQPoolComponentReorgCoalescedOrder(t *testing.T) {
+	a, b := componentTx(1, 20, 2, 20), componentTx(2, 21, 2, 20)
+	p, c, _, commonBlock, old, next := componentFork(t, a)
+	old2 := componentBlock(old, "old-second-block", b)
+	c.blocks[old2.Hash()] = old2
+	p.head = old2.Header()
+	var order []common.Hash
+	p.checkProof = func(tx *types.Transaction, _ *params.ChainConfig, _ string) error {
+		order = append(order, tx.Hash())
+		return nil
+	}
+	// Deliberately stale coordinator hint: the pool's processed head is old2.
+	p.Reset(commonBlock.Header(), next.Header())
+	if len(order) != 2 || order[0] != a.Hash() || order[1] != b.Hash() || !p.Has(a.Hash()) || !p.Has(b.Hash()) {
+		t.Fatal("coalesced reset did not preserve ancestor-to-tip order", order)
+	}
+	t.Log("component only: stale old-head hint ignored; last processed p.head scanned; ancestor-to-tip/block order preserved")
+}
+func TestPQPoolComponentDeferredSharedCapacity(t *testing.T) {
+	for _, name := range []string{"data-cap", "pending-cap", "exact-accounting"} {
+		t.Run(name, func(t *testing.T) {
+			a, b := componentTx(1, 20, 2, 20), componentTx(2, 21, 2, 20)
+			p, _, _, _, old, next := componentFork(t, b)
+			if err := add(p, a); err != nil {
+				t.Fatal(err)
+			}
+			if name == "data-cap" {
+				p.cfg.DataCap = p.bodyBytes + b.Size() - 1
+			}
+			if name == "pending-cap" {
+				p.cfg.MaxPending = 1
+			}
+			if name == "exact-accounting" {
+				p.cfg.DataCap = p.bodyBytes + b.Size()
+				p.cfg.MaxPending = 2
+			}
+			p.checkProof = func(tx *types.Transaction, _ *params.ChainConfig, _ string) error {
+				if tx.Hash() == b.Hash() {
+					return core.ErrPQFullUnavailable
+				}
+				return nil
+			}
+			p.Reset(old.Header(), next.Header())
+			if !p.Has(a.Hash()) || p.Has(b.Hash()) {
+				t.Fatal("capacity test lost existing valid entry or exposed deferred")
+			}
+			if name == "exact-accounting" {
+				if len(p.deferred) != 1 || p.deferredBytes != b.Size() || p.bodyBytes+p.deferredBytes != p.cfg.DataCap {
+					t.Fatal("deferred raw plus disk body accounting mismatch")
+				}
+				if err := add(p, componentTx(3, 22, 2, 20)); !errors.Is(err, txpool.ErrOutOfCapacity) {
+					t.Fatal("deferred slot bypassed MaxPending", err)
+				}
+			} else if len(p.deferred) != 0 || p.deferredBytes != 0 {
+				t.Fatal("over-budget raw retained without capacity")
+			}
+			t.Logf("component only: %s pending=%d deferred=%d bodyBytes=%d deferredRawBytes=%d DataCap=%d", name, len(p.entries), len(p.deferred), p.bodyBytes, p.deferredBytes, p.cfg.DataCap)
+		})
+	}
+}
+func TestPQPoolComponentConcurrentResetCloseSubscription(t *testing.T) {
+	tx := componentTx(1, 20, 2, 20)
+	p, _, _, _, old, next := componentFork(t, tx)
+	unread := make(chan core.NewTxsEvent)
+	sub := p.SubscribeTransactions(unread, true)
+	defer sub.Unsubscribe()
+	resetDone := make(chan struct{})
+	go func() { p.Reset(old.Header(), next.Header()); close(resetDone) }()
+	deadline := time.Now().Add(5 * time.Second)
+	for !p.Has(tx.Hash()) && time.Now().Before(deadline) {
+		time.Sleep(time.Millisecond)
+	}
+	if !p.Has(tx.Hash()) {
+		t.Fatal("reset never finished admission before notification")
+	}
+	select {
+	case <-resetDone:
+		t.Fatal("unread reorg subscriber did not hold event send")
+	default:
+	}
+	closeDone := make(chan error, 1)
+	go func() { closeDone <- p.Close() }()
+	select {
+	case err := <-closeDone:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("Close blocked behind unread reorg subscription")
+	}
+	select {
+	case <-resetDone:
+	case <-time.After(5 * time.Second):
+		t.Fatal("scope close did not release Reset event send")
+	}
+	for _, reorgs := range []bool{true, false} {
+		late := p.SubscribeTransactions(make(chan core.NewTxsEvent), reorgs)
+		if late == nil {
+			t.Fatal("Subscribe after Close returned unusable nil")
+		}
+		select {
+		case _, ok := <-late.Err():
+			if ok {
+				t.Fatal("late subscription not closed")
+			}
+		case <-time.After(time.Second):
+			t.Fatal("late subscription retained after scope Close")
+		}
+		late.Unsubscribe()
+		sent := make(chan int, 1)
+		go func() {
+			if reorgs {
+				sent <- p.txFeed.Send(core.NewTxsEvent{Txs: []*types.Transaction{tx}})
+			} else {
+				sent <- p.discoverFeed.Send(core.NewTxsEvent{Txs: []*types.Transaction{tx}})
+			}
+		}()
+		select {
+		case n := <-sent:
+			if n != 0 {
+				t.Fatal("closed scope retained subscriber", n)
+			}
+		case <-time.After(time.Second):
+			t.Fatal("closed scope leaked blocking subscription")
+		}
+	}
+	t.Log("component only: unread reorg subscriber blocked lock-free Feed.Send; Close released subscription and Reset; post-Close Subscribe already closed and feed has no listeners")
+}
+
+// Minimal self-cleaning counterexample for the old Track-without-cleanup pattern.
+// This does not restore faulty runtime code or use a synthetic proof as evidence.
+func TestPQPoolComponentClosedScopeCounterexample(t *testing.T) {
+	var feed event.Feed
+	var scope event.SubscriptionScope
+	scope.Close()
+	sub := feed.Subscribe(make(chan core.NewTxsEvent))
+	defer sub.Unsubscribe()
+	if scope.Track(sub) != nil {
+		t.Fatal("expected closed scope to reject Track")
+	}
+	started := make(chan struct{})
+	done := make(chan int, 1)
+	go func() { close(started); done <- feed.Send(core.NewTxsEvent{}) }()
+	<-started
+	select {
+	case <-done:
+		t.Fatal("old pattern unexpectedly removed untracked listener")
+	case <-time.After(50 * time.Millisecond):
+	}
+	// Explicit cleanup is the actual runtime fix; never leave this goroutine.
+	sub.Unsubscribe()
+	select {
+	case n := <-done:
+		if n != 0 {
+			t.Fatal("send had a receiver", n)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("cleanup did not release old-pattern send")
+	}
+	t.Log("component counterexample reproduced: closed scope Track returned nil while untracked subscription blocked Send; explicit Unsubscribe released it safely")
+}
