index 0000000000000000000000000000000000000000..e4a6c24d3cd944d2385293ac2f99cb0af7a6fd01
--- /dev/null
+++ b/eth/protocols/eth/pq_delivery_clock_test.go
@@ -0,0 +1,43 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package eth
+
+import "testing"
+
+type timedDeliveryBackend struct {
+	Backend
+	clock, received uint64
+	calls           int
+}
+
+func (b *timedDeliveryBackend) AcceptTxs() bool         { return true }
+func (b *timedDeliveryBackend) PQDeliveryClock() uint64 { return b.clock }
+func (b *timedDeliveryBackend) HandleAt(_ *Peer, _ Packet, delivered uint64) error {
+	b.received = delivered
+	b.calls++
+	return nil
+}
+
+type clockMovingDecoder func(interface{}) error
+
+func (d clockMovingDecoder) Decode(value interface{}) error { return d(value) }
+
+func TestPQProtocolDeliveryClockPrecedesTransactionDecode(t *testing.T) {
+	for _, next := range []uint64{1144, 880} {
+		backend := &timedDeliveryBackend{clock: 1012}
+		decoder := clockMovingDecoder(func(value interface{}) error {
+			if _, ok := value.(*TransactionsPacket); !ok {
+				t.Fatal("wrong decode target")
+			}
+			backend.clock = next
+			return nil // Empty decoded packet suffices to isolate dispatch timing.
+		})
+		if err := handleTransactions(backend, decoder, nil); err != nil {
+			t.Fatal(err)
+		}
+		if backend.calls != 1 || backend.received != 1012 || backend.clock != next {
+			t.Fatal("delivery recaptured after decode", backend.received)
+		}
+	}
+}
diff --git a/eth/protocols/eth/pq_request.go b/eth/protocols/eth/pq_request.go
new file mode 100644
index 0000000000000000000000000000000000000000..a85f1713784fb40667f348b6f595efad819b355d
--- /dev/null
+++ b/eth/protocols/eth/pq_request.go
@@ -0,0 +1,66 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package eth
+
+import (
+	"errors"
+	"time"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core/types"
+)
+
+type fullProofRequest struct {
+	at     time.Time
+	hashes map[common.Hash]struct{}
+}
+
+func (p *Peer) trackFullRequest(id uint64, hashes []common.Hash) {
+	if p.chainConfig == nil || p.chainConfig.PQMigrate == nil || p.chainConfig.PQMigrate.FullResearch == nil {
+		return
+	}
+	p.fullRequestMu.Lock()
+	defer p.fullRequestMu.Unlock()
+	now := time.Now()
+	for id, req := range p.fullRequests {
+		if now.Sub(req.at) > 5*time.Minute {
+			delete(p.fullRequests, id)
+		}
+	}
+	// At most 128 outstanding hash sets. Dropping the oldest is local fetch
+	// backpressure; it cannot make a block or a proof mathematically invalid.
+	if len(p.fullRequests) >= 128 {
+		var oldest uint64
+		var at time.Time
+		for k, r := range p.fullRequests {
+			if at.IsZero() || r.at.Before(at) {
+				oldest, at = k, r.at
+			}
+		}
+		delete(p.fullRequests, oldest)
+	}
+	r := &fullProofRequest{at: now, hashes: make(map[common.Hash]struct{}, len(hashes))}
+	for _, h := range hashes {
+		r.hashes[h] = struct{}{}
+	}
+	p.fullRequests[id] = r
+}
+func (p *Peer) validateFullResponse(id uint64, txs []*types.Transaction) error {
+	p.fullRequestMu.Lock()
+	defer p.fullRequestMu.Unlock()
+	req := p.fullRequests[id]
+	delete(p.fullRequests, id)
+	for _, tx := range txs {
+		if tx.Type() != types.PQMigrateTxType && tx.Type() != types.PQBatchTxType {
+			continue
+		}
+		if req == nil {
+			return errors.New("unrequested Full proof response")
+		}
+		if _, ok := req.hashes[tx.Hash()]; !ok {
+			return errors.New("Full proof hash was not requested")
+		}
+	}
+	return nil
+}
diff --git a/eth/protocols/eth/pq_request_test.go b/eth/protocols/eth/pq_request_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..6b46194d93fdca012c2e589d412b7c5fbee122e2
--- /dev/null
+++ b/eth/protocols/eth/pq_request_test.go
@@ -0,0 +1,95 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package eth
+
+import (
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/params"
+	"github.com/ethereum/go-ethereum/rlp"
+	"math/big"
+	"os"
+	"testing"
+	"time"
+)
+
+// Transport-only: these tests never claim to validate a proof. The first body
+// is the real signed research fixture, while the padded body is synthetic.
+func TestPQFullRequestedResponseCodec(t *testing.T) {
+	if os.Getenv("PQ_LEGACY_MIGRATE_FILE") == "" {
+		t.Skip("set PQ_LEGACY_MIGRATE_FILE for the carrier vector")
+	}
+	raw, err := os.ReadFile(os.Getenv("PQ_LEGACY_MIGRATE_FILE"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	tx := new(types.Transaction)
+	if err = tx.UnmarshalBinary(raw); err != nil {
+		t.Fatal(err)
+	}
+	cfg := *params.AllDevChainProtocolChanges
+	cfg.PQMigrate = &params.PQMigrateConfig{FullResearch: &params.PQFullResearchConfig{MaxTxBytes: 3 << 20}}
+	p := &Peer{chainConfig: &cfg, fullRequests: make(map[uint64]*fullProofRequest)}
+	roundtrip := func(id uint64, tx *types.Transaction) []*types.Transaction {
+		list := new(rlp.RawList[*types.Transaction])
+		if err := list.Append(tx); err != nil {
+			t.Fatal(err)
+		}
+		encoded, err := rlp.EncodeToBytes(&PooledTransactionsPacket{RequestId: id, List: *list})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if len(encoded) < 128<<10 || len(encoded) > maxMessageSize {
+			t.Fatal("transport case does not span old local tx limit / fits wrong hard cap")
+		}
+		var packet PooledTransactionsPacket
+		if err = rlp.DecodeBytes(encoded, &packet); err != nil {
+			t.Fatal(err)
+		}
+		items, err := packet.List.Items()
+		if err != nil || len(items) != 1 || items[0].Hash() != tx.Hash() {
+			t.Fatal("wire roundtrip", err)
+		}
+		t.Logf("PooledTransactions packet id=%d bytes=%d (10MiB hard message cap unchanged)", id, len(encoded))
+		return items
+	}
+	p.trackFullRequest(10, []common.Hash{tx.Hash()})
+	if err = p.validateFullResponse(10, roundtrip(10, tx)); err != nil {
+		t.Fatal(err)
+	}
+	if err = p.validateFullResponse(10, []*types.Transaction{tx}); err == nil {
+		t.Fatal("repeated unsolicited response accepted")
+	}
+	p.trackFullRequest(11, []common.Hash{common.HexToHash("01")})
+	if err = p.validateFullResponse(11, []*types.Transaction{tx}); err == nil {
+		t.Fatal("unrequested Full hash accepted")
+	}
+	// A maximum-length research carrier remains a single >2MiB packet. This is
+	// only framing evidence and is intentionally not sent to proof validation.
+	m, _ := tx.AsPQMigrate()
+	copytx := types.NewTx(m)
+	m, _ = copytx.AsPQMigrate()
+	m.ProofCarrier.Proof = make([]byte, 2<<20)
+	padded := types.NewTx(m)
+	p.trackFullRequest(12, []common.Hash{padded.Hash()})
+	if err = p.validateFullResponse(12, roundtrip(12, padded)); err != nil {
+		t.Fatal(err)
+	}
+	// Ordinary packets are not made dependent on this Full-specific tracker.
+	ordinary := types.NewTx(&types.LegacyTx{Gas: 21000, GasPrice: big.NewInt(1), Value: new(big.Int)})
+	if err = p.validateFullResponse(999, []*types.Transaction{ordinary}); err != nil {
+		t.Fatal(err)
+	}
+	p.fullRequests[1] = &fullProofRequest{at: time.Now().Add(-6 * time.Minute), hashes: map[common.Hash]struct{}{tx.Hash(): {}}}
+	p.trackFullRequest(13, []common.Hash{tx.Hash()})
+	if _, ok := p.fullRequests[1]; ok {
+		t.Fatal("stale request retained")
+	}
+	for i := uint64(100); i < 300; i++ {
+		p.trackFullRequest(i, []common.Hash{tx.Hash()})
+	}
+	if len(p.fullRequests) > 128 {
+		t.Fatal("request table unbounded")
+	}
+}
