+
+// Stage r1-proof-20261028: R-1's own root receipt (spec section 23.2, row proof
+// object) at the client.
+
+package core
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"math/big"
+	"os"
+	"testing"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/params"
+)
+
+// The PI fields the stage froze (config.json of results/r1-proof-20261028/inputs).
+type r1RootFields struct {
+	ChainID         uint64 `json:"chain_id"`
+	DomainTag       string `json:"DOMAIN_TAG"`
+	LegacyAddress   string `json:"legacy_address"`
+	MigrationNonce  uint64 `json:"migration_nonce"`
+	AlgID           uint8  `json:"alg_id"`
+	PQPKCommit      string `json:"pq_pk_commit"`
+	VerifierVersion uint32 `json:"verifier_version"`
+	Expiry          uint64 `json:"expiry"`
+	MaxAccountFee   string `json:"max_account_fee"`
+	FeeMode         uint8  `json:"fee_mode"`
+	FeeSponsor      string `json:"fee_sponsor"`
+	FeeAuthUntil    uint64 `json:"fee_auth_until"`
+}
+
+func r1RootInputs(t *testing.T) (r1RootFields, []byte) {
+	cfgPath, piPath := os.Getenv("PQ_R1_ROOT_CONFIG"), os.Getenv("PQ_R1_PI")
+	if cfgPath == "" || piPath == "" {
+		t.Skip("requires R-1's frozen PI fields and its 198-byte PI")
+	}
+	raw, err := os.ReadFile(cfgPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var doc struct {
+		Fields r1RootFields `json:"fields"`
+	}
+	if err := json.Unmarshal(raw, &doc); err != nil {
+		t.Fatal(err)
+	}
+	pi, err := os.ReadFile(piPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(pi) != 198 {
+		t.Fatal("PI length")
+	}
+	return doc.Fields, pi
+}
+
+// A mode-0 0x7e of R-1 with the frozen fields: no sponsor option, the gas cap.
+func r1RootCarrier(t *testing.T, f r1RootFields, cfg *params.ChainConfig, proof []byte) *types.PQMigrateTx {
+	fee, ok := new(big.Int).SetString(f.MaxAccountFee, 10)
+	if !ok {
+		t.Fatal("max_account_fee")
+	}
+	return &types.PQMigrateTx{ChainID: new(big.Int).Set(cfg.ChainID), LegacyAddress: common.HexToAddress(f.LegacyAddress),
+		MigrationNonce: f.MigrationNonce, AlgID: f.AlgID, PQPKCommit: common.HexToHash(f.PQPKCommit), Expiry: f.Expiry,
+		MaxAccountFee: fee, FeeMode: f.FeeMode, FeeSponsor: common.HexToAddress(f.FeeSponsor), FeeAuthUntil: f.FeeAuthUntil,
+		GasTipCap: big.NewInt(100000000), GasFeeCap: big.NewInt(2000000000), Gas: params.MaxTxGas,
+		VerifierVersion: f.VerifierVersion, ProofCarrier: types.PQMigrationCarrier{Proof: proof}}
+}
+
+// The node recomputes PI_bytes from the decoded fields (spec l. 1963). For a 0x7e
+// of R-1's chain id and identifier with the frozen fields, that recomputation is
+// the 198 bytes the guest committed.
+func TestPQR1RootPublicInputs(t *testing.T) {
+	f, pi := r1RootInputs(t)
+	cfg := r1TestChain(0)
+	if f.ChainID != params.PQR1ChainID || cfg.ChainID.Uint64() != params.PQR1ChainID || f.VerifierVersion != params.PQR1Version {
+		t.Fatalf("not R-1's chain id and identifier: %d, %#x", f.ChainID, f.VerifierVersion)
+	}
+	m := r1RootCarrier(t, f, cfg, nil)
+	if err := m.ValidateShape(); err != nil {
+		t.Fatal("R-1's mode-0 carrier shape", err)
+	}
+	if got := m.PublicInputs(); !bytes.Equal(got, pi) {
+		t.Fatalf("node-recomputed PI differs from R-1's PI:\n%x\n%x", got, pi)
+	}
+	if common.BytesToHash(pi[32:64]) != common.HexToHash(f.DomainTag) {
+		t.Fatal("DOMAIN_TAG field")
+	}
+	// DOMAIN_TAG binds the chain id (l. 62): the recomputation for 13375, the chain
+	// of every earlier research profile, differs in it.
+	m.ChainID = big.NewInt(13375)
+	if bytes.Equal(m.PublicInputs()[32:64], pi[32:64]) {
+		t.Fatal("DOMAIN_TAG does not separate chain 13375 from 13376")
+	}
+}
+
+// R-1's root receipt through the node's check 2 and check 9 with the linked R-1
+// library (ValidatePQMigrateProof, the PI recomputed from the carrier):
+//   - accepted for R-1's carrier;
+//   - padded with trailing bytes to exactly 224,256 B: passes check 2, INVALID_PROOF
+//     (vector (d), last clause);
+//   - 224,257 B: PROOF_TOO_LARGE before any verification (vector (d));
+//   - any changed PI field: INVALID_PROOF;
+//   - the section 22.7 root naming 0x80000005: INVALID_PROOF; naming 0x80000002:
+//     WRONG_VERIFIER_VERSION before any verification (vector (e)).
+func TestPQR1RootReceipt(t *testing.T) {
+	f, _ := r1RootInputs(t)
+	rootPath, oldPath := os.Getenv("PQ_R1_ROOT"), os.Getenv("PQ_SECTION_22_7_ROOT")
+	if rootPath == "" || oldPath == "" {
+		t.Skip("requires R-1's root receipt and the section 22.7 root")
+	}
+	if _, linked := pqNativeIdentityJSON(); !linked {
+		t.Skip("requires the native-linked build")
+	}
+	root, err := os.ReadFile(rootPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	old, err := os.ReadFile(oldPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if uint64(len(root)) > params.PQSuccinctMaxProofBytes {
+		t.Fatalf("R-1's root has %d bytes, above R-1's bound", len(root))
+	}
+	t.Setenv("PQ_FULL_VERIFIER_PATH", "/nonexistent/no-worker-fallback")
+	cfg := r1TestChain(0)
+	saved := pqNativeLibrary
+	defer func() { pqNativeLibrary = saved }()
+	calls := 0
+	pqNativeLibrary.verify = func(proof, pi []byte) int { calls++; return saved.verify(proof, pi) }
+	carrier := func(proof []byte, edit func(*types.PQMigrateTx)) *types.Transaction {
+		m := r1RootCarrier(t, f, cfg, proof)
+		if edit != nil {
+			edit(m)
+		}
+		return types.NewTx(m)
+	}
+	if err := ValidatePQMigrateProof(carrier(root, nil), cfg, "test"); err != nil || calls != 1 {
+		t.Fatalf("R-1's root not accepted for R-1's carrier: %v, calls=%d", err, calls)
+	}
+	invalid := func(name string, err error) {
+		t.Helper()
+		if pqMigrationErrorName(err) != "INVALID_PROOF" || errors.Is(err, ErrPQFullUnavailable) {
+			t.Fatalf("%s: %v", name, err)
+		}
+	}
+	padded := append(bytes.Clone(root), make([]byte, int(params.PQSuccinctMaxProofBytes)-len(root))...)
+	invalid("root padded to 224,256 bytes", ValidatePQMigrateProof(carrier(padded, nil), cfg, "test"))
+	before := calls
+	if err := ValidatePQMigrateProof(carrier(append(padded, 0), nil), cfg, "test"); pqMigrationErrorName(err) != "PROOF_TOO_LARGE" || calls != before {
+		t.Fatalf("224,257 bytes: %v, verifier calls %d", err, calls-before)
+	}
+	for name, edit := range map[string]func(*types.PQMigrateTx){
+		"chain_id 13375":  func(m *types.PQMigrateTx) { m.ChainID = big.NewInt(13375) },
+		"legacy_address":  func(m *types.PQMigrateTx) { m.LegacyAddress[19] ^= 1 },
+		"migration_nonce": func(m *types.PQMigrateTx) { m.MigrationNonce++ },
+		"pq_pk_commit":    func(m *types.PQMigrateTx) { m.PQPKCommit[31] ^= 1 },
+		"expiry":          func(m *types.PQMigrateTx) { m.Expiry++ },
+		"max_account_fee": func(m *types.PQMigrateTx) { m.MaxAccountFee = new(big.Int).Add(m.MaxAccountFee, common.Big1) },
+	} {
+		invalid(name, ValidatePQMigrateProof(carrier(root, edit), cfg, "test"))
+	}
+	invalid("section 22.7 root naming 0x80000005", ValidatePQMigrateProof(carrier(old, nil), cfg, "test"))
+	before = calls
+	version2 := func(m *types.PQMigrateTx) { m.VerifierVersion = 0x80000002 }
+	if err := ValidatePQMigrateProof(carrier(old, version2), cfg, "test"); pqMigrationErrorName(err) != "WRONG_VERIFIER_VERSION" || calls != before {
+		t.Fatalf("section 22.7 root naming 0x80000002: %v, verifier calls %d", err, calls-before)
+	}
+	t.Logf("R-1's root of %d bytes accepted through check 2 and check 9; %d verifier calls", len(root), calls)
+}
diff --git a/core/pq_r5_saved_test.go b/core/pq_r5_saved_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..a66d272e57f129012c966d6020a99b3389de79ae
--- /dev/null
+++ b/core/pq_r5_saved_test.go
@@ -0,0 +1,76 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package core
+
+import (
+	"bytes"
+	"math/big"
+	"os"
+	"testing"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core/tracing"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/holiman/uint256"
+)
+
+// The exact signed transaction from the failed Lean run, not a reconstructed
+// signature. Pre-state is the documented post-recovery/pre-activation state;
+// the separate installed Lean experiment checks the complete proof path.
+func TestPQR5SavedSelfActivation(t *testing.T) {
+	path := os.Getenv("PQ_R5_SAVED_TX")
+	if path == "" {
+		t.Skip("set PQ_R5_SAVED_TX to frozen verify3/txs/activate.bin")
+	}
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var tx types.Transaction
+	if err = tx.UnmarshalBinary(raw); err != nil {
+		t.Fatal(err)
+	}
+	if tx.Hash() != common.HexToHash("d02172ea5310d54346c3942b689f21ffe770a54b1620781f4f483458232f8bff") {
+		t.Fatal("wrong frozen counterexample")
+	}
+	p, ok := tx.AsPQTx()
+	if !ok || p.From != p.To || len(p.Data) != 0 {
+		t.Fatal("expected self activation")
+	}
+	s, evm, h := pqEnv(t, common.HexToAddress("9999"), nil)
+	evm.ChainConfig().ChainID = big.NewInt(13378)
+	owner := p.From
+	registry := evm.ChainConfig().PQMigrate.Registry
+	commit := PQKeyCommit(1, p.PublicKey[0])
+	if commit != common.HexToHash("9be4ce1ee578f017d1ae2271fe1bfdd811c93f7a6ff6ed6ff441cf3c5453bfbe") {
+		t.Fatal("commit")
+	}
+	writePQRecord(s, registry, owner, PQRecord{Mode: 2, AlgID: 1, MigrationNonce: 1, Commit: commit})
+	s.SetBalance(owner, uint256.NewInt(2000000000000000000), tracing.BalanceChangeUnspecified)
+	before := new(uint256.Int).Set(s.GetBalance(owner))
+	receipt := pqApply(t, s, evm, h, NewGasPool(h.GasLimit), &tx, 0)
+	if receipt.Status != 1 || receipt.GasUsed >= tx.Gas() {
+		t.Fatalf("R5 failed: status=%d gas=%d", receipt.Status, receipt.GasUsed)
+	}
+	if s.GetNonce(owner) != 1 || !bytes.Equal(s.GetCode(owner), append([]byte{0xef, 1, 1}, p.PublicKey[0]...)) {
+		t.Fatal("activation state")
+	}
+	if ReadPQRecord(s, registry, owner).MigrationNonce != 1 {
+		t.Fatal("activation changed migration nonce")
+	}
+	fee := new(uint256.Int).Mul(uint256.NewInt(receipt.GasUsed), uint256.NewInt(2000000000))
+	if new(uint256.Int).Sub(before, s.GetBalance(owner)).Cmp(fee) != 0 {
+		t.Fatal("self call moved value or mischarged fee")
+	}
+	found := false
+	for _, log := range receipt.Logs {
+		if len(log.Topics) > 0 && log.Topics[0] == common.HexToHash("0cc43938d137e7efade6a531f663e78c1fc75257b0d65ffda2fdaf70cb49cdf9") {
+			found = true
+		}
+	}
+	if !found {
+		t.Fatal("Activated event missing")
+	}
+	t.Logf("saved hash=%s status=%d gas=%d nonce=%d markerBytes=%d", tx.Hash(), receipt.Status, receipt.GasUsed, s.GetNonce(owner), len(s.GetCode(owner)))
+}
diff --git a/core/pq_rotate_test.go b/core/pq_rotate_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..42179851d27b0dc20dfbf91e8c8e5d892959ad66
--- /dev/null
+++ b/core/pq_rotate_test.go
@@ -0,0 +1,218 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package core
+
+import (
+	"bytes"
+	"encoding/binary"
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core/tracing"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/crypto"
+	"math"
+	"math/big"
+	"testing"
+)
+
+func rotateABI(pk, sig []byte) []byte {
+	word := func(n int) []byte { return common.LeftPadBytes(big.NewInt(int64(n)).Bytes(), 32) }
+	p1, p2 := (len(pk)+31)/32*32, (len(sig)+31)/32*32
+	return bytes.Join([][]byte{{0x26, 0x2f, 0x8a, 0xe0}, word(1), word(96), word(128 + p1), word(len(pk)), pk, make([]byte, p1-len(pk)), word(len(sig)), sig, make([]byte, p2-len(sig))}, nil)
+}
+
+func TestPQRotateStateTransition(t *testing.T) {
+	pk1, sk1 := pqSeedKey(0x71)
+	pk2, sk2 := pqSeedKey(0x72)
+	cases := []struct {
+		name           string
+		activate, same bool
+		mut            string
+		used           uint64
+		status         uint64
+	}{
+		{"new-key", false, false, "", 323200, 1}, {"same-key", false, true, "", 320400, 1},
+		{"activating", true, false, "", 323200, 1}, {"activating-same", true, true, "", 320400, 1},
+		{"bad-pop-activation-kept", true, false, "pop", 50200, 0}, {"bad-pop", false, false, "pop", 50200, 0},
+		{"in-frame-nonce", false, false, "nonce8", 50200, 0}, {"migration-nonce", false, false, "nonce3", 50200, 0},
+		{"wrong-pop-domain", false, false, "domain", 50200, 0}, {"wrong-pop-chain", false, false, "chain", 50200, 0}, {"old-key-pop", false, false, "old-pop", 50200, 0},
+		{"dirty-alg", false, false, "alg", 200, 0}, {"dirty-padding", false, false, "padding", 200, 0},
+		{"trailing", false, false, "trailing", 200, 0}, {"overflow-length", false, false, "overflow", 200, 0},
+		{"short-selector-only", false, false, "short", 200, 0}, {"wrong-offset", false, false, "offset", 200, 0},
+		{"migration-nonce-max", false, false, "max", 200, 0}, {"window-open", false, false, "window", 200, 0},
+		{"window-overflow", false, false, "deadline-overflow", 200, 0}, {"window-closed", false, false, "closed", 323200, 1},
+		{"value-refused", false, false, "value", 0, 0}, {"other-selector-stop", false, false, "stop", 0, 1},
+		{"write-OOG", false, false, "oog", 323199, 0}, {"activating-write-OOG-keeps-activation", true, false, "oog", 323199, 0},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			s, evm, h := pqEnv(t, common.HexToAddress("9999"), nil)
+			cfg := evm.ChainConfig()
+			reg := cfg.PQMigrate.Registry
+			owner := pqSender
+			record := PQRecord{Mode: 2, AlgID: 1, MigrationNonce: 3, Commit: PQKeyCommit(1, pk1.Bytes())}
+			switch tc.mut {
+			case "max":
+				record.MigrationNonce = math.MaxUint64
+			case "window":
+				record.Mode = 1
+				record.EnrolledAt = h.Time
+			case "deadline-overflow":
+				record.Mode = 1
+				cfg.PQMigrate.T = math.MaxUint64 - 1
+				cfg.PQMigrate.W = 10
+			case "closed":
+				record.Mode = 1
+				record.EnrolledAt = 1
+				cfg.PQMigrate.T = 2
+				cfg.PQMigrate.W = 3
+			}
+			writePQRecord(s, reg, owner, record)
+			s.SetNonce(owner, 7, tracing.NonceChangeUnspecified)
+			if !tc.activate {
+				s.SetCode(owner, append([]byte{0xef, 1, 1}, pk1.Bytes()...), tracing.CodeChangeUnspecified)
+			}
+			newpk, newsk := pk2, sk2
+			if tc.same {
+				newpk, newsk = pk1, sk1
+			}
+			nonce := uint64(7)
+			if tc.mut == "nonce8" {
+				nonce = 8
+			}
+			if tc.mut == "nonce3" {
+				nonce = 3
+			}
+			chain := new(big.Int).Set(cfg.ChainID)
+			if tc.mut == "chain" {
+				chain.Add(chain, big.NewInt(1))
+			}
+			pre := append([]byte("PQ-ROTATE"), common.LeftPadBytes(chain.Bytes(), 32)...)
+			pre = append(pre, owner[:]...)
+			pre = binary.BigEndian.AppendUint64(pre, nonce)
+			pre = append(pre, 1)
+			pre = append(pre, newpk.Bytes()...)
+			sig := pqSignTag(t, newsk, "ETH-PQ-ROTATE-POP/v1", crypto.Keccak256Hash(pre))
+			if tc.mut == "domain" {
+				sig = pqSignTag(t, newsk, "ETH-PQ-ENROLL-POP/v1", crypto.Keccak256Hash(pre))
+			}
+			if tc.mut == "old-pop" {
+				sig = pqSignTag(t, sk1, "ETH-PQ-ROTATE-POP/v1", crypto.Keccak256Hash(pre))
+			}
+			if tc.mut == "pop" {
+				sig[0] ^= 1
+			}
+			cd := rotateABI(newpk.Bytes(), sig)
+			switch tc.mut {
+			case "alg":
+				cd[34] = 1
+			case "padding":
+				cd[len(cd)-1] = 1
+			case "trailing":
+				cd = append(cd, 0)
+			case "overflow":
+				cd[1444] = 0xff
+			case "short":
+				cd = cd[:4]
+			case "offset":
+				cd[67] = 64
+			case "stop":
+				cd[3] ^= 1
+			}
+			tx := &types.PQTx{ChainID: cfg.ChainID, From: owner, Nonce: 7, GasTipCap: big.NewInt(1000000000), GasFeeCap: big.NewInt(2000000000), Gas: 1500000, To: reg, Value: new(big.Int), Data: cd, AlgID: 1}
+			// Keep execution gas above the calldata floor, exposing the exact frame cost.
+			for i := 1; i <= 42; i++ {
+				tx.AccessList = append(tx.AccessList, types.AccessTuple{Address: common.BigToAddress(big.NewInt(int64(0x2000 + i)))})
+			}
+			if tc.activate {
+				tx.PublicKey = [][]byte{pk1.Bytes()}
+			}
+			if tc.mut == "value" {
+				tx.Value.SetInt64(1)
+			}
+			tx.Signature = pqSignTag(t, sk1, "ETH-PQ-TX/v1", tx.SigningHash())
+			p, err := validatePQ(s, cfg, h, types.NewTx(tx), owner, true, verifyPQMigrationSignatureAt)
+			if err != nil {
+				t.Fatal(err)
+			}
+			rules := evm.GetRules()
+			intrinsic, err := IntrinsicGas(p.calldata, tx.AccessList, nil, owner, &reg, nil, rules)
+			if err != nil {
+				t.Fatal(err)
+			}
+			intrinsic += p.extraGas
+			if tc.mut == "oog" {
+				tx.Gas = intrinsic + tc.used
+				tx.Signature = pqSignTag(t, sk1, "ETH-PQ-TX/v1", tx.SigningHash())
+				p, err = validatePQ(s, cfg, h, types.NewTx(tx), owner, true, verifyPQMigrationSignatureAt)
+				if err != nil {
+					t.Fatal(err)
+				}
+				intrinsic, err = IntrinsicGas(p.calldata, tx.AccessList, nil, owner, &reg, nil, rules)
+				if err != nil {
+					t.Fatal(err)
+				}
+				intrinsic += p.extraGas
+				// Signature bytes alter intrinsic gas. Keep the carrying transaction's
+				// frame safely below the write charge and assert full gas consumption.
+				tx.Gas = intrinsic + 320000
+				tx.Signature = pqSignTag(t, sk1, "ETH-PQ-TX/v1", tx.SigningHash())
+			}
+			rc := pqApply(t, s, evm, h, NewGasPool(h.GasLimit), types.NewTx(tx), 0)
+			if rc.Status != tc.status {
+				t.Fatalf("status=%d want=%d gas=%d", rc.Status, tc.status, rc.GasUsed)
+			}
+			if tc.mut == "oog" {
+				if rc.GasUsed != tx.Gas {
+					t.Fatal("OOG must consume gas limit")
+				}
+			} else if rc.GasUsed != intrinsic+tc.used {
+				t.Fatalf("gas=%d intrinsic=%d frame want=%d", rc.GasUsed, intrinsic, tc.used)
+			}
+			changed := tc.status == 1 && tc.mut != "stop"
+			wantPK := pk1.Bytes()
+			wantRecord := record
+			if changed {
+				wantPK = newpk.Bytes()
+				wantRecord.MigrationNonce++
+				wantRecord.Commit = PQKeyCommit(1, wantPK)
+			}
+			if ReadPQRecord(s, reg, owner) != wantRecord || !bytes.Equal(s.GetCode(owner), append([]byte{0xef, 1, 1}, wantPK...)) || s.GetNonce(owner) != 8 {
+				t.Fatal("state/nonce/code mismatch")
+			}
+			nlogs := 0
+			if tc.activate {
+				nlogs++
+			}
+			if changed {
+				nlogs++
+			}
+			if len(rc.Logs) != nlogs {
+				t.Fatalf("logs=%d want=%d", len(rc.Logs), nlogs)
+			}
+			if tc.activate && rc.Logs[0].Topics[0] != crypto.Keccak256Hash([]byte("Activated(address)")) {
+				t.Fatal("activation log order")
+			}
+			if changed {
+				l := rc.Logs[len(rc.Logs)-1]
+				if l.Address != reg || len(l.Data) != 64 || l.Data[31] != 1 || !bytes.Equal(l.Data[32:], wantRecord.Commit[:]) || l.Topics[0] != crypto.Keccak256Hash([]byte("Rotated(address,uint8,bytes32)")) {
+					t.Fatal("Rotated log")
+				}
+				// A previously accepted signature under the old key must not authorize a
+				// new transaction after the binding changes, even with a warm signature cache.
+				if !tc.same {
+					sp := &types.PQTx{ChainID: cfg.ChainID, From: owner, Nonce: 8, GasTipCap: big.NewInt(1000000000), GasFeeCap: big.NewInt(2000000000), Gas: 500000, To: pqRecipient, Value: new(big.Int), AlgID: 1}
+					sp.Signature = pqSignTag(t, sk1, "ETH-PQ-TX/v1", sp.SigningHash())
+					if ValidatePQTransaction(s, cfg, h, types.NewTx(sp), true) == nil {
+						t.Fatal("old key accepted")
+					}
+					sp.Signature = pqSignTag(t, newsk, "ETH-PQ-TX/v1", sp.SigningHash())
+					if err := ValidatePQTransaction(s, cfg, h, types.NewTx(sp), true); err != nil {
+						t.Fatal(err)
+					}
+				}
+			}
+			t.Logf("status=%d gas=%d activated=%t migrationNonce=%d logs=%d", rc.Status, rc.GasUsed, tc.activate, wantRecord.MigrationNonce, len(rc.Logs))
+		})
+	}
+}
diff --git a/core/pq_signature_cache.go b/core/pq_signature_cache.go
new file mode 100644
index 0000000000000000000000000000000000000000..ea023c79ce316d02c0080997c1e23218979d2e28
--- /dev/null
+++ b/core/pq_signature_cache.go
@@ -0,0 +1,96 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package core
+
+import (
+	"sync"
+
+	"github.com/cloudflare/circl/sign/mldsa/mldsa44"
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/common/lru"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/crypto"
+	"github.com/ethereum/go-ethereum/params"
+)
+
+// Only failed evaluations of the pure, fixed ML-DSA-44 signature profile are
+// memoized. A hit does not change gas, state checks or the caller's peer budget.
+// The fixed-capacity LRU stores 32-byte keys, never attacker-provided payloads.
+var pqSignatureFailures = newPQSignatureFailureCache(1024, verifyPQMigrationSignatureUncached)
+
+type pqSignatureFailureCache struct {
+	mu      sync.Mutex
+	epoch   string
+	entries lru.BasicLRU[common.Hash, struct{}]
+	check   func([]byte, string, common.Hash, []byte) bool
+}
+
+func newPQSignatureFailureCache(capacity int, check func([]byte, string, common.Hash, []byte) bool) *pqSignatureFailureCache {
+	return &pqSignatureFailureCache{entries: lru.NewBasicLRU[common.Hash, struct{}](capacity), check: check}
+}
+
+// This is exactly the complete invocation key in adopted spec section 20.3.
+// In particular a rotation/reorg to a different public key cannot reuse a
+// failure under the old key, even when the account and nonce are unchanged.
+func pqSignatureFailureKey(pk []byte, tag string, digest common.Hash, sig []byte) common.Hash {
+	return crypto.Keccak256Hash([]byte{1}, crypto.Keccak256(pk), []byte{byte(len(tag))}, []byte(tag), digest[:], sig)
+}
+
+func (c *pqSignatureFailureCache) verify(epoch string, pk []byte, tag string, digest common.Hash, sig []byte) bool {
+	// Reject malformed sizes before hashing. All deployed research call sites
+	// use fixed short domains; unsupported contexts cannot enter the cache.
+	if len(pk) != mldsa44.PublicKeySize || len(sig) != mldsa44.SignatureSize || len(tag) > 255 {
+		return false
+	}
+	key := pqSignatureFailureKey(pk, tag, digest, sig)
+	c.mu.Lock()
+	if c.epoch != epoch {
+		c.entries.Purge()
+		c.epoch = epoch
+	}
+	_, hit := c.entries.Get(key)
+	c.mu.Unlock()
+	if hit {
+		return false
+	}
+	valid := c.check(pk, tag, digest, sig)
+	if !valid {
+		c.mu.Lock()
+		// A concurrent validation on another fork may have cleared the cache.
+		// Do not reintroduce an old configuration's result after that clearing.
+		if c.epoch == epoch {
+			c.entries.Add(key, struct{}{})
+		}
+		c.mu.Unlock()
+	}
+	return valid
+}
+
+// PQSignatureCheck evaluates VerifyMigrationSignature for one call site.
+type PQSignatureCheck func(c *params.ChainConfig, h *types.Header, pk []byte, tag string, digest common.Hash, sig []byte) bool
+
+type pqSignatureCheck = PQSignatureCheck
+
+// VerifyPQMigrationSignatureForPool retains the shared negative-cache policy for
+// pool-local positive-cache misses. It must not be used for block execution.
+func VerifyPQMigrationSignatureForPool(c *params.ChainConfig, h *types.Header, pk []byte, tag string, digest common.Hash, sig []byte) bool {
+	return verifyPQMigrationSignatureAt(c, h, pk, tag, digest, sig)
+}
+
+// verifyPQMigrationSignatureAt is the evaluation of the pool call sites, txpool
+// admission and reset. They alone consult the negative cache (spec l. 2808).
+func verifyPQMigrationSignatureAt(c *params.ChainConfig, h *types.Header, pk []byte, tag string, digest common.Hash, sig []byte) bool {
+	// This research client admits only the fixed pure FIPS-204 ML-DSA-44
+	// profile. Purge at every execution-fork transition (including a reorg
+	// back). Enabling another algorithm/profile must also change this epoch.
+	epoch := "FIPS204-pure-ML-DSA-44/" + c.LatestFork(h.Time).String()
+	return pqSignatureFailures.verify(epoch, pk, tag, digest, sig)
+}
+
+// verifyPQMigrationSignatureInBlock is the evaluation of block building and
+// import: every signature is verified again, and the negative cache is neither
+// consulted nor filled (spec l. 2808, l. 2895).
+func verifyPQMigrationSignatureInBlock(_ *params.ChainConfig, _ *types.Header, pk []byte, tag string, digest common.Hash, sig []byte) bool {
+	return verifyPQMigrationSignatureUncached(pk, tag, digest, sig)
+}
diff --git a/core/pq_signature_cache_block_test.go b/core/pq_signature_cache_block_test.go
