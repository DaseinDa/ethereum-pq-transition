@@ -0,0 +1,229 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package pqpool
+
+import (
+	"errors"
+	"math/big"
+	"testing"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core"
+	"github.com/ethereum/go-ethereum/core/state"
+	"github.com/ethereum/go-ethereum/core/tracing"
+	"github.com/ethereum/go-ethereum/core/txpool"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/params"
+)
+
+type strikeHistoryChain struct {
+	*componentChain
+	history map[common.Hash]*state.StateDB
+	genesis *types.Block
+}
+
+func (c *strikeHistoryChain) StateAt(h *types.Header) (*state.StateDB, error) {
+	if s := c.history[h.Hash()]; s != nil {
+		return s.Copy(), nil
+	}
+	return nil, errors.New("historical state unavailable")
+}
+func (c *strikeHistoryChain) Genesis() *types.Block { return c.genesis }
+func (c *strikeHistoryChain) block(parent *types.Block, timestamp uint64, key byte) *types.Block {
+	h := &types.Header{Number: big.NewInt(0), Time: timestamp, GasLimit: 120000000, GasUsed: 60000000, BaseFee: big.NewInt(1)}
+	if parent != nil {
+		h.ParentHash = parent.Hash()
+		h.Number = new(big.Int).Add(parent.Number(), big.NewInt(1))
+	}
+	b := types.NewBlockWithHeader(h)
+	s := c.s.Copy()
+	code := append([]byte(nil), s.GetCode(addr(20))...)
+	code[3] = key
+	s.SetCode(addr(20), code, tracing.CodeChangeUnspecified)
+	_, keySlot := core.PQRecordSlots(addr(20))
+	s.SetState(c.cfg.PQMigrate.Registry, keySlot, core.PQKeyCommit(1, code[3:]))
+	c.blocks[b.Hash()] = b
+	c.history[b.Hash()] = s
+	return b
+}
+func strikeFixture(t *testing.T, oldKey byte) (*Pool, *strikeHistoryChain, *types.Block, *types.Block) {
+	t.Helper()
+	p, c, _ := componentPool(t)
+	history := &strikeHistoryChain{componentChain: c, history: make(map[common.Hash]*state.StateDB)}
+	c.blocks = make(map[common.Hash]*types.Block)
+	genesis := history.block(nil, 700, oldKey)
+	history.genesis = genesis
+	oldest := history.block(genesis, 880, oldKey) // exactly td - hs - SLOT
+	head := history.block(oldest, 1000, 20)
+	p.chain = history
+	p.head = head.Header()
+	p.state = history.history[head.Hash()].Copy()
+	p.genesisTime = 700
+	p.deliveryClock.Store(1012)
+	p.checkState = func(*types.Transaction, *state.StateDB, *types.Header, *params.ChainConfig) error {
+		return &core.PQMigrationError{Name: "BAD_SPONSOR_SIG", Code: 0x0403}
+	}
+	return p, history, head, oldest
+}
+func rejectSponsor(t *testing.T, p *Pool, source string) {
+	t.Helper()
+	if err := p.AddFrom(source, []*types.Transaction{componentTx(1, 20, 2, 20)}, true)[0]; errorName(err) != "BAD_SPONSOR_SIG" {
+		t.Fatal(err)
+	}
+}
+
+// These exercise penalty policy with explicit state histories. The failing
+// signature hook isolates clocks and keys; it is not cryptographic evidence.
+func TestSponsorStrikeWaitsThenConfirmsOnlyOnce(t *testing.T) {
+	p, c, head, _ := strikeFixture(t, 20)
+	rejectSponsor(t, p, "peer")
+	if p.sources["peer"].failures != 0 || len(p.sponsorStrikes) != 1 {
+		t.Fatal("charged at rejection")
+	}
+	strike := p.sponsorStrikes[0]
+	early := c.block(head, 1119, 20)
+	p.Reset(head.Header(), early.Header())
+	if p.sources["peer"].failures != 0 || len(p.sponsorStrikes) != 1 {
+		t.Fatal("decided before max(td,tr)+hs")
+	}
+	decision := c.block(early, 1120, 20)
+	p.Reset(early.Header(), decision.Header())
+	if p.sources["peer"].failures != 1 || len(p.sponsorStrikes) != 0 {
+		t.Fatal("unchanged key not charged at equality")
+	}
+	// The replacement branch is also eligible to decide at pool clock 1132,
+	// and its intervening rotation would cancel a still-provisional strike.
+	rotated := c.block(head, 1100, 21)
+	back := c.block(rotated, 1120, 20)
+	if got := txpool.PQPoolTime(back.Header(), c.cfg); got != 1132 {
+		t.Fatalf("reorganization pool clock = %d, want 1132", got)
+	}
+	hs, ok := p.strikeHorizon()
+	if !ok || p.confirmSponsorStrike(strike, back.Header(), hs) {
+		t.Fatal("replacement branch does not contradict the original strike")
+	}
+	p.Reset(decision.Header(), back.Header())
+	if p.sources["peer"].failures != 1 || len(p.sponsorStrikes) != 0 {
+		t.Fatal("reorganization revised a final strike decision")
+	}
+}
+
+func TestSponsorStrikeCancelsForKeyAtOldestBoundary(t *testing.T) {
+	p, c, head, _ := strikeFixture(t, 21)
+	rejectSponsor(t, p, "relay")
+	decision := c.block(head, 1120, 20)
+	p.Reset(head.Header(), decision.Header())
+	if p.sources["relay"].failures != 0 || len(p.sponsorStrikes) != 0 {
+		t.Fatal("rotation race charged honest relay")
+	}
+}
+
+func TestSponsorStrikeMoveBackUsesLaterDeliveryClock(t *testing.T) {
+	p, c, head, _ := strikeFixture(t, 20)
+	p.deliveryClock.Store(1144) // delivery preceded a head move back to tr=1012
+	rejectSponsor(t, p, "relay")
+	early := c.block(head, 1120, 20)
+	p.Reset(head.Header(), early.Header())
+	if len(p.sponsorStrikes) != 1 || p.sources["relay"].failures != 0 {
+		t.Fatal("move-back shortened decision wait")
+	}
+	rotated := c.block(early, 1200, 21)
+	decision := c.block(rotated, 1252, 21)
+	p.Reset(early.Header(), decision.Header())
+	if len(p.sponsorStrikes) != 0 || p.sources["relay"].failures != 0 {
+		t.Fatal("later canonical key did not cancel")
+	}
+}
+
+func TestSponsorStrikeMissingHistoryCancels(t *testing.T) {
+	p, c, head, oldest := strikeFixture(t, 20)
+	rejectSponsor(t, p, "relay")
+	delete(c.history, oldest.Hash())
+	decision := c.block(head, 1120, 20)
+	p.Reset(head.Header(), decision.Header())
+	if len(p.sponsorStrikes) != 0 || p.sources["relay"].failures != 0 {
+		t.Fatal("missing state confirmed a strike")
+	}
+}
+
+func TestSponsorStrikeForkWindowAndGenesisBoundaries(t *testing.T) {
+	p, c, _, _ := strikeFixture(t, 20)
+	c.cfg.PQMigrate.T = 1100
+	rejectSponsor(t, p, "fork-relay")
+	if len(p.sponsorStrikes) != 0 || p.sources["fork-relay"].failures != 0 {
+		t.Fatal("future fork inside window was charged")
+	}
+	p.genesisTime = 0
+	c.cfg.PQMigrate.T0 = 12
+	c.cfg.PQMigrate.T = 10000
+	if !p.signatureForkWindow(48, 48, 120) {
+		t.Fatal("near-genesis integer window underflowed")
+	}
+	c.cfg.PQMigrate.T0 = 0
+	if p.signatureForkWindow(48, 48, 120) {
+		t.Fatal("fork already active at genesis opened a window")
+	}
+	c.cfg.PQMigrate.T0 = 892
+	if p.signatureForkWindow(1012, 1012, 120) {
+		t.Fatal("open lower boundary treated as closed")
+	}
+	c.cfg.PQMigrate.T0 = 1132
+	if !p.signatureForkWindow(1012, 1012, 120) {
+		t.Fatal("closed upper boundary excluded")
+	}
