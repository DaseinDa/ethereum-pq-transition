@@ -0,0 +1,95 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package pqpool
+
+import (
+	"encoding/json"
+	"fmt"
+	"math/big"
+	"testing"
+	"time"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/params"
+)
+
+// Explicit synthetic state/proof hooks; this is scheduling evidence, not 128
+// real ownership proofs. 128 distinct unactivated owners use eight activated
+// payers with exactly 16 candidates per payer; all coexist under real slot and
+// cumulative balance policy. Only the signature/ownership predicates are hooks. Only the clock window is advanced without sleeping.
+func TestPQPoolComponentSaturatedForwardProgress(t *testing.T) {
+	for _, headsPerWindow := range []int{1, 5} {
+		t.Run(fmt.Sprintf("heads-per-window-%d", headsPerWindow), func(t *testing.T) {
+			var txs []*types.Transaction
+			for i := 1; i <= 128; i++ {
+				txs = append(txs, changed(componentTx(1, byte(20+(i-1)/16), int64(130-i), 1000), func(m *types.PQMigrateTx) {
+					m.LegacyAddress = common.BigToAddress(big.NewInt(int64(10000 + i)))
+					// The scheduling model must use a legal carrier under the standard cap.
+					m.Gas = params.MaxTxGas
+				}))
+			}
+			p, c, _, _, old, next := componentFork(t, txs...)
+			p.cfg.VerificationBurst = DefaultConfig.VerificationBurst
+			p.cfg.VerificationWindow = DefaultConfig.VerificationWindow
+			calls := map[common.Hash]int{}
+			first := map[common.Hash]int{}
+			var sequence []string
+			var heads []map[string]interface{}
+			round := 0
+			p.checkProof = func(tx *types.Transaction, _ *params.ChainConfig, _ string) error {
+				calls[tx.Hash()]++
+				sequence = append(sequence, fmt.Sprintf("%d:%s", round, tx.Hash()))
+				return nil
+			}
+			head := next
+			for round = 0; round < 4*headsPerWindow+1; round++ {
+				if round%headsPerWindow == 0 {
+					p.verifyStart = time.Time{}
+				}
+				if round > 0 {
+					old = head
+					head = componentBlock(head, fmt.Sprintf("continuous-%d", round))
+					c.blocks[head.Hash()] = head
+				}
+				p.Reset(old.Header(), head.Header())
+				for _, tx := range txs {
+					if p.Has(tx.Hash()) {
+						if _, ok := first[tx.Hash()]; !ok {
+							first[tx.Hash()] = round
+						}
+					}
+				}
+				heads = append(heads, map[string]interface{}{"round": round, "model_elapsed_seconds": round * 60 / headsPerWindow, "pending": len(p.entries), "deferred": len(p.deferred), "window_full_calls": p.verifyCount, "ever_pending": len(first)})
+				if p.verifyCount > 64 || len(p.entries)+len(p.deferred) != 128 {
+					t.Fatalf("budget/capacity changed at round %d count=%d pending=%d deferred=%d", round, p.verifyCount, len(p.entries), len(p.deferred))
+				}
+			}
+			type item struct {
+				Hash         common.Hash `json:"hash"`
+				FirstPending int         `json:"first_pending_round"`
+				FullCalls    int         `json:"full_calls"`
+				WaitHeads    int         `json:"wait_heads"`
+			}
+			rows := make([]item, 0, 128)
+			for _, tx := range txs {
+				n, ok := first[tx.Hash()]
+				if !ok {
+					n = -1
+				}
+				rows = append(rows, item{tx.Hash(), n, calls[tx.Hash()], n})
+			}
+			data, _ := json.Marshal(map[string]interface{}{"layer": "component-hooks", "budget_per_minute": 64, "max_pending": 128, "head_rounds": 4*headsPerWindow + 1, "heads_per_window": headsPerWindow, "window_reset_rounds": []int{0, headsPerWindow, 2 * headsPerWindow, 3 * headsPerWindow, 4 * headsPerWindow}, "candidates": rows, "verification_order": sequence, "heads": heads, "clock": "model budget-window advance; actual host time is not a latency measurement"})
+			t.Log(string(data))
+			if len(first) != 128 {
+				t.Fatalf("starvation: only %d of 128 legal candidates ever became Pending after 5 budget windows", len(first))
+			}
+			for _, r := range rows {
+				if r.FirstPending > headsPerWindow {
+					t.Fatalf("candidate waited beyond next window: %+v", r)
+				}
+			}
+		})
+	}
+}
