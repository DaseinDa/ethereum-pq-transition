+// The fixture MUST be a new real composite receipt, with complete assumptions
+// resolved by the fixed worker. Missing artifacts skip rather than mock Full.
+func TestPQFullActualFixture(t *testing.T) {
+	rawname := os.Getenv("PQ_FULL_RAW")
+	if rawname == "" {
+		rawname = "migrate"
+	}
+	if _, e := os.Stat(filepath.Join(fullTestInputs, rawname+".bin")); e != nil {
+		t.Skip("real new proof/raw fixture not yet available")
+	}
+	for _, coinbase := range []common.Address{common.HexToAddress("900"), fullSponsor, fullLegacy} {
+		t.Run(coinbase.Hex(), func(t *testing.T) {
+			s, evm, h := fullEnv(t, coinbase)
+			tx := fullRead(t, rawname)
+			p, _ := tx.AsPQMigrate()
+			if p == nil {
+				t.Fatal("wrong fixture type")
+			}
+			pi, _ := os.ReadFile(filepath.Join(fullTestInputs, "pi.bin"))
+			if !bytes.Equal(p.PublicInputs(), pi) {
+				t.Fatal("node PI mismatch")
+			}
+			// Byte-identical typed/JSON round trips of the actual large proof carrier.
+			jb, e := json.Marshal(tx)
+			if e != nil {
+				t.Fatal(e)
+			}
+			var round types.Transaction
+			if e = json.Unmarshal(jb, &round); e != nil || round.Hash() != tx.Hash() {
+				t.Fatalf("large JSON codec %v", e)
+			}
+			gp := NewGasPool(h.GasLimit)
+			beforeState := s.Copy()
+			balances := map[common.Address]*big.Int{}
+			for _, a := range []common.Address{fullLegacy, fullSponsor, coinbase} {
+				balances[a] = s.GetBalance(a).ToBig()
+			}
+			oldL, oldS := s.GetNonce(fullLegacy), s.GetNonce(fullSponsor)
+			rc := pqApply(t, s, evm, h, gp, tx, 2)
+			rec := ReadPQRecord(s, evm.ChainConfig().PQMigrate.Registry, fullLegacy)
+			if rec.Mode != 2 || rec.MigrationNonce != 1 || rec.Commit != fullCommit || len(s.GetCode(fullLegacy)) != 0 || s.GetNonce(fullLegacy) != oldL || s.GetNonce(fullSponsor) != oldS {
+				t.Fatal("migration write/nonce")
+			}
+			if rc.Type != 0x7e || rc.Status != 1 || len(rc.Logs) != 1 || len(rc.Logs[0].Data) != 160 || binary.BigEndian.Uint64(rc.Logs[0].Data[88:96]) != 1 || rc.Logs[0].Data[127] != 0 || rc.Logs[0].Data[159] != 0 {
+				t.Fatal("migrated event/typed receipt")
+			}
+			cost := new(big.Int).Mul(new(big.Int).SetUint64(rc.GasUsed), big.NewInt(1100000000))
+			tip := new(big.Int).Mul(new(big.Int).SetUint64(rc.GasUsed), big.NewInt(100000000))
+			reimburse := new(big.Int).Set(p.MaxAccountFee)
+			if reimburse.Cmp(balances[fullLegacy]) > 0 {
+				reimburse.Set(balances[fullLegacy])
+			}
+			balances[fullSponsor].Sub(balances[fullSponsor], cost)
+			balances[fullLegacy].Sub(balances[fullLegacy], reimburse)
+			balances[fullSponsor].Add(balances[fullSponsor], reimburse)
+			balances[coinbase].Add(balances[coinbase], tip)
+			for a, want := range balances {
+				if s.GetBalance(a).CmpBig(want) != 0 {
+					t.Fatalf("address ledger %s got %s want %s", a, s.GetBalance(a), want)
+				}
+			}
+			if gp.Used() != rc.GasUsed || rc.CumulativeGasUsed != rc.GasUsed {
+				t.Fatal("block gas")
+			}
+			receiptRoot := types.DeriveSha(types.Receipts{rc}, trie.NewStackTrie(nil))
+			stateRoot := s.IntermediateRoot(evm.GetRules())
+			s.SetTxContext(tx.Hash(), 3, 4)
+			_, _, e = ApplyTransaction(context.Background(), evm, gp, s, h, tx)
+			if e == nil || !strings.Contains(e.Error(), "WRONG_MIGRATION_NONCE") || s.IntermediateRoot(evm.GetRules()) != stateRoot {
+				t.Fatalf("replay %v", e)
+			}
+			// Reorg replay: rebuild the EVM on the reconstructed pre-state and execute
+			// the same real transaction through ApplyTransaction again, with real Full.
+			replay := vm.NewEVM(evm.Context, beforeState, evm.ChainConfig(), vm.Config{})
+			defer replay.Release()
+			rcReplay := pqApply(t, beforeState, replay, h, NewGasPool(h.GasLimit), tx, 2)
+			if beforeState.IntermediateRoot(replay.GetRules()) != stateRoot || types.DeriveSha(types.Receipts{rcReplay}, trie.NewStackTrie(nil)) != receiptRoot {
+				t.Fatal("reconstructed-state replay diverged")
+			}
+			// Then the Rust signed activation and ordinary call execute in real EVM.
+			ac, sp := fullRead(t, "activate"), fullRead(t, "spend")
+			pqApply(t, s, evm, h, gp, ac, 3)
+			pqApply(t, s, evm, h, gp, sp, 4)
+			if !PQActivated(s, evm.ChainConfig().PQMigrate, fullLegacy) || s.GetNonce(fullLegacy) != 2 {
+				t.Fatal("activation/call after real Full")
+			}
+			t.Logf("real Full bytes=%d gas=%d state=%s receipts=%s; account nonces unchanged at migration", len(p.ProofCarrier.Proof), rc.GasUsed, stateRoot, receiptRoot)
+		})
+	}
+}
