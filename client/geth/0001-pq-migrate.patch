+// L2 with the real pqpool on both nodes and the real carrier, on the F run's
+// genesis and a head at the real clock (never a rolled-back clock or an edited
+// PI): the source admits the carrier after native F verification, announces
+// it, and the peer fetches it and admits it after its own verification. A
+// carrier above the raw bound is refused at the source and never announced.
+// Skips with a reason when the native verifier is not linked or the proof's
+// expiry has passed.
+func TestPQL2CarrierPropagationRealPool(t *testing.T) {
+	carrier := pqL2Carrier(t)
+	gspec := new(core.Genesis)
+	if err := json.Unmarshal(pqL2File(t, "PQ_L2_GENESIS", pqL2GenesisSHA), gspec); err != nil {
+		t.Fatal(err)
+	}
+	if err := core.CheckPQFullVerifierConfig(gspec.Config.PQMigrate.FullResearch); err != nil {
+		t.Skipf("native F verifier unavailable (%v): build with -tags pq_native,pq_final and the native libraries", err)
+	}
+	m, _ := carrier.AsPQMigrate()
+	now := uint64(time.Now().Unix())
