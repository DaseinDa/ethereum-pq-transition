+func TestPQPoolProofCacheKeyBindsEveryInput(t *testing.T) {
+	p, chain, calls := componentPool(t)
+	tx := componentTx(1, 20, 2, 20)
+	base := p.proofResultKey(tx)
+	mutations := map[string]func(*types.PQMigrateTx){
+		"chain":       func(m *types.PQMigrateTx) { m.ChainID.Add(m.ChainID, common.Big1) },
+		"legacy":      func(m *types.PQMigrateTx) { m.LegacyAddress[0]++ },
+		"nonce":       func(m *types.PQMigrateTx) { m.MigrationNonce++ },
+		"alg":         func(m *types.PQMigrateTx) { m.AlgID++ },
+		"commit":      func(m *types.PQMigrateTx) { m.PQPKCommit[0]++ },
+		"version":     func(m *types.PQMigrateTx) { m.VerifierVersion++ },
+		"expiry":      func(m *types.PQMigrateTx) { m.Expiry++ },
+		"owner-fee":   func(m *types.PQMigrateTx) { m.MaxAccountFee.Add(m.MaxAccountFee, common.Big1) },
+		"fee-mode":    func(m *types.PQMigrateTx) { m.FeeMode++ },
+		"fee-sponsor": func(m *types.PQMigrateTx) { m.FeeSponsor[0]++ },
+		"fee-until":   func(m *types.PQMigrateTx) { m.FeeAuthUntil++ },
+		"proof":       func(m *types.PQMigrateTx) { m.ProofCarrier.Proof[0] ^= 1 },
+	}
+	// Exercise the actual verification/cache helper to detect accidental hits;
+	// admission rejects malformed combinations earlier and is tested separately.
+	for name, change := range mutations {
+		t.Run(name, func(t *testing.T) {
+			altered := changed(tx, change)
+			if p.proofResultKey(altered) == base {
+				t.Fatal("changed input shared cache key")
+			}
+		})
+	}
+	if err := p.verifyProofCached(tx, "test", "test"); err != nil {
+		t.Fatal(err)
+	}
+	proofChange := changed(tx, mutations["proof"])
+	piChange := changed(tx, mutations["expiry"])
+	for _, item := range []*types.Transaction{proofChange, piChange} {
+		if err := p.verifyProofCached(item, "test", "test"); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for _, field := range []*common.Hash{&chain.cfg.PQMigrate.FullResearch.ImageID, &chain.cfg.PQMigrate.FullResearch.GuestSHA, &chain.cfg.PQMigrate.FullResearch.VerifierSHA, &chain.cfg.PQMigrate.FullResearch.NativeAlgorithmDigest} {
+		field[0]++
+		if err := p.verifyProofCached(tx, "test", "test"); err != nil {
+			t.Fatal(err)
+		}
+	}
+	chain.cfg.PQMigrate.FullResearch.Backend = params.PQSuccinctNativeBackend
+	if err := p.verifyProofCached(tx, "test", "test"); err != nil {
+		t.Fatal(err)
+	}
+	versionChange := changed(tx, mutations["version"])
+	chain.cfg.PQMigrate.FullResearch.Version++
+	if err := p.verifyProofCached(versionChange, "test", "test"); err != nil {
+		t.Fatal(err)
+	}
+	if *calls != 9 || p.proofCacheHits != 0 {
+		t.Fatalf("identity changes hit cache: calls=%d hits=%d", *calls, p.proofCacheHits)
+	}
+	old := p.proofResultKey(tx)
+	p.proofCacheSalt[0] ^= 1
+	if old == p.proofResultKey(tx) {
+		t.Fatal("node salt not bound")
+	}
+}
