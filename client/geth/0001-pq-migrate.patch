@@ -0,0 +1,12 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package txpool
+
+import "errors"
+
+// Admission-only resource outcomes. Never used by a consensus validator.
+var (
+	ErrPQBusy         = errors.New("PQPOOL_LOCAL_BUSY: retry admission")
+	ErrPQSourceBudget = errors.New("PQPOOL_SOURCE_BUDGET")
+)
diff --git a/core/txpool/pqpool/batch.go b/core/txpool/pqpool/batch.go
new file mode 100644
index 0000000000000000000000000000000000000000..6cd02c492bc353248423d6e7d25944baafdeaaa2
--- /dev/null
+++ b/core/txpool/pqpool/batch.go
@@ -0,0 +1,507 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package pqpool
+
+import (
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core"
+	"github.com/ethereum/go-ethereum/core/tracing"
+	"github.com/ethereum/go-ethereum/core/txpool"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/log"
+	"github.com/ethereum/go-ethereum/params"
+	"github.com/holiman/uint256"
+	"math/big"
+	"sort"
+	"time"
+)
+
+type batchEntry struct {
+	tx            *types.Transaction
+	seen          time.Time
+	pending       bool
+	admitted      bool
+	resetReady    bool
+	deferredOrder uint64
+}
+
+func batchError(name string, code uint16) error {
+	return &core.PQMigrationError{Name: name, Code: code}
+}
+func (p *Pool) batchBasics(tx *types.Transaction) error {
+	b, ok := tx.AsPQBatch()
+	if !ok {
+		return core.ErrTxTypeNotSupported
+	}
+	c := p.chain.Config().PQMigrate
+	if c == nil || c.AggregateResearch == nil || c.FullResearch == nil {
+		return core.ErrTxTypeNotSupported
+	}
+	if e := b.ValidateShape(); e != nil {
+		return batchError("NON_CANONICAL_ENCODING", 3)
+	}
+	if uint64(len(b.Entries)) != c.AggregateResearch.NMax || tx.Size() > c.AggregateResearch.MaxTxBytes {
+		return batchError("NON_CANONICAL_ENCODING", 3)
+	}
+	if uint64(len(b.ProofCarrier.Proof)) > c.FullResearch.MaxProofBytes {
+		return batchError("PROOF_TOO_LARGE", 8)
+	}
+	return nil
+}
+func (p *Pool) batchList(addr common.Address) []*batchEntry {
+	var out []*batchEntry
+	for _, e := range p.batches {
+		b, _ := e.tx.AsPQBatch()
+		if b.Sponsor == addr {
+			out = append(out, e)
+		}
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].tx.Nonce() < out[j].tx.Nonce() })
+	return out
+}
+func (p *Pool) batchNonce(addr common.Address) uint64 {
+	if p.state == nil {
+		return 0
+	}
+	n := p.state.Copy().GetNonce(addr)
+	for _, e := range p.batchList(addr) {
+		if !(e.pending || p.resetting && e.admitted && e.resetReady) || e.tx.Nonce() != n {
+			break
+		}
+		n++
+	}
+	return n
+}
+func (p *Pool) batchLiability(addr common.Address, except common.Hash) (int, *big.Int) {
+	return p.batchLiabilityWith(addr, except, nil)
+}
+
+// At reset, count only the revalidated gapless sequence, including the sequence
+// that a candidate would join by closing its first gap (section 28.6).
+func (p *Pool) batchLiabilityWith(addr common.Address, except common.Hash, candidate *types.PQBatchTx) (int, *big.Int) {
+	n, total := 0, new(big.Int)
+	if !p.resetting {
+		for hash, e := range p.batches {
+			b, _ := e.tx.AsPQBatch()
+			if hash != except && b.Sponsor == addr && e.pending {
+				n++
+				total.Add(total, new(big.Int).Mul(new(big.Int).SetUint64(b.Gas), b.GasFeeCap))
+			}
+		}
+		return n, total
+	}
+	next := p.state.Copy().GetNonce(addr)
+	list := p.batchList(addr)
+	for {
+		if candidate != nil && candidate.SponsorNonce == next {
+			if next == ^uint64(0) {
+				return n, total
+			}
+			next++ // caller adds the candidate's own liability/count
+			continue
+		}
+		var found *types.PQBatchTx
+		for _, e := range list {
+			if e.tx.Hash() != except && e.tx.Nonce() == next && e.admitted && e.resetReady {
+				found, _ = e.tx.AsPQBatch()
+				break
+			}
+		}
+		if found == nil {
+			return n, total
+		}
+		n++
+		total.Add(total, new(big.Int).Mul(new(big.Int).SetUint64(found.Gas), found.GasFeeCap))
+		if next == ^uint64(0) {
+			return n, total
+		}
+		next++
+	}
+}
+func (p *Pool) dropBatch(hash common.Hash) {
+	e := p.batches[hash]
+	if e == nil {
+		return
+	}
+	b, _ := e.tx.AsPQBatch()
+	delete(p.batches, hash)
+	p.batchBytes -= e.tx.Size()
+	if len(p.batchList(b.Sponsor)) == 0 && p.reserver != nil {
+		p.reserver.Release(b.Sponsor)
+	}
+}
+func (p *Pool) addBatch(tx *types.Transaction, admission bool) error {
+	return p.addBatchWithProof(tx, admission, core.ValidatePQBatchProof)
+}
+
+// Only proof evaluation is parameterized for policy component tests. Every
+// production caller enters addBatch and supplies the pinned native C verifier.
+func (p *Pool) addBatchWithProof(tx *types.Transaction, admission bool, verifyProof func(*types.Transaction, *params.ChainConfig) error) error {
+	if err := p.batchBasics(tx); err != nil {
+		return err
+	}
+	b, _ := tx.AsPQBatch()
+	h := p.nextHeader()
+	if p.state == nil || p.stateErr != nil {
+		return ErrLocalUnavailable
+	}
+	if p.reserver != nil && p.reserver.Has(b.Sponsor) {
+		return txpool.ErrAlreadyReserved
+	}
+	// Sponsor conditions follow section 27.6: activation, current expiry,
+	// nonce sequence, cumulative balance, count, horizon, then ban.
+	attempt := p.state.Copy()
+	activated := core.PQActivated(attempt, p.chain.Config().PQMigrate, b.Sponsor)
+	if attempt.Error() != nil {
+		return ErrLocalUnavailable
+	}
+	if !activated {
+		return batchError("NOT_PQ_ACCOUNT", 0x0106)
+	}
+	if h.Time > b.SponsorValidUntil {
+		return batchError("SPONSOR_EXPIRED", 0x0309)
+	}
+	var displaced common.Hash
+	list := p.batchList(b.Sponsor)
+	next := attempt.GetNonce(b.Sponsor)
+	stateNonce := next
+	held := p.resetting && p.batches[tx.Hash()] != nil && !p.batches[tx.Hash()].admitted
+	if attempt.Error() != nil {
+		return ErrLocalUnavailable
+	}
+	for _, e := range list {
+		if e.tx.Nonce() == b.SponsorNonce {
+			displaced = e.tx.Hash()
+			break
+		}
+		if !(e.pending || p.resetting && e.admitted && e.resetReady) || e.tx.Nonce() != next {
+			break
+		}
+		next++
+	}
+	if held {
+		// Section 28.6(c): a held retry may sit above a gap until the
+		// final sweep. Find its same-nonce replacement even above that gap.
+		if b.SponsorNonce < stateNonce {
+			return batchError("WRONG_SPONSOR_NONCE", 0x0308)
+		}
+		for _, e := range list {
+			if e.tx.Nonce() == b.SponsorNonce {
+				displaced = e.tx.Hash()
+				break
+			}
+		}
+	} else if b.SponsorNonce != next {
+		return batchError("WRONG_SPONSOR_NONCE", 0x0308)
+	}
+	n, total := p.batchLiabilityWith(b.Sponsor, displaced, b)
+	for _, e := range p.entries {
+		if s := e.template.Sponsor(); s != nil && s.Sponsor == b.Sponsor {
+			n++
+			total.Add(total, liability(e.template))
+		}
+	}
+	total.Add(total, new(big.Int).Mul(new(big.Int).SetUint64(b.Gas), b.GasFeeCap))
+	balance := attempt.GetBalance(b.Sponsor)
+	if attempt.Error() != nil {
+		return ErrLocalUnavailable
+	}
+	if balance.CmpBig(total) < 0 {
+		return batchError("INSUFFICIENT_FEE_BALANCE", 0x0302)
+	}
+	if n >= p.cfg.MaxSponsored {
+		return batchError("SPONSOR_PENDING_LIMIT", 0x0303)
+	}
+	if admission && (h.Time > ^uint64(0)-p.sponsorHorizon() || b.SponsorValidUntil < h.Time+p.sponsorHorizon()) {
+		return batchError("SPONSOR_EXPIRED", 0x0309)
+	}
+	// Entry fee authorization may expire before sponsor authorization. It
+	// affects reimbursement at execution, never sponsor admission (section 27.6).
+	if admission && time.Now().Before(p.bans[b.Sponsor]) {
+		return batchError("SPONSOR_BANNED", 0x030a)
+	}
+	if b.GasTipCap.Cmp(p.minTip) < 0 {
+		return txpool.ErrUnderpriced
+	}
+	if displaced != (common.Hash{}) && !(p.resetting && displaced == tx.Hash() && !p.batches[displaced].admitted) {
+		old, _ := p.batches[displaced].tx.AsPQBatch()
+		if b.GasTipCap.Cmp(doubled(old.GasTipCap)) < 0 || b.GasFeeCap.Cmp(doubled(old.GasFeeCap)) < 0 {
+			return txpool.ErrReplaceUnderpriced
+		}
+	}
+	credit := uint64(0)
+	if e := p.batches[displaced]; e != nil {
+		credit = e.tx.Size()
+	}
+	if (len(p.batches)+len(p.entries)+len(p.deferred) >= p.cfg.MaxPending && displaced == (common.Hash{})) || tx.Size() > p.cfg.DataCap || p.bodyBytes+p.deferredBytes+p.batchBytes-credit > p.cfg.DataCap-tx.Size() {
+		return txpool.ErrOutOfCapacity
+	}
+	attempt.SetNonce(b.Sponsor, b.SponsorNonce, tracing.NonceChangeUnspecified)
+	stateErr := core.ValidatePQBatchState(tx, attempt, h, p.chain.Config(), admission)
+	if attempt.Error() != nil {
+		return ErrLocalUnavailable
+	}
+	if stateErr != nil {
+		return stateErr
+	}
+	if err := p.verificationBudget(); err != nil {
+		return err
+	}
+	if err := verifyProof(tx, p.chain.Config()); err != nil {
+		return err
+	}
+	if len(list) == 0 && p.reserver != nil {
+		if err := p.reserver.Hold(b.Sponsor); err != nil {
+			return err
+		}
+	}
+	// Replace in place: never momentarily release the sponsor reservation.
+	if displaced != (common.Hash{}) {
+		p.batchBytes -= p.batches[displaced].tx.Size()
+		delete(p.batches, displaced)
+	}
+	owned := types.NewTx(b)
+	p.batches[owned.Hash()] = &batchEntry{tx: owned, seen: time.Now(), pending: b.SponsorNonce == next, admitted: true, resetReady: true}
+	p.batchBytes += owned.Size()
+	log.Info("PQ_BATCH_POOL_ACCEPT", "tx", tx.Hash(), "batch", b.BatchID(), "entries", len(b.Entries), "nonce", b.SponsorNonce)
+	return nil
+}
+
+// Drop included batches across the whole set before sponsor blame. For other
+// admitted batches, activation precedes own-expiry/version/fee evictions; only
+// surviving obligations can trigger an authorization-lapse or balance ban.
+func (p *Pool) pruneBatchReset(h *types.Header) {
+	slot := txpool.PQPoolSlot(p.chain.Config())
+	for hash, e := range p.batches {
+		b, _ := e.tx.AsPQBatch()
+		e.resetReady = false
+		if !e.admitted && p.resetCandidateExpired(e.tx, h) {
+			p.dropBatch(hash)
+			continue
+		}
+		attempt := p.state.Copy()
+		nonce := attempt.GetNonce(b.Sponsor)
+		if attempt.Error() != nil {
+			p.deferBatch(e.tx)
+			continue
+		}
+		if b.SponsorNonce < nonce {
+			p.dropBatch(hash)
+		}
+	}
+	for hash, e := range p.batches {
+		if !e.admitted {
+			continue
+		}
+		b, _ := e.tx.AsPQBatch()
+		attempt := p.state.Copy()
+		activated := core.PQActivated(attempt, p.chain.Config().PQMigrate, b.Sponsor)
+		if attempt.Error() != nil {
+			p.deferBatch(e.tx)
+			continue
+		}
+		if !activated {
+			p.banSponsor(b.Sponsor, "batch sponsor no longer activated")
+			continue
+		}
+		var expiry uint64
+		for _, entry := range b.Entries {
+			expiry = max(expiry, entry.Expiry)
+		}
+		if h.Time > ^uint64(0)-slot || expiry < h.Time+slot {
+			p.dropBatch(hash)
+			continue
+		}
+		f := p.chain.Config().PQMigrate.FullResearch
+		if f == nil || b.VerifierVersion != f.Version || h.Time < f.Activation || h.Time >= f.Sunset || b.GasTipCap.Cmp(p.minTip) < 0 || h.BaseFee != nil && b.GasFeeCap.Cmp(h.BaseFee) < 0 {
+			p.dropBatch(hash)
+		}
+	}
+}
+
+// Keep a reorg candidate on a local fault without announcing it. It reserves
+// its nonce-bearing sponsor, but is not accepted until its real C proof passes.
+func (p *Pool) deferBatch(tx *types.Transaction) {
+	if e := p.batches[tx.Hash()]; e != nil {
+		if e.admitted {
+			p.deferredOrder++
+			e.deferredOrder = p.deferredOrder
+		}
+		e.admitted, e.pending, e.resetReady = false, false, false
+		return
+	}
+	if p.batchBasics(tx) != nil {
+		return
+	}
+	if len(p.entries)+len(p.batches)+len(p.deferred) >= p.cfg.MaxPending || tx.Size() > p.cfg.DataCap || p.bodyBytes+p.batchBytes+p.deferredBytes > p.cfg.DataCap-tx.Size() {
+		return
+	}
+	b, _ := tx.AsPQBatch()
+	for _, e := range p.batchList(b.Sponsor) {
+		if e.tx.Nonce() == b.SponsorNonce {
+			return
+		}
+	}
+	if len(p.batchList(b.Sponsor)) == 0 && p.reserver != nil {
+		if p.reserver.Hold(b.Sponsor) != nil {
+			return
+		}
+	}
+	owned := types.NewTx(b)
+	p.deferredOrder++
+	p.batches[owned.Hash()] = &batchEntry{tx: owned, seen: time.Now(), deferredOrder: p.deferredOrder}
+	p.batchBytes += owned.Size()
+}
+
+// Revalidate retained batches without discarding a temporary nonce gap. The
+// final gapless sweep runs only after held retries and canonical-order orphans.
+func (p *Pool) revalidateBatches() {
+	h := p.nextHeader()
+	slot := txpool.PQPoolSlot(p.chain.Config())
+	sponsors := make(map[common.Address]bool)
+	for _, e := range p.batches {
+		b, _ := e.tx.AsPQBatch()
+		sponsors[b.Sponsor] = true
+	}
+	for addr := range sponsors {
+		list := p.batchList(addr)
+		nonceState := p.state.Copy()
+		next := nonceState.GetNonce(addr)
+		if nonceState.Error() != nil {
+			for _, e := range list {
+				p.deferBatch(e.tx)
+			}
+			continue
+		}
+		total := new(big.Int)
+		for _, single := range p.entries {
+			if s := single.template.Sponsor(); s != nil && s.Sponsor == addr {
+				total.Add(total, liability(single.template))
+			}
+		}
+		for _, e := range list {
+			b, _ := e.tx.AsPQBatch()
+			if p.batches[e.tx.Hash()] == nil {
+				continue
+			}
+			e.pending = false
+			if !e.admitted {
+				continue
+			} // retried later as a new admission
+			connected := b.SponsorNonce == next
+			attempt := p.state.Copy()
+			activated := core.PQActivated(attempt, p.chain.Config().PQMigrate, addr)
+			balance := attempt.GetBalance(addr)
+			if attempt.Error() != nil {
+				p.deferBatch(e.tx)
+				continue
+			}
+			if !activated || h.Time > ^uint64(0)-slot || b.SponsorValidUntil < h.Time+slot {
+				p.banSponsor(addr, "batch sponsor state changed")
+				break
+			}
+			if connected {
+				total.Add(total, new(big.Int).Mul(new(big.Int).SetUint64(b.Gas), b.GasFeeCap))
+				if balance.CmpBig(total) < 0 {
+					p.banSponsor(addr, "batch sponsor cumulative balance changed")
+					break
+				}
+			}
+			// A gap is a pool-sequence condition, not the transaction's current
+			// key/withdrawal/fee checks. Validate those before it can join later.
+			attempt.SetNonce(addr, b.SponsorNonce, tracing.NonceChangeUnspecified)
+			err := core.ValidatePQBatchState(e.tx, attempt, h, p.chain.Config(), false)
+			if attempt.Error() != nil {
+				err = ErrLocalUnavailable
+			}
+			if err != nil {
+				if retryable(err) {
+					p.deferBatch(e.tx)
+				} else {
+					p.dropBatch(e.tx.Hash())
+					// A signature failure is step (viii), after the cumulative
+					// bound. Keep its nonce in this pass's accounting prefix,
+					// so the batches above it still count under 28.6(b).
+					if connected && errorName(err) == "BAD_SPONSOR_SIG" {
+						next++
+					}
+				}
+				continue
+			}
+			e.resetReady = true
+			e.pending = connected
+			if connected {
+				next++
+			}
+		}
+	}
+}
+
+func (p *Pool) finishBatchReset() {
+	sponsors := make(map[common.Address]bool)
+	for _, e := range p.batches {
+		b, _ := e.tx.AsPQBatch()
+		sponsors[b.Sponsor] = true
+	}
+	for addr := range sponsors {
+		attempt := p.state.Copy()
+		next := attempt.GetNonce(addr)
+		if attempt.Error() != nil {
+			for _, e := range p.batchList(addr) {
+				p.deferBatch(e.tx)
+			}
+			continue
+		}
+		for _, e := range p.batchList(addr) {
+			if !e.admitted {
+				e.pending = false
+				continue
+			}
+			if e.tx.Nonce() == next && e.resetReady {
+				e.pending = true
+				next++
+			} else if e.resetReady {
+				p.dropBatch(e.tx.Hash()) // WRONG_SPONSOR_NONCE, never a ban
+			} else {
+				p.deferBatch(e.tx)
+			} // local fault stays unadmitted and unavailable
+		}
+	}
+}
+
+func (p *Pool) pendingBatches(f txpool.PendingFilter, result map[common.Address][]*txpool.LazyTransaction) int {
+	sponsors := make(map[common.Address]bool)
+	for _, e := range p.batches {
+		b, _ := e.tx.AsPQBatch()
+		sponsors[b.Sponsor] = true
+	}
+	n := 0
+	for addr := range sponsors {
+		for _, e := range p.batchList(addr) {
+			if !e.pending {
+				break
+			}
+			b, _ := e.tx.AsPQBatch()
+			fee, tip := uint256.MustFromBig(b.GasFeeCap), uint256.MustFromBig(b.GasTipCap)
+			if f.GasLimitCap != 0 && b.Gas > f.GasLimitCap {
+				break
+			}
+			if f.BaseFee != nil {
+				if fee.Cmp(f.BaseFee) < 0 {
+					break
+				}
+				tip = new(uint256.Int).Sub(fee, f.BaseFee)
+				if tip.Cmp(uint256.MustFromBig(b.GasTipCap)) > 0 {
+					tip = uint256.MustFromBig(b.GasTipCap)
+				}
+			}
+			if f.MinTip != nil && tip.Cmp(f.MinTip) < 0 {
+				break
+			}
+			result[addr] = append(result[addr], &txpool.LazyTransaction{Pool: p, Hash: e.tx.Hash(), Time: e.seen, GasFeeCap: fee, GasTipCap: uint256.MustFromBig(b.GasTipCap), Gas: b.Gas})
+			n++
+		}
+	}
+	return n
+}
