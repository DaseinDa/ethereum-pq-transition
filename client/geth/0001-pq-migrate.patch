+			if v.wantErr != "" {
+				if e == nil || !strings.Contains(e.Error(), v.wantErr) {
+					t.Fatal(e)
+				}
+				return
+			}
+			if e != nil {
+				t.Fatal(e)
+			}
+			gas := pqColdWriteGas(pqRecordWord(r), pqRecordWord(plan.next)) + pqColdWriteGas(r.Commit, plan.next.Commit)
+			if gas != v.wantGas || plan.next.EnrolledAt != r.EnrolledAt || plan.next.MigrationNonce != 2 {
+				t.Fatalf("cold gas/record %d %+v", gas, plan.next)
+			}
+		})
+	}
