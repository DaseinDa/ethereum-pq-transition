+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package core
+
+import (
+	"bytes"
+	"encoding/hex"
+	"errors"
+	"github.com/cloudflare/circl/sign/mldsa/mldsa44"
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/params"
+	"math/big"
+	"os"
+	"strings"
+	"testing"
+	"time"
+)
+
+func finalTestProfile() *params.PQFullResearchConfig {
+	f := nativeTestProfile()
+	f.Backend = params.PQFinalBackend
+	f.Version = params.PQFinalVersion
+	f.NativeAlgorithmDigest = params.PQFinalAlgorithmDigest
+	f.FinalKeyDigest = params.PQFinalKeyDigest
+	f.MaxProofBytes = params.PQFinalMaxProofBytes
+	f.MaxTxBytes = params.PQFinalMaxTxBytes
+	f.VerifyGas = params.PQFinalVerifyGas
+	f.ImageID = common.Hash{}
+	f.GuestSHA = common.Hash{}
+	return f
+}
+func TestPQFinalProfile(t *testing.T) {
+	c := nativeTestChain()
+	c.PQMigrate.FullResearch = finalTestProfile()
+	if err := c.CheckConfigForkOrder(); err != nil {
+		t.Fatal(err)
+	}
+	edits := map[string]func(*params.PQFullResearchConfig){
+		"uncalibrated-gas": func(f *params.PQFullResearchConfig) { f.VerifyGas = 5500000 },
+		"changed-gas":      func(f *params.PQFullResearchConfig) { f.VerifyGas++ },
+		"key":              func(f *params.PQFullResearchConfig) { f.FinalKeyDigest[0] ^= 1 },
+		"algorithm":        func(f *params.PQFullResearchConfig) { f.NativeAlgorithmDigest[0] ^= 1 },
+		"old-version":      func(f *params.PQFullResearchConfig) { f.Version = params.PQR1Version },
+		"proof-bound":      func(f *params.PQFullResearchConfig) { f.MaxProofBytes++ },
+		"tx-bound":         func(f *params.PQFullResearchConfig) { f.MaxTxBytes++ },
+		"image":            func(f *params.PQFullResearchConfig) { f.ImageID = params.PQSuccinctImageID },
+		"gas-cap":          func(f *params.PQFullResearchConfig) { f.TxGasCap = params.MaxTxGas + 1 },
+		"worker":           func(f *params.PQFullResearchConfig) { f.Backend = "external" },
+	}
+	for name, edit := range edits {
+		t.Run(name, func(t *testing.T) {
+			f := finalTestProfile()
+			edit(f)
+			c.PQMigrate.FullResearch = f
+			if c.CheckConfigForkOrder() == nil {
+				t.Fatal("changed profile accepted")
+			}
+		})
+	}
+}
+func TestPQFinalFaultIsNotRejection(t *testing.T) {
+	old := pqFinalLibrary
+	defer func() { pqFinalLibrary = old }()
+	for _, status := range []int{3, 4, -1} {
+		pqFinalLibrary.verify = func([]byte, []byte) int { return status }
+		err := verifyPQFinal(finalTestProfile(), make([]byte, 198), []byte{1})
+		if !errors.Is(err, ErrPQFullUnavailable) || errors.Is(err, ErrPQInvalidFullProof) {
+			t.Fatalf("status %d: %v", status, err)
+		}
+	}
+}
+func TestPQFinalUnavailable(t *testing.T) {
+	if _, ok := pqFinalIdentity(); ok {
+		t.Skip("separate no-pq_final build exercises absence")
+	}
+	t.Setenv("PQ_FULL_VERIFIER_PATH", "/must/not/run")
+	if err := VerifyPQFull(finalTestProfile(), make([]byte, 198), []byte{1}); !errors.Is(err, ErrPQFullUnavailable) {
+		t.Fatal(err)
+	}
+}
+func TestPQFinalRawBound(t *testing.T) {
+	u256 := new(big.Int).Sub(new(big.Int).Lsh(common.Big1, 256), common.Big1)
+	u64 := ^uint64(0)
+	m := &types.PQMigrateTx{ChainID: u256, MigrationNonce: u64, AlgID: 255, Expiry: u64, MaxAccountFee: u256, FeeMode: 255, FeeAuthUntil: u64,
+		GasTipCap: u256, GasFeeCap: u256, Gas: u64, VerifierVersion: ^uint32(0),
+		SponsorOption: &types.PQMigrationSponsor{ValidUntil: u64, Signature: make([]byte, mldsa44.SignatureSize)},
+		ProofCarrier:  types.PQMigrationCarrier{Proof: make([]byte, params.PQFinalMaxProofBytes)}}
+	raw, err := types.NewTx(m).MarshalBinary()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if uint64(len(raw)+1) != params.PQFinalMaxTxBytes {
+		t.Fatalf("raw bound: %d", len(raw)+1)
+	}
+}
+func TestPQFinalActualProof(t *testing.T) {
+	path := os.Getenv("PQ_F_PROOF")
+	if path == "" {
+		t.Skip("requires real F fixture")
+	}
+	proof, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	h, err := os.ReadFile(os.Getenv("PQ_F_PI"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	pi, err := hex.DecodeString(strings.TrimSpace(string(h)))
+	if err != nil || len(pi) != 198 {
+		t.Fatal("PI", err)
+	}
+	t.Setenv("PQ_FULL_VERIFIER_PATH", "/must/not/run")
+	t.Setenv("RISC0_DEV_MODE", "1")
+	f := finalTestProfile()
+	if err = VerifyPQFull(f, pi, proof); err != nil {
+		t.Fatal(err)
+	}
+	for i := range pi {
+		changed := bytes.Clone(pi)
+		changed[i] ^= 1
+		if err = VerifyPQFull(f, changed, proof); !errors.Is(err, ErrPQInvalidFullProof) || errors.Is(err, ErrPQFullUnavailable) {
+			t.Fatalf("PI[%d]: %v", i, err)
+		}
+	}
+	for name, p := range map[string][]byte{"trailing": append(bytes.Clone(proof), 0), "empty": {}, "truncated": proof[:len(proof)-1], "over-bound": make([]byte, params.PQFinalMaxProofBytes+1)} {
+		if err = VerifyPQFull(f, pi, p); !errors.Is(err, ErrPQInvalidFullProof) {
+			t.Fatalf("%s: %v", name, err)
+		}
+	}
+	for i := 0; i < 16; i++ {
+		p := bytes.Clone(proof)
+		p[i*(len(proof)-1)/15] ^= 1
+		if err = VerifyPQFull(f, pi, p); !errors.Is(err, ErrPQInvalidFullProof) {
+			t.Fatalf("proof flip %d: %v", i, err)
+		}
+	}
+	samples := make([]int64, 21)
+	for i := range samples {
+		start := time.Now()
+		if err = VerifyPQFull(f, pi, proof); err != nil {
+			t.Fatal(err)
+		}
+		samples[i] = time.Since(start).Nanoseconds()
+	}
+	t.Logf("real F proofBytes=%d; verifyNs=%v; charge=%d experimental, not production calibration", len(proof), samples, f.VerifyGas)
+}
