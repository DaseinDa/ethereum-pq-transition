+func TestPQAccountRPCResolutionErrors(t *testing.T) {
+	for _, name := range []string{"backend_error", "nil_state", "nil_header", "deadline_overflow"} {
+		t.Run(name, func(t *testing.T) {
+			b := pqAccountBackend(t)
+			switch name {
+			case "backend_error":
+				b.resolveError = errors.New("state is missing")
+			case "nil_state":
+				b.nilState = true
+			case "nil_header":
+				b.nilHeader = true
+			case "deadline_overflow":
+				pqAccountWrite(b.latest, b.config.PQMigrate.Registry, 1, 2, common.Hash{})
+				b.config.PQMigrate.W = math.MaxUint64
+			}
+			// Direct call also checks that no result accompanies an error. Recover
+			// here makes a baseline nil-header panic a retained test failure.
+			defer func() {
+				if r := recover(); r != nil {
+					t.Errorf("API panicked instead of returning an error: %v", r)
+				}
+			}()
+			got, err := NewBlockChainAPI(b).GetPQAccount(context.Background(), pqAccountAddress, nil)
+			if err == nil || got != nil {
+				t.Fatalf("unavailable result escaped: %v, %v", got, err)
+			}
+			if name != "deadline_overflow" && b.configReads != 0 {
+				t.Fatal("configuration was read after state/header failure")
+			}
+		})
+	}
+}
+
+type pqAccountFailingReader struct {
+	state.Reader
+	storageReads int
+	accountReads int
+	readError    error
+}
+
+func (r *pqAccountFailingReader) Account(common.Address) (*types.StateAccount, error) {
+	r.accountReads++
+	a := types.NewEmptyStateAccount()
+	a.Root = common.HexToHash("0x1234")
+	return a, nil
+}
+
+func (r *pqAccountFailingReader) Storage(common.Address, common.Hash) (common.Hash, error) {
+	r.storageReads++
+	return common.Hash{}, r.readError
+}
+
+func TestPQAccountRPCStorageErrorIsNotZeroRecord(t *testing.T) {
+	b := pqAccountBackend(t)
+	reader := &pqAccountFailingReader{readError: errors.New("missing registry trie node")}
+	s, err := state.NewWithReader(types.EmptyRootHash, state.NewDatabaseForTesting(), reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	b.latest = s
+	got, err := NewBlockChainAPI(b).GetPQAccount(context.Background(), pqAccountAddress, nil)
+	if err == nil || !errors.Is(err, reader.readError) || got != nil || reader.storageReads == 0 {
+		t.Fatalf("missing storage became a record: %v, %v, reads %d", got, err, reader.storageReads)
+	}
+	if reader.accountReads != 1 {
+		t.Fatalf("continued to read owner/code after registry failure: %d account reads", reader.accountReads)
+	}
+	// Once StateDB records the error, a subsequent call must stop before reads.
+	storageReads, accountReads := reader.storageReads, reader.accountReads
+	got, err = NewBlockChainAPI(b).GetPQAccount(context.Background(), pqAccountAddress, nil)
+	if err == nil || got != nil || reader.storageReads != storageReads || reader.accountReads != accountReads {
+		t.Fatal("errored state was used for a later answer")
+	}
+}
