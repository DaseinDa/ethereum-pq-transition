+func TestPQBatchSkippedEntriesHaveNoRegistryCharge(t *testing.T) {
+	b, s, cfg, h, sign := batchStateFixture(t)
+	// Keep the pre-state unchanged and move only the timestamp past each
+	// entry's expiry. Thus calldata, worst-case writes, and signature match.
+	// Authorization cannot outlive every entry: give the fourth entry a
+	// later expiry and compare before/after the first three expire.
+	b.Entries[3].Expiry = 2000
+	b.SponsorValidUntil = 1500
+	tx := sign(b)
+	h.Time = 150
+	full, err := validatePQBatch(tx, s.Copy(), h, cfg, false, verifyPQMigrationSignatureInBlock)
+	if err != nil {
+		t.Fatal(err)
+	}
+	h.Time = 1001
+	skipped, err := validatePQBatch(tx, s.Copy(), h, cfg, false, verifyPQMigrationSignatureInBlock)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for i := 0; i < 3; i++ {
+		if skipped.skip[i] != 0x0201 {
+			t.Fatal(skipped.skip)
+		}
+	}
+	if skipped.skip[3] != 0 || full.used-skipped.used != 3*PQRegistryFirstWriteGas {
+		t.Fatalf("skips charged registry reads: full=%d skipped=%d", full.used, skipped.used)
+	}
