+func pqL2File(t *testing.T, env, sum string) []byte {
+	t.Helper()
+	path := os.Getenv(env)
+	if path == "" {
+		t.Skipf("%s is not set: the real F carrier and its genesis are public test material in results/f-geth-20261101/network (run_tests.sh sets it)", env)
+	}
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := sha256.Sum256(raw); hex.EncodeToString(got[:]) != sum {
+		t.Fatalf("%s: sha256 %x, want %s", path, got, sum)
+	}
+	return raw
+}
+
+func pqL2Carrier(t *testing.T) *types.Transaction {
+	t.Helper()
+	tx := new(types.Transaction)
+	if err := tx.UnmarshalBinary(pqL2File(t, "PQ_L2_CARRIER", pqL2CarrierSHA)); err != nil {
+		t.Fatal(err)
+	}
+	if tx.Type() != types.PQMigrateTxType || tx.Size() != pqL2CarrierLen {
+		t.Fatalf("carrier type %d size %d", tx.Type(), tx.Size())
+	}
+	return tx
+}
