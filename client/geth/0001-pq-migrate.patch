+			b, s, cfg, h, sign := batchStateFixture(t)
+			cfg.PQMigrate.LegacySeedProofFromT0 = enabled
+			for i := range b.Entries {
+				e := &b.Entries[i]
+				e.MigrationNonce = 1 // Match the current counter; do not test stale nonce instead.
+				writePQRecord(s, cfg.PQMigrate.Registry, e.LegacyAddress, PQRecord{Mode: 2, AlgID: 1, MigrationNonce: 1, Commit: e.PQPKCommit})
+			}
+			tx := sign(b)
+			plan, err := validatePQBatch(tx, s, h, cfg, false, verifyPQMigrationSignatureInBlock)
+			if err != nil {
+				t.Fatal(err)
+			}
+			for _, skip := range plan.skip {
+				if skip != 0 {
+					t.Fatal("BY_PROOF was treated as pre-T LEGACY", skip)
+				}
+			}
+			// The independent re-commit gate requires empty code. An activated
+			// BY_PROOF marker must instead return ALREADY_MIGRATED.
+			s.SetCode(b.Entries[0].LegacyAddress, append([]byte{}, s.GetCode(b.Sponsor)...), tracing.CodeChangeUnspecified)
+			plan, err = validatePQBatch(tx, s, h, cfg, false, verifyPQMigrationSignatureInBlock)
+			if err != nil || plan.skip[0] != 0x0103 {
+				t.Fatal("activated BY_PROOF control", plan, err)
+			}
+		})
+	}
