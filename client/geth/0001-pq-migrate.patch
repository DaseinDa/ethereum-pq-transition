+//go:build cgo && pq_final
+
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package core
+
+/*
+#cgo LDFLAGS: -lpq_final_native
+#include <stdint.h>
+#include <stddef.h>
+extern int32_t pq_f_verify_v1(const uint8_t*, size_t, const uint8_t*, size_t);
+extern int32_t pq_f_ready_v1(void);
+extern const char* pq_f_identity_v1(void);
+*/
+import "C"
+import "unsafe"
+
+func pqFinalIdentity() (string, bool) {
+	p := C.pq_f_identity_v1()
+	if p == nil {
+		return "", false
+	}
+	return C.GoString(p), true
+}
+func pqFinalReady() int { return int(C.pq_f_ready_v1()) }
+func pqFinalVerify(proof, pi []byte) int {
+	if len(proof) == 0 || len(pi) != 198 {
+		return 1
+	}
+	return int(C.pq_f_verify_v1((*C.uint8_t)(unsafe.Pointer(&proof[0])), C.size_t(len(proof)), (*C.uint8_t)(unsafe.Pointer(&pi[0])), C.size_t(len(pi))))
+}
