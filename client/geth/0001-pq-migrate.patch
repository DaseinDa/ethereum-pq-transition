@@ -0,0 +1,28 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package legacypool
+
+import (
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/crypto"
+	"github.com/ethereum/go-ethereum/params"
+)
+
+// Cache only a successful pure signature evaluation. Every call site first
+// re-reads the current marker/commitment. Key, domain, digest and signature bytes
+// are hashed by value, so neither transaction identity nor pointer immutability
+// is an assumption. The fixed-capacity cache does not affect block verification.
+func (pool *LegacyPool) verifyPQSignature(c *params.ChainConfig, h *types.Header, pk []byte, tag string, digest common.Hash, sig []byte) bool {
+	epoch := "FIPS204-pure-ML-DSA-44/" + c.LatestFork(h.Time).String()
+	key := crypto.Keccak256Hash([]byte(epoch), []byte{0}, crypto.Keccak256(pk), []byte{byte(len(tag))}, []byte(tag), digest[:], sig)
+	if _, ok := pool.pqSignatures.Get(key); ok {
+		return true
+	}
+	if !pool.pqSignatureCheck(c, h, pk, tag, digest, sig) {
+		return false
+	}
+	pool.pqSignatures.Add(key, struct{}{})
+	return true
+}
