+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package rawdb
+
+import (
+	"errors"
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/ethdb"
+	"github.com/ethereum/go-ethereum/ethdb/memorydb"
+	"math/big"
+	"strings"
+	"testing"
+)
+
+func pqSparseKV() *memorydb.Database {
+	db := memorydb.New()
+	WriteCanonicalHash(db, common.HexToHash("01"), 0)
+	h := &types.Header{Number: big.NewInt(22974577)}
+	WriteHeader(db, h)
+	WriteCanonicalHash(db, h.Hash(), 22974577)
+	WriteHeadHeaderHash(db, h.Hash())
+	return db
+}
+func TestPQBridgeFreezerOrdinarySparseDatabaseStillRejected(t *testing.T) {
+	kv := pqSparseKV()
+	defer kv.Close()
+	db, err := Open(kv, OpenOptions{})
+	if err == nil {
+		db.Close()
+		t.Fatal("ordinary sparse history bypassed freezer guard")
+	}
+	if !strings.Contains(err.Error(), "ancient chain segments already extracted") {
+		t.Fatalf("unexpected error: %v", err)
+	}
+}
+func TestPQBridgeFreezerRequiresSuccessfulIdentityCallback(t *testing.T) {
+	for _, allow := range []bool{false, true} {
+		kv := pqSparseKV()
+		calls := 0
+		sentinel := errors.New("identity mismatch")
+		db, err := Open(kv, OpenOptions{ValidateWithoutFreezer: func(ethdb.KeyValueStore) error {
+			calls++
+			if !allow {
+				return sentinel
+			}
+			return nil
+		}})
+		if calls != 1 {
+			t.Fatalf("callback calls %d", calls)
+		}
+		if !allow {
+			if !errors.Is(err, sentinel) {
+				t.Fatalf("identity error lost: %v", err)
+			}
+			kv.Close()
+			continue
+		}
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, err = db.Ancients(); err == nil {
+			t.Fatal("no-freezer wrapper falsely reports ancient completeness")
+		}
+		if ReadCanonicalHash(db, 1) != (common.Hash{}) {
+			t.Fatal("bridge created fake historical block1")
+		}
+		db.Close()
+	}
+}
+func TestPQBridgeFreezerDoesNotHideGenuineAncients(t *testing.T) {
+	dir := t.TempDir()
+	f, err := newChainFreezer(resolveChainFreezerDir(dir), "", "", false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = f.ModifyAncients(func(op ethdb.AncientWriteOp) error {
+		for name := range chainFreezerTableConfigs {
+			if err := op.AppendRaw(name, 0, []byte{1}); err != nil {
+				return err
+			}
+		}
+		return nil
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if err = f.Close(); err != nil {
+		t.Fatal(err)
+	}
+	kv := pqSparseKV()
+	defer kv.Close()
+	called := false
+	db, err := Open(kv, OpenOptions{Ancient: dir, ValidateWithoutFreezer: func(ethdb.KeyValueStore) error { called = true; return nil }})
+	if err == nil {
+		db.Close()
+		t.Fatal("bridge hid genuine ancient data")
+	}
+	if called || !strings.Contains(err.Error(), "nonempty ancient history") {
+		t.Fatalf("wrong rejection: called=%v err=%v", called, err)
+	}
+}
