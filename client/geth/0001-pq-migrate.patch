+func TestPQPoolBudgetUsesLocalMonotonicTime(t *testing.T) {
+	p, _, _ := componentPool(t)
+	p.cfg.VerificationBurst = 1
+	p.verifyStart = time.Now() // retains Go's monotonic component
+	if err := p.verificationBudget(); err != nil {
+		t.Fatal(err)
+	}
+	p.head.Time = math.MaxUint64 - 100
+	if err := p.verificationBudget(); !errors.Is(err, txpool.ErrPQBusy) {
+		t.Fatal("chain time reset local verifier budget", err)
+	}
+	p.verifyStart = p.verifyStart.Add(-p.cfg.VerificationWindow)
+	if err := p.verificationBudget(); err != nil {
+		t.Fatal("elapsed local interval did not refill", err)
+	}
+}
