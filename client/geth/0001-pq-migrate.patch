+// Replay the unchanged public C statement against explicit parent-state fixtures.
+// These are execution tests, not claims about a live account's prior history.
+func TestPQBatchRealNativeEntryGates(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		code   uint16
+		writes uint64
+	}{
+		{"native", 0x0103, 0},
+		{"contract", 0x0102, 0},
+		{"closed-override", 0x0104, 0},
+		{"open-override", 0, 10000},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			tx, s, evm, h := batchFixture(t)
+			b, _ := tx.AsPQBatch()
+			cfg := evm.ChainConfig().PQMigrate
+			e := b.Entries[0]
+			old := PQRecord{}
+			var oldCode []byte
+			switch tc.name {
+			case "native":
+				pk := pqtest.SponsorPublicKey()
+				old = PQRecord{Mode: 3, AlgID: 1, MigrationNonce: 1, Commit: PQKeyCommit(1, pk)}
+				oldCode = append([]byte{0xef, 1, 1}, pk...)
+			case "contract":
+				oldCode = []byte{0x60, 0}
+			case "closed-override", "open-override":
+				// The fixed C statement has nonce 0, while actual 0x7d enrollment
+				// increments it to 1. This constructed nonce-0 prestate checks
+				// native acceptance/settlement, not a reachable on-chain override.
+				old = PQRecord{Mode: 1, AlgID: 1, EnrolledAt: h.Time - 100, Commit: common.Hash{99}}
+				cfg.W = 50 // h.Time is exactly max(enrolledAt,T)+W.
+				if tc.name == "open-override" {
+					cfg.W = 100
+				}
+			}
+			writePQRecord(s, cfg.Registry, e.LegacyAddress, old)
+			s.SetCode(e.LegacyAddress, oldCode, tracing.CodeChangeUnspecified)
+			beforeSponsor := new(uint256.Int).Set(s.GetBalance(b.Sponsor))
+			s.SetTxContext(tx.Hash(), 0, 1)
+			result, err := ApplyMessage(evm, &Message{PQTransaction: tx, GasLimit: b.Gas}, NewGasPool(h.GasLimit))
+			if err != nil {
+				t.Fatal(err)
+			}
+			wantGas := batchExpectedGas(t, b, 3*44200+tc.writes)
+			if result.UsedGas != wantGas || s.GetNonce(b.Sponsor) != b.SponsorNonce+1 {
+				t.Fatal("native gate gas or sponsor nonce", result.UsedGas, wantGas)
+			}
+			price := new(big.Int).Add(h.BaseFee, b.GasTipCap)
+			charge := new(uint256.Int).Mul(uint256.NewInt(wantGas), uint256.MustFromBig(price))
+			if new(uint256.Int).Sub(beforeSponsor, s.GetBalance(b.Sponsor)).Cmp(charge) != 0 {
+				t.Fatal("native gate sponsor charge")
+			}
+			tip := new(uint256.Int).Mul(uint256.NewInt(wantGas), uint256.MustFromBig(b.GasTipCap))
+			if s.GetBalance(h.Coinbase).Cmp(tip) != 0 {
+				t.Fatal("native gate coinbase tip")
+			}
+			logs := s.GetLogs(tx.Hash(), h.Number.Uint64(), common.Hash{}, h.Time)
+			if len(logs) != 4 {
+				t.Fatal("native gate receipt log count", len(logs))
+			}
+			for i, entry := range b.Entries {
+				code, enrolledAt := uint16(0), uint64(0)
+				if i == 0 {
+					code, enrolledAt = tc.code, old.EnrolledAt
+				}
+				assertBatchLog(t, logs[i], cfg.Registry, entry, i, code, 1, i == 0 && tc.name == "open-override", false)
+				wantRecord := PQRecord{Mode: 2, AlgID: entry.AlgID, EnrolledAt: enrolledAt, MigrationNonce: 1, Commit: entry.PQPKCommit}
+				if code != 0 {
+					wantRecord = old
+					if string(s.GetCode(entry.LegacyAddress)) != string(oldCode) {
+						t.Fatal("skip changed code")
+					}
+				} else if len(s.GetCode(entry.LegacyAddress)) != 0 {
+					t.Fatal("applied entry retained code")
+				}
+				if ReadPQRecord(s, cfg.Registry, entry.LegacyAddress) != wantRecord || s.GetNonce(entry.LegacyAddress) != 9 || s.GetBalance(entry.LegacyAddress).Uint64() != 2_000_000_000_000_000_000 {
+					t.Fatal("native gate owner record, nonce or mode2 balance", i)
+				}
+			}
+		})
+	}
