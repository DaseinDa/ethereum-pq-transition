@@ -0,0 +1,72 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package legacypool
+
+import (
+	"errors"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core"
+	"github.com/ethereum/go-ethereum/core/txpool"
+	"github.com/ethereum/go-ethereum/core/types"
+)
+
+// evictPQLegacy rechecks held authority after the canonical head/state reset,
+// before promotion or reinjection. R1 invalidates ECDSA transactions; an override
+// or rotation can invalidate an already admitted PQ transaction without consuming
+// its account nonce. pool.mu is held. No migration proof is verified here.
+func (pool *LegacyPool) evictPQLegacy() {
+	cfg := pool.chainconfig.PQMigrate
+	if cfg == nil {
+		return
+	}
+	now := txpool.PQPoolTime(pool.currentHead.Load(), pool.chainconfig)
+	header := types.CopyHeader(pool.currentHead.Load())
+	header.Time = now
+	state := pool.currentState
+	dead := make(map[common.Address]bool)
+	var hashes []common.Hash
+	pool.all.Range(func(hash common.Hash, tx *types.Transaction) bool {
+		if tx.Type() == types.PQTxType {
+			// Economic conditions do not revoke authority. The shared key selector
+			// rechecks marker/commitment and the bounded pool signature cache handles
+			// unchanged keys. A local state failure is not evidence of lost authority.
+			err := core.ValidatePQHeldTransactionAuthority(state, pool.chainconfig, header, tx, pool.verifyPQSignature)
+			if err != nil && state.Error() == nil && !errors.Is(err, core.ErrPQStateUnavailable) {
+				hashes = append(hashes, hash)
+			}
+			return true
+		}
+		if now < cfg.T0 {
+			return true
+		}
+		// Enrollment still uses old ECDSA authority and expires at T.
+		// Freeze requires no state read after T.
+		reject := now >= cfg.T
+		if !reject {
+			sender, err := types.Sender(pool.signer, tx)
+			if err != nil {
+				return true
+			} // insertion already authenticated every sender
+			var seen bool
+			reject, seen = dead[sender]
+			if !seen {
+				reject = core.PQECDSADead(state, cfg, sender, now)
+				dead[sender] = reject
+			}
+		}
+		if reject {
+			hashes = append(hashes, hash)
+		}
+		return true
+	})
+	// A failed registry read is not evidence that an account lost authority.
+	// Leave local state-fault handling to the existing pool/build paths.
+	if now < cfg.T && state.Error() != nil {
+		return
+	}
+	for _, hash := range hashes {
+		pool.removeTx(hash, true, true)
+	}
+}
