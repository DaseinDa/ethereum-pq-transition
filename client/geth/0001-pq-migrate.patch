+	}
+	if p.activate {
+		if p.native {
+			writePQRecord(st.state, cfg.Registry, a, p.record)
+		}
+		marker := append([]byte{0xef, 1, 1}, p.publicKey...)
+		st.state.SetCode(a, marker, tracing.CodeChangeUnspecified)
+		st.state.AddLog(&types.Log{Address: cfg.Registry, Topics: []common.Hash{crypto.Keccak256Hash([]byte("Activated(address)")), common.BytesToHash(a[:])}})
+	}
+	return false
+}
+
+// Silence accidental wire-independent key comparisons: marker content and commitment
+// are both checked above; bytes.Equal is also used by the test-visible helper.
+func PQMarkerMatches(b, pk []byte) bool { return bytes.Equal(b, append([]byte{0xef, 1, 1}, pk...)) }
