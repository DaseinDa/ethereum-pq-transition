+func TestPQBatchReimbursementBalanceDeadlineAndRecipient(t *testing.T) {
+	for _, tc := range []struct {
+		name                            string
+		balance, expected               uint64
+		expired, ownerRecipient, absent bool
+	}{
+		{"above-cap-at-deadline", 150, 100, false, false, false},
+		{"equal-cap", 100, 100, false, false, false},
+		{"below-cap", 40, 40, false, false, false},
+		{"zero", 0, 0, false, false, false},
+		{"deadline-plus-one", 150, 0, true, false, false},
+		{"owner-is-fee-recipient", 150, 100, false, true, false},
+		{"absent-owner", 0, 0, false, false, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			b, s, cfg, h, sign := batchStateFixture(t)
+			e := &b.Entries[0]
+			e.FeeMode, e.MaxAccountFee, e.FeeAuthUntil = 3, big.NewInt(100), h.Time
+			if tc.expired {
+				e.FeeAuthUntil--
+			}
+			if !tc.absent {
+				s.SetBalance(e.LegacyAddress, uint256.NewInt(tc.balance), tracing.BalanceChangeUnspecified)
+			}
+			if tc.absent && s.Exist(e.LegacyAddress) {
+				t.Fatal("owner fixture already exists")
+			}
+			h.Coinbase = common.Address{90}
+			if tc.ownerRecipient {
+				h.Coinbase = e.LegacyAddress
+			}
+			tx := sign(b)
+			plan, err := validatePQBatch(tx, s, h, cfg, false, verifyPQMigrationSignatureInBlock)
+			if err != nil {
+				t.Fatal(err)
+			}
+			wantGas := batchExpectedGas(t, b, 4*44200)
+			if plan.used != wantGas {
+				t.Fatal("independent gas formula", plan.used, wantGas)
+			}
+			before := new(uint256.Int).Set(s.GetBalance(b.Sponsor))
+			s.SetTxContext(tx.Hash(), 0, 1)
+			var legacyZeroTransfer *state.StateDB
+			if tc.absent {
+				legacyZeroTransfer = s.Copy()
+				// Replay the former zero reimbursement operations on an identical
+				// pre-state, then execute the same migration/settlement. A zero
+				// transfer commutes with the sponsor's gas debit.
+				legacyZeroTransfer.SubBalance(e.LegacyAddress, new(uint256.Int), tracing.BalanceChangeTransfer)
+				legacyZeroTransfer.AddBalance(b.Sponsor, new(uint256.Int), tracing.BalanceChangeTransfer)
+				applyPQBatchPlan(legacyZeroTransfer, tx, h, cfg.PQMigrate, plan)
+			}
+			applyPQBatchPlan(s, tx, h, cfg.PQMigrate, plan)
+			ownerWant := tc.balance - tc.expected
+			if tc.ownerRecipient {
+				ownerWant += wantGas
+			}
+			if s.GetBalance(e.LegacyAddress).Uint64() != ownerWant {
+				t.Fatal("owner balance", s.GetBalance(e.LegacyAddress), ownerWant)
+			}
+			want := new(uint256.Int).Sub(before, uint256.NewInt(2*wantGas))
+			want.Add(want, uint256.NewInt(tc.expected))
+			if s.GetBalance(b.Sponsor).Cmp(want) != 0 {
+				t.Fatal("sponsor balance")
+			}
+			if !tc.ownerRecipient && s.GetBalance(h.Coinbase).Uint64() != wantGas {
+				t.Fatal("coinbase reward")
+			}
+			logs := s.GetLogs(tx.Hash(), h.Number.Uint64(), common.Hash{}, h.Time)
+			if len(logs) != 4 {
+				t.Fatal("applied fee case skipped", len(logs))
+			}
+			for i, entry := range b.Entries {
+				assertBatchLog(t, logs[i], cfg.PQMigrate.Registry, entry, i, 0, 1, false, false)
+			}
+			s.Finalise(true)
+			if tc.absent {
+				legacyZeroTransfer.Finalise(true)
+				if s.Exist(e.LegacyAddress) || legacyZeroTransfer.Exist(e.LegacyAddress) {
+					t.Fatal("absent owner survived empty-account finalization")
+				}
+				if current, legacy := s.IntermediateRoot(true), legacyZeroTransfer.IntermediateRoot(true); current != legacy {
+					t.Fatal("omitting zero reimbursement changed final state root", current, legacy)
+				}
+			}
+		})
+	}
+}
