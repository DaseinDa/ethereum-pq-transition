+type pqAuthorityReadRecorder struct {
+	vm.StateDB
+	reads []common.Hash
+}
+
+func (r *pqAuthorityReadRecorder) GetState(a common.Address, k common.Hash) common.Hash {
+	r.reads = append(r.reads, k)
+	return r.StateDB.GetState(a, k)
+}
+func TestPQClientAuthoritySlotScope(t *testing.T) {
+	s, evm, _ := pqEnv(t, common.HexToAddress("900"), nil)
+	cfg := *evm.ChainConfig().PQMigrate
+	cfg.T0 = 100
+	cfg.T = 200
+	k, k1 := PQRecordSlots(pqSender)
+	r := &pqAuthorityReadRecorder{StateDB: s}
+	if PQECDSADead(r, &cfg, pqSender, 99) || len(r.reads) != 0 {
+		t.Fatal("preT0 authority read")
+	}
+	if !PQECDSADead(r, &cfg, pqSender, 200) || len(r.reads) != 0 {
+		t.Fatal("postT authority read")
+	}
+	s.SetState(cfg.Registry, k1, common.Hash{31: 1}) // Unused commit must not affect the mode-only gate.
+	if PQECDSADead(r, &cfg, pqSender, 100) || len(r.reads) != 1 || r.reads[0] != k {
+		t.Fatalf("R1/R2 read scope: %v", r.reads)
+	}
+	s.SetState(cfg.Registry, k, common.Hash{31: 1})
+	r.reads = nil
+	if !PQECDSADead(r, &cfg, pqSender, 100) || len(r.reads) != 1 || r.reads[0] != k {
+		t.Fatalf("retired read scope: %v", r.reads)
+	}
+	// This checks the gas formula's zero-output branch; it does not claim to have
+	// generated a public key whose Keccak commitment is zero.
+	if pqFirstRegistryWriteGas(common.Hash{}) != 24300 || pqFirstRegistryWriteGas(common.Hash{31: 1}) != 44200 {
+		t.Fatal("first-write per-slot gas")
+	}
+}
