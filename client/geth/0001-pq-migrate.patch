+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package pqpool
+
+import (
+	"context"
+	"math/big"
+	"testing"
+
+	"github.com/cloudflare/circl/sign/mldsa/mldsa44"
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core"
+	"github.com/ethereum/go-ethereum/core/tracing"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/core/vm"
+	"github.com/ethereum/go-ethereum/crypto"
+	"github.com/ethereum/go-ethereum/params"
+	"github.com/holiman/uint256"
+)
+
+// An actual ECDSA-authorized 0x7d wins the pre-T race. The first case
+// uses the unchanged real mode0 F fixture. The sponsored policy case uses the
+// component fixture's explicit state/proof hooks, never claiming a native proof.
+func TestPQPoolPreTEnrollmentPrunesPendingProof(t *testing.T) {
+	for _, sponsored := range []bool{false, true} {
+		name := "real-F-mode0"
+		if sponsored {
+			name = "sponsored-policy-component"
+		}
+		t.Run(name, func(t *testing.T) {
+			// Public BIP39 fixture, m/44'/60'/0'/0/0 (abandon x11 + about).
+			key, err := crypto.HexToECDSA("1ab42cc412b618bdea3a599e3c9bae199ebf030895b039e9db1e30dafb12b727")
+			if err != nil {
+				t.Fatal(err)
+			}
+			owner := crypto.PubkeyToAddress(key.PublicKey)
+			var p *Pool
+			var chain *componentChain
+			var tx *types.Transaction
+			var now uint64
+			if sponsored {
+				p, chain, _ = componentPool(t)
+				chain.cfg.AmsterdamTime, chain.cfg.BogotaTime, chain.cfg.UBTTime = nil, nil, nil
+				chain.cfg.PQMigrate.LegacySeedProofFromT0 = true
+				chain.s.SetBalance(owner, uint256.NewInt(2000000000000000000), tracing.BalanceChangeUnspecified)
+				p.state = chain.s.Copy()
+				tx = changed(componentTx(1, 20, 2, 20), func(m *types.PQMigrateTx) { m.LegacyAddress = owner })
+				now = 1012
+			} else {
+				p, chain, tx, now = currentFPool(t, 0)
+			}
+			m, _ := tx.AsPQMigrate()
+			cfg := chain.cfg
+			cfg.PQMigrate.T = now + 3600
+			if m.LegacyAddress != owner || m.MigrationNonce != 0 {
+				t.Fatal("test requires initial public F owner")
+			}
+
+			calls := 0
+			realProof := p.checkProof
+			p.checkProof = func(tx *types.Transaction, c *params.ChainConfig, version string) error {
+				calls++
+				return realProof(tx, c, version)
+			}
+			if err := add(p, tx); err != nil {
+				t.Fatal(err)
+			}
+			if calls != 1 {
+				t.Fatalf("admission F verifications=%d", calls)
+			}
+			before := *p.sources["rpc:component"]
+			seed := [mldsa44.SeedSize]byte{0xa6}
+			pk, sk := mldsa44.NewKeyFromSeed(&seed)
+			en := &types.PQEnrollTx{ChainID: cfg.ChainID, Nonce: chain.s.GetNonce(owner), GasTipCap: big.NewInt(params.GWei), GasFeeCap: big.NewInt(2 * params.GWei), Gas: 1000000, AlgID: 1, PublicKey: pk.Bytes(), PoPSignature: make([]byte, mldsa44.SignatureSize)}
+			digest := core.PQEnrollmentDigest(cfg.ChainID, owner, en.Nonce, 1, en.PublicKey)
+			tag := []byte("ETH-PQ-ENROLL-POP/v1")
+			if err := mldsa44.SignTo(sk, append(append([]byte{}, tag...), digest[:]...), tag, false, en.PoPSignature); err != nil {
+				t.Fatal(err)
+			}
+			digest = en.SigningHash()
+			sig, err := crypto.Sign(digest[:], key)
+			if err != nil {
+				t.Fatal(err)
+			}
+			en.R, en.S, en.V = new(big.Int).SetBytes(sig[:32]), new(big.Int).SetBytes(sig[32:64]), new(big.Int).SetUint64(uint64(sig[64]))
+			enroll := types.NewTx(en)
+			head := types.CopyHeader(p.head)
+			head.Time = now
+			head.Number = big.NewInt(1)
+			random := common.Hash{}
+			evm := vm.NewEVM(vm.BlockContext{CanTransfer: core.CanTransfer, Transfer: core.Transfer, GetHash: func(uint64) common.Hash { return common.Hash{} }, BlockNumber: head.Number, Time: head.Time, BaseFee: head.BaseFee, GasLimit: head.GasLimit, Difficulty: head.Difficulty, Random: &random}, chain.s, cfg, vm.Config{})
+			defer evm.Release()
+			chain.s.SetTxContext(enroll.Hash(), 0, 0)
+			receipt, _, err := core.ApplyTransaction(context.Background(), evm, core.NewGasPool(head.GasLimit), chain.s, head, enroll)
+			if err != nil || receipt.Status != types.ReceiptStatusSuccessful {
+				t.Fatalf("attacker enrollment transition: %v", err)
+			}
+			r := core.ReadPQRecord(chain.s, cfg.PQMigrate.Registry, owner)
+			if r.Mode != 1 || r.MigrationNonce != 1 {
+				t.Fatalf("enrollment record: %+v", r)
+			}
+			// A simultaneous sponsor lapse must not turn a stale owner into a ban.
+			if sponsor := m.Sponsor(); sponsor != nil {
+				chain.s.SetCode(sponsor.Sponsor, nil, tracing.CodeChangeUnspecified)
+			}
+			p.Reset(nil, head)
+			if p.Has(tx.Hash()) || len(p.bans) != 0 || calls != 1 {
+				t.Fatalf("stale proof retained, sponsor banned or proof rerun: held=%t bans=%d calls=%d", p.Has(tx.Hash()), len(p.bans), calls)
+			}
+			if after := *p.sources["rpc:component"]; after != before {
+				t.Fatalf("stale pruning charged source: before=%+v after=%+v", before, after)
+			}
+
+		})
+	}
+}
diff --git a/core/txpool/pqpool/pq_reset.go b/core/txpool/pqpool/pq_reset.go
new file mode 100644
index 0000000000000000000000000000000000000000..ac143bbddf357f5c868547727c3fe2a61dea888d
--- /dev/null
+++ b/core/txpool/pqpool/pq_reset.go
@@ -0,0 +1,98 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package pqpool
+
+import (
+	"fmt"
+
+	"github.com/ethereum/go-ethereum/core"
+	"github.com/ethereum/go-ethereum/core/txpool"
+	"github.com/ethereum/go-ethereum/core/types"
+)
+
+// pruneReset removes obligations that do not survive this head before any
+// sponsor cumulative-balance check. These passes do no signature or proof work.
+// In particular, an included/stale obligation cannot cause its sponsor's ban.
+// p.mu is held, and h uses the pool's next-slot clock.
+func (p *Pool) pruneReset(h *types.Header) {
+	c := p.chain.Config()
+	// Staleness is a property of the owner gate and migration nonce, not of
+	// sponsor authorization. Complete this pass over all entries first, even
+	// when a lower-tip stale entry would otherwise be visited after a survivor.
+	for _, e := range p.sorted() {
+		attempt := p.state.Copy()
+		err := core.ValidatePQMigrateOwnerState(e.template, attempt, h, c)
+		if attempt.Error() != nil {
+			p.deferResetEntry(e, fmt.Errorf("%w: %v", ErrLocalUnavailable, attempt.Error()))
+		} else if retryable(err) {
+			p.deferResetEntry(e, err)
+		} else if err != nil {
+			p.remove(e.hash, "stale owner: "+err.Error())
+		}
+	}
+
+	slot := txpool.PQPoolSlot(c)
+	overflow := h.Time > ^uint64(0)-slot
+	margin := h.Time + slot
+	// A sponsor that lost activation is still a sponsor-caused eviction, even
+	// if this entry also fails a later condition. Otherwise its own expiry,
+	// version/time checks and fee floor win without a ban (spec section 27.6).
+	for _, e := range p.sorted() {
+		if p.entries[e.hash] == nil {
+			continue
+		}
+		m := e.template
+		if sponsor := m.Sponsor(); sponsor != nil {
+			attempt := p.state.Copy()
+			activated := core.PQActivated(attempt, c.PQMigrate, sponsor.Sponsor)
+			if attempt.Error() != nil {
+				p.deferResetEntry(e, fmt.Errorf("%w: %v", ErrLocalUnavailable, attempt.Error()))
+				continue
+			}
+			if !activated {
+				p.banSponsor(sponsor.Sponsor, "sponsor no longer activated")
+				continue
+			}
+		}
+		if overflow || m.Expiry < margin {
+			p.remove(e.hash, "proof near expiry")
+			continue
+		}
+		f := c.PQMigrate.FullResearch
+		if f == nil || m.VerifierVersion != f.Version || m.ProofCarrier.Route != 0 || h.Time < f.Activation || h.Time >= f.Sunset {
+			p.remove(e.hash, "WRONG_VERIFIER_VERSION")
+			continue
+		}
+		// The expiry lower bound above makes this subtraction safe. A head
+		// rollback can invalidate the upper bound of an already admitted proof.
+		if m.Expiry-h.Time > f.ProofLifetime {
+			p.remove(e.hash, "EXPIRY_TOO_FAR")
+			continue
+		}
+		if m.GasTipCap.Cmp(p.minTip) < 0 || h.BaseFee != nil && m.GasFeeCap.Cmp(h.BaseFee) < 0 {
+			p.remove(e.hash, txpool.ErrUnderpriced.Error())
+		}
+	}
+	// Only still-live obligations can establish authorization lapse. Equality
+	// at now+SLOT survives; expiry of both the proof and authorization starts no
+	// ban. All such removals precede the cumulative-balance pass in Reset.
+	for _, e := range p.sorted() {
+		if p.entries[e.hash] == nil {
+			continue
+		}
+		if sponsor := e.template.Sponsor(); sponsor != nil && sponsor.ValidUntil < margin {
+			p.banSponsor(sponsor.Sponsor, "sponsor authorization near expiry")
+		}
+	}
+}
+
+func (p *Pool) deferResetEntry(e *entry, err error) {
+	tx := p.resolve(e)
+	if tx == nil {
+		p.remove(e.hash, "local body unavailable; not INVALID_PROOF")
+		return
+	}
+	p.remove(e.hash, "state unavailable; deferred")
+	p.deferTx(tx, e.source, err)
+}
diff --git a/core/txpool/pqpool/pq_reset_sponsor_test.go b/core/txpool/pqpool/pq_reset_sponsor_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..ef4a8604d9dd9bd3b210f32ac28c444bd47d7ec9
--- /dev/null
+++ b/core/txpool/pqpool/pq_reset_sponsor_test.go
@@ -0,0 +1,187 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package pqpool
+
+import (
+	"encoding/binary"
+	"errors"
+	"math/big"
+	"testing"
+	"time"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core"
+	"github.com/ethereum/go-ethereum/core/tracing"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/holiman/uint256"
+)
+
+// These are pool-policy component regressions. They use the production owner
+// gate and sponsor activation predicate, and the component fixture's explicit
+// state/proof hooks for the remaining checks; no real Full proof is claimed.
+func resetSponsorHead(p *Pool, timestamp uint64) *types.Header {
+	h := types.CopyHeader(p.head)
+	h.Time = timestamp
+	return h
+}
+
+func resetOwnerRecord(c *componentChain, owner common.Address, mode byte, nonce uint64) {
+	slot, _ := core.PQRecordSlots(owner)
+	word := common.Hash{}
+	word[31], word[30] = mode, 1
+	binary.BigEndian.PutUint64(word[14:22], nonce)
+	c.s.SetState(c.cfg.PQMigrate.Registry, slot, word)
+}
+
+func TestPQPoolResetStaleBeforeSponsorLapseAndLiability(t *testing.T) {
+	p, chain, calls := componentPool(t)
+	stale := changed(componentTx(1, 20, 2, 20), func(m *types.PQMigrateTx) { m.SponsorOption.ValidUntil = 1132 })
+	live := componentTx(2, 20, 3, 20) // Visits first by tip; stale must already be gone.
+	for _, tx := range []*types.Transaction{stale, live} {
+		if err := add(p, tx); err != nil {
+			t.Fatal(err)
+		}
+	}
+	resetOwnerRecord(chain, addr(1), 2, 1) // The canonical inclusion advanced only migration_nonce.
+	chain.s.SetBalance(addr(20), uint256.NewInt(2000), tracing.BalanceChangeUnspecified)
+	p.Reset(nil, resetSponsorHead(p, 1121)) // now=1133; stale authorization is already expired.
+	if p.Has(stale.Hash()) || !p.Has(live.Hash()) || len(p.bans) != 0 {
+		t.Fatal("included obligation banned its sponsor or counted against the surviving recovery")
+	}
+	if *calls != 2 || p.sources["rpc:component"].failures != 0 {
+		t.Fatal("stale pruning verified a proof or charged the source")
+	}
+}
+
+func TestPQPoolResetStaleOwnerBeforeSponsorActivation(t *testing.T) {
+	for _, cause := range []string{"migration-nonce", "owner-gate"} {
+		t.Run(cause, func(t *testing.T) {
+			p, chain, calls := componentPool(t)
+			resetOwnerRecord(chain, addr(1), 2, 1)
+			p.state = chain.s.Copy()
+			tx := changed(componentTx(1, 20, 2, 20), func(m *types.PQMigrateTx) { m.MigrationNonce = 1 })
+			if err := add(p, tx); err != nil {
+				t.Fatal(err)
+			}
+			if cause == "migration-nonce" {
+				resetOwnerRecord(chain, addr(1), 2, 2)
+			} else {
+				// Activation closes re-commit eligibility without advancing the migration nonce.
+				chain.s.SetCode(addr(1), common.CopyBytes(chain.s.GetCode(addr(20))), tracing.CodeChangeUnspecified)
+			}
+			chain.s.SetCode(addr(20), nil, tracing.CodeChangeUnspecified)
+			p.Reset(nil, p.head)
+			if p.Has(tx.Hash()) || len(p.bans) != 0 || *calls != 1 {
+				t.Fatal("stale owner obligation caused a sponsor-activation ban or Full check")
+			}
+		})
+	}
+}
+
+func TestPQPoolResetProofExpiryDoesNotBanActiveSponsor(t *testing.T) {
+	for _, timestamp := range []uint64{1109, 1121} { // Both within margin; second also past both expiries.
+		t.Run(new(big.Int).SetUint64(timestamp).String(), func(t *testing.T) {
+			p, chain, calls := componentPool(t)
+			expired := changed(componentTx(1, 20, 2, 20), func(m *types.PQMigrateTx) { m.Expiry = 1132; m.SponsorOption.ValidUntil = 1132 })
+			live := componentTx(2, 20, 3, 20)
+			for _, tx := range []*types.Transaction{expired, live} {
+				if err := add(p, tx); err != nil {
+					t.Fatal(err)
+				}
+			}
+			chain.s.SetBalance(addr(20), uint256.NewInt(2000), tracing.BalanceChangeUnspecified)
+			p.Reset(nil, resetSponsorHead(p, timestamp))
+			if p.Has(expired.Hash()) || !p.Has(live.Hash()) || len(p.bans) != 0 || *calls != 2 {
+				t.Fatal("own-expired obligation caused a lapse/liability ban or Full check")
+			}
+		})
+	}
+}
+
+func TestPQPoolResetSponsorMarginInclusive(t *testing.T) {
+	p, _, calls := componentPool(t)
+	tx := changed(componentTx(1, 20, 2, 20), func(m *types.PQMigrateTx) { m.SponsorOption.ValidUntil = 1132 })
+	if err := add(p, tx); err != nil {
+		t.Fatal(err)
+	}
+	p.Reset(nil, resetSponsorHead(p, 1108)) // now+SLOT=1132: inclusive boundary.
+	if !p.Has(tx.Hash()) || len(p.bans) != 0 || *calls != 1 {
+		t.Fatal("authorization at the reset margin did not survive")
+	}
+	p.Reset(nil, resetSponsorHead(p, 1109)) // now+SLOT=1133, before proof expiry.
+	if p.Has(tx.Hash()) || !time.Now().Before(p.bans[addr(20)]) || *calls != 1 {
+		t.Fatal("live obligation below the authorization margin did not ban sponsor")
+	}
+}
+
+func TestPQPoolResetInactiveSponsorPrecedesProofExpiry(t *testing.T) {
+	p, chain, calls := componentPool(t)
+	tx := changed(componentTx(1, 20, 2, 20), func(m *types.PQMigrateTx) { m.Expiry = 1132; m.SponsorOption.ValidUntil = 1132 })
+	if err := add(p, tx); err != nil {
+		t.Fatal(err)
+	}
+	chain.s.SetCode(addr(20), nil, tracing.CodeChangeUnspecified)
+	p.Reset(nil, resetSponsorHead(p, 1121))
+	if p.Has(tx.Hash()) || !time.Now().Before(p.bans[addr(20)]) || *calls != 1 {
+		t.Fatal("sponsor activation must precede own expiry after stale-owner pruning")
+	}
+}
+
+func TestPQPoolResetNonSponsorDropsBeforeCumulativeBalance(t *testing.T) {
+	for _, cause := range []string{"fee-floor", "expiry-upper-bound"} {
+		t.Run(cause, func(t *testing.T) {
+			p, chain, calls := componentPool(t)
+			dropped := componentTx(1, 20, 1, 2)
+			if cause == "expiry-upper-bound" {
+				dropped = changed(dropped, func(m *types.PQMigrateTx) { m.Expiry = 1012 + chain.cfg.PQMigrate.FullResearch.ProofLifetime })
+			}
+			live := componentTx(2, 20, 3, 20)
+			for _, tx := range []*types.Transaction{dropped, live} {
+				if err := add(p, tx); err != nil {
+					t.Fatal(err)
+				}
+			}
+			chain.s.SetBalance(addr(20), uint256.NewInt(2000), tracing.BalanceChangeUnspecified)
+			h := resetSponsorHead(p, 1000)
+			if cause == "fee-floor" {
+				h.BaseFee = big.NewInt(10)
+			} else {
+				h.Time--
+			}
+			p.Reset(nil, h)
+			if p.Has(dropped.Hash()) || !p.Has(live.Hash()) || len(p.bans) != 0 || *calls != 2 {
+				t.Fatal("non-sponsor eviction was counted in cumulative sponsor liability")
+			}
+		})
+	}
+}
+
+func TestPQPoolResetOwnerStateFailureIsDeferred(t *testing.T) {
+	p, chain, calls := componentPool(t)
+	tx := componentTx(1, 20, 2, 20)
+	if err := add(p, tx); err != nil {
+		t.Fatal(err)
+	}
+	chain.s.SetExternalError(errors.New("test missing owner state"))
+	p.Reset(nil, p.head)
+	if p.Has(tx.Hash()) || p.deferred[tx.Hash()] == nil || len(p.bans) != 0 || *calls != 1 || p.sources["rpc:component"].failures != 0 {
+		t.Fatal("owner state fault became a determinate rejection, sponsor ban or source charge")
+	}
+}
+
+func TestPQPoolResetMarginOverflowDoesNotBan(t *testing.T) {
+	p, chain, calls := componentPool(t)
+	chain.cfg.PQMigrate.FullResearch.ProofLifetime = ^uint64(0)
+	chain.cfg.PQMigrate.FullResearch.Sunset = ^uint64(0)
+	tx := changed(componentTx(1, 20, 2, 20), func(m *types.PQMigrateTx) {
+		m.Expiry, m.SponsorOption.ValidUntil = ^uint64(0), ^uint64(0)
+	})
+	if err := add(p, tx); err != nil {
+		t.Fatal(err)
+	}
+	p.Reset(nil, resetSponsorHead(p, ^uint64(0)-12))
+	if p.Has(tx.Hash()) || len(p.bans) != 0 || *calls != 1 {
+		t.Fatal("overflowing next-slot margin wrapped into a live obligation or sponsor ban")
+	}
+}
diff --git a/core/txpool/pqpool/pqpool.go b/core/txpool/pqpool/pqpool.go
new file mode 100644
index 0000000000000000000000000000000000000000..dfed7ba801c8667a7e54fc690682bc780012f050
--- /dev/null
+++ b/core/txpool/pqpool/pqpool.go
@@ -0,0 +1,1061 @@
+// Copyright 2026 The go-ethereum Authors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+// Package pqpool holds nonce-less, payer-keyed Full Route A transactions and
+// sponsor-nonce-ordered aggregate batches in separate sets. This research
+// profile excludes Route B lanes. Pool policy never enters block validity.
+
+package pqpool
+
+import (
+	"bytes"
+	"crypto/rand"
+	"errors"
+	"fmt"
+	"math/big"
+	"os"
+	"path/filepath"
+	"sort"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/consensus/misc/eip1559"
+	"github.com/ethereum/go-ethereum/core"
+	"github.com/ethereum/go-ethereum/core/state"
+	"github.com/ethereum/go-ethereum/core/txpool"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/crypto"
+	"github.com/ethereum/go-ethereum/event"
+	"github.com/ethereum/go-ethereum/log"
+	"github.com/ethereum/go-ethereum/params"
+	"github.com/ethereum/go-ethereum/rlp"
+	"github.com/holiman/uint256"
+)
+
+var (
+	ErrVersionLimit     = errors.New("VERSION_LIMIT")
+	ErrSponsorLimit     = errors.New("SPONSOR_PENDING_LIMIT")
+	ErrSponsorHorizon   = errors.New("SPONSOR_HORIZON")
+	ErrSponsorBan       = errors.New("SPONSOR_BANNED")
+	ErrLocalUnavailable = errors.New("PQPOOL_LOCAL_UNAVAILABLE")
+)
+
+// These are local research policy, deliberately separate from genesis limits.
+// SLOT comes from the shared chain slot configuration; no validity decision uses wall-clock time.
+type Config struct {
+	Datadir            string
+	DataCap            uint64
+	MaxPending         int
+	PositiveCacheBytes uint64
+	NegativeCacheBytes uint64
+	MaxVersions        int
+	MaxSponsored       int
+	InvalidBudget      int
+	VerificationBurst  int
+	VerificationWindow time.Duration
+	SponsorBan         time.Duration
+	MaxReorgDepth      uint64
+	MaxReorgScan       int
+	MaxReorgCandidates int
+	MaxReorgBytes      uint64
+}
+
+var DefaultConfig = Config{DataCap: 1 << 30, MaxPending: 128, PositiveCacheBytes: 1 << 20, NegativeCacheBytes: 1 << 20,
+	MaxVersions: 3, MaxSponsored: 16,
+	InvalidBudget: 4, VerificationBurst: 64, VerificationWindow: time.Minute,
+	SponsorBan: time.Hour, MaxReorgDepth: 64, MaxReorgScan: 32768,
+	MaxReorgCandidates: 128, MaxReorgBytes: 64 << 20}
+
+type Chain interface {
+	Config() *params.ChainConfig
+	StateAt(*types.Header) (*state.StateDB, error)
+	GetBlock(common.Hash, uint64) *types.Block
+}
+
+type versionKey struct{ legacy, payer common.Address }
+type proofBody struct {
+	size uint64
+	refs int
+}
+type sourceBudget struct {
+	start    time.Time
+	failures int
+}
+type entry struct {
+	hash, proofKey, piHash, proofHash common.Hash
+	key                               versionKey
+	template                          *types.PQMigrateTx // Proof omitted; the shared body lives on disk.
+	size                              uint64
+	seen                              time.Time
+	source                            string
+	resultKey                         common.Hash // positive-cache entry this item pins while pending
+	pinned                            bool
+}
+
+// deferredEntry is a bounded retry object, never a pending transaction. A local
+// verifier/storage outage is not proof invalidity; retry still runs every check.
+type deferredEntry struct {
+	tx     *types.Transaction
+	source string
+	order  uint64
+	reason string
+}
+
+// Pool keeps single migrations independent of ordinary account nonce ordering.
+// Batches reserve their sponsor and follow its ordinary nonce; migration_nonce
+// remains an owner-state value checked by the consensus core for both types.
+type Pool struct {
+	batches                map[common.Hash]*batchEntry
+	batchBytes             uint64
+	resetting              bool
+	reserver               txpool.Reserver
+	mu                     sync.RWMutex
+	cfg                    Config
+	chain                  Chain
+	head                   *types.Header
+	deliveryClock          atomic.Uint64
+	genesisTime            uint64
+	sponsorStrikes         []sponsorStrike
+	state                  *state.StateDB
+	stateErr               error
+	minTip                 *big.Int
+	entries                map[common.Hash]*entry
+	versions               map[versionKey]common.Hash
+	bodies                 map[common.Hash]*proofBody
+	bodyBytes              uint64
+	deferred               map[common.Hash]*deferredEntry
+	deferredBytes          uint64 // Full raw bytes, conservatively sharing DataCap with proof bodies.
+	deferredOrder          uint64
+	diagnostics            map[common.Hash]localDecision
+	diagnosticOrder        uint64
+	dir                    string
+	bans                   map[common.Address]time.Time
+	sources                map[string]*sourceBudget
+	verifyStart            time.Time
+	verifyCount            int
+	admission              chan struct{} // Nonblocking node-wide gate, not a validity timeout.
+	txFeed                 event.Feed    // New admissions and reorg reinjections.
+	discoverFeed           event.Feed    // Only new external admissions.
+	scope                  event.SubscriptionScope
+	closed                 bool
+	proofCacheSalt         common.Hash
+	positiveCache          *proofResultCache
+	negativeCache          *proofResultCache
+	proofCacheHits         uint64
+	proofCacheMisses       uint64
+	proofCacheNegativeHits uint64
+	// Unexported hooks permit deterministic component tests. New always installs
+	// actual core checks when checkState is nil; there is no mock-accept flag or RPC override.
+	checkState func(*types.Transaction, *state.StateDB, *types.Header, *params.ChainConfig) error
+	checkProof func(*types.Transaction, *params.ChainConfig, string) error
+}
+
+var _ txpool.SubPool = (*Pool)(nil)
+
+func New(cfg Config, chain Chain) *Pool {
+	return &Pool{batches: make(map[common.Hash]*batchEntry), cfg: cfg, chain: chain, minTip: new(big.Int), entries: make(map[common.Hash]*entry),
+		versions: make(map[versionKey]common.Hash), bodies: make(map[common.Hash]*proofBody),
+		bans: make(map[common.Address]time.Time), sources: make(map[string]*sourceBudget),
+		deferred: make(map[common.Hash]*deferredEntry), diagnostics: make(map[common.Hash]localDecision),
+		admission:  make(chan struct{}, 1),
+		checkProof: core.ValidatePQMigrateProof}
+}
+
+func (p *Pool) enabled() bool {
+	c := p.chain.Config()
+	return c.PQMigrate != nil && c.PQMigrate.FullResearch != nil
+}
+func (p *Pool) Filter(tx *types.Transaction) bool { return p.FilterType(tx.Type()) }
+func (p *Pool) FilterType(kind byte) bool {
+	return p.enabled() && (kind == types.PQMigrateTxType || (kind == types.PQBatchTxType && p.chain.Config().PQMigrate.AggregateResearch != nil))
+}
+
+func (p *Pool) Init(tip uint64, head *types.Header, reserver txpool.Reserver) error {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if !p.enabled() {
+		return errors.New("PQ Full research profile disabled")
+	}
+	if p.cfg.MaxPending < 1 || p.cfg.DataCap == 0 || p.cfg.MaxVersions < 1 || p.cfg.VerificationBurst < 1 || p.cfg.VerificationWindow <= 0 || p.cfg.MaxReorgDepth == 0 || p.cfg.MaxReorgScan < 1 || p.cfg.MaxReorgCandidates < 1 || p.cfg.MaxReorgBytes == 0 {
+		return errors.New("invalid local pqpool configuration")
+	}
+	if p.cfg.Datadir != "" {
+		if err := os.MkdirAll(p.cfg.Datadir, 0700); err != nil {
+			return err
+		}
+	}
+	var err error
+	// A private session directory prevents old abandoned files from evading the
+	// accounting of this process. A restart starts empty and revalidates resubmits.
+	p.dir, err = os.MkdirTemp(p.cfg.Datadir, "pending-")
+	if err != nil {
+		return err
+	}
+	if _, err = rand.Read(p.proofCacheSalt[:]); err != nil {
+		os.RemoveAll(p.dir)
+		return fmt.Errorf("pqpool cache salt: %w", err)
+	}
+	p.positiveCache = newProofResultCache(p.cfg.PositiveCacheBytes)
+	p.negativeCache = newProofResultCache(p.cfg.NegativeCacheBytes)
+	p.head = types.CopyHeader(head)
+	p.deliveryClock.Store(txpool.PQPoolTime(head, p.chain.Config()))
+	if genesis, ok := p.chain.(interface{ Genesis() *types.Block }); ok && genesis.Genesis() != nil {
+		p.genesisTime = genesis.Genesis().Time()
+	} else if head.Number.Sign() == 0 {
+		p.genesisTime = head.Time
+	}
+
+	p.reserver = reserver
+	p.minTip.SetUint64(tip)
+	p.state, err = p.chain.StateAt(head)
+	if err != nil {
+		os.RemoveAll(p.dir)
+		return err
+	}
+	log.Info("PQPOOL_ENABLED", "profile", "Full research only", "proofDatacap", p.cfg.DataCap,
+		"pendingLimit", p.cfg.MaxPending, "poolSlot", txpool.PQPoolSlot(p.chain.Config()), "sponsorHorizon", p.sponsorHorizon())
+	return nil
+}
+
+func (p *Pool) Close() error {
+	p.scope.Close()
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	p.closed = true
+	for hash := range p.batches {
+		p.dropBatch(hash)
+	}
+	p.positiveCache = nil
+	p.negativeCache = nil
+	p.entries = make(map[common.Hash]*entry)
+	p.versions = make(map[versionKey]common.Hash)
+	p.bodies = make(map[common.Hash]*proofBody)
+	p.bodyBytes = 0
+	p.deferred = make(map[common.Hash]*deferredEntry)
+	p.deferredBytes = 0
+	if p.dir != "" {
+		return os.RemoveAll(p.dir)
+	}
+	return nil
+}
+
+func (p *Pool) nextHeader() *types.Header {
+	h := types.CopyHeader(p.head)
+	h.Number = new(big.Int).Add(h.Number, big.NewInt(1))
+	h.Time = txpool.PQPoolTime(p.head, p.chain.Config())
+	if h.BaseFee != nil {
+		h.BaseFee = eip1559.CalcBaseFee(p.chain.Config(), p.head)
+	}
+	return h
+}
+
+func (p *Pool) ValidateTxBasics(tx *types.Transaction) error {
+	if tx.Type() == types.PQBatchTxType {
+		return p.batchBasics(tx)
+	}
+	if !p.Filter(tx) {
+		return core.ErrTxTypeNotSupported
+	}
+	m, ok := tx.AsPQMigrate()
+	if !ok {
+		return core.ErrTxTypeNotSupported
+	}
+	if err := m.ValidateShape(); err != nil {
+		return err
+	}
+	c := p.chain.Config().PQMigrate.FullResearch
+	if m.ProofCarrier.Route != 0 || m.LaneAuthOption != nil || m.VerifierVersion != c.Version {
+		return errors.New("WRONG_VERIFIER_VERSION")
+	}
+	if uint64(len(m.ProofCarrier.Proof)) > c.MaxProofBytes {
+		return &core.PQMigrationError{Name: "PROOF_TOO_LARGE", Code: 0x0008}
+	}
+	if tx.Size() > c.MaxTxBytes || len(m.ProofCarrier.Proof) == 0 {
+		return errors.New("PQ_RESEARCH_SIZE_LIMIT")
+	}
+	if tx.Gas() > params.MaxTxGas || tx.Gas() > c.TxGasCap {
+		return errors.New("TX_GAS_CAP")
+	}
+	if m.AlgID != 1 || m.PQPKCommit == (common.Hash{}) {
+		return errors.New("NON_CANONICAL_ENCODING")
+	}
+	return nil
+}
+
+func keyFor(m *types.PQMigrateTx) versionKey {
+	k := versionKey{legacy: m.LegacyAddress, payer: m.LegacyAddress}
+	if s := m.Sponsor(); s != nil {
+		k.payer = s.Sponsor
+	}
+	return k
+}
+func liability(m *types.PQMigrateTx) *big.Int {
+	return new(big.Int).Mul(new(big.Int).SetUint64(m.Gas), m.GasFeeCap)
+}
+func doubled(v *big.Int) *big.Int { return new(big.Int).Lsh(new(big.Int).Set(v), 1) }
+func (p *Pool) source(source string) *sourceBudget {
+	now := time.Now()
+	if b := p.sources[source]; b != nil && now.Sub(b.start) < time.Hour {
+		return b
+	}
+	for k, b := range p.sources {
+		if now.Sub(b.start) >= time.Hour {
+			delete(p.sources, k)
+		}
+	}
+	if len(p.sources) >= 4096 {
+		return nil
+	}
+	b := &sourceBudget{start: now}
+	p.sources[source] = b
+	return b
+}
+func errorName(err error) string {
+	var named *core.PQMigrationError
+	if errors.As(err, &named) {
+		return named.Name
+	}
+	if err == nil {
+		return ""
+	}
+	return err.Error()
+}
+func invalidVerification(err error) bool {
+	if err == nil {
+		return false
+	}
+	if errors.Is(err, core.ErrPQFullUnavailable) {
+		return false
+	}
+	if errors.Is(err, core.ErrPQInvalidFullProof) {
+		return true
+	}
+	// Only deterministic pure signature/proof rejection consumes the invalid
+	// budget. Worker crashes, local IO/timeouts and state gates are separate.
+	switch errorName(err) {
+	case "INVALID_PROOF", "BAD_PQ_SIG", "BAD_POP", "BAD_LANE_SIG":
+		return true
+	}
+	return false
+}
+func (p *Pool) budgetFailure(source string, err error) error {
+	if !invalidVerification(err) {
+		return err
+	}
+	b := p.source(source)
+	if b == nil {
+		return txpool.ErrPQSourceBudget
+	}
+	b.failures++
+	log.Warn("PQPOOL_INVALID", "source", source, "failures", b.failures, "err", err)
+	if b.failures > p.cfg.InvalidBudget {
+		return fmt.Errorf("%w: %v", txpool.ErrPQSourceBudget, err)
+	}
+	return err
+}
+
+// policy computes a possible displacement but does not mutate any pending entry.
+// Failed verification consequently never removes a valid owner's version.
+func (p *Pool) policy(m *types.PQMigrateTx, h *types.Header, exclude common.Hash, admission bool) (common.Hash, error) {
+	attempt := p.state.Copy()
+	displaced, err := p.policyState(m, h, exclude, admission, attempt)
+	if attempt.Error() != nil {
+		return common.Hash{}, fmt.Errorf("%w: %v", ErrLocalUnavailable, attempt.Error())
+	}
+	return displaced, err
+}
+
+// Section 28.8: lowest tip, then lowest fee cap, then greatest tx hash.
+func lowerDisplacementPriority(a, b *entry) bool {
+	if order := a.template.GasTipCap.Cmp(b.template.GasTipCap); order != 0 {
+		return order < 0
+	}
+	if order := a.template.GasFeeCap.Cmp(b.template.GasFeeCap); order != 0 {
+		return order < 0
+	}
+	return bytes.Compare(a.hash[:], b.hash[:]) > 0
+}
+
+func (p *Pool) policyState(m *types.PQMigrateTx, h *types.Header, exclude common.Hash, admission bool, attempt *state.StateDB) (common.Hash, error) {
+	return p.policyStateWith(m, h, exclude, admission, attempt, false)
+}
+func (p *Pool) policyStateWith(m *types.PQMigrateTx, h *types.Header, exclude common.Hash, admission bool, attempt *state.StateDB, sponsorOnly bool) (common.Hash, error) {
+	key := keyFor(m)
+	var policyErr error
+	fail := func(err error) {
+		if policyErr == nil {
+			policyErr = err
+		}
+	}
+	if m.GasTipCap.Cmp(p.minTip) < 0 || h.BaseFee != nil && m.GasFeeCap.Cmp(h.BaseFee) < 0 {
+		fail(txpool.ErrUnderpriced)
+	}
+	var displaced common.Hash
+	if admission {
+		if oldHash, ok := p.versions[key]; ok && oldHash != exclude {
+			old := p.entries[oldHash].template
+			displaced = oldHash
+			if m.GasTipCap.Cmp(doubled(old.GasTipCap)) < 0 || m.GasFeeCap.Cmp(doubled(old.GasFeeCap)) < 0 {
+				fail(txpool.ErrReplaceUnderpriced)
+			}
+		} else {
+			count := 0
+			var lowest *entry
+			for _, e := range p.entries {
+				if e.hash == exclude || e.key.legacy != key.legacy {
+					continue
+				}
+				count++
+				if e.template.Sponsor() != nil && (lowest == nil || lowerDisplacementPriority(e, lowest)) {
+					lowest = e
+				}
+			}
+			if count >= p.cfg.MaxVersions {
+				if lowest == nil || m.GasTipCap.Cmp(lowest.template.GasTipCap) <= 0 {
+					fail(ErrVersionLimit)
+				} else {
+					displaced = lowest.hash
+				}
+			}
+		}
+		if len(p.entries) >= p.cfg.MaxPending && displaced == (common.Hash{}) {
+			fail(txpool.ErrOutOfCapacity)
+		}
+	}
+	// Check 7 sponsor policy precedes check 8 tip/version/replacement outcomes.
+	// Computing a replacement candidate never removes it; verification must pass.
+	if s := m.Sponsor(); s != nil {
+		count, total := p.batchLiability(s.Sponsor, common.Hash{})
+		total.Add(total, liability(m))
+		for _, e := range p.entries {
+			if e.hash == exclude || e.hash == displaced {
+				continue
+			}
+			if es := e.template.Sponsor(); es != nil && es.Sponsor == s.Sponsor {
+				count++
+				total.Add(total, liability(e.template))
+			}
+		}
+		// Protocol order: cumulative bound, count, admission horizon, ban.
+		if attempt.GetBalance(s.Sponsor).CmpBig(total) < 0 {
+			return common.Hash{}, errors.New("INSUFFICIENT_FEE_BALANCE")
+		}
+		if admission && count >= p.cfg.MaxSponsored {
+			return common.Hash{}, ErrSponsorLimit
+		}
+		if admission && (h.Time > ^uint64(0)-p.sponsorHorizon() || s.ValidUntil < h.Time+p.sponsorHorizon()) {
+			return common.Hash{}, ErrSponsorHorizon
+		}
+		if until := p.bans[s.Sponsor]; admission && time.Now().Before(until) {
+			return common.Hash{}, ErrSponsorBan
+		}
+	}
+	if sponsorOnly {
+		return displaced, nil
+	}
+	return displaced, policyErr
+}
+
+// The core state checker invokes cheap sponsor checks and then the check-8
+// outcome before signature verification. The candidate is only selected here;
+// replacement/displacement takes effect after every verification passes.
+func (p *Pool) validateState(tx *types.Transaction, attempt *state.StateDB, h *types.Header, exclude common.Hash, admission bool) error {
+	if p.checkState != nil {
+		return p.checkState(tx, attempt, h, p.chain.Config())
+	}
+	return core.ValidatePQMigrateStateWithSponsorPolicy(tx, attempt, h, p.chain.Config(), func() error {
+		m, _ := tx.AsPQMigrate()
+		_, err := p.policyStateWith(m, h, exclude, admission, attempt, false)
+		return err
+	})
+}
+
+func (p *Pool) Add(txs []*types.Transaction, sync bool) []error { return p.AddFrom("local", txs, sync) }
+func (p *Pool) PQDeliveryClock() uint64                         { return p.deliveryClock.Load() }
+
+func (p *Pool) AddFrom(source string, txs []*types.Transaction, sync bool) []error {
+	return p.AddFromAt(source, txs, sync, p.PQDeliveryClock())
+}
+
+// AddFromAt preserves the outer dispatcher's delivery clock across any wait in
+// an earlier subpool. Direct callers capture it at AddFrom entry instead.
+func (p *Pool) AddFromAt(source string, txs []*types.Transaction, _ bool, delivered uint64) []error {
+	errs := make([]error, len(txs))
+	if len(txs) == 0 {
+		return errs
+	}
+	select {
+	case p.admission <- struct{}{}:
+		defer func() { <-p.admission }()
+	default:
+		for i := range errs {
+			errs[i] = txpool.ErrPQBusy
+		}
+		return errs
+	}
+	accepted := make([]*types.Transaction, 0, len(txs))
+	p.mu.Lock()
+	for i, tx := range txs {
+		// A new submission that meets a local fault gets the retryable local
+		// error and is not retained (spec section 20.17 (a)). Only an item the
+		// pool already holds can enter the deferred set, at Reset.
+		errs[i] = p.addWithDelivery(source, tx, &delivered)
+		if errs[i] != nil && !errors.Is(errs[i], txpool.ErrAlreadyKnown) {
+			p.rememberDecision(tx.Hash(), errs[i].Error(), retryable(errs[i]))
+		}
+		if errs[i] == nil {
+			accepted = append(accepted, tx)
+		}
+	}
+	p.mu.Unlock()
+	if len(accepted) > 0 {
+		p.txFeed.Send(core.NewTxsEvent{Txs: accepted})
+		p.discoverFeed.Send(core.NewTxsEvent{Txs: accepted})
+	}
+	return errs
+}
+
+// A held retry or reinjection has no external delivery and charges no source.
+func (p *Pool) addLocked(source string, tx *types.Transaction) error {
+	return p.addWithDelivery(source, tx, nil)
+}
+
+func (p *Pool) addWithDelivery(source string, tx *types.Transaction, delivered *uint64) error {
+	if p.closed || p.state == nil || p.stateErr != nil {
+		return fmt.Errorf("%w: state unavailable", ErrLocalUnavailable)
+	}
+	if err := p.ValidateTxBasics(tx); err != nil {
+		return err
+	}
+	if tx.Type() == types.PQBatchTxType {
+		if batch := p.batches[tx.Hash()]; batch != nil && (batch.admitted || !p.resetting) {
+			return txpool.ErrAlreadyKnown
+		}
+		// Reset must still fully admit an unverified held batch of this hash.
+	}
+	if delivered != nil {
+		b := p.source(source)
+		if b == nil || b.failures > p.cfg.InvalidBudget {
+			return txpool.ErrPQSourceBudget
+		}
+	}
+	if tx.Type() == types.PQBatchTxType {
+		return p.admissionFailure(source, tx, delivered, p.addBatch(tx, true))
+	}
+	m, _ := tx.AsPQMigrate()
+	h := p.nextHeader()
+	attempt := p.state.Copy()
+	stateErr := p.validateState(tx, attempt, h, common.Hash{}, true)
+	if attempt.Error() != nil {
+		return fmt.Errorf("%w: %v", ErrLocalUnavailable, attempt.Error())
+	}
+	if stateErr != nil {
+		return p.admissionFailure(source, tx, delivered, stateErr)
+	}
+	displaced, err := p.policy(m, h, common.Hash{}, true)
+	if err != nil {
+		return err
+	}
+	if p.entries[tx.Hash()] != nil {
+		return txpool.ErrReplaceUnderpriced
+	}
+	if len(p.entries)+len(p.batches)+len(p.deferred) >= p.cfg.MaxPending && displaced == (common.Hash{}) && p.deferred[tx.Hash()] == nil {
+		return txpool.ErrOutOfCapacity
+	}
+	pi := m.PublicInputs()
+	proof := m.ProofCarrier.Proof
+	key := crypto.Keccak256Hash(pi, proof) // version is inside PI; config is immutable per chain.
+	queuedBytes := p.deferredBytes
+	if d := p.deferred[tx.Hash()]; d != nil {
+		queuedBytes -= d.tx.Size()
+	}
+	if _, exists := p.bodies[key]; !exists && (uint64(len(proof)) > p.cfg.DataCap || p.bodyBytes+p.batchBytes+queuedBytes > p.cfg.DataCap-uint64(len(proof))) {
+		return txpool.ErrOutOfCapacity
+	}
+	err = p.verifyProofCached(tx, "admission", source)
+	if err != nil {
+		return p.admissionFailure(source, tx, delivered, err)
+	}
+	if _, exists := p.bodies[key]; !exists {
+		if err = os.WriteFile(filepath.Join(p.dir, key.Hex()+".proof"), proof, 0600); err != nil {
+			return fmt.Errorf("%w: %v", ErrLocalUnavailable, err)
+		}
+		p.bodies[key] = &proofBody{size: uint64(len(proof))}
+		p.bodyBytes += uint64(len(proof))
+	}
+	// Hold the new reference before dropping an older version of the same proof.
+	p.bodies[key].refs++
+	if displaced != (common.Hash{}) {
+		p.remove(displaced, "replacement/displacement")
+	}
+	piHash, proofHash := crypto.Keccak256Hash(pi), crypto.Keccak256Hash(proof)
+	// AsPQMigrate exposes the transaction payload; never strip the caller's
+	// proof. NewTx makes the owned deep copy before discarding only our copy.
+	owned := types.NewTx(m)
+	template, _ := owned.AsPQMigrate()
+	template.ProofCarrier.Proof = nil
+	e := &entry{hash: tx.Hash(), proofKey: key, piHash: piHash, proofHash: proofHash, key: keyFor(m), template: template, size: tx.Size(), seen: time.Now(), source: source}
+	p.entries[e.hash] = e
+	p.pinProofResult(e, tx)
+	p.versions[e.key] = e.hash
+	p.forgetDeferred(e.hash)
+	delete(p.diagnostics, e.hash)
+	log.Info("PQPOOL_ACCEPT", "context", "admission", "source", source, "txhash", e.hash, "legacy", e.key.legacy, "payer", e.key.payer, "piHash", e.piHash, "proofHash", e.proofHash, "bytes", e.size, "pending", len(p.entries))
+	return nil
+}
+
+func (p *Pool) resolve(e *entry) *types.Transaction {
+	b, err := os.ReadFile(filepath.Join(p.dir, e.proofKey.Hex()+".proof"))
+	if err != nil {
+		log.Error("PQPOOL_BODY_UNAVAILABLE", "txhash", e.hash, "err", err)
+		return nil
+	}
+	if crypto.Keccak256Hash(b) != e.proofHash {
+		log.Error("PQPOOL_BODY_CORRUPT", "txhash", e.hash)
+		return nil
+	}
+	m := *e.template
+	m.ProofCarrier.Proof = b
+	tx := types.NewTx(&m)
+	if tx.Hash() != e.hash {
+		log.Error("PQPOOL_RECONSTRUCTION_FAILED", "txhash", e.hash)
+		return nil
+	}
+	return tx
+}
+func (p *Pool) remove(hash common.Hash, reason string) {
+	e := p.entries[hash]
+	if e == nil {
+		return
+	}
+	delete(p.entries, hash)
+	if e.pinned {
+		p.positiveCache.unpin(e.resultKey)
+	}
+	p.rememberDecision(hash, reason, false)
+	delete(p.versions, e.key)
+	if body := p.bodies[e.proofKey]; body != nil {
+		body.refs--
+		if body.refs == 0 {
+			os.Remove(filepath.Join(p.dir, e.proofKey.Hex()+".proof"))
+			p.bodyBytes -= body.size
+			delete(p.bodies, e.proofKey)
+		}
+	}
+	log.Info("PQPOOL_EVICT", "txhash", hash, "legacy", e.key.legacy, "payer", e.key.payer, "reason", reason)
+}
+
+func (p *Pool) banSponsor(s common.Address, reason string) {
+	p.bans[s] = time.Now().Add(p.cfg.SponsorBan)
+	for hash, e := range p.batches {
+		b, _ := e.tx.AsPQBatch()
+		if b.Sponsor == s {
+			p.dropBatch(hash)
+		}
+	}
+	for hash, e := range p.entries {
+		if es := e.template.Sponsor(); es != nil && es.Sponsor == s {
+			p.remove(hash, reason)
+		}
+	}
+	log.Warn("PQPOOL_SPONSOR_BAN", "sponsor", s, "reason", reason, "duration", p.cfg.SponsorBan)
+}
+
+// Reset is invoked serially by TxPool.loop. It may skip intermediate heads, so
+// traversal starts at the last head this pool actually processed (p.head), not an
+// independently supplied old-head hint. Same-head resets retry deferred objects.
+func (p *Pool) Reset(old, head *types.Header) {
+	p.mu.Lock()
+	if p.closed || head == nil {
+		p.mu.Unlock()
+		return
+	}
+	if old != nil && p.head != nil && old.Hash() != p.head.Hash() {
+		log.Debug("PQPOOL_RESET_COALESCED", "hint", old.Hash(), "processed", p.head.Hash(), "new", head.Hash())
+	}
+	candidates, scanErr := p.orphaned(p.head, head)
+	if scanErr != nil {
+		// Never act on a partial new-branch included set. This is local policy;
+		// the new canonical state is still installed and pending revalidated.
+		log.Warn("PQPOOL_REORG_SCAN_SKIPPED", "err", scanErr, "new", head.Hash())
+	}
+	newHead := p.head == nil || p.head.Hash() != head.Hash()
+	p.head = types.CopyHeader(head)
+	p.deliveryClock.Store(txpool.PQPoolTime(head, p.chain.Config()))
+	if newHead {
+		p.decideSponsorStrikes(head)
+	}
+
+	p.pruneProofCaches()
+	p.state, p.stateErr = p.chain.StateAt(head)
+	if p.stateErr != nil {
+		for _, e := range p.batches {
+			p.deferBatch(e.tx)
+		}
+		for _, tx := range candidates {
+			p.deferTx(tx, "reorg:"+tx.Hash().Hex(), p.stateErr)
+		}
+		log.Error("PQPOOL_RESET_UNAVAILABLE", "err", p.stateErr)
+		p.mu.Unlock()
+		return
+	}
+	h := p.nextHeader()
+	p.resetting = true
+	p.pruneBatchReset(h)
+	p.pruneReset(h)
+	queued := p.deferredRetries()
+	p.revalidateBatches()
+
+	var rechecks []*entry
+	for _, e := range p.sorted() {
+		if p.entries[e.hash] == nil {
+			continue
+		}
+		m := e.template
+		attemptState := p.state.Copy()
+		tx := p.resolve(e)
+		if tx == nil {
+			p.remove(e.hash, "local body unavailable; not INVALID_PROOF")
+			continue
+		}
+		stateErr := p.validateState(tx, attemptState, h, e.hash, false)
+		if attemptState.Error() != nil {
+			p.remove(e.hash, "state unavailable; deferred")
+			p.deferTx(tx, e.source, fmt.Errorf("%w: %v", ErrLocalUnavailable, attemptState.Error()))
+			continue
+		}
+		if retryable(stateErr) {
+			// A local fault is no verdict on a held item: it waits in the
+			// deferred set, as at the policy check below (spec section 20.17 (a)-(b)).
+			p.remove(e.hash, "state unavailable; deferred")
+			p.deferTx(tx, e.source, stateErr)
+			continue
+		}
+		if err := stateErr; err != nil {
+			if s := m.Sponsor(); s != nil && errorName(err) == "INSUFFICIENT_FEE_BALANCE" {
+				p.banSponsor(s.Sponsor, "sponsor balance broken")
+			} else {
+				p.remove(e.hash, err.Error())
+			}
+			continue
+		}
+		_, err := p.policy(m, h, e.hash, false)
+		if retryable(err) {
+			p.remove(e.hash, "state unavailable; deferred")
+			p.deferTx(tx, e.source, err)
+			continue
+		}
+		if err != nil {
+			if s := m.Sponsor(); s != nil && errorName(err) == "INSUFFICIENT_FEE_BALANCE" {
+				p.banSponsor(s.Sponsor, "sponsor cumulative balance broken")
+			} else {
+				p.remove(e.hash, err.Error())
+			}
+			continue
+		}
+		rechecks = append(rechecks, e)
+	}
+	// Retry prior local failures before spending the Full budget on previously
+	// admitted entries. Otherwise the same Pending prefix can starve deferred
+	// candidates forever. All old Pending entries are freshly checked or moved
+	// to deferred before releasing mu. Orphans follow existing work in canonical
+	// ancestor-to-tip/block order. Every admission attempt uses the
+	// ordinary version/replacement, payer, state, signature and Full admission.
+	accepted := make([]*types.Transaction, 0, len(queued)+len(candidates))
+	attempted := make(map[common.Hash]struct{}, len(queued)+len(candidates))
+	attempt := func(tx *types.Transaction, source string) {
+		if _, duplicate := attempted[tx.Hash()]; duplicate {
+			return
+		}
+		attempted[tx.Hash()] = struct{}{}
+		if p.resetCandidateExpired(tx, h) {
+			p.forgetDeferred(tx.Hash())
+			p.dropBatch(tx.Hash())
+			p.rememberDecision(tx.Hash(), "reset time margin", false)
+			return
+		}
+		err := p.addLocked(source, tx)
+		if err == nil {
+			accepted = append(accepted, tx)
+			log.Info("PQPOOL_REORG_REINJECT", "txhash", tx.Hash(), "head", head.Hash(), "source", source)
+		} else if retryable(err) {
+			p.deferTx(tx, source, err)
+		} else {
+			p.forgetDeferred(tx.Hash())
+			if batch := p.batches[tx.Hash()]; batch != nil && !batch.admitted {
+				p.dropBatch(tx.Hash())
+			}
+			if !errors.Is(err, txpool.ErrAlreadyKnown) {
+				p.rememberDecision(tx.Hash(), err.Error(), false)
+			}
+			log.Info("PQPOOL_REORG_REJECT", "txhash", tx.Hash(), "head", head.Hash(), "err", err)
+		}
+	}
+	for _, d := range queued {
+		attempt(d.tx, d.source)
+	}
+	for _, e := range rechecks {
+		if p.entries[e.hash] == nil {
+			continue
+		} // Deferred admission may replace it.
+		tx := p.resolve(e) // Keep at most one reconstructed proof live per pass.
+		if tx == nil {
+			p.remove(e.hash, "local body unavailable; not INVALID_PROOF")
+			continue
+		}
+		err := p.verifyProofCached(tx, "pool-reset", e.source)
+		if retryable(err) {
+			// Fresh validation did not finish for this head: quarantine rather
+			// than expose it through Pending. No INVALID proof/source penalty.
+			p.remove(e.hash, "local verification unavailable; deferred")
+			p.deferTx(tx, e.source, err)
+			continue
+		}
+		if err != nil {
+			p.remove(e.hash, "reset verification: "+err.Error())
+		}
+	}
+	for _, tx := range candidates {
+		if batch := p.batches[tx.Hash()]; batch != nil && batch.admitted {
+			continue
+		}
+		attempt(tx, "reorg:"+tx.Hash().Hex())
+	}
+	p.finishBatchReset()
+	// A held batch can pass admission above a gap and be removed by the
+	// final sweep. Announce only the transactions that survived that sweep.
+	kept := accepted[:0]
+	for _, tx := range accepted {
+		if batch := p.batches[tx.Hash()]; batch != nil && batch.pending || p.entries[tx.Hash()] != nil {
+			kept = append(kept, tx)
+		}
+	}
+	accepted = kept
+	p.resetting = false
+	p.mu.Unlock()
+	// Subscribers may call back into the pool; never send while holding mu.
+	// Close closes the subscription scope first, releasing blocked sends.
+	if len(accepted) > 0 {
+		p.txFeed.Send(core.NewTxsEvent{Txs: accepted})
+	}
+}
+
+func (p *Pool) sorted() []*entry {
+	items := make([]*entry, 0, len(p.entries))
+	for _, e := range p.entries {
+		items = append(items, e)
+	}
+	sort.Slice(items, func(i, j int) bool {
+		if cmp := items[i].template.GasTipCap.Cmp(items[j].template.GasTipCap); cmp != 0 {
+			return cmp > 0
+		}
+		return items[i].seen.Before(items[j].seen)
+	})
+	return items
+}
+func (p *Pool) SetGasTip(tip *big.Int) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	p.minTip.Set(tip)
+	for h, e := range p.batches {
+		if e.tx.GasTipCap().Cmp(tip) < 0 {
+			p.dropBatch(h)
+		}
+	}
+	for h, e := range p.entries {
+		if e.template.GasTipCap.Cmp(tip) < 0 {
+			p.remove(h, "minimum tip changed")
+		}
+	}
+}
+func (p *Pool) Has(h common.Hash) bool {
+	p.mu.RLock()
+	defer p.mu.RUnlock()
+	batch := p.batches[h]
+	return p.entries[h] != nil || batch != nil && batch.admitted
+}
+func (p *Pool) Get(h common.Hash) *types.Transaction {
+	p.mu.RLock()
+	defer p.mu.RUnlock()
+	if b := p.batches[h]; b != nil && b.admitted {
+		return b.tx
+	}
+	if e := p.entries[h]; e != nil {
+		return p.resolve(e)
+	}
+	return nil
+}
+func (p *Pool) GetRLP(h common.Hash, _ uint) []byte {
+	tx := p.Get(h)
+	if tx == nil {
+		return nil
+	}
+	b, err := rlp.EncodeToBytes(tx)
+	if err != nil {
+		return nil
+	}
+	return b
+}
+func (p *Pool) GetMetadata(h common.Hash) *txpool.TxMetadata {
+	p.mu.RLock()
+	defer p.mu.RUnlock()
+	if b := p.batches[h]; b != nil && b.admitted {
+		return &txpool.TxMetadata{Type: types.PQBatchTxType, Size: b.tx.Size(), SizeWithoutBlob: b.tx.Size()}
+	}
+	if e := p.entries[h]; e != nil {
+		return &txpool.TxMetadata{Type: types.PQMigrateTxType, Size: e.size, SizeWithoutBlob: e.size}
+	}
+	return nil
+}
+func (p *Pool) Pending(f txpool.PendingFilter) (map[common.Address][]*txpool.LazyTransaction, int) {
+	result := make(map[common.Address][]*txpool.LazyTransaction)
+	if f.BlobTxs {
+		return result, 0
+	}
+	p.mu.RLock()
+	defer p.mu.RUnlock()
+	if p.closed || p.stateErr != nil {
+		return result, 0
+	}
+	n := 0
+	if !f.OnlyPQ {
+		n = p.pendingBatches(f, result)
+	}
+	if f.ExcludePQ {
+		return result, n
+	}
+	for _, e := range p.sorted() {
+		m := e.template
+		fee, tip := uint256.MustFromBig(m.GasFeeCap), uint256.MustFromBig(m.GasTipCap)
+		if f.GasLimitCap != 0 && m.Gas > f.GasLimitCap {
+			continue
+		}
+		if f.BaseFee != nil {
+			if fee.Cmp(f.BaseFee) < 0 {
+				continue
+			}
+			effective := new(uint256.Int).Sub(fee, f.BaseFee)
+			if effective.Cmp(tip) < 0 {
+				tip = effective
+			}
+		}
+		if f.MinTip != nil && tip.Cmp(f.MinTip) < 0 {
+			continue
+		}
+		result[e.key.legacy] = append(result[e.key.legacy], &txpool.LazyTransaction{Pool: p, Hash: e.hash, Time: e.seen, GasFeeCap: fee, GasTipCap: uint256.MustFromBig(m.GasTipCap), Gas: m.Gas})
+		n++
+	}
+	return result, n
+}
+func (p *Pool) SubscribeTransactions(ch chan<- core.NewTxsEvent, reorgs bool) event.Subscription {
+	var sub event.Subscription
+	if reorgs {
+		sub = p.txFeed.Subscribe(ch)
+	} else {
+		sub = p.discoverFeed.Subscribe(ch)
+	}
+	if tracked := p.scope.Track(sub); tracked != nil {
+		return tracked
+	}
+	// Track can race Close and return nil without unsubscribing its argument.
+	// Never leak a receiver that could block an in-flight lock-free Send.
+	sub.Unsubscribe()
+	return sub
+}
+func (p *Pool) Nonce(a common.Address) uint64 {
+	p.mu.RLock()
+	defer p.mu.RUnlock()
+	if len(p.batchList(a)) == 0 {
+		return 0
+	}
+	return p.batchNonce(a)
+}
+func (p *Pool) Stats() (int, int) {
+	p.mu.RLock()
+	defer p.mu.RUnlock()
+	pending, queued := len(p.entries), 0
+	for _, e := range p.batches {
+		if e.pending {
+			pending++
+		} else {
+			queued++
+		}
+	}
+	return pending, queued
+}
+
+// Generic txpool_content is a nonce map. Dedicated pqpool_content exposes all
+// hash-keyed versions without overwriting an ordinary transaction at nonce 0.
+func (p *Pool) Content() (map[common.Address][]*types.Transaction, map[common.Address][]*types.Transaction) {
+	p.mu.RLock()
+	defer p.mu.RUnlock()
+	pending := make(map[common.Address][]*types.Transaction)
+	queued := make(map[common.Address][]*types.Transaction)
+	for _, e := range p.batches {
+		b, _ := e.tx.AsPQBatch()
+		out := pending
+		if !e.pending {
+			out = queued
+		}
+		out[b.Sponsor] = append(out[b.Sponsor], e.tx)
+	}
+	for _, out := range []map[common.Address][]*types.Transaction{pending, queued} {
+		for a := range out {
+			sort.Slice(out[a], func(i, j int) bool { return out[a][i].Nonce() < out[a][j].Nonce() })
+		}
+	}
+	return pending, queued
+}
+func (p *Pool) ContentFrom(a common.Address) ([]*types.Transaction, []*types.Transaction) {
+	pending, queued := p.Content()
+	return pending[a], queued[a]
+}
+func (p *Pool) Status(h common.Hash) txpool.TxStatus {
+	p.mu.RLock()
+	defer p.mu.RUnlock()
+	if e := p.batches[h]; e != nil {
+		if e.pending {
+			return txpool.TxStatusPending
+		}
+		return txpool.TxStatusQueued
+	}
+	if p.entries[h] != nil {
+		return txpool.TxStatusPending
+	}
+	return txpool.TxStatusUnknown
+}
+func (p *Pool) Clear() {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	for h := range p.batches {
+		p.dropBatch(h)
+	}
+	for h := range p.entries {
+		p.remove(h, "clear")
+	}
+	p.deferred = make(map[common.Hash]*deferredEntry)
+	p.deferredBytes = 0
+}
+
+type API struct{ pool *Pool }
+
+func NewAPI(p *Pool) *API { return &API{pool: p} }
+func (a *API) Status() map[string]interface{} {
+	p := a.pool
+	p.mu.RLock()
+	defer p.mu.RUnlock()
+	return map[string]interface{}{"profile": "Full Route A research only", "pending": len(p.entries), "queued": 0, "proofBodies": len(p.bodies), "proofBytes": p.bodyBytes, "dataCap": p.cfg.DataCap, "poolClock": p.nextHeader().Time, "ordinaryNonceOrdering": false, "stateAvailable": p.stateErr == nil, "fullProofCache": p.proofCacheHoldsPending(), "proofCacheHits": p.proofCacheHits, "proofCacheMisses": p.proofCacheMisses, "proofCacheNegativeHits": p.proofCacheNegativeHits, "proofCacheEntries": p.positiveCache.len(), "proofCacheNegativeEntries": p.negativeCache.len(), "proofCacheBytes": p.positiveCache.bytes(), "proofCacheNegativeBytes": p.negativeCache.bytes(), "proofCacheByteCap": p.cfg.PositiveCacheBytes, "proofCacheNegativeByteCap": p.cfg.NegativeCacheBytes, "deferred": len(p.deferred), "deferredBytes": p.deferredBytes, "reorgDepth": p.cfg.MaxReorgDepth, "reorgScan": p.cfg.MaxReorgScan, "reorgCandidates": p.cfg.MaxReorgCandidates, "reorgBytes": p.cfg.MaxReorgBytes, "diagnostics": len(p.diagnostics), "diagnosticLimit": p.cfg.MaxPending, "fullSchedule": "deferred-before-pending-state-recheck; pure-proof-cache"}
+}
+func (a *API) Content() map[string]interface{} {
+	p := a.pool
+	p.mu.RLock()
+	defer p.mu.RUnlock()
+	out := make(map[string]interface{}, len(p.entries))
+	for _, e := range p.sorted() {
+		m := e.template
+		out[e.hash.Hex()] = map[string]interface{}{"hash": e.hash, "legacyAddress": e.key.legacy, "payer": e.key.payer, "sponsored": m.Sponsor() != nil, "migrationNonce": m.MigrationNonce, "expiry": m.Expiry, "gas": m.Gas, "maxFeePerGas": m.GasFeeCap.String(), "maxPriorityFeePerGas": m.GasTipCap.String(), "rawBytes": e.size, "proofBytes": p.bodies[e.proofKey].size, "piHash": e.piHash, "proofHash": e.proofHash, "proofBodyKey": e.proofKey, "source": e.source}
+	}
+	return out
+}
