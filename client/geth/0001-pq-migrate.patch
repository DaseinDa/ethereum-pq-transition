@@ -0,0 +1,149 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package core
+
+import (
+	"math/big"
+	"testing"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/consensus/beacon"
+	"github.com/ethereum/go-ethereum/consensus/ethash"
+	"github.com/ethereum/go-ethereum/core/rawdb"
+	"github.com/ethereum/go-ethereum/core/state"
+	"github.com/ethereum/go-ethereum/core/tracing"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/crypto"
+	"github.com/ethereum/go-ethereum/params"
+)
+
+// Client change (3) of research profile R-1 (spec section 23.2, rows client
+// and E1): a T0 after genesis, with the code images of section 19.9 item 4
+// installed in the transition block of T0 (section 24.6 rules 1-2). Component
+// tests (model tier): real blocks built and imported in process, no network.
+
+// A chain whose genesis is at 0 and whose blocks come every 10 seconds; T0 = 25
+// makes block 3 (timestamp 30) the transition block.
+const pqT0 = 25
+
+func TestPQR1T0InstallsCodeImages(t *testing.T) {
+	cfg := r1TestChain(pqT0)
+	registry, facts := cfg.PQMigrate.Registry, cfg.PQMigrate.FactRegistry
+	held := big.NewInt(12345) // ether sent to PQ_REGISTRY before T0 (section 22.4)
+	key, _ := crypto.HexToECDSA("8a1f9a8f95be41cd7ccb6168179afb4504aefe388d1e14474d32c45c72ce7b7a")
+	sender := crypto.PubkeyToAddress(key.PublicKey)
+	pk, sk := pqSeedKey(0x41)
+	gspec := &Genesis{Config: cfg, GasLimit: 30000000, Alloc: withSystemContracts(types.GenesisAlloc{
+		registry: {Balance: held},
+		sender:   {Balance: new(big.Int).Mul(big.NewInt(10), big.NewInt(params.Ether))},
+	})}
+	// A 0x7d enrolling the sender, valid from T0; it lands in the transition block.
+	en := &types.PQEnrollTx{ChainID: cfg.ChainID, GasTipCap: big.NewInt(params.GWei), GasFeeCap: big.NewInt(10 * params.GWei), Gas: 500000, AlgID: 1, PublicKey: pk.Bytes()}
+	en.PoPSignature = pqSignTag(t, sk, "ETH-PQ-ENROLL-POP/v1", PQEnrollmentDigest(cfg.ChainID, sender, 0, 1, en.PublicKey))
+	hash := en.SigningHash()
+	sig, err := crypto.Sign(hash[:], key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	en.R, en.S, en.V = new(big.Int).SetBytes(sig[:32]), new(big.Int).SetBytes(sig[32:64]), new(big.Int).SetUint64(uint64(sig[64]))
+	enroll := types.NewTx(en)
+	_, blocks, _ := GenerateChainWithGenesis(gspec, beacon.New(ethash.NewFaker()), 4, func(i int, b *BlockGen) {
+		if b.Number().Uint64() == 3 {
+			b.AddTx(enroll)
+		}
+	})
+	chain, err := NewBlockChain(rawdb.NewMemoryDatabase(), gspec, beacon.New(ethash.NewFaker()), nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer chain.Stop()
+	if n, err := chain.InsertChain(blocks); err != nil {
+		t.Fatalf("import of the built chain failed at %d: %v", n, err)
+	}
+	for _, b := range blocks {
+		s, err := chain.StateAt(b.Header())
+		if err != nil {
+			t.Fatal(err)
+		}
+		installed := b.Time() >= pqT0
+		for _, a := range []common.Address{registry, facts} {
+			code, nonce := s.GetCode(a), s.GetNonce(a)
+			if installed != (len(code) == 1 && code[0] == 0 && nonce == 1) || !installed && (len(code) != 0 || nonce != 0) {
+				t.Fatalf("block %d (time %d): %s holds code %x nonce %d", b.NumberU64(), b.Time(), a, code, nonce)
+			}
+		}
+		if s.GetBalance(registry).ToBig().Cmp(held) != 0 {
+			t.Fatalf("block %d: PQ_REGISTRY balance not kept", b.NumberU64())
+		}
+	}
+	if blocks[2].Time() != 30 || len(blocks[2].Transactions()) != 1 {
+		t.Fatal("the 0x7d must sit in the transition block")
+	}
+	s, _ := chain.StateAt(blocks[2].Header())
+	if rec := ReadPQRecord(s, registry, sender); rec.Mode != 1 || rec.EnrolledAt != 30 {
+		t.Fatalf("enrollment in the transition block: %+v", rec)
+	}
+}
+
+// Before T0 no type of this protocol is live: a 0x7d is refused as not yet
+// active (spec section 24.6 rule 1; layer 1).
+func TestPQR1T0TypeNotLiveBefore(t *testing.T) {
+	cfg := r1TestChain(pqT0)
+	s, err := state.New(types.EmptyRootHash, state.NewDatabaseForTesting())
+	if err != nil {
+		t.Fatal(err)
+	}
+	key, _ := crypto.HexToECDSA("8a1f9a8f95be41cd7ccb6168179afb4504aefe388d1e14474d32c45c72ce7b7a")
+	pk, sk := pqSeedKey(0x41)
+	en := &types.PQEnrollTx{ChainID: cfg.ChainID, GasTipCap: big.NewInt(1), GasFeeCap: big.NewInt(params.GWei), Gas: 500000, AlgID: 1, PublicKey: pk.Bytes()}
+	en.PoPSignature = pqSignTag(t, sk, "ETH-PQ-ENROLL-POP/v1", PQEnrollmentDigest(cfg.ChainID, crypto.PubkeyToAddress(key.PublicKey), 0, 1, en.PublicKey))
+	hash := en.SigningHash()
+	sig, _ := crypto.Sign(hash[:], key)
+	en.R, en.S, en.V = new(big.Int).SetBytes(sig[:32]), new(big.Int).SetBytes(sig[32:64]), new(big.Int).SetUint64(uint64(sig[64]))
+	h := &types.Header{Number: big.NewInt(2), Time: pqT0 - 1, BaseFee: big.NewInt(1), Difficulty: new(big.Int)}
+	if err := ValidatePQTransaction(s, cfg, h, types.NewTx(en), false); err == nil || err.Error() != "FORK_NOT_ACTIVE" {
+		t.Fatalf("0x7d before T0: %v", err)
+	}
+}
+
+// The installation itself: only in the transition block, an address holding
+// code is skipped, the bridge laboratory installs by number instead.
+func TestPQR1T0InstallationRule(t *testing.T) {
+	cfg := r1TestChain(pqT0)
+	registry, facts := cfg.PQMigrate.Registry, cfg.PQMigrate.FactRegistry
+	fresh := func() *state.StateDB {
+		s, err := state.New(types.EmptyRootHash, state.NewDatabaseForTesting())
+		if err != nil {
+			t.Fatal(err)
+		}
+		return s
+	}
+	for name, c := range map[string]struct{ parent, time uint64 }{
+		"before-t0":    {10, 20},
+		"after-t0":     {30, 40},
+		"parent-at-t0": {pqT0, pqT0 + 10}, // a later block, or T0 at or before genesis
+	} {
+		s := fresh()
+		if err := InstallPQSystemImages(cfg, c.parent, c.time, s); err != nil || len(s.GetCode(registry)) != 0 {
+			t.Fatalf("%s: installed outside the transition block", name)
+		}
+	}
+	s := fresh()
+	s.SetCode(facts, []byte{0x60}, tracing.CodeChangeUnspecified)
+	if err := InstallPQSystemImages(cfg, pqT0-1, pqT0, s); err != nil {
+		t.Fatal(err)
+	}
+	if code := s.GetCode(registry); len(code) != 1 || code[0] != 0 || s.GetNonce(registry) != 1 {
+		t.Fatal("PQ_REGISTRY not installed at T0 exactly")
+	}
+	if code := s.GetCode(facts); len(code) != 1 || code[0] != 0x60 || s.GetNonce(facts) != 0 {
+		t.Fatal("an address holding code was overwritten")
+	}
+	bridge := *cfg
+	bridge.PQStateBridge = &params.PQStateBridgeConfig{}
+	s = fresh()
+	if err := InstallPQSystemImages(&bridge, pqT0-1, pqT0, s); err != nil || len(s.GetCode(registry)) != 0 {
+		t.Fatal("the generic trigger ran on the bridge laboratory")
+	}
+}
