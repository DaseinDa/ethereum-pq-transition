+	du := r5DataInput(data, ds)
+	dp := append(bytes.Clone(du), make([]byte, 12)...)
+	mut := func(b []byte, at int, v []byte) []byte { r := bytes.Clone(b); copy(r[at:], v); return r }
+	cases := []struct {
+		name  string
+		cd    []byte
+		valid bool
+		gas   uint64
+	}{
+		{"ER-1-padded", p, true, 50240}, {"ER-2-unpadded", u, true, 50237},
+		{"ER-3-nonzero-padding", mut(p, len(u), bytes.Repeat([]byte{255}, 12)), true, 50240},
+		{"ER-4-trailing-1", append(bytes.Clone(p), 0), true, 50240},
+		{"ER-4-trailing-32", append(bytes.Clone(p), bytes.Repeat([]byte{255}, 32)...), true, 50243},
+		{"ER-5-offset", mut(p, 36, r5Word(96)), false, 50240},
+		{"ER-6-overlong", mut(p, 68, r5Word(2421)), false, 50240},
+		{"ER-7-short-tail", u[:len(u)-1], false, 50237}, {"ER-7-no-tail", u[:100], false, 50012},
+		{"ER-8-selector", u[:4], false, 50003}, {"ER-8-short-head", u[:99], false, 50012},
+		{"ER-9-short-sig", mut(p, 68, r5Word(2419)), false, 50240},
+		{"ER-10-Safe", dp, true, 50252}, {"ER-11-unpadded", du, true, 50249},
+		{"ER-11-padding", mut(dp, 166, bytes.Repeat([]byte{255}, 30)), true, 50252},
+		{"ER-12-offset", mut(dp, 36, r5Word(224)), false, 50252},
+		{"ER-13-first-offset", mut(dp, 4, r5Word(96)), false, 50252},
+		{"ER-13-overflow-length", mut(dp, 68, bytes.Repeat([]byte{255}, 32)), false, 50252},
+		{"ER-13-sig-overlong", mut(dp, 196, r5Word(2421)), false, 50252},
+		{"bad-signature", mut(p, 100, []byte{p[100] ^ 1}), false, 50240},
+		{"wrong-domain", append(r5HashInput(h, r5Sig(t, sk, "ETH-PQ-TX/v1", h)), make([]byte, 12)...), false, 50240},
+		{"overflow-offset", mut(dp, 36, bytes.Repeat([]byte{255}, 32)), false, 50252},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			evm, s, _, _ := pqRecoveryFixture(t, 100)
+			b := common.HexToAddress("1234")
+			s.SetCode(b, append([]byte{0xef, 1, 1}, pk.Bytes()...), tracing.CodeChangeUnspecified)
+			// Deliberately no Rec entry: R5 is code-only, unlike transaction admission.
+			budget := NewGasBudget(1000000, 0)
+			out, left, err := evm.StaticCall(common.Address{}, b, tc.cd, budget)
+			want := make([]byte, 32)
+			copy(want, []byte{255, 255, 255, 255})
+			if tc.valid {
+				copy(want, tc.cd[:4])
+			}
+			if err != nil || !bytes.Equal(out, want) || left.Used(budget) != tc.gas {
+				t.Fatalf("out=%x gas=%d err=%v", out, left.Used(budget), err)
+			}
+			for _, slot := range []common.Hash{pqAuthoritySlot(b), common.BigToHash(new(uint256.Int).SetBytes(pqAuthoritySlot(b).Bytes()).AddUint64(new(uint256.Int).SetBytes(pqAuthoritySlot(b).Bytes()), 1).ToBig())} {
+				if _, warm := s.SlotInAccessList(evm.chainConfig.PQMigrate.Registry, slot); warm {
+					t.Fatal("R5 accessed registry")
+				}
+			}
+		})
+	}
+}
+
+func TestPQMarkerEntryAndRollback(t *testing.T) {
+	pk, _ := r5Key()
+	marker := append([]byte{0xef, 1, 1}, pk.Bytes()...)
+	for _, kind := range []OpCode{CALL, STATICCALL, CALLCODE, DELEGATECALL} {
+		for _, cd := range [][]byte{nil, {1, 2, 3}, {1, 2, 3, 4}, {0x16, 0x26, 0xba, 0x7e}} {
+			t.Run(fmt.Sprintf("%s/%x", kind, cd), func(t *testing.T) {
+				evm, s, _, _ := pqRecoveryFixture(t, 200)
+				a, b := common.HexToAddress("1111"), common.HexToAddress("2222")
+				s.SetBalance(a, uint256.NewInt(100), tracing.BalanceChangeUnspecified)
+				s.SetCode(b, marker, tracing.CodeChangeUnspecified)
+				budget := NewGasBudget(100000, 0)
+				var out []byte
+				var left GasBudget
+				var err error
+				switch kind {
+				case CALL:
+					out, left, err = evm.Call(a, b, cd, budget, uint256.NewInt(7))
+				case STATICCALL:
+					out, left, err = evm.StaticCall(a, b, cd, budget)
+				case CALLCODE:
+					out, left, err = evm.CallCode(a, b, cd, budget, uint256.NewInt(7))
+				case DELEGATECALL:
+					out, left, err = evm.DelegateCall(a, a, b, cd, budget, uint256.NewInt(7))
+				}
+				wantGas := uint64(0)
+				wantLen := 0
+				if (kind == CALL || kind == STATICCALL) && len(cd) == 4 && cd[0] == 0x16 {
+					wantGas = 50003
+					wantLen = 32
+				}
+				if err != nil || len(out) != wantLen || left.Used(budget) != wantGas {
+					t.Fatalf("out=%x gas=%d err=%v", out, left.Used(budget), err)
+				}
+				wantBal := uint64(0)
+				if kind == CALL {
+					wantBal = 7
+				}
+				if s.GetBalance(b).Uint64() != wantBal || !bytes.Equal(s.GetCode(b), marker) {
+					t.Fatal("balance/code changed incorrectly")
+				}
+			})
+		}
+	}
+	for _, gas := range []uint64{50002, 50003} {
+		t.Run(fmt.Sprintf("OOG/%d", gas), func(t *testing.T) {
+			evm, s, _, _ := pqRecoveryFixture(t, 200)
+			a, b := common.HexToAddress("1111"), common.HexToAddress("2222")
+			s.SetBalance(a, uint256.NewInt(100), tracing.BalanceChangeUnspecified)
+			s.SetCode(b, marker, tracing.CodeChangeUnspecified)
+			out, left, err := evm.Call(a, b, []byte{0x16, 0x26, 0xba, 0x7e}, NewGasBudget(gas, 0), uint256.NewInt(7))
+			if left.ExecutionGas != 0 {
+				t.Fatal("gas")
+			}
+			if gas == 50002 {
+				if err != ErrOutOfGas || len(out) != 0 || s.GetBalance(b).Sign() != 0 {
+					t.Fatal("OOG did not revert value")
+				}
+			} else {
+				if err != nil || len(out) != 32 || s.GetBalance(b).Uint64() != 7 {
+					t.Fatal("exact gas")
+				}
+			}
+		})
+	}
+}
+
+func TestPQMarkerDetectionAndDelegation(t *testing.T) {
+	pk, _ := r5Key()
+	marker := append([]byte{0xef, 1, 1}, pk.Bytes()...)
+	for _, when := range []uint64{99, 100, 199, 200} {
+		for _, kind := range []string{"marker", "delegation", "truncated", "extra", "eip7851", "unknown"} {
+			t.Run(fmt.Sprintf("%d/%s", when, kind), func(t *testing.T) {
+				evm, s, _, _ := pqRecoveryFixture(t, when)
+				a, b := common.HexToAddress("1111"), common.HexToAddress("2222")
+				code := bytes.Clone(marker)
+				switch kind {
+				case "delegation":
+					code = types.AddressToDelegation(b)
+				case "truncated":
+					code = code[:len(code)-1]
+				case "extra":
+					code = append(code, 0)
+				case "eip7851":
+					code = append([]byte{0xef, 1, 1}, b[:]...)
+				case "unknown":
+					code[2] = 255
+				}
+				s.SetCode(b, marker, tracing.CodeChangeUnspecified)
+				s.SetCode(a, code, tracing.CodeChangeUnspecified)
+				_, left, err := evm.Call(common.Address{}, a, nil, NewGasBudget(10000, 0), new(uint256.Int))
+				ok := kind == "marker" && when >= 100 || kind == "delegation" && when >= 200
+				if (err == nil) != ok || (ok && left.ExecutionGas != 10000) {
+					t.Fatalf("err=%v left=%v", err, left)
+				}
+			})
+		}
+	}
+	for _, alg := range []byte{2, 3, 4} {
+		t.Run(fmt.Sprintf("disabled-%d", alg), func(t *testing.T) {
+			evm, s, _, _ := pqRecoveryFixture(t, 100)
+			n, _, price := pqMarkerShape(alg)
+			a := common.HexToAddress("2222")
+			s.SetCode(a, append([]byte{0xef, 1, alg}, make([]byte, n)...), tracing.CodeChangeUnspecified)
+			out, left, err := evm.StaticCall(common.Address{}, a, []byte{0x16, 0x26, 0xba, 0x7e}, NewGasBudget(1000000, 0))
+			if err != nil || !bytes.Equal(out[:4], []byte{255, 255, 255, 255}) || left.ExecutionGas != 1000000-price-3 {
+				t.Fatal("disabled marker")
+			}
+		})
+	}
+}
