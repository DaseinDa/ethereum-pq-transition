+func TestPQPoolProofCacheStateStillRechecked(t *testing.T) {
+	for _, kind := range []string{"nonce", "balance", "base-fee", "signature", "state-unavailable"} {
+		t.Run(kind, func(t *testing.T) {
+			p, c, calls := componentPool(t)
+			tx := componentTx(1, 20, 2, 20)
+			if err := add(p, tx); err != nil {
+				t.Fatal(err)
+			}
+			recovered := p.checkState
+			announced, discovered := make(chan core.NewTxsEvent, 4), make(chan core.NewTxsEvent, 4)
+			defer p.SubscribeTransactions(announced, true).Unsubscribe()
+			defer p.SubscribeTransactions(discovered, false).Unsubscribe()
+			h := types.CopyHeader(p.head)
+			switch kind {
+			case "nonce":
+				k, _ := core.PQRecordSlots(addr(1))
+				w := common.Hash{}
+				w[21] = 1
+				c.s.SetState(c.cfg.PQMigrate.Registry, k, w)
+			case "balance":
+				c.s.SetBalance(addr(20), uint256.NewInt(1), tracing.BalanceChangeUnspecified)
+			case "base-fee":
+				h.BaseFee.SetInt64(1000)
+			case "signature":
+				p.checkState = func(*types.Transaction, *state.StateDB, *types.Header, *params.ChainConfig) error {
+					return &core.PQMigrationError{Name: "BAD_SPONSOR_SIG"}
+				}
+			case "state-unavailable":
+				p.checkState = func(*types.Transaction, *state.StateDB, *types.Header, *params.ChainConfig) error {
+					return ErrLocalUnavailable
+				}
+			}
+			p.Reset(p.head, h)
+			if p.Has(tx.Hash()) || *calls != 1 {
+				t.Fatalf("cached Full bypassed %s or reran Full: calls=%d", kind, *calls)
+			}
+			if p.negativeCache.len() != 0 {
+				t.Fatal("state rejection entered negative Full cache")
+			}
+			if _, n := p.Pending(txpool.PendingFilter{OnlyPQ: true}); n != 0 || p.Get(tx.Hash()) != nil || len(announced)+len(discovered) != 0 {
+				t.Fatal("item offered to a builder, served or announced after its reset")
+			}
+			if kind != "state-unavailable" {
+				// A deterministic failure removes the item; nothing is held for it.
+				if p.deferred[tx.Hash()] != nil {
+					t.Fatalf("deterministic %s failure deferred the item", kind)
+				}
+				return
+			}
+			// Spec section 20.17 (a)-(b): a held item that meets a retryable state
+			// error at reset is deferred. Has reads the pending entries alone, so
+			// the deferred set itself is read.
+			if p.deferred[tx.Hash()] == nil || len(p.deferred) != 1 || NewAPI(p).Lookup(tx.Hash())["status"] != "deferred" {
+				t.Fatalf("held item not in the deferred set after a retryable state error: deferred=%d", len(p.deferred))
+			}
+			if p.sources["rpc:component"].failures != 0 || len(p.bans) != 0 {
+				t.Fatal("local fault at reset charged the source or banned the sponsor")
+			}
+			// Once the state is available again the item is pending at a later head,
+			// from its memoized Full result (section 20.17 (b)-(c)).
+			p.checkState = recovered
+			later := types.CopyHeader(h)
+			later.ParentHash, later.Number, later.Time = h.Hash(), new(big.Int).Add(h.Number, common.Big1), h.Time+12
+			p.Reset(h, later)
+			if !p.Has(tx.Hash()) || len(p.deferred) != 0 {
+				t.Fatal("deferred item not pending again after the state recovered")
+			}
+			if *calls != 1 || p.proofCacheHits != 1 {
+				t.Fatalf("retry repeated Full verification: calls=%d hits=%d", *calls, p.proofCacheHits)
+			}
+			if len(announced) != 1 || len(discovered) != 0 {
+				t.Fatalf("pending again must be announced once as a reinjection: %d/%d", len(announced), len(discovered))
+			}
+		})
+	}
+}
