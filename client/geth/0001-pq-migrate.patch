index 0000000000000000000000000000000000000000..2a90251999259c9826a050ca487d45c90172b2ae
--- /dev/null
+++ b/core/vm/pq_rotate.go
@@ -0,0 +1,163 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package vm
+
+import (
+	"bytes"
+	"encoding/binary"
+	"math"
+	"math/big"
+
+	"github.com/cloudflare/circl/sign/mldsa/mldsa44"
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core/tracing"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/crypto"
+	"github.com/ethereum/go-ethereum/params"
+	"github.com/holiman/uint256"
+)
+
+var pqRotateSelector = []byte{0x26, 0x2f, 0x8a, 0xe0}
+
+func (evm *EVM) isPQRotate(addr common.Address, input []byte) bool {
+	c := evm.chainConfig.PQMigrate
+	return c != nil && evm.Context.Time >= c.T0 && addr == c.Registry && len(input) >= 4 && bytes.Equal(input[:4], pqRotateSelector)
+}
+
+// Strict canonical ABI, section 24.2 rule 2. Bound every word before rounding,
+// narrowing or slicing. The selected research profile enables ML-DSA-44 only.
+func pqDecodeRotate(cd []byte) (pk, sig []byte, ok bool) {
+	if len(cd) < 132 {
+		return nil, nil, false
+	}
+	alg, a := pqABIWord(cd, 4, 255)
+	off, b := pqABIWord(cd, 36, 96)
+	if !a || !b || alg != 1 || off != 96 {
+		return nil, nil, false
+	}
+	l1, a := pqABIWord(cd, 100, len(cd)-132)
+	if !a || l1 != mldsa44.PublicKeySize {
+		return nil, nil, false
+	}
+	p1 := (l1 + 31) / 32 * 32
+	if len(cd) < 164+p1 {
+		return nil, nil, false
+	}
+	off, b = pqABIWord(cd, 68, len(cd))
+	if !b || off != 128+p1 {
+		return nil, nil, false
+	}
+	l2, a := pqABIWord(cd, 132+p1, len(cd)-164-p1)
+	if !a || l2 != mldsa44.SignatureSize {
+		return nil, nil, false
+	}
+	p2 := (l2 + 31) / 32 * 32
+	if len(cd) != 164+p1+p2 {
+		return nil, nil, false
+	}
+	for _, x := range cd[132+l1 : 132+p1] {
+		if x != 0 {
+			return nil, nil, false
+		}
+	}
+	for _, x := range cd[164+p1+l2:] {
+		if x != 0 {
+			return nil, nil, false
+		}
+	}
+	return cd[132 : 132+l1], cd[164+p1 : 164+p1+l2], true
+}
+
+// This runs inside the existing EVM frame snapshot. REVERT rolls back frame
+// effects, including value/access warmth, but not transaction-level activation.
+func (evm *EVM) runPQRotate(kind OpCode, caller, addr common.Address, input []byte, gas GasBudget, value *uint256.Int, readOnly bool) ([]byte, GasBudget, error) {
+	if kind != CALL || !evm.PQRotateEligible || evm.depth != 0 || caller != evm.Origin || readOnly || evm.readOnly || !value.IsZero() {
+		return nil, gas, ErrExecutionReverted
+	}
+	// validatePQ rejects these unimplemented schedules before execution.
+	if !evm.chainRules.IsBerlin || evm.chainRules.IsAmsterdam || evm.chainRules.IsEIP4762 {
+		return nil, gas, ErrExecutionReverted
+	}
+	charge := func(cost uint64) bool {
+		prior, ok := gas.ChargeExecution(cost)
+		if ok && evm.Config.Tracer.HasGasHook() {
+			evm.Config.Tracer.EmitGasChange(prior.AsTracing(), gas.AsTracing(), tracing.GasChangeCallPrecompiledContract)
+		}
+		return ok
+	}
+	var pre [64]byte
+	copy(pre[12:32], caller[:])
+	k0 := crypto.Keccak256Hash(pre[:])
+	k1 := common.BigToHash(new(big.Int).Add(k0.Big(), big.NewInt(1)))
+	var words [2]common.Hash
+	for i, k := range []common.Hash{k0, k1} {
+		_, warm := evm.StateDB.SlotInAccessList(addr, k)
+		cost := uint64(params.WarmStorageReadCostEIP2929)
+		if !warm {
+			cost = params.ColdSloadCostEIP2929
+		}
+		if !charge(cost) {
+			return nil, gas, ErrOutOfGas
+		}
+		if !warm {
+			evm.StateDB.AddSlotToAccessList(addr, k)
+		}
+		words[i] = evm.StateDB.GetState(addr, k)
+	}
+	w, oldCommit := words[0], words[1]
+	mode, alg := w[31], w[30]
+	code := evm.StateDB.GetCode(caller)
+	activated := mode >= 1 && mode <= 3 && alg == 1 && len(code) == 3+mldsa44.PublicKeySize && bytes.Equal(code[:3], []byte{0xef, 1, alg}) && crypto.Keccak256Hash([]byte{alg}, code[3:]) == oldCommit
+	c := evm.chainConfig.PQMigrate
+	start := max(c.T, binary.BigEndian.Uint64(w[22:30]))
+	final := mode == 2 || mode == 3 || (mode == 1 && evm.Context.Time >= start && evm.Context.Time-start >= c.W)
+	if !activated || !final {
+		return nil, gas, ErrExecutionReverted
+	}
+	migrationNonce := binary.BigEndian.Uint64(w[14:22])
+	if migrationNonce == math.MaxUint64 {
+		return nil, gas, ErrExecutionReverted
+	}
+	pk, sig, ok := pqDecodeRotate(input)
+	if !ok {
+		return nil, gas, ErrExecutionReverted
+	}
+	if !charge(50000) {
+		return nil, gas, ErrOutOfGas
+	}
+	// The transaction nonce has already incremented outside this frame.
+	stateNonce := evm.StateDB.GetNonce(caller)
+	if stateNonce == 0 {
+		return nil, gas, ErrExecutionReverted
+	}
+	digestInput := append([]byte("PQ-ROTATE"), common.LeftPadBytes(evm.chainConfig.ChainID.Bytes(), 32)...)
+	digestInput = append(digestInput, caller[:]...)
+	digestInput = binary.BigEndian.AppendUint64(digestInput, stateNonce-1)
+	digestInput = append(digestInput, 1)
+	digestInput = append(digestInput, pk...)
+	digest := crypto.Keccak256Hash(digestInput)
+	const tag = "ETH-PQ-ROTATE-POP/v1"
+	var key mldsa44.PublicKey
+	if key.UnmarshalBinary(pk) != nil || !mldsa44.Verify(&key, append([]byte(tag), digest[:]...), []byte(tag), sig) {
+		return nil, gas, ErrExecutionReverted
+	}
+	commit := crypto.Keccak256Hash([]byte{1}, pk)
+	writeCost := uint64(10000)
+	if commit == oldCommit {
+		writeCost = 7200
+	}
+	if !charge(writeCost + 200*uint64(3+len(pk))) {
+		return nil, gas, ErrOutOfGas
+	}
+	w[30] = 1
+	binary.BigEndian.PutUint64(w[14:22], migrationNonce+1)
+	evm.StateDB.SetState(addr, k0, w)
+	evm.StateDB.SetState(addr, k1, commit)
+	evm.StateDB.SetCode(caller, append([]byte{0xef, 1, 1}, pk...), tracing.CodeChangeUnspecified)
+	data := make([]byte, 64)
+	data[31] = 1
+	copy(data[32:], commit[:])
+	evm.StateDB.AddLog(&types.Log{Address: addr, Topics: []common.Hash{crypto.Keccak256Hash([]byte("Rotated(address,uint8,bytes32)")), common.BytesToHash(caller[:])}, Data: data})
+	return nil, gas, nil
+}
