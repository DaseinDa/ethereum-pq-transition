diff --git a/eth/catalyst/pq_applied_state.go b/eth/catalyst/pq_applied_state.go
new file mode 100644
index 0000000000000000000000000000000000000000..03cc7186953a07eb3d0a80e66db5b3f28947e650
--- /dev/null
+++ b/eth/catalyst/pq_applied_state.go
@@ -0,0 +1,54 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package catalyst
+
+import (
+	"crypto/rand"
+	"errors"
+	"sync"
+
+	"github.com/ethereum/go-ethereum/beacon/engine"
+	"github.com/ethereum/go-ethereum/common"
+)
+
+// This diagnostic is deliberately not called a signing permit. The caller must
+// fence all Engine writers, exclude sync/state-reset paths and hold the CL
+// selection authority until its durable signature reservation has completed.
+// Merely reading this RPC, or setting maxpeers=0, does not establish that fence.
+type PQAppliedState struct {
+	Instance common.Hash              `json:"instance"`
+	Request  common.Hash              `json:"request"`
+	Applied  engine.ForkchoiceStateV1 `json:"applied"`
+}
+
+var pqInstance = sync.OnceValue(func() common.Hash {
+	var id common.Hash
+	if _, err := rand.Read(id[:]); err != nil {
+		panic(err)
+	}
+	return id
+})
+
+// PqAppliedStateV1 returns one snapshot under both Engine operation locks and
+// the blockchain mutation lock, rather than three independent eth_* reads.
+// A process restart necessarily changes Instance. This method is on the JWT
+// authenticated Engine service and does not select a chain or modify finality.
+func (api *ConsensusAPI) PqAppliedStateV1(request common.Hash, expected engine.ForkchoiceStateV1) (PQAppliedState, error) {
+	if request == (common.Hash{}) || expected.HeadBlockHash == (common.Hash{}) || expected.SafeBlockHash == (common.Hash{}) || expected.FinalizedBlockHash == (common.Hash{}) {
+		return PQAppliedState{}, errors.New("explicit nonzero request and all three targets required")
+	}
+	api.forkchoiceLock.Lock()
+	defer api.forkchoiceLock.Unlock()
+	api.newPayloadLock.Lock()
+	defer api.newPayloadLock.Unlock()
+	head, safe, finalized, err := api.eth.BlockChain().PQAppliedExecutionHeads()
+	if err != nil {
+		return PQAppliedState{}, err
+	}
+	actual := engine.ForkchoiceStateV1{HeadBlockHash: head, SafeBlockHash: safe, FinalizedBlockHash: finalized}
+	if actual != expected {
+		return PQAppliedState{}, errors.New("requested forkchoice is not the applied forkchoice")
+	}
+	return PQAppliedState{Instance: pqInstance(), Request: request, Applied: actual}, nil
+}
diff --git a/eth/catalyst/pq_applied_state_test.go b/eth/catalyst/pq_applied_state_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..6353b62c3b3e133bc6840a3d476622e5f97660ac
--- /dev/null
+++ b/eth/catalyst/pq_applied_state_test.go
@@ -0,0 +1,79 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package catalyst
+
+import (
+	"context"
+	"github.com/ethereum/go-ethereum/beacon/engine"
+	"github.com/ethereum/go-ethereum/common"
+	"testing"
+	"time"
+)
+
+func TestPQAppliedStateRejectsIgnoredVALID(t *testing.T) {
+	genesis, blocks := generateMergeChain(10, true)
+	n, backend := startEthService(t, genesis, blocks)
+	defer n.Close()
+	api := newConsensusAPIWithoutHeartbeat(backend)
+	selected := engine.ForkchoiceStateV1{HeadBlockHash: blocks[9].Hash(), SafeBlockHash: blocks[7].Hash(), FinalizedBlockHash: blocks[7].Hash()}
+	if _, err := api.ForkchoiceUpdatedV3(context.Background(), selected, nil); err != nil {
+		t.Fatal(err)
+	}
+	request := common.HexToHash("0x01")
+	observed, err := api.PqAppliedStateV1(request, selected)
+	if err != nil || observed.Request != request || observed.Applied != selected || observed.Instance == (common.Hash{}) {
+		t.Fatalf("bad snapshot: %+v %v", observed, err)
+	}
+	old := engine.ForkchoiceStateV1{HeadBlockHash: blocks[2].Hash(), SafeBlockHash: blocks[2].Hash(), FinalizedBlockHash: blocks[2].Hash()}
+	response, err := api.ForkchoiceUpdatedV3(context.Background(), old, nil)
+	if err != nil || response.PayloadStatus.Status != engine.VALID || *response.PayloadStatus.LatestValidHash != old.HeadBlockHash {
+		t.Fatalf("ignored VALID precondition not reproduced: %+v %v", response, err)
+	}
+	if _, err := api.PqAppliedStateV1(request, old); err == nil {
+		t.Fatal("ignored VALID must not become applied-state evidence")
+	}
+	if after, err := api.PqAppliedStateV1(request, selected); err != nil || after.Applied != selected {
+		t.Fatal("original actual pointers lost", err)
+	}
+	t.Log("reproduced VALID/latestValidHash for unapplied head; coherent snapshot rejected it")
+}
+
+func TestPQAppliedStateSerializesWithForkchoice(t *testing.T) {
+	genesis, blocks := generateMergeChain(3, true)
+	n, backend := startEthService(t, genesis, blocks)
+	defer n.Close()
+	api := newConsensusAPIWithoutHeartbeat(backend)
+	target := engine.ForkchoiceStateV1{HeadBlockHash: blocks[2].Hash(), SafeBlockHash: blocks[0].Hash(), FinalizedBlockHash: blocks[0].Hash()}
+	if _, err := api.ForkchoiceUpdatedV3(context.Background(), target, nil); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := api.PqAppliedStateV1(common.Hash{}, target); err == nil {
+		t.Fatal("zero request accepted")
+	}
+	api.forkchoiceLock.Lock()
+	done := make(chan error, 1)
+	go func() { _, err := api.PqAppliedStateV1(common.HexToHash("0x02"), target); done <- err }()
+	select {
+	case err := <-done:
+		api.forkchoiceLock.Unlock()
+		t.Fatalf("observation crossed held forkchoice lock: %v", err)
+	case <-time.After(30 * time.Millisecond):
+	}
+	api.forkchoiceLock.Unlock()
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("observation did not resume")
+	}
+}
+
+func TestPQAppliedInstance(t *testing.T) {
+	if pqInstance() == (common.Hash{}) || pqInstance() != pqInstance() {
+		t.Fatal("process identity invalid")
+	}
+	t.Log("PQ_INSTANCE", pqInstance().Hex())
+}
