+func TestPQFinalStateRecheckAndLocalFailure(t *testing.T) {
+	s, evm, h := finalStateEnv(t, common.HexToAddress("900"))
+	tx := finalStateSign(t, finalStateCarrier(), 0x22)
+	if e := ValidatePQMigrateState(tx, s.Copy(), h, evm.ChainConfig()); e != nil {
+		t.Fatal(e)
+	}
+	s.SetBalance(finalStateSponsor, uint256.NewInt(1), tracing.BalanceChangeUnspecified)
+	before := s.IntermediateRoot(evm.GetRules())
+	gp := NewGasPool(h.GasLimit)
+	s.SetTxContext(tx.Hash(), 2, 3)
+	if _, _, e := ApplyTransaction(context.Background(), evm, gp, s, h, tx); e == nil || !strings.Contains(e.Error(), "INSUFFICIENT_FEE_BALANCE") {
+		t.Fatalf("state recheck %v", e)
+	}
+	if s.IntermediateRoot(evm.GetRules()) != before || gp.Used() != 0 {
+		t.Fatal("failed balance recheck charged/wrote")
+	}
+	s.SetBalance(finalStateSponsor, uint256.NewInt(5000000000000000000), tracing.BalanceChangeUnspecified)
+	before = s.IntermediateRoot(evm.GetRules())
+	old := pqFinalLibrary
+	defer func() { pqFinalLibrary = old }()
+	pqFinalLibrary.verify = func([]byte, []byte) int { return 3 }
+	s.SetTxContext(tx.Hash(), 2, 3)
+	if _, _, e := ApplyTransaction(context.Background(), evm, gp, s, h, tx); !errors.Is(e, ErrPQFullUnavailable) {
+		t.Fatalf("local failure incorrectly classified: %v", e)
+	}
+	if s.IntermediateRoot(evm.GetRules()) != before || gp.Used() != 0 || len(s.GetLogs(tx.Hash(), 1, common.Hash{}, h.Time)) != 0 {
+		t.Fatal("local failure charged/wrote/logged")
+	}
+}
+func TestPQFinalStateOrderedErrors(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		want uint16
+	}{
+		{"proof-bound-before-alg", 0x0008}, {"activation-before-expiry", 0x0106}, {"expiry-before-balance", 0x0309},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			s, evm, h := finalStateEnv(t, common.Address{})
+			p := finalStateCarrier()
+			switch tc.name {
+			case "proof-bound-before-alg":
+				p.ProofCarrier.Proof = make([]byte, params.PQFinalMaxProofBytes+1)
+				p.AlgID = 2
+			case "activation-before-expiry":
+				s.SetCode(finalStateSponsor, nil, tracing.CodeChangeUnspecified)
+				p.SponsorOption.ValidUntil = h.Time - 1
+			case "expiry-before-balance":
+				p.SponsorOption.ValidUntil = h.Time - 1
+				s.SetBalance(finalStateSponsor, new(uint256.Int), tracing.BalanceChangeUnspecified)
+			}
+			err := ValidatePQMigrateState(finalStateSign(t, p, 0x22), s, h, evm.ChainConfig())
+			var failure *PQMigrationError
+			if !errors.As(err, &failure) || failure.Code != tc.want {
+				t.Fatalf("want %04x got %v", tc.want, err)
+			}
+		})
+	}
+}
