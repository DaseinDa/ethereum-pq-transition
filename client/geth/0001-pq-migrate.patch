new file mode 100644
index 0000000000000000000000000000000000000000..6090fcc5434000c258d70eedd016f7834a7735b3
--- /dev/null
+++ b/core/vm/pq_authority.go
@@ -0,0 +1,91 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package vm
+
+import (
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core/tracing"
+	"github.com/ethereum/go-ethereum/crypto"
+	"github.com/ethereum/go-ethereum/params"
+)
+
+// pqAuthorityPrecompile installs the stateful research ecrecover retirement gate.
+// This object must be scoped to this EVM, never to the global precompile maps.
+func (evm *EVM) pqAuthorityPrecompile(addr common.Address) (PrecompiledContract, bool) {
+	cfg := evm.chainConfig.PQMigrate
+	if cfg == nil || evm.Context.Time < cfg.T0 || addr != common.BytesToAddress([]byte{1}) {
+		return nil, false
+	}
+	return &pqECRecover{evm: evm, recovery: &ecrecover{}}, true
+}
+
+type pqECRecover struct {
+	evm      *EVM
+	recovery PrecompiledContract
+}
+
+// PQDelegationSuspended controls execution resolution only. EXTCODE* keeps
+// observing the original EIP-7702 designator stored in StateDB.
+func (evm *EVM) PQDelegationSuspended() bool {
+	cfg := evm.chainConfig.PQMigrate
+	return cfg != nil && evm.Context.Time >= cfg.T
+}
+
+// pqAuthoritySlot is Rec[authority].slot0 in the system registry mapping.
+func pqAuthoritySlot(authority common.Address) common.Hash {
+	var preimage [64]byte
+	copy(preimage[12:32], authority[:])
+	return crypto.Keccak256Hash(preimage[:])
+}
+
+// RequiredGas must not recover a signature or inspect state: the dispatcher calls
+// it before checking whether the caller can pay even the base recovery charge.
+func (p *pqECRecover) RequiredGas(input []byte) uint64 {
+	return params.EcrecoverGas
+}
+
+// Run is the unmetered PrecompiledContract entry point. EVM execution always uses
+// RunWithGas after charging RequiredGas; keep direct component callers equivalent
+// to the other precompiles' unmetered Run methods.
+func (p *pqECRecover) Run(input []byte) ([]byte, error) {
+	output, _, err := p.RunWithGas(input, NewGasBudget(^uint64(0), 0), nil)
+	return output, err
+}
+
+// RunWithGas is called only after the fixed 3000 gas recovery charge was paid.
+// Recover once, then charge the state-read cost before reading or warming Rec.
+func (p *pqECRecover) RunWithGas(input []byte, gas GasBudget, logger *tracing.Hooks) ([]byte, GasBudget, error) {
+	cfg := p.evm.chainConfig.PQMigrate
+	if p.evm.Context.Time >= cfg.T {
+		return nil, gas, nil
+	}
+	output, err := p.recovery.Run(input)
+	if err != nil || len(output) == 0 {
+		return output, gas, err
+	}
+	key := pqAuthoritySlot(common.BytesToAddress(output))
+	_, warm := p.evm.StateDB.SlotInAccessList(cfg.Registry, key)
+	readGas := params.ColdSloadCostEIP2929
+	if warm {
+		readGas = params.WarmStorageReadCostEIP2929
+	}
+	prior, ok := gas.ChargeExecution(readGas)
+	if !ok {
+		return nil, gas, ErrOutOfGas
+	}
+	if logger.HasGasHook() {
+		logger.EmitGasChange(prior.AsTracing(), gas.AsTracing(), tracing.GasChangeCallPrecompiledContract)
+	}
+	p.evm.StateDB.AddSlotToAccessList(cfg.Registry, key)
+	if p.evm.StateDB.GetState(cfg.Registry, key)[31] != 0 {
+		return nil, gas, nil
+	}
+	return output, gas, nil
+}
+
+func (*pqECRecover) Name() string { return "PQ_ECRECOVER" }
+
+// A signature alone does not identify the result: Rec and block time also
+// affect it. This precompile is deliberately excluded from the pure-result cache.
+func (*pqECRecover) Cacheable() bool { return false }
