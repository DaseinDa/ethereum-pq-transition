+			}
+		})
+	}
+	for _, v := range []struct {
+		name    string
+		mode    uint8
+		same    bool
+		atEnd   bool
+		wantGas uint64
+		wantErr string
+	}{
+		{"override_changed", 1, false, false, 10000, ""}, {"override_same", 1, true, false, 7200, ""}, {"recommit_changed", 2, false, false, 10000, ""}, {"recommit_same", 2, true, false, 7200, ""}, {"override_at_end", 1, false, true, 0, "OVERRIDE_WINDOW_CLOSED"},
+	} {
+		t.Run(v.name, func(t *testing.T) {
+			ss := s.Copy()
+			hh := *h
+			p := fullStateOnlyCarrier()
+			p.MigrationNonce = 1
+			commit := common.HexToHash("99")
+			if v.same {
+				commit = fullCommit
+			}
+			r := PQRecord{Mode: v.mode, AlgID: 1, EnrolledAt: h.Time - 100, MigrationNonce: 1, Commit: commit}
+			writePQRecord(ss, cfg.PQMigrate.Registry, fullLegacy, r)
+			if v.atEnd {
+				hh.Time = cfg.PQMigrate.T + cfg.PQMigrate.W
+				p.Expiry = hh.Time
+				p.SponsorOption.ValidUntil = hh.Time
+				cfg.PQMigrate.FullResearch.Sunset = hh.Time + 1
+			}
+			plan, e := validatePQMigrateState(fullSign(t, p, 0x22), ss, &hh, cfg)
+			if v.wantErr != "" {
+				if e == nil || !strings.Contains(e.Error(), v.wantErr) {
+					t.Fatal(e)
+				}
+				return
+			}
+			if e != nil {
+				t.Fatal(e)
+			}
+			gas := pqColdWriteGas(pqRecordWord(r), pqRecordWord(plan.next)) + pqColdWriteGas(r.Commit, plan.next.Commit)
+			if gas != v.wantGas || plan.next.EnrolledAt != r.EnrolledAt || plan.next.MigrationNonce != 2 {
+				t.Fatalf("cold gas/record %d %+v", gas, plan.next)
+			}
+		})
+	}
+}
