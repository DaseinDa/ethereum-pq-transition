+	}
+	hash := crypto.Keccak256([]byte("PQ research R3 component vector"))
+	sig, err := crypto.Sign(hash, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	input := make([]byte, 128)
+	copy(input, hash)
+	input[63] = 27 + sig[64]
+	copy(input[64:96], sig[:32])
+	copy(input[96:], sig[32:64])
+	return evm, s, input, crypto.PubkeyToAddress(key.PublicKey)
+}
+
+func TestPQAuthorityColdWarmAndCache(t *testing.T) {
+	evm, s, input, authority := pqRecoveryFixture(t, 100)
+	p, ok := evm.pqAuthorityPrecompile(common.HexToAddress("1"))
+	if !ok {
+		t.Fatal("missing R3 dispatcher")
+	}
+	registry := evm.chainConfig.PQMigrate.Registry
+	slot := pqAuthoritySlot(authority)
+	if p.RequiredGas(input) != 3000 {
+		t.Fatal("up-front recovery gas")
+	}
+	if _, warm := s.SlotInAccessList(registry, slot); warm {
+		t.Fatal("gas estimation warmed slot")
+	}
+	cache := NewPrecompileCache()
+	for i, wantGas := range []uint64{5100, 3100} {
+		budget := NewGasBudget(10000, 0)
+		out, left, err := RunPrecompiledContract(s, p, common.HexToAddress("1"), input, budget, nil, evm.chainRules, cache)
+		if err != nil || !bytes.Equal(out, common.LeftPadBytes(authority[:], 32)) || left.Used(budget) != wantGas {
+			t.Fatalf("call %d: out=%x gas=%d err=%v", i, out, left.Used(budget), err)
+		}
+	}
+	s.SetState(registry, slot, common.Hash{31: 1})
+	budget := NewGasBudget(10000, 0)
+	out, left, err := RunPrecompiledContract(s, p, common.HexToAddress("1"), input, budget, nil, evm.chainRules, cache)
+	if err != nil || len(out) != 0 || left.Used(budget) != 3100 {
+		t.Fatalf("cached legacy recovery bypassed retirement: %x %v", out, err)
+	}
+	if _, ok := precompileCacheKey(p, input); ok {
+		t.Fatal("stateful recovery cacheable")
+	}
+	t.Log("preT successful recovery: cold=5100, warm=3100; nonLEGACY gives empty at warm=3100; pure cache bypassed")
+}
+
+func TestPQAuthorityBoundaryInvalidAndOutOfGas(t *testing.T) {
+	for _, timestamp := range []uint64{99, 100, 199, 200, 201} {
+		t.Run(new(big.Int).SetUint64(timestamp).String(), func(t *testing.T) {
+			evm, s, input, authority := pqRecoveryFixture(t, timestamp)
+			registry, slot := evm.chainConfig.PQMigrate.Registry, pqAuthoritySlot(authority)
+			p, _ := evm.precompile(common.HexToAddress("1"))
+			want := uint64(5100)
+			if timestamp < 100 || timestamp >= 200 {
+				want = 3000
+			}
+			if p.RequiredGas(input) != 3000 {
+				t.Fatalf("up-front boundary gas %d", p.RequiredGas(input))
+			}
+			budget := NewGasBudget(10000, 0)
+			out, left, err := evm.StaticCall(common.HexToAddress("900"), common.HexToAddress("1"), input, budget)
+			if err != nil || left.Used(budget) != want || (len(out) == 0) != (timestamp >= 200) {
+				t.Fatalf("boundary output %x gas=%d err=%v", out, left.Used(budget), err)
+			}
+			_, warm := s.SlotInAccessList(registry, slot)
+			if warm != (timestamp >= 100 && timestamp < 200) {
+				t.Fatalf("boundary warmth=%v", warm)
+			}
+		})
+	}
+	for _, inputKind := range []string{"empty", "invalid-v", "zero-r"} {
+		t.Run(inputKind, func(t *testing.T) {
+			evm, s, input, authority := pqRecoveryFixture(t, 100)
+			switch inputKind {
+			case "empty":
+				input = nil
+			case "invalid-v":
+				input[63] = 29
+			case "zero-r":
+				clear(input[64:96])
+			}
+			budget := NewGasBudget(10000, 0)
+			out, left, err := evm.Call(common.HexToAddress("900"), common.HexToAddress("1"), input, budget, new(uint256.Int))
+			if err != nil || len(out) != 0 || left.Used(budget) != 3000 {
+				t.Fatalf("invalid: out=%x gas=%d err=%v", out, left.Used(budget), err)
+			}
+			if _, warm := s.SlotInAccessList(evm.chainConfig.PQMigrate.Registry, pqAuthoritySlot(authority)); warm {
+				t.Fatal("invalid recovery read Rec")
+			}
+		})
+	}
+	evm, s, input, authority := pqRecoveryFixture(t, 100)
+	out, left, err := evm.Call(common.HexToAddress("900"), common.HexToAddress("1"), input, NewGasBudget(5099, 0), new(uint256.Int))
+	if !errors.Is(err, ErrOutOfGas) || len(out) != 0 || left.ExecutionGas != 0 {
+		t.Fatalf("OOG: %x %s %v", out, left, err)
+	}
+	if _, warm := s.SlotInAccessList(evm.chainConfig.PQMigrate.Registry, pqAuthoritySlot(authority)); warm {
+		t.Fatal("OOG warmed Rec")
+	}
+}
+
+func TestPQAuthorityAllCallKinds(t *testing.T) {
+	for _, kind := range []string{"CALL", "STATICCALL", "CALLCODE", "DELEGATECALL"} {
+		t.Run(kind, func(t *testing.T) {
+			evm, s, input, authority := pqRecoveryFixture(t, 100)
+			s.SetState(evm.chainConfig.PQMigrate.Registry, pqAuthoritySlot(authority), common.Hash{31: 2})
+			budget := NewGasBudget(10000, 0)
+			from, to := common.HexToAddress("900"), common.HexToAddress("1")
+			var out []byte
+			var left GasBudget
+			var err error
+			switch kind {
+			case "CALL":
+				out, left, err = evm.Call(from, to, input, budget, new(uint256.Int))
+			case "STATICCALL":
+				out, left, err = evm.StaticCall(from, to, input, budget)
+			case "CALLCODE":
+				out, left, err = evm.CallCode(from, to, input, budget, new(uint256.Int))
+			case "DELEGATECALL":
+				out, left, err = evm.DelegateCall(from, from, to, input, budget, new(uint256.Int))
+			}
+			if err != nil || len(out) != 0 || left.Used(budget) != 5100 {
+				t.Fatalf("retirement bypass: out=%x gas=%d err=%v", out, left.Used(budget), err)
+			}
+		})
+	}
+}
+
+func TestPQAuthorityDelegationSuspended(t *testing.T) {
+	for _, timestamp := range []uint64{199, 200} {
+		for _, kind := range []string{"CALL", "STATICCALL", "CALLCODE", "DELEGATECALL"} {
+			t.Run(new(big.Int).SetUint64(timestamp).String()+"/"+kind, func(t *testing.T) {
+				evm, s, _, _ := pqRecoveryFixture(t, timestamp)
+				from, to, target := common.HexToAddress("900"), common.HexToAddress("a00"), common.HexToAddress("b00")
+				designator := types.AddressToDelegation(target)
+				s.SetCode(to, designator, tracing.CodeChangeUnspecified)
+				s.SetCode(target, common.FromHex("602a60005260206000f3"), tracing.CodeChangeUnspecified)
+				budget := NewGasBudget(10000, 0)
+				var out []byte
+				var err error
+				switch kind {
+				case "CALL":
+					out, _, err = evm.Call(from, to, nil, budget, new(uint256.Int))
+				case "STATICCALL":
+					out, _, err = evm.StaticCall(from, to, nil, budget)
+				case "CALLCODE":
+					out, _, err = evm.CallCode(from, to, nil, budget, new(uint256.Int))
+				case "DELEGATECALL":
+					out, _, err = evm.DelegateCall(from, from, to, nil, budget, new(uint256.Int))
+				}
+				if err != nil {
+					t.Fatal(err)
+				}
+				if timestamp < 200 {
+					if len(out) != 32 || out[31] != 42 {
+						t.Fatalf("preT delegate not executed: %x", out)
+					}
+				} else if len(out) != 0 {
+					t.Fatalf("postT delegate executed: %x", out)
+				}
+				if !bytes.Equal(s.GetCode(to), designator) || s.GetCodeHash(to) != crypto.Keccak256Hash(designator) {
+					t.Fatal("suspension changed stored designator/EXTCODE view")
+				}
+			})
+		}
+	}
+}
+
+func TestPQAuthorityDelegationTargetAccess(t *testing.T) {
+	for _, timestamp := range []uint64{199, 200} {
+		t.Run(new(big.Int).SetUint64(timestamp).String(), func(t *testing.T) {
+			evm, s, _, _ := pqRecoveryFixture(t, timestamp)
+			from, callee, delegator, target := common.HexToAddress("900"), common.HexToAddress("901"), common.HexToAddress("a00"), common.HexToAddress("b00")
+			s.SetCode(delegator, types.AddressToDelegation(target), tracing.CodeChangeUnspecified)
+			s.SetCode(target, common.FromHex("602a60005260206000f3"), tracing.CodeChangeUnspecified)
+			// Real CALL opcode: output[0:32] := CALL(delegator, gas=65535), then return it.
+			code := append(common.FromHex("6020600060006000600073"), delegator[:]...)
+			code = append(code, common.FromHex("61fffff160206000f3")...)
+			s.SetCode(callee, code, tracing.CodeChangeUnspecified)
+			out, _, err := evm.Call(from, callee, nil, NewGasBudget(100000, 0), new(uint256.Int))
+			if err != nil || len(out) != 32 {
+				t.Fatalf("nested CALL %x %v", out, err)
+			}
+			want := byte(42)
+			if timestamp >= 200 {
+				want = 0
+			}
+			if out[31] != want {
+				t.Fatalf("nested result %x", out)
+			}
+			if s.AddressInAccessList(target) != (timestamp < 200) {
+				t.Fatal("suspended target was accessed/warmed")
+			}
+		})
+	}
+}
diff --git a/core/vm/pq_fact_registry.go b/core/vm/pq_fact_registry.go
new file mode 100644
index 0000000000000000000000000000000000000000..3b7a72151dd953da3dea78bbe5486d5f4acb040a
--- /dev/null
+++ b/core/vm/pq_fact_registry.go
@@ -0,0 +1,93 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package vm
+
+import (
+	"bytes"
+	"encoding/binary"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core/tracing"
+	"github.com/holiman/uint256"
+)
+
+// pqFactRegisterSelector is a literal protocol selector, not a Solidity ABI
+// selector. The sole internal encoding is "PQF1" || u32_be(version) || fact32.
+// The public statement verifier continues to take u16_be(type) || statement.
+var pqFactRegisterSelector = [4]byte{0x50, 0x51, 0x46, 0x31}
+
+func (evm *EVM) isPQFactRegistry(addr common.Address) bool {
+	p := evm.chainConfig.PQMigrate
+	return p != nil && p.FactRegistry != (common.Address{}) && addr == p.FactRegistry && evm.Context.Time >= p.T0
+}
+
+// runPQFactRegistry executes inside the existing CALL-family snapshot. It is a
+// privileged write gate, NOT VerifyStatement or a proof verifier. Authorization
+// depends on an immutable version-specific verifier image whose successful
+// predicate computes fact = keccak256(u32(v) || u16(type) || statement). A pinned
+// verifier must neither expose arbitrary registration nor delegate untrusted
+// code. No production Route B version is enabled in this research checkout.
+//
+// Fixed-size decoding, configuration lookup, and code-identity comparisons are
+// bounded native dispatch checks with no additional gas item. The invoking EVM
+// CALL accounts for address access, memory, value handling, and EIP-150. This
+// frame accounts exactly for SLOAD then SSTORE using EIP-2200/2929, never a second
+// flat W_fact. No input hash or statement verification is performed here.
+func (evm *EVM) runPQFactRegistry(kind OpCode, caller, addr common.Address, input []byte, gas GasBudget, value *uint256.Int, readOnly bool) ([]byte, GasBudget, error) {
+	if (kind != CALL && kind != STATICCALL) || !value.IsZero() || len(input) != 40 || !bytes.Equal(input[:4], pqFactRegisterSelector[:]) {
+		return nil, gas, ErrExecutionReverted
+	}
+	// This component implements the explicitly selected Osaka schedule. A later
+	// state-gas or state-tree schedule needs its own specified integration.
+	if !evm.chainRules.IsBerlin || evm.chainRules.IsAmsterdam || evm.chainRules.IsEIP4762 {
+		return nil, gas, ErrExecutionReverted
+	}
+	version := binary.BigEndian.Uint32(input[4:8])
+	v, ok := evm.chainConfig.PQMigrate.FactVerifiers[version]
+	now := evm.Context.Time
+	if !ok || now == 0 || now < v.Activation || now >= v.Sunset || caller != v.Address || v.CodeHash == (common.Hash{}) || evm.StateDB.GetCodeHash(caller) != v.CodeHash {
+		return nil, gas, ErrExecutionReverted
+	}
+	fact := common.BytesToHash(input[8:])
+	contract := NewContract(caller, addr, value, gas, evm.jumpDests)
+	stack := evm.arena.stack()
+	defer stack.release()
+	var key uint256.Int
+	key.SetBytes(fact[:])
+	stack.push(&key)
+	loadCost, err := gasSLoadEIP2929(evm, contract, stack, nil, 0)
+	if err != nil {
+		return nil, contract.Gas, err
+	}
+	if !contract.chargeExecution(loadCost.ExecutionGas, evm.Config.Tracer, tracing.GasChangeUnspecified) {
+		return nil, contract.Gas, ErrOutOfGas
+	}
+	old := evm.StateDB.GetState(addr, fact)
+	// Only canonical u64 words are meaningful. A future timestamp remains live;
+	// subtraction instead of registered+TTL avoids uint64 overflow.
+	registered := binary.BigEndian.Uint64(old[24:])
+	if !bytes.Equal(old[:24], make([]byte, 24)) || (registered != 0 && (now <= registered || now-registered <= v.TTL)) {
+		return nil, contract.Gas, ErrExecutionReverted
+	}
+	if readOnly || evm.readOnly {
+		return nil, contract.Gas, ErrWriteProtection
+	}
+	// Reuse the client gas function, including its 2300-gas sentry, access-list
+	// journaling, original/current-value handling and refunds. The allowed
+	// zero->timestamp / expired->timestamp writes have no clearing refund.
+	stack.pop1()
+	var timestamp uint256.Int
+	timestamp.SetUint64(now)
+	stack.push(&timestamp)
+	stack.push(&key)
+	writeCost, err := gasSStoreEIP3529(evm, contract, stack, nil, 0)
+	if err != nil {
+		return nil, contract.Gas, err
+	}
+	if !contract.chargeExecution(writeCost.ExecutionGas, evm.Config.Tracer, tracing.GasChangeUnspecified) {
+		return nil, contract.Gas, ErrOutOfGas
+	}
+	evm.StateDB.SetState(addr, fact, common.Hash(timestamp.Bytes32()))
+	return bytes.Clone(fact[:]), contract.Gas, nil
+}
diff --git a/core/vm/pq_fact_registry_test.go b/core/vm/pq_fact_registry_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..07831bb6cce7cdfb6cac64cc47e5111870683c35
--- /dev/null
+++ b/core/vm/pq_fact_registry_test.go
@@ -0,0 +1,453 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package vm
+
+import (
+	"bytes"
+	"encoding/binary"
+	"errors"
+	"math"
+	"math/big"
+	"testing"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core/state"
+	"github.com/ethereum/go-ethereum/core/tracing"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/crypto"
+	"github.com/ethereum/go-ethereum/params"
+	"github.com/holiman/uint256"
+)
+
+var (
+	pqTestRegistry = common.HexToAddress("0x0801")
+	pqTestVerifier = common.HexToAddress("0x0888")
+	pqTestSender   = common.HexToAddress("0x0100")
+	pqTestFact     = crypto.Keccak256Hash([]byte{0, 0, 0, 1, 0, 1, 42})
+)
+
+// These tests execute real geth EVM bytecode against StateDB. The deliberately
+// tiny public predicate (type=1, one payload byte=42) IS NOT a STARK, a full
+// migration relation, or an enabled production Route B verifier.
+type pqToyAssembler struct {
+	code []byte
+	fail []int
+}
+
+func (p *pqToyAssembler) op(ops ...OpCode) {
+	for _, op := range ops {
+		p.code = append(p.code, byte(op))
+	}
+}
+
+func (p *pqToyAssembler) push(b []byte) {
+	p.code = append(p.code, byte(PUSH1)+byte(len(b))-1)
+	p.code = append(p.code, b...)
+}
+
+func (p *pqToyAssembler) n(n byte) { p.push([]byte{n}) }
+
+func (p *pqToyAssembler) require() {
+	p.op(ISZERO, PUSH2)
+	p.fail = append(p.fail, len(p.code))
+	p.code = append(p.code, 0, 0, byte(JUMPI))
+}
+
+func (p *pqToyAssembler) finish() []byte {
+	dest := len(p.code)
+	p.op(JUMPDEST)
+	p.n(0)
+	p.n(0)
+	p.op(REVERT)
+	for _, fix := range p.fail {
+		binary.BigEndian.PutUint16(p.code[fix:fix+2], uint16(dest))
+	}
+	return p.code
+}
+
+func pqToyVerifier(revertParent, catchDuplicate bool) []byte {
+	return pqToyVerifierCall(CALL, 0, revertParent, catchDuplicate)
+}
+
+func pqToyVerifierCall(kind OpCode, value byte, revertParent, catchDuplicate bool) []byte {
+	p := new(pqToyAssembler)
+	p.op(ADDRESS)
+	p.push(pqTestVerifier[:])
+	p.op(EQ)
+	p.require()
+	p.op(CALLVALUE, ISZERO)
+	p.require()
+	p.op(CALLDATASIZE)
+	p.n(3)
+	p.op(EQ)
+	p.require()
+	p.n(0)
+	p.op(CALLDATALOAD)
+	p.n(232)
+	p.op(SHR)
+	p.push([]byte{0, 1, 42})
+	p.op(EQ)
+	p.require()
+	// Hash precisely u32(version=1) || public u16(type) || payload.
+	p.n(1)
+	p.n(224)
+	p.op(SHL)
+	p.n(0)
+	p.op(MSTORE)
+	p.n(3)
+	p.n(0)
+	p.n(4)
+	p.op(CALLDATACOPY)
+	p.n(7)
+	p.n(0)
+	p.op(KECCAK256)
+	// The fixed internal message is separate from the public predicate input.
+	p.push([]byte{0x50, 0x51, 0x46, 0x31, 0, 0, 0, 1})
+	p.n(192)
+	p.op(SHL)
+	p.n(0)
+	p.op(MSTORE)
+	p.n(8)
+	p.op(MSTORE)
+	call := func() {
+		p.n(32)
+		p.n(64)
+		p.n(40)
+		p.n(0)
+		if kind == CALL || kind == CALLCODE {
+			p.n(value)
+		}
+		p.push(pqTestRegistry[:])
+		p.op(GAS, kind)
+	}
+	call()
+	p.require()
+	if catchDuplicate {
+		call()
+		p.op(ISZERO)
+		p.require()
+	}
+	if revertParent {
+		p.n(0)
+		p.n(0)
+		p.op(REVERT)
+	} else {
+		p.n(32)
+		p.n(64)
+		p.op(RETURN)
+	}
+	return p.finish()
+}
+
+func pqTestEVM(t *testing.T, code []byte, old common.Hash, warmSlot, warmAccount bool) (*EVM, *state.StateDB) {
+	t.Helper()
+	cfg := *params.MergedTestChainConfig
+	cfg.ShanghaiTime, cfg.CancunTime, cfg.PragueTime, cfg.OsakaTime = new(uint64), new(uint64), new(uint64), new(uint64)
+	cfg.AmsterdamTime, cfg.BogotaTime, cfg.UBTTime = nil, nil, nil
+	cfg.PQMigrate = &params.PQMigrateConfig{T0: 1, FactRegistry: pqTestRegistry, FactVerifiers: map[uint32]params.PQFactVerifierConfig{
+		1: {Address: pqTestVerifier, CodeHash: crypto.Keccak256Hash(code), Activation: 1, Sunset: math.MaxUint64, TTL: 99},
+	}}
+	db, err := state.New(types.EmptyRootHash, state.NewDatabaseForTesting())
+	if err != nil {
+		t.Fatal(err)
+	}
+	db.SetCode(pqTestRegistry, []byte{byte(STOP)}, tracing.CodeChangeUnspecified)
+	db.SetNonce(pqTestRegistry, 1, tracing.NonceChangeUnspecified)
+	db.SetCode(pqTestVerifier, code, tracing.CodeChangeUnspecified)
+	db.SetState(pqTestRegistry, pqTestFact, old)
+	db.AddBalance(pqTestVerifier, uint256.NewInt(100), tracing.BalanceChangeUnspecified)
+	db.AddBalance(pqTestSender, uint256.NewInt(100), tracing.BalanceChangeUnspecified)
+	db.Finalise(params.Rules{IsEIP158: true})
+	ctx := BlockContext{
+		CanTransfer: func(db StateDB, from common.Address, value *uint256.Int) bool {
+			return db.GetBalance(from).Cmp(value) >= 0
+		},
+		Transfer: func(db StateDB, from, to common.Address, value *uint256.Int, _ *params.Rules) {
+			db.SubBalance(from, value, tracing.BalanceChangeTransfer)
+			db.AddBalance(to, value, tracing.BalanceChangeTransfer)
+		},
+		BlockNumber: big.NewInt(1), Time: 1000, Random: &common.Hash{},
+	}
+	if warmAccount {
+		ctx.Coinbase = pqTestRegistry // EIP-3651, without warming any storage key.
+	}
+	evm := NewEVM(ctx, db, &cfg, Config{})
+	t.Cleanup(evm.Release)
+	db.Prepare(evm.chainRules, pqTestSender, ctx.Coinbase, &pqTestVerifier, ActivePrecompiles(evm.chainRules), nil)
+	if warmSlot {
+		db.AddSlotToAccessList(pqTestRegistry, pqTestFact)
+	}
+	evm.SetTxContext(TxContext{Origin: pqTestSender, GasPrice: new(uint256.Int)})
+	return evm, db
+}
+
+func pqTimeWord(n uint64) common.Hash {
+	var word common.Hash
+	binary.BigEndian.PutUint64(word[24:], n)
+	return word
+}
+
+func pqRegisterInput() []byte {
+	input := append([]byte{}, pqFactRegisterSelector[:]...)
+	input = append(input, 0, 0, 0, 1)
+	return append(input, pqTestFact[:]...)
+}
+
+func TestPQFactRegistryCalleeMetering(t *testing.T) {
+	for _, tc := range []struct {
+		name      string
+		old       uint64
+		warm      bool
+		cost      uint64
+		duplicate bool
+	}{
+		{"cold_new", 0, false, 22100, false},
+		{"warm_new", 0, true, 20100, false},
+		{"cold_expired", 900, false, 5000, false},
+		{"warm_expired", 900, true, 3000, false},
+		{"ttl_inclusive_cold", 901, false, 2100, true},
+		{"ttl_inclusive_warm", 901, true, 100, true},
+		{"same_timestamp", 1000, false, 2100, true},
+		{"future_timestamp_fails_closed", 1001, false, 2100, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			evm, db := pqTestEVM(t, pqToyVerifier(false, false), pqTimeWord(tc.old), tc.warm, false)
+			budget := NewGasBudget(50000, 0)
+			ret, left, err := evm.Call(pqTestVerifier, pqTestRegistry, pqRegisterInput(), budget, new(uint256.Int))
+			if tc.duplicate {
+				if err != ErrExecutionReverted || len(ret) != 0 || db.GetState(pqTestRegistry, pqTestFact) != pqTimeWord(tc.old) {
+					t.Fatalf("duplicate changed state or wrong result: %x %v", ret, err)
+				}
+			} else if err != nil || !bytes.Equal(ret, pqTestFact[:]) || db.GetState(pqTestRegistry, pqTestFact) != pqTimeWord(1000) {
+				t.Fatalf("registration result/state: %x %v", ret, err)
+			}
+			if used := left.Used(budget); used != tc.cost || db.GetRefund() != 0 {
+				t.Fatalf("gas=%d want=%d refund=%d", used, tc.cost, db.GetRefund())
+			}
+			_, warm := db.SlotInAccessList(pqTestRegistry, pqTestFact)
+			if warm != (!tc.duplicate || tc.warm) {
+				t.Fatal("reverted frame did not restore slot warmth")
+			}
+			t.Logf("callee_gas=%d; refund=0", tc.cost)
+		})
+	}
+}
