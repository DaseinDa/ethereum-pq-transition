+// These four public proofs bind their original PI. Evaluation is pinned below
+// each expiry, with explicit component pre-states; no live recovery is claimed.
+func finalPublicFixture(t *testing.T, mode uint8) (*types.Transaction, *state.StateDB, *vm.EVM, *types.Header) {
+	t.Helper()
+	tx, now := pqtest.SingleF(t, mode)
+	p, _ := tx.AsPQMigrate()
+	cfg := nativeTestChain()
+	cfg.ChainID = new(big.Int).Set(p.ChainID)
+	cfg.PQMigrate.FullResearch = finalTestProfile()
+	cfg.PQMigrate.FullResearch.Sunset = ^uint64(0)
+	cfg.PQMigrate.T0, cfg.PQMigrate.ReceivingTime, cfg.PQMigrate.T = now-100, now-100, now-50
+	cfg.PQMigrate.LegacySeedProofFromT0 = true
+	if err := cfg.CheckConfigForkOrder(); err != nil {
+		t.Fatal(err)
+	}
+	s, err := state.New(types.EmptyRootHash, state.NewDatabaseForTesting())
+	if err != nil {
+		t.Fatal(err)
+	}
+	s.SetBalance(p.LegacyAddress, uint256.NewInt(2000000000000000000), tracing.BalanceChangeUnspecified)
+	s.SetNonce(p.LegacyAddress, 9, tracing.NonceChangeUnspecified)
+	if p.MigrationNonce != 0 {
+		writePQRecord(s, cfg.PQMigrate.Registry, p.LegacyAddress, PQRecord{Mode: 2, AlgID: 1, MigrationNonce: p.MigrationNonce, Commit: common.Hash{0x99}})
+	}
+	if sponsor := p.Sponsor(); sponsor != nil {
+		pk := pqtest.SponsorPublicKey()
+		writePQRecord(s, cfg.PQMigrate.Registry, sponsor.Sponsor, PQRecord{Mode: 2, AlgID: 1, MigrationNonce: 1, Commit: PQKeyCommit(1, pk)})
+		s.SetCode(sponsor.Sponsor, append([]byte{0xef, 1, 1}, pk...), tracing.CodeChangeUnspecified)
+		s.SetBalance(sponsor.Sponsor, uint256.NewInt(5000000000000000000), tracing.BalanceChangeUnspecified)
+		s.SetNonce(sponsor.Sponsor, 7, tracing.NonceChangeUnspecified)
+	}
+	h := &types.Header{Number: big.NewInt(1), Time: now, GasLimit: 45000000, BaseFee: big.NewInt(params.GWei), Difficulty: new(big.Int), Coinbase: common.Address{0xaa}}
+	random := common.Hash{}
+	evm := vm.NewEVM(vm.BlockContext{CanTransfer: CanTransfer, Transfer: Transfer, GetHash: func(uint64) common.Hash { return common.Hash{} }, Coinbase: h.Coinbase, BlockNumber: h.Number, Time: h.Time, Difficulty: h.Difficulty, BaseFee: h.BaseFee, GasLimit: h.GasLimit, Random: &random}, s, cfg, vm.Config{})
+	t.Cleanup(evm.Release)
+	return tx, s, evm, h
+}
+
+func TestPQFinalPublicFeeModesExecute(t *testing.T) {
+	for mode := uint8(0); mode <= 3; mode++ {
+		t.Run(fmt.Sprintf("mode%d", mode), func(t *testing.T) {
+			tx, s, evm, h := finalPublicFixture(t, mode)
+			p, _ := tx.AsPQMigrate()
+			ownerBefore := new(uint256.Int).Set(s.GetBalance(p.LegacyAddress))
+			payer := p.LegacyAddress
+			if p.Sponsor() != nil {
+				payer = p.Sponsor().Sponsor
+			}
+			payerBefore := new(uint256.Int).Set(s.GetBalance(payer))
+			s.SetTxContext(tx.Hash(), 0, 1)
+			result, err := ApplyMessage(evm, &Message{PQTransaction: tx, GasLimit: tx.Gas()}, NewGasPool(h.GasLimit))
+			if err != nil {
+				t.Fatal(err)
+			}
+			r := ReadPQRecord(s, evm.ChainConfig().PQMigrate.Registry, p.LegacyAddress)
+			if r.Mode != 2 || r.MigrationNonce != p.MigrationNonce+1 || r.Commit != p.PQPKCommit || len(s.GetCode(p.LegacyAddress)) != 0 || s.GetNonce(p.LegacyAddress) != 9 {
+				t.Fatal("migration state", r)
+			}
+			fee := new(uint256.Int).Mul(uint256.NewInt(result.UsedGas), uint256.NewInt(2*params.GWei))
+			reimbursement := new(uint256.Int)
+			if mode == 1 || mode == 3 {
+				reimbursement.Set(uint256.MustFromBig(p.MaxAccountFee))
+			}
+			wantPayer := new(uint256.Int).Sub(payerBefore, fee)
+			if mode != 0 {
+				wantPayer.Add(wantPayer, reimbursement)
+				if s.GetNonce(payer) != 7 {
+					t.Fatal("single consumed sponsor nonce")
+				}
+			}
+			if s.GetBalance(payer).Cmp(wantPayer) != 0 {
+				t.Fatal("gross charge/reimbursement")
+			}
+			if mode != 0 && s.GetBalance(p.LegacyAddress).Cmp(new(uint256.Int).Sub(ownerBefore, reimbursement)) != 0 {
+				t.Fatal("owner reimbursement")
+			}
+			if len(s.GetLogs(tx.Hash(), 1, common.Hash{}, h.Time)) != 1 {
+				t.Fatal("migration receipt")
+			}
+		})
+	}
+}
