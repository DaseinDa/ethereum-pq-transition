+// pqL2Resized is the real carrier with its proof field resized so that the
+// whole envelope has exactly size bytes. Proof validity is irrelevant here
+// (mechanics layer); the PI is unchanged.
+func pqL2Resized(t *testing.T, carrier *types.Transaction, size uint64) *types.Transaction {
+	t.Helper()
+	m, _ := carrier.AsPQMigrate()
+	cp := types.NewTx(m) // deep copy
+	m, _ = cp.AsPQMigrate()
+	m.ProofCarrier.Proof = append(m.ProofCarrier.Proof, make([]byte, size-carrier.Size())...)
+	tx := types.NewTx(m)
+	if tx.Size() != size {
+		t.Fatalf("resized carrier %d bytes, want %d", tx.Size(), size)
+	}
+	return tx
+}
