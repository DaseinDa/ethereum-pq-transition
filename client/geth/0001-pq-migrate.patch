+func TestPQN1RequestGateChargeAndOverflow(t *testing.T) {
+	for _, warm := range []bool{false, true} {
+		for _, enough := range []bool{false, true} {
+			t.Run(fmt.Sprintf("warm=%v/enough=%v", warm, enough), func(t *testing.T) {
+				evm, s, _, sender := pqRecoveryFixture(t, math.MaxUint64)
+				c := evm.chainConfig.PQMigrate
+				c.T = math.MaxUint64 - 2
+				c.W = 10
+				s.SetState(c.Registry, pqAuthoritySlot(sender), common.Hash{31: 1})
+				if warm {
+					s.AddSlotToAccessList(c.Registry, pqAuthoritySlot(sender))
+				}
+				db := &pqCountedState{StateDB: s}
+				evm.StateDB = db
+				cost := uint64(2100)
+				if warm {
+					cost = 100
+				}
+				gas := cost
+				if !enough {
+					gas--
+				}
+				_, e := evm.pqRequestGate(sender, params.WithdrawalQueueAddress, []byte{1}, NewGasBudget(gas, 0))
+				if enough {
+					if !errors.Is(e, ErrExecutionReverted) || db.reads != 1 {
+						t.Fatal("deadline overflow or read", e, db.reads)
+					}
+				} else if !errors.Is(e, ErrOutOfGas) || db.reads != 0 || db.warms != 0 {
+					t.Fatal("state read before charge", e, db.reads, db.warms)
+				}
+			})
+		}
+	}
+}
+func TestPQN1FeeReadsHaveNoGateAccess(t *testing.T) {
