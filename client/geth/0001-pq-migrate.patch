+func assertBatchLog(t *testing.T, log *types.Log, registry common.Address, entry types.PQBatchEntry, position int, skip uint16, nonce uint64, override, recommit bool) {
+	t.Helper()
+	var topic common.Hash
+	var data []byte
+	if skip != 0 {
+		topic = crypto.Keccak256Hash([]byte("BatchEntrySkipped(uint32,address,uint16)"))
+		data = make([]byte, 64)
+		binary.BigEndian.PutUint32(data[28:32], uint32(position))
+		binary.BigEndian.PutUint16(data[62:64], skip)
+	} else {
+		topic = crypto.Keccak256Hash([]byte("Migrated(address,uint8,bytes32,uint64,bool,bool)"))
+		data = make([]byte, 160)
+		data[31] = entry.AlgID
+		copy(data[32:64], entry.PQPKCommit[:])
+		binary.BigEndian.PutUint64(data[88:96], nonce)
+		if override {
+			data[127] = 1
+		}
+		if recommit {
+			data[159] = 1
+		}
+	}
+	if log.Address != registry || len(log.Topics) != 2 || log.Topics[0] != topic || log.Topics[1] != common.BytesToHash(entry.LegacyAddress[:]) || !bytes.Equal(log.Data, data) {
+		t.Fatalf("entry %d receipt ABI/order: %#v", position, log)
+	}
