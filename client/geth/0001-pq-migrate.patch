index 0000000000000000000000000000000000000000..2abc899e82ae2483f6d3721a72363f6d8f00263f
--- /dev/null
+++ b/internal/ethapi/pq_account.go
@@ -0,0 +1,77 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+// Research PQ migration query. State and time come from the requested block.
+package ethapi
+
+import (
+	"context"
+	"errors"
+	"math"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/common/hexutil"
+	"github.com/ethereum/go-ethereum/core"
+	"github.com/ethereum/go-ethereum/core/txpool"
+	"github.com/ethereum/go-ethereum/rpc"
+)
+
+// GetPQAccount implements the account shape of section 24.7 rule 18. Like
+// eth_getBalance, an omitted block defaults to latest. Pending is a policy
+// view: the latest canonical state evaluated at the common pool clock, never
+// the miner's speculative pending state (section 29.4 rule 6).
+func (api *BlockChainAPI) GetPQAccount(ctx context.Context, address common.Address, blockNrOrHash *rpc.BlockNumberOrHash) (map[string]interface{}, error) {
+	ref := blockNrOrHashOrLatest(blockNrOrHash)
+	number, isNumber := ref.Number()
+	pending := isNumber && number == rpc.PendingBlockNumber
+	if pending {
+		ref = rpc.BlockNumberOrHashWithNumber(rpc.LatestBlockNumber)
+	}
+	s, h, err := api.b.StateAndHeaderByNumberOrHash(ctx, ref)
+	if err != nil {
+		return nil, err
+	}
+	if s == nil || h == nil {
+		return nil, errors.New("PQ account state or header is unavailable")
+	}
+	if err := s.Error(); err != nil {
+		return nil, err
+	}
+	chainConfig := api.b.ChainConfig()
+	cfg := chainConfig.PQMigrate
+	var (
+		rec       core.PQRecord
+		deadline  interface{}
+		activated bool
+		ecdsaDead bool
+	)
+	// Without a scheduled PQ migration there is no PQ registry to read.
+	if cfg != nil {
+		rec = core.ReadPQRecord(s, cfg.Registry, address)
+		if err := s.Error(); err != nil {
+			return nil, err
+		}
+		if rec.Mode == 1 {
+			start := max(rec.EnrolledAt, cfg.T)
+			if start > math.MaxUint64-cfg.W {
+				return nil, errors.New("PQ deadline overflow")
+			}
+			deadline = hexutil.Uint64(start + cfg.W)
+		}
+		timestamp := h.Time
+		if pending {
+			timestamp = txpool.PQPoolTime(h, chainConfig)
+		}
+		activated = core.PQActivated(s, cfg, address)
+		ecdsaDead = core.PQECDSADead(s, cfg, address, timestamp)
+		if err := s.Error(); err != nil {
+			return nil, err
+		}
+	}
+	return map[string]interface{}{
+		"mode": hexutil.Uint64(rec.Mode), "algId": hexutil.Uint64(rec.AlgID),
+		"enrolledAt": hexutil.Uint64(rec.EnrolledAt), "overrideDeadline": deadline,
+		"migrationNonce": hexutil.Uint64(rec.MigrationNonce), "pqPkCommit": rec.Commit,
+		"activated": activated, "ecdsaDead": ecdsaDead,
+	}, nil
+}
