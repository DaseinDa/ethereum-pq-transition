+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+// Research client: component regressions for R1 in the blob subpool.
+
+package blobpool
+
+import (
+	"crypto/ecdsa"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"math"
+	"math/big"
+	"testing"
+
+	"github.com/cloudflare/circl/sign/mldsa/mldsa44"
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/consensus/beacon"
+	"github.com/ethereum/go-ethereum/consensus/ethash"
+	"github.com/ethereum/go-ethereum/core"
+	"github.com/ethereum/go-ethereum/core/rawdb"
+	"github.com/ethereum/go-ethereum/core/state"
+	"github.com/ethereum/go-ethereum/core/tracing"
+	"github.com/ethereum/go-ethereum/core/txpool"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/crypto"
+	"github.com/ethereum/go-ethereum/crypto/kzg4844"
+	"github.com/ethereum/go-ethereum/params"
+	"github.com/holiman/uint256"
+)
+
+// Public geth test keys only (never a real key).
+var (
+	pqKeyL, _ = crypto.HexToECDSA("b71c71a67e1177ad4e901695e1b4b9ee17ae16c6668d313eac2f96dbcda3f291")
+	pqKeyU, _ = crypto.HexToECDSA("8a1f9a8f95be41cd7ccb6168179afb4504aefe388d1e14474d32c45c72ce7b7a")
+	pqAddrL   = crypto.PubkeyToAddress(pqKeyL.PublicKey)
+	pqAddrU   = crypto.PubkeyToAddress(pqKeyU.PublicKey)
+)
+
+// pqR1Config is the F research profile of the client (chain 13378, version
+// 0x80000008) with the given T0 and T; it passes CheckConfigForkOrder.
+func pqR1Config(t0, t uint64) *params.ChainConfig {
+	cfg := *params.MergedTestChainConfig
+	cfg.ChainID = new(big.Int).SetUint64(params.PQR1ChainID)
+	cfg.PQMigrate = &params.PQMigrateConfig{
+		PoolSlotSeconds: 12, T0: t0, T: t, W: 31536000, ReceivingTime: t0, MaxPayloadBytes: 131072,
+		Registry: common.HexToAddress("0x0800"), FactRegistry: common.HexToAddress("0x0801"),
+		FullResearch: &params.PQFullResearchConfig{
+			Backend: params.PQFinalBackend, NativeAlgorithmDigest: params.PQFinalAlgorithmDigest,
+			FinalKeyDigest: params.PQFinalKeyDigest, Version: params.PQFinalVersion,
+			Activation: t0, Sunset: math.MaxUint64, ProofLifetime: 604800,
+			MaxProofBytes: params.PQFinalMaxProofBytes, MaxTxBytes: params.PQFinalMaxTxBytes,
+			TxGasCap: params.MaxTxGas, VerifyGas: params.PQFinalVerifyGas,
+		},
+	}
+	return &cfg
+}
+
+// pqBlobTx is a real signed one-blob type-3 envelope with a version-1 sidecar.
+func pqBlobTx(chainID *big.Int, key *ecdsa.PrivateKey, nonce uint64, blob int) *types.Transaction {
+	return types.MustSignNewTx(key, types.LatestSignerForChainID(chainID), &types.BlobTx{
+		ChainID:    uint256.MustFromBig(chainID),
+		Nonce:      nonce,
+		GasTipCap:  uint256.NewInt(params.GWei),
+		GasFeeCap:  uint256.NewInt(10 * params.GWei),
+		Gas:        21000,
+		BlobFeeCap: uint256.NewInt(params.GWei),
+		BlobHashes: []common.Hash{testBlobVHashes[blob]},
+		Value:      uint256.NewInt(1),
+		Sidecar: types.NewBlobTxSidecar(types.BlobSidecarVersion1, []kzg4844.Blob{*testBlobs[blob]},
+			[]kzg4844.Commitment{testBlobCommits[blob]}, testBlobCellProofs[blob]),
+	})
+}
+
+// pqEnroll is a real 0x7d of key at nonce (ECDSA envelope signature and a real
+// ML-DSA-44 proof of possession from a public seed), and the registry record it
+// writes in a block at time t (mode 1, ML-DSA-44, enrolled_at t, migration nonce 1).
+func pqEnroll(t *testing.T, cfg *params.ChainConfig, key *ecdsa.PrivateKey, nonce, time uint64) (*types.Transaction, func(*state.StateDB)) {
+	t.Helper()
+	seed := [mldsa44.SeedSize]byte{0x5a}
+	pk, sk := mldsa44.NewKeyFromSeed(&seed)
+	sender := crypto.PubkeyToAddress(key.PublicKey)
+	en := &types.PQEnrollTx{ChainID: cfg.ChainID, Nonce: nonce, GasTipCap: big.NewInt(params.GWei), GasFeeCap: big.NewInt(10 * params.GWei),
+		Gas: 500000, AlgID: 1, PublicKey: pk.Bytes(), PoPSignature: make([]byte, mldsa44.SignatureSize)}
+	tag := []byte("ETH-PQ-ENROLL-POP/v1")
+	digest := core.PQEnrollmentDigest(cfg.ChainID, sender, nonce, 1, en.PublicKey)
+	if err := mldsa44.SignTo(sk, append(append([]byte{}, tag...), digest[:]...), tag, false, en.PoPSignature); err != nil {
+		t.Fatal(err)
+	}
+	hash := en.SigningHash()
+	sig, err := crypto.Sign(hash[:], key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	en.R, en.S, en.V = new(big.Int).SetBytes(sig[:32]), new(big.Int).SetBytes(sig[32:64]), new(big.Int).SetUint64(uint64(sig[64]))
+	tx := types.NewTx(en)
+	if from, err := types.Sender(types.LatestSigner(cfg), tx); err != nil || from != sender {
+		t.Fatalf("0x7d sender: %v %v", from, err)
+	}
+	write := func(s *state.StateDB) {
+		k, k1 := core.PQRecordSlots(sender)
+		var w common.Hash
+		w[31], w[30] = 1, 1
+		binary.BigEndian.PutUint64(w[22:30], time)
+		binary.BigEndian.PutUint64(w[14:22], 1)
+		s.SetState(cfg.PQMigrate.Registry, k, w)
+		s.SetState(cfg.PQMigrate.Registry, k1, core.PQKeyCommit(1, en.PublicKey))
+		s.SetNonce(sender, nonce+1, tracing.NonceChangeUnspecified)
+	}
+	return tx, write
+}
+
+// pqR1Chain is a blob pool chain with explicit blocks and one state per head,
+// so that resets and reorganizations move the pool clock and the registry.
+type pqR1Chain struct {
+	config *params.ChainConfig
+	blocks map[common.Hash]*types.Block
+	states map[common.Hash]*state.StateDB
+	head   *types.Header
+	first  *types.Block
+}
+
+func newPQR1Chain(cfg *params.ChainConfig) *pqR1Chain {
+	return &pqR1Chain{config: cfg, blocks: make(map[common.Hash]*types.Block), states: make(map[common.Hash]*state.StateDB)}
+}
+func (c *pqR1Chain) Config() *params.ChainConfig      { return c.config }
+func (c *pqR1Chain) CurrentBlock() *types.Header      { return c.head }
+func (c *pqR1Chain) CurrentFinalBlock() *types.Header { return &types.Header{Number: big.NewInt(0)} }
+func (c *pqR1Chain) Genesis() *types.Block            { return c.first }
+func (c *pqR1Chain) GetBlock(hash common.Hash, number uint64) *types.Block {
+	if b := c.blocks[hash]; b != nil && b.NumberU64() == number {
+		return b
+	}
+	return nil
+}
+func (c *pqR1Chain) StateAt(h *types.Header) (*state.StateDB, error) {
+	if s := c.states[h.Hash()]; s != nil {
+		return s, nil
+	}
+	return nil, fmt.Errorf("no state for block %d", h.Number)
+}
+
+// block adds a block on parent (nil: the first block) and the state after it.
+func (c *pqR1Chain) block(parent *types.Header, time uint64, tag string, st *state.StateDB, txs ...*types.Transaction) *types.Header {
+	number, parentHash := big.NewInt(1), common.Hash{}
+	if parent != nil {
+		number, parentHash = new(big.Int).Add(parent.Number, common.Big1), parent.Hash()
+	}
+	h := &types.Header{ParentHash: parentHash, Number: number, Time: time, GasLimit: 30_000_000, BaseFee: big.NewInt(1),
+		Difficulty: common.Big0, Extra: []byte(tag), ExcessBlobGas: new(uint64), BlobGasUsed: new(uint64)}
+	body := make([]*types.Transaction, len(txs))
+	for i, tx := range txs {
+		body[i] = tx.WithoutBlobTxSidecar()
+	}
+	b := types.NewBlockWithHeader(h).WithBody(types.Body{Transactions: body})
+	c.blocks[b.Hash()], c.states[b.Hash()] = b, st
+	if c.first == nil {
+		c.first = b
+	}
+	return b.Header()
+}
+
+// pqR1State funds both senders and applies the given changes.
+func pqR1State(changes ...func(*state.StateDB)) *state.StateDB {
+	s, _ := state.New(types.EmptyRootHash, state.NewDatabaseForTesting())
+	for _, a := range []common.Address{pqAddrL, pqAddrU} {
+		s.AddBalance(a, uint256.NewInt(params.Ether), tracing.BalanceChangeUnspecified)
+	}
+	for _, change := range changes {
+		change(s)
+	}
+	return s
+}
+
+func pqNonce(a common.Address, n uint64) func(*state.StateDB) {
+	return func(s *state.StateDB) { s.SetNonce(a, n, tracing.NonceChangeUnspecified) }
+}
+
+func pqR1Pool(t *testing.T, chain *pqR1Chain, head *types.Header, dir string) *BlobPool {
+	t.Helper()
+	if err := chain.config.CheckConfigForkOrder(); err != nil {
+		t.Fatalf("research configuration refused: %v", err)
+	}
+	chain.head = head
+	pool := New(Config{Datadir: dir}, chain, nil)
+	if err := pool.Init(1, head, newReserver()); err != nil {
+		t.Fatal(err)
+	}
+	verifyPoolInternals(t, pool)
+	return pool
+}
+
+func pqReset(t *testing.T, pool *BlobPool, chain *pqR1Chain, head *types.Header) {
+	t.Helper()
+	old := chain.head
+	chain.head = head
+	pool.Reset(old, head)
+	verifyPoolInternals(t, pool)
+}
+
+func pqAdd(t *testing.T, pool *BlobPool, tx *types.Transaction) error {
+	t.Helper()
+	err := pool.Add([]*types.Transaction{tx}, true)[0]
+	verifyPoolInternals(t, pool)
+	return err
+}
+
+func pqMustAdd(t *testing.T, pool *BlobPool, tx *types.Transaction, want txpool.TxStatus) {
+	t.Helper()
+	if err := pqAdd(t, pool, tx); err != nil {
+		t.Fatalf("admission of %x refused: %v", tx.Hash(), err)
+	}
+	if got := pool.Status(tx.Hash()); got != want {
+		t.Fatalf("status of %x: have %v, want %v", tx.Hash(), got, want)
+	}
+}
+
+func pqMustRefuse(t *testing.T, pool *BlobPool, tx *types.Transaction) {
+	t.Helper()
+	if err := pqAdd(t, pool, tx); !errors.Is(err, core.ErrECDSADisabled) || err.Error() != "ECDSA_DISABLED" {
+		t.Fatalf("admission of %x: have %v, want ECDSA_DISABLED", tx.Hash(), err)
+	}
+	if pool.Has(tx.Hash()) {
+		t.Fatalf("refused envelope %x held", tx.Hash())
+	}
+}
+
+// pqGone checks that nothing of tx remains in any pool structure: pending
+// index and lookup, gapped buffer, serving paths (Get, GetRLP, metadata).
+func pqGone(t *testing.T, pool *BlobPool, txs ...*types.Transaction) {
+	t.Helper()
+	for _, tx := range txs {
+		h := tx.Hash()
+		_, pending := pool.lookup.storeidOfTx(h)
+		_, gapped := pool.gappedSource[h]
+		if pool.Has(h) || pending || gapped || pool.Status(h) != txpool.TxStatusUnknown || pool.Get(h) != nil ||
+			pool.GetRLP(h, 68) != nil || pool.GetRLP(h, 72) != nil || pool.GetMetadata(h) != nil {
+			t.Fatalf("envelope %x still held (pending %v, gapped %v)", h, pending, gapped)
+		}
+	}
+}
+
+// V22-POOL-3 (i)-(iii) and TP-1 for a blob subpool (T0 = 600, T = 1,200,
+// 12-second slots): a LEGACY sender's envelope is admitted before T, evicted
+// with the gapped one at the first reset with now >= T, every new type-3
+// envelope is refused there by type (an unrecoverable signature included),
+// and a reorganization back to now < T admits again until the head returns.
+func TestPQBlobR1PoolClock(t *testing.T) {
+	cfg := pqR1Config(600, 1200)
+	chain := newPQR1Chain(cfg)
+	// L's account nonce 10 gives it a gapped-buffer allowance of one envelope.
+	st := func() *state.StateDB { return pqR1State(pqNonce(pqAddrL, 10)) }
+	h1152 := chain.block(nil, 1152, "", st())
+	h1164 := chain.block(h1152, 1164, "", st())
+	h1176 := chain.block(h1164, 1176, "", st())
+	h1188 := chain.block(h1176, 1188, "", st())
+
+	pool := pqR1Pool(t, chain, h1176, t.TempDir()) // now 1,188
+	defer pool.Close()
+	if now := txpool.PQPoolTime(h1176, cfg); now != 1188 {
+		t.Fatalf("pool clock %d", now)
+	}
+	e := pqBlobTx(cfg.ChainID, pqKeyL, 10, 0)
+	gap := pqBlobTx(cfg.ChainID, pqKeyL, 12, 1)
+	pqMustAdd(t, pool, e, txpool.TxStatusPending)
+	pqMustAdd(t, pool, gap, txpool.TxStatusQueued)
+	if pending, queued := pool.Stats(); pending != 1 || queued != 1 {
+		t.Fatalf("setup pending %d queued %d", pending, queued)
+	}
+	// (i) head 1,188, now 1,200 = T.
+	pqReset(t, pool, chain, h1188)
+	pqGone(t, pool, e, gap)
+	if pending, queued := pool.Stats(); pending != 0 || queued != 0 || pool.stored != 0 || pool.reserver.Has(pqAddrL) {
+		t.Fatalf("held at T: pending %d queued %d stored %d reserved %v", pending, queued, pool.stored, pool.reserver.Has(pqAddrL))
+	}
+	pqMustRefuse(t, pool, pqBlobTx(cfg.ChainID, pqKeyL, 10, 2))
+	pqMustRefuse(t, pool, pqBlobTx(cfg.ChainID, pqKeyU, 0, 3))
+	// An envelope whose signature recovers to no sender: refused by type alone.
+	bad := pqBlobTx(cfg.ChainID, pqKeyU, 1, 4)
+	v, r, _ := bad.RawSignatureValues()
+	zeroS := append(append(common.LeftPadBytes(r.Bytes(), 32), make([]byte, 32)...), byte(v.Uint64()))
+	bad, _ = bad.WithSignature(types.LatestSignerForChainID(cfg.ChainID), zeroS)
+	if _, err := types.Sender(types.LatestSigner(cfg), bad); err == nil {
+		t.Fatal("corrupted signature still recoverable")
+	}
+	pqMustRefuse(t, pool, bad)
+	if err := pool.ValidateTxBasics(e); !errors.Is(err, core.ErrECDSADisabled) {
+		t.Fatalf("eth/72 buffer validation after T: %v", err)
+	}
+	// (ii) reorganization back to head 1,164, now 1,176 < T.
+	pqReset(t, pool, chain, h1164)
+	again := pqBlobTx(cfg.ChainID, pqKeyL, 10, 5)
+	pqMustAdd(t, pool, again, txpool.TxStatusPending)
+	pqMustAdd(t, pool, gap, txpool.TxStatusQueued)
+	// (iii) the head returns to 1,188.
+	pqReset(t, pool, chain, h1188)
+	pqGone(t, pool, again, gap)
+	pqMustRefuse(t, pool, pqBlobTx(cfg.ChainID, pqKeyL, 10, 6))
+	t.Logf("T on the pool clock: admitted at now 1188, evicted (pending and gapped) and refused at now 1200, admitted after the reorg to now 1176, evicted again at 1200")
+}
+
+// V22-POOL-3 (iv): before T, at the reset to the head of 900 whose block holds
+// 0x7d(L), the envelope of L that the subpool held is evicted although its
+// nonce is still executable, its gapped one too, and a new one is refused;
+// an unrelated LEGACY sender keeps its envelope and may add more.
+func TestPQBlobR1EnrolledSenderBeforeT(t *testing.T) {
+	cfg := pqR1Config(600, 1200)
+	chain := newPQR1Chain(cfg)
+	h888 := chain.block(nil, 888, "", pqR1State(pqNonce(pqAddrL, 10)))
+	enroll, write := pqEnroll(t, cfg, pqKeyL, 10, 900)
+	h900 := chain.block(h888, 900, "", pqR1State(write), enroll)
+
+	pool := pqR1Pool(t, chain, h888, t.TempDir()) // now 900, in [T0, T)
+	defer pool.Close()
+	e0, e1 := pqBlobTx(cfg.ChainID, pqKeyL, 10, 0), pqBlobTx(cfg.ChainID, pqKeyL, 11, 1)
+	gap := pqBlobTx(cfg.ChainID, pqKeyL, 13, 2)
+	f := pqBlobTx(cfg.ChainID, pqKeyU, 0, 3)
+	for _, tx := range []*types.Transaction{e0, e1, f} {
+		pqMustAdd(t, pool, tx, txpool.TxStatusPending)
+	}
+	pqMustAdd(t, pool, gap, txpool.TxStatusQueued)
+
+	pqReset(t, pool, chain, h900) // now 912 < T; Rec(L).mode = 1, nonce(L) = 11
+	if rec := core.ReadPQRecord(pool.state, cfg.PQMigrate.Registry, pqAddrL); rec.Mode != 1 || pool.state.GetNonce(pqAddrL) != 11 {
+		t.Fatalf("modelled head state: %+v nonce %d", rec, pool.state.GetNonce(pqAddrL))
+	}
+	pqGone(t, pool, e0, e1, gap) // e0 by its nonce, e1 (executable) and gap by R1
+	if pool.Status(f.Hash()) != txpool.TxStatusPending {
+		t.Fatal("unrelated LEGACY sender evicted")
+	}
+	pqMustRefuse(t, pool, pqBlobTx(cfg.ChainID, pqKeyL, 11, 4))
+	pqMustAdd(t, pool, pqBlobTx(cfg.ChainID, pqKeyU, 1, 5), txpool.TxStatusPending)
+	t.Logf("before T: enrolled sender's executable envelope (nonce 11) and gapped one evicted at the reset to the 0x7d head; new one ECDSA_DISABLED; LEGACY sender unaffected")
+}
+
+// R1 at reinjection (call site 1): an envelope included on a block that a
+// reorganization drops re-enters the pool only under R1 at the new head's
+// pool clock. Before T a LEGACY sender's envelope is reinjected (control);
+// after T it is refused without being re-pooled or reported as reinjected,
+// and its limbo entry is left to finality.
+func TestPQBlobR1Reinjection(t *testing.T) {
+	cfg := pqR1Config(600, 1200)
+	for _, tc := range []struct {
+		name  string
+		depth int // blocks on the new branch: head time 1,140 + 12 * depth
+		admit bool
+	}{{"before-T", 3, true}, {"after-T", 4, false}} {
+		t.Run(tc.name, func(t *testing.T) {
+			chain := newPQR1Chain(cfg)
+			x := pqBlobTx(cfg.ChainID, pqKeyL, 0, 0)
+			g := chain.block(nil, 1140, "", pqR1State())
+			a1 := chain.block(g, 1152, "a", pqR1State(pqNonce(pqAddrL, 1)), x)
+			head := g
+			for i := 1; i <= tc.depth; i++ {
+				head = chain.block(head, 1140+12*uint64(i), "b", pqR1State())
+			}
+			pool := pqR1Pool(t, chain, g, t.TempDir())
+			defer pool.Close()
+			pqMustAdd(t, pool, x, txpool.TxStatusPending)
+			pqReset(t, pool, chain, a1) // included: moved to the limbo
+			if _, ok := pool.limbo.index[x.Hash()]; !ok || pool.Has(x.Hash()) {
+				t.Fatal("included envelope not in the limbo")
+			}
+			events := make(chan core.NewTxsEvent, 16)
+			sub := pool.SubscribeTransactions(events, true)
+			defer sub.Unsubscribe()
+
+			pqReset(t, pool, chain, head)
+			now := txpool.PQPoolTime(head, cfg)
+			reinjected := false
+			for len(events) > 0 {
+				for _, tx := range (<-events).Txs {
+					reinjected = reinjected || tx.Hash() == x.Hash()
+				}
+			}
+			if tc.admit {
+				if now >= cfg.PQMigrate.T || !reinjected || pool.Status(x.Hash()) != txpool.TxStatusPending {
+					t.Fatalf("now %d: LEGACY envelope not reinjected before T (event %v)", now, reinjected)
+				}
+				return
+			}
+			if now < cfg.PQMigrate.T || reinjected {
+				t.Fatalf("now %d: reinjection reported after T", now)
+			}
+			pqGone(t, pool, x)
+			if _, ok := pool.limbo.index[x.Hash()]; !ok {
+				t.Fatal("limbo entry dropped before finality")
+			}
+			pqMustRefuse(t, pool, x)
+			t.Logf("now %d: reorged-out type-3 envelope refused at reinjection, limbo entry kept to finality", now)
+		})
+	}
+}
+
+// The on-disk store: a restart after T evicts what was stored before T, and a
+// later restart before T resurrects nothing that the eviction deleted.
+func TestPQBlobR1RestartAcrossT(t *testing.T) {
+	cfg := pqR1Config(600, 1200)
+	chain := newPQR1Chain(cfg)
+	h1176 := chain.block(nil, 1176, "", pqR1State())
+	h1188 := chain.block(h1176, 1188, "", pqR1State())
+	dir := t.TempDir()
+	txs := []*types.Transaction{pqBlobTx(cfg.ChainID, pqKeyL, 0, 0), pqBlobTx(cfg.ChainID, pqKeyU, 0, 1)}
+
+	pool := pqR1Pool(t, chain, h1176, dir)
+	for _, tx := range txs {
+		pqMustAdd(t, pool, tx, txpool.TxStatusPending)
+	}
+	pool.Close()
+
+	pool = pqR1Pool(t, chain, h1188, dir) // start-up at now 1,200
+	pqGone(t, pool, txs...)
+	if pending, queued := pool.Stats(); pending != 0 || queued != 0 || pool.stored != 0 {
+		t.Fatalf("restart after T kept pending %d queued %d stored %d", pending, queued, pool.stored)
+	}
+	pool.Close()
+
+	pool = pqR1Pool(t, chain, h1176, dir) // start-up before T again
+	defer pool.Close()
+	if pending, queued := pool.Stats(); pending != 0 || queued != 0 {
+		t.Fatalf("store resurrected pending %d queued %d", pending, queued)
+	}
+	pqMustAdd(t, pool, txs[0], txpool.TxStatusPending)
+}
+
+// pqAttack is the quantum attacker's vector (V22-POOL-2's type-3 part): A signs
+// a type-3 envelope with the victim's exposed key (here a public test key). It
+// returns the envelope, a block at time 10 that holds it (built on a chain whose
+// T is later, so the block is valid there) and a constructor of real chains with
+// the same genesis and a chosen T.
+func pqAttack(t *testing.T) (*types.Transaction, []*types.Block, func(uint64) *core.BlockChain) {
+	t.Helper()
+	attack := pqBlobTx(new(big.Int).SetUint64(params.PQR1ChainID), pqKeyU, 0, 7)
+	genesis := func(tt uint64) *core.Genesis {
+		alloc := core.SystemContractAllocs()
+		alloc[pqAddrU] = types.Account{Balance: big.NewInt(params.Ether)}
+		return &core.Genesis{Config: pqR1Config(0, tt), GasLimit: 30_000_000, BaseFee: big.NewInt(params.InitialBaseFee),
+			Difficulty: common.Big0, Alloc: alloc}
+	}
+	_, blocks, _ := core.GenerateChainWithGenesis(genesis(1000), beacon.New(ethash.NewFaker()), 1, func(i int, b *core.BlockGen) {
+		b.AddTx(attack.WithoutBlobTxSidecar())
+	})
+	if blocks[0].Time() != 10 || len(blocks[0].Transactions()) != 1 || blocks[0].Transactions()[0].Type() != types.BlobTxType {
+		t.Fatal("unexpected test block")
+	}
+	return attack, blocks, func(tt uint64) *core.BlockChain {
+		chain, err := core.NewBlockChain(rawdb.NewMemoryDatabase(), genesis(tt), beacon.New(ethash.NewFaker()), nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return chain
+	}
+}
+
+// The attacker's envelope at the pool: refused after T (pool clock 12 at the
+// genesis head, T = 10) and admitted on the chain whose T is 1,000 (control).
+func TestPQBlobR1ExposedKeyAfterT(t *testing.T) {
+	attack, _, newChain := pqAttack(t)
+	for _, tc := range []struct {
+		t     uint64
+		admit bool
+	}{{1000, true}, {10, false}} {
+		chain := newChain(tc.t)
+		pool := New(Config{Datadir: t.TempDir()}, chain, nil)
+		if err := pool.Init(1, chain.CurrentBlock(), newReserver()); err != nil {
+			t.Fatal(err)
+		}
+		err := pool.Add([]*types.Transaction{attack}, true)[0]
+		if tc.admit != (err == nil) || (!tc.admit && !errors.Is(err, core.ErrECDSADisabled)) || tc.admit != pool.Has(attack.Hash()) {
+			t.Fatalf("T=%d: pool admission %v", tc.t, err)
+		}
+		t.Logf("T=%d: pool admission of the exposed-key type-3 envelope: %v", tc.t, err)
+		pool.Close()
+		chain.Stop()
+	}
+}
+
+// The attacker's envelope at import: a block at time 10 that holds it is
+// invalid on the chain with T = 10 (ECDSA_DISABLED from R1 in the shared
+// state-processing path, the victim's account untouched) and valid on the
+// chain with T = 1,000 (control). This is existing consensus behaviour of the
+// client; the test is located here so that the pool and import halves of the
+// vector run together.
+func TestPQBlobR1ExposedKeyImport(t *testing.T) {
+	_, blocks, newChain := pqAttack(t)
+	for _, tc := range []struct {
+		t     uint64
+		valid bool
+	}{{1000, true}, {10, false}} {
+		chain := newChain(tc.t)
+		_, err := chain.InsertChain(blocks)
+		st, _ := chain.State()
+		if tc.valid {
+			if err != nil || chain.CurrentBlock().Number.Uint64() != 1 {
+				t.Fatalf("control (T=%d): block refused: %v", tc.t, err)
+			}
+		} else {
+			if !errors.Is(err, core.ErrECDSADisabled) || chain.CurrentBlock().Number.Uint64() != 0 {
+				t.Fatalf("T=%d: block holding the attacker's type-3 envelope imported: %v", tc.t, err)
+			}
+			if st.GetBalance(pqAddrU).ToBig().Cmp(big.NewInt(params.Ether)) != 0 || st.GetNonce(pqAddrU) != 0 {
+				t.Fatal("victim's account changed")
+			}
+		}
+		t.Logf("T=%d: import of the block at time 10 holding the type-3 envelope: %v", tc.t, err)
+		chain.Stop()
+	}
+}
