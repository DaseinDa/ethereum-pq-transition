+	b := &types.PQBatchTx{ChainID: cfg.ChainID, Sponsor: sponsor, SponsorValidUntil: 1000,
+		GasTipCap: big.NewInt(1), GasFeeCap: big.NewInt(2), Gas: params.MaxTxGas,
+		VerifierVersion: params.PQFinalVersion, ProofCarrier: types.PQMigrationCarrier{Proof: []byte("state-only fixture")}}
+	for i := byte(1); i <= 4; i++ {
+		b.Entries = append(b.Entries, types.PQBatchEntry{LegacyAddress: common.Address{i}, AlgID: 1,
+			PQPKCommit: common.Hash{i}, Expiry: 1000, MaxAccountFee: new(big.Int), FeeMode: 2})
