@@ -0,0 +1,52 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package params
+
+import (
+	"fmt"
+
+	"github.com/ethereum/go-ethereum/common"
+)
+
+// Separate Lean experiment identity; the R-1 build remains unmodified.
+// Research only; no production or security acceptance.
+const (
+	PQR1ChainID uint64 = 13378
+	PQR1Version uint32 = 0x80000007
+)
+
+const PQSuccinctNativeBackend = "risc0-succinct-native-v1"
+
+// R-1's proof bound is 224,256 bytes (219 KiB). Its raw-transaction bound is
+// L_max of a 0x7e under R-1's record (spec section 29.4 rule 4): every field at
+// its longest canonical encoding, the carrier-A proof at the bound, a sponsor
+// signature at SIG_LEN 2,420 and no lane option, which carrier A excludes.
+const PQSuccinctMaxProofBytes uint64 = 224256
+const PQSuccinctMaxTxBytes uint64 = 226980
+
+var PQSuccinctImageID = common.HexToHash("020250ef5bcd6a6ebdca97d6206b2ecdb9e95ef907697dcab0e51911803d6100")
+
+// Bound to R-1's algorithm document, not a compiled library file: the Keccak-256
+// of the exact bytes of rust/R1-ALGORITHM.txt (spec section 22.3 rules 1-2).
+var PQSuccinctAlgorithmDigest = common.HexToHash("1a2005f6e7a04d3679ca1efc05735cff04bab5ca06d54f1eec1c5af0786d3f1b")
+
+// ValidateBackend admits only R-1's verifier: the in-process native library
+// (spec section 23.2, row verifier and identity). The external worker of the
+// earlier research profiles is refused.
+func (f *PQFullResearchConfig) ValidateBackend() error {
+	if f.Backend == PQFinalBackend {
+		return f.validateFinalBackend()
+	}
+	if f.FinalKeyDigest != (common.Hash{}) {
+		return fmt.Errorf("F key on non-F backend")
+	}
+	if f.Backend != PQSuccinctNativeBackend {
+		return fmt.Errorf("research profile R-1 admits only the %q Full backend, not %q", PQSuccinctNativeBackend, f.Backend)
+	}
+	if f.NativeAlgorithmDigest != PQSuccinctAlgorithmDigest || f.VerifierSHA != (common.Hash{}) ||
+		f.MaxProofBytes != PQSuccinctMaxProofBytes || f.MaxTxBytes != PQSuccinctMaxTxBytes {
+		return fmt.Errorf("unsupported native Succinct algorithm identity/bounds")
+	}
+	return nil
+}
