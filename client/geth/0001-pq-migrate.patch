@@ -0,0 +1,283 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package core
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"math/big"
+	"os"
+	"strings"
+	"testing"
+	"unicode/utf8"
+
+	"github.com/cloudflare/circl/sign/mldsa/mldsa44"
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core/state"
+	"github.com/ethereum/go-ethereum/core/tracing"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/crypto"
+	"github.com/ethereum/go-ethereum/params"
+	"github.com/holiman/uint256"
+)
+
+// Client changes (1) and (2) of research profile R-1 (spec section 23.2, row
+// client and network): R-1's values in the research binding, and the Keccak-256
+// identity of R-1's algorithm document. Component tests (model tier); the
+// native-linked build also checks the linked library itself.
+
+// r1TestChain is an R-1 configuration of the E1 kind, Osaka from genesis and T0
+// at t0. It is test data, not the configuration of the stage freeze.
+func r1TestChain(t0 uint64) *params.ChainConfig {
+	cfg := *params.MergedTestChainConfig
+	cfg.ChainID = new(big.Int).SetUint64(params.PQR1ChainID)
+	cfg.PQMigrate = &params.PQMigrateConfig{T0: t0, ReceivingTime: t0, T: t0 + 100, W: 31536000, MaxPayloadBytes: 131072,
+		Registry: common.HexToAddress("800"), FactRegistry: common.HexToAddress("801"), FullResearch: nativeTestProfile()}
+	return &cfg
+}
+
+// Spec section 23.2 vector (a), its configuration part: the binary refuses to
+// start, with a configuration error and never a proof verdict, on every earlier
+// profile's chain id, version, identity and bounds.
+func TestPQR1BindingRefusesEarlierProfiles(t *testing.T) {
+	for _, t0 := range []uint64{0, 1000} {
+		if err := r1TestChain(t0).CheckConfigForkOrder(); err != nil {
+			t.Fatalf("R-1 with T0 %d refused: %v", t0, err)
+		}
+	}
+	osaka := uint64(2000)
+	for name, edit := range map[string]func(*params.ChainConfig){
+		"chain-13375":        func(c *params.ChainConfig) { c.ChainID = big.NewInt(13375) },
+		"chain-13374":        func(c *params.ChainConfig) { c.ChainID = big.NewInt(13374) },
+		"version-0x80000002": func(c *params.ChainConfig) { c.PQMigrate.FullResearch.Version = 0x80000002 },
+		"digest-sha256-of-ALGORITHM": func(c *params.ChainConfig) {
+			c.PQMigrate.FullResearch.NativeAlgorithmDigest = common.HexToHash("0675a90a342d394bf8b6b98f9df5e880d41fe6c6b0f605a800c33ba784ce09a2")
+		},
+		"digest-keccak-of-ALGORITHM": func(c *params.ChainConfig) {
+			c.PQMigrate.FullResearch.NativeAlgorithmDigest = common.HexToHash("f620627069ad9b85321180583d4eb22455935cffeaa271b408910de54e5bf8b0")
+		},
+		"digest-sha256-of-R1-document": func(c *params.ChainConfig) {
+			c.PQMigrate.FullResearch.NativeAlgorithmDigest = common.HexToHash("7a91ec3d33302d0ba7be815e5063a815760bfb1e9d1147f45066fe3a0d2c0efe")
+		},
+		"digest-sha3-of-R1-document": func(c *params.ChainConfig) {
+			c.PQMigrate.FullResearch.NativeAlgorithmDigest = common.HexToHash("4bb596ee3336191d36d9a88ee28778143a9a0861cb0b5dfa8e069b2898c15741")
+		},
+		"proof-bound-512KiB":   func(c *params.ChainConfig) { c.PQMigrate.FullResearch.MaxProofBytes = 512 << 10 },
+		"proof-bound-plus-one": func(c *params.ChainConfig) { c.PQMigrate.FullResearch.MaxProofBytes++ },
+		"raw-bound-768KiB":     func(c *params.ChainConfig) { c.PQMigrate.FullResearch.MaxTxBytes = 768 << 10 },
+		"external-worker-backend": func(c *params.ChainConfig) {
+			f := c.PQMigrate.FullResearch
+			f.Backend, f.NativeAlgorithmDigest, f.VerifierSHA, f.MaxProofBytes, f.MaxTxBytes = "", common.Hash{}, common.HexToHash("01"), 2<<20, 3<<20
+		},
+		"no-full-research":      func(c *params.ChainConfig) { c.PQMigrate.FullResearch = nil },
+		"t0-before-osaka":       func(c *params.ChainConfig) { c.OsakaTime = &osaka },
+		"receiving-time-not-t0": func(c *params.ChainConfig) { c.PQMigrate.ReceivingTime = c.PQMigrate.T0 + 1 },
+		"t-not-after-t0":        func(c *params.ChainConfig) { c.PQMigrate.T = c.PQMigrate.T0 },
+	} {
+		t.Run(name, func(t *testing.T) {
+			c := r1TestChain(1000)
+			edit(c)
+			if c.CheckConfigForkOrder() == nil {
+				t.Fatal("configuration of an earlier profile accepted")
+			}
+		})
+	}
+	t.Run("bridge-laboratory", func(t *testing.T) {
+		c := bridgeTestConfig(t)
+		osaka := *c.OsakaTime
+		c.ChainID = new(big.Int).SetUint64(params.PQR1ChainID)
+		c.PQMigrate = &params.PQMigrateConfig{T0: osaka, ReceivingTime: osaka, T: osaka + 100, W: 31536000, MaxPayloadBytes: 131072,
+			Registry: common.HexToAddress("800"), FactRegistry: common.HexToAddress("801"), FullResearch: nativeTestProfile()}
+		if err := c.CheckConfigForkOrder(); err != nil {
+			t.Fatal("E2 under R-1 refused", err)
+		}
+		c.ChainID = big.NewInt(13375)
+		if c.CheckConfigForkOrder() == nil {
+			t.Fatal("bridge laboratory on chain 13375 accepted")
+		}
+	})
+}
+
+// L_max of a 0x7e under R-1's record (spec section 29.4 rule 4): every integer
+// at the largest value of its range, the carrier-A proof at 224,256 bytes, a
+// sponsor signature at SIG_LEN, no lane option (carrier A admits none).
+func TestPQR1RawTransactionBound(t *testing.T) {
+	u256 := new(big.Int).Sub(new(big.Int).Lsh(common.Big1, 256), common.Big1)
+	u64 := ^uint64(0)
+	var a common.Address
+	m := &types.PQMigrateTx{ChainID: u256, LegacyAddress: a, MigrationNonce: u64, AlgID: 0xff, Expiry: u64, MaxAccountFee: u256,
+		FeeMode: 0xff, FeeSponsor: a, FeeAuthUntil: u64, GasTipCap: u256, GasFeeCap: u256, Gas: u64,
+		SponsorOption:   &types.PQMigrationSponsor{Sponsor: a, ValidUntil: u64, Signature: make([]byte, mldsa44.SignatureSize)},
+		VerifierVersion: ^uint32(0), ProofCarrier: types.PQMigrationCarrier{Route: 0, Proof: make([]byte, params.PQSuccinctMaxProofBytes)}}
+	raw, err := types.NewTx(m).MarshalBinary()
+	if err != nil {
+		t.Fatal(err)
+	}
+	// The carrier's route is the integer 0 of carrier A. Read as one more
+	// integer at the largest value of its u8 range, it encodes one byte longer;
+	// the bound takes that longer reading, so no conforming carrier exceeds it.
+	if lmax := uint64(len(raw)) + 1; lmax != params.PQSuccinctMaxTxBytes {
+		t.Fatalf("L_max of a 0x7e under R-1 is %d, the client's raw bound %d", lmax, params.PQSuccinctMaxTxBytes)
+	}
+	t.Logf("L_max(0x7e, R-1) = %d bytes (route at its value 0: %d)", params.PQSuccinctMaxTxBytes, len(raw))
+}
+
+// Spec section 23.2 vector (d), at the client: a proof of 224,257 bytes is
+// refused by check 2 before any verification; one of exactly 224,256 bytes
+// passes check 2 and reaches the verifier.
+func TestPQR1ProofBound(t *testing.T) {
+	cfg := r1TestChain(0)
+	s, err := state.New(types.EmptyRootHash, state.NewDatabaseForTesting())
+	if err != nil {
+		t.Fatal(err)
+	}
+	owner := common.HexToAddress("1234")
+	s.SetBalance(owner, uint256.NewInt(2000000000000000000), tracing.BalanceChangeUnspecified)
+	for _, a := range []common.Address{cfg.PQMigrate.Registry, cfg.PQMigrate.FactRegistry} {
+		s.SetCode(a, []byte{0}, tracing.CodeChangeUnspecified)
+		s.SetNonce(a, 1, tracing.NonceChangeUnspecified)
+	}
+	carrier := func(n uint64) *types.Transaction {
+		return types.NewTx(&types.PQMigrateTx{ChainID: cfg.ChainID, LegacyAddress: owner, AlgID: 1, PQPKCommit: common.HexToHash("01"), Expiry: 2000,
+			MaxAccountFee: big.NewInt(100000000000000000), GasTipCap: big.NewInt(1), GasFeeCap: big.NewInt(1000000000), Gas: params.MaxTxGas,
+			VerifierVersion: params.PQR1Version, ProofCarrier: types.PQMigrationCarrier{Proof: make([]byte, n)}})
+	}
+	h := &types.Header{Number: big.NewInt(1), Time: 1000, GasLimit: 30000000, BaseFee: big.NewInt(1), Difficulty: new(big.Int)}
+	saved := pqNativeLibrary
+	defer func() { pqNativeLibrary = saved }()
+	calls := 0
+	pqNativeLibrary.identity = func() (string, bool) {
+		return `{"native_algorithm_digest":"` + params.PQSuccinctAlgorithmDigest.Hex() + `","algorithm_document_canonical":true,"native_algorithm_digest_hash":"keccak256","image_id":"` +
+			params.PQSuccinctImageID.Hex() + `","guest_sha256":"` + cfg.PQMigrate.FullResearch.GuestSHA.Hex() + `","dev_mode":false,"groth16":false}`, true
+	}
+	pqNativeLibrary.verify = func([]byte, []byte) int { calls++; return 1 }
+	over := carrier(params.PQSuccinctMaxProofBytes + 1)
+	if uint64(over.Size()) > params.PQSuccinctMaxTxBytes {
+		t.Fatal("an over-bound proof should meet check 2, not the raw bound")
+	}
+	for _, err := range []error{ValidatePQMigrateState(over, s.Copy(), h, cfg), ValidatePQMigrateProof(over, cfg, "test")} {
+		if name := pqMigrationErrorName(err); name != "PROOF_TOO_LARGE" {
+			t.Fatalf("224,257-byte proof: %v", err)
+		}
+	}
+	if calls != 0 {
+		t.Fatal("an over-bound proof reached the verifier")
+	}
+	if err := ValidatePQMigrateProof(carrier(params.PQSuccinctMaxProofBytes), cfg, "test"); !errors.Is(err, ErrPQInvalidFullProof) || calls != 1 {
+		t.Fatalf("224,256-byte proof did not pass check 2 to the verifier: %v, calls=%d", err, calls)
+	}
+}
+
+// Spec section 23.2 vector (d), its last clause, at the linked library: a root
+// receipt padded with trailing bytes to exactly 224,256 bytes passes the bound
+// and is rejected by the no-trailing-byte rule. The frozen root of section 22.7
+// stands in for R-1's own root, which does not exist yet.
+func TestPQR1PaddedRootRejected(t *testing.T) {
+	proofPath, piPath := os.Getenv("PQ_NATIVE_PROOF"), os.Getenv("PQ_NATIVE_PI")
+	if proofPath == "" || piPath == "" {
+		t.Skip("requires the frozen root receipt and its 198-byte PI")
+	}
+	if _, linked := pqNativeIdentityJSON(); !linked {
+		t.Skip("requires the native-linked build")
+	}
+	proof, err := os.ReadFile(proofPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	pi, err := os.ReadFile(piPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	f := nativeTestProfile()
+	if err := VerifyPQFull(f, pi, proof); err != nil {
+		t.Fatal("frozen root not accepted for its own PI", err)
+	}
+	padded := append(bytes.Clone(proof), make([]byte, int(params.PQSuccinctMaxProofBytes)-len(proof))...)
+	if err := VerifyPQFull(f, pi, padded); !errors.Is(err, ErrPQInvalidFullProof) || errors.Is(err, ErrPQFullUnavailable) {
+		t.Fatalf("root padded to 224,256 bytes: %v", err)
+	}
+	t.Logf("root of %d bytes accepted for its own PI; padded to %d bytes, rejected as an invalid proof", len(proof), len(padded))
+}
+
+func pqMigrationErrorName(err error) string {
+	var named *PQMigrationError
+	if errors.As(err, &named) {
+		return named.Name
+	}
+	return ""
+}
+
+// The start-up identity check of spec section 22.3 rule 3 for R-1's document:
+// the library's declaration is accepted only with R-1's Keccak-256 digest of a
+// canonical document, and every other declaration is a local fault.
+func TestPQR1IdentityStartupCheck(t *testing.T) {
+	profile := nativeTestProfile()
+	declared := func(edit func(map[string]any)) string {
+		id := map[string]any{"native_algorithm_digest": params.PQSuccinctAlgorithmDigest.Hex(), "algorithm_document_canonical": true,
+			"native_algorithm_digest_hash": "keccak256", "image_id": profile.ImageID.Hex(), "guest_sha256": profile.GuestSHA.Hex(),
+			"dev_mode": false, "groth16": false}
+		edit(id)
+		b, err := json.Marshal(id)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return string(b)
+	}
+	if err := checkPQNativeIdentity(profile, declared(func(map[string]any) {})); err != nil {
+		t.Fatal("R-1 identity refused", err)
+	}
+	changed := map[string]func(map[string]any){
+		"document-not-canonical": func(id map[string]any) { id["algorithm_document_canonical"] = false },
+		"hash-named-sha256":      func(id map[string]any) { id["native_algorithm_digest_hash"] = "sha256" },
+		"sha256-of-ALGORITHM": func(id map[string]any) {
+			id["native_algorithm_digest"] = "0x0675a90a342d394bf8b6b98f9df5e880d41fe6c6b0f605a800c33ba784ce09a2"
+		},
+		"keccak-of-ALGORITHM": func(id map[string]any) {
+			id["native_algorithm_digest"] = "0xf620627069ad9b85321180583d4eb22455935cffeaa271b408910de54e5bf8b0"
+		},
+		"sha256-of-R1-document": func(id map[string]any) {
+			id["native_algorithm_digest"] = "0x7a91ec3d33302d0ba7be815e5063a815760bfb1e9d1147f45066fe3a0d2c0efe"
+		},
+		"sha3-of-R1-document": func(id map[string]any) {
+			id["native_algorithm_digest"] = "0x4bb596ee3336191d36d9a88ee28778143a9a0861cb0b5dfa8e069b2898c15741"
+		},
+		"dev-mode": func(id map[string]any) { id["dev_mode"] = true },
+		"groth16":  func(id map[string]any) { id["groth16"] = true },
+		"guest":    func(id map[string]any) { id["guest_sha256"] = "0x01" },
+	}
+	if path := os.Getenv("PQ_R1_ALGORITHM_PATH"); path != "" {
+		doc, err := os.ReadFile(path)
+		if err != nil {
+			t.Fatal(err)
+		}
+		body := doc[:len(doc)-1]
+		if crypto.Keccak256Hash(doc) != params.PQSuccinctAlgorithmDigest || !utf8.Valid(doc) || bytes.HasPrefix(doc, []byte{0xef, 0xbb, 0xbf}) ||
+			bytes.IndexByte(doc, '\r') >= 0 || len(body) == 0 || doc[len(doc)-1] != '\n' || body[len(body)-1] == '\n' {
+			t.Fatal("R-1's document is not the canonical artifact the configuration pins")
+		}
+		edited := bytes.Clone(doc)
+		edited[0] ^= 1
+		changed["one-byte-changed-document"] = func(id map[string]any) { id["native_algorithm_digest"] = crypto.Keccak256Hash(edited).Hex() }
+	}
+	for name, edit := range changed {
+		t.Run(name, func(t *testing.T) {
+			err := checkPQNativeIdentity(profile, declared(edit))
+			if !errors.Is(err, ErrPQFullUnavailable) || errors.Is(err, ErrPQInvalidFullProof) {
+				t.Fatalf("not a local start-up fault: %v", err)
+			}
+		})
+	}
+	raw, linked := pqNativeIdentityJSON()
+	if !linked {
+		t.Log("no-library build: the linked library's own declaration is checked in the native-linked build")
+		return
+	}
+	if err := CheckPQFullVerifierConfig(profile); err != nil {
+		t.Fatal("the linked R-1 library fails the start-up check", err)
+	}
+	if !strings.Contains(raw, `"research_profile":"R-1"`) || !strings.Contains(raw, `"max_proof_bytes":224256`) {
+		t.Fatalf("linked library is not R-1's: %s", raw)
+	}
+}
diff --git a/core/pq_r1_root_test.go b/core/pq_r1_root_test.go
