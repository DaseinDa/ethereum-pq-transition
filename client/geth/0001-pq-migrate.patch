+func TestPQFullActualFeeFallbacks(t *testing.T) {
+	cases := []struct {
+		name      string
+		timestamp uint64
+		payer     common.Address
+	}{
+		{"other-sponsor-migrate", 1792108800, fullOther},
+		{"fee-expired-migrate", 1792108801, fullSponsor},
+	}
+	for _, v := range cases {
+		t.Run(v.name, func(t *testing.T) {
+			if _, e := os.Stat(filepath.Join(fullTestInputs, v.name+".bin")); e != nil {
+				t.Skip("real fallback proof/raw not yet available")
+			}
+			s, evm, h := fullEnv(t, fullLegacy)
+			h.Time = v.timestamp
+			evm.Context.Time = v.timestamp
+			tx := fullRead(t, v.name)
+			p, _ := tx.AsPQMigrate()
+			if p == nil || p.SponsorOption.Sponsor != v.payer {
+				t.Fatal("fallback fixture identity")
+			}
+			beforeL, beforeS := s.GetBalance(fullLegacy).ToBig(), s.GetBalance(v.payer).ToBig()
+			beforeN := s.GetNonce(v.payer)
+			rc := pqApply(t, s, evm, h, NewGasPool(h.GasLimit), tx, 2)
+			wantL := new(big.Int).Add(beforeL, new(big.Int).Mul(new(big.Int).SetUint64(rc.GasUsed), big.NewInt(100000000)))
+			wantS := new(big.Int).Sub(beforeS, new(big.Int).Mul(new(big.Int).SetUint64(rc.GasUsed), big.NewInt(1100000000)))
+			if s.GetBalance(fullLegacy).CmpBig(wantL) != 0 || s.GetBalance(v.payer).CmpBig(wantS) != 0 || s.GetNonce(v.payer) != beforeN {
+				t.Fatal("fallback must be valid with exactly zero reimbursement")
+			}
+			if ReadPQRecord(s, evm.ChainConfig().PQMigrate.Registry, fullLegacy).Mode != 2 || rc.Status != 1 {
+				t.Fatal("fallback failed migration")
+			}
+			t.Logf("actual Full %s valid; reimbursement=0; gas=%d; coinbase=owner priority credit=%s", v.name, rc.GasUsed, new(big.Int).Sub(wantL, beforeL))
+		})
+	}
+}
