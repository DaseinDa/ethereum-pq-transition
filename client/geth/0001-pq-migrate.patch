+func TestPQBatchRealNativeExecutionAndSkips(t *testing.T) {
+	for _, skip := range []int{0, 1, 4} {
+		t.Run(string(rune('0'+skip))+"-skips", func(t *testing.T) {
+			tx, s, evm, h := batchFixture(t)
+			b, _ := tx.AsPQBatch()
+			cfg := evm.ChainConfig()
+			for i := 0; i < skip; i++ {
+				e := b.Entries[i]
+				writePQRecord(s, cfg.PQMigrate.Registry, e.LegacyAddress, PQRecord{Mode: 2, AlgID: 1, MigrationNonce: 1, Commit: e.PQPKCommit})
+			}
+			before := new(uint256.Int).Set(s.GetBalance(b.Sponsor))
+			s.SetTxContext(tx.Hash(), 0, 1)
+			result, err := ApplyMessage(evm, &Message{PQTransaction: tx, GasLimit: b.Gas}, NewGasPool(h.GasLimit))
+			if err != nil {
+				t.Fatal(err)
+			}
+			if s.GetNonce(b.Sponsor) != b.SponsorNonce+1 {
+				t.Fatal("sponsor replay counter")
+			}
+			logs := s.GetLogs(tx.Hash(), h.Number.Uint64(), common.Hash{}, h.Time)
+			if len(logs) != 4 {
+				t.Fatal("receipt log count", len(logs))
+			}
+			for i, e := range b.Entries {
+				if s.GetNonce(e.LegacyAddress) != 9 || s.GetBalance(e.LegacyAddress).Uint64() != 2_000_000_000_000_000_000 {
+					t.Fatal("owner nonce or mode2 balance changed")
+				}
+				r := ReadPQRecord(s, cfg.PQMigrate.Registry, e.LegacyAddress)
+				if r.Mode != 2 || r.MigrationNonce != 1 || r.Commit != e.PQPKCommit {
+					t.Fatal("recovery result", r)
+				}
+				if i < skip {
+					if len(logs[i].Data) != 64 || binary.BigEndian.Uint32(logs[i].Data[28:32]) != uint32(i) || binary.BigEndian.Uint16(logs[i].Data[62:]) != 0x0105 {
+						t.Fatal("skip order/code", logs[i])
+					}
+				} else if len(logs[i].Data) != 160 || binary.BigEndian.Uint64(logs[i].Data[88:96]) != 1 {
+					t.Fatal("applied receipt")
+				}
+			}
+			wantGas := batchExpectedGas(t, b, uint64(4-skip)*44200)
+			if result.UsedGas != wantGas {
+				t.Fatal("independent gas formula", result.UsedGas, wantGas)
+			}
+			price := new(big.Int).Add(h.BaseFee, b.GasTipCap)
+			want := new(uint256.Int).Mul(uint256.NewInt(wantGas), uint256.MustFromBig(price))
+			if new(uint256.Int).Sub(before, s.GetBalance(b.Sponsor)).Cmp(want) != 0 {
+				t.Fatal("sponsor charge")
+			}
+			receipt := &types.Receipt{Type: types.PQBatchTxType, Status: 1, CumulativeGasUsed: result.UsedGas, Logs: logs}
+			encoded, err := rlp.EncodeToBytes(receipt)
+			if err != nil {
+				t.Fatal(err)
+			}
+			var decoded types.Receipt
+			if err = rlp.DecodeBytes(encoded, &decoded); err != nil || decoded.Type != 0x7f || len(decoded.Logs) != 4 {
+				t.Fatal("typed receipt roundtrip", err)
+			}
+			if _, err = ApplyMessage(evm, &Message{PQTransaction: tx, GasLimit: b.Gas}, NewGasPool(h.GasLimit)); err == nil {
+				t.Fatal("same batch replay accepted")
+			}
+		})
+	}
