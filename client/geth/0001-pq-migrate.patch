+		t.Skipf("the real carrier's proof expired at %s (pool clock now %d): its PI is never edited and the clock never rolled back", expiry, now)
+	}
+	// Two empty blocks on the F run's genesis: the first before T0, the second
+	// (the T0 transition block, whose system-image installation the generator
+	// and the importer both apply) moved to the real clock.
+	t0 := gspec.Config.PQMigrate.T0
+	_, blocks, _ := core.GenerateChainWithGenesis(gspec, beacon.New(ethash.NewFaker()), 2, func(i int, b *core.BlockGen) {
+		if i == 1 {
+			if b.Timestamp() < t0 {
