+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package core
+
+import (
+	"crypto/sha256"
+	"encoding/json"
+	"fmt"
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/log"
+	"github.com/ethereum/go-ethereum/params"
+	"time"
+)
+
+// Only tests replace these functions. No RPC or runtime environment selects a verifier.
+var pqFinalLibrary = struct {
+	identity func() (string, bool)
+	ready    func() int
+	verify   func([]byte, []byte) int
+}{pqFinalIdentity, pqFinalReady, pqFinalVerify}
+
+func checkPQFinalConfig(c *params.PQFullResearchConfig) error {
+	if err := c.ValidateBackend(); err != nil {
+		return fmt.Errorf("%w: %v", ErrPQFullUnavailable, err)
+	}
+	raw, ok := pqFinalLibrary.identity()
+	if !ok {
+		return fmt.Errorf("%w: F native library not linked", ErrPQFullUnavailable)
+	}
+	var id struct {
+		ABI             int         `json:"abi"`
+		Backend         string      `json:"backend"`
+		ChainID         uint64      `json:"chain_id"`
+		Version         uint32      `json:"verifier_version"`
+		AlgorithmDigest common.Hash `json:"algorithm_digest"`
+		DigestHash      string      `json:"algorithm_digest_hash"`
+		F               common.Hash `json:"f_vk_digest"`
+		B               common.Hash `json:"b_vk_digest"`
+		L0              common.Hash `json:"l0p2_vk_digest"`
+		Max             uint64      `json:"max_proof_bytes"`
+		PI              int         `json:"pi_bytes"`
+		Groth16         bool        `json:"groth16"`
+		Dev             bool        `json:"dev_mode"`
+	}
+	if err := json.Unmarshal([]byte(raw), &id); err != nil {
+		return fmt.Errorf("%w: F identity: %v", ErrPQFullUnavailable, err)
+	}
+	if id.ABI != 1 || id.Backend != params.PQFinalBackend || id.ChainID != params.PQR1ChainID || id.Version != params.PQFinalVersion ||
+		id.AlgorithmDigest != params.PQFinalAlgorithmDigest || id.DigestHash != "keccak256" || id.F != params.PQFinalKeyDigest ||
+		id.B != params.PQFinalBKeyDigest || id.L0 != params.PQFinalL0KeyDigest || id.Max != params.PQFinalMaxProofBytes || id.PI != 198 || id.Groth16 || id.Dev {
+		return fmt.Errorf("%w: F native algorithm/key identity mismatch", ErrPQFullUnavailable)
+	}
+	if status := pqFinalLibrary.ready(); status != 0 {
+		return fmt.Errorf("%w: F key initialization status %d", ErrPQFullUnavailable, status)
+	}
+	return nil
+}
+
+func verifyPQFinal(c *params.PQFullResearchConfig, pi, proof []byte) error {
+	if len(pi) != 198 || len(proof) == 0 || uint64(len(proof)) > params.PQFinalMaxProofBytes {
+		return fmt.Errorf("%w: F proof or PI length", ErrPQInvalidFullProof)
+	}
+	start := time.Now()
+	status := pqFinalLibrary.verify(proof, pi)
+	log.Info("PQ_F_NATIVE_RESULT", "pi", common.Hash(sha256.Sum256(pi)), "proof", common.Hash(sha256.Sum256(proof)), "status", status, "verifyElapsed", time.Since(start))
+	switch status {
+	case 0:
+		return nil
+	case 1, 2:
+		return fmt.Errorf("%w: F native rejection class %d", ErrPQInvalidFullProof, status)
+	default:
+		return fmt.Errorf("%w: F native local fault status %d", ErrPQFullUnavailable, status)
+	}
+}
