+}
+func actualImport(t *testing.T, bc *core.BlockChain, b *types.Block, canonical bool) {
+	t.Helper()
+	if _, err := bc.InsertBlockWithoutSetHead(context.Background(), b, false); err != nil {
+		t.Fatal(err)
