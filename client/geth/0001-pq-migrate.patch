@@ -0,0 +1,131 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package ethapi
+
+import (
+	"encoding/json"
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/common/hexutil"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/params"
+	"math/big"
+	"os"
+	"testing"
+)
+
+// RPC representation roundtrip only; proof validity is tested elsewhere.
+func TestPQFullRPCSchema(t *testing.T) {
+	if os.Getenv("PQ_LEGACY_MIGRATE_FILE") == "" {
+		t.Skip("set PQ_LEGACY_MIGRATE_FILE for the carrier vector")
+	}
+	raw, err := os.ReadFile(os.Getenv("PQ_LEGACY_MIGRATE_FILE"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	tx := new(types.Transaction)
+	if err = tx.UnmarshalBinary(raw); err != nil {
+		t.Fatal(err)
+	}
+	cfg := *params.AllDevChainProtocolChanges
+	cfg.ChainID = big.NewInt(13375)
+	pending := NewRPCPendingTransaction(tx, nil, &cfg)
+	encoded, err := json.Marshal(pending)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var fields map[string]json.RawMessage
+	if err = json.Unmarshal(encoded, &fields); err != nil {
+		t.Fatal(err)
+	}
+	for _, name := range []string{"from", "sponsor", "sponsorValidUntil", "sponsorSig", "legacyAddress", "migrationNonce", "sponsorOption", "proofCarrier", "verifierVersion", "maxAccountFee", "feeSponsor", "feeAuthUntil", "blockHash", "transactionIndex"} {
+		if _, ok := fields[name]; !ok {
+			t.Fatal("missing Full RPC field", name)
+		}
+	}
+	for _, name := range []string{"nonce", "v", "r", "s", "to", "input", "value"} {
+		if _, ok := fields[name]; ok {
+			t.Fatal("manufactured ordinary envelope", name)
+		}
+	}
+	if string(fields["blockHash"]) != "null" {
+		t.Fatal("pending has block hash")
+	}
+	migration, _ := tx.AsPQMigrate()
+	assertAliases := func(fields map[string]json.RawMessage) {
+		t.Helper()
+		for name, want := range map[string]interface{}{
+			"from": migration.LegacyAddress, "sponsor": migration.Sponsor().Sponsor,
+			"sponsorValidUntil": hexutil.Uint64(migration.Sponsor().ValidUntil),
+			"sponsorSig":        hexutil.Bytes(migration.Sponsor().Signature),
+		} {
+			encoded, err := json.Marshal(want)
+			if err != nil || string(fields[name]) != string(encoded) {
+				t.Fatalf("RPC alias %s have=%s want=%s err=%v", name, fields[name], encoded, err)
+			}
+		}
+	}
+	assertAliases(fields)
+	// All mined transaction RPC entry points use this same representation.
+	mined := newRPCTransaction(tx, common.HexToHash("42"), 17, 1792108800, 2, big.NewInt(1000000000), &cfg)
+	minedJSON, err := json.Marshal(mined)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var minedFields map[string]json.RawMessage
+	if err = json.Unmarshal(minedJSON, &minedFields); err != nil {
+		t.Fatal(err)
+	}
+	assertAliases(minedFields)
+	if string(minedFields["blockHash"]) == "null" || string(minedFields["transactionIndex"]) != "\"0x2\"" {
+		t.Fatal("mined RPC metadata lost")
+	}
+	// Optional sponsor aliases must be absent for an unsponsored envelope.
+	// This copied object is a codec fixture only, not a valid Full proof intent.
+	unsignedCopy := types.NewTx(migration)
+	withoutSponsor, _ := unsignedCopy.AsPQMigrate()
+	withoutSponsor.SponsorOption = nil
+	withoutSponsor.FeeMode = 0
+	withoutSponsor.FeeSponsor = common.Address{}
+	withoutSponsor.FeeAuthUntil = 0
+	noSponsorJSON, err := json.Marshal(NewRPCPendingTransaction(types.NewTx(withoutSponsor), nil, &cfg))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var noSponsorFields map[string]json.RawMessage
+	if err = json.Unmarshal(noSponsorJSON, &noSponsorFields); err != nil {
+		t.Fatal(err)
+	}
+	for _, name := range []string{"sponsor", "sponsorValidUntil", "sponsorSig"} {
+		if _, ok := noSponsorFields[name]; ok {
+			t.Fatal("absent sponsor has alias", name)
+		}
+	}
+	if string(noSponsorFields["from"]) != string(fields["from"]) || string(noSponsorFields["sponsorOption"]) != "null" {
+		t.Fatal("unsponsored representation lost from/option")
+	}
+	var decoded types.Transaction
+	if err = json.Unmarshal(encoded, &decoded); err != nil || decoded.Hash() != tx.Hash() {
+		t.Fatal("Full RPC lost signed bytes", err)
+	}
+	ordinary := types.NewTx(&types.LegacyTx{Gas: 21000, GasPrice: big.NewInt(1), Value: new(big.Int), To: func() *common.Address { a := common.Address{}; return &a }()})
+	encoded, err = json.Marshal(NewRPCPendingTransaction(ordinary, nil, &cfg))
+	if err != nil {
+		t.Fatal(err)
+	}
+	fields = nil
+	if err = json.Unmarshal(encoded, &fields); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := fields["nonce"]; !ok {
+		t.Fatal("ordinary RPC nonce changed")
+	}
+	if _, ok := fields["proofCarrier"]; ok {
+		t.Fatal("ordinary RPC schema contaminated")
+	}
+	after, err := tx.MarshalBinary()
+	if err != nil || string(after) != string(raw) {
+		t.Fatal("RPC alias rendering changed signed raw")
+	}
+	t.Logf("Full pending/mined RPC from and sponsor aliases match exact fields; canonical hash=%s/raw unchanged; optional aliases omitted and ordinary RPC retained", tx.Hash())
+}
