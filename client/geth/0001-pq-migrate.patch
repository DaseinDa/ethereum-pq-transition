+	"github.com/holiman/uint256"
+	"testing"
+	"time"
+)
+
+func TestPQPoolSponsorPolicyPrecedesPriceAndDuplicate(t *testing.T) {
+	t.Run("ban-before-price", func(t *testing.T) {
+		p, _, calls := componentPool(t)
+		p.bans[addr(20)] = time.Now().Add(time.Minute)
+		if err := add(p, componentTx(1, 20, 0, 20)); !errors.Is(err, ErrSponsorBan) {
+			t.Fatal(err)
+		}
+		if *calls != 0 {
+			t.Fatal("invalid sponsor reached proof")
+		}
+	})
+	t.Run("horizon-before-price", func(t *testing.T) {
+		p, _, _ := componentPool(t)
+		tx := changed(componentTx(1, 20, 0, 20), func(m *types.PQMigrateTx) { m.SponsorOption.ValidUntil = 1131 })
+		if err := add(p, tx); !errors.Is(err, ErrSponsorHorizon) {
+			t.Fatal(err)
+		}
+	})
+	t.Run("count-before-price", func(t *testing.T) {
+		p, _, _ := componentPool(t)
+		p.cfg.MaxSponsored = 1
+		if err := add(p, componentTx(1, 20, 2, 20)); err != nil {
+			t.Fatal(err)
+		}
+		if err := add(p, componentTx(2, 20, 0, 20)); !errors.Is(err, ErrSponsorLimit) {
+			t.Fatal(err)
+		}
+	})
+	t.Run("duplicate-and-current-state", func(t *testing.T) {
+		p, _, calls := componentPool(t)
+		tx := componentTx(1, 20, 2, 20)
+		if err := add(p, tx); err != nil {
+			t.Fatal(err)
+		}
+		if err := add(p, tx); !errors.Is(err, txpool.ErrReplaceUnderpriced) {
+			t.Fatal(err)
+		}
+		if *calls != 1 || !p.Has(tx.Hash()) {
+			t.Fatal("duplicate changed pending/proof state")
+		}
+		expected := &core.PQMigrationError{Name: "WRONG_MIGRATION_NONCE", Code: 0x105}
+		p.checkState = func(*types.Transaction, *state.StateDB, *types.Header, *params.ChainConfig) error { return expected }
+		if err := add(p, tx); !errors.Is(err, expected) {
+			t.Fatal("duplicate shortcut skipped checks 4-7", err)
+		}
+	})
+}
+
+func TestPQPoolSponsorCheapCheckOrder(t *testing.T) {
+	p, _, _ := componentPool(t)
+	p.cfg.MaxSponsored = 1
+	if err := add(p, componentTx(1, 20, 2, 20)); err != nil {
+		t.Fatal(err)
+	}
+	p.bans[addr(20)] = time.Now().Add(time.Minute)
+	candidate := changed(componentTx(2, 20, 0, 20), func(m *types.PQMigrateTx) { m.SponsorOption.ValidUntil = 1131 })
+	// Each individual debit fits, but the cumulative pair does not.
+	p.state.SetBalance(addr(20), uint256.NewInt(3000), tracing.BalanceChangeUnspecified)
+	if err := add(p, candidate); err == nil || err.Error() != "INSUFFICIENT_FEE_BALANCE" {
+		t.Fatal("bound before count/horizon/ban/tip", err)
+	}
+	p.state.SetBalance(addr(20), uint256.NewInt(100000), tracing.BalanceChangeUnspecified)
+	if err := add(p, candidate); !errors.Is(err, ErrSponsorLimit) {
+		t.Fatal("count before horizon/ban/tip", err)
+	}
+	p.cfg.MaxSponsored = 2
+	if err := add(p, candidate); !errors.Is(err, ErrSponsorHorizon) {
+		t.Fatal("horizon before ban/tip", err)
+	}
+	candidate = changed(candidate, func(m *types.PQMigrateTx) { m.SponsorOption.ValidUntil = 10000 })
+	if err := add(p, candidate); !errors.Is(err, ErrSponsorBan) {
+		t.Fatal("ban before tip", err)
+	}
+}
diff --git a/core/txpool/pqpool/sponsor_strikes.go b/core/txpool/pqpool/sponsor_strikes.go
new file mode 100644
index 0000000000000000000000000000000000000000..49546e335f9f33bd52749b5c341241eb73f39d7d
--- /dev/null
+++ b/core/txpool/pqpool/sponsor_strikes.go
@@ -0,0 +1,159 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package pqpool
+
+import (
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core"
+	"github.com/ethereum/go-ethereum/core/txpool"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/crypto"
+	"github.com/ethereum/go-ethereum/log"
+)
+
+// Fixed process-local bounds. Overflow and unavailable history cancel a strike;
+// neither condition is evidence against a peer (sections 24.7 and 28.2).
+const maxSponsorStrikes = 4096
+const maxSponsorStrikesPerSource = 64
+const maxStrikeHistoryBlocks = 4096
+
+type sponsorStrike struct {
+	source              string
+	account             common.Address
+	key                 common.Hash // keccak of the complete effective marker, including alg_id
+	delivered, rejected uint64
+	// Only ML-DSA-44 is admitted by this profile, so its fixed gas weight is 1.
+}
+
+func (p *Pool) strikeHorizon() (uint64, bool) {
+	slot := txpool.PQPoolSlot(p.chain.Config())
+	if slot == 0 || slot > ^uint64(0)/10 {
+		return 0, false
+	}
+	return 10 * slot, true
+}
+
+// The integer interval is (min(td,tr)-hs, max(td,tr)+hs], never unsigned
+// subtraction or saturation. Forks at or before genesis activate in no window.
+func (p *Pool) signatureForkWindow(delivered, rejected, hs uint64) bool {
+	lo, hi := min(delivered, rejected), max(delivered, rejected)
+	inWindow := func(f uint64) bool {
+		return f > p.genesisTime && (f >= lo || lo-f < hs) && (f <= hi || f-hi <= hs)
+	}
+	c := p.chain.Config()
+	for _, f := range []*uint64{c.ShanghaiTime, c.CancunTime, c.PragueTime, c.OsakaTime,
+		c.BPO1Time, c.BPO2Time, c.BPO3Time, c.BPO4Time, c.BPO5Time, c.AmsterdamTime, c.BogotaTime, c.UBTTime} {
+		if f != nil && inWindow(*f) {
+			return true
+		}
+	}
+	return c.PQMigrate != nil && (inWindow(c.PQMigrate.T0) || inWindow(c.PQMigrate.T))
+}
+
+func (p *Pool) admissionFailure(source string, tx *types.Transaction, delivered *uint64, err error) error {
+	if delivered == nil || err == nil || retryable(err) {
+		return err
+	}
+	if errorName(err) != "BAD_SPONSOR_SIG" {
+		return p.budgetFailure(source, err)
+	}
+	hs, ok := p.strikeHorizon()
+	if !ok || len(p.sponsorStrikes) >= maxSponsorStrikes {
+		return err
+	}
+	rejected := p.nextHeader().Time
+	if p.signatureForkWindow(*delivered, rejected, hs) {
+		return err
+	}
+	var account common.Address
+	if m, ok := tx.AsPQMigrate(); ok && m.Sponsor() != nil {
+		account = m.Sponsor().Sponsor
+	} else if b, ok := tx.AsPQBatch(); ok {
+		account = b.Sponsor
+	} else {
+		return err
+	}
+	attempt := p.state.Copy()
+	code := attempt.GetCode(account)
+	if attempt.Error() != nil || len(code) != 1315 || code[0] != 0xef || code[1] != 1 || code[2] != 1 {
+		return err
+	}
+	count := 0
+	for _, strike := range p.sponsorStrikes {
+		if strike.source == source {
+			count++
+		}
+	}
+	if count >= maxSponsorStrikesPerSource {
+		return err
+	}
+	p.sponsorStrikes = append(p.sponsorStrikes, sponsorStrike{source, account, crypto.Keccak256Hash(code), *delivered, rejected})
+	log.Debug("PQPOOL_SPONSOR_STRIKE", "source", source, "account", account, "delivered", *delivered, "rejected", rejected)
+	return err
+}
+
+// Called only at a different canonical head, including a reorganization. A
+// decision is final: later reorgs never revive or undo a decided strike.
+func (p *Pool) decideSponsorStrikes(head *types.Header) {
+	hs, ok := p.strikeHorizon()
+	if !ok {
+		p.sponsorStrikes = nil
+		return
+	}
+	now := txpool.PQPoolTime(head, p.chain.Config())
+	keep := p.sponsorStrikes[:0]
+	for _, strike := range p.sponsorStrikes {
+		later := max(strike.delivered, strike.rejected)
+		if now < later || now-later < hs {
+			keep = append(keep, strike)
+			continue
+		}
+		if p.confirmSponsorStrike(strike, head, hs) {
+			// Charge the fixed ML-DSA-44 weight once, without verifying again.
+			if budget := p.source(strike.source); budget != nil {
+				budget.failures++
+				log.Warn("PQPOOL_SPONSOR_STRIKE_CONFIRMED", "source", strike.source, "failures", budget.failures)
+			}
+		}
+	}
+	// Clear removed source strings as well as the logical entries.
+	for i := len(keep); i < len(p.sponsorStrikes); i++ {
+		p.sponsorStrikes[i] = sponsorStrike{}
+	}
+	p.sponsorStrikes = keep
+}
+
+func (p *Pool) confirmSponsorStrike(strike sponsorStrike, head *types.Header, hs uint64) bool {
+	earlier := min(strike.delivered, strike.rejected)
+	slot := txpool.PQPoolSlot(p.chain.Config())
+	// range membership: timestamp + SLOT + hs >= earlier, without overflow
+	inRange := func(timestamp uint64) bool {
+		return timestamp >= earlier || earlier-timestamp <= hs || earlier-timestamp-hs <= slot
+	}
+	cursor := types.CopyHeader(head)
+	for checked := 0; checked < maxStrikeHistoryBlocks; checked++ {
+		if !inRange(cursor.Time) {
+			return true
+		}
+		state, err := p.chain.StateAt(cursor)
+		if err != nil || state == nil {
+			return false
+		}
+		attempt := state.Copy()
+		code := attempt.GetCode(strike.account)
+		activated := core.PQActivated(attempt, p.chain.Config().PQMigrate, strike.account)
+		if attempt.Error() != nil || !activated || crypto.Keccak256Hash(code) != strike.key {
+			return false
+		}
+		if cursor.Number.Sign() == 0 {
+			return true
+		}
+		parent := p.chain.GetBlock(cursor.ParentHash, cursor.Number.Uint64()-1)
+		if parent == nil || parent.Hash() != cursor.ParentHash || parent.NumberU64()+1 != cursor.Number.Uint64() || parent.Time() >= cursor.Time {
+			return false
+		}
+		cursor = parent.Header()
+	}
+	return false // The bounded scan could not decide; cancellation is mandatory.
+}
diff --git a/core/txpool/pqpool/sponsor_strikes_test.go b/core/txpool/pqpool/sponsor_strikes_test.go
