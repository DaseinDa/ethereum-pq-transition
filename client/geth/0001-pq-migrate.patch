+			a := newPQL2Node(t, gspec, blocks, pqL2RealPools(t))
+			defer a.close()
+			b := newPQL2Node(t, gspec, blocks, pqL2RealPools(t))
+			defer b.close()
+			atob, btoa, done := pqL2Connect(t, a, b, version, false)
+			defer done()
+
+			// Above the bound: refused at the source, nothing announced.
+			if err := a.pool.Add([]*types.Transaction{over}, true)[0]; err == nil {
+				t.Fatal("over-bound carrier admitted")
+			} else {
+				t.Logf("source refuses the %d-byte carrier: %v", over.Size(), err)
+			}
+			start := time.Now()
+			if err := a.pool.Add([]*types.Transaction{carrier}, true)[0]; err != nil {
+				t.Fatalf("source refused the real carrier: %v", err)
+			}
+			t.Logf("source admitted the real carrier after native F verification in %v", time.Since(start))
+			pqL2Propagated(t, atob, btoa, b, carrier)
+			if a.pool.(*txpool.TxPool).Status(carrier.Hash()) != txpool.TxStatusPending || b.pool.(*txpool.TxPool).Status(carrier.Hash()) != txpool.TxStatusPending {
+				t.Fatal("carrier not pending on both nodes")
+			}
+			if len(atob.find(eth.NewPooledTransactionHashesMsg, over.Hash())) != 0 || a.handler.peers.len() != 1 || b.handler.peers.len() != 1 {
+				t.Fatal("over-bound carrier announced, or a peer dropped")
+			}
+		})
+	}
+}
