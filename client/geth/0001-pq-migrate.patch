+		if err := add(p, componentTx(17, 20, 2, 20)); !errors.Is(err, ErrSponsorLimit) {
+			t.Fatal(err)
+		}
+		if *calls != 16 {
+			t.Fatal("17th candidate reached proof")
+		}
+	})
+	t.Run("cumulative", func(t *testing.T) {
+		p, chain, _ := componentPool(t)
+		chain.s.SetBalance(addr(20), uint256.NewInt(5000), tracing.BalanceChangeUnspecified)
+		p.state = chain.s.Copy()
+		for _, i := range []byte{1, 2} {
+			if err := add(p, componentTx(i, 20, 2, 20)); err != nil {
+				t.Fatal(err)
+			}
+		}
+		if err := add(p, componentTx(3, 20, 2, 20)); errorName(err) != "INSUFFICIENT_FEE_BALANCE" {
+			t.Fatal(err)
+		}
+		chain.s.SetBalance(addr(20), uint256.NewInt(3000), tracing.BalanceChangeUnspecified)
+		p.Reset(nil, p.head)
+		if len(p.entries) != 0 || !time.Now().Before(p.bans[addr(20)]) {
+			t.Fatal("sponsor cumulative insolvency did not evict/ban whole group")
+		}
+	})
+}
+func TestPQPoolComponentTimeAndHead(t *testing.T) {
+	t.Run("horizon", func(t *testing.T) {
+		p, _, calls := componentPool(t)
+		base := componentTx(1, 20, 2, 20)
+		bad := changed(base, func(m *types.PQMigrateTx) { m.SponsorOption.ValidUntil = 1131 })
+		if err := add(p, bad); !errors.Is(err, ErrSponsorHorizon) {
+			t.Fatal(err)
+		}
+		good := changed(base, func(m *types.PQMigrateTx) { m.SponsorOption.ValidUntil = 1132 })
+		if err := add(p, good); err != nil {
+			t.Fatal(err)
+		}
+		if *calls != 1 {
+			t.Fatal("horizon failed before Full")
+		}
+	})
+	t.Run("expiryEquality", func(t *testing.T) {
+		p, _, calls := componentPool(t)
+		tx := changed(componentTx(1, 20, 2, 20), func(m *types.PQMigrateTx) { m.Expiry = 1144; m.SponsorOption.ValidUntil = 1144 })
+		if err := add(p, tx); err != nil {
+			t.Fatal(err)
+		}
+		h := types.CopyHeader(p.head)
+		h.Time = 1120
+		p.Reset(nil, h)
+		if !p.Has(tx.Hash()) || *calls != 1 {
+			t.Fatal("expiry==now+slot must survive state recheck with cached Full")
+		}
+		h.Time = 1121
+		p.Reset(nil, h)
+		if p.Has(tx.Hash()) || len(p.bans) != 0 {
+			t.Fatal("near expiry eviction or erroneous sponsor ban")
+		}
+	})
+	t.Run("stateStale", func(t *testing.T) {
+		p, chain, calls := componentPool(t)
+		tx := componentTx(1, 20, 2, 20)
+		if err := add(p, tx); err != nil {
+			t.Fatal(err)
+		}
+		k, _ := core.PQRecordSlots(addr(1))
+		w := common.Hash{}
+		w[21] = 1
+		chain.s.SetState(chain.cfg.PQMigrate.Registry, k, w)
+		p.Reset(nil, p.head)
+		if p.Has(tx.Hash()) || *calls != 1 {
+			t.Fatal("stale migration version survived or invoked Full")
+		}
+	})
+}
+func TestPQPoolComponentBudgetAndLocalFailure(t *testing.T) {
+	p, _, _ := componentPool(t)
+	p.checkProof = func(*types.Transaction, *params.ChainConfig, string) error {
+		return fmt.Errorf("%w: malformed fixture", core.ErrPQInvalidFullProof)
+	}
+	for i := byte(1); i <= 5; i++ {
+		err := add(p, componentTx(i, 20, 2, 20))
+		if i < 5 && !errors.Is(err, core.ErrPQInvalidFullProof) {
+			t.Fatal(err)
+		}
+		if i == 5 && !errors.Is(err, txpool.ErrPQSourceBudget) {
+			t.Fatal(err)
+		}
+	}
+	if len(p.entries) != 0 {
+		t.Fatal("rejected proof took a slot")
+	}
+	p.checkProof = func(*types.Transaction, *params.ChainConfig, string) error {
+		return fmt.Errorf("%w: worker crashed", core.ErrPQFullUnavailable)
+	}
+	for i := 0; i < 6; i++ {
+		err := p.AddFrom("rpc:other", []*types.Transaction{componentTx(6, 20, 2, 20)}, true)[0]
+		if !errors.Is(err, core.ErrPQFullUnavailable) {
+			t.Fatal(err)
+		}
+	}
+	if p.sources["rpc:other"].failures != 0 {
+		t.Fatal("local fault poisoned invalid budget")
+	}
+	p.checkProof = func(*types.Transaction, *params.ChainConfig, string) error { return nil }
+	if err := p.AddFrom("rpc:other", []*types.Transaction{componentTx(6, 20, 2, 20)}, true)[0]; err != nil {
+		t.Fatal("repair did not permit resubmission", err)
+	}
+}
+func TestPQPoolComponentProfileAndCapacity(t *testing.T) {
+	p, chain, calls := componentPool(t)
+	chain.cfg.PQMigrate.FullResearch = nil
+	if p.FilterType(types.PQMigrateTxType) {
+		t.Fatal("default config accepted research type")
+	}
+	if err := add(p, componentTx(1, 20, 2, 20)); !errors.Is(err, core.ErrTxTypeNotSupported) {
+		t.Fatal(err)
+	}
+	if *calls != 0 {
+		t.Fatal("disabled profile called Full")
+	}
+	chain.cfg.PQMigrate.FullResearch = &params.PQFullResearchConfig{Version: 0x80000002, MaxProofBytes: 2 << 20, MaxTxBytes: 3 << 20, TxGasCap: params.MaxTxGas}
+	p.cfg.DataCap = 1
+	if err := add(p, componentTx(1, 20, 2, 20)); !errors.Is(err, txpool.ErrOutOfCapacity) {
+		t.Fatal(err)
+	}
+	if *calls != 0 || len(p.entries) != 0 {
+		t.Fatal("datacap admitted or verified")
+	}
+}
diff --git a/core/txpool/pqpool/proof_cache.go b/core/txpool/pqpool/proof_cache.go
new file mode 100644
index 0000000000000000000000000000000000000000..98a713446653ca832212b2d4be64b9263c6079a8
--- /dev/null
+++ b/core/txpool/pqpool/proof_cache.go
@@ -0,0 +1,218 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package pqpool
+
+import (
+	"container/list"
+	"encoding/binary"
+	"errors"
+	"math"
+	"time"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core"
+	"github.com/ethereum/go-ethereum/core/txpool"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/crypto"
+	"github.com/ethereum/go-ethereum/log"
+	"github.com/ethereum/go-ethereum/params"
+)
+
+// The cache retains only a digest, version/sunset metadata and LRU links, never
+// proof or witness bytes. Each entry reserves 256 bytes, conservatively covering
+// its fixed payload, map slot and list node. Separate positive/negative byte
+// caps prevent invalid-proof flooding from evicting successful verification.
+// The byte cap counts every entry, but only unpinned entries are evicted to meet
+// it: the entry of a pending item is pinned (spec section 20.17 (c): at least
+// one entry per pending item), so the cache exceeds the cap by pinned entries
+// alone, at most MaxPending x 256 bytes, and a cap below 256 keeps no other.
+const proofCacheEntryBytes uint64 = 256
+
+type proofResultEntry struct {
+	key     common.Hash
+	version uint32
+	sunset  uint64
+}
+type proofResultCache struct {
+	limit   uint64
+	entries map[common.Hash]*list.Element
+	lru     *list.List
+	pins    map[common.Hash]int // pending items per entry
+}
+
+func newProofResultCache(limit uint64) *proofResultCache {
+	return &proofResultCache{limit: limit, entries: make(map[common.Hash]*list.Element), lru: list.New(), pins: make(map[common.Hash]int)}
+}
+func (c *proofResultCache) len() int {
+	if c == nil {
+		return 0
+	}
+	return len(c.entries)
+}
+func (c *proofResultCache) bytes() uint64 { return uint64(c.len()) * proofCacheEntryBytes }
+func (c *proofResultCache) has(key common.Hash) bool {
+	if c == nil {
+		return false
+	}
+	if e := c.entries[key]; e != nil {
+		c.lru.MoveToFront(e)
+		return true
+	}
+	return false
+}
+func (c *proofResultCache) add(key common.Hash, version uint32, sunset uint64) {
+	if c == nil || c.has(key) {
+		return
+	}
+	c.entries[key] = c.lru.PushFront(proofResultEntry{key, version, sunset})
+	c.trim()
+}
+
+// trim evicts the least recently used unpinned entries until the byte cap holds
+// or only pinned entries remain.
+func (c *proofResultCache) trim() {
+	for e := c.lru.Back(); e != nil && c.bytes() > c.limit; {
+		previous := e.Prev()
+		if c.pins[e.Value.(proofResultEntry).key] == 0 {
+			c.remove(e)
+		}
+		e = previous
+	}
+}
+
+// pin records one more pending item whose admission has just verified key,
+// inserting the entry again if the byte cap had already evicted it.
+func (c *proofResultCache) pin(key common.Hash, version uint32, sunset uint64) {
+	if c == nil {
+		return
+	}
+	if !c.has(key) {
+		c.entries[key] = c.lru.PushFront(proofResultEntry{key, version, sunset})
+	}
+	c.pins[key]++
+}
+func (c *proofResultCache) unpin(key common.Hash) {
+	if c == nil || c.pins[key] == 0 {
+		return
+	}
+	if c.pins[key]--; c.pins[key] == 0 {
+		delete(c.pins, key)
+		c.trim()
+	}
+}
+func (c *proofResultCache) remove(e *list.Element) {
+	key := e.Value.(proofResultEntry).key
+	delete(c.entries, key)
+	delete(c.pins, key)
+	c.lru.Remove(e)
+}
+func (c *proofResultCache) prune(version uint32, now uint64) {
+	if c == nil {
+		return
+	}
+	for e := c.lru.Back(); e != nil; {
+		previous := e.Prev()
+		v := e.Value.(proofResultEntry)
+		if v.version != version || now >= v.sunset {
+			c.remove(e)
+		}
+		e = previous
+	}
+}
+func (p *Pool) sponsorHorizon() uint64 {
+	slot := txpool.PQPoolSlot(p.chain.Config())
+	if slot > math.MaxUint64/10 {
+		return math.MaxUint64
+	}
+	return slot * 10
+}
+
+// ResearchVKDigest binds all pinned identities consulted by VerifyPQFull. This
+// research profile has no production vk_digest manifest: its fixed ImageID,
+// guest ELF SHA256 and explicit backend/algorithm identity collectively identify it.
+// The historical worker additionally binds its executable SHA256; native
+// consensus identity is the algorithm declaration, never the linked library.
+// This local digest is not a production verifier/version security claim.
+func researchVKDigest(f *params.PQFullResearchConfig) common.Hash {
+	return crypto.Keccak256Hash([]byte("pqpool/research-vk/v2"), f.ImageID[:], f.GuestSHA[:], f.VerifierSHA[:], []byte(f.Backend), f.NativeAlgorithmDigest[:])
+}
+func (p *Pool) proofResultKey(tx *types.Transaction) common.Hash {
+	m, _ := tx.AsPQMigrate()
+	var version [4]byte
+	binary.BigEndian.PutUint32(version[:], m.VerifierVersion)
+	vk := researchVKDigest(p.chain.Config().PQMigrate.FullResearch)
+	proofHash := crypto.Keccak256Hash(m.ProofCarrier.Proof)
+	return crypto.Keccak256Hash([]byte("pqpool/full-result/v1"), p.proofCacheSalt[:], version[:], vk[:], m.PublicInputs(), proofHash[:])
+}
+func (p *Pool) pruneProofCaches() {
+	f := p.chain.Config().PQMigrate.FullResearch
+	now := txpool.PQPoolTime(p.head, p.chain.Config())
+	p.positiveCache.prune(f.Version, now)
+	p.negativeCache.prune(f.Version, now)
+}
+
+// pinProofResult pins the memoized Full result of an item that has just become
+// pending, under the condition on which verifyProofCached memoizes it. A pruned
+// version or sunset still drops the entry; such an item fails its next reset.
+func (p *Pool) pinProofResult(e *entry, tx *types.Transaction) {
+	f := p.chain.Config().PQMigrate.FullResearch
+	if m, _ := tx.AsPQMigrate(); txpool.PQPoolTime(p.head, p.chain.Config()) >= f.Sunset || m.VerifierVersion != f.Version {
+		return
+	}
+	e.resultKey, e.pinned = p.proofResultKey(tx), true
+	p.positiveCache.pin(e.resultKey, f.Version, f.Sunset)
+}
+
+// proofCacheHoldsPending reports, from the cache itself, whether every pending
+// item still has its memoized Full result. The caller holds p.mu for reading,
+// so the LRU order is not touched.
+func (p *Pool) proofCacheHoldsPending() bool {
+	if p.closed || p.positiveCache == nil {
+		return false
+	}
+	for _, e := range p.entries {
+		if !e.pinned || p.positiveCache.entries[e.resultKey] == nil {
+			return false
+		}
+	}
+	return true
+}
+
+// Caller holds p.mu and has already repeated canonical, state, fee, signature,
+// nonce, activation and expiry checks against the current head. Only the pure
+// Full result is memoized. A cache hit does not consume scarce verifier work,
+// but a negative hit still flows through budgetFailure at admission.
+func (p *Pool) verifyProofCached(tx *types.Transaction, context, source string) error {
+	p.pruneProofCaches()
+	key := p.proofResultKey(tx)
+	if p.positiveCache.has(key) {
+		p.proofCacheHits++
+		log.Debug("PQPOOL_PROOF_CACHE", "result", "valid", "context", context, "txhash", tx.Hash())
+		return nil
+	}
+	if p.negativeCache.has(key) {
+		p.proofCacheNegativeHits++
+		log.Debug("PQPOOL_PROOF_CACHE", "result", "invalid", "context", context, "txhash", tx.Hash())
+		return &core.PQMigrationError{Name: "INVALID_PROOF", Code: 0x0402, Cause: core.ErrPQInvalidFullProof}
+	}
+	if err := p.verificationBudget(); err != nil {
+		return err
+	}
+	p.proofCacheMisses++
+	start := time.Now()
+	err := p.checkProof(tx, p.chain.Config(), context)
+	m, _ := tx.AsPQMigrate()
+	log.Info("PQPOOL_FULL", "context", context, "source", source, "txhash", tx.Hash(), "piHash", crypto.Keccak256Hash(m.PublicInputs()), "proofHash", crypto.Keccak256Hash(m.ProofCarrier.Proof), "elapsed", time.Since(start), "err", err)
+	f := p.chain.Config().PQMigrate.FullResearch
+	if txpool.PQPoolTime(p.head, p.chain.Config()) < f.Sunset && m.VerifierVersion == f.Version {
+		if err == nil {
+			p.positiveCache.add(key, f.Version, f.Sunset)
+		} else if errors.Is(err, core.ErrPQInvalidFullProof) && !errors.Is(err, core.ErrPQFullUnavailable) {
+			// Never cache arbitrary error text, local IO, worker crashes, timeouts,
+			// incomplete verification, or any state-dependent error.
+			p.negativeCache.add(key, f.Version, f.Sunset)
+		}
+	}
+	return err
+}
diff --git a/core/txpool/pqpool/proof_cache_pin_test.go b/core/txpool/pqpool/proof_cache_pin_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..fdcb89f7e96c1a61f2ba4eb7f3dfc29cbcdac042
--- /dev/null
+++ b/core/txpool/pqpool/proof_cache_pin_test.go
@@ -0,0 +1,152 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package pqpool
+
+import (
+	"fmt"
+	"math/big"
+	"testing"
+	"time"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core/types"
+)
+
+// Spec section 20.17 (c) (defect (j) of section 22.7): the positive cache holds
+// at least one entry per pending item, and a pending item whose result is
+// memoized is never deferred because the node-wide budget is exhausted. This
+// pool pins the entries of pending items instead of refusing small capacities
+// at Init, so these tests run below and at the bound MaxPending x 256 bytes.
+
+func admitSelfPay(t *testing.T, p *Pool, n int) []*types.Transaction {
+	t.Helper()
+	txs := make([]*types.Transaction, 0, n)
+	for i := 1; i <= n; i++ {
+		tx := componentTx(byte(i), byte(i), 2, 20)
+		if err := add(p, tx); err != nil {
+			t.Fatalf("admission %d: %v", i, err)
+		}
+		txs = append(txs, tx)
+	}
+	return txs
+}
+
+// nextHead is the child of the pool's head, one slot later.
+func nextHead(p *Pool) *types.Header {
+	h := types.CopyHeader(p.head)
+	h.ParentHash, h.Number, h.Time = p.head.Hash(), new(big.Int).Add(p.head.Number, common.Big1), p.head.Time+12
+	return h
+}
+
+func requireMemoized(t *testing.T, p *Pool, txs []*types.Transaction) {
+	t.Helper()
+	for i, tx := range txs {
+		if p.positiveCache.entries[p.proofResultKey(tx)] == nil {
+			t.Fatalf("pending item %d of %d lost its memoized Full result (cache bound %d bytes)", i+1, len(txs), p.positiveCache.limit)
+		}
+	}
+}
+
+func TestPQPoolProofCachePinsPendingBelowBound(t *testing.T) {
+	bound := uint64(DefaultConfig.MaxPending) * proofCacheEntryBytes
+	for _, limit := range []uint64{0, proofCacheEntryBytes - 1, bound - 1} {
+		t.Run(fmt.Sprint(limit), func(t *testing.T) {
+			p, _, calls := componentPool(t)
+			p.cfg.PositiveCacheBytes = limit
+			p.positiveCache = newProofResultCache(limit) // what Init builds from this value
+			txs := admitSelfPay(t, p, p.cfg.MaxPending)
+			requireMemoized(t, p, txs)
+			// First verifications of other proofs press on the byte bound.
+			for i := 0; i < 2*p.cfg.MaxPending; i++ {
+				other := changed(componentTx(1, 1, 2, 20), func(m *types.PQMigrateTx) { m.ProofCarrier.Proof = []byte(fmt.Sprint("other proof ", i)) })
+				if err := p.verifyProofCached(other, "test", "test"); err != nil {
+					t.Fatal(err)
+				}
+			}
+			requireMemoized(t, p, txs)
+			if unpinned := p.positiveCache.len() - len(txs); uint64(unpinned)*proofCacheEntryBytes > limit {
+				t.Fatalf("entries of items not pending exceed the bound: %d", unpinned)
+			}
+			// No budget is left, yet every pending item survives its next reset.
+			p.verifyCount, p.verifyStart = p.cfg.VerificationBurst, time.Now()
+			full := *calls
+			p.Reset(p.head, nextHead(p))
+			for i, tx := range txs {
+				if !p.Has(tx.Hash()) {
+					t.Fatalf("pending item %d deferred or evicted at reset", i+1)
+				}
+			}
+			if *calls != full || len(p.deferred) != 0 || p.proofCacheHits != uint64(len(txs)) {
+				t.Fatalf("reset: Full calls %d->%d deferred=%d hits=%d", full, *calls, len(p.deferred), p.proofCacheHits)
+			}
+		})
+	}
+}
+
+// The further test of entry condition 1 (d): with first verifications at the
+// node-wide budget, no pending item's entry is evicted before its next reset,
+// at exactly MaxPending x 256 bytes. A replacement at full pending is the last
+// first verification; an unpinned LRU evicts the oldest pending item's entry
+// for it, and that item is then deferred at the reset for want of budget.
+func TestPQPoolProofCacheNoPendingEvictionAtBudget(t *testing.T) {
+	p, _, calls := componentPool(t)
+	n := p.cfg.MaxPending
+	p.cfg.PositiveCacheBytes = uint64(n) * proofCacheEntryBytes
+	p.positiveCache = newProofResultCache(p.cfg.PositiveCacheBytes)
+	p.cfg.VerificationBurst, p.cfg.VerificationWindow = n+1, time.Hour
+	txs := admitSelfPay(t, p, n)
+	replacement := changed(txs[n-1], func(m *types.PQMigrateTx) {
+		m.GasTipCap.SetInt64(4)
+		m.GasFeeCap.SetInt64(40)
+		m.ProofCarrier.Proof = []byte("replacement proof")
+	})
+	if err := add(p, replacement); err != nil || p.Has(txs[n-1].Hash()) {
+		t.Fatal("replacement at full pending", err)
+	}
+	if p.verifyCount != p.cfg.VerificationBurst || *calls != n+1 {
+		t.Fatalf("first verifications not at the budget: count=%d burst=%d calls=%d", p.verifyCount, p.cfg.VerificationBurst, *calls)
+	}
+	pending := append(append([]*types.Transaction(nil), txs[:n-1]...), replacement)
+	evicted := 0
+	for _, tx := range pending {
+		if p.positiveCache.entries[p.proofResultKey(tx)] == nil {
+			evicted++
+		}
+	}
+	if evicted != 0 {
+		t.Errorf("%d pending items lost their memoized result before their next reset", evicted)
+	}
+	p.Reset(p.head, nextHead(p))
+	for i, tx := range pending {
+		if !p.Has(tx.Hash()) {
+			t.Fatalf("pending item %d left the pending set at its next reset (deferred=%d)", i+1, len(p.deferred))
+		}
+	}
+	if *calls != n+1 || len(p.deferred) != 0 || p.proofCacheHits != uint64(n) {
+		t.Fatalf("reset: Full calls=%d deferred=%d hits=%d", *calls, len(p.deferred), p.proofCacheHits)
+	}
+}
+
+// Status reports fullProofCache from the cache's state, not as a constant.
+func TestPQPoolStatusFullProofCacheFromState(t *testing.T) {
+	p, _, _ := componentPool(t)
+	api := NewAPI(p)
+	if api.Status()["fullProofCache"] != true {
+		t.Fatal("initialized cache not reported")
+	}
+	if err := add(p, componentTx(1, 20, 2, 20)); err != nil {
+		t.Fatal(err)
+	}
+	if api.Status()["fullProofCache"] != true {
+		t.Fatal("cache holding the pending item's result not reported")
+	}
+	p.positiveCache = newProofResultCache(p.cfg.PositiveCacheBytes) // the pending item's result is gone
+	if api.Status()["fullProofCache"] != false {
+		t.Fatal("fullProofCache reported for a cache without the pending item's result")
+	}
+	p.Close()
+	if api.Status()["fullProofCache"] != false {
+		t.Fatal("fullProofCache reported by a closed pool")
+	}
+}
