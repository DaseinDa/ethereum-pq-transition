+			FinalKeyDigest: params.PQFinalKeyDigest, Version: params.PQFinalVersion,
+			Activation: 0, Sunset: math.MaxUint64, ProofLifetime: 604800,
+			MaxProofBytes: params.PQFinalMaxProofBytes, MaxTxBytes: params.PQFinalMaxTxBytes,
