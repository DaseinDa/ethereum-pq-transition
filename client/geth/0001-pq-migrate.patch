+	"github.com/ethereum/go-ethereum/triedb"
+	"github.com/holiman/uint256"
+)
+
+// Real archived MPT with missing paths, deterministic signature/proof hooks.
+// These regressions do not count as real Full proof or PQ security acceptance.
+func bridgeIncompleteState(t *testing.T) *state.StateDB {
+	t.Helper()
+	path := os.Getenv("PQ_BRIDGE_WITNESS")
+	if path == "" {
+		t.Skip("set PQ_BRIDGE_WITNESS for the external state witness")
+	}
+	b, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if fmt.Sprintf("%x", sha256.Sum256(b)) != "844af0767c27256ef5934f164d98c086d87bece27b3f9d30a369a512ff1b3ca2" {
+		t.Fatal("witness identity changed")
+	}
+	var w stateless.Witness
+	if err = rlp.DecodeBytes(b, &w); err != nil {
+		t.Fatal(err)
+	}
+	db := w.MakeHashDB()
+	tdb := triedb.NewDatabase(db, triedb.HashDefaults)
+	t.Cleanup(func() { tdb.Close(); db.Close() })
+	s, err := state.New(w.Root(), state.NewDatabase(tdb, state.NewCodeDB(db)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	probe := s.Copy()
+	probe.GetBalance(common.HexToAddress("0x800"))
+	if probe.Error() == nil {
+		t.Fatal("expected missing real MPT path")
+	}
+	if s.Error() != nil {
+		t.Fatal("copy polluted base")
+	}
+	return s
+}
+
+// The names of every code of spec section 14.14 and its later additions
+// (sections 15.1 and 27.6). A local fault carries none of them (section 20.17 (a)).
+var specErrorNames = []string{"FORK_NOT_ACTIVE", "ENROLL_AFTER_FORK", "NON_CANONICAL_ENCODING", "WRONG_CHAIN_ID",
+	"WRONG_FORK_ID", "WRONG_VERIFIER_VERSION", "UNSUPPORTED_PQ_SCHEME", "PROOF_TOO_LARGE", "SENDER_HAS_CODE", "NOT_AN_EOA",
+	"ALREADY_MIGRATED", "OVERRIDE_WINDOW_CLOSED", "WRONG_MIGRATION_NONCE", "NOT_PQ_ACCOUNT", "NOT_FINAL",
+	"ROTATE_BAD_CALLER", "PROOF_EXPIRED", "EXPIRY_TOO_FAR", "FEE_CAP_EXCEEDED", "INSUFFICIENT_FEE_BALANCE",
+	"SPONSOR_PENDING_LIMIT", "REPLACEMENT_UNDERPRICED", "UNDERPRICED", "VERSION_LIMIT", "BATCH_ENTRY_NOT_ADMISSIBLE",
+	"WRONG_SPONSOR_NONCE", "SPONSOR_EXPIRED", "SPONSOR_BANNED", "BAD_POP", "INVALID_PROOF", "BAD_SPONSOR_SIG",
+	"BAD_ACTIVATION", "BAD_PQ_SIG", "ECDSA_DISABLED", "AUTH_TUPLE_REJECTED", "LANE_NOT_CLOSED", "LANE_MEMBER_INVALID",
+	"LANE_KEY_MISMATCH", "BAD_LANE_SIG", "LANE_GAS_EXCEEDED", "STATEMENT_INVALID", "FACT_ALREADY_REGISTERED",
+	"FACT_MISSING", "LANE_K_EXCEEDED"}
+
+// requireNoVerdict checks spec section 20.17 (a) for a new submission that met
+// a local fault: the retryable local error, no code of section 14.14, nothing
+// retained or pending, and no source budget, sponsor ban or negative entry.
+func requireNoVerdict(t *testing.T, p *Pool, err error) {
+	t.Helper()
+	var coded *core.PQMigrationError
+	if !errors.Is(err, ErrLocalUnavailable) || !retryable(err) || errors.As(err, &coded) {
+		t.Fatalf("not the retryable local error: %v", err)
+	}
+	for _, name := range specErrorNames {
+		if strings.Contains(err.Error(), name) {
+			t.Fatalf("local error carries the section 14.14 name %s: %v", name, err)
+		}
+	}
+	if len(p.deferred) != 0 || p.deferredBytes != 0 {
+		t.Fatalf("new submission retained in the deferred set: %d items, %d bytes", len(p.deferred), p.deferredBytes)
+	}
+	if len(p.entries) != 0 || len(p.bodies) != 0 {
+		t.Fatalf("new submission pending: %d entries, %d bodies", len(p.entries), len(p.bodies))
+	}
+	if b := p.sources["rpc:component"]; b != nil && b.failures != 0 {
+		t.Fatalf("local fault charged the source budget: %d", b.failures)
+	}
+	if len(p.bans) != 0 || p.negativeCache.len() != 0 || p.proofCacheNegativeHits != 0 {
+		t.Fatalf("local fault banned a sponsor or entered the negative cache: bans=%d negative=%d", len(p.bans), p.negativeCache.len())
+	}
+}
+
+func TestPQBridgePoolMissingStateAdmission(t *testing.T) {
+	p, c, calls := componentPool(t)
+	p.state = bridgeIncompleteState(t)
+	c.cfg.PQMigrate.Registry = common.HexToAddress("0x800")
+	tx := componentTx(1, 1, 2, 20)
+	err := add(p, tx)
+	requireNoVerdict(t, p, err)
+	if *calls != 0 {
+		t.Fatal("missing state reached Full verification")
+	}
+	if p.state.Error() != nil {
+		t.Fatal("local error polluted base state")
+	}
+	t.Log("real missing MPT: retryable local error, nothing retained, no Full call, no invalid budget debit")
+}
+
+func TestPQBridgePoolMissingSponsorPolicy(t *testing.T) {
+	p, _, calls := componentPool(t)
+	p.state = bridgeIncompleteState(t)
+	p.checkState = func(*types.Transaction, *state.StateDB, *types.Header, *params.ChainConfig) error { return nil }
+	tx := changed(componentTx(1, 20, 2, 20), func(m *types.PQMigrateTx) { m.SponsorOption.Sponsor = common.HexToAddress("0x800") })
+	err := add(p, tx)
+	requireNoVerdict(t, p, err)
+	if *calls != 0 || p.state.Error() != nil {
+		t.Fatal("missing sponsor state reached Full verification or polluted base state")
+	}
+}
+
+// A proof that verified but whose body cannot be stored is not held either: the
+// store is the node's own means of keeping the item (spec section 20.17 (a)).
+func TestPQBridgePoolProofStoreUnwritable(t *testing.T) {
+	p, _, calls := componentPool(t)
+	store := p.dir
+	blocker := filepath.Join(t.TempDir(), "not-a-directory")
+	if err := os.WriteFile(blocker, nil, 0600); err != nil {
+		t.Fatal(err)
+	}
+	p.dir = blocker // a regular file, so no proof body can be written beneath it
+	tx := componentTx(1, 20, 2, 20)
+	err := add(p, tx)
+	requireNoVerdict(t, p, err)
+	if *calls != 1 {
+		t.Fatalf("the store failure must follow a completed verification: Full calls=%d", *calls)
+	}
+	p.dir = store
+	if err := add(p, tx); err != nil || !p.Has(tx.Hash()) {
+		t.Fatal("resubmission after the store recovered was not admitted", err)
+	}
+	if *calls != 1 || p.proofCacheHits != 1 {
+		t.Fatalf("resubmission did not reuse the memoized result: calls=%d hits=%d", *calls, p.proofCacheHits)
+	}
+}
+
+// sparseState commits full and keeps only the trie nodes on the proofs of the
+// given accounts and storage slots: a real MPT whose other paths are missing, as
+// on a node that authenticated only that set.
+func sparseState(t *testing.T, full *state.StateDB, tdb *triedb.Database, slots map[common.Address][]common.Hash) *state.StateDB {
+	t.Helper()
+	root, err := full.Commit(params.AllDevChainProtocolChanges.Rules(big.NewInt(0), true, 0), 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = tdb.Commit(root, false); err != nil {
+		t.Fatal(err)
+	}
+	accounts, err := trie.New(trie.StateTrieID(root), tdb)
+	if err != nil {
+		t.Fatal(err)
+	}
+	kept := rawdb.NewMemoryDatabase()
+	for a, keys := range slots {
+		if err = accounts.Prove(crypto.Keccak256(a[:]), kept); err != nil {
+			t.Fatal(err)
+		}
+		storage, err := trie.New(trie.StorageTrieID(root, crypto.Keccak256Hash(a[:]), full.GetStorageRoot(a)), tdb)
+		if err != nil {
+			t.Fatal(err)
+		}
+		for _, k := range keys {
+			if err = storage.Prove(crypto.Keccak256(k[:]), kept); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+	keptdb := triedb.NewDatabase(kept, triedb.HashDefaults)
+	t.Cleanup(func() { keptdb.Close(); kept.Close() })
+	s, err := state.New(root, state.NewDatabase(keptdb, state.NewCodeDB(kept)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	return s
+}
+
+// The failure of defect (g): on a sparse node every submission for an address
+// outside the authenticated set used to be deferred, and MaxPending of them
+// filled the shared pending-and-deferred capacity against later valid ones.
+func TestPQBridgePoolMissingStateCapacity(t *testing.T) {
+	p, c, calls := componentPool(t)
+	if p.cfg.MaxPending != 128 || p.cfg.MaxReorgCandidates != 128 {
+		t.Fatalf("research pool bounds changed: pending=%d deferred=%d", p.cfg.MaxPending, p.cfg.MaxReorgCandidates)
+	}
+	disk := rawdb.NewMemoryDatabase()
+	tdb := triedb.NewDatabase(disk, triedb.HashDefaults)
+	t.Cleanup(func() { tdb.Close(); disk.Close() })
+	full, err := state.New(types.EmptyRootHash, state.NewDatabase(tdb, state.NewCodeDB(disk)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	registry := c.cfg.PQMigrate.Registry
+	full.SetCode(registry, []byte{0}, tracing.CodeChangeUnspecified)
+	full.SetNonce(registry, 1, tracing.NonceChangeUnspecified)
+	// Every outside address has both registry slots in the full trie, so each
+	// read of them runs into a node the sparse node does not hold.
+	for i := 1; i <= p.cfg.MaxPending; i++ {
+		k, k1 := core.PQRecordSlots(addr(byte(i)))
+		word := common.Hash{}
+		word[31], word[30] = 1, 1
+		full.SetState(registry, k, word)
+		full.SetState(registry, k1, crypto.Keccak256Hash([]byte{byte(i)}))
+	}
+	valid := addr(200)
+	vk, vk1 := core.PQRecordSlots(valid)
+	full.SetBalance(valid, uint256.NewInt(1000000000000000000), tracing.BalanceChangeUnspecified)
+	p.state = sparseState(t, full, tdb, map[common.Address][]common.Hash{registry: {vk, vk1}, valid: nil})
+	for i := 1; i <= p.cfg.MaxPending; i++ {
+		if err := add(p, componentTx(byte(i), byte(i), 2, 20)); !errors.Is(err, ErrLocalUnavailable) {
+			t.Fatalf("outside address %d: %v", i, err)
+		}
+	}
+	retained, pending, verified := len(p.deferred), len(p.entries), *calls
+	tx := componentTx(200, 200, 2, 20)
+	err = add(p, tx)
+	t.Logf("component hooks, real sparse MPT: after %d unavailable submissions deferred=%d pending=%d Full calls=%d; valid submission: %v",
+		p.cfg.MaxPending, retained, pending, verified, err)
+	if retained != 0 || pending != 0 || verified != 0 {
+		t.Errorf("unavailable submissions were retained or verified: deferred=%d pending=%d Full calls=%d", retained, pending, verified)
+	}
+	if err != nil || !p.Has(tx.Hash()) {
+		t.Fatalf("valid submission after %d unavailable ones refused: %v", p.cfg.MaxPending, err)
+	}
+	if *calls != 1 || len(p.deferred) != 0 || p.state.Error() != nil {
+		t.Fatalf("only the valid submission may reach Full: calls=%d deferred=%d", *calls, len(p.deferred))
+	}
+	if b := p.sources["rpc:component"]; b.failures != 0 || len(p.bans) != 0 || p.negativeCache.len() != 0 {
+		t.Fatal("unavailable submissions charged the source, banned a sponsor or entered the negative cache")
+	}
+}
+
+func TestPQBridgePoolMissingResetThenRepair(t *testing.T) {
+	p, c, calls := componentPool(t)
+	tx := componentTx(1, 1, 2, 20)
+	if err := add(p, tx); err != nil {
+		t.Fatal(err)
+	}
+	good := c.s
+	oldRegistry := c.cfg.PQMigrate.Registry
+	c.s = bridgeIncompleteState(t)
+	c.cfg.PQMigrate.Registry = common.HexToAddress("0x800")
+	p.Reset(nil, p.head)
+	if p.Has(tx.Hash()) || len(p.deferred) != 1 || *calls != 1 || len(p.bans) != 0 || p.state.Error() != nil {
+		t.Fatal("reset missing state was not retryable")
+	}
+	if p.proofCacheHits != 0 {
+		t.Fatal("cached Full bypassed the missing-state gate")
+	}
+	c.s = good
+	c.cfg.PQMigrate.Registry = oldRegistry
+	p.Reset(nil, p.head)
+	if !p.Has(tx.Hash()) || len(p.deferred) != 0 {
+		t.Fatal("same-head repaired state did not re-admit")
+	}
+	// The repaired head must pass state checks again. Its unchanged pure
+	// proof is already verified, so repair reuses that result exactly once.
+	if *calls != 1 || p.proofCacheHits != 1 || p.negativeCache.len() != 0 {
+		t.Fatalf("repair proof cache: calls=%d hits=%d negative=%d", *calls, p.proofCacheHits, p.negativeCache.len())
+	}
+	t.Logf("real missing MPT: valid->deferred->repaired Pending; Full calls=%d cache hits=%d, missing-state phase cache hits=0", *calls, p.proofCacheHits)
+	if p.sources["rpc:component"].failures != 0 {
+		t.Fatal("repair consumed invalid budget")
+	}
+}
+
+func TestPQBridgePoolInvalidProofStillPenalized(t *testing.T) {
+	p, _, _ := componentPool(t)
+	p.checkProof = func(*types.Transaction, *params.ChainConfig, string) error { return core.ErrPQInvalidFullProof }
+	err := add(p, componentTx(1, 1, 2, 20))
+	if !errors.Is(err, core.ErrPQInvalidFullProof) || p.sources["rpc:component"].failures != 1 || len(p.deferred) != 0 {
+		t.Fatal("deterministic invalid proof became retryable", err)
+	}
+}
