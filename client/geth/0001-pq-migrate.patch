+
+func bridgeTestConfig(t *testing.T) *params.ChainConfig {
+	t.Helper()
+	cfg := *params.MainnetChainConfig
+	p := &params.PQStateBridgeConfig{ResearchOnly: true, AnchorHash: params.PQBridgeAnchorHash, AnchorRoot: params.PQBridgeAnchorRoot, AnchorNumber: params.PQBridgeAnchorNumber, InitBlock: params.PQBridgeAnchorNumber + 1, ProfileSHA256: common.HexToHash("01"), Credits: []params.PQStateBridgeCredit{{Address: common.HexToAddress("0x6a670ef1e58f7fd8ec5b639d5e80fcccd8a7e770"), Balance: big.NewInt(123), AbsenceProofSHA256: common.HexToHash("02")}}}
+	b, e := p.InitDeltaBytes()
+	if e != nil {
+		t.Fatal(e)
+	}
+	p.InitDeltaSHA256 = common.Hash(sha256.Sum256(b))
+	if e = p.Validate(); e != nil {
+		t.Fatal(e)
+	}
+	cfg.PQStateBridge = p
+	return &cfg
+}
+
+func TestPQBridgeTrustedRecordDoesNotAuthorizeDescendants(t *testing.T) {
+	cfg := bridgeTestConfig(t)
+	db := rawdb.NewMemoryDatabase()
+	defer db.Close()
+	configHash, e := PQBridgeConfigHash(cfg)
+	if e != nil {
+		t.Fatal(e)
+	}
+	r := &TrustedCheckpointRecord{Schema: "PQ-TRUSTED-CHECKPOINT-v1", ResearchOnly: true, BlockHash: params.PQBridgeAnchorHash, BlockNumber: params.PQBridgeAnchorNumber, StateRoot: params.PQBridgeAnchorRoot, ProfileSHA256: cfg.PQStateBridge.ProfileSHA256, LocalConfigSHA256: configHash, BlockSHA256: common.HexToHash("03"), WitnessSHA256: common.HexToHash("04"), HistoricalEvidenceSHA256: common.HexToHash("05"), GenesisHash: params.MainnetGenesisHash, Reopened: true, Sparse: true}
+	if e = WriteTrustedCheckpointRecord(db, r); e != nil {
+		t.Fatal(e)
+	}
+	if !IsTrustedCheckpoint(db, r.BlockHash, r.BlockNumber, r.StateRoot, r.ProfileSHA256) {
+		t.Fatal("fixed H not recognized")
+	}
+	if IsTrustedCheckpoint(db, r.BlockHash, r.BlockNumber+1, r.StateRoot, r.ProfileSHA256) {
+		t.Fatal("H+1 inherited checkpoint trust")
+	}
+	if e = CheckTrustedCheckpointConfig(db, cfg); e != nil {
+		t.Fatal(e)
+	}
+	cfg.PQStateBridge.Credits[0].Balance.Add(cfg.PQStateBridge.Credits[0].Balance, big.NewInt(1))
+	b, _ := cfg.PQStateBridge.InitDeltaBytes()
+	cfg.PQStateBridge.InitDeltaSHA256 = common.Hash(sha256.Sum256(b))
+	if e = CheckTrustedCheckpointConfig(db, cfg); e == nil {
+		t.Fatal("same profile with changed delta accepted")
+	}
+}
+
+func TestPQBridgeInitMissingStateCannotBecomeAbsent(t *testing.T) {
+	cfg := bridgeTestConfig(t)
+	db := rawdb.NewMemoryDatabase()
+	defer db.Close()
+	tdb := triedb.NewDatabase(db, triedb.HashDefaults)
+	defer tdb.Close()
+	s, e := state.New(params.PQBridgeAnchorRoot, state.NewDatabase(tdb, state.NewCodeDB(db)))
+	if e != nil {
+		return
+	} // Reader may reject before any attempted execution.
+	_, e = ApplyLabInit(cfg, params.PQBridgeAnchorHash, new(big.Int).SetUint64(params.PQBridgeAnchorNumber+1), 1753185600, s)
+	if e == nil || s.Error() == nil {
+		t.Fatal("missing root permitted init or lost state read error")
+	}
+	if !strings.Contains(e.Error(), "unavailable") {
+		t.Fatalf("wrong classification: %v", e)
+	}
+}
+
+func TestPQBridgeInitWrongParentAndLaterBlock(t *testing.T) {
+	cfg := bridgeTestConfig(t)
+	db := rawdb.NewMemoryDatabase()
+	defer db.Close()
+	tdb := triedb.NewDatabase(db, triedb.HashDefaults)
+	defer tdb.Close()
+	s, e := state.New(types.EmptyRootHash, state.NewDatabase(tdb, state.NewCodeDB(db)))
+	if e != nil {
+		t.Fatal(e)
+	}
+	if _, e = ApplyLabInit(cfg, common.Hash{}, new(big.Int).SetUint64(params.PQBridgeAnchorNumber+1), 1753185600, s); e == nil {
+		t.Fatal("wrong parent accepted")
+	}
+	if _, e = ApplyLabInit(cfg, common.Hash{}, new(big.Int).SetUint64(params.PQBridgeAnchorNumber+2), 1753185612, s); e != nil {
+		t.Fatalf("later block must not apply credit: %v", e)
+	}
+	if s.Error() != nil {
+		t.Fatal("later block read or mutated initial state")
+	}
+}
+
+func TestPQBridgeSystemImagesPreserveHistoricalBalance(t *testing.T) {
+	cfg := bridgeTestConfig(t)
+	cfg.PQMigrate = &params.PQMigrateConfig{T0: 1753185600, Registry: common.HexToAddress("0x800"), FactRegistry: common.HexToAddress("0x801")}
+	db := rawdb.NewMemoryDatabase()
+	defer db.Close()
+	td := triedb.NewDatabase(db, triedb.HashDefaults)
+	defer td.Close()
+	s, err := state.New(types.EmptyRootHash, state.NewDatabase(td, state.NewCodeDB(db)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	balance := uint256.NewInt(117805017000000000)
+	s.SetBalance(cfg.PQMigrate.Registry, balance, tracing.BalanceIncreaseGenesisBalance)
+	n := new(big.Int).SetUint64(cfg.PQStateBridge.InitBlock)
+	if err = InstallPQBridgeSystemImages(cfg, n, cfg.PQMigrate.T0, s); err != nil {
+		t.Fatal(err)
+	}
+	for _, a := range []common.Address{cfg.PQMigrate.Registry, cfg.PQMigrate.FactRegistry} {
+		if string(s.GetCode(a)) != string([]byte{0}) || s.GetNonce(a) != 1 {
+			t.Fatal("system image not installed")
+		}
+		if s.GetState(a, common.Hash{}) != (common.Hash{}) {
+			t.Fatal("system install wrote binding/storage")
+		}
+	}
+	if s.GetBalance(cfg.PQMigrate.Registry).Cmp(balance) != 0 {
+		t.Fatal("historical ETH balance changed")
+	}
+	if !s.GetBalance(cfg.PQMigrate.FactRegistry).IsZero() {
+		t.Fatal("new fact registry gained ETH")
+	}
+	s.SetNonce(cfg.PQMigrate.Registry, 2, tracing.NonceChangeUnspecified)
+	if err = InstallPQBridgeSystemImages(cfg, new(big.Int).Add(n, big.NewInt(1)), cfg.PQMigrate.T0+12, s); err != nil {
+		t.Fatal(err)
+	}
+	if s.GetNonce(cfg.PQMigrate.Registry) != 2 {
+		t.Fatal("later block reapplied init")
+	}
+}
+
+func TestPQBridgeSystemImageConflictIsAtomic(t *testing.T) {
+	for _, kind := range []string{"code", "storage"} {
+		t.Run(kind, func(t *testing.T) {
+			cfg := bridgeTestConfig(t)
+			cfg.PQMigrate = &params.PQMigrateConfig{T0: 1753185600, Registry: common.HexToAddress("0x800"), FactRegistry: common.HexToAddress("0x801")}
+			db := rawdb.NewMemoryDatabase()
+			defer db.Close()
+			td := triedb.NewDatabase(db, triedb.HashDefaults)
+			defer td.Close()
+			s, err := state.New(types.EmptyRootHash, state.NewDatabase(td, state.NewCodeDB(db)))
+			if err != nil {
+				t.Fatal(err)
+			}
+			if kind == "code" {
+				s.SetCode(cfg.PQMigrate.FactRegistry, []byte{0x01}, tracing.CodeChangeUnspecified)
+			} else {
+				s.SetBalance(cfg.PQMigrate.FactRegistry, uint256.NewInt(1), tracing.BalanceIncreaseGenesisBalance)
+				s.SetState(cfg.PQMigrate.FactRegistry, common.Hash{}, common.HexToHash("01"))
+				s.IntermediateRoot(cfg.Rules(new(big.Int).SetUint64(cfg.PQStateBridge.InitBlock), true, cfg.PQMigrate.T0))
+			}
+			if err = InstallPQBridgeSystemImages(cfg, new(big.Int).SetUint64(cfg.PQStateBridge.InitBlock), cfg.PQMigrate.T0, s); err == nil {
+				t.Fatal("conflicting registry accepted")
+			}
+			if len(s.GetCode(cfg.PQMigrate.Registry)) != 0 || s.GetNonce(cfg.PQMigrate.Registry) != 0 {
+				t.Fatal("partial system image mutation")
+			}
+		})
+	}
+}
