+// Exercise both the builder's ApplyTransaction path and a separate import.
+func TestPQBatchRealBlockImport(t *testing.T) {
+	for _, skipped := range []bool{false, true} {
+		t.Run(fmt.Sprintf("one-skipped-%v", skipped), func(t *testing.T) {
+			tx, _, evm, h := batchFixture(t)
+			b, _ := tx.AsPQBatch()
+			cfg := evm.ChainConfig()
+			pk := pqtest.SponsorPublicKey()
+			k, k1 := PQRecordSlots(b.Sponsor)
+			record := PQRecord{Mode: 3, AlgID: 1, MigrationNonce: 1, Commit: PQKeyCommit(1, pk)}
+			storage := map[common.Hash]common.Hash{k: pqRecordWord(record), k1: record.Commit}
+			if skipped {
+				e := b.Entries[0]
+				owner, commit := PQRecordSlots(e.LegacyAddress)
+				storage[owner] = pqRecordWord(PQRecord{Mode: 2, AlgID: 1, MigrationNonce: 1, Commit: e.PQPKCommit})
+				storage[commit] = e.PQPKCommit
+			}
+			genesis := &Genesis{Config: cfg, Timestamp: h.Time - 10, GasLimit: h.GasLimit,
+				Alloc: withSystemContracts(types.GenesisAlloc{
+					b.Sponsor:                  {Balance: new(big.Int).Mul(big.NewInt(10), big.NewInt(params.Ether)), Code: append([]byte{0xef, 1, 1}, pk...)},
+					cfg.PQMigrate.Registry:     {Balance: new(big.Int), Code: []byte{0}, Nonce: 1, Storage: storage},
+					cfg.PQMigrate.FactRegistry: {Balance: new(big.Int), Code: []byte{0}, Nonce: 1},
+				})}
+			engine := beacon.New(ethash.NewFaker())
+			db, blocks, builtReceipts := GenerateChainWithGenesis(genesis, engine, 1, func(_ int, block *BlockGen) { block.AddTx(tx) })
+			defer db.Close()
+			chain, err := NewBlockChain(rawdb.NewMemoryDatabase(), genesis, engine, &BlockChainConfig{ArchiveMode: true})
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer chain.Stop()
+			if _, err := chain.InsertChain(blocks); err != nil {
+				t.Fatal("native C batch import", err)
+			}
+			s, err := chain.StateAt(blocks[0].Header())
+			if err != nil {
+				t.Fatal(err)
+			}
+			if s.GetNonce(b.Sponsor) != b.SponsorNonce+1 {
+				t.Fatal("import did not consume sponsor nonce")
+			}
+			applied := uint64(4)
+			if skipped {
+				applied--
+			}
+			wantGas := batchExpectedGas(t, b, applied*44200)
+			for _, receipts := range []types.Receipts{builtReceipts[0], chain.GetReceiptsByHash(blocks[0].Hash())} {
+				if len(receipts) != 1 {
+					t.Fatal("receipt count", len(receipts))
+				}
+				receipt := receipts[0]
+				if receipt.Type != types.PQBatchTxType || receipt.Status != types.ReceiptStatusSuccessful || receipt.GasUsed != wantGas || receipt.CumulativeGasUsed != wantGas || len(receipt.Logs) != 4 {
+					t.Fatalf("receipt: %#v, want gas %d", receipt, wantGas)
+				}
+				for i, entry := range b.Entries {
+					code := uint16(0)
+					if skipped && i == 0 {
+						code = 0x0105
+					}
+					assertBatchLog(t, receipt.Logs[i], cfg.PQMigrate.Registry, entry, i, code, 1, false, false)
+				}
+			}
+			if blocks[0].GasUsed() != wantGas {
+				t.Fatal("header gas", blocks[0].GasUsed(), wantGas)
+			}
+			for _, entry := range b.Entries {
+				r := ReadPQRecord(s, cfg.PQMigrate.Registry, entry.LegacyAddress)
+				if r.Mode != 2 || r.MigrationNonce != 1 || r.Commit != entry.PQPKCommit {
+					t.Fatal("imported owner record", r)
+				}
+			}
+			t.Logf("real C fixture: carrier=%d bytes, skipped=%v, gas=%d", len(b.ProofCarrier.Proof), skipped, wantGas)
+		})
+	}
+}
