+func TestResetRetryMarginPrecedesReplacementAndDisplacement(t *testing.T) {
+	for _, displacement := range []bool{false, true} {
+		p, _, calls := componentPool(t)
+		var live []*types.Transaction
+		if displacement {
+			for payer := byte(20); payer < 23; payer++ {
+				live = append(live, componentTx(1, payer, int64(payer-18), 20))
+			}
+		} else {
+			live = []*types.Transaction{componentTx(1, 1, 2, 20)}
+		}
+		for _, tx := range live {
+			if err := add(p, tx); err != nil {
+				t.Fatal(err)
+			}
+		}
+		candidate := changed(componentTx(1, 1, 8, 80), func(m *types.PQMigrateTx) { m.Expiry = p.nextHeader().Time + 5 })
+		p.deferTx(candidate, "rpc:component", ErrLocalUnavailable)
+		before := *calls
+		p.Reset(nil, p.head)
+		for _, tx := range live {
+			if !p.Has(tx.Hash()) {
+				t.Fatal("inside-margin retry displaced a live version")
+			}
+		}
+		if p.Has(candidate.Hash()) || len(p.deferred) != 0 || len(p.bans) != 0 || *calls != before || p.sources["rpc:component"].failures != 0 {
+			t.Fatal("margin retry had verification/penalty effects")
+		}
+	}
+}
+
+func TestResetOrphanMarginPrecedesReplacement(t *testing.T) {
+	candidate := changed(componentTx(1, 1, 8, 80), func(m *types.PQMigrateTx) { m.Expiry = 1029 }) // new pool clock1024, margin1036
+	p, _, calls, _, old, next := componentFork(t, candidate)
+	live := componentTx(1, 1, 2, 20)
+	if err := add(p, live); err != nil {
+		t.Fatal(err)
+	}
+	p.Reset(old.Header(), next.Header())
+	if !p.Has(live.Hash()) || p.Has(candidate.Hash()) || *calls != 1 || len(p.bans) != 0 {
+		t.Fatal("orphan inside reset margin replaced live version")
+	}
+}
+
+func TestResetCandidateMarginEqualityAndOverflow(t *testing.T) {
+	p, _, calls := componentPool(t)
+	tx := changed(componentTx(1, 1, 2, 20), func(m *types.PQMigrateTx) { m.Expiry = 1024 })
+	p.deferTx(tx, "held", ErrLocalUnavailable)
+	p.Reset(nil, p.head)
+	if !p.Has(tx.Hash()) || *calls != 1 || p.sources["held"] != nil {
+		t.Fatal("expiry equal to margin must survive without source charge")
+	}
+	h := types.CopyHeader(p.head)
+	h.Time = ^uint64(0) - 5
+	if !p.resetCandidateExpired(tx, h) {
+		t.Fatal("margin overflow wrapped")
+	}
+}
+
+// Real C/signature admission on a synthetic two-branch pool fixture. It proves
+// reset ordering and liabilities, not a live consensus reorganization.
+func TestBatchResetFillsOrphanGapBeforeFinalSweep(t *testing.T) {
+	for _, cause := range []string{"valid", "invalid-proof", "cumulative-balance"} {
+		t.Run(cause, func(t *testing.T) {
+			p, c, zero, _ := realBatchPool(t)
+			b, _ := zero.AsPQBatch()
+			copyTx := types.NewTx(b)
+			nextBatch, _ := copyTx.AsPQBatch()
+			nextBatch.SponsorNonce++
+			one := pqtest.SignBatch(t, nextBatch)
+			for _, tx := range []*types.Transaction{zero, one} {
+				if err := p.Add([]*types.Transaction{tx}, true)[0]; err != nil {
+					t.Fatal(err)
+				}
+			}
+			p.dropBatch(zero.Hash()) // old branch already included nonce0; nonce1 remains pending
+			commonBlock := types.NewBlockWithHeader(p.head)
+			oldHeader := types.CopyHeader(p.head)
+			oldHeader.Number = big.NewInt(1)
+			oldHeader.ParentHash = commonBlock.Hash()
+			oldHeader.Time += 12
+			oldHeader.Extra = []byte("old")
+			orphan := zero
+			if cause == "invalid-proof" {
+				own := types.NewTx(b)
+				bad, _ := own.AsPQBatch()
+				bad.ProofCarrier.Proof[len(bad.ProofCarrier.Proof)-1] ^= 1
+				orphan = pqtest.SignBatch(t, bad)
+			}
+			old := types.NewBlock(oldHeader, &types.Body{Transactions: []*types.Transaction{orphan}}, nil, trie.NewStackTrie(nil))
+			newHeader := types.CopyHeader(oldHeader)
+			newHeader.Extra = []byte("new")
+			next := types.NewBlockWithHeader(newHeader)
+			c.blocks = map[common.Hash]*types.Block{commonBlock.Hash(): commonBlock, old.Hash(): old, next.Hash(): next}
+			p.head = old.Header()
+			if cause == "cumulative-balance" {
+				total := new(big.Int).Mul(new(big.Int).SetUint64(b.Gas), b.GasFeeCap)
+				total.Mul(total, big.NewInt(2))
+				total.Sub(total, big.NewInt(1))
+				c.s.SetBalance(b.Sponsor, uint256.MustFromBig(total), tracing.BalanceChangeUnspecified)
+			}
+			p.Reset(old.Header(), next.Header())
+			if cause == "valid" {
+				if !p.Has(zero.Hash()) || !p.Has(one.Hash()) || p.Nonce(b.Sponsor) != b.SponsorNonce+2 {
+					t.Fatal("temporary gap evicted the later batch")
+				}
+			} else if p.Has(one.Hash()) || p.Has(orphan.Hash()) {
+				t.Fatal("failed gap-filler left higher batch pending")
+			}
+			if len(p.bans) != 0 || p.sources["local"].failures != 0 {
+				t.Fatal("reinjection/gap failure charged or banned sponsor")
+			}
+		})
+	}
+}
+
+// Synthetic retained payloads isolate the prepass ordering without claiming
+// that their omitted aggregate proof or signature was ever verified.
+func TestBatchResetPrunesIncludedBeforeActivationButActivationBeforeExpiry(t *testing.T) {
+	for _, included := range []bool{false, true} {
+		p, c, _ := componentPool(t)
+		b := &types.PQBatchTx{ChainID: big.NewInt(13375), Sponsor: addr(20), SponsorValidUntil: 1013,
+			GasTipCap: big.NewInt(2), GasFeeCap: big.NewInt(20), Gas: 100,
+			VerifierVersion: c.cfg.PQMigrate.FullResearch.Version,
+			Entries:         []types.PQBatchEntry{{LegacyAddress: addr(1), AlgID: 1, Expiry: 1013, MaxAccountFee: new(big.Int), FeeMode: 2}}}
+		tx := types.NewTx(b)
+		p.batches[tx.Hash()] = &batchEntry{tx: tx, admitted: true, pending: true}
+		p.batchBytes = tx.Size()
+		c.s.SetCode(b.Sponsor, nil, tracing.CodeChangeUnspecified)
+		if included {
+			c.s.SetNonce(b.Sponsor, 1, tracing.NonceChangeUnspecified)
+		}
+		p.state = c.s.Copy()
+		p.pruneBatchReset(p.nextHeader()) // own expiry is inside now1012+SLOT
+		if p.Has(tx.Hash()) || (len(p.bans) != 0) == included {
+			t.Fatal("wrong stale/activation/expiry precedence")
+		}
+	}
+}
