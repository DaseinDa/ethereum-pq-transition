@@ -0,0 +1,87 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+// Package pqtest loads public aggregate fixtures for component tests.
+
+package pqtest
+
+import (
+	"bytes"
+	"encoding/binary"
+	"math/big"
+	"os"
+	"testing"
+
+	"github.com/cloudflare/circl/sign/mldsa/mldsa44"
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/crypto"
+	"github.com/ethereum/go-ethereum/params"
+)
+
+func sponsorKey() (*mldsa44.PublicKey, *mldsa44.PrivateKey) {
+	var seed [mldsa44.SeedSize]byte // Explicitly public test credentials.
+	for i := range seed {
+		seed[i] = 0x53
+	}
+	return mldsa44.NewKeyFromSeed(&seed)
+}
+
+func SponsorPublicKey() []byte { pk, _ := sponsorKey(); return pk.Bytes() }
+
+func SignBatch(t *testing.T, b *types.PQBatchTx) *types.Transaction {
+	t.Helper()
+	_, sk := sponsorKey()
+	digest := b.SponsorSigningHash()
+	tag := []byte("ETH-PQ-SPONSOR/v1")
+	b.SponsorSignature = make([]byte, mldsa44.SignatureSize)
+	if err := mldsa44.SignTo(sk, append(append([]byte{}, tag...), digest[:]...), tag, false, b.SponsorSignature); err != nil {
+		t.Fatal(err)
+	}
+	return types.NewTx(b)
+}
+
+// Batch returns the shipped real C proof in a freshly signed carrier and a
+// deterministic historical component-test timestamp. This is a fixture replay,
+// not a new recovery on a live chain or a claim that an expired proof is live.
+func Batch(t *testing.T) (*types.Transaction, uint64) {
+	t.Helper()
+	carrier, statement := os.Getenv("PQ_BATCH_CARRIER"), os.Getenv("PQ_BATCH_STATEMENT")
+	if carrier == "" || statement == "" {
+		t.Skip("requires the packaged public C carrier and statement")
+	}
+	proof, err := os.ReadFile(carrier)
+	if err != nil {
+		t.Fatal(err)
+	}
+	pi, err := os.ReadFile(statement)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(pi) != 798 || binary.BigEndian.Uint16(pi[:2]) != 4 || binary.BigEndian.Uint32(pi[2:6]) != params.PQFinalVersion {
+		t.Fatal("wrong four-owner statement")
+	}
+	pk := SponsorPublicKey()
+	b := &types.PQBatchTx{
+		ChainID:   new(big.Int).SetBytes(pi[6:38]),
+		Sponsor:   common.BytesToAddress(crypto.Keccak256([]byte("PQ-ADDR"), []byte{1}, pk)[12:]),
+		GasTipCap: big.NewInt(params.GWei), GasFeeCap: big.NewInt(10 * params.GWei), Gas: 16000000,
+		VerifierVersion: params.PQFinalVersion, ProofCarrier: types.PQMigrationCarrier{Proof: proof},
+		SponsorValidUntil: ^uint64(0),
+	}
+	for i := 0; i < 4; i++ {
+		p := pi[6+198*i : 6+198*(i+1)]
+		e := types.PQBatchEntry{LegacyAddress: common.BytesToAddress(p[64:84]), MigrationNonce: binary.BigEndian.Uint64(p[84:92]),
+			AlgID: p[92], PQPKCommit: common.BytesToHash(p[93:125]), Expiry: binary.BigEndian.Uint64(p[129:137]),
+			MaxAccountFee: new(big.Int).SetBytes(p[137:169]), FeeMode: p[169], FeeSponsor: common.BytesToAddress(p[170:190]), FeeAuthUntil: binary.BigEndian.Uint64(p[190:198])}
+		if !bytes.Equal(e.Migration(b.ChainID, b.VerifierVersion).PublicInputs(), p) || e.MigrationNonce != 0 || e.FeeMode < 1 || e.FeeMode > 3 {
+			t.Fatal("unexpected public owner fixture")
+		}
+		b.Entries = append(b.Entries, e)
+		b.SponsorValidUntil = min(b.SponsorValidUntil, e.Expiry)
+	}
+	if b.SponsorValidUntil < 3600 {
+		t.Fatal("fixture expiry too early")
+	}
+	return SignBatch(t, b), b.SponsorValidUntil - 3600
+}
