+++ b/core/types/pq_json.go
@@ -0,0 +1,89 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package types
+
+import (
+	"encoding/json"
+	"errors"
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/common/hexutil"
+	"math/big"
+)
+
+type pqJSON struct {
+	Type         hexutil.Uint64  `json:"type"`
+	Hash         common.Hash     `json:"hash"`
+	ChainID      *hexutil.Big    `json:"chainId"`
+	From         *common.Address `json:"from,omitempty"`
+	Nonce        *hexutil.Uint64 `json:"nonce"`
+	Gas          *hexutil.Uint64 `json:"gas"`
+	GasTipCap    *hexutil.Big    `json:"maxPriorityFeePerGas"`
+	GasFeeCap    *hexutil.Big    `json:"maxFeePerGas"`
+	To           *common.Address `json:"to,omitempty"`
+	Value        *hexutil.Big    `json:"value,omitempty"`
+	Data         *hexutil.Bytes  `json:"input,omitempty"`
+	AccessList   *AccessList     `json:"accessList,omitempty"`
+	AlgID        *hexutil.Uint64 `json:"algId"`
+	PublicKey    *hexutil.Bytes  `json:"pqPk,omitempty"`
+	Signature    *hexutil.Bytes  `json:"sig,omitempty"`
+	PoPSignature *hexutil.Bytes  `json:"popSig,omitempty"`
+	V            *hexutil.Big    `json:"v,omitempty"`
+	R            *hexutil.Big    `json:"r,omitempty"`
+	S            *hexutil.Big    `json:"s,omitempty"`
+}
+
+func (tx *Transaction) marshalPQJSON() ([]byte, error) {
+	n, g := hexutil.Uint64(tx.Nonce()), hexutil.Uint64(tx.Gas())
+	j := pqJSON{Type: hexutil.Uint64(tx.Type()), Hash: tx.Hash(), ChainID: (*hexutil.Big)(tx.ChainId()), Nonce: &n, Gas: &g, GasTipCap: (*hexutil.Big)(tx.GasTipCap()), GasFeeCap: (*hexutil.Big)(tx.GasFeeCap())}
+	if p, ok := tx.AsPQTx(); ok {
+		a := hexutil.Uint64(p.AlgID)
+		j.From = &p.From
+		j.To = &p.To
+		j.Value = (*hexutil.Big)(p.Value)
+		j.Data = (*hexutil.Bytes)(&p.Data)
+		j.AccessList = &p.AccessList
+		j.AlgID = &a
+		j.Signature = (*hexutil.Bytes)(&p.Signature)
+		if len(p.PublicKey) == 1 {
+			j.PublicKey = (*hexutil.Bytes)(&p.PublicKey[0])
+		}
+	}
+	if p, ok := tx.AsPQEnroll(); ok {
+		a := hexutil.Uint64(p.AlgID)
+		j.AlgID = &a
+		j.PublicKey = (*hexutil.Bytes)(&p.PublicKey)
+		j.PoPSignature = (*hexutil.Bytes)(&p.PoPSignature)
+		j.V = (*hexutil.Big)(p.V)
+		j.R = (*hexutil.Big)(p.R)
+		j.S = (*hexutil.Big)(p.S)
+	}
+	return json.Marshal(j)
+}
+func decodePQJSON(input []byte) (TxData, error) {
+	var j pqJSON
+	if e := json.Unmarshal(input, &j); e != nil {
+		return nil, e
+	}
+	if j.ChainID == nil || j.Nonce == nil || j.Gas == nil || j.GasTipCap == nil || j.GasFeeCap == nil || j.AlgID == nil || *j.AlgID > 255 {
+		return nil, errors.New("missing/invalid PQ transaction field")
+	}
+	if j.Type == PQTxType {
+		if j.From == nil || j.To == nil || j.Value == nil || j.Data == nil || j.Signature == nil {
+			return nil, errors.New("missing PQ_TX field")
+		}
+		p := &PQTx{ChainID: (*big.Int)(j.ChainID), From: *j.From, Nonce: uint64(*j.Nonce), GasTipCap: (*big.Int)(j.GasTipCap), GasFeeCap: (*big.Int)(j.GasFeeCap), Gas: uint64(*j.Gas), To: *j.To, Value: (*big.Int)(j.Value), Data: *j.Data, AlgID: uint8(*j.AlgID), Signature: *j.Signature}
+		if j.AccessList != nil {
+			p.AccessList = *j.AccessList
+		}
+		if j.PublicKey != nil {
+			p.PublicKey = [][]byte{*j.PublicKey}
+		}
+		return p, p.validateShape()
+	}
+	if j.PublicKey == nil || j.PoPSignature == nil || j.V == nil || j.R == nil || j.S == nil {
+		return nil, errors.New("missing ENROLL field")
+	}
+	p := &PQEnrollTx{ChainID: (*big.Int)(j.ChainID), Nonce: uint64(*j.Nonce), GasTipCap: (*big.Int)(j.GasTipCap), GasFeeCap: (*big.Int)(j.GasFeeCap), Gas: uint64(*j.Gas), AlgID: uint8(*j.AlgID), PublicKey: *j.PublicKey, PoPSignature: *j.PoPSignature, V: (*big.Int)(j.V), R: (*big.Int)(j.R), S: (*big.Int)(j.S)}
+	return p, p.validateShape()
+}
diff --git a/core/types/pq_migrate_json.go b/core/types/pq_migrate_json.go
new file mode 100644
index 0000000000000000000000000000000000000000..eb30671c917a7c2d7924eab46ff08b9480452842
--- /dev/null
+++ b/core/types/pq_migrate_json.go
@@ -0,0 +1,89 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package types
+
+import (
+	"encoding/json"
+	"errors"
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/common/hexutil"
+	"math/big"
+)
+
+type pqMigrationSponsorJSON struct {
+	Sponsor    common.Address  `json:"sponsor"`
+	ValidUntil *hexutil.Uint64 `json:"validUntil"`
+	Signature  *hexutil.Bytes  `json:"signature"`
+}
+type pqMigrationLaneJSON struct {
+	Gas       *hexutil.Uint64 `json:"gas"`
+	PublicKey *hexutil.Bytes  `json:"publicKey"`
+	Signature *hexutil.Bytes  `json:"signature"`
+}
+type pqMigrationCarrierJSON struct {
+	Route    *hexutil.Uint64 `json:"route"`
+	Proof    *hexutil.Bytes  `json:"proof"`
+	FactRefs []common.Hash   `json:"factRefs,omitempty"`
+}
+
+// There is deliberately no ordinary nonce, ECDSA signature or authenticated
+// 'from' field. legacyAddress is a declared identity, authenticated by Full.
+type pqMigrateJSON struct {
+	Type            hexutil.Uint64          `json:"type"`
+	Hash            common.Hash             `json:"hash"`
+	ChainID         *hexutil.Big            `json:"chainId"`
+	LegacyAddress   *common.Address         `json:"legacyAddress"`
+	MigrationNonce  *hexutil.Uint64         `json:"migrationNonce"`
+	AlgID           *hexutil.Uint64         `json:"algId"`
+	PQPKCommit      *common.Hash            `json:"pqPkCommit"`
+	Expiry          *hexutil.Uint64         `json:"expiry"`
+	MaxAccountFee   *hexutil.Big            `json:"maxAccountFee"`
+	FeeMode         *hexutil.Uint64         `json:"feeMode"`
+	FeeSponsor      *common.Address         `json:"feeSponsor"`
+	FeeAuthUntil    *hexutil.Uint64         `json:"feeAuthUntil"`
+	GasTipCap       *hexutil.Big            `json:"maxPriorityFeePerGas"`
+	GasFeeCap       *hexutil.Big            `json:"maxFeePerGas"`
+	Gas             *hexutil.Uint64         `json:"gas"`
+	SponsorOption   *pqMigrationSponsorJSON `json:"sponsorOption"`
+	VerifierVersion *hexutil.Uint64         `json:"verifierVersion"`
+	ProofCarrier    *pqMigrationCarrierJSON `json:"proofCarrier"`
+	LaneAuthOption  *pqMigrationLaneJSON    `json:"laneAuthOption"`
+}
+
+func pqHexU64(n uint64) *hexutil.Uint64 { v := hexutil.Uint64(n); return &v }
+func (tx *Transaction) marshalPQMigrateJSON() ([]byte, error) {
+	p, _ := tx.AsPQMigrate()
+	j := pqMigrateJSON{Type: PQMigrateTxType, Hash: tx.Hash(), ChainID: (*hexutil.Big)(p.ChainID), LegacyAddress: &p.LegacyAddress, MigrationNonce: pqHexU64(p.MigrationNonce), AlgID: pqHexU64(uint64(p.AlgID)), PQPKCommit: &p.PQPKCommit, Expiry: pqHexU64(p.Expiry), MaxAccountFee: (*hexutil.Big)(p.MaxAccountFee), FeeMode: pqHexU64(uint64(p.FeeMode)), FeeSponsor: &p.FeeSponsor, FeeAuthUntil: pqHexU64(p.FeeAuthUntil), GasTipCap: (*hexutil.Big)(p.GasTipCap), GasFeeCap: (*hexutil.Big)(p.GasFeeCap), Gas: pqHexU64(p.Gas), VerifierVersion: pqHexU64(uint64(p.VerifierVersion)), ProofCarrier: &pqMigrationCarrierJSON{Route: pqHexU64(uint64(p.ProofCarrier.Route)), Proof: (*hexutil.Bytes)(&p.ProofCarrier.Proof), FactRefs: p.ProofCarrier.FactRefs}}
+	if s := p.SponsorOption; s != nil {
+		j.SponsorOption = &pqMigrationSponsorJSON{s.Sponsor, pqHexU64(s.ValidUntil), (*hexutil.Bytes)(&s.Signature)}
+	}
+	if a := p.LaneAuthOption; a != nil {
+		j.LaneAuthOption = &pqMigrationLaneJSON{pqHexU64(a.Gas), (*hexutil.Bytes)(&a.PublicKey), (*hexutil.Bytes)(&a.Signature)}
+	}
+	return json.Marshal(j)
+}
+func decodePQMigrateJSON(input []byte) (TxData, error) {
+	var j pqMigrateJSON
+	if e := json.Unmarshal(input, &j); e != nil {
+		return nil, e
+	}
+	bad := errors.New("NON_CANONICAL_ENCODING: missing/invalid migration JSON field")
+	if j.ChainID == nil || j.LegacyAddress == nil || j.MigrationNonce == nil || j.AlgID == nil || *j.AlgID > 255 || j.PQPKCommit == nil || j.Expiry == nil || j.MaxAccountFee == nil || j.FeeMode == nil || *j.FeeMode > 3 || j.FeeSponsor == nil || j.FeeAuthUntil == nil || j.GasTipCap == nil || j.GasFeeCap == nil || j.Gas == nil || j.VerifierVersion == nil || uint64(*j.VerifierVersion) > 0xffffffff || j.ProofCarrier == nil || j.ProofCarrier.Route == nil || *j.ProofCarrier.Route > 1 || j.ProofCarrier.Proof == nil {
+		return nil, bad
+	}
+	p := &PQMigrateTx{ChainID: (*big.Int)(j.ChainID), LegacyAddress: *j.LegacyAddress, MigrationNonce: uint64(*j.MigrationNonce), AlgID: uint8(*j.AlgID), PQPKCommit: *j.PQPKCommit, Expiry: uint64(*j.Expiry), MaxAccountFee: (*big.Int)(j.MaxAccountFee), FeeMode: uint8(*j.FeeMode), FeeSponsor: *j.FeeSponsor, FeeAuthUntil: uint64(*j.FeeAuthUntil), GasTipCap: (*big.Int)(j.GasTipCap), GasFeeCap: (*big.Int)(j.GasFeeCap), Gas: uint64(*j.Gas), VerifierVersion: uint32(*j.VerifierVersion), ProofCarrier: PQMigrationCarrier{uint8(*j.ProofCarrier.Route), *j.ProofCarrier.Proof, j.ProofCarrier.FactRefs}}
+	if s := j.SponsorOption; s != nil {
+		if s.ValidUntil == nil || s.Signature == nil {
+			return nil, bad
+		}
+		p.SponsorOption = &PQMigrationSponsor{s.Sponsor, uint64(*s.ValidUntil), *s.Signature}
+	}
+	if a := j.LaneAuthOption; a != nil {
+		if a.Gas == nil || a.PublicKey == nil || a.Signature == nil {
+			return nil, bad
+		}
+		p.LaneAuthOption = &PQMigrationLaneAuth{uint64(*a.Gas), *a.PublicKey, *a.Signature}
+	}
+	return p, p.ValidateShape()
+}
diff --git a/core/types/pq_migrate_test.go b/core/types/pq_migrate_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..e36663c11375c25a01f5aa40ff55db07c83aebe9
--- /dev/null
+++ b/core/types/pq_migrate_test.go
@@ -0,0 +1,183 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package types
+
+import (
+	"bytes"
+	"encoding/json"
+	"math/big"
+	"os"
+	"testing"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/crypto"
+	"github.com/ethereum/go-ethereum/rlp"
+)
+
+func migrationWireExample() *PQMigrateTx {
+	return &PQMigrateTx{
+		ChainID: big.NewInt(13375), LegacyAddress: common.HexToAddress("9858effd232b4033e47d90003d41ec34ecaeda94"), AlgID: 1, PQPKCommit: common.HexToHash("4e9e4c061c81c2bfb66fc9a0b48e49a4a0dba7864f1bf4f4ccdfa999593d574a"), Expiry: 1792195200, MaxAccountFee: big.NewInt(20000000000000000), FeeMode: 1, FeeSponsor: common.HexToAddress("91eae395a4b237a31200e9e6e48dc4b66d0230ab"), FeeAuthUntil: 1792195200, GasTipCap: big.NewInt(100000000), GasFeeCap: big.NewInt(2000000000), Gas: 50000000, SponsorOption: &PQMigrationSponsor{common.HexToAddress("91eae395a4b237a31200e9e6e48dc4b66d0230ab"), 1792195200, []byte{1, 2, 3}}, VerifierVersion: 0x80000002, ProofCarrier: PQMigrationCarrier{Route: 0, Proof: []byte{1, 0, 255}},
+	}
+}
+func TestPQFullWireRoundTrip(t *testing.T) {
+	p := migrationWireExample()
+	tx := NewTx(p)
+	raw, e := tx.MarshalBinary()
+	if e != nil {
+		t.Fatal(e)
+	}
+	if raw[0] != 0x7e || tx.Hash() != crypto.Keccak256Hash(raw) || uint64(tx.Size()) != uint64(len(raw)) {
+		t.Fatal("typed hash/size")
+	}
+	var fields []rlp.RawValue
+	if e = rlp.DecodeBytes(raw[1:], &fields); e != nil || len(fields) != 17 {
+		t.Fatalf("17 fields: %v %d", e, len(fields))
+	}
+	var sponsor []rlp.RawValue
+	rlp.DecodeBytes(fields[13], &sponsor)
+	if len(sponsor) != 3 || !bytes.Equal(fields[16], []byte{0xc0}) {
+		t.Fatal("exact option shape")
+	}
+	var back Transaction
+	if e = back.UnmarshalBinary(raw); e != nil {
+		t.Fatal(e)
+	}
+	if back.Hash() != tx.Hash() {
+		t.Fatal("binary roundtrip")
+	}
+	j, e := json.Marshal(tx)
+	if e != nil {
+		t.Fatal(e)
+	}
+	if bytes.Contains(j, []byte(`"nonce"`)) || bytes.Contains(j, []byte(`"from"`)) {
+		t.Fatal("fabricated ordinary nonce/sender JSON")
+	}
+	if e = json.Unmarshal(j, &back); e != nil || back.Hash() != tx.Hash() {
+		t.Fatalf("JSON roundtrip: %v", e)
+	}
+	id, e := Sender(LatestSignerForChainID(p.ChainID), tx)
+	if e != nil || id != p.LegacyAddress {
+		t.Fatalf("declared identity: %v", e)
+	}
+	fixture := os.Getenv("PQ_PI198_FILE")
+	if fixture == "" {
+		t.Skip("set PQ_PI198_FILE for the independent encoding vector")
+	}
+	expected, e := os.ReadFile(fixture)
+	if e != nil {
+		t.Fatal(e)
+	}
+	if !bytes.Equal(p.PublicInputs(), expected) {
+		t.Fatal("198-byte PI mismatch with independent Python/Rust fixture")
+	}
+	before := p.SponsorSigningHash()
+	p.SponsorOption.Signature = []byte{8, 9}
+	if p.SponsorSigningHash() != before {
+		t.Fatal("signature slot not emptied")
+	}
+	p.Gas++
+	if p.SponsorSigningHash() == before {
+		t.Fatal("gas not signed")
+	}
+	p.Gas--
+	p.FeeAuthUntil--
+	if p.SponsorSigningHash() == before {
+		t.Fatal("fee policy not signed")
+	}
+	rc := &Receipt{Type: PQMigrateTxType, Status: 1, CumulativeGasUsed: 123, Logs: []*Log{{Address: p.LegacyAddress, Topics: []common.Hash{p.PQPKCommit}, Data: []byte{9}}}}
+	rc.Bloom = CreateBloom(rc)
+	rb, e := rc.MarshalBinary()
+	if e != nil {
+		t.Fatal(e)
+	}
+	var rr Receipt
+	if e = rr.UnmarshalBinary(rb); e != nil || rr.Type != PQMigrateTxType || rr.Status != 1 || rr.CumulativeGasUsed != 123 {
+		t.Fatalf("typed receipt %v", e)
+	}
+	var encoded bytes.Buffer
+	Receipts{rc}.EncodeIndex(0, &encoded)
+	if !bytes.Equal(encoded.Bytes(), rb) {
+		t.Fatal("receipt trie encoding differs from typed receipt")
+	}
+	root := crypto.Keccak256Hash(encoded.Bytes())
+	rc.Logs[0].Data[0] ^= 1
+	encoded.Reset()
+	Receipts{rc}.EncodeIndex(0, &encoded)
+	if root == crypto.Keccak256Hash(encoded.Bytes()) {
+		t.Fatal("receipt trie encoding fails to bind log")
+	}
+}
+func TestPQFullWireCanonicalRejections(t *testing.T) {
+	tests := []struct {
+		name   string
+		mutate func(*PQMigrateTx)
+	}{
+		{"zero_commit", func(p *PQMigrateTx) { p.PQPKCommit = common.Hash{} }},
+		{"self_sponsor", func(p *PQMigrateTx) { p.SponsorOption.Sponsor = p.LegacyAddress }},
+		{"sponsor_window", func(p *PQMigrateTx) { p.SponsorOption.ValidUntil = p.Expiry + 1 }},
+		{"fee_mode", func(p *PQMigrateTx) { p.FeeMode = 4 }},
+		{"fee_mode0_sponsored", func(p *PQMigrateTx) { p.FeeMode = 0; p.FeeSponsor = common.Address{}; p.FeeAuthUntil = 0 }},
+		{"named_zero", func(p *PQMigrateTx) { p.FeeSponsor = common.Address{} }},
+		{"owner_window", func(p *PQMigrateTx) { p.FeeAuthUntil = p.Expiry + 1 }},
+		{"mode2_payee", func(p *PQMigrateTx) { p.FeeMode = 2; p.FeeAuthUntil = 0 }},
+		{"routeA_lane", func(p *PQMigrateTx) { p.LaneAuthOption = &PQMigrationLaneAuth{} }},
+		{"routeB_missing_auth", func(p *PQMigrateTx) {
+			p.FeeMode = 0
+			p.FeeSponsor = common.Address{}
+			p.FeeAuthUntil = 0
+			p.SponsorOption = nil
+			p.ProofCarrier.Route = 1
+		}},
+		{"routeB_nonzero_lane", func(p *PQMigrateTx) { p.ProofCarrier.Route = 1; p.LaneAuthOption = &PQMigrationLaneAuth{Gas: 1} }},
+		{"routeB_duplicate_fact", func(p *PQMigrateTx) { p.ProofCarrier.Route = 1; p.ProofCarrier.FactRefs = []common.Hash{{1}, {1}} }},
+		{"uint257", func(p *PQMigrateTx) { p.MaxAccountFee = new(big.Int).Lsh(big.NewInt(1), 256) }},
+	}
+	for _, v := range tests {
+		t.Run(v.name, func(t *testing.T) {
+			p := migrationWireExample()
+			v.mutate(p)
+			b, e := rlp.EncodeToBytes(p)
+			if e != nil {
+				return
+			}
+			var tx Transaction
+			if e = tx.UnmarshalBinary(append([]byte{0x7e}, b...)); e == nil {
+				t.Fatal("accepted malformed encoding")
+			}
+		})
+	}
+	p := migrationWireExample()
+	raw, _ := NewTx(p).MarshalBinary()
+	var fields []rlp.RawValue
+	rlp.DecodeBytes(raw[1:], &fields)
+	cases := map[string][]rlp.RawValue{}
+	for _, i := range []int{0, 1, 2, 13, 14, 16} {
+		f := append([]rlp.RawValue(nil), fields...)
+		switch i {
+		case 0:
+			f[i] = []byte{0x82, 0, 1}
+		case 1:
+			f[i] = []byte{0x80}
+		case 2:
+			f[i] = []byte{0}
+		case 13:
+			f[i] = []byte{0xc1, 0xc0}
+		case 14:
+			f[i] = []byte{0x85, 1, 0, 0, 0, 0}
+		case 16:
+			f[i] = []byte{0x80}
+		}
+		cases[big.NewInt(int64(i)).String()] = f
+	}
+	cases["wrong_field_count"] = fields[:16]
+	for n, f := range cases {
+		t.Run("raw_"+n, func(t *testing.T) {
+			b, _ := rlp.EncodeToBytes(f)
+			var tx Transaction
+			if tx.UnmarshalBinary(append([]byte{0x7e}, b...)) == nil {
+				t.Fatal("accepted invalid raw schema")
+			}
+		})
+	}
+}
diff --git a/core/types/pq_migrate_tx.go b/core/types/pq_migrate_tx.go
new file mode 100644
index 0000000000000000000000000000000000000000..674343927a8dadbbdf95e047dfd17730174fbf4a
--- /dev/null
+++ b/core/types/pq_migrate_tx.go
@@ -0,0 +1,234 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+// Research-only PI_LAYOUT_2 migration carrier. Authorization lives in core.
+package types
+
+import (
+	"bytes"
+	"encoding/binary"
+	"errors"
+	"io"
+	"math/big"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/crypto"
+	"github.com/ethereum/go-ethereum/rlp"
+)
+
+const PQMigrateTxType = 0x7e
+
+type PQMigrationSponsor struct {
+	Sponsor    common.Address
+	ValidUntil uint64
+	Signature  []byte
+}
+type PQMigrationLaneAuth struct {
+	Gas       uint64
+	PublicKey []byte
+	Signature []byte
+}
+
+// Route zero is [0, proof]; route one is [1, transcript, factRefs].
+// Route B can be decoded canonically but is never enabled by this research fork.
+type PQMigrationCarrier struct {
+	Route    uint8
+	Proof    []byte
+	FactRefs []common.Hash
+}
+
+func (p PQMigrationCarrier) EncodeRLP(w io.Writer) error {
+	if p.Route == 0 {
+		return rlp.Encode(w, []any{p.Route, p.Proof})
+	}
+	if p.Route == 1 {
+		return rlp.Encode(w, []any{p.Route, p.Proof, p.FactRefs})
+	}
+	return errors.New("NON_CANONICAL_ENCODING")
+}
+func (p *PQMigrationCarrier) DecodeRLP(s *rlp.Stream) error {
+	raw, err := s.Raw()
+	if err != nil {
+		return err
+	}
+	var fields []rlp.RawValue
+	if err = rlp.DecodeBytes(raw, &fields); err != nil {
+		return err
+	}
+	if len(fields) < 2 || len(fields) > 3 {
+		return errors.New("NON_CANONICAL_ENCODING")
+	}
+	if err = rlp.DecodeBytes(fields[0], &p.Route); err != nil {
+		return err
+	}
+	if err = rlp.DecodeBytes(fields[1], &p.Proof); err != nil {
+		return err
+	}
+	p.FactRefs = nil
+	switch p.Route {
+	case 0:
+		if len(fields) != 2 {
+			return errors.New("NON_CANONICAL_ENCODING")
+		}
+	case 1:
+		if len(fields) != 3 {
+			return errors.New("NON_CANONICAL_ENCODING")
+		}
+		if err = rlp.DecodeBytes(fields[2], &p.FactRefs); err != nil {
+			return err
+		}
+		for i := 1; i < len(p.FactRefs); i++ {
+			if bytes.Compare(p.FactRefs[i-1][:], p.FactRefs[i][:]) >= 0 {
+				return errors.New("NON_CANONICAL_ENCODING")
+			}
+		}
+	default:
+		return errors.New("NON_CANONICAL_ENCODING")
+	}
+	return nil
+}
+
+// Field order is the exact 17-field layout-2 wire profile. The options encode
+// as [] or the struct's fields, never as a list wrapping another list.
+type PQMigrateTx struct {
+	ChainID         *big.Int
+	LegacyAddress   common.Address
+	MigrationNonce  uint64
+	AlgID           uint8
+	PQPKCommit      common.Hash
+	Expiry          uint64
+	MaxAccountFee   *big.Int
+	FeeMode         uint8
+	FeeSponsor      common.Address
+	FeeAuthUntil    uint64
+	GasTipCap       *big.Int
+	GasFeeCap       *big.Int
+	Gas             uint64
+	SponsorOption   *PQMigrationSponsor `rlp:"nilList"`
+	VerifierVersion uint32
+	ProofCarrier    PQMigrationCarrier
+	LaneAuthOption  *PQMigrationLaneAuth `rlp:"nilList"`
+}
+
+func (p *PQMigrateTx) ValidateShape() error {
+	bad := func() error { return errors.New("NON_CANONICAL_ENCODING") }
+	if !pqUint256(p.ChainID) || !pqUint256(p.MaxAccountFee) || !pqUint256(p.GasTipCap) || !pqUint256(p.GasFeeCap) || p.PQPKCommit == (common.Hash{}) || p.FeeMode > 3 {
+		return bad()
+	}
+	switch p.FeeMode {
+	case 0, 2:
+		if p.FeeSponsor != (common.Address{}) || p.FeeAuthUntil != 0 {
+			return bad()
+		}
+	case 1:
+		if p.FeeSponsor == (common.Address{}) || p.FeeAuthUntil > p.Expiry {
+			return bad()
+		}
+	case 3:
+		if p.FeeSponsor != (common.Address{}) || p.FeeAuthUntil > p.Expiry {
+			return bad()
+		}
+	}
+	if (p.SponsorOption == nil) != (p.FeeMode == 0) {
+		return bad()
+	}
+	if s := p.SponsorOption; s != nil {
+		if s.Sponsor == p.LegacyAddress || s.ValidUntil > p.Expiry {
+			return bad()
+		}
+	}
+	switch p.ProofCarrier.Route {
+	case 0:
+		if p.LaneAuthOption != nil || len(p.ProofCarrier.FactRefs) != 0 {
+			return bad()
+		}
+	case 1:
+		if p.SponsorOption == nil && p.LaneAuthOption == nil {
+			return bad()
+		}
+		if p.SponsorOption != nil && p.LaneAuthOption != nil && p.LaneAuthOption.Gas != 0 {
+			return bad()
+		}
+		for i := 1; i < len(p.ProofCarrier.FactRefs); i++ {
+			if bytes.Compare(p.ProofCarrier.FactRefs[i-1][:], p.ProofCarrier.FactRefs[i][:]) >= 0 {
+				return bad()
+			}
+		}
+	default:
+		return bad()
+	}
+	return nil
+}
+func (p *PQMigrateTx) Sponsor() *PQMigrationSponsor { return p.SponsorOption }
+func (p *PQMigrateTx) copy() TxData {
+	b, e := rlp.EncodeToBytes(p)
+	if e != nil {
+		panic(e)
+	}
+	var c PQMigrateTx
+	if e = rlp.DecodeBytes(b, &c); e != nil {
+		panic(e)
+	}
+	return &c
+}
+func (p *PQMigrateTx) txType() byte           { return PQMigrateTxType }
+func (p *PQMigrateTx) chainID() *big.Int      { return p.ChainID }
+func (p *PQMigrateTx) accessList() AccessList { return nil }
+func (p *PQMigrateTx) data() []byte           { return nil }
+func (p *PQMigrateTx) gas() uint64            { return p.Gas }
+func (p *PQMigrateTx) gasPrice() *big.Int     { return p.GasFeeCap }
+func (p *PQMigrateTx) gasTipCap() *big.Int    { return p.GasTipCap }
+func (p *PQMigrateTx) gasFeeCap() *big.Int    { return p.GasFeeCap }
+func (p *PQMigrateTx) value() *big.Int        { return new(big.Int) }
+
+// Required by TxData only: this carrier HAS NO ordinary-account nonce.
+// No ordinary-nonce pool or state-transition rule may consume this accessor.
+func (p *PQMigrateTx) nonce() uint64       { return 0 }
+func (p *PQMigrateTx) to() *common.Address { return &common.Address{} }
+func (p *PQMigrateTx) effectiveGasPrice(dst, base *big.Int) *big.Int {
+	return pqEffective(dst, p.GasFeeCap, p.GasTipCap, base)
+}
+func (p *PQMigrateTx) rawSignatureValues() (v, r, s *big.Int) {
+	return new(big.Int), new(big.Int), new(big.Int)
+}
+func (p *PQMigrateTx) setSignatureValues(chainID, v, r, s *big.Int) {
+	p.ChainID = new(big.Int).Set(chainID)
+}
+func (p *PQMigrateTx) encode(b *bytes.Buffer) error { return rlp.Encode(b, p) }
+func (p *PQMigrateTx) decode(input []byte) error {
+	if err := rlp.DecodeBytes(input, p); err != nil {
+		return errors.New("NON_CANONICAL_ENCODING: " + err.Error())
+	}
+	return p.ValidateShape()
+}
+func (p *PQMigrateTx) sigHash(chainID *big.Int) common.Hash {
+	c := *p
+	c.ChainID = chainID
+	if p.SponsorOption != nil {
+		s := *p.SponsorOption
+		s.Signature = nil
+		c.SponsorOption = &s
+	}
+	return prefixedRlpHash(PQMigrateTxType, &c)
+}
+func (p *PQMigrateTx) SponsorSigningHash() common.Hash { return p.sigHash(p.ChainID) }
+func (p *PQMigrateTx) PublicInputs() []byte {
+	b := make([]byte, 198)
+	p.ChainID.FillBytes(b[:32])
+	copy(b[32:64], crypto.Keccak256([]byte("PQ-MIGRATE-v1"), b[:32]))
+	copy(b[64:84], p.LegacyAddress[:])
+	binary.BigEndian.PutUint64(b[84:92], p.MigrationNonce)
+	b[92] = p.AlgID
+	copy(b[93:125], p.PQPKCommit[:])
+	binary.BigEndian.PutUint32(b[125:129], p.VerifierVersion)
+	binary.BigEndian.PutUint64(b[129:137], p.Expiry)
+	p.MaxAccountFee.FillBytes(b[137:169])
+	b[169] = p.FeeMode
+	copy(b[170:190], p.FeeSponsor[:])
+	binary.BigEndian.PutUint64(b[190:198], p.FeeAuthUntil)
+	return b
+}
+func (tx *Transaction) AsPQMigrate() (*PQMigrateTx, bool) {
+	p, ok := tx.inner.(*PQMigrateTx)
+	return p, ok
+}
