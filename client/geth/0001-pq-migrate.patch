+	"testing"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core/txpool"
+	"github.com/ethereum/go-ethereum/core/types"
+)
+
+func TestPQPoolCheapPolicyBeforeInvalidSponsorSignature(t *testing.T) {
+	for _, kind := range []string{"tip", "replacement", "version"} {
+		t.Run(kind, func(t *testing.T) {
+			p, chain, calls := componentPool(t)
+			chain.cfg.AmsterdamTime, chain.cfg.BogotaTime, chain.cfg.UBTTime = nil, nil, nil
+			var expected error
+			candidate := componentTx(1, 24, 2, 20)
+			switch kind {
+			case "tip":
+				p.minTip = big.NewInt(3)
+				expected = txpool.ErrUnderpriced
+			case "replacement":
+				if err := add(p, componentTx(1, 20, 2, 20)); err != nil {
+					t.Fatal(err)
+				}
+				candidate = componentTx(1, 20, 3, 30)
+				expected = txpool.ErrReplaceUnderpriced
+			case "version":
+				for payer := byte(20); payer < 23; payer++ {
+					if err := add(p, componentTx(1, payer, 2, 20)); err != nil {
+						t.Fatal(err)
+					}
+				}
+				expected = ErrVersionLimit
+			}
+			candidate = changed(candidate, func(m *types.PQMigrateTx) { m.Gas = 1_000_000 })
+			p.checkState = nil // Real core state checks and real (deliberately bad) signature.
+			before, pending := *calls, len(p.entries)
+			if err := add(p, candidate); !errors.Is(err, expected) {
+				t.Fatalf("got %v, want %v", err, expected)
+			}
+			if *calls != before || len(p.entries) != pending || p.sources["rpc:component"].failures != 0 {
+				t.Fatal("cheap rejection verified Full, displaced a version or charged a source")
+			}
+		})
+	}
+}
+
+// Pairwise checks make fee-cap and hash tie-break regressions deterministic;
+// the policy test below additionally exercises selection from the entry map.
+func TestPQPoolDisplacementComparatorTieBreaks(t *testing.T) {
+	makeEntry := func(tip, fee int64, hashByte byte) *entry {
+		return &entry{
+			hash: common.Hash{31: hashByte},
+			template: &types.PQMigrateTx{
+				GasTipCap: big.NewInt(tip),
+				GasFeeCap: big.NewInt(fee),
+			},
+		}
+	}
+	for _, test := range []struct {
+		name          string
+		lower, higher *entry
+	}{
+		{"tip-before-fee-and-hash", makeEntry(1, 40, 1), makeEntry(2, 20, 2)},
+		{"fee-before-hash", makeEntry(2, 20, 1), makeEntry(2, 30, 2)},
+		{"greatest-hash", makeEntry(2, 20, 2), makeEntry(2, 20, 1)},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			if !lowerDisplacementPriority(test.lower, test.higher) {
+				t.Fatal("lower-priority entry did not sort first")
+			}
+			if lowerDisplacementPriority(test.higher, test.lower) {
+				t.Fatal("reverse comparison also sorted first")
+			}
+			if lowerDisplacementPriority(test.lower, test.lower) {
+				t.Fatal("identical entries have a strict displacement order")
+			}
+		})
+	}
+}
+
+func TestPQPoolDisplacementTieBreaksIndependentOfInsertionOrder(t *testing.T) {
+	for _, reverse := range []bool{false, true} {
+		for _, equalFees := range []bool{false, true} {
+			p, _, _ := componentPool(t)
+			a, b := componentTx(1, 20, 2, 20), componentTx(1, 21, 2, 30)
+			if equalFees {
+				b = componentTx(1, 21, 2, 20)
+			}
+			want := a.Hash()
+			ah, bh := a.Hash(), b.Hash()
+			if equalFees && bytes.Compare(ah[:], bh[:]) < 0 {
+				want = b.Hash()
+			}
+			rows := []*types.Transaction{a, b, componentTx(1, 22, 4, 40)}
+			if reverse {
+				rows[0], rows[2] = rows[2], rows[0]
+			}
+			for _, tx := range rows {
+				if err := add(p, tx); err != nil {
+					t.Fatal(err)
+				}
+			}
+			candidate := componentTx(1, 24, 5, 50)
+			m, _ := candidate.AsPQMigrate()
+			got, err := p.policy(m, p.nextHeader(), common.Hash{}, true)
+			if err != nil || got != want {
+				t.Fatalf("fees=%v reverse=%v: got %s/%v, want %s", equalFees, reverse, got, err, want)
+			}
+			if err := add(p, candidate); err != nil {
+				t.Fatal(err)
+			}
+			if p.Has(want) || len(p.entries) != 3 {
+				t.Fatal("wrong version displaced")
+			}
+		}
+	}
+}
