@@ -0,0 +1,84 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package catalyst
+
+import (
+	"context"
+	"github.com/ethereum/go-ethereum/beacon/engine"
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestPQSigningFenceHoldsEngineAndRewind(t *testing.T) {
+	genesis, blocks := generateMergeChain(4, true)
+	n, backend := startEthService(t, genesis, blocks)
+	defer n.Close()
+	t.Setenv("PQ_LEAN_FENCE_PATH", filepath.Join(t.TempDir(), "fence"))
+	api := newConsensusAPIWithoutHeartbeat(backend)
+	targets := engine.ForkchoiceStateV1{HeadBlockHash: blocks[3].Hash(), SafeBlockHash: blocks[0].Hash(), FinalizedBlockHash: blocks[0].Hash()}
+	if _, err := api.ForkchoiceUpdatedV3(context.Background(), targets, nil); err != nil {
+		t.Fatal(err)
+	}
+	req := common.HexToHash("0xa123")
+	fence, err := api.PqBeginSigningV1(req, targets)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := core.PQCheckSigningFenceRecovery(); err == nil {
+		t.Fatal("restart accepted unresolved signature fence")
+	}
+	if _, err := api.PqEndSigningV1(fence.Instance, common.Hash{}); err == nil {
+		t.Fatal("wrong release accepted")
+	}
+	done := make(chan error, 2)
+	go func() { _, err := api.ForkchoiceUpdatedV3(context.Background(), targets, nil); done <- err }()
+	go func() { _, err := backend.BlockChain().SetCanonical(blocks[2]); done <- err }()
+	select {
+	case err := <-done:
+		t.Fatalf("mutation crossed fence: %v", err)
+	case <-time.After(50 * time.Millisecond):
+	}
+	if ok, err := api.PqEndSigningV1(fence.Instance, req); !ok || err != nil {
+		t.Fatal(ok, err)
+	}
+	for i := 0; i < 2; i++ {
+		select {
+		case err := <-done:
+			if err != nil {
+				t.Fatal(err)
+			}
+		case <-time.After(5 * time.Second):
+			t.Fatal("held mutation did not resume")
+		}
+	}
+	if err := core.PQCheckSigningFenceRecovery(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(os.Getenv("PQ_LEAN_FENCE_PATH")); !os.IsNotExist(err) {
+		t.Fatal("released marker persists", err)
+	}
+}
+
+func TestPQSigningFenceRejectsWrongAppliedTargets(t *testing.T) {
+	genesis, blocks := generateMergeChain(3, true)
+	n, backend := startEthService(t, genesis, blocks)
+	defer n.Close()
+	t.Setenv("PQ_LEAN_FENCE_PATH", filepath.Join(t.TempDir(), "fence"))
+	api := newConsensusAPIWithoutHeartbeat(backend)
+	targets := engine.ForkchoiceStateV1{HeadBlockHash: blocks[2].Hash(), SafeBlockHash: blocks[0].Hash(), FinalizedBlockHash: blocks[0].Hash()}
+	if _, err := api.ForkchoiceUpdatedV3(context.Background(), targets, nil); err != nil {
+		t.Fatal(err)
+	}
+	targets.HeadBlockHash = blocks[1].Hash()
+	if _, err := api.PqBeginSigningV1(common.HexToHash("0xb123"), targets); err == nil {
+		t.Fatal("unapplied target got fence")
+	}
+	if err := core.PQCheckSigningFenceRecovery(); err != nil {
+		t.Fatal("rejected targets left a fence", err)
+	}
+}
