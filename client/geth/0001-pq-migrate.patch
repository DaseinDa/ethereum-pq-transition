+	return gen, bc, db, boot[0], mk
+}
+
+// actualManagedPool exercises the real upstream transaction-pool head subscription.
+// Callers never invoke Reset themselves to claim automatic orphan reinjection.
+func actualManagedPool(t *testing.T, bc *core.BlockChain) (*Pool, *txpool.TxPool) {
+	t.Helper()
+	cfg := DefaultConfig
+	cfg.Datadir = t.TempDir()
+	p := New(cfg, bc)
+	manager, err := txpool.New(1, bc, []txpool.SubPool{p})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if err := manager.Close(); err != nil {
+			t.Error(err)
+		}
+	})
+	return p, manager
+}
+func actualAwaitHead(t *testing.T, p *Pool, want common.Hash) {
+	t.Helper()
+	deadline := time.Now().Add(20 * time.Second)
+	for time.Now().Before(deadline) {
+		p.mu.RLock()
+		ready := p.head != nil && p.head.Hash() == want
+		p.mu.RUnlock()
+		if ready {
+			return
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	t.Fatal("actual txpool ChainHeadEvent did not complete Reset", want)
+}
+func actualPending(t *testing.T, p *Pool, tx *types.Transaction, want bool) {
+	t.Helper()
+	pending, n := p.Pending(txpool.PendingFilter{OnlyPQ: true})
+	found := false
+	for _, versions := range pending {
+		for _, item := range versions {
+			if item.Hash == tx.Hash() {
+				found = true
+			}
+		}
+	}
+	if found != want || p.Has(tx.Hash()) != want {
+		t.Fatalf("Pending/Has mismatch: got pending=%v Has=%v n=%d want=%v", found, p.Has(tx.Hash()), n, want)
+	}
+}
+func TestPQPoolActualHeadAndReorg(t *testing.T) {
+	gen, bc, _, boot, mk := actualBase(t)
+	p, manager := actualManagedPool(t, bc)
+	tx := actualRead(t, "migrate")
+	if err := manager.Add([]*types.Transaction{tx}, true)[0]; err != nil {
+		t.Fatal(err)
+	}
+	actualPending(t, p, tx, true)
+	other := actualRead(t, "other-sponsor-migrate")
+	if err := manager.Add([]*types.Transaction{other}, true)[0]; err != nil {
+		t.Fatal(err)
+	}
+	if len(p.entries) != 2 || len(p.bodies) != 1 {
+		t.Fatal("real proof body not deduplicated")
+	}
+	blockA, _ := mk(boot, "migration-A", tx)
+	actualImport(t, bc, blockA, true)
+	actualAwaitHead(t, p, blockA.Hash())
+	if p.Has(tx.Hash()) || p.Has(other.Hash()) {
+		t.Fatal("new migration nonce did not evict both payer versions")
+	}
+	afterA, err := bc.StateAt(blockA.Header())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if core.ReadPQRecord(afterA, gen.Config.PQMigrate.Registry, actualL).MigrationNonce != 1 {
+		t.Fatal("migration did not execute")
+	}
+	if afterA.GetNonce(actualL) != 0 || afterA.GetNonce(actualS) != 1 {
+		t.Fatal("Full used ordinary nonce")
+	}
+	side, _ := mk(boot, "empty-side", nil)
+	actualImport(t, bc, side, true)
+	actualAwaitHead(t, p, side.Hash())
+	back, err := bc.StateAt(side.Header())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if core.ReadPQRecord(back, gen.Config.PQMigrate.Registry, actualL).Mode != 0 || len(back.GetCode(actualL)) != 0 {
+		t.Fatal("reorg did not restore LEGACY")
+	}
+	if back.GetBalance(actualL).ToBig().Cmp(big.NewInt(2000000000000000000)) != 0 {
+		t.Fatal("owner balance did not roll back")
+	}
+	actualPending(t, p, tx, true)
+	if p.Has(other.Hash()) {
+		t.Fatal("non-included competing payer version unexpectedly resurrected")
+	}
+	replay, _ := mk(side, "migration-after-reorg", tx)
+	actualImport(t, bc, replay, true)
+	actualAwaitHead(t, p, replay.Hash())
+	actualPending(t, p, tx, false)
+	if bc.CurrentBlock().Hash() != replay.Hash() {
+		t.Fatal("canonical head wrong")
+	}
+	t.Logf("real fixed Full + BlockChain -> txpool.ChainHeadEvent -> Reset -> automatic Pending -> re-inclusion; NO resubmit/Reset/Sync calls; common=%s old=%s side=%s replay=%s gas=%d/%d", boot.Hash(), blockA.Hash(), side.Hash(), replay.Hash(), blockA.GasUsed(), replay.GasUsed())
+}
+
+func TestPQPoolActualDirectInvalidImportAndUnavailable(t *testing.T) {
+	_, bc, db, boot, mk := actualBase(t)
+	valid, receipts := mk(boot, "valid-after-local-repair", actualRead(t, "migrate"))
+	badtx := actualRead(t, "negative-proof-byte")
+	bad := types.NewBlock(valid.Header(), &types.Body{Transactions: []*types.Transaction{badtx}, Withdrawals: valid.Withdrawals()}, receipts, trie.NewStackTrie(nil))
+	before := bc.CurrentBlock().Hash()
+	_, err := bc.InsertBlockWithoutSetHead(context.Background(), bad, false)
+	if !errors.Is(err, core.ErrPQInvalidFullProof) {
+		t.Fatalf("direct invalid proof import: %v", err)
+	}
+	if bc.CurrentBlock().Hash() != before {
+		t.Fatal("invalid import changed head")
+	}
+	if rawdb.ReadBadBlock(db, bad.Hash()) == nil {
+		t.Fatal("deterministically invalid block not distinguished in badblock storage")
+	}
+	// A local worker path failure is not a consensus negative. The exact block
+	// must import successfully when the local dependency is restored.
+	t.Setenv("PQ_FULL_VERIFIER_PATH", filepath.Join(t.TempDir(), "missing-worker"))
+	_, err = bc.InsertBlockWithoutSetHead(context.Background(), valid, false)
+	if !errors.Is(err, core.ErrPQFullUnavailable) {
+		t.Fatalf("local failure misclassified: %v", err)
+	}
+	if bc.CurrentBlock().Hash() != before || rawdb.ReadBadBlock(db, valid.Hash()) != nil {
+		t.Fatal("unavailable cached as bad or advanced head")
+	}
+	t.Setenv("PQ_FULL_VERIFIER_PATH", actualWorker)
+	actualImport(t, bc, valid, true)
+	t.Logf("direct import bypassed pool: bad=%s INVALID_PROOF, unavailable=%s no badblock/head change, same block passed after repair", bad.Hash(), valid.Hash())
+}
+
+func TestPQPoolActualHeadBalanceAndLocalAvailability(t *testing.T) {
+	_, bc, _, boot, mk := actualBase(t)
+	p := actualPool(t, bc)
+	tx := actualRead(t, "migrate")
+	if err := add(p, tx); err != nil {
+		t.Fatal(err)
+	}
+	// Explicitly evict the pure success: the outage path applies to cache misses.
+	p.positiveCache = newProofResultCache(p.cfg.PositiveCacheBytes)
+	t.Setenv("PQ_FULL_VERIFIER_PATH", filepath.Join(t.TempDir(), "missing-worker"))
+	p.Reset(boot.Header(), boot.Header())
+	if p.Has(tx.Hash()) {
+		t.Fatal("local unavailability left transaction eligible as Pending")
+	}
+	if p.deferred[tx.Hash()] == nil {
+		t.Fatal("local unavailability lost recoverable transaction")
+	}
+	t.Setenv("PQ_FULL_VERIFIER_PATH", actualWorker)
+	p.Reset(boot.Header(), boot.Header())
+	if !p.Has(tx.Hash()) {
+		t.Fatal("repaired full revalidation dropped valid tx")
+	}
+	drain := actualRead(t, "sponsor-drain")
+	block, _ := mk(boot, "sponsor-balance-change", drain)
+	actualImport(t, bc, block, true)
+	p.Reset(boot.Header(), block.Header())
+	if p.Has(tx.Hash()) || len(p.bans) != 1 {
+		t.Fatal("actual sponsor balance change did not evict+ban")
+	}
+	s, err := bc.StateAt(block.Header())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if s.GetBalance(actualS).ToBig().Cmp(big.NewInt(100000000000000000)) >= 0 {
+		t.Fatal("fixture did not reduce sponsor below gross maximum")
+	}
+	t.Logf("actual signed 0x7c head balance change: sponsor balance=%s, pending removed and local sponsor ban; no Full verdict from unavailable worker", s.GetBalance(actualS).ToBig())
+}
+
+// All of these run actual signed transactions and the pinned real Full worker.
+// They use normal BlockChain SetCanonical events, not a manually injected Reset.
+func TestPQPoolActualAutomaticReorgFilters(t *testing.T) {
+	for _, name := range []string{"already-on-new-branch", "new-migration-nonce", "sponsor-balance", "proof-expiry", "fee-authorization-expiry"} {
+		t.Run(name, func(t *testing.T) {
+			gen, bc, _, boot, mk := actualBase(t)
+			p, _ := actualManagedPool(t, bc)
+			var proofCalls atomic.Int64
+			realCheck := p.checkProof
+			p.checkProof = func(tx *types.Transaction, c *params.ChainConfig, context string) error {
+				proofCalls.Add(1)
+				return realCheck(tx, c, context)
+			}
+			fixture := "migrate"
+			if name == "fee-authorization-expiry" {
+				fixture = "fee-expired-migrate"
+			}
+			tx := actualRead(t, fixture)
+			m, _ := tx.AsPQMigrate()
+			old, _ := mk(boot, "orphan-"+name, tx)
+			var side *types.Block
+			switch name {
+			case "already-on-new-branch":
+				side, _ = mk(boot, "replacement-same-raw", tx)
+			case "new-migration-nonce":
+				side, _ = mk(boot, "replacement-other-payer", actualRead(t, "other-sponsor-migrate"))
+			case "sponsor-balance":
+				side, _ = mk(boot, "replacement-drain", actualRead(t, "sponsor-drain"))
+			case "proof-expiry":
+				side, _ = mk(boot, "replacement-late", nil, int64(m.Expiry-boot.Time())+1-10)
+			case "fee-authorization-expiry":
+				side, _ = mk(boot, "replacement-fee-late", nil, int64(m.FeeAuthUntil-boot.Time())+1-10)
+			}
+			actualImport(t, bc, old, true)
+			actualAwaitHead(t, p, old.Hash())
+			actualImport(t, bc, side, true)
+			actualAwaitHead(t, p, side.Hash())
+			want := name == "fee-authorization-expiry"
+			actualPending(t, p, tx, want)
+			p.mu.RLock()
+			deferred := len(p.deferred)
+			p.mu.RUnlock()
+			if deferred != 0 {
+				t.Fatalf("definite head outcome entered unavailable quarantine: %d", deferred)
+			}
+			if want && proofCalls.Load() != 1 {
+				t.Fatalf("expected fresh real Full after new-head state checks, calls=%d", proofCalls.Load())
+			}
+			if !want && proofCalls.Load() != 0 {
+				t.Fatalf("excluded candidate unnecessarily reached Full, calls=%d", proofCalls.Load())
+			}
+			p.mu.RLock()
+			stateCopy := p.state.Copy()
+			nextHeader := p.nextHeader()
+			p.mu.RUnlock()
+			gateErr := core.ValidatePQMigrateState(tx, stateCopy, nextHeader, gen.Config)
+			t.Logf("automatic reorg filter: fixture=%s tx=%s common=%s old=%s new=%s candidateTime=%d current-state-gate=%v pool-Full-calls=%d Pending=%v Deferred=%d", name, tx.Hash(), boot.Hash(), old.Hash(), side.Hash(), nextHeader.Time, gateErr, proofCalls.Load(), want, deferred)
+			if want {
+				before, err := bc.StateAt(side.Header())
+				if err != nil {
+					t.Fatal(err)
+				}
+				owner := before.GetBalance(actualL).ToBig()
+				sponsor := before.GetBalance(actualS).ToBig()
+				replay, _ := mk(side, "zero-reimbursement-reincluded", tx)
+				actualImport(t, bc, replay, true)
+				actualAwaitHead(t, p, replay.Hash())
+				after, err := bc.StateAt(replay.Header())
+				if err != nil {
+					t.Fatal(err)
+				}
+				if after.GetBalance(actualL).ToBig().Cmp(owner) != 0 {
+					t.Fatal("expired fee authorization still charged owner")
+				}
+				if after.GetBalance(actualS).ToBig().Cmp(sponsor) >= 0 {
+					t.Fatal("external sponsor did not pay")
+				}
+				if core.ReadPQRecord(after, gen.Config.PQMigrate.Registry, actualL).MigrationNonce != 1 {
+					t.Fatal("valid migration was not executed")
+				}
+				t.Logf("real fee_auth_until=%d < replacement timestamp=%d: Full remained valid; auto-Pending and reinclusion; owner reimbursement=0, sponsor pays gas=%d", m.FeeAuthUntil, side.Time(), replay.GasUsed())
+			} else {
+				t.Logf("real automatic orphan filter %s: old=%s new=%s timestamp=%d; excluded from Pending and quarantine", name, old.Hash(), side.Hash(), side.Time())
+			}
+		})
+	}
+}
+func TestPQPoolActualAutomaticReorgUnavailableRecovery(t *testing.T) {
+	_, bc, _, boot, mk := actualBase(t)
+	p, manager := actualManagedPool(t, bc)
+	tx := actualRead(t, "migrate")
+	old, _ := mk(boot, "unavailable-old", tx)
+	side, _ := mk(boot, "unavailable-side", nil)
+	actualImport(t, bc, old, true)
+	actualAwaitHead(t, p, old.Hash())
+	t.Setenv("PQ_FULL_VERIFIER_PATH", filepath.Join(t.TempDir(), "missing-worker"))
+	actualImport(t, bc, side, true)
+	actualAwaitHead(t, p, side.Hash())
+	actualPending(t, p, tx, false)
+	p.mu.RLock()
+	held := p.deferred[tx.Hash()] != nil
+	banned := len(p.bans)
+	p.mu.RUnlock()
+	lookup := NewAPI(p).Lookup(tx.Hash())
+	if lookup["status"] != "deferred" || lookup["eligible"] != false || lookup["retryable"] != true {
+		t.Fatal("real unavailable diagnostics", lookup)
+	}
+	if !held || banned != 0 {
+		t.Fatalf("local worker fault lost orphan or banned sponsor: held=%v bans=%d", held, banned)
+	}
+	t.Setenv("PQ_FULL_VERIFIER_PATH", actualWorker)
+	// Explicit synchronization only for local-dependency repair. Discovery above
+	// was automatic from the real head event. Sync is upstream's real Reset path.
+	if err := manager.Sync(); err != nil {
+		t.Fatal(err)
+	}
+	actualPending(t, p, tx, true)
+	p.mu.RLock()
+	held = p.deferred[tx.Hash()] != nil
+	p.mu.RUnlock()
+	if held {
+		t.Fatal("repaired candidate left duplicate quarantine")
+	}
+	if NewAPI(p).Lookup(tx.Hash())["status"] != "pending" {
+		t.Fatal("repaired real proof not Pending in lookup")
+	}
+	t.Log("real orphan discovery on ChainHeadEvent: missing local worker quarantined, no Pending/ban/INVALID verdict; same raw revalidated by fixed Full after explicit txpool.Sync repair")
+}
