+// pqL2Pool is the mechanics pool: it admits a 0x7e up to its byte bound with
+// no proof, state or signature check (the pqpool's raw-bound rule only), and
+// is the node's blob pool too (holding none).
+type pqL2Pool struct {
+	bound uint64
+	lock  sync.RWMutex
+	txs   map[common.Hash]*types.Transaction
+	tried map[common.Hash]int // Add attempts per hash, admitted or not
+	feed  event.Feed
+}
+
+func newPQL2Pool(bound uint64) *pqL2Pool {
+	return &pqL2Pool{bound: bound, txs: make(map[common.Hash]*types.Transaction), tried: make(map[common.Hash]int)}
+}
+func (p *pqL2Pool) Has(h common.Hash) bool {
+	p.lock.RLock()
+	defer p.lock.RUnlock()
+	return p.txs[h] != nil
+}
+func (p *pqL2Pool) attempts(h common.Hash) int {
+	p.lock.RLock()
+	defer p.lock.RUnlock()
+	return p.tried[h]
+}
+func (p *pqL2Pool) Get(h common.Hash) *types.Transaction {
+	p.lock.RLock()
+	defer p.lock.RUnlock()
+	return p.txs[h]
+}
+func (p *pqL2Pool) GetRLP(h common.Hash, _ uint) []byte {
+	if tx := p.Get(h); tx != nil {
+		enc, _ := rlp.EncodeToBytes(tx)
+		return enc
+	}
+	return nil
+}
+func (p *pqL2Pool) GetMetadata(h common.Hash) *txpool.TxMetadata {
+	if tx := p.Get(h); tx != nil {
+		return &txpool.TxMetadata{Type: tx.Type(), Size: tx.Size(), SizeWithoutBlob: tx.Size()}
+	}
+	return nil
+}
+func (p *pqL2Pool) Add(txs []*types.Transaction, _ bool) []error {
+	errs := make([]error, len(txs))
+	var added []*types.Transaction
+	p.lock.Lock()
+	for i, tx := range txs {
+		p.tried[tx.Hash()]++
+		switch {
+		case tx.Type() != types.PQMigrateTxType:
+			errs[i] = core.ErrTxTypeNotSupported
+		case tx.Size() > p.bound:
+			errs[i] = errors.New("PQ_RESEARCH_SIZE_LIMIT")
+		case p.txs[tx.Hash()] != nil:
+			errs[i] = txpool.ErrAlreadyKnown
+		default:
+			p.txs[tx.Hash()] = tx
+			added = append(added, tx)
+		}
+	}
+	p.lock.Unlock()
+	if len(added) > 0 {
+		p.feed.Send(core.NewTxsEvent{Txs: added})
+	}
+	return errs
+}
+func (p *pqL2Pool) Pending(txpool.PendingFilter) (map[common.Address][]*txpool.LazyTransaction, int) {
+	return map[common.Address][]*txpool.LazyTransaction{}, 0
+}
+func (p *pqL2Pool) SubscribeTransactions(ch chan<- core.NewTxsEvent, _ bool) event.Subscription {
+	return p.feed.Subscribe(ch)
+}
+func (p *pqL2Pool) FilterType(kind byte) bool               { return kind == types.PQMigrateTxType }
+func (p *pqL2Pool) GetBlobHashes(common.Hash) []common.Hash { return nil }
+func (p *pqL2Pool) GetBlobCells([]common.Hash, types.CustodyBitmap) ([][]*kzg4844.Cell, [][]*kzg4844.Proof, error) {
+	return nil, nil, nil
+}
+func (p *pqL2Pool) GetCustody(common.Hash) *types.CustodyBitmap { return nil }
+func (p *pqL2Pool) AddPooledTx(*blobpool.BlobTxForPool) error   { return errors.New("no blob pool") }
+func (p *pqL2Pool) ValidateTxBasics(*types.Transaction) error   { return nil }
