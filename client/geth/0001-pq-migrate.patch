index 0000000000000000000000000000000000000000..418e1207cea1da2d8f0575a2bdcc94c47689a5d6
--- /dev/null
+++ b/core/types/pq_tx.go
@@ -0,0 +1,173 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+// Research-only v1.7.3 canonical transaction types. No Full verifier is enabled.
+package types
+
+import (
+	"bytes"
+	"errors"
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/crypto"
+	"github.com/ethereum/go-ethereum/rlp"
+	"math/big"
+)
+
+const (
+	PQTxType       = 0x7c
+	PQEnrollTxType = 0x7d
+)
+
+// PQTx follows the thirteen-field protocol RLP schema. PublicKey is [] or [pk].
+type PQTx struct {
+	ChainID    *big.Int
+	From       common.Address
+	Nonce      uint64
+	GasTipCap  *big.Int
+	GasFeeCap  *big.Int
+	Gas        uint64
+	To         common.Address
+	Value      *big.Int
+	Data       []byte
+	AccessList AccessList
+	AlgID      uint8
+	PublicKey  [][]byte
+	Signature  []byte
+}
+
+type PQEnrollTx struct {
+	ChainID      *big.Int
+	Nonce        uint64
+	GasTipCap    *big.Int
+	GasFeeCap    *big.Int
+	Gas          uint64
+	AlgID        uint8
+	PublicKey    []byte
+	PoPSignature []byte
+	V            *big.Int
+	R            *big.Int
+	S            *big.Int
+}
+
+func pqUint256(v *big.Int) bool { return v != nil && v.Sign() >= 0 && v.BitLen() <= 256 }
+func (t *PQTx) validateShape() error {
+	if !pqUint256(t.ChainID) || !pqUint256(t.GasTipCap) || !pqUint256(t.GasFeeCap) || !pqUint256(t.Value) || len(t.PublicKey) > 1 || (len(t.PublicKey) == 1 && len(t.PublicKey[0]) == 0) {
+		return errors.New("NON_CANONICAL_ENCODING")
+	}
+	return nil
+}
+func (t *PQEnrollTx) validateShape() error {
+	if !pqUint256(t.ChainID) || !pqUint256(t.GasTipCap) || !pqUint256(t.GasFeeCap) || !pqUint256(t.V) || !pqUint256(t.R) || !pqUint256(t.S) || t.V.BitLen() > 1 {
+		return errors.New("NON_CANONICAL_ENCODING")
+	}
+	return nil
+}
+func (t *PQTx) copy() TxData {
+	b, e := rlp.EncodeToBytes(t)
+	if e != nil {
+		panic(e)
+	}
+	var c PQTx
+	if e = rlp.DecodeBytes(b, &c); e != nil {
+		panic(e)
+	}
+	return &c
+}
+func (t *PQEnrollTx) copy() TxData {
+	b, e := rlp.EncodeToBytes(t)
+	if e != nil {
+		panic(e)
+	}
+	var c PQEnrollTx
+	if e = rlp.DecodeBytes(b, &c); e != nil {
+		panic(e)
+	}
+	return &c
+}
+func (t *PQTx) txType() byte                 { return PQTxType }
+func (t *PQEnrollTx) txType() byte           { return PQEnrollTxType }
+func (t *PQTx) chainID() *big.Int            { return t.ChainID }
+func (t *PQEnrollTx) chainID() *big.Int      { return t.ChainID }
+func (t *PQTx) accessList() AccessList       { return t.AccessList }
+func (t *PQEnrollTx) accessList() AccessList { return nil }
+func (t *PQTx) data() []byte                 { return t.Data }
+func (t *PQEnrollTx) data() []byte           { return nil }
+func (t *PQTx) gas() uint64                  { return t.Gas }
+func (t *PQEnrollTx) gas() uint64            { return t.Gas }
+func (t *PQTx) gasPrice() *big.Int           { return t.GasFeeCap }
+func (t *PQEnrollTx) gasPrice() *big.Int     { return t.GasFeeCap }
+func (t *PQTx) gasTipCap() *big.Int          { return t.GasTipCap }
+func (t *PQEnrollTx) gasTipCap() *big.Int    { return t.GasTipCap }
+func (t *PQTx) gasFeeCap() *big.Int          { return t.GasFeeCap }
+func (t *PQEnrollTx) gasFeeCap() *big.Int    { return t.GasFeeCap }
+func (t *PQTx) value() *big.Int              { return t.Value }
+func (t *PQEnrollTx) value() *big.Int        { return new(big.Int) }
+func (t *PQTx) nonce() uint64                { return t.Nonce }
+func (t *PQEnrollTx) nonce() uint64          { return t.Nonce }
+func (t *PQTx) to() *common.Address          { return &t.To }
+
+// Enrollment has no EVM frame, and must never be reported as CREATE.
+func (t *PQEnrollTx) to() *common.Address { return &common.Address{} }
+func pqEffective(dst, fee, tip, base *big.Int) *big.Int {
+	if base == nil {
+		return dst.Set(fee)
+	}
+	dst.Sub(fee, base)
+	if dst.Cmp(tip) > 0 {
+		dst.Set(tip)
+	}
+	return dst.Add(dst, base)
+}
+func (t *PQTx) effectiveGasPrice(dst, base *big.Int) *big.Int {
+	return pqEffective(dst, t.GasFeeCap, t.GasTipCap, base)
+}
+func (t *PQEnrollTx) effectiveGasPrice(dst, base *big.Int) *big.Int {
+	return pqEffective(dst, t.GasFeeCap, t.GasTipCap, base)
+}
+func (t *PQTx) rawSignatureValues() (v, r, s *big.Int) {
+	return new(big.Int), new(big.Int), new(big.Int)
+}
+func (t *PQEnrollTx) rawSignatureValues() (v, r, s *big.Int) { return t.V, t.R, t.S }
+func (t *PQTx) setSignatureValues(chainID, v, r, s *big.Int) { t.ChainID = new(big.Int).Set(chainID) }
+func (t *PQEnrollTx) setSignatureValues(chainID, v, r, s *big.Int) {
+	t.ChainID, t.V, t.R, t.S = chainID, v, r, s
+}
+func (t *PQTx) encode(b *bytes.Buffer) error       { return rlp.Encode(b, t) }
+func (t *PQEnrollTx) encode(b *bytes.Buffer) error { return rlp.Encode(b, t) }
+func (t *PQTx) decode(input []byte) error {
+	if e := rlp.DecodeBytes(input, t); e != nil {
+		return e
+	}
+	return t.validateShape()
+}
+func (t *PQEnrollTx) decode(input []byte) error {
+	if e := rlp.DecodeBytes(input, t); e != nil {
+		return e
+	}
+	return t.validateShape()
+}
+func (t *PQTx) sigHash(chainID *big.Int) common.Hash {
+	c := *t
+	c.ChainID = chainID
+	c.Signature = nil
+	return prefixedRlpHash(PQTxType, &c)
+}
+func (t *PQEnrollTx) sigHash(chainID *big.Int) common.Hash {
+	return prefixedRlpHash(PQEnrollTxType, []any{chainID, t.Nonce, t.GasTipCap, t.GasFeeCap, t.Gas, t.AlgID, t.PublicKey, t.PoPSignature})
+}
+func (t *PQTx) SigningHash() common.Hash       { return t.sigHash(t.ChainID) }
+func (t *PQEnrollTx) SigningHash() common.Hash { return t.sigHash(t.ChainID) }
+func (t *PQEnrollTx) Sender() (common.Address, error) {
+	if t.V == nil || t.V.Sign() < 0 || t.V.BitLen() > 1 || !crypto.ValidateSignatureValues(byte(t.V.Uint64()), t.R, t.S, true) {
+		return common.Address{}, ErrInvalidSig
+	}
+	return recoverPlain(t.SigningHash(), t.R, t.S, new(big.Int).Add(t.V, big.NewInt(27)), true)
+}
+func (tx *Transaction) AsPQTx() (*PQTx, bool) { t, ok := tx.inner.(*PQTx); return t, ok }
+func (tx *Transaction) AsPQEnroll() (*PQEnrollTx, bool) {
+	t, ok := tx.inner.(*PQEnrollTx)
+	return t, ok
+}
+func (tx *Transaction) IsPQResearch() bool {
+	return tx.Type() == PQTxType || tx.Type() == PQEnrollTxType || tx.Type() == PQMigrateTxType || tx.Type() == PQBatchTxType
+}
