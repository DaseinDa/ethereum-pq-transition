+func mode0Env(t *testing.T, ownCoinbase bool) (*types.Transaction, *state.StateDB, *vm.EVM, *types.Header) {
+	t.Helper()
+	pqHistoricalProfile(t)
+	dir := os.Getenv("PQ_MODE0_FIXTURES")
+	if dir == "" || os.Getenv("PQ_FULL_VERIFIER_PATH") == "" {
+		t.Fatal("PQ_MODE0_FIXTURES and PQ_FULL_VERIFIER_PATH required; no mock/skip fallback")
+	}
+	t.Setenv("RISC0_DEV_MODE", "0")
+	b, err := os.ReadFile(filepath.Join(dir, "config.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var f mode0FixtureConfig
+	if err = json.Unmarshal(b, &f); err != nil {
+		t.Fatal(err)
+	}
+	raw, err := os.ReadFile(filepath.Join(dir, "mode0.bin"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	tx := new(types.Transaction)
+	if err = tx.UnmarshalBinary(raw); err != nil {
+		t.Fatal(err)
+	}
+	again, err := tx.MarshalBinary()
+	if err != nil || !bytes.Equal(raw, again) {
+		t.Fatal("mode0 canonical bytes changed")
+	}
+	if tx.Gas() > params.MaxTxGas {
+		t.Skip("historical Composite carrier exceeds standard gas cap; not current execution evidence")
+	}
+	p, ok := tx.AsPQMigrate()
+	if !ok || p.FeeMode != 0 || p.SponsorOption != nil || p.LaneAuthOption != nil || p.ProofCarrier.Route != 0 || p.MigrationNonce != 0 {
+		t.Fatal("expected unsponsored Route A nonce-zero mode0 fixture")
+	}
+	if len(p.PublicInputs()) != 198 || common.Hash(sha256.Sum256(p.PublicInputs())) != mode0Hash(t, f.PI, "PI SHA-256") {
+		t.Fatal("complete fixed PI mismatch")
+	}
+	if p.Expiry < 3600 || f.Sunset <= p.Expiry || f.Lifetime < 3600 {
+		t.Fatal("fixture time configuration")
+	}
+	cfg := *params.AllDevChainProtocolChanges
+	cfg.ChainID = new(big.Int).Set(p.ChainID)
+	cfg.AmsterdamTime, cfg.BogotaTime, cfg.UBTTime = nil, nil, nil
+	cfg.PQMigrate = &params.PQMigrateConfig{T0: 0, T: p.Expiry - 3600, W: 31536000,
+		ReceivingTime: 0, MaxPayloadBytes: 131072, Registry: common.HexToAddress(f.Registry), FactRegistry: common.HexToAddress(f.FactRegistry),
+		FullResearch: &params.PQFullResearchConfig{Version: p.VerifierVersion, Activation: 0, Sunset: f.Sunset, ProofLifetime: f.Lifetime,
+			MaxProofBytes: 2 << 20, MaxTxBytes: 3 << 20, TxGasCap: params.MaxTxGas, VerifyGas: 5500000,
+			ImageID: mode0Hash(t, f.Image, "ImageID"), GuestSHA: mode0Hash(t, f.Guest, "guest SHA-256"), VerifierSHA: mode0Hash(t, f.Worker, "worker SHA-256")}}
+	if cfg.PQMigrate.Registry == (common.Address{}) || cfg.PQMigrate.FactRegistry == (common.Address{}) {
+		t.Fatal("fixed Registry addresses missing")
+	}
+	if err = cfg.CheckConfigForkOrder(); err != nil {
+		t.Fatal(err)
+	}
+	if err = CheckPQFullVerifierConfig(cfg.PQMigrate.FullResearch); err != nil {
+		t.Fatal(err)
+	}
+	s, err := state.New(types.EmptyRootHash, state.NewDatabaseForTesting())
+	if err != nil {
+		t.Fatal(err)
+	}
+	s.SetCode(cfg.PQMigrate.Registry, []byte{0}, tracing.CodeChangeUnspecified)
+	s.SetNonce(cfg.PQMigrate.Registry, 1, tracing.NonceChangeUnspecified)
+	s.SetBalance(p.LegacyAddress, uint256.NewInt(2000000000000000000), tracing.BalanceChangeUnspecified)
+	s.SetNonce(p.LegacyAddress, 9234, tracing.NonceChangeUnspecified)
+	coinbase := common.HexToAddress("900")
+	if ownCoinbase {
+		coinbase = p.LegacyAddress
+	}
+	h := &types.Header{Number: big.NewInt(1), Time: cfg.PQMigrate.T, GasLimit: 120000000, BaseFee: big.NewInt(1000000000), Difficulty: new(big.Int), Coinbase: coinbase}
+	random := common.Hash{}
+	evm := vm.NewEVM(vm.BlockContext{CanTransfer: CanTransfer, Transfer: Transfer, GetHash: func(uint64) common.Hash { return common.Hash{} }, Coinbase: coinbase,
+		BlockNumber: h.Number, Time: h.Time, Difficulty: h.Difficulty, BaseFee: h.BaseFee, GasLimit: h.GasLimit, Random: &random}, s, &cfg, vm.Config{})
+	t.Cleanup(evm.Release)
+	return tx, s, evm, h
+}
+
+func mode0Edit(tx *types.Transaction, edit func(*types.PQMigrateTx)) *types.Transaction {
+	p, _ := tx.AsPQMigrate()
+	owned := types.NewTx(p)
+	m, _ := owned.AsPQMigrate()
+	edit(m)
+	return types.NewTx(m)
+}
+
+func mode0Reject(t *testing.T, tx *types.Transaction, s *state.StateDB, evm *vm.EVM, h *types.Header, gp *GasPool, want string) error {
+	t.Helper()
+	root, gas, logs := s.IntermediateRoot(evm.GetRules()), *gp.Snapshot(), len(s.Logs())
+	s.SetTxContext(tx.Hash(), 0, 1)
+	rc, _, err := ApplyTransaction(context.Background(), evm, gp, s, h, tx)
+	if err == nil || !strings.Contains(err.Error(), want) {
+		t.Fatalf("want %s, got %v", want, err)
+	}
+	if rc != nil || s.IntermediateRoot(evm.GetRules()) != root || *gp.Snapshot() != gas || len(s.Logs()) != logs {
+		t.Fatal("rejected mode0 changed state, gas, receipt or logs")
+	}
+	t.Logf("%s; state/gas/logs unchanged", err)
+	return err
+}
+
+func TestPQMode0ActualFullSettlement(t *testing.T) {
+	for _, ownCoinbase := range []bool{false, true} {
+		t.Run(map[bool]string{false: "separate_coinbase_cap_and_balance_equality", true: "owner_coinbase_below_cap"}[ownCoinbase], func(t *testing.T) {
+			tx, s, evm, h := mode0Env(t, ownCoinbase)
+			p, _ := tx.AsPQMigrate()
+			gross := new(big.Int).Mul(new(big.Int).SetUint64(p.Gas), p.GasFeeCap)
+			if gross.Cmp(p.MaxAccountFee) != 0 {
+				t.Fatal("fixture must exercise exact cap equality")
+			}
+			if ownCoinbase {
+				tx = mode0Edit(tx, func(m *types.PQMigrateTx) { m.GasFeeCap = new(big.Int).Add(h.BaseFee, m.GasTipCap) })
+				p, _ = tx.AsPQMigrate()
+				gross.Mul(new(big.Int).SetUint64(p.Gas), p.GasFeeCap)
+				if gross.Cmp(p.MaxAccountFee) >= 0 {
+					t.Fatal("below-cap fixture")
+				}
+			}
+			s.SetBalance(p.LegacyAddress, uint256.MustFromBig(gross), tracing.BalanceChangeUnspecified)
+			s.SetCode(p.LegacyAddress, types.AddressToDelegation(common.HexToAddress("901")), tracing.CodeChangeUnspecified)
+			before := new(big.Int).Set(gross)
+			gp := NewGasPool(h.GasLimit)
+			rc := pqApply(t, s, evm, h, gp, tx, 0)
+			price := new(big.Int).Add(h.BaseFee, p.GasTipCap)
+			if price.Cmp(p.GasFeeCap) > 0 {
+				price.Set(p.GasFeeCap)
+			}
+			if ownCoinbase {
+				price.Set(h.BaseFee)
+			}
+			want := new(big.Int).Sub(before, new(big.Int).Mul(new(big.Int).SetUint64(rc.GasUsed), price))
+			r := ReadPQRecord(s, evm.ChainConfig().PQMigrate.Registry, p.LegacyAddress)
+			if rc.Status != 1 || rc.GasUsed != gp.Used() || rc.CumulativeGasUsed != gp.Used() || s.GetBalance(p.LegacyAddress).CmpBig(want) != 0 || s.GetNonce(p.LegacyAddress) != 9234 || len(s.GetCode(p.LegacyAddress)) != 0 || r.Mode != 2 || r.MigrationNonce != 1 || r.Commit != p.PQPKCommit || r.EnrolledAt != 0 {
+				t.Fatal("mode0 fee/nonce/code/Registry transition")
+			}
+			if len(rc.Logs) != 1 || len(rc.Logs[0].Data) != 160 || rc.Logs[0].Data[95] != 1 || rc.Logs[0].Data[127] != 0 || rc.Logs[0].Data[159] != 0 {
+				t.Fatal("Migrated receipt")
+			}
+			mode0Reject(t, tx, s, evm, h, NewGasPool(h.GasLimit), "WRONG_MIGRATION_NONCE")
+			t.Logf("actual Full accepted mode0, proofBytes=%d, gas=%d, payer=legacy, ordinaryNonce=9234 unchanged, no sponsor account/signature", len(p.ProofCarrier.Proof), rc.GasUsed)
+		})
+	}
+}
+
+func TestPQMode0FeeAndStatePrechecks(t *testing.T) {
+	cases := []struct {
+		name, want string
+		edit       func(*types.PQMigrateTx, *state.StateDB, *vm.EVM)
+	}{
+		{"cap_exceeded", "FEE_CAP_EXCEEDED", func(p *types.PQMigrateTx, s *state.StateDB, evm *vm.EVM) { p.Gas++ }},
+		{"balance_short_one_wei", "INSUFFICIENT_FEE_BALANCE", func(p *types.PQMigrateTx, s *state.StateDB, evm *vm.EVM) {
+			need := new(big.Int).Mul(new(big.Int).SetUint64(p.Gas), p.GasFeeCap)
+			need.Sub(need, big.NewInt(1))
+			s.SetBalance(p.LegacyAddress, uint256.MustFromBig(need), tracing.BalanceChangeUnspecified)
+		}},
+		{"uint256_liability_overflow", "FEE_CAP_EXCEEDED", func(p *types.PQMigrateTx, s *state.StateDB, evm *vm.EVM) {
+			p.GasFeeCap = new(big.Int).Sub(new(big.Int).Lsh(big.NewInt(1), 256), big.NewInt(1))
+		}},
+		{"wrong_migration_nonce", "WRONG_MIGRATION_NONCE", func(p *types.PQMigrateTx, s *state.StateDB, evm *vm.EVM) { p.MigrationNonce++ }},
+		{"exhausted_migration_nonce", "WRONG_MIGRATION_NONCE", func(p *types.PQMigrateTx, s *state.StateDB, evm *vm.EVM) {
+			p.MigrationNonce = math.MaxUint64
+			writePQRecord(s, evm.ChainConfig().PQMigrate.Registry, p.LegacyAddress, PQRecord{Mode: 2, AlgID: 1, MigrationNonce: math.MaxUint64, Commit: p.PQPKCommit})
+		}},
+		{"mode_requires_external_payer", "NON_CANONICAL_ENCODING", func(p *types.PQMigrateTx, s *state.StateDB, evm *vm.EVM) { p.FeeMode = 2 }},
+		{"mode0_forbids_sponsor", "NON_CANONICAL_ENCODING", func(p *types.PQMigrateTx, s *state.StateDB, evm *vm.EVM) {
+			p.SponsorOption = &types.PQMigrationSponsor{Sponsor: common.HexToAddress("902"), ValidUntil: p.Expiry}
+		}},
+		{"intrinsic_too_low", "intrinsic gas too low", func(p *types.PQMigrateTx, s *state.StateDB, evm *vm.EVM) { p.Gas = 21000 }},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			tx, s, evm, h := mode0Env(t, false)
+			tx = mode0Edit(tx, func(p *types.PQMigrateTx) { tc.edit(p, s, evm) })
+			err := mode0Reject(t, tx, s, evm, h, NewGasPool(h.GasLimit), tc.want)
+			if errors.Is(err, ErrPQFullUnavailable) {
+				t.Fatal("local failure is not a negative-vector result")
+			}
+			t.Log("precheck rejection; not claimed as a Full proof verification")
+		})
+	}
+}
+
+func TestPQMode0ActualFullRejectsChangedBindingAndProof(t *testing.T) {
+	for _, mutatePI := range []bool{false, true} {
+		t.Run(map[bool]string{false: "damaged_receipt", true: "changed_committed_key"}[mutatePI], func(t *testing.T) {
+			tx, s, evm, h := mode0Env(t, false)
+			tx = mode0Edit(tx, func(p *types.PQMigrateTx) {
+				if mutatePI {
+					p.PQPKCommit[0] ^= 1
+				} else {
+					p.ProofCarrier.Proof[len(p.ProofCarrier.Proof)-1] ^= 1
+				}
+			})
+			err := mode0Reject(t, tx, s, evm, h, NewGasPool(h.GasLimit), "INVALID_PROOF")
+			if !errors.Is(err, ErrPQInvalidFullProof) || errors.Is(err, ErrPQFullUnavailable) {
+				t.Fatal("must be determinate actual Full rejection")
+			}
+		})
+	}
+}
+
+func TestPQMode0WorkerUnavailableAtomic(t *testing.T) {
+	tx, s, evm, h := mode0Env(t, false)
+	t.Setenv("PQ_FULL_VERIFIER_PATH", filepath.Join(t.TempDir(), "missing-worker"))
+	err := mode0Reject(t, tx, s, evm, h, NewGasPool(h.GasLimit), "PQ_FULL_VERIFIER_UNAVAILABLE")
+	if !errors.Is(err, ErrPQFullUnavailable) || errors.Is(err, ErrPQInvalidFullProof) {
+		t.Fatal("worker outage classification")
+	}
+}
+
+func TestPQMode0ActualFullNoSponsorVerificationGas(t *testing.T) {
+	tx, s, evm, h := mode0Env(t, false)
+	p, _ := tx.AsPQMigrate()
+	// A component-only gas schedule makes execution cost exceed the calldata
+	// floor. This exposes an accidental sponsor verification surcharge, which
+	// the ordinary research profile's floor would otherwise hide.
+	evm.ChainConfig().PQMigrate.FullResearch.VerifyGas = 30000000
+	var tokens uint64
+	for _, b := range p.ProofCarrier.Proof {
+		if b == 0 {
+			tokens++
+		} else {
+			tokens += 4
+		}
+	}
+	want := uint64(21000+30000000+44200) + 4*tokens
+	if want <= 21000+10*tokens || want > p.Gas {
+		t.Fatal("gas probe must exceed calldata floor and fit the fixed owner cap")
+	}
+	rc := pqApply(t, s, evm, h, NewGasPool(h.GasLimit), tx, 0)
+	if rc.GasUsed != want {
+		t.Fatalf("self-pay has no ML-DSA verification: gas=%d want=%d; PQSignatureGas=%d", rc.GasUsed, want, PQSignatureGas)
+	}
+	t.Logf("actual Full, component-only VerifyGas=30000000, no sponsor verification surcharge; gas=%d", rc.GasUsed)
+}
+
+func TestPQMode0AdmissionCannotAuthorizeChangedState(t *testing.T) {
+	tx, s, evm, h := mode0Env(t, false)
+	p, _ := tx.AsPQMigrate()
+	if err := ValidatePQMigrateForPool(tx, s.Copy(), h, evm.ChainConfig()); err != nil {
+		t.Fatal(err)
+	}
+	s.SetBalance(p.LegacyAddress, uint256.NewInt(1), tracing.BalanceChangeUnspecified)
+	mode0Reject(t, tx, s, evm, h, NewGasPool(h.GasLimit), "INSUFFICIENT_FEE_BALANCE")
+}
+
+func TestPQMode0ActualFullBlockGasAtomic(t *testing.T) {
+	tx, s, evm, h := mode0Env(t, false)
+	err := mode0Reject(t, tx, s, evm, h, NewGasPool(tx.Gas()-1), "gas limit reached")
+	if !errors.Is(err, ErrGasLimitReached) {
+		t.Fatal(err)
+	}
+}
diff --git a/core/pq_native.go b/core/pq_native.go
new file mode 100644
index 0000000000000000000000000000000000000000..b7c26dfd245c3c13d38c02ca3d92d07e14fd1e2a
--- /dev/null
+++ b/core/pq_native.go
@@ -0,0 +1,86 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package core
+
+import (
+	"crypto/sha256"
+	"encoding/json"
+	"fmt"
+	"time"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/log"
+	"github.com/ethereum/go-ethereum/params"
+)
+
+// The ABI implementation fixes the RISC Zero verification algorithm, ImageID,
+// successful claim, control root, hash/field/FRI parameters and receipt type.
+// The declaration digest identifies these rules; no binary SHA is a predicate.
+type pqNativeIdentity struct {
+	AlgorithmDigest            string `json:"native_algorithm_digest"`
+	AlgorithmDocumentCanonical bool   `json:"algorithm_document_canonical"`
+	AlgorithmDigestHash        string `json:"native_algorithm_digest_hash"`
+	ImageID                    string `json:"image_id"`
+	GuestSHA                   string `json:"guest_sha256"`
+	DevMode                    bool   `json:"dev_mode"`
+	Groth16                    bool   `json:"groth16"`
+}
+
+// pqNativeLibrary is the linked verifier library: its identity declaration and
+// its verification entry point. Only package tests replace it, to stand in for
+// the library where no proof exists; nothing else assigns it.
+var pqNativeLibrary = struct {
+	identity func() (string, bool)
+	verify   func(proof, pi []byte) int
+}{pqNativeIdentityJSON, pqNativeVerify}
+
+func checkPQNativeConfig(c *params.PQFullResearchConfig) error {
+	if err := c.ValidateBackend(); err != nil {
+		return fmt.Errorf("%w: %v", ErrPQFullUnavailable, err)
+	}
+	if c.ImageID != params.PQSuccinctImageID {
+		return fmt.Errorf("%w: native ImageID mismatch", ErrPQFullUnavailable)
+	}
+	raw, available := pqNativeLibrary.identity()
+	if !available {
+		return fmt.Errorf("%w: native verifier not linked (requires CGO_ENABLED=1 and pq_native)", ErrPQFullUnavailable)
+	}
+	return checkPQNativeIdentity(c, raw)
+}
+
+// checkPQNativeIdentity is the start-up check of spec section 22.3 rule 3: the
+// linked library must declare the Keccak-256 of a canonical algorithm document,
+// equal to the configured digest. A mismatch is a local fault, never a verdict.
+func checkPQNativeIdentity(c *params.PQFullResearchConfig, raw string) error {
+	var id pqNativeIdentity
+	if err := json.Unmarshal([]byte(raw), &id); err != nil {
+		return fmt.Errorf("%w: native identity decode: %v", ErrPQFullUnavailable, err)
+	}
+	if !id.AlgorithmDocumentCanonical || id.AlgorithmDigestHash != "keccak256" ||
+		common.HexToHash(id.AlgorithmDigest) != c.NativeAlgorithmDigest ||
+		common.HexToHash(id.ImageID) != c.ImageID || common.HexToHash(id.GuestSHA) != c.GuestSHA ||
+		id.DevMode || id.Groth16 {
+		return fmt.Errorf("%w: native algorithm/guest identity mismatch", ErrPQFullUnavailable)
+	}
+	return nil
+}
+
+func verifyPQNative(c *params.PQFullResearchConfig, pi, proof []byte) error {
+	if len(pi) != 198 || len(proof) == 0 || uint64(len(proof)) > params.PQSuccinctMaxProofBytes {
+		return fmt.Errorf("%w: native receipt or PI length", ErrPQInvalidFullProof)
+	}
+	started := time.Now()
+	status := pqNativeLibrary.verify(proof, pi)
+	ph, rh := common.Hash(sha256.Sum256(pi)), common.Hash(sha256.Sum256(proof))
+	switch status {
+	case 0:
+		log.Info("PQ_FULL_NATIVE_ACCEPT", "pi", ph, "proof", rh, "verifyElapsed", time.Since(started), "backend", c.Backend)
+		return nil
+	case 1:
+		log.Info("PQ_FULL_NATIVE_REJECT", "pi", ph, "proof", rh, "verifyElapsed", time.Since(started))
+		return fmt.Errorf("%w: native Succinct verification rejected", ErrPQInvalidFullProof)
+	default:
+		return fmt.Errorf("%w: native ABI status %d", ErrPQFullUnavailable, status)
+	}
+}
