+// pqL2Msg is one eth message as the receiving end read it off the wire.
+type pqL2Msg struct {
+	code  uint64
+	size  uint32
+	kinds []byte
+	sizes []uint32
+	txs   []common.Hash // announced, requested or delivered hashes
+}
+
+// pqL2Wire records every message read through it (the payload is passed on
+// unchanged), so the test sees announce, request and response on the wire.
+type pqL2Wire struct {
+	p2p.MsgReadWriter
+	version uint
+	lock    sync.Mutex
+	msgs    []pqL2Msg
+}
+
+func (w *pqL2Wire) ReadMsg() (p2p.Msg, error) {
+	msg, err := w.MsgReadWriter.ReadMsg()
+	if err != nil {
+		return msg, err
+	}
+	data, err := io.ReadAll(msg.Payload)
+	if err != nil {
+		return msg, err
+	}
+	msg.Payload = bytes.NewReader(data)
+	rec := pqL2Msg{code: msg.Code, size: msg.Size}
+	switch msg.Code {
+	case eth.NewPooledTransactionHashesMsg:
+		if w.version >= eth.ETH72 {
+			var ann eth.NewPooledTransactionHashesPacket72
+			if rlp.DecodeBytes(data, &ann) == nil {
+				rec.kinds, rec.sizes, rec.txs = ann.Types, ann.Sizes, ann.Hashes
+			}
+		} else {
+			var ann eth.NewPooledTransactionHashesPacket71
+			if rlp.DecodeBytes(data, &ann) == nil {
+				rec.kinds, rec.sizes, rec.txs = ann.Types, ann.Sizes, ann.Hashes
+			}
+		}
+	case eth.GetPooledTransactionsMsg:
+		var req eth.GetPooledTransactionsPacket
+		if rlp.DecodeBytes(data, &req) == nil {
+			rec.txs = req.GetPooledTransactionsRequest
+		}
+	case eth.PooledTransactionsMsg:
+		var res eth.PooledTransactionsPacket
+		if rlp.DecodeBytes(data, &res) == nil {
+			if items, err := res.List.Items(); err == nil {
+				for _, tx := range items {
+					rec.txs = append(rec.txs, tx.Hash())
+				}
+			}
+		}
+	case eth.TransactionsMsg:
+		var bcast eth.TransactionsPacket
+		if rlp.DecodeBytes(data, &bcast) == nil {
+			if items, err := bcast.Items(); err == nil {
+				for _, tx := range items {
+					rec.txs = append(rec.txs, tx.Hash())
+				}
+			}
+		}
+	}
+	w.lock.Lock()
+	w.msgs = append(w.msgs, rec)
+	w.lock.Unlock()
+	return msg, nil
+}
+
+// find returns the recorded messages of a code that mention hash.
+func (w *pqL2Wire) find(code uint64, hash common.Hash) []pqL2Msg {
+	w.lock.Lock()
+	defer w.lock.Unlock()
+	var out []pqL2Msg
+	for _, m := range w.msgs {
+		for _, h := range m.txs {
+			if m.code == code && h == hash {
+				out = append(out, m)
+				break
+			}
+		}
+	}
+	return out
+}
