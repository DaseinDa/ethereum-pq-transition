+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+// Research v1.7.3 enrollment and PQ execution. Only ML-DSA-44 / Fusaka are enabled.
+package core
+
+import (
+	"bytes"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"math"
+	"math/big"
+
+	"github.com/cloudflare/circl/sign/mldsa/mldsa44"
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core/state"
+	"github.com/ethereum/go-ethereum/core/tracing"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/core/vm"
+	"github.com/ethereum/go-ethereum/crypto"
+	"github.com/ethereum/go-ethereum/params"
+)
+
+const PQSignatureGas uint64 = 50000
+const PQRegistryFirstWriteGas uint64 = 44200
+
+// Both LEGACY words are zero. The first word becomes nonzero; a computed-key
+// commitment is not forbidden from being zero, in which case its write is a
+// cold unchanged-value SSTORE (2200), not a first nonzero write (22100).
+func pqFirstRegistryWriteGas(commit common.Hash) uint64 {
+	if commit == (common.Hash{}) {
+		return 22100 + 2200
+	}
+	return PQRegistryFirstWriteGas
+}
+
+var ErrECDSADisabled = errors.New("ECDSA_DISABLED")
+
+// ValidatePQTransactionTime enforces the time-only part of R1 before sender
+// recovery. The pre-T account-specific rule still requires the recovered owner.
+func ValidatePQTransactionTime(c *params.ChainConfig, timestamp uint64, tx *types.Transaction) error {
+	if c == nil || c.PQMigrate == nil || timestamp < c.PQMigrate.T0 || timestamp < c.PQMigrate.T {
+		return nil
+	}
+	if tx.Type() <= types.SetCodeTxType {
+		return ErrECDSADisabled
+	}
+	if tx.Type() == types.PQEnrollTxType {
+		return errors.New("ENROLL_AFTER_FORK")
+	}
+	return nil
+}
+
+type PQRecord struct {
+	Mode           uint8       `json:"mode"`
+	AlgID          uint8       `json:"algId"`
+	EnrolledAt     uint64      `json:"enrolledAt"`
+	MigrationNonce uint64      `json:"migrationNonce"`
+	Commit         common.Hash `json:"pqPkCommit"`
+}
+
+func PQRecordSlots(a common.Address) (common.Hash, common.Hash) {
+	var b [64]byte
+	copy(b[12:32], a[:])
+	s := crypto.Keccak256Hash(b[:])
+	n := new(big.Int).Add(s.Big(), big.NewInt(1))
+	return s, common.BigToHash(n)
+}
+func ReadPQRecord(s vm.StateDB, registry, a common.Address) PQRecord {
+	k, k1 := PQRecordSlots(a)
+	w := s.GetState(registry, k)
+	return PQRecord{w[31], w[30], binary.BigEndian.Uint64(w[22:30]), binary.BigEndian.Uint64(w[14:22]), s.GetState(registry, k1)}
+}
+func writePQRecord(s vm.StateDB, registry, a common.Address, r PQRecord) {
+	k, k1 := PQRecordSlots(a)
+	var w common.Hash
+	w[31] = r.Mode
+	w[30] = r.AlgID
+	binary.BigEndian.PutUint64(w[22:30], r.EnrolledAt)
+	binary.BigEndian.PutUint64(w[14:22], r.MigrationNonce)
+	s.SetState(registry, k, w)
+	s.SetState(registry, k1, r.Commit)
+}
+func pqWarm(s vm.StateDB, registry, a common.Address, both bool) {
+	k, k1 := PQRecordSlots(a)
+	s.AddSlotToAccessList(registry, k)
+	if both {
+		s.AddSlotToAccessList(registry, k1)
+	}
+}
+func PQKeyCommit(alg uint8, pk []byte) common.Hash { return crypto.Keccak256Hash([]byte{alg}, pk) }
+func PQActivated(s vm.StateDB, c *params.PQMigrateConfig, a common.Address) bool {
+	r := ReadPQRecord(s, c.Registry, a)
+	b := s.GetCode(a)
+	return r.Mode != 0 && r.AlgID == 1 && len(b) == 3+mldsa44.PublicKeySize && b[0] == 0xef && b[1] == 1 && b[2] == r.AlgID && PQKeyCommit(r.AlgID, b[3:]) == r.Commit
+}
+func PQECDSADead(s vm.StateDB, c *params.PQMigrateConfig, a common.Address, t uint64) bool {
+	if c == nil || t < c.T0 {
+		return false
+	}
+	if t >= c.T {
+		return true
+	}
+	k, _ := PQRecordSlots(a)
+	return s.GetState(c.Registry, k)[31] != 0
+}
+
+// VerifyPQMigrationSignature is no pool call site, so it leaves the pool's
+// negative cache alone: no lookup, no entry and no epoch change.
+func VerifyPQMigrationSignature(pk []byte, tag string, digest common.Hash, sig []byte) bool {
+	return verifyPQMigrationSignatureUncached(pk, tag, digest, sig)
+}
+
+func verifyPQMigrationSignatureUncached(pk []byte, tag string, digest common.Hash, sig []byte) bool {
+	if len(pk) != mldsa44.PublicKeySize || len(sig) != mldsa44.SignatureSize {
+		return false
+	}
+	var p mldsa44.PublicKey
+	if p.UnmarshalBinary(pk) != nil {
+		return false
+	}
+	msg := append([]byte(tag), digest[:]...)
+	return mldsa44.Verify(&p, msg, []byte(tag), sig)
+}
+func PQEnrollmentDigest(chainID *big.Int, a common.Address, nonce uint64, alg uint8, pk []byte) common.Hash {
+	b := append([]byte("PQ-ENROLL"), common.LeftPadBytes(chainID.Bytes(), 32)...)
+	b = append(b, a[:]...)
+	b = binary.BigEndian.AppendUint64(b, nonce)
+	b = append(b, alg)
+	b = append(b, pk...)
+	return crypto.Keccak256Hash(b)
+}
+
+type pqExecution struct {
+	enroll, activate, native bool
+	publicKey                []byte
+	record                   PQRecord
+	extraGas                 uint64
+	calldata                 []byte
+}
+
+// ValidatePQTransaction shares the stateful acceptance predicate with execution.
+// Pool callers use a disposable state and checkNonce=false to permit gap queues.
+// Ordinary ECDSA transactions only run R1 here; their other checks stay upstream.
+func ValidatePQTransaction(s *state.StateDB, c *params.ChainConfig, h *types.Header, tx *types.Transaction, checkNonce bool) error {
+	return ValidatePQTransactionWithSignatureCheck(s, c, h, tx, checkNonce, verifyPQMigrationSignatureAt)
+}
+
+// ValidatePQTransactionWithSignatureCheck allows a pool-local cache of the pure
+// signature predicate. Every state, fee, nonce and gas check still runs. Block
+// construction and import call validatePQ with the uncached verifier directly.
+func ValidatePQTransactionWithSignatureCheck(s *state.StateDB, c *params.ChainConfig, h *types.Header, tx *types.Transaction, checkNonce bool, checkSig PQSignatureCheck) error {
+	if checkSig == nil {
+		checkSig = verifyPQMigrationSignatureAt
+	}
+	if err := ValidatePQTransactionTime(c, h.Time, tx); err != nil {
+		return err
+	}
+	if tx.Type() == types.PQMigrateTxType {
+		return ValidatePQMigrateForPool(tx, s, h, c)
+	}
+	from, e := types.Sender(types.MakeSigner(c, h.Number, h.Time), tx)
+	if e != nil {
+		return e
+	}
+	if !tx.IsPQResearch() {
+		if PQECDSADead(s, c.PQMigrate, from, h.Time) {
+			return ErrECDSADisabled
+		}
+		return nil
+	}
+	_, e = validatePQ(s, c, h, tx, from, checkNonce, checkSig)
+	return e
+}
+
+// ValidatePQHeldTransactionAuthority rechecks only authority for an already
+// admitted 0x7c. Upstream pool reset handles nonce and affordability separately.
+// Reads do not alter state or access warmth, so no per-transaction copy is needed.
+func ValidatePQHeldTransactionAuthority(s *state.StateDB, c *params.ChainConfig, h *types.Header, tx *types.Transaction, checkSig PQSignatureCheck) error {
+	if err := ValidatePQTransactionTime(c, h.Time, tx); err != nil {
+		return err
+	}
+	if err := s.Error(); err != nil {
+		return WrapPQStateUnavailable(err)
+	}
+	pq, ok := tx.AsPQTx()
+	if !ok {
+		return ErrTxTypeNotSupported
+	}
+	if c.PQMigrate == nil || h.Time < c.PQMigrate.T0 {
+		return errors.New("FORK_NOT_ACTIVE")
+	}
+	if c.IsAmsterdam(h.Number, h.Time) || c.IsEIP4762(h.Number, h.Time) {
+		return errors.New("PQ_RESEARCH_UNSUPPORTED_FORK")
+	}
+	if pq.ChainID.Cmp(c.ChainID) != 0 {
+		return types.ErrInvalidChainId
+	}
+	r, code := ReadPQRecord(s, c.PQMigrate.Registry, pq.From), s.GetCode(pq.From)
+	p, err := pqTransactionAuthority(s, c.PQMigrate, pq, pq.From, r, code)
+	if stateErr := s.Error(); stateErr != nil {
+		return WrapPQStateUnavailable(stateErr)
+	}
+	if err != nil {
+		return err
+	}
+	if checkSig == nil {
+		checkSig = verifyPQMigrationSignatureAt
+	}
+	if !checkSig(c, h, p.publicKey, "ETH-PQ-TX/v1", pq.SigningHash(), pq.Signature) {
+		return errors.New("BAD_PQ_SIG")
+	}
+	return nil
+}
+
+// pqTransactionAuthority selects the currently authorized key and activation
+// plan. It deliberately excludes nonce, fee, balance and gas checks.
+func pqTransactionAuthority(s vm.StateDB, cfg *params.PQMigrateConfig, pq *types.PQTx, from common.Address, r PQRecord, code []byte) (*pqExecution, error) {
+	p := &pqExecution{}
+	if pq.AlgID != 1 || len(pq.Signature) != mldsa44.SignatureSize {
+		return nil, errors.New("BAD_PQ_SIG")
+	}
+	if r.Mode != 0 && PQActivated(s, cfg, from) {
+		if len(pq.PublicKey) != 0 || pq.AlgID != r.AlgID {
+			return nil, errors.New("BAD_PQ_SIG")
+		}
+		p.publicKey = code[3:]
+	} else if r.Mode != 0 && len(code) == 0 {
+		if len(pq.PublicKey) != 1 || len(pq.PublicKey[0]) != mldsa44.PublicKeySize || pq.AlgID != r.AlgID || PQKeyCommit(pq.AlgID, pq.PublicKey[0]) != r.Commit {
+			return nil, errors.New("BAD_ACTIVATION")
+		}
+		p.activate = true
+		p.publicKey = pq.PublicKey[0]
+	} else if r.Mode == 0 && len(code) == 0 && s.GetNonce(from) == 0 && len(pq.PublicKey) == 1 && len(pq.PublicKey[0]) == mldsa44.PublicKeySize {
+		expected := common.BytesToAddress(crypto.Keccak256([]byte("PQ-ADDR"), []byte{pq.AlgID}, pq.PublicKey[0])[12:])
+		if expected != from {
+			return nil, errors.New("NOT_PQ_ACCOUNT")
+		}
+		if r != (PQRecord{}) {
+			return nil, errors.New("BAD_REGISTRY_STATE")
+		}
+		p.activate = true
+		p.native = true
+		p.publicKey = pq.PublicKey[0]
+		p.record = PQRecord{3, pq.AlgID, 0, 1, PQKeyCommit(pq.AlgID, p.publicKey)}
+	} else {
+		return nil, errors.New("NOT_PQ_ACCOUNT")
+	}
+	return p, nil
+}
+
+func validatePQ(s vm.StateDB, c *params.ChainConfig, h *types.Header, tx *types.Transaction, from common.Address, checkNonce bool, checkSig pqSignatureCheck) (*pqExecution, error) {
+	cfg := c.PQMigrate
+	if cfg == nil || h.Time < cfg.T0 {
+		return nil, errors.New("FORK_NOT_ACTIVE")
+	}
+	if c.IsAmsterdam(h.Number, h.Time) || c.IsEIP4762(h.Number, h.Time) {
+		return nil, errors.New("PQ_RESEARCH_UNSUPPORTED_FORK")
+	}
+	if tx.ChainId().Cmp(c.ChainID) != 0 {
+		return nil, types.ErrInvalidChainId
+	}
+	if tx.Gas() > params.MaxTxGas {
+		return nil, ErrGasLimitTooHigh
+	}
+	p := &pqExecution{}
+	r := ReadPQRecord(s, cfg.Registry, from)
+	code := s.GetCode(from)
+	var sig []byte
+	var tag string
+	var digest common.Hash
+	if en, ok := tx.AsPQEnroll(); ok {
+		if h.Time >= cfg.T {
+			return nil, errors.New("ENROLL_AFTER_FORK")
+		}
+		if en.AlgID != 1 || len(en.PublicKey) != mldsa44.PublicKeySize || len(en.PoPSignature) != mldsa44.SignatureSize {
+			return nil, errors.New("BAD_POP")
+		}
+		if _, delegated := types.ParseDelegation(code); len(code) > 0 && !delegated {
+			return nil, ErrSenderNoEOA
+		}
+		if r.Mode != 0 {
+			return nil, errors.New("ALREADY_MIGRATED")
+		}
+		// LEGACY records must have both zero slots in this research configuration.
+		if r != (PQRecord{}) {
+			return nil, errors.New("BAD_REGISTRY_STATE")
+		}
+		p.enroll = true
+		p.publicKey = en.PublicKey
+		p.extraGas = PQSignatureGas + pqFirstRegistryWriteGas(PQKeyCommit(en.AlgID, en.PublicKey))
+		p.calldata = append(common.CopyBytes(en.PublicKey), en.PoPSignature...)
+		p.record = PQRecord{1, en.AlgID, h.Time, 1, PQKeyCommit(en.AlgID, en.PublicKey)}
+		sig = en.PoPSignature
+		tag = "ETH-PQ-ENROLL-POP/v1"
+		digest = PQEnrollmentDigest(c.ChainID, from, en.Nonce, en.AlgID, en.PublicKey)
+	} else if pq, ok := tx.AsPQTx(); ok {
+		var err error
+		p, err = pqTransactionAuthority(s, cfg, pq, from, r, code)
+		if err != nil {
+			return nil, err
+		}
+		p.extraGas = PQSignatureGas
+		if p.activate {
+			p.extraGas += 200 * uint64(3+len(p.publicKey))
+		}
+		if p.native {
+			p.extraGas += pqFirstRegistryWriteGas(p.record.Commit)
+		}
+		p.calldata = append(common.CopyBytes(pq.Data), pq.Signature...)
+		if len(pq.PublicKey) == 1 {
+			p.calldata = append(p.calldata, pq.PublicKey[0]...)
+		}
+		sig = pq.Signature
+		tag = "ETH-PQ-TX/v1"
+		digest = pq.SigningHash()
+	} else {
+		return nil, ErrTxTypeNotSupported
+	}
+	n := s.GetNonce(from)
+	if tx.Nonce() < n {
+		return nil, ErrNonceTooLow
+	}
+	if checkNonce && tx.Nonce() > n {
+		return nil, ErrNonceTooHigh
+	}
+	if tx.Nonce() == math.MaxUint64 {
+		return nil, ErrNonceMax
+	}
+	if tx.GasFeeCap().BitLen() > 256 || tx.GasTipCap().BitLen() > 256 {
+		return nil, ErrFeeCapVeryHigh
+	}
+	if tx.GasTipCap().Cmp(tx.GasFeeCap()) > 0 {
+		return nil, ErrTipAboveFeeCap
+	}
+	if h.BaseFee != nil && tx.GasFeeCap().Cmp(h.BaseFee) < 0 {
+		return nil, ErrFeeCapTooLow
+	}
+	need := new(big.Int).Mul(new(big.Int).SetUint64(tx.Gas()), tx.GasFeeCap())
+	need.Add(need, tx.Value())
+	if need.BitLen() > 256 || s.GetBalance(from).CmpBig(need) < 0 {
+		return nil, ErrInsufficientFunds
+	}
+	rules := c.Rules(h.Number, h.Difficulty == nil || h.Difficulty.Sign() == 0, h.Time)
+	intrinsic, e := IntrinsicGas(p.calldata, tx.AccessList(), nil, from, tx.To(), nil, rules)
+	if e != nil {
+		return nil, e
+	}
+	if math.MaxUint64-intrinsic < p.extraGas {
+		return nil, ErrGasUintOverflow
+	}
+	intrinsic += p.extraGas
+	floor, e := FloorDataGas(rules, from, tx.To(), nil, p.calldata, tx.AccessList())
+	if e != nil {
+		return nil, e
+	}
+	if tx.Gas() < max(intrinsic, floor) {
+		return nil, fmt.Errorf("%w: have %d want %d", ErrIntrinsicGas, tx.Gas(), max(intrinsic, floor))
+	}
+	if !checkSig(c, h, p.publicKey, tag, digest, sig) {
+		if p.enroll {
+			return nil, errors.New("BAD_POP")
+		}
+		return nil, errors.New("BAD_PQ_SIG")
+	}
+	return p, nil
+}
+
+func (st *stateTransition) preparePQ(rules params.Rules) error {
+	cfg := st.evm.ChainConfig().PQMigrate
+	if st.msg.PQTransaction != nil && (cfg == nil || st.evm.Context.Time < cfg.T0) {
+		return errors.New("FORK_NOT_ACTIVE")
+	}
+	if cfg == nil || st.evm.Context.Time < cfg.T0 || st.msg.SkipTransactionChecks {
+		return nil
+	}
+	// Prepare once before consensus reads. Repeating it later would erase R1 warmth.
+	st.state.Prepare(rules, st.msg.From, st.evm.Context.Coinbase, st.msg.To, vm.ActivePrecompiles(rules), st.msg.AccessList)
+	st.pqPrepared = true
+	pqWarm(st.state, cfg.Registry, st.msg.From, st.msg.PQTransaction != nil)
+	if st.msg.PQTransaction == nil {
+		if PQECDSADead(st.state, cfg, st.msg.From, st.evm.Context.Time) {
+			return ErrECDSADisabled
+		}
+		return nil
+	}
+	h := &types.Header{Number: st.evm.Context.BlockNumber, Time: st.evm.Context.Time, BaseFee: st.evm.Context.BaseFee, Difficulty: new(big.Int)}
+	p, e := validatePQ(st.state, st.evm.ChainConfig(), h, st.msg.PQTransaction, st.msg.From, true, verifyPQMigrationSignatureInBlock)
+	if e != nil {
+		return e
+	}
+	st.pq = p
+	return nil
+}
+func (st *stateTransition) applyPQWrites() bool {
+	if st.pq == nil {
+		return false
+	}
+	p := st.pq
+	cfg := st.evm.ChainConfig().PQMigrate
+	a := st.msg.From
+	if p.enroll {
+		writePQRecord(st.state, cfg.Registry, a, p.record)
+		st.state.SetCode(a, nil, tracing.CodeChangeUnspecified)
+		data := make([]byte, 96)
+		data[31] = 1
+		copy(data[32:64], p.record.Commit[:])
+		binary.BigEndian.PutUint64(data[88:96], p.record.EnrolledAt)
+		st.state.AddLog(&types.Log{Address: cfg.Registry, Topics: []common.Hash{crypto.Keccak256Hash([]byte("Enrolled(address,uint8,bytes32,uint64)")), common.BytesToHash(a[:])}, Data: data})
