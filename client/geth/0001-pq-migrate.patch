new file mode 100644
index 0000000000000000000000000000000000000000..e86cc19c19414b6dfa860ab88df00a16ab4c05f4
--- /dev/null
+++ b/internal/ethapi/pq_migration_json.go
@@ -0,0 +1,59 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package ethapi
+
+import (
+	"encoding/json"
+
+	"github.com/ethereum/go-ethereum/common/hexutil"
+)
+
+// MarshalJSON preserves the canonical Full schema rather than manufacturing a
+// nonce/ECDSA envelope. The normative RPC from is the declared legacy identity,
+// and sponsor aliases expose the public wire option. They do not authenticate
+// the transaction or affect the canonical signed encoding.
+func (t *RPCTransaction) MarshalJSON() ([]byte, error) {
+	// The RPC server invokes json.Marshaler directly, including typed nils.
+	if t == nil {
+		return []byte("null"), nil
+	}
+	type ordinary RPCTransaction
+	if t.PQMigration == nil {
+		return json.Marshal(ordinary(*t))
+	}
+	raw, err := t.PQMigration.MarshalJSON()
+	if err != nil {
+		return nil, err
+	}
+	var fields map[string]json.RawMessage
+	if err = json.Unmarshal(raw, &fields); err != nil {
+		return nil, err
+	}
+	public := map[string]interface{}{
+		"blockHash": t.BlockHash, "blockNumber": t.BlockNumber,
+		"blockTimestamp": t.BlockTimestamp, "transactionIndex": t.TransactionIndex,
+		"gasPrice": t.GasPrice,
+	}
+	if batch, ok := t.PQMigration.AsPQBatch(); ok {
+		public["from"] = batch.Sponsor
+		public["sponsor"] = batch.Sponsor
+		public["sponsorValidUntil"] = hexutil.Uint64(batch.SponsorValidUntil)
+		public["sponsorSig"] = hexutil.Bytes(batch.SponsorSignature)
+	} else if migration, ok := t.PQMigration.AsPQMigrate(); ok {
+		public["from"] = migration.LegacyAddress
+		if sponsor := migration.Sponsor(); sponsor != nil {
+			public["sponsor"] = sponsor.Sponsor
+			public["sponsorValidUntil"] = hexutil.Uint64(sponsor.ValidUntil)
+			public["sponsorSig"] = hexutil.Bytes(sponsor.Signature)
+		}
+	}
+	for key, value := range public {
+		b, err := json.Marshal(value)
+		if err != nil {
+			return nil, err
+		}
+		fields[key] = b
+	}
+	return json.Marshal(fields)
+}
diff --git a/internal/ethapi/pq_migration_json_test.go b/internal/ethapi/pq_migration_json_test.go
