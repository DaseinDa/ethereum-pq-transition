+func TestPQFullActualNegativeCorpus(t *testing.T) {
+	raw, e := os.ReadFile(filepath.Join(fullTestInputs, "negative-vectors.json"))
+	if e != nil {
+		t.Skip("new real proof negative corpus not available")
+	}
+	var corpus struct {
+		Cases []struct {
+			Name     string `json:"name"`
+			File     string `json:"file"`
+			Expected string `json:"expected_error"`
+			SHA      string `json:"raw_sha256"`
+		} `json:"cases"`
+	}
+	if e = json.Unmarshal(raw, &corpus); e != nil {
+		t.Fatal(e)
+	}
+	s, evm, h := fullEnv(t, common.HexToAddress("900"))
+	for _, v := range corpus.Cases {
+		t.Run(v.Name, func(t *testing.T) {
+			raw, e := os.ReadFile(filepath.Join(fullTestInputs, v.File))
+			if e != nil {
+				t.Fatal(e)
+			}
+			if common.Hash(sha256.Sum256(raw)) != common.HexToHash(v.SHA) {
+				t.Fatal("raw fixture digest changed")
+			}
+			var tx types.Transaction
+			err := tx.UnmarshalBinary(raw)
+			ss := s.Copy()
+			instance := vm.NewEVM(evm.Context, ss, evm.ChainConfig(), vm.Config{})
+			defer instance.Release()
+			before := ss.IntermediateRoot(instance.GetRules())
+			gp := NewGasPool(h.GasLimit)
+			if err == nil {
+				ss.SetTxContext(tx.Hash(), 2, 3)
+				_, _, err = ApplyTransaction(context.Background(), instance, gp, ss, h, &tx)
+			}
+			if err == nil || !strings.Contains(err.Error(), v.Expected) {
+				t.Fatalf("have %v want %s", err, v.Expected)
+			}
+			if ss.IntermediateRoot(instance.GetRules()) != before || gp.Used() != 0 {
+				t.Fatal("rejected transaction changed state or gas")
+			}
+			if v.Expected == "INVALID_PROOF" && !errors.Is(err, ErrPQInvalidFullProof) {
+				t.Fatal("cryptographic rejection lost classification")
+			}
+			if errors.Is(err, ErrPQFullUnavailable) {
+				t.Fatal("local fault must not count as negative proof")
+			}
+			t.Logf("real corpus %s -> %v; state and gas unchanged", v.Name, err)
+		})
+	}
+}
+func TestPQFullActualNonceDelegationAndRecheck(t *testing.T) {
+	if _, e := os.Stat(filepath.Join(fullTestInputs, "migrate.bin")); e != nil {
+		t.Skip("real raw not available")
+	}
+	s, evm, h := fullEnv(t, common.HexToAddress("900"))
+	tx := fullRead(t, "migrate")
+	s.SetNonce(fullLegacy, 9234, tracing.NonceChangeUnspecified)
+	s.SetNonce(fullSponsor, math.MaxUint64, tracing.NonceChangeUnspecified)
+	s.SetCode(fullLegacy, types.AddressToDelegation(fullOther), tracing.CodeChangeUnspecified)
+	if e := ValidatePQMigrateForPool(tx, s.Copy(), h, evm.ChainConfig()); e != nil {
+		t.Fatal(e)
+	}
+	before := s.Copy()
+	rc := pqApply(t, s, evm, h, NewGasPool(h.GasLimit), tx, 2)
+	if s.GetNonce(fullLegacy) != 9234 || s.GetNonce(fullSponsor) != math.MaxUint64 || len(s.GetCode(fullLegacy)) != 0 || rc.Status != 1 {
+		t.Fatal("ordinary nonce mutation or delegation not cleared")
+	}
+	// The earlier real admission does not authorize later changed state.
+	changed := before.Copy()
+	changed.SetBalance(fullSponsor, uint256.NewInt(0), tracing.BalanceChangeUnspecified)
+	instance := vm.NewEVM(evm.Context, changed, evm.ChainConfig(), vm.Config{})
+	defer instance.Release()
+	root := changed.IntermediateRoot(instance.GetRules())
+	gp := NewGasPool(h.GasLimit)
+	changed.SetTxContext(tx.Hash(), 2, 3)
+	if _, _, e := ApplyTransaction(context.Background(), instance, gp, changed, h, tx); e == nil || !strings.Contains(e.Error(), "INSUFFICIENT_FEE_BALANCE") {
+		t.Fatal(e)
+	}
+	if changed.IntermediateRoot(instance.GetRules()) != root || gp.Used() != 0 {
+		t.Fatal("state recheck wrote/charged")
+	}
+	// The block's independent gas budget is also enforced before any payment.
+	unchanged := before.Copy()
+	instance2 := vm.NewEVM(evm.Context, unchanged, evm.ChainConfig(), vm.Config{})
+	defer instance2.Release()
+	root = unchanged.IntermediateRoot(instance2.GetRules())
+	tooSmall := NewGasPool(tx.Gas() - 1)
+	unchanged.SetTxContext(tx.Hash(), 2, 3)
+	if _, _, e := ApplyTransaction(context.Background(), instance2, tooSmall, unchanged, h, tx); !errors.Is(e, ErrGasLimitReached) {
+		t.Fatal(e)
+	}
+	if unchanged.IntermediateRoot(instance2.GetRules()) != root || tooSmall.Used() != 0 {
+		t.Fatal("block gas failure changed state")
+	}
+}
