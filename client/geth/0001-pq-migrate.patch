+++ b/params/pq_state_bridge.go
@@ -0,0 +1,94 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package params
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"errors"
+	"math/big"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/rlp"
+)
+
+// Research-only bridge identity. The original mainnet header is never rewritten.
+const PQBridgeAnchorNumber uint64 = 22974577
+
+var PQBridgeAnchorHash = common.HexToHash("0xe6e4c256069674f7939f82fc808d0cd104210533c83add12d2c33d274fc3c027")
+var PQBridgeAnchorRoot = common.HexToHash("0x9015056bc42f7a02accba1290ef146c67e493fb102444084dec2a5e15eac74b7")
+
+type PQStateBridgeCredit struct {
+	Address            common.Address `json:"address"`
+	Balance            *big.Int       `json:"balance"`
+	AbsenceProofSHA256 common.Hash    `json:"absenceProofSHA256"`
+}
+
+type PQStateBridgeConfig struct {
+	ResearchOnly    bool                  `json:"researchOnly"`
+	AnchorHash      common.Hash           `json:"anchorHash"`
+	AnchorRoot      common.Hash           `json:"anchorRoot"`
+	AnchorNumber    uint64                `json:"anchorNumber"`
+	InitBlock       uint64                `json:"initBlock"`
+	ProfileSHA256   common.Hash           `json:"profileSHA256"`
+	InitDeltaSHA256 common.Hash           `json:"initDeltaSHA256"`
+	Credits         []PQStateBridgeCredit `json:"credits"`
+}
+
+// InitDeltaBytes implements DESIGN.md's canonical RLP; JSON is a reading view.
+func (p *PQStateBridgeConfig) InitDeltaBytes() ([]byte, error) {
+	type entry struct {
+		Address     common.Address
+		ExpectedOld uint64
+		Nonce       uint64
+		Balance     *big.Int
+		StorageRoot common.Hash
+		CodeHash    common.Hash
+		ProofSHA256 common.Hash
+	}
+	entries := make([]entry, len(p.Credits))
+	for i, c := range p.Credits {
+		if c.Balance == nil || c.Balance.Sign() <= 0 || c.Balance.BitLen() > 256 {
+			return nil, errors.New("invalid experimental credit balance")
+		}
+		entries[i] = entry{c.Address, 0, 0, c.Balance, common.HexToHash("0x56e81f171bcc55a6ff8345e692c0f86e5b48e01b996cadc001622fb5e363b421"), common.HexToHash("0xc5d2460186f7233c927e7db2dcc703c0e500b653ca82273b7bfad8045d85a470"), c.AbsenceProofSHA256}
+	}
+	return rlp.EncodeToBytes(struct {
+		Domain  []byte
+		Anchor  common.Hash
+		Root    common.Hash
+		Profile common.Hash
+		Number  uint64
+		Entries []entry
+	}{[]byte("PQ-MIGRATE-LAB-INIT-v1"), p.AnchorHash, p.AnchorRoot, p.ProfileSHA256, p.InitBlock, entries})
+}
+
+func (p *PQStateBridgeConfig) Validate() error {
+	if p == nil {
+		return nil
+	}
+	if !p.ResearchOnly || p.AnchorNumber != PQBridgeAnchorNumber || p.AnchorHash != PQBridgeAnchorHash || p.AnchorRoot != PQBridgeAnchorRoot || p.InitBlock != PQBridgeAnchorNumber+1 || p.ProfileSHA256 == (common.Hash{}) {
+		return errors.New("unsupported PQ state bridge anchor/profile")
+	}
+	if len(p.Credits) == 0 || len(p.Credits) > 16 {
+		return errors.New("PQ bridge requires 1..16 explicit credits")
+	}
+	for i, c := range p.Credits {
+		if c.AbsenceProofSHA256 == (common.Hash{}) || c.Address == (common.Address{}) || c.Address == common.HexToAddress("0x800") || c.Address == common.HexToAddress("0x801") {
+			return errors.New("invalid PQ experimental credit identity")
+		}
+		if i > 0 && bytes.Compare(p.Credits[i-1].Address[:], c.Address[:]) >= 0 {
+			return errors.New("PQ credits must be sorted and unique")
+		}
+	}
+	blob, err := p.InitDeltaBytes()
+	if err != nil {
+		return err
+	}
+	sum := sha256.Sum256(blob)
+	if common.Hash(sum) != p.InitDeltaSHA256 {
+		return errors.New("PQ init delta digest mismatch")
+	}
+	return nil
+}
