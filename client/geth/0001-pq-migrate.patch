+	"github.com/ethereum/go-ethereum/crypto"
+	"github.com/ethereum/go-ethereum/params"
+	"github.com/ethereum/go-ethereum/trie"
+)
+
+func heldRead(t *testing.T, p string) []byte {
+	t.Helper()
+	b, e := os.ReadFile(p)
+	if e != nil {
+		t.Fatal(e)
+	}
+	return b
+}
+func heldSign(t *testing.T, key *mldsa44.PrivateKey, tag string, h common.Hash) []byte {
+	t.Helper()
+	s := make([]byte, mldsa44.SignatureSize)
+	if e := mldsa44.SignTo(key, append([]byte(tag), h[:]...), []byte(tag), false, s); e != nil {
+		t.Fatal(e)
+	}
+	return s
+}
+func TestPQHeldAttackerAfterRealFOverride(t *testing.T) {
+	dir := os.Getenv("PQ_HELD_PROOF_DIR")
+	if dir == "" {
+		t.Skip("requires fresh actual F override fixture; not a proof stub")
+	}
+	proof := heldRead(t, filepath.Join(dir, "f/proof.postcard"))
+	pi, e := hex.DecodeString(strings.TrimSpace(string(heldRead(t, filepath.Join(dir, "statement/pi198.hex")))))
+	if e != nil || len(pi) != 198 {
+		t.Fatal("PI", e)
+	}
+	var g core.Genesis
+	if e = json.Unmarshal(heldRead(t, os.Getenv("PQ_HELD_GENESIS")), &g); e != nil {
+		t.Fatal(e)
+	}
+	now := uint64(time.Now().Unix())
+	g.Timestamp = now - 100
+	g.GasLimit = 44999185
+	g.BaseFee = big.NewInt(params.InitialBaseFee)
+	g.Difficulty = new(big.Int)
+	cfg := g.Config
+	p := cfg.PQMigrate
+	p.T0 = g.Timestamp
+	p.T = now - 65
+	p.ReceivingTime = p.T0
+	p.FullResearch.Activation = p.T0
+	if e = cfg.CheckConfigForkOrder(); e != nil {
+		t.Fatal(e)
+	}
+	if e = core.CheckPQFullVerifierConfig(p.FullResearch); e != nil {
+		t.Fatal(e)
+	}
+	if e = core.VerifyPQFull(p.FullResearch, pi, proof); e != nil {
+		t.Fatal(e)
+	}
+	owner := common.BytesToAddress(pi[64:84])
+	legacyKey, e := crypto.HexToECDSA("1ab42cc412b618bdea3a599e3c9bae199ebf030895b039e9db1e30dafb12b727") // abandon x11 about, m/44'/60'/0'/0/0; PUBLIC TEST ONLY
+	if e != nil || crypto.PubkeyToAddress(legacyKey.PublicKey) != owner {
+		t.Fatal("public vector key/address")
+	}
+	g.Alloc[owner] = types.Account{Balance: new(big.Int).Mul(big.NewInt(2), big.NewInt(params.Ether))}
+	for _, addr := range []common.Address{p.Registry, p.FactRegistry} {
+		g.Alloc[addr] = types.Account{Balance: new(big.Int), Code: []byte{0}, Nonce: 1}
+	}
+	seed := [mldsa44.SeedSize]byte{0xa1}
+	pk, sk := mldsa44.NewKeyFromSeed(&seed)
+	en := &types.PQEnrollTx{ChainID: cfg.ChainID, Nonce: 0, GasTipCap: big.NewInt(params.GWei), GasFeeCap: big.NewInt(10 * params.GWei), Gas: 700000, AlgID: 1, PublicKey: pk.Bytes()}
+	en.PoPSignature = heldSign(t, sk, "ETH-PQ-ENROLL-POP/v1", core.PQEnrollmentDigest(cfg.ChainID, owner, 0, 1, en.PublicKey))
+	h := en.SigningHash()
+	sig, e := crypto.Sign(h[:], legacyKey)
+	if e != nil {
+		t.Fatal(e)
+	}
+	en.R = new(big.Int).SetBytes(sig[:32])
+	en.S = new(big.Int).SetBytes(sig[32:64])
+	en.V = new(big.Int).SetUint64(uint64(sig[64]))
+	recipient := common.HexToAddress("0x7777")
+	pqtx := func(n uint64, activate bool) *types.Transaction {
+		v := &types.PQTx{ChainID: cfg.ChainID, From: owner, Nonce: n, GasTipCap: big.NewInt(params.GWei), GasFeeCap: big.NewInt(10 * params.GWei), Gas: 700000, To: recipient, Value: big.NewInt(1), AlgID: 1}
+		if activate {
+			v.PublicKey = [][]byte{pk.Bytes()}
+		}
+		v.Signature = heldSign(t, sk, "ETH-PQ-TX/v1", v.SigningHash())
+		return types.NewTx(v)
+	}
+	activation, held := pqtx(1, true), pqtx(2, false) // Signed before the override; nonce stays 2 across it.
+	m := &types.PQMigrateTx{ChainID: new(big.Int).SetBytes(pi[:32]), LegacyAddress: owner, MigrationNonce: binary.BigEndian.Uint64(pi[84:92]), AlgID: pi[92], PQPKCommit: common.BytesToHash(pi[93:125]), VerifierVersion: binary.BigEndian.Uint32(pi[125:129]), Expiry: binary.BigEndian.Uint64(pi[129:137]), MaxAccountFee: new(big.Int).SetBytes(pi[137:169]), FeeMode: pi[169], FeeSponsor: common.BytesToAddress(pi[170:190]), FeeAuthUntil: binary.BigEndian.Uint64(pi[190:198]), GasTipCap: big.NewInt(params.GWei), GasFeeCap: big.NewInt(5 * params.GWei), Gas: 16000000, ProofCarrier: types.PQMigrationCarrier{Proof: proof}}
+	if !bytes.Equal(m.PublicInputs(), pi) || m.MigrationNonce != 1 || m.FeeMode > 1 || m.Expiry < now || m.Expiry-now > 604800 {
+		t.Fatal("override statement/time")
+	}
+	override := types.NewTx(m)
+	var sponsorActivation *types.Transaction
+	if m.FeeMode == 1 {
+		override = new(types.Transaction)
+		if e = override.UnmarshalBinary(heldRead(t, filepath.Join(dir, "mode1.bin"))); e != nil {
+			t.Fatal(e)
+		}
+		decoded, ok := override.AsPQMigrate()
+		if !ok || !bytes.Equal(decoded.PublicInputs(), pi) || !bytes.Equal(decoded.ProofCarrier.Proof, proof) {
+			t.Fatal("reused carrier/PI/proof mismatch")
+		}
+		m = decoded
+		sponsorActivation = new(types.Transaction)
+		if e = sponsorActivation.UnmarshalBinary(heldRead(t, filepath.Join(dir, "sponsor-activate.bin"))); e != nil {
+			t.Fatal(e)
+		}
+		sp, ok := sponsorActivation.AsPQTx()
+		if !ok || sp.From != m.FeeSponsor {
+			t.Fatal("sponsor fixture")
+		}
+		g.Alloc[sp.From] = types.Account{Balance: new(big.Int).Mul(big.NewInt(5), big.NewInt(params.Ether))}
+	}
+	eng := beacon.New(ethash.NewFaker())
+	genDB, commonBlocks, _ := core.GenerateChainWithGenesis(&g, eng, 2, func(i int, b *core.BlockGen) {
+		if i == 0 {
+			if sponsorActivation != nil {
+				b.AddTx(sponsorActivation)
+			}
+			b.AddTx(types.NewTx(en))
+		} else {
+			b.AddTx(activation)
+		}
+	})
+	defer genDB.Close()
+	// Old branch proves the held signature was executable before the override.
+	oldBranch, _ := core.GenerateChain(cfg, commonBlocks[1], eng, genDB, 1, func(i int, b *core.BlockGen) { b.AddTx(held) })
+	newBranch, _ := core.GenerateChain(cfg, commonBlocks[1], eng, genDB, 2, func(i int, b *core.BlockGen) {
+		if i == 0 {
+			b.OffsetTime(10)
+			b.AddTx(override)
+		}
+	})
+	newChain := func() *core.BlockChain {
+		c, e := core.NewBlockChain(rawdb.NewMemoryDatabase(), &g, eng, &core.BlockChainConfig{ArchiveMode: true})
+		if e != nil {
+			t.Fatal(e)
+		}
+		t.Cleanup(c.Stop)
+		return c
+	}
+	insert := func(c *core.BlockChain, bs []*types.Block) {
+		if _, e := c.InsertChain(bs); e != nil {
+			t.Fatal(e)
+		}
+		if _, e := c.SetCanonical(bs[len(bs)-1]); e != nil {
+			t.Fatal(e)
+		}
+	}
+	a := newChain()
+	insert(a, commonBlocks)
+	lcfg := legacypool.DefaultConfig
+	lcfg.Journal = ""
+	lp := legacypool.New(lcfg, a)
+	tp, e := txpool.New(lcfg.PriceLimit, a, []txpool.SubPool{lp})
+	if e != nil {
+		t.Fatal(e)
+	}
+	t.Cleanup(func() { tp.Close() })
+	if e = tp.Add([]*types.Transaction{held}, true)[0]; e != nil {
+		t.Fatal("positive pre-override admission", e)
+	}
+	insert(a, oldBranch)
+	if e = tp.Sync(); e != nil {
+		t.Fatal(e)
+	}
+	if lp.Get(held.Hash()) != nil {
+		t.Fatal("mined old-branch transaction still pending")
+	}
+	// Fork replacement drives the actual reset/discard/reinject path.
+	insert(a, newBranch)
+	if e = tp.Sync(); e != nil {
+		t.Fatal(e)
+	}
+	lp.Reset(oldBranch[0].Header(), newBranch[1].Header())
+	s, e := a.State()
+	if e != nil {
+		t.Fatal(e)
+	}
+	r := core.ReadPQRecord(s, p.Registry, owner)
+	if r.Mode != 2 || r.MigrationNonce != 2 || r.Commit != m.PQPKCommit || s.GetNonce(owner) != 2 || len(s.GetCode(owner)) != 0 {
+		t.Fatal("actual override transition")
+	}
+	if lp.Get(held.Hash()) != nil {
+		t.Fatal("reinjected obsolete key transaction")
+	}
+	t.Log("reinjection: rejected after actual branch switch; pending/queued lookup empty")
+	if e = tp.Add([]*types.Transaction{held}, true)[0]; e == nil || !strings.Contains(e.Error(), "BAD_ACTIVATION") {
+		t.Fatal("post-override admission", e)
+	}
+	t.Log("admission: BAD_ACTIVATION at unchanged ordinary nonce 2")
+	// Exercise miner.commitTransaction directly, even if an adversarial/stale queue hands it the bytes.
+	backend := &testWorkerBackend{chain: a, txPool: tp, genesis: &g}
+	mc := testConfig
+	mc.GasCeil = g.GasLimit
+	w := New(backend, mc, eng)
+	zero := common.Hash{}
+	env, e := w.prepareWork(context.Background(), &generateParams{parentHash: newBranch[1].Hash(), timestamp: newBranch[1].Time() + 10, forceTime: true, withdrawals: types.Withdrawals{}, beaconRoot: &zero}, false)
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer env.discard()
+	root := env.state.IntermediateRoot(env.evm.GetRules())
+	gas := env.gasPool.Gas()
+	env.state.SetTxContext(held.Hash(), 0, 1)
+	if e = w.commitTransaction(context.Background(), env, held); e == nil || !strings.Contains(e.Error(), "BAD_ACTIVATION") {
+		t.Fatal("builder", e)
+	}
+	if len(env.txs) != 0 || len(env.receipts) != 0 || env.gasPool.Gas() != gas || env.state.IntermediateRoot(env.evm.GetRules()) != root {
+		t.Fatal("builder mutated rejected candidate")
+	}
+	t.Log("builder: BAD_ACTIVATION; state, gas and included transactions unchanged")
+	// A malicious producer can still put bytes in a body: independent B must reject before root comparison.
+	blank, _ := core.GenerateChain(cfg, newBranch[1], eng, genDB, 1, nil)
+	bad := types.NewBlock(blank[0].Header(), &types.Body{Transactions: []*types.Transaction{held}, Withdrawals: blank[0].Withdrawals()}, nil, trie.NewStackTrie(nil))
+	b := newChain()
+	insert(b, commonBlocks)
+	insert(b, newBranch)
+	before := b.CurrentBlock().Hash()
+	if _, e = b.InsertChain([]*types.Block{bad}); e == nil || !strings.Contains(e.Error(), "BAD_ACTIVATION") {
+		t.Fatal("B import", e)
+	}
+	if b.CurrentBlock().Hash() != before {
+		t.Fatal("B advanced on invalid payload")
+	}
+	t.Log("B import: BAD_ACTIVATION; canonical head unchanged")
+	t.Logf("real F %d B sha256=%x; PI=%x; held=%s; override=%s; canonical=%s; oldbranch=%s; all signatures public-test ML-DSA-44; component forkchoice, not a Lean consensus run", len(proof), sha256.Sum256(proof), sha256.Sum256(pi), held.Hash(), override.Hash(), before, oldBranch[0].Hash())
+	if out := os.Getenv("PQ_HELD_OUT"); out != "" {
+		raw, _ := held.MarshalBinary()
+		if e = os.WriteFile(filepath.Join(out, "held.bin"), raw, 0600); e != nil {
+			t.Fatal(e)
+		}
+		raw, _ = override.MarshalBinary()
+		if e = os.WriteFile(filepath.Join(out, "override.bin"), raw, 0600); e != nil {
+			t.Fatal(e)
+		}
+		v := map[string]any{"status": "PASS", "cases": []string{"positive-before-override", "admission", "reinjection", "builder", "B-import"}, "proofBytes": len(proof), "proofSHA256": fmt.Sprintf("%x", sha256.Sum256(proof)), "held": held.Hash(), "override": override.Hash(), "canonical": before, "tier": "real native F + geth component; explicit component forkchoice, no Lean claim"}
+		raw, _ = json.MarshalIndent(v, "", "  ")
+		if e = os.WriteFile(filepath.Join(out, "RESULT.json"), append(raw, '\n'), 0600); e != nil {
+			t.Fatal(e)
+		}
+	}
+}
diff --git a/miner/pq_migration.go b/miner/pq_migration.go
new file mode 100644
index 0000000000000000000000000000000000000000..f4f6d03fe6ffde5c2713f48f661405e7df8672f0
--- /dev/null
+++ b/miner/pq_migration.go
@@ -0,0 +1,86 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package miner
+
+import (
+	"context"
+	"errors"
+	"sort"
+	"sync/atomic"
+	"time"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core"
+	"github.com/ethereum/go-ethereum/core/txpool"
+	"github.com/ethereum/go-ethereum/crypto"
+	"github.com/ethereum/go-ethereum/log"
+)
+
+// commitPQMigrations consumes a genuinely nonce-less queue. Every attempted
+// transaction calls ApplyTransaction on the current candidate overlay and
+// timestamp. No admission decision substitutes for execution. In particular,
+// the second version of an already included migration fails its current nonce
+// gate and is popped without affecting the first version or an ordinary queue.
+func (miner *Miner) commitPQMigrations(ctx context.Context, env *environment,
+	items map[common.Address][]*txpool.LazyTransaction, interrupt *atomic.Int32) error {
+	var queue []*txpool.LazyTransaction
+	for _, list := range items {
+		queue = append(queue, list...)
+	}
+	sort.SliceStable(queue, func(i, j int) bool {
+		a, b := queue[i], queue[j]
+		aFee, bFee := a.GasTipCap.ToBig(), b.GasTipCap.ToBig()
+		if env.header.BaseFee != nil {
+			aMargin := a.GasFeeCap.ToBig()
+			aMargin.Sub(aMargin, env.header.BaseFee)
+			if aMargin.Cmp(aFee) < 0 {
+				aFee = aMargin
+			}
+			bMargin := b.GasFeeCap.ToBig()
+			bMargin.Sub(bMargin, env.header.BaseFee)
+			if bMargin.Cmp(bFee) < 0 {
+				bFee = bMargin
+			}
+		}
+		if cmp := aFee.Cmp(bFee); cmp != 0 {
+			return cmp > 0
+		}
+		if !a.Time.Equal(b.Time) {
+			return a.Time.Before(b.Time)
+		}
+		return a.Hash.Hex() < b.Hash.Hex()
+	})
+	for _, lazy := range queue {
+		if interrupt != nil && interrupt.Load() != commitInterruptNone {
+			return signalToErr(interrupt.Load())
+		}
+		if lazy.Gas > env.gasPool.Gas() {
+			continue
+		}
+		tx := lazy.Resolve()
+		if tx == nil || !env.txFitsSize(tx) {
+			continue
+		}
+		m, ok := tx.AsPQMigrate()
+		if !ok {
+			continue
+		}
+		log.Info("PQ_BUILD_SELECT", "context", "candidate", "txhash", tx.Hash(), "piHash", crypto.Keccak256Hash(m.PublicInputs()), "proofHash", crypto.Keccak256Hash(m.ProofCarrier.Proof), "candidateTime", env.header.Time, "position", env.tcount, "legacy", m.LegacyAddress)
+		env.state.SetTxContext(tx.Hash(), env.tcount, uint32(env.tcount+1))
+		start := time.Now()
+		err := miner.commitTransaction(ctx, env, tx)
+		if err != nil {
+			if errors.Is(err, core.ErrPQFullUnavailable) {
+				log.Error("PQ_BUILD_UNAVAILABLE", "context", "candidate", "txhash", tx.Hash(), "candidateTime", env.header.Time, "elapsed", time.Since(start), "err", err)
+				return err
+			}
+			// Candidate exclusion is not a peer ban and not a consensus proof
+			// verdict. In particular, local verifier failures remain retryable.
+			log.Warn("PQ_BUILD_POP", "context", "candidate", "txhash", tx.Hash(), "candidateTime", env.header.Time, "elapsed", time.Since(start), "err", err)
+			continue
+		}
+		log.Info("PQ_BUILD_INCLUDED", "context", "candidate", "txhash", tx.Hash(), "candidateTime", env.header.Time, "position", env.tcount-1, "elapsed", time.Since(start))
+	}
+	return nil
+}
diff --git a/miner/pq_research_order.go b/miner/pq_research_order.go
new file mode 100644
index 0000000000000000000000000000000000000000..6273bd834e6150235d4592691ec6e7696057fad4
--- /dev/null
+++ b/miner/pq_research_order.go
@@ -0,0 +1,135 @@
+//go:build pq_research_order
+
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+// Research-only adversarial ordering hook, version 2 (rows 10 and 11 of the R-1 matrix,
+// spec section 23.3): the attacker operates the builder and chooses what its block attempts and
+// in which order (threat model, spec l. 44-48). It exists only in a binary built with
+// -tags pq_research_order and acts only while PQ_RESEARCH_ORDER_FILE names an existing
+// file holding a JSON list. Default: off.
+//
+// A list entry is either a transaction hash (row 10: a transaction this node's pool
+// holds) or an object {"raw": "0x..."} (row 11: a transaction from the attacker's own
+// order flow that no pool admitted, for example an ECDSA envelope signed after T with an
+// exposed key). The entries are attempted first, in the listed order, each through the
+// stock commitTransaction (core.ApplyTransaction against the candidate's in-payload state
+// and header.timestamp); a transaction that fails is popped, as in the stock lanes; the
+// stock lanes then fill the rest with the attempted hashes removed, so nothing is
+// attempted twice. No validity rule, no pool admission rule and no import path is touched.
+// Version 1 (row 10) accepted hash entries only; for them the behaviour is unchanged.
+package miner
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"os"
+	"sync/atomic"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/common/hexutil"
+	"github.com/ethereum/go-ethereum/core"
+	"github.com/ethereum/go-ethereum/core/txpool"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/log"
+)
+
+type pqResearchEntry struct {
+	hash common.Hash
+	raw  hexutil.Bytes
+}
+
+func (e *pqResearchEntry) UnmarshalJSON(b []byte) error {
+	if len(b) > 0 && b[0] == '"' {
+		return json.Unmarshal(b, &e.hash)
+	}
+	var obj struct {
+		Raw hexutil.Bytes `json:"raw"`
+	}
+	if err := json.Unmarshal(b, &obj); err != nil {
+		return err
+	}
+	if len(obj.Raw) == 0 {
+		return errors.New("entry without raw transaction")
+	}
+	e.raw = obj.Raw
+	return nil
+}
+
+func (miner *Miner) pqResearchOrderPrefix(ctx context.Context, env *environment, interrupt *atomic.Int32) (map[common.Hash]struct{}, error) {
+	path := os.Getenv("PQ_RESEARCH_ORDER_FILE")
+	if path == "" {
+		return nil, nil
+	}
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		return nil, nil // no file: the stock order
+	}
+	var entries []pqResearchEntry
+	if err := json.Unmarshal(raw, &entries); err != nil {
+		log.Warn("PQ_RESEARCH_ORDER_BAD_FILE", "path", path, "err", err)
+		return nil, nil
+	}
+	attempted := make(map[common.Hash]struct{}, len(entries))
+	for i, entry := range entries {
+		if interrupt != nil && interrupt.Load() != commitInterruptNone {
+			return attempted, signalToErr(interrupt.Load())
+		}
+		var (
+			tx     *types.Transaction
+			source = "pool"
+		)
+		if entry.raw != nil {
+			source = "raw"
+			tx = new(types.Transaction)
+			if err := tx.UnmarshalBinary(entry.raw); err != nil {
+				log.Warn("PQ_RESEARCH_ORDER_BAD_RAW", "listIndex", i, "candidateTime", env.header.Time, "number", env.header.Number, "err", err)
+				continue
+			}
+		} else {
+			tx = miner.txpool.Get(entry.hash)
+			if tx == nil {
+				log.Info("PQ_RESEARCH_ORDER_ABSENT", "listIndex", i, "txhash", entry.hash, "candidateTime", env.header.Time, "number", env.header.Number)
+				continue
+			}
+		}
+		h := tx.Hash()
+		attempted[h] = struct{}{}
+		if tx.Type() == types.BlobTxType || tx.Gas() > env.gasPool.Gas() || !env.txFitsSize(tx) {
+			log.Warn("PQ_RESEARCH_ORDER_POP", "listIndex", i, "source", source, "txhash", h, "type", tx.Type(), "candidateTime", env.header.Time, "number", env.header.Number, "position", env.tcount, "err", "blob type or does not fit the candidate")
+			continue
+		}
+		env.state.SetTxContext(h, env.tcount, uint32(env.tcount+1))
+		if err := miner.commitTransaction(ctx, env, tx); err != nil {
+			if errors.Is(err, core.ErrPQFullUnavailable) {
+				log.Error("PQ_BUILD_UNAVAILABLE", "context", "research-order", "txhash", h, "candidateTime", env.header.Time, "err", err)
+				return attempted, err
+			}
+			log.Warn("PQ_RESEARCH_ORDER_POP", "listIndex", i, "source", source, "txhash", h, "type", tx.Type(), "candidateTime", env.header.Time, "number", env.header.Number, "position", env.tcount, "err", err)
+			continue
+		}
+		log.Info("PQ_RESEARCH_ORDER_INCLUDED", "listIndex", i, "source", source, "txhash", h, "type", tx.Type(), "candidateTime", env.header.Time, "number", env.header.Number, "position", env.tcount-1)
+	}
+	return attempted, nil
+}
+
+// pqResearchSkip removes the hashes the hook already attempted from a stock lane.
+func pqResearchSkip(pending map[common.Address][]*txpool.LazyTransaction, skip map[common.Hash]struct{}) {
+	if len(skip) == 0 {
+		return
+	}
+	for addr, list := range pending {
+		kept := list[:0:0]
+		for _, ltx := range list {
+			if _, ok := skip[ltx.Hash]; !ok {
+				kept = append(kept, ltx)
+			}
+		}
+		if len(kept) == 0 {
+			delete(pending, addr)
+		} else {
+			pending[addr] = kept
+		}
+	}
+}
