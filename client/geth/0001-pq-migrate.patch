new file mode 100644
index 0000000000000000000000000000000000000000..a183f2435375455a9248e1dab805c3225d9f27f2
--- /dev/null
+++ b/core/pq_checkpoint.go
@@ -0,0 +1,230 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package core
+
+import (
+	"crypto/sha256"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"math/big"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core/state"
+	"github.com/ethereum/go-ethereum/core/tracing"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/ethdb"
+	"github.com/ethereum/go-ethereum/params"
+	"github.com/holiman/uint256"
+)
+
+var trustedCheckpointKey = []byte("pq-research-trusted-checkpoint-v1")
+
+// This is a local explicit trust record for one historical anchor, not a claim
+// that sparse state is complete or that local descendants were executed.
+type TrustedCheckpointRecord struct {
+	Schema                   string      `json:"schema"`
+	ResearchOnly             bool        `json:"research_only"`
+	BlockHash                common.Hash `json:"block_hash"`
+	BlockNumber              uint64      `json:"block_number"`
+	StateRoot                common.Hash `json:"state_root"`
+	ProfileSHA256            common.Hash `json:"profile_sha256"`
+	LocalConfigSHA256        common.Hash `json:"local_config_sha256"`
+	BlockSHA256              common.Hash `json:"block_sha256"`
+	WitnessSHA256            common.Hash `json:"witness_sha256"`
+	HistoricalEvidenceSHA256 common.Hash `json:"historical_evidence_sha256"`
+	GenesisHash              common.Hash `json:"genesis_hash"`
+	Reopened                 bool        `json:"reopened"`
+	Sparse                   bool        `json:"sparse"`
+	TrustStatement           string      `json:"trust_statement"`
+}
+
+func (r *TrustedCheckpointRecord) Validate() error {
+	if r == nil || r.Schema != "PQ-TRUSTED-CHECKPOINT-v1" || !r.ResearchOnly || !r.Reopened || !r.Sparse || r.BlockHash != params.PQBridgeAnchorHash || r.BlockNumber != params.PQBridgeAnchorNumber || r.StateRoot != params.PQBridgeAnchorRoot || r.GenesisHash != params.MainnetGenesisHash || r.ProfileSHA256 == (common.Hash{}) || r.LocalConfigSHA256 == (common.Hash{}) || r.BlockSHA256 == (common.Hash{}) || r.WitnessSHA256 == (common.Hash{}) || r.HistoricalEvidenceSHA256 == (common.Hash{}) {
+		return errors.New("invalid research checkpoint record")
+	}
+	return nil
+}
+func WriteTrustedCheckpointRecord(db ethdb.KeyValueWriter, r *TrustedCheckpointRecord) error {
+	if err := r.Validate(); err != nil {
+		return err
+	}
+	b, err := json.Marshal(r)
+	if err != nil {
+		return err
+	}
+	return db.Put(trustedCheckpointKey, b)
+}
+func ReadTrustedCheckpointRecord(db ethdb.KeyValueReader) (*TrustedCheckpointRecord, error) {
+	b, err := db.Get(trustedCheckpointKey)
+	if err != nil {
+		return nil, err
+	}
+	var r TrustedCheckpointRecord
+	if err = json.Unmarshal(b, &r); err != nil {
+		return nil, err
+	}
+	if err = r.Validate(); err != nil {
+		return nil, err
+	}
+	return &r, nil
+}
+func IsTrustedCheckpoint(db ethdb.KeyValueReader, hash common.Hash, number uint64, root common.Hash, profile common.Hash) bool {
+	r, err := ReadTrustedCheckpointRecord(db)
+	return err == nil && r.BlockHash == hash && r.BlockNumber == number && r.StateRoot == root && r.ProfileSHA256 == profile
+}
+func PQBridgeConfigHash(cfg *params.ChainConfig) (common.Hash, error) {
+	b, err := json.Marshal(cfg)
+	if err != nil {
+		return common.Hash{}, err
+	}
+	return common.Hash(sha256.Sum256(b)), nil
+}
+func CheckTrustedCheckpointConfig(db ethdb.KeyValueReader, cfg *params.ChainConfig) error {
+	if cfg == nil || cfg.PQStateBridge == nil {
+		return errors.New("checkpoint requires explicit state bridge configuration")
+	}
+	r, err := ReadTrustedCheckpointRecord(db)
+	if err != nil {
+		return err
+	}
+	h, err := PQBridgeConfigHash(cfg)
+	if err != nil {
+		return err
+	}
+	if h != r.LocalConfigSHA256 || cfg.PQStateBridge.ProfileSHA256 != r.ProfileSHA256 {
+		return errors.New("local chain config differs from durable checkpoint identity")
+	}
+	return nil
+}
+
+// ApplyLabInit is shared by the ordinary builder and importer before system
+// calls. It never edits H, pre-writes migration records, or credits twice after
+// H+1. Reorg branches replay it from the authenticated original parent root.
+func ApplyLabInit(cfg *params.ChainConfig, parentHash common.Hash, number *big.Int, timestamp uint64, s *state.StateDB) (common.Hash, error) {
+	p := cfg.PQStateBridge
+	if p == nil {
+		return common.Hash{}, nil
+	}
+	if err := p.Validate(); err != nil {
+		return common.Hash{}, err
+	}
+	if number == nil || !number.IsUint64() {
+		return common.Hash{}, errors.New("bridge block number overflow")
+	}
+	n := number.Uint64()
+	if n != p.InitBlock {
+		return common.Hash{}, nil
+	}
+	if parentHash != p.AnchorHash {
+		return common.Hash{}, errors.New("lab init has wrong parent hash")
+	}
+	rules := cfg.Rules(number, true, timestamp)
+	before := s.IntermediateRoot(rules)
+	if err := s.Error(); err != nil {
+		return common.Hash{}, fmt.Errorf("lab init prestate unavailable: %w", err)
+	}
+	if before != p.AnchorRoot {
+		return common.Hash{}, errors.New("lab init prestate differs from original mainnet root")
+	}
+	// Credit requires an authenticated absent public-test owner. Native
+	// registry addresses may hold historical ETH; preserve those balances.
+	for _, c := range p.Credits {
+		exists := s.Exist(c.Address)
+		if err := s.Error(); err != nil {
+			return common.Hash{}, fmt.Errorf("lab init absence unavailable for %s: %w", c.Address, err)
+		}
+		if exists {
+			return common.Hash{}, fmt.Errorf("lab init refuses existing credit account %s", c.Address)
+		}
+	}
+	for _, c := range p.Credits {
+		value, overflow := uint256.FromBig(c.Balance)
+		if overflow {
+			return common.Hash{}, errors.New("credit overflow")
+		}
+		s.SetBalance(c.Address, value, tracing.BalanceIncreaseGenesisBalance)
+	}
+	root := s.IntermediateRoot(rules)
+	if err := s.Error(); err != nil {
+		return common.Hash{}, fmt.Errorf("lab init update closure unavailable: %w", err)
+	}
+	return root, nil
+}
+
+// CheckCheckpointHeader deliberately covers exactly H, not H+1 descendants.
+func CheckCheckpointHeader(h *types.Header) error {
+	if h == nil || h.Number == nil || !h.Number.IsUint64() || h.Number.Uint64() != params.PQBridgeAnchorNumber || h.Hash() != params.PQBridgeAnchorHash || h.Root != params.PQBridgeAnchorRoot {
+		return errors.New("header does not match fixed mainnet checkpoint")
+	}
+	return nil
+}
+
+// InstallPQBridgeSystemImages implements adopted spec section 19.9 at this
+// research profile's first post-T0 child. Balances and storage are preserved;
+// no migration binding is written. All conflict reads precede all writes.
+func InstallPQBridgeSystemImages(cfg *params.ChainConfig, number *big.Int, timestamp uint64, s *state.StateDB) error {
+	if cfg.PQStateBridge == nil || number == nil || !number.IsUint64() || number.Uint64() != cfg.PQStateBridge.InitBlock {
+		return nil
+	}
+	if cfg.PQMigrate == nil || timestamp < cfg.PQMigrate.T0 {
+		return errors.New("bridge first child must activate T0")
+	}
+	addresses := []common.Address{cfg.PQMigrate.Registry, cfg.PQMigrate.FactRegistry}
+	for _, a := range addresses {
+		code := s.GetCode(a)
+		storageRoot := s.GetStorageRoot(a)
+		if err := s.Error(); err != nil {
+			return fmt.Errorf("system image prestate unavailable for %s: %w", a, err)
+		}
+		if len(code) != 0 || (storageRoot != (common.Hash{}) && storageRoot != types.EmptyRootHash) {
+			return fmt.Errorf("system image address conflicts with historical code/storage: %s", a)
+		}
+	}
+	for _, a := range addresses {
+		s.SetCode(a, []byte{0}, tracing.CodeChangeUnspecified)
+		s.SetNonce(a, 1, tracing.NonceChangeUnspecified)
+	}
+	return s.Error()
+}
+
+// InstallPQSystemImages is the generic trigger of spec section 19.9 item 4 as
+// section 24.6 rules 1-2 read it. In the transition block of T0 (its parent is
+// earlier than T0 and it is not; never the genesis block) PQ_REGISTRY and then
+// FACT_REGISTRY receive code 0x00 and nonce 1, each unless it already holds
+// code, keeping its balance and storage (section 22.4). No other block tests or
+// installs. The bridge laboratory installs by block number instead.
+func InstallPQSystemImages(cfg *params.ChainConfig, parentTime, timestamp uint64, s *state.StateDB) error {
+	p := cfg.PQMigrate
+	if p == nil || cfg.PQStateBridge != nil || parentTime >= p.T0 || timestamp < p.T0 {
+		return nil
+	}
+	for _, a := range []common.Address{p.Registry, p.FactRegistry} {
+		if len(s.GetCode(a)) != 0 {
+			continue
+		}
+		s.SetCode(a, []byte{0}, tracing.CodeChangeUnspecified)
+		s.SetNonce(a, 1, tracing.NonceChangeUnspecified)
+	}
+	return s.Error()
+}
+
+// ApplyPQPrologue keeps experimental funding (R_lab) separate from the protocol
+// system image transition. Builder and importer share this order. It runs before
+// the EIP-4788 and EIP-2935 system calls rather than after them (section 24.6
+// rule 2): the accounts are distinct, so the state is the same, and R-1 records
+// no block-level access list.
+func ApplyPQPrologue(cfg *params.ChainConfig, parent *types.Header, number *big.Int, timestamp uint64, s *state.StateDB) (common.Hash, error) {
+	root, err := ApplyLabInit(cfg, parent.Hash(), number, timestamp, s)
+	if err != nil {
+		return common.Hash{}, err
+	}
+	if err = InstallPQBridgeSystemImages(cfg, number, timestamp, s); err != nil {
+		return common.Hash{}, err
+	}
+	if err = InstallPQSystemImages(cfg, parent.Time, timestamp, s); err != nil {
+		return common.Hash{}, err
+	}
+	return root, nil
+}
