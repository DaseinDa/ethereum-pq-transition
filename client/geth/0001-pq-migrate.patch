+func bridgeTestImport(t *testing.T, repo, name string) string {
+	t.Helper()
+	path := filepath.Join(repo, "results/state-bridge-impl-20261016/checkpoint/checkpoint-20261018-run2/A-import.command.json")
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var command struct {
+		Argv []string `json:"argv"`
+	}
+	if err = json.Unmarshal(raw, &command); err != nil {
+		t.Fatal(err)
+	}
+	datadir := filepath.Join(t.TempDir(), name)
+	found := false
+	for i, value := range command.Argv {
+		if value == "-datadir" {
+			command.Argv[i+1] = datadir
+			found = true
+		}
+	}
+	if !found {
+		t.Fatal("recorded importer command has no datadir")
+	}
+	if output, err := exec.Command(command.Argv[0], command.Argv[1:]...).CombinedOutput(); err != nil {
+		t.Fatalf("isolated checkpoint import: %v\n%s", err, output)
+	}
+	return datadir
+}
+
+func bridgeTestStart(t *testing.T, datadir string) (*node.Node, *eth.Ethereum) {
+	t.Helper()
+	raw, err := os.ReadFile(filepath.Join(datadir, "override-genesis.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var genesis core.Genesis
+	if err = json.Unmarshal(raw, &genesis); err != nil {
+		t.Fatal(err)
+	}
+	n, err := node.New(&node.Config{Name: "geth", DataDir: datadir,
+		P2P: p2p.Config{NoDiscovery: true, NoDial: true, MaxPeers: 0}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	cfg := ethconfig.Defaults
+	cfg.Genesis = &genesis
+	cfg.SyncMode = ethconfig.FullSync
+	cfg.NetworkId = 13375
+	cfg.StateScheme = rawdb.HashScheme
+	cfg.NoPruning = true
+	cfg.DatabaseCache, cfg.DatabaseHandles = 64, 64
+	cfg.TrieCleanCache, cfg.TrieDirtyCache, cfg.SnapshotCache = 0, 0, 0
+	cfg.Miner.GasCeil = 44999185
+	e, err := eth.New(n, &cfg)
+	if err != nil {
+		n.Close()
+		t.Fatal(err)
+	}
+	if err = n.Start(); err != nil {
+		n.Close()
+		t.Fatal(err)
+	}
+	e.SetSynced()
+	return n, e
+}
+
+func bridgeTestRequiredNode(t *testing.T, repo string, timestamp uint64) (common.Hash, []byte) {
+	t.Helper()
+	files, err := filepath.Glob(filepath.Join(repo, "results/state-bridge-impl-20261016/data/window-20261018-run1/*.response.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := common.BigToHash(new(big.Int).SetUint64(timestamp % 8191))
+	for _, file := range files {
+		raw, err := os.ReadFile(file)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var response struct {
+			Result struct {
+				Address string `json:"address"`
+				Storage []struct {
+					Key   string   `json:"key"`
+					Proof []string `json:"proof"`
+				} `json:"storageProof"`
+			} `json:"result"`
+		}
+		if err = json.Unmarshal(raw, &response); err != nil {
+			t.Fatal(err)
+		}
+		if common.HexToAddress(response.Result.Address) != params.BeaconRootsAddress {
+			continue
+		}
+		for _, slot := range response.Result.Storage {
+			if common.HexToHash(slot.Key) == want && len(slot.Proof) > 0 {
+				blob := common.FromHex(slot.Proof[len(slot.Proof)-1])
+				return crypto.Keccak256Hash(blob), blob
+			}
+		}
+	}
+	t.Fatal("missing pinned RPC proof for first-slot beacon ring slot")
+	return common.Hash{}, nil
+}
