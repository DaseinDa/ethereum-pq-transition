+			var rejected *PQMigrationError
+			if !errors.As(err, &rejected) || rejected.Code != 3 || calls != 0 {
+				t.Fatalf("count %d: error=%v signature calls=%d", count, err, calls)
+			}
+			if err := ValidatePQBatchProof(sign(b), cfg); !errors.As(err, &rejected) || rejected.Code != 3 {
+				t.Fatal("shape did not precede C verifier", err)
+			}
+		})
+	}
+}
