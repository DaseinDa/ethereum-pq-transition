+func TestPQPoolComponentPendingDiskAndNoNonce(t *testing.T) {
+	p, _, calls := componentPool(t)
+	first := componentTx(1, 20, 2, 20)
+	second := componentTx(1, 21, 3, 30)
+	raw, _ := first.MarshalBinary()
+	if err := add(p, first); err != nil {
+		t.Fatal(err)
+	}
+	if err := add(p, second); err != nil {
+		t.Fatal(err)
+	}
+	after, _ := first.MarshalBinary()
+	if !bytes.Equal(raw, after) {
+		t.Fatal("admission mutated caller proof")
+	}
+	if len(p.entries) != 2 || len(p.bodies) != 1 || p.bodies[p.entries[first.Hash()].proofKey].refs != 2 {
+		t.Fatal("version/disk dedup")
+	}
+	if p.Get(first.Hash()).Hash() != first.Hash() {
+		t.Fatal("disk reconstruction")
+	}
+	var decoded types.Transaction
+	if err := rlp.DecodeBytes(p.GetRLP(first.Hash(), 72), &decoded); err != nil || decoded.Hash() != first.Hash() {
+		t.Fatal("P2P RLP reconstruction", err)
+	}
+	items, n := p.Pending(txpool.PendingFilter{OnlyPQ: true})
+	if n != 2 || len(items[addr(1)]) != 2 {
+		t.Fatal("pending versions lost")
+	}
+	_, n = p.Pending(txpool.PendingFilter{ExcludePQ: true})
+	if n != 0 || p.Nonce(addr(20)) != 0 {
+		t.Fatal("ordinary nonce path contaminated")
+	}
+	if *calls != 1 {
+		t.Fatal("same Full relation was not reused across outer payer versions")
+	}
+	if len(NewAPI(p).Content()) != 2 {
+		t.Fatal("dedicated hash-keyed RPC lost version")
+	}
+	t.Log("component only: two payer versions, one disk body, caller bytes retained, nonce-less Pending")
+}
+func TestPQPoolComponentReplacementAtomic(t *testing.T) {
+	p, _, calls := componentPool(t)
+	old := componentTx(1, 20, 2, 20)
+	if err := add(p, old); err != nil {
+		t.Fatal(err)
+	}
+	for _, bad := range []*types.Transaction{componentTx(1, 20, 3, 40), componentTx(1, 20, 4, 39)} {
+		if err := add(p, bad); !errors.Is(err, txpool.ErrReplaceUnderpriced) {
+			t.Fatal(err)
+		}
+	}
+	if *calls != 1 || !p.Has(old.Hash()) {
+		t.Fatal("underpriced replacement verified or removed old")
+	}
+	replacement := componentTx(1, 20, 4, 40)
+	if err := add(p, replacement); err != nil {
+		t.Fatal(err)
+	}
+	if p.Has(old.Hash()) || !p.Has(replacement.Hash()) || len(p.bodies) != 1 {
+		t.Fatal("replacement did not atomically retain body")
+	}
+	p.checkProof = func(*types.Transaction, *params.ChainConfig, string) error {
+		return fmt.Errorf("%w: test", core.ErrPQInvalidFullProof)
+	}
+	bad := changed(componentTx(1, 20, 8, 80), func(m *types.PQMigrateTx) { m.ProofCarrier.Proof = []byte("different invalid proof") })
+	if err := add(p, bad); !errors.Is(err, core.ErrPQInvalidFullProof) {
+		t.Fatal(err)
+	}
+	if !p.Has(replacement.Hash()) || p.Has(bad.Hash()) {
+		t.Fatal("invalid replacement removed good entry")
+	}
+}
+func TestPQPoolComponentVersionProtection(t *testing.T) {
+	p, _, _ := componentPool(t)
