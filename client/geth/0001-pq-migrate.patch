@@ -0,0 +1,89 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package core
+
+// State-gate regression on the current F profile; it does not substitute a proof.
+import (
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core/state"
+	"github.com/ethereum/go-ethereum/core/tracing"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/params"
+	"github.com/holiman/uint256"
+	"math/big"
+	"strings"
+	"testing"
+)
+
+func TestPQPreTLegacyGate(t *testing.T) {
+	for _, open := range []bool{false, true} {
+		cfg := nativeTestChain()
+		cfg.PQMigrate.FullResearch = finalTestProfile()
+		cfg.PQMigrate.T0, cfg.PQMigrate.T = 500, 1000
+		cfg.PQMigrate.LegacySeedProofFromT0 = open
+		s, err := state.New(types.EmptyRootHash, state.NewDatabaseForTesting())
+		if err != nil {
+			t.Fatal(err)
+		}
+		owner := common.HexToAddress("1234")
+		s.SetBalance(owner, uint256.NewInt(2000000000000000000), tracing.BalanceChangeUnspecified)
+		s.SetCode(cfg.PQMigrate.Registry, []byte{0}, tracing.CodeChangeUnspecified)
+		s.SetNonce(cfg.PQMigrate.Registry, 1, tracing.NonceChangeUnspecified)
+		p := &types.PQMigrateTx{ChainID: new(big.Int).SetUint64(params.PQR1ChainID), LegacyAddress: owner, AlgID: 1,
+			PQPKCommit: common.HexToHash("01"), Expiry: 2000, MaxAccountFee: big.NewInt(100000000000000000),
+			GasTipCap: big.NewInt(1), GasFeeCap: big.NewInt(1000000000), Gas: 12000000,
+			VerifierVersion: params.PQFinalVersion, ProofCarrier: types.PQMigrationCarrier{Proof: []byte{1}}}
+		preT := func(want string) string {
+			if open {
+				return ""
+			}
+			return want
+		}
+		cases := []struct {
+			name string
+			time uint64
+			edit func(*state.StateDB, *types.PQMigrateTx)
+			want string
+		}{
+			{"before-T0", 499, nil, "FORK_NOT_ACTIVE"},
+			{"at-T0", 500, nil, preT("FORK_NOT_ACTIVE")},
+			{"before-T", 999, nil, preT("FORK_NOT_ACTIVE")},
+			{"at-T", 1000, nil, ""},
+			{"before-T-delegated", 999, func(s *state.StateDB, p *types.PQMigrateTx) {
+				s.SetCode(owner, types.AddressToDelegation(common.HexToAddress("99")), tracing.CodeChangeUnspecified)
+			}, preT("FORK_NOT_ACTIVE")},
+			{"before-T-contract", 999, func(s *state.StateDB, p *types.PQMigrateTx) {
+				s.SetCode(owner, []byte{0x60}, tracing.CodeChangeUnspecified)
+			}, "NOT_AN_EOA"},
+			{"before-T-already-by-proof", 999, func(s *state.StateDB, p *types.PQMigrateTx) {
+				writePQRecord(s, cfg.PQMigrate.Registry, owner, PQRecord{Mode: 2, AlgID: 1, MigrationNonce: 1, Commit: common.HexToHash("02")})
+				p.MigrationNonce = 1 // Match state to exercise the independent unactivated re-commit gate.
+			}, ""},
+			{"before-T-activated-by-proof", 999, func(s *state.StateDB, p *types.PQMigrateTx) {
+				pk, _ := pqSeedKey(0xa7)
+				writePQRecord(s, cfg.PQMigrate.Registry, owner, PQRecord{Mode: 2, AlgID: 1, MigrationNonce: 1, Commit: PQKeyCommit(1, pk.Bytes())})
+				s.SetCode(owner, append([]byte{0xef, 1, 1}, pk.Bytes()...), tracing.CodeChangeUnspecified)
+				p.MigrationNonce = 1
+			}, "ALREADY_MIGRATED"},
+		}
+		for _, tc := range cases {
+			name := tc.name
+			if open {
+				name += "/open"
+			}
+			t.Run(name, func(t *testing.T) {
+				ss := s.Copy()
+				carrier, _ := types.NewTx(p).AsPQMigrate()
+				if tc.edit != nil {
+					tc.edit(ss, carrier)
+				}
+				h := &types.Header{Number: big.NewInt(1), Time: tc.time, GasLimit: 30000000, BaseFee: big.NewInt(1), Difficulty: new(big.Int)}
+				err := ValidatePQMigrateState(types.NewTx(carrier), ss, h, cfg)
+				if tc.want == "" && err != nil || tc.want != "" && (err == nil || !strings.Contains(err.Error(), tc.want)) {
+					t.Fatalf("have %v want %q", err, tc.want)
+				}
+			})
+		}
+	}
+}
diff --git a/core/pq_r1_e1_genesis_test.go b/core/pq_r1_e1_genesis_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..b89094a55fe5102ca740a6423c06b18c5d33dbcb
--- /dev/null
+++ b/core/pq_r1_e1_genesis_test.go
@@ -0,0 +1,218 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+// Stage r1-genesis-20261028: the genesis of environment E1 of research profile
+// R-1 (spec section 23.2, row environment E1) and R-1's root receipt on it.
+//
+
+package core
+
+import (
+	"encoding/json"
+	"fmt"
+	"math/big"
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/consensus/beacon"
+	"github.com/ethereum/go-ethereum/consensus/ethash"
+	"github.com/ethereum/go-ethereum/core/rawdb"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/params"
+)
+
+// r1E1Genesis reads E1's genesis.json and the genesis block hash that geth init
+// and the consensus-layer genesis report for it.
+func r1E1Genesis(t *testing.T) (*Genesis, common.Hash) {
+	t.Helper()
+	path, hash := os.Getenv("PQ_R1_E1_GENESIS"), os.Getenv("PQ_R1_E1_GENESIS_HASH")
+	if path == "" || hash == "" {
+		t.Skip("requires E1's genesis.json and its genesis block hash")
+	}
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	gspec := new(Genesis)
+	if err := json.Unmarshal(raw, gspec); err != nil {
+		t.Fatal(err)
+	}
+	return gspec, common.HexToHash(hash)
+}
+
+// E1's genesis as the R-1 client reads it: R-1's binding is accepted, the genesis
+// block hash is the one of geth init and of the consensus-layer genesis, Osaka
+// holds from genesis, T0 lies after the genesis block, the test owner is funded,
+// and PQ_REGISTRY holds a balance and no code before T0 (spec section 23.2, rows
+// environment E1 and fork switches and time; section 19.9 item 4, fixture (iv)).
+func TestPQR1E1Genesis(t *testing.T) {
+	gspec, want := r1E1Genesis(t)
+	f, _ := r1RootInputs(t)
+	cfg := gspec.Config
+	if err := cfg.CheckConfigForkOrder(); err != nil {
+		t.Fatal("R-1 binding refused E1's genesis:", err)
+	}
+	if got := gspec.ToBlock().Hash(); got != want {
+		t.Fatalf("genesis block hash %x, geth init and the CL genesis %x", got, want)
+	}
+	p := cfg.PQMigrate
+	if cfg.ChainID.Uint64() != params.PQR1ChainID || p.FullResearch.Version != params.PQR1Version || !cfg.IsOsaka(common.Big0, gspec.Timestamp) {
+		t.Fatal("not R-1's chain id, identifier or Osaka from genesis")
+	}
+	if p.T0 <= gspec.Timestamp || p.T <= p.T0 || p.FullResearch.Activation > p.T0 || p.FullResearch.Sunset != ^uint64(0) {
+		t.Fatalf("timing: genesis %d, T0 %d, T %d, activation %d, sunset %d", gspec.Timestamp, p.T0, p.T, p.FullResearch.Activation, p.FullResearch.Sunset)
+	}
+	// The first block at or after T must lie in the root's window, with 600 s to land it.
+	if p.T < f.Expiry-p.FullResearch.ProofLifetime || p.T+600 > f.Expiry {
+		t.Fatalf("T %d not inside the root's window ending %d", p.T, f.Expiry)
+	}
+	owner := gspec.Alloc[common.HexToAddress(f.LegacyAddress)]
+	fee, _ := new(big.Int).SetString(f.MaxAccountFee, 10)
+	if owner.Balance == nil || owner.Balance.Cmp(fee) < 0 {
+		t.Fatal("the test owner cannot pay a carrier at its fee cap (F-18)")
+	}
+	reg, ok := gspec.Alloc[p.Registry]
+	if !ok || len(reg.Code) != 0 || reg.Nonce != 0 || reg.Balance == nil || reg.Balance.Sign() <= 0 {
+		t.Fatal("PQ_REGISTRY must hold a balance and no code or nonce before T0")
+	}
+	if _, ok := gspec.Alloc[p.FactRegistry]; ok {
+		t.Fatal("FACT_REGISTRY must not be allocated")
+	}
+}
+
+// R-1's root receipt on E1, built and imported in process with the linked R-1
+// library. Blocks come every 10 seconds from E1's genesis (the network's slots are
+// 12 seconds), so block 60 is T0's transition block and block 120 is the first
+// block at T. The mode-0 0x7e with gas_limit 2^24 and max_fee 2 gwei lands in
+// block 120 and is executed; built at T0 - 10, at T - 10 or after expiry, it is
+// refused. Checks 1 to 9 run, at block building and at import.
+func TestPQR1E1Migration(t *testing.T) {
+	gspec, _ := r1E1Genesis(t)
+	f, pi := r1RootInputs(t)
+	rootPath := os.Getenv("PQ_R1_ROOT")
+	if rootPath == "" {
+		t.Skip("requires R-1's root receipt")
+	}
+	if _, linked := pqNativeIdentityJSON(); !linked {
+		t.Skip("requires the native-linked build")
+	}
+	root, err := os.ReadFile(rootPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("PQ_FULL_VERIFIER_PATH", "/nonexistent/no-worker-fallback")
+	cfg, p := gspec.Config, gspec.Config.PQMigrate
+	g := gspec.Timestamp
+	if p.T0 != g+600 || p.T != g+1200 {
+		t.Fatalf("expected T0 = genesis + 600 and T = genesis + 1200, got %d and %d", p.T0-g, p.T-g)
+	}
+	migration := types.NewTx(r1RootCarrier(t, f, cfg, root))
+	if m, _ := migration.AsPQMigrate(); string(m.PublicInputs()) != string(pi) {
+		t.Fatal("the carrier's PI is not R-1's PI")
+	}
+	owner := common.HexToAddress(f.LegacyAddress)
+	engine := beacon.New(ethash.NewFaker())
+
+	// Refused at block building: the type before T0, the frozen recovery before T,
+	// and the proof after its expiry (a jump of the clock after T0 and T).
+	for _, c := range []struct {
+		name   string
+		block  int
+		offset int64
+		want   string
+	}{
+		{"at T0 - 10", 59, 0, "FORK_NOT_ACTIVE"},
+		{"at T - 10", 119, 0, "FORK_NOT_ACTIVE"},
+		{"after expiry", 122, int64(f.Expiry - g), "PROOF_EXPIRED"},
+	} {
+		err := func() (err error) {
+			defer func() {
+				if r := recover(); r != nil {
+					err = fmt.Errorf("%v", r)
+				}
+			}()
+			GenerateChainWithGenesis(gspec, engine, c.block, func(i int, b *BlockGen) {
+				if i+1 == c.block {
+					if c.offset != 0 {
+						b.OffsetTime(c.offset)
+					}
+					b.AddTx(migration)
+				}
+			})
+			return nil
+		}()
+		if err == nil || !strings.Contains(err.Error(), c.want) {
+			t.Fatalf("0x7e %s: %v, want %s", c.name, err, c.want)
+		}
+	}
+
+	// Accepted: block 120, the first block at T.
+	_, blocks, receipts := GenerateChainWithGenesis(gspec, engine, 121, func(i int, b *BlockGen) {
+		if b.Number().Uint64() == 120 {
+			b.AddTx(migration)
+		}
+	})
+	chain, err := NewBlockChain(rawdb.NewMemoryDatabase(), gspec, engine, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer chain.Stop()
+	if n, err := chain.InsertChain(blocks); err != nil {
+		t.Fatalf("import failed at block %d: %v", n, err)
+	}
+	if blocks[59].Time() != p.T0 || blocks[119].Time() != p.T {
+		t.Fatal("block 60 must be at T0 and block 120 at T")
+	}
+	r := receipts[119]
+	if len(r) != 1 || r[0].Status != types.ReceiptStatusSuccessful || r[0].TxHash != migration.Hash() {
+		t.Fatalf("the 0x7e did not succeed in block 120: %+v", r)
+	}
+	before, err := chain.StateAt(blocks[118].Header())
+	if err != nil {
+		t.Fatal(err)
+	}
+	after, err := chain.StateAt(blocks[119].Header())
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Mode 2 is PQ_BY_PROOF in this client (pq_migrate.go); the record was empty (LEGACY).
+	if prev := ReadPQRecord(before, p.Registry, owner); prev != (PQRecord{}) {
+		t.Fatalf("the owner's record before the 0x7e: %+v", prev)
+	}
+	rec := ReadPQRecord(after, p.Registry, owner)
+	if rec.Mode != 2 || rec.MigrationNonce != 1 || rec.AlgID != f.AlgID || rec.Commit != common.HexToHash(f.PQPKCommit) {
+		t.Fatalf("the owner's record after the 0x7e: %+v", rec)
+	}
+	// Mode 0: the owner pays gas_used x (base fee + tip, at most max_fee), nothing else.
+	m, _ := migration.AsPQMigrate()
+	price := new(big.Int).Add(blocks[119].BaseFee(), m.GasTipCap)
+	if price.Cmp(m.GasFeeCap) > 0 {
+		price = new(big.Int).Set(m.GasFeeCap)
+	}
+	paid := new(big.Int).Sub(before.GetBalance(owner).ToBig(), after.GetBalance(owner).ToBig())
+	if cost := new(big.Int).Mul(new(big.Int).SetUint64(r[0].GasUsed), price); paid.Cmp(cost) != 0 {
+		t.Fatalf("the owner paid %v, gas_used x price is %v", paid, cost)
+	}
+	// Fixture (iv) and its balance variant on E1's chain: the images appear at the
+	// first block at or after T0 and not before; PQ_REGISTRY's balance is kept.
+	held := gspec.Alloc[p.Registry].Balance
+	for _, n := range []int{59, 60, 121} {
+		s, err := chain.StateAt(blocks[n-1].Header())
+		if err != nil {
+			t.Fatal(err)
+		}
+		installed := blocks[n-1].Time() >= p.T0
+		for _, a := range []common.Address{p.Registry, p.FactRegistry} {
+			code := s.GetCode(a)
+			if installed != (len(code) == 1 && code[0] == 0 && s.GetNonce(a) == 1) || !installed && (len(code) != 0 || s.GetNonce(a) != 0) {
+				t.Fatalf("block %d: %s holds code %x, nonce %d", n, a, code, s.GetNonce(a))
+			}
+		}
+		if s.GetBalance(p.Registry).ToBig().Cmp(held) != 0 || s.GetBalance(p.FactRegistry).Sign() != 0 {
+			t.Fatalf("block %d: a registry balance changed", n)
+		}
+	}
+	t.Logf("E1: 0x7e in block 120 (time %d, T %d): gas %d, price %v, owner paid %v; record %+v", blocks[119].Time(), p.T, r[0].GasUsed, price, paid, rec)
+}
diff --git a/core/pq_r1_e1_row1_test.go b/core/pq_r1_e1_row1_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..e6f87f1c88ec75827319f38d38d9ba608fd82dd5
--- /dev/null
+++ b/core/pq_r1_e1_row1_test.go
@@ -0,0 +1,163 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+// Stage r1-e1-run-20261028: the exact raw transactions of row 1 of stage R-1
+// (spec section 23.3) on E1's genesis, in process, before the network run.
+//
+
+package core
+
+import (
+	"bytes"
+	"encoding/binary"
+	"fmt"
+	"math/big"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/consensus/beacon"
+	"github.com/ethereum/go-ethereum/consensus/ethash"
+	"github.com/ethereum/go-ethereum/core/rawdb"
+	"github.com/ethereum/go-ethereum/core/state"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/crypto"
+)
+
+func r1E1RawTxs(t *testing.T) map[string]*types.Transaction {
+	t.Helper()
+	dir := os.Getenv("PQ_R1_E1_TXS")
+	if dir == "" {
+		t.Skip("requires the raw transactions written by cmd/pqr1e1")
+	}
+	txs := map[string]*types.Transaction{}
+	for _, name := range []string{"migrate", "over-cap", "activate", "spend"} {
+		raw, err := os.ReadFile(filepath.Join(dir, name+".bin"))
+		if err != nil {
+			t.Fatal(err)
+		}
+		tx := new(types.Transaction)
+		if err := tx.UnmarshalBinary(raw); err != nil {
+			t.Fatalf("%s: %v", name, err)
+		}
+		txs[name] = tx
+	}
+	return txs
+}
+
+// Row 1 in process on E1's genesis with the exact raw transactions of the run:
+// the frozen-recovery 0x7e in the first block at T, the activating 0x7c and the
+// spend in the next blocks, built and imported with the linked R-1 library.
+// The Migrated log carries (false, false) and migration_nonce 1 (l. 3398,
+// l. 3404); the account nonce is unchanged by the 0x7e and rises by one at the
+// activation and at the spend (l. 276, l. 927). Block building refuses the
+// replayed 0x7e before the activation (WRONG_MIGRATION_NONCE) and after it
+// (ALREADY_MIGRATED, l. 1159), and the carrier above the gas cap.
+func TestPQR1E1Row1Transactions(t *testing.T) {
+	gspec, _ := r1E1Genesis(t)
+	f, pi := r1RootInputs(t)
+	txs := r1E1RawTxs(t)
+	if _, linked := pqNativeIdentityJSON(); !linked {
+		t.Skip("requires the native-linked build")
+	}
+	t.Setenv("PQ_FULL_VERIFIER_PATH", "/nonexistent/no-worker-fallback")
+	cfg, p := gspec.Config, gspec.Config.PQMigrate
+	owner := common.HexToAddress(f.LegacyAddress)
+	m, ok := txs["migrate"].AsPQMigrate()
+	if !ok || !bytes.Equal(m.PublicInputs(), pi) || txs["migrate"].Gas() != 1<<24 || txs["over-cap"].Gas() != 1<<24+1 {
+		t.Fatal("migrate.bin is not R-1's carrier at the gas cap")
+	}
+	if p.T0 != gspec.Timestamp+600 || p.T != gspec.Timestamp+1200 {
+		t.Fatal("expected T0 = genesis + 600 and T = genesis + 1200")
+	}
+	engine := beacon.New(ethash.NewFaker())
+	refused := func(name string, block int, place map[int][]*types.Transaction, want string) {
+		t.Helper()
+		err := func() (err error) {
+			defer func() {
+				if r := recover(); r != nil {
+					err = fmt.Errorf("%v", r)
+				}
+			}()
+			GenerateChainWithGenesis(gspec, engine, block, func(i int, b *BlockGen) {
+				for _, tx := range place[i+1] {
+					b.AddTx(tx)
+				}
+			})
+			return nil
+		}()
+		if err == nil || !strings.Contains(strings.ToLower(err.Error()), strings.ToLower(want)) {
+			t.Fatalf("%s: %v, want %s", name, err, want)
+		}
+	}
+	refused("over the gas cap", 120, map[int][]*types.Transaction{120: {txs["over-cap"]}}, "gas")
+	refused("replay before activation", 121, map[int][]*types.Transaction{120: {txs["migrate"]}, 121: {txs["migrate"]}}, "WRONG_MIGRATION_NONCE")
+	refused("replay after activation", 122, map[int][]*types.Transaction{120: {txs["migrate"]}, 121: {txs["activate"]}, 122: {txs["migrate"]}}, "ALREADY_MIGRATED")
+
+	order := map[uint64]*types.Transaction{120: txs["migrate"], 121: txs["activate"], 122: txs["spend"]}
+	_, blocks, receipts := GenerateChainWithGenesis(gspec, engine, 123, func(i int, b *BlockGen) {
+		if tx, ok := order[b.Number().Uint64()]; ok {
+			b.AddTx(tx)
+		}
+	})
+	chain, err := NewBlockChain(rawdb.NewMemoryDatabase(), gspec, engine, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer chain.Stop()
+	if n, err := chain.InsertChain(blocks); err != nil {
+		t.Fatalf("import failed at block %d: %v", n, err)
+	}
+	for n, tx := range order {
+		r := receipts[n-1]
+		if len(r) != 1 || r[0].Status != types.ReceiptStatusSuccessful || r[0].TxHash != tx.Hash() {
+			t.Fatalf("block %d: %+v", n, r)
+		}
+	}
+	logs := receipts[119][0].Logs
+	topic := crypto.Keccak256Hash([]byte("Migrated(address,uint8,bytes32,uint64,bool,bool)"))
+	if len(logs) != 1 || logs[0].Topics[0] != topic || logs[0].Topics[1] != common.BytesToHash(owner[:]) || len(logs[0].Data) != 160 {
+		t.Fatalf("Migrated log: %+v", logs)
+	}
+	d := logs[0].Data
+	if d[31] != f.AlgID || common.BytesToHash(d[32:64]) != common.HexToHash(f.PQPKCommit) || binary.BigEndian.Uint64(d[88:96]) != 1 || d[127] != 0 || d[159] != 0 {
+		t.Fatalf("Migrated data %x: want alg 1, the commitment, migration_nonce 1 and (false, false)", d)
+	}
+	state := func(n int) (nonce uint64, code []byte, rec PQRecord, recipient *big.Int) {
+		s, err := chain.StateAt(blocks[n-1].Header())
+		if err != nil {
+			t.Fatal(err)
+		}
+		to := txs["spend"].To()
+		return s.GetNonce(owner), s.GetCode(owner), ReadPQRecord(s, p.Registry, owner), s.GetBalance(*to).ToBig()
+	}
+	for n, want := range map[int]uint64{119: 0, 120: 0, 121: 1, 122: 2} {
+		if nonce, _, _, _ := state(n); nonce != want {
+			t.Fatalf("block %d: account nonce %d, want %d", n, nonce, want)
+		}
+	}
+	_, code120, rec120, _ := state(120)
+	if len(code120) != 0 || rec120.Mode != 2 || rec120.MigrationNonce != 1 || !PQECDSADead(mustState(t, chain, blocks[119]), p, owner, blocks[119].Time()) || PQActivated(mustState(t, chain, blocks[119]), p, owner) {
+		t.Fatalf("after the 0x7e: code %x, record %+v", code120, rec120)
+	}
+	pq, _ := txs["activate"].AsPQTx()
+	_, code121, _, _ := state(121)
+	if !bytes.Equal(code121, append([]byte{0xef, 0x01, 0x01}, pq.PublicKey[0]...)) || !PQActivated(mustState(t, chain, blocks[120]), p, owner) {
+		t.Fatal("the activation did not install the 0xef0101 marker")
+	}
+	if _, _, _, got := state(122); got.Cmp(big.NewInt(2_000_000_000_000)) != 0 {
+		t.Fatalf("recipient holds %v after the spend", got)
+	}
+	t.Logf("row 1 in process on E1 (chain %d): 0x7e gas %d, 0x7c gas %d and %d", cfg.ChainID, receipts[119][0].GasUsed, receipts[120][0].GasUsed, receipts[121][0].GasUsed)
+}
+
+func mustState(t *testing.T, chain *BlockChain, b *types.Block) *state.StateDB {
+	t.Helper()
+	s, err := chain.StateAt(b.Header())
+	if err != nil {
+		t.Fatal(err)
+	}
+	return s
+}
