@@ -0,0 +1,49 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+// Local native Full verification for explicitly isolated research profiles.
+// Missing libraries and ABI faults are local errors, never proof rejection.
+package core
+
+import (
+	"errors"
+	"fmt"
+
+	"github.com/ethereum/go-ethereum/params"
+)
+
+var ErrPQFullUnavailable = errors.New("PQ_FULL_VERIFIER_UNAVAILABLE")
+var ErrPQInvalidFullProof = errors.New("INVALID_PROOF")
+
+// Every accepted profile pins a native implementation. The earlier external
+// worker profile is rejected by configuration and has no executable fallback.
+func CheckPQFullVerifierConfig(c *params.PQFullResearchConfig) error {
+	if c == nil {
+		return fmt.Errorf("%w: profile disabled", ErrPQFullUnavailable)
+	}
+	switch c.Backend {
+	case params.PQFinalBackend:
+		return checkPQFinalConfig(c)
+	case params.PQSuccinctNativeBackend:
+		return checkPQNativeConfig(c)
+	default:
+		return fmt.Errorf("%w: unsupported research backend", ErrPQFullUnavailable)
+	}
+}
+
+func VerifyPQFull(c *params.PQFullResearchConfig, pi, proof []byte) error {
+	if len(pi) != 198 || c == nil || uint64(len(proof)) > c.MaxProofBytes {
+		return fmt.Errorf("%w: research proof/PI bound", ErrPQInvalidFullProof)
+	}
+	if err := CheckPQFullVerifierConfig(c); err != nil {
+		return err
+	}
+	switch c.Backend {
+	case params.PQFinalBackend:
+		return verifyPQFinal(c, pi, proof)
+	case params.PQSuccinctNativeBackend:
+		return verifyPQNative(c, pi, proof)
+	default:
+		return fmt.Errorf("%w: unsupported research backend", ErrPQFullUnavailable)
+	}
+}
