new file mode 100644
index 0000000000000000000000000000000000000000..7b7ce187194070bebba62ac6543248ef531beafa
--- /dev/null
+++ b/core/vm/pq_authority_gas_test.go
@@ -0,0 +1,176 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package vm
+
+import (
+	"bytes"
+	"errors"
+	"testing"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core/tracing"
+)
+
+type pqCountedRecovery struct {
+	PrecompiledContract
+	calls  int
+	before func()
+}
+
+func (p *pqCountedRecovery) Run(input []byte) ([]byte, error) {
+	p.calls++
+	if p.before != nil {
+		p.before()
+	}
+	return p.PrecompiledContract.Run(input)
+}
+
+type pqCountedState struct {
+	StateDB
+	reads, slotQueries, warms, touches int
+}
+
+func (s *pqCountedState) GetState(addr common.Address, key common.Hash) common.Hash {
+	s.reads++
+	return s.StateDB.GetState(addr, key)
+}
+
+func (s *pqCountedState) SlotInAccessList(addr common.Address, key common.Hash) (bool, bool) {
+	s.slotQueries++
+	return s.StateDB.SlotInAccessList(addr, key)
+}
+
+func (s *pqCountedState) AddSlotToAccessList(addr common.Address, key common.Hash) {
+	s.warms++
+	s.StateDB.AddSlotToAccessList(addr, key)
+}
+
+func (s *pqCountedState) Touch(addr common.Address) {
+	s.touches++
+	s.StateDB.Touch(addr)
+}
+
+// This exercises the real dispatcher, rather than calling the metered helper
+// directly: the security boundary is charging before even attempting recovery.
+func TestPQAuthorityChargeBeforeRecovery(t *testing.T) {
+	for _, tc := range []struct {
+		name                       string
+		gas                        uint64
+		warm, invalid, retired     bool
+		recoveries, queries, reads int
+		used                       uint64
+		outOfGas                   bool
+	}{
+		{name: "zero", gas: 0, outOfGas: true},
+		{name: "below-base", gas: 2999, outOfGas: true},
+		{name: "base-only", gas: 3000, recoveries: 1, queries: 1, used: 3000, outOfGas: true},
+		{name: "below-cold", gas: 5099, recoveries: 1, queries: 1, used: 3000, outOfGas: true},
+		{name: "exact-cold", gas: 5100, recoveries: 1, queries: 1, reads: 1, used: 5100},
+		{name: "extra-cold", gas: 5101, recoveries: 1, queries: 1, reads: 1, used: 5100},
+		{name: "below-warm", gas: 3099, warm: true, recoveries: 1, queries: 1, used: 3000, outOfGas: true},
+		{name: "exact-warm", gas: 3100, warm: true, recoveries: 1, queries: 1, reads: 1, used: 3100},
+		{name: "invalid", gas: 3000, invalid: true, recoveries: 1, used: 3000},
+		{name: "retired-below-base", gas: 2999, retired: true, outOfGas: true},
+		{name: "retired", gas: 3000, retired: true, used: 3000},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			timestamp := uint64(100)
+			if tc.retired {
+				timestamp = 200
+			}
+			evm, s, input, authority := pqRecoveryFixture(t, timestamp)
+			registry, slot := evm.chainConfig.PQMigrate.Registry, pqAuthoritySlot(authority)
+			if tc.warm {
+				s.AddSlotToAccessList(registry, slot)
+			}
+			if tc.invalid {
+				input[63] = 29
+			}
+			db := &pqCountedState{StateDB: s}
+			evm.StateDB = db
+			p, _ := evm.pqAuthorityPrecompile(common.HexToAddress("1"))
+			var charges []uint64
+			recovery := &pqCountedRecovery{PrecompiledContract: &ecrecover{}}
+			recovery.before = func() {
+				if len(charges) != 1 || charges[0] != 3000 {
+					t.Fatalf("recovery occurred before base charge: %v", charges)
+				}
+			}
+			p.(*pqECRecover).recovery = recovery
+			if got := p.RequiredGas(input); got != 3000 || recovery.calls != 0 || db.slotQueries != 0 || db.reads != 0 {
+				t.Fatalf("RequiredGas did work: gas=%d recover=%d state=%+v", got, recovery.calls, db)
+			}
+			logger := &tracing.Hooks{OnGasChangeV2: func(old, new tracing.Gas, reason tracing.GasChangeReason) {
+				if old.State != 777 || new.State != 777 || reason != tracing.GasChangeCallPrecompiledContract {
+					t.Fatalf("unexpected gas dimension/reason: %v %v %v", old, new, reason)
+				}
+				charges = append(charges, old.Execution-new.Execution)
+			}}
+			budget := NewGasBudget(tc.gas, 777)
+			out, remaining, err := RunPrecompiledContract(db, p, common.HexToAddress("1"), input, budget, logger, evm.chainRules, NewPrecompileCache())
+			if errors.Is(err, ErrOutOfGas) != tc.outOfGas || (err != nil && !tc.outOfGas) {
+				t.Fatalf("error=%v, want outOfGas=%v", err, tc.outOfGas)
+			}
+			if recovery.calls != tc.recoveries || db.slotQueries != tc.queries || db.reads != tc.reads || db.warms != tc.reads {
+				t.Fatalf("recovery=%d queries=%d reads=%d warms=%d", recovery.calls, db.slotQueries, db.reads, db.warms)
+			}
+			if remaining.Used(budget) != tc.used || remaining.UsedExecutionGas != tc.used || remaining.StateGas != 777 || remaining.UsedStateGas != 0 || remaining.Spilled != 0 {
+				t.Fatalf("gas budget=%v, want execution used=%d", remaining, tc.used)
+			}
+			_, warm := s.SlotInAccessList(registry, slot)
+			if warm != (tc.warm || tc.reads != 0) {
+				t.Fatal("unpaid state read warmed registry slot")
+			}
+			if tc.reads != 0 {
+				if !bytes.Equal(out, common.LeftPadBytes(authority[:], 32)) || len(charges) != 2 || charges[1] != tc.used-3000 {
+					t.Fatalf("output=%x charges=%v", out, charges)
+				}
+			} else if len(out) != 0 {
+				t.Fatalf("unexpected output %x", out)
+			}
+			t.Logf("gas=%d recoveries=%d Rec reads=%d charges=%v", tc.gas, recovery.calls, db.reads, charges)
+		})
+	}
+}
+
+func TestPQAuthorityMeteredBlockAccessList(t *testing.T) {
+	for _, tc := range []struct {
+		name                                  string
+		gas                                   uint64
+		retired, invalid, wantTouch, wantRead bool
+	}{
+		{name: "unfunded", gas: 2999},
+		{name: "read-unfunded", gas: 5099, wantTouch: true},
+		{name: "funded", gas: 5100, wantTouch: true, wantRead: true},
+		{name: "invalid", gas: 3000, invalid: true, wantTouch: true},
+		{name: "retired", gas: 3000, retired: true, wantTouch: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			evm, s, input, authority := pqRecoveryFixture(t, 100)
+			registry, slot := evm.chainConfig.PQMigrate.Registry, pqAuthoritySlot(authority)
+			// Persist an existing registry account before the measured transaction.
+			s.SetNonce(registry, 1, tracing.NonceChangeUnspecified)
+			s.Finalise(evm.chainRules)
+			evm.chainRules.IsAmsterdam = true
+			s.Prepare(evm.chainRules, common.HexToAddress("900"), common.Address{}, nil, ActivePrecompiles(evm.chainRules), nil)
+			if tc.retired {
+				evm.Context.Time = 200
+			}
+			if tc.invalid {
+				input[63] = 29
+			}
+			p, _ := evm.pqAuthorityPrecompile(common.HexToAddress("1"))
+			RunPrecompiledContract(s, p, common.HexToAddress("1"), input, NewGasBudget(tc.gas, 0), nil, evm.chainRules, NewPrecompileCache())
+			access := s.Finalise(evm.chainRules)
+			_, touched := access.Accounts[common.HexToAddress("1")]
+			read := false
+			if account := access.Accounts[registry]; account != nil {
+				_, read = account.StorageReads[slot]
+			}
+			if touched != tc.wantTouch || read != tc.wantRead {
+				t.Fatalf("BAL precompile=%v Rec slot=%v, want %v/%v", touched, read, tc.wantTouch, tc.wantRead)
+			}
+		})
+	}
+}
