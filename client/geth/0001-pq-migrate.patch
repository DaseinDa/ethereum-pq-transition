+package core
+
+/*
+#cgo LDFLAGS: -lpq_migrate_tree
+#include <stdint.h>
+#include <stddef.h>
+extern int32_t pq_aggregate_verify(const uint8_t*,size_t,const uint8_t*,size_t);
+extern int32_t pq_aggregate_ready_v1(void);
+extern const char* pq_aggregate_key_v1(void);
+*/
+import "C"
+import "unsafe"
+
+func pqAggregateReady() (string, int) {
+	return C.GoString(C.pq_aggregate_key_v1()), int(C.pq_aggregate_ready_v1())
+}
+func pqAggregateVerify(proof, statement []byte) int {
+	if len(proof) == 0 || len(statement) != 798 {
+		return 1
+	}
+	return int(C.pq_aggregate_verify((*C.uint8_t)(unsafe.Pointer(&proof[0])), C.size_t(len(proof)), (*C.uint8_t)(unsafe.Pointer(&statement[0])), C.size_t(len(statement))))
+}
