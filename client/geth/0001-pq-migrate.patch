+type pqGraphBackend struct {
+	ethapi.Backend
+	calls int
+}
+
+func (b *pqGraphBackend) ChainConfig() *params.ChainConfig { return params.AllDevChainProtocolChanges }
+func (b *pqGraphBackend) RPCTxFeeCap() float64             { return 0 }
+func (b *pqGraphBackend) UnprotectedAllowed() bool         { return true }
+func (b *pqGraphBackend) SendTx(context.Context, *types.Transaction) error {
+	b.calls++
+	return &core.PQMigrationError{Name: "WRONG_MIGRATION_NONCE", Code: 0x105}
+}
+func TestPQGraphQLSubmissionExtensions(t *testing.T) {
+	b := new(pqGraphBackend)
+	s, err := gql.ParseSchema(schema, &Resolver{backend: b})
+	if err != nil {
+		t.Fatal(err)
+	}
+	tx := types.NewTx(&types.PQMigrateTx{ChainID: big.NewInt(13378), LegacyAddress: common.Address{1}, AlgID: 1, PQPKCommit: common.Hash{1}, Expiry: 1000, MaxAccountFee: big.NewInt(0), GasTipCap: big.NewInt(1), GasFeeCap: big.NewInt(2), Gas: 100000, VerifierVersion: 0x80000008, ProofCarrier: types.PQMigrationCarrier{Proof: []byte{1}}})
+	raw, _ := tx.MarshalBinary()
+	for _, c := range []struct {
+		data, reason, code string
+		calls              int
+	}{
+		{hexutil.Encode(raw), "WRONG_MIGRATION_NONCE", "0x105", 1},
+		{"0x7ec0", "NON_CANONICAL_ENCODING", "0x3", 1},
+		{"0x7bc0", "NON_CANONICAL_ENCODING", "0x3", 1},
+	} {
+		result := s.Exec(context.Background(), `mutation { sendRawTransaction(data: "`+c.data+`") }`, "", nil)
+		if len(result.Errors) != 1 {
+			t.Fatalf("errors: %+v", result)
+		}
+		encoded, _ := json.Marshal(result)
+		var obj map[string]interface{}
+		json.Unmarshal(encoded, &obj)
+		e := obj["errors"].([]interface{})[0].(map[string]interface{})
+		x := e["extensions"].(map[string]interface{})
+		if len(x) != 5 || x["reason"] != c.reason || x["protocolCode"] != c.code || x["culprit"] != nil || x["pendingFetch"] != false {
+			t.Fatalf("extensions: %s", encoded)
+		}
+		if _, has := obj["jsonrpc"]; has || b.calls != c.calls {
+			t.Fatal("JSON-RPC envelope or duplicate admission")
+		}
+	}
+	result := s.Exec(context.Background(), `mutation { sendRawTransaction(data: "0xzz") }`, "", nil)
+	if len(result.Errors) == 0 || len(result.Errors[0].Extensions) != 0 || b.calls != 1 {
+		t.Fatalf("invalid DATA: %+v", result)
+	}
+}
