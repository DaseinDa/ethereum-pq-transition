+
+	"github.com/cloudflare/circl/sign/mldsa/mldsa44"
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/params"
+)
+
+// SingleF replays public F fixtures at an explicit timestamp below expiry.
+// The PI and ownership proof are unchanged; only the carrier's fee terms and
+// public sponsor authorization are generated here. This is component evidence.
+func SingleF(t *testing.T, mode uint8) (*types.Transaction, uint64) {
+	t.Helper()
+	dir := os.Getenv("PQ_F_FIXTURES")
+	if dir == "" {
+		t.Skip("requires packaged public single-F fixtures")
+	}
+	raw, err := os.ReadFile(filepath.Join(dir, fmt.Sprintf("mode%d", mode), "pi198.hex"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	pi, err := hex.DecodeString(strings.TrimSpace(string(raw)))
+	if err != nil || len(pi) != 198 {
+		t.Fatal("PI198", err)
+	}
+	proof, err := os.ReadFile(filepath.Join(dir, fmt.Sprintf("mode%d", mode), "proof.postcard"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	p := &types.PQMigrateTx{ChainID: new(big.Int).SetBytes(pi[:32]), LegacyAddress: common.BytesToAddress(pi[64:84]),
+		MigrationNonce: binary.BigEndian.Uint64(pi[84:92]), AlgID: pi[92], PQPKCommit: common.BytesToHash(pi[93:125]),
+		VerifierVersion: binary.BigEndian.Uint32(pi[125:129]), Expiry: binary.BigEndian.Uint64(pi[129:137]),
+		MaxAccountFee: new(big.Int).SetBytes(pi[137:169]), FeeMode: pi[169], FeeSponsor: common.BytesToAddress(pi[170:190]), FeeAuthUntil: binary.BigEndian.Uint64(pi[190:198]),
+		GasTipCap: big.NewInt(params.GWei), GasFeeCap: big.NewInt(2 * params.GWei), Gas: 16000000, ProofCarrier: types.PQMigrationCarrier{Proof: proof}}
+	if p.FeeMode != mode || p.VerifierVersion != params.PQFinalVersion || !bytes.Equal(p.PublicInputs(), pi) || p.Expiry < 3600 {
+		t.Fatal("wrong F fixture")
+	}
+	if mode != 0 {
+		sponsor := common.HexToAddress("0xf053")
+		if mode == 1 {
+			sponsor = p.FeeSponsor
+		}
+		p.SponsorOption = &types.PQMigrationSponsor{Sponsor: sponsor, ValidUntil: p.Expiry, Signature: make([]byte, mldsa44.SignatureSize)}
+		_, sk := sponsorKey()
+		d := p.SponsorSigningHash()
+		tag := []byte("ETH-PQ-SPONSOR/v1")
+		if err := mldsa44.SignTo(sk, append(append([]byte{}, tag...), d[:]...), tag, false, p.SponsorOption.Signature); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return types.NewTx(p), p.Expiry - 3600
+}
