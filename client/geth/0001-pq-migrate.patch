+)
+
+func TestPQBatchAnnouncementSizeBoundary(t *testing.T) {
+	cfg := *params.AllEthashProtocolChanges
+	genesis := &core.Genesis{Config: &cfg, GasLimit: 30000000, Difficulty: big.NewInt(1)}
+	db := rawdb.NewMemoryDatabase()
+	defer db.Close()
+	chain, err := core.NewBlockChain(db, genesis, ethash.NewFaker(), nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer chain.Stop()
+	// This tests announcement policy only. Attach the size policy to an idle
+	// ordinary test chain; no PQ startup, proof, or execution claim is made.
+	chain.Config().PQMigrate = &params.PQMigrateConfig{AggregateResearch: &params.PQAggregateResearchConfig{MaxTxBytes: params.PQAggregateMaxTxBytes}}
+	at, over := common.Hash{1}, common.Hash{2}
+	requested := make(chan []common.Hash, 1)
+	testTransactionFetcher(t, txFetcherTest{
+		init: func() *TxFetcher {
+			f := newTestTxFetcher()
+			f.chain = chain
+			f.fetchTxs = func(peer string, hashes []common.Hash) error {
+				requested <- append([]common.Hash{}, hashes...)
+				return nil
+			}
+			return f
+		},
+		steps: []interface{}{
+			doTxNotify{peer: "peer", version: eth.ETH70, hashes: []common.Hash{at, over}, types: []byte{types.PQBatchTxType, types.PQBatchTxType}, sizes: []uint32{200512, 200513}},
+			isWaiting(map[string][]announce{"peer": {{at, types.PQBatchTxType, 200512}}}),
+			doWait{time: txArriveTimeout, step: true},
+			isWaiting(nil),
+			isScheduled{tracking: map[string][]announce{"peer": {{at, types.PQBatchTxType, 200512}}}, fetching: map[string][]common.Hash{"peer": {at}}},
+			doFunc(func() {
+				select {
+				case hashes := <-requested:
+					if len(hashes) != 1 || hashes[0] != at {
+						t.Fatal("wrong batch announcement fetched", hashes)
+					}
+				case <-time.After(time.Second):
+					t.Fatal("boundary-sized batch was not requested")
+				}
+			}),
+		},
+	})
+}
