+	"github.com/ethereum/go-ethereum/trie"
+)
+
+// This is a real RPC renderer/receipt codec component test. Synthetic envelopes
+// do not establish proof or signature validity and do not run Full verification.
+func TestPQNativeReceiptDestination(t *testing.T) {
+	to := common.HexToAddress("7777777777777777777777777777777777777777")
+	created := common.HexToAddress("8888888888888888888888888888888888888888")
+	chainID := big.NewInt(13375)
+	signer := types.LatestSignerForChainID(chainID)
+	key, err := crypto.HexToECDSA("b71c71a67e1177ad4e901695e1b4b9ee17ae16c6668d313eac2f96dbcda3f291")
+	if err != nil {
+		t.Fatal(err)
+	}
+	migration := types.NewTx(&types.PQMigrateTx{
+		ChainID: chainID, LegacyAddress: to, AlgID: 1,
+		PQPKCommit: common.Hash{31: 1}, Expiry: 2000000000,
+		MaxAccountFee: new(big.Int), FeeMode: 0,
+		GasTipCap: big.NewInt(1), GasFeeCap: big.NewInt(2), Gas: 100000,
+		VerifierVersion: 0x80000002,
+		ProofCarrier:    types.PQMigrationCarrier{Route: 0, Proof: []byte{1}},
+	})
+	enrollment := types.NewTx(&types.PQEnrollTx{
+		ChainID: chainID, GasTipCap: big.NewInt(1), GasFeeCap: big.NewInt(2),
+		Gas: 100000, AlgID: 1, PublicKey: []byte{1}, PoPSignature: []byte{2},
+		V: new(big.Int), R: new(big.Int), S: new(big.Int),
+	})
+	enrollmentData, _ := enrollment.AsPQEnroll()
+	enrollmentDigest := enrollmentData.SigningHash()
+	enrollmentSig, err := crypto.Sign(enrollmentDigest[:], key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	enrollmentData.V = new(big.Int).SetUint64(uint64(enrollmentSig[64]))
+	enrollmentData.R = new(big.Int).SetBytes(enrollmentSig[:32])
+	enrollmentData.S = new(big.Int).SetBytes(enrollmentSig[32:64])
+	enrollment = types.NewTx(enrollmentData)
+	pqCall := types.NewTx(&types.PQTx{
+		ChainID: chainID, From: created, GasTipCap: big.NewInt(1),
+		GasFeeCap: big.NewInt(2), Gas: 100000, To: to, Value: new(big.Int),
+		AlgID: 1, Signature: []byte{1},
+	})
+	ordinary := func(dest *common.Address) *types.Transaction {
+		tx, err := types.SignTx(types.NewTx(&types.LegacyTx{
+			Gas: 100000, GasPrice: big.NewInt(2), To: dest, Value: new(big.Int),
+		}), signer, key)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return tx
+	}
+	for _, tc := range []struct {
+		name         string
+		tx           *types.Transaction
+		wantTo       *common.Address
+		contract     common.Address
+		wantContract *common.Address
+	}{
+		{"single_migration_0x7e", migration, nil, common.Address{}, nil},
+		{"enrollment_0x7d", enrollment, nil, common.Address{}, nil},
+		// These two types never create an EVM contract, even if a caller's
+		// non-consensus ContractAddress metadata is erroneously populated.
+		{"migration_never_CREATE", migration, nil, created, nil},
+		{"enrollment_never_CREATE", enrollment, nil, created, nil},
+		{"pq_call_0x7c", pqCall, &to, common.Address{}, nil},
+		{"ordinary_call", ordinary(&to), &to, common.Address{}, nil},
+		{"ordinary_call_zero_address", ordinary(&common.Address{}), &common.Address{}, common.Address{}, nil},
+		{"ordinary_creation", ordinary(nil), nil, created, &created},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			receipt := &types.Receipt{
+				Type: tc.tx.Type(), Status: types.ReceiptStatusSuccessful,
+				CumulativeGasUsed: 123456, GasUsed: 23456,
+				EffectiveGasPrice: big.NewInt(2), ContractAddress: tc.contract,
+				Logs: []*types.Log{{Address: to, Topics: []common.Hash{{31: 2}}, Data: []byte{3}}},
+			}
+			receipt.Bloom = types.CreateBloom(receipt)
+			rawBefore, err := tc.tx.MarshalBinary()
+			if err != nil {
+				t.Fatal(err)
+			}
+			hashBefore := tc.tx.Hash()
+			consensusBefore, err := receipt.MarshalBinary()
+			if err != nil {
+				t.Fatal(err)
+			}
+			rootBefore := types.DeriveSha(types.Receipts{receipt}, trie.NewStackTrie(nil))
+			fields := MarshalReceipt(receipt, common.Hash{31: 4}, 9, signer, tc.tx, 2)
+			encoded, err := json.Marshal(fields)
+			if err != nil {
+				t.Fatal(err)
+			}
+			var decoded map[string]json.RawMessage
+			if err = json.Unmarshal(encoded, &decoded); err != nil {
+				t.Fatal(err)
+			}
+			wantTo, _ := json.Marshal(tc.wantTo)
+			wantContract, _ := json.Marshal(tc.wantContract)
+			if string(decoded["to"]) != string(wantTo) || string(decoded["contractAddress"]) != string(wantContract) {
+				t.Fatalf("to=%s contractAddress=%s want=%s/%s", decoded["to"], decoded["contractAddress"], wantTo, wantContract)
+			}
+			wantType, _ := json.Marshal(hexutil.Uint(tc.tx.Type()))
+			if !bytes.Equal(decoded["type"], wantType) || fields["type"] == nil {
+				t.Fatal("type discriminator missing")
+			}
+			consensusAfter, err := receipt.MarshalBinary()
+			if err != nil {
+				t.Fatal(err)
+			}
+			rawAfter, err := tc.tx.MarshalBinary()
+			if err != nil {
+				t.Fatal(err)
+			}
+			rootAfter := types.DeriveSha(types.Receipts{receipt}, trie.NewStackTrie(nil))
+			if !bytes.Equal(consensusBefore, consensusAfter) || rootBefore != rootAfter ||
+				!bytes.Equal(rawBefore, rawAfter) || hashBefore != tc.tx.Hash() {
+				t.Fatal("RPC representation mutated typed receipt, receipts root, raw transaction or hash")
+			}
+			t.Logf("RPC to=%s contractAddress=%s; typed receipt, receiptsRoot, raw and hash unchanged", wantTo, wantContract)
+		})
+	}
+}
diff --git a/internal/ethapi/pq_submit.go b/internal/ethapi/pq_submit.go
new file mode 100644
index 0000000000000000000000000000000000000000..08d57cfc49cc09d6d2887638580e1bfd9e24bb9e
--- /dev/null
+++ b/internal/ethapi/pq_submit.go
@@ -0,0 +1,171 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package ethapi
+
+import (
+	"errors"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/common/hexutil"
+	"github.com/ethereum/go-ethereum/core"
+	"github.com/ethereum/go-ethereum/core/txpool"
+	"github.com/ethereum/go-ethereum/core/txpool/pqpool"
+	"github.com/ethereum/go-ethereum/core/types"
+)
+
+// The mapper describes one completed admission attempt. It never validates,
+// retries, touches pool state or assigns source charges. Unknown local errors
+// deliberately lose their diagnostic text at this public boundary.
+type pqSubmitError struct {
+	code int
+	data pqSubmitErrorData
+}
+
+type pqSubmitErrorData struct {
+	FailureClass string           `json:"failureClass"`
+	Reason       string           `json:"reason"`
+	ProtocolCode *hexutil.Uint64  `json:"protocolCode"`
+	Culprit      *pqSubmitCulprit `json:"culprit"`
+	PendingFetch *bool            `json:"pendingFetch"`
+}
+
+type pqSubmitCulprit struct {
+	Kind     string       `json:"kind"`
+	TxHash   *common.Hash `json:"txHash"`
+	FactHash *common.Hash `json:"factHash"`
+}
+
+func (e *pqSubmitError) Error() string          { return e.data.Reason }
+func (e *pqSubmitError) ErrorCode() int         { return e.code }
+func (e *pqSubmitError) ErrorData() interface{} { return e.data }
+
+func pqSubmitFailure(code int, class, reason string) *pqSubmitError {
+	e := &pqSubmitError{code: code, data: pqSubmitErrorData{FailureClass: class, Reason: reason}}
+	// This profile has no assembly. Determinate rejection retains no fetch.
+	// Unsupported and local failures leave the outcome unobserved.
+	if code == -32003 || code == -32005 {
+		retained := false
+		e.data.PendingFetch = &retained
+	}
+	return e
+}
+
+func pqSubmitLocalLimit() error { return pqSubmitFailure(-32005, "bounds", "LOCAL_LIMIT") }
+
+// Names and codes are paired by the protocol's fixed error registry. This
+// boundary maps an existing outcome; it does not perform another validation.
+var pqSubmitCodes = map[string]uint16{
+	"FORK_NOT_ACTIVE": 0x0001, "ENROLL_AFTER_FORK": 0x0002, "NON_CANONICAL_ENCODING": 0x0003,
+	"WRONG_CHAIN_ID": 0x0004, "WRONG_VERIFIER_VERSION": 0x0006, "UNSUPPORTED_PQ_SCHEME": 0x0007, "PROOF_TOO_LARGE": 0x0008,
+	"SENDER_HAS_CODE": 0x0101, "NOT_AN_EOA": 0x0102, "ALREADY_MIGRATED": 0x0103, "OVERRIDE_WINDOW_CLOSED": 0x0104,
+	"WRONG_MIGRATION_NONCE": 0x0105, "NOT_PQ_ACCOUNT": 0x0106, "NOT_FINAL": 0x0107, "ROTATE_BAD_CALLER": 0x0108,
+	"PROOF_EXPIRED": 0x0201, "EXPIRY_TOO_FAR": 0x0202, "FEE_CAP_EXCEEDED": 0x0301, "INSUFFICIENT_FEE_BALANCE": 0x0302,
+	"SPONSOR_PENDING_LIMIT": 0x0303, "REPLACEMENT_UNDERPRICED": 0x0304, "UNDERPRICED": 0x0305, "VERSION_LIMIT": 0x0306,
+	"BATCH_ENTRY_NOT_ADMISSIBLE": 0x0307, "WRONG_SPONSOR_NONCE": 0x0308, "SPONSOR_EXPIRED": 0x0309, "SPONSOR_BANNED": 0x030a,
+	"BAD_POP": 0x0401, "INVALID_PROOF": 0x0402, "BAD_SPONSOR_SIG": 0x0403, "BAD_ACTIVATION": 0x0404, "BAD_PQ_SIG": 0x0405,
+	"ECDSA_DISABLED": 0x0501, "AUTH_TUPLE_REJECTED": 0x0502,
+	"LANE_NOT_CLOSED": 0x0601, "LANE_MEMBER_INVALID": 0x0602, "LANE_KEY_MISMATCH": 0x0603, "BAD_LANE_SIG": 0x0604,
+	"LANE_GAS_EXCEEDED": 0x0605, "STATEMENT_INVALID": 0x0606, "FACT_ALREADY_REGISTERED": 0x0607, "FACT_MISSING": 0x0608, "LANE_K_EXCEEDED": 0x0609,
+}
+
+func pqProtocolFailure(name string) *pqSubmitError {
+	code := pqSubmitCodes[name]
+	class := "chain-state"
+	switch code {
+	case 0x0003, 0x0004, 0x0602:
+		class = "packet-format"
+	case 0x0008, 0x0605, 0x0609:
+		class = "bounds"
+	case 0x0401, 0x0402, 0x0403, 0x0404, 0x0405, 0x0603, 0x0604, 0x0606:
+		class = "cryptography"
+	}
+	e := pqSubmitFailure(-32003, class, name)
+	value := hexutil.Uint64(code)
+	e.data.ProtocolCode = &value
+	return e
+}
+
+func isPQSubmissionType(kind byte) bool { return kind >= 0x7b && kind <= 0x7f }
+
+// GraphQL consumes the same five members, without a JSON-RPC envelope.
+func (e *pqSubmitError) Extensions() map[string]interface{} {
+	return map[string]interface{}{"failureClass": e.data.FailureClass, "reason": e.data.Reason,
+		"protocolCode": e.data.ProtocolCode, "culprit": e.data.Culprit, "pendingFetch": e.data.PendingFetch}
+}
+
+func mapPQTransactionError(err error, kind byte) error {
+	if err == nil {
+		return nil
+	}
+	// These are the stock signed-transaction pool rules for 0x7c/0x7d.
+	if kind == 0x7c || kind == 0x7d {
+		for _, stock := range []error{txpool.ErrAlreadyKnown, txpool.ErrUnderpriced, txpool.ErrReplaceUnderpriced} {
+			if errors.Is(err, stock) {
+				return pqSubmitFailure(-32003, "chain-state", "STOCK_REJECTION")
+			}
+		}
+	}
+	return mapPQSubmitError(err, nil)
+}
+
+func mapPQSubmitError(err error, _ *common.Hash) error {
+	if err == nil {
+		return nil
+	}
+	if errors.Is(err, core.ErrPQFullUnavailable) || errors.Is(err, pqpool.ErrLocalUnavailable) {
+		return pqSubmitFailure(-32002, "local-unavailable", "LOCAL_UNAVAILABLE")
+	}
+	for _, limit := range []error{txpool.ErrOutOfCapacity, txpool.ErrPQBusy, txpool.ErrPQSourceBudget} {
+		if errors.Is(err, limit) {
+			return pqSubmitLocalLimit()
+		}
+	}
+	if errors.Is(err, core.ErrTxTypeNotSupported) || err.Error() == "PQ_FULL_RESEARCH_DISABLED" || err.Error() == "PQ_RESEARCH_UNSUPPORTED_FORK" {
+		return pqSubmitFailure(-32004, "unsupported", "UNSUPPORTED_CAPABILITY")
+	}
+	name := err.Error()
+	var protocol *core.PQMigrationError
+	if errors.As(err, &protocol) {
+		if code, ok := pqSubmitCodes[protocol.Name]; !ok || code != protocol.Code {
+			return pqSubmitFailure(-32002, "local-unavailable", "LOCAL_UNAVAILABLE")
+		}
+		return pqProtocolFailure(protocol.Name)
+	}
+	switch {
+	case errors.Is(err, pqpool.ErrVersionLimit):
+		name = "VERSION_LIMIT"
+	case errors.Is(err, pqpool.ErrSponsorLimit):
+		name = "SPONSOR_PENDING_LIMIT"
+	case errors.Is(err, pqpool.ErrSponsorHorizon):
+		name = "SPONSOR_EXPIRED"
+	case errors.Is(err, pqpool.ErrSponsorBan):
+		name = "SPONSOR_BANNED"
+	case errors.Is(err, txpool.ErrAlreadyKnown), errors.Is(err, txpool.ErrReplaceUnderpriced):
+		name = "REPLACEMENT_UNDERPRICED"
+	case errors.Is(err, txpool.ErrUnderpriced):
+		name = "UNDERPRICED"
+	}
+	switch name {
+	case "SPONSOR_NOT_ACTIVATED":
+		name = "NOT_PQ_ACCOUNT"
+	case "PQ_TX_TOO_LARGE", "PQ_RESEARCH_SIZE_LIMIT":
+		name = "PROOF_TOO_LARGE"
+	}
+	if _, ok := pqSubmitCodes[name]; ok {
+		return pqProtocolFailure(name)
+	}
+	for _, stock := range []error{core.ErrTipAboveFeeCap, core.ErrFeeCapTooLow, core.ErrGasLimitTooHigh, core.ErrGasUintOverflow,
+		core.ErrIntrinsicGas, core.ErrGasLimitReached, core.ErrNonceTooLow, core.ErrNonceTooHigh, core.ErrInsufficientFunds, core.ErrInsufficientFundsForTransfer,
+		core.ErrNonceMax, core.ErrGasLimitOverflow, core.ErrFloorDataGas, core.ErrTipVeryHigh, core.ErrFeeCapVeryHigh, core.ErrSenderNoEOA,
+		types.ErrInvalidSig, txpool.ErrInvalidSender, txpool.ErrTxGasPriceTooLow, txpool.ErrAccountLimitExceeded, txpool.ErrGasLimit, txpool.ErrNegativeValue, txpool.ErrOversizedData, txpool.ErrAlreadyReserved, txpool.ErrInflightTxLimitReached} {
+		if errors.Is(err, stock) {
+			return pqSubmitFailure(-32003, "chain-state", "STOCK_REJECTION")
+		}
+	}
+	if name == "TX_GAS_CAP" || name == "GAS_LIMIT_TOO_LOW" {
+		return pqSubmitFailure(-32003, "chain-state", "STOCK_REJECTION")
+	}
+	// An opaque internal failure is not a cryptographic rejection.
+	return pqSubmitFailure(-32002, "local-unavailable", "LOCAL_UNAVAILABLE")
+}
diff --git a/internal/ethapi/pq_submit_test.go b/internal/ethapi/pq_submit_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..fe1aed4a4b771a2d2d982c71839c78aaba2963aa
--- /dev/null
+++ b/internal/ethapi/pq_submit_test.go
@@ -0,0 +1,290 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package ethapi
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"math/big"
+	"strings"
+	"testing"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/common/hexutil"
+	"github.com/ethereum/go-ethereum/core"
+	"github.com/ethereum/go-ethereum/core/txpool"
+	"github.com/ethereum/go-ethereum/core/txpool/pqpool"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/event"
+	"github.com/ethereum/go-ethereum/params"
+	"github.com/ethereum/go-ethereum/rlp"
+	"github.com/ethereum/go-ethereum/rpc"
+)
+
+// The API and serialization are real; SendTx outcomes are injected here.
+// Separate two-process integration exercises the actual pool and native proof.
+type pqSubmitBackend struct {
+	Backend
+	err   error
+	calls int
+	cap   float64
+}
+
+func (b *pqSubmitBackend) RPCTxFeeCap() float64                             { return b.cap }
+func (b *pqSubmitBackend) UnprotectedAllowed() bool                         { return true }
+func (b *pqSubmitBackend) SendTx(context.Context, *types.Transaction) error { b.calls++; return b.err }
+func (b *pqSubmitBackend) CurrentBlock() *types.Header {
+	return &types.Header{Number: big.NewInt(1), Time: 100}
+}
+func (b *pqSubmitBackend) ChainConfig() *params.ChainConfig { return params.AllDevChainProtocolChanges }
+
+func (b *pqSubmitBackend) GetCanonicalTransaction(common.Hash) (bool, *types.Transaction, common.Hash, uint64, uint64) {
+	return false, nil, common.Hash{}, 0, 0
+}
+func (b *pqSubmitBackend) GetPoolTransaction(common.Hash) *types.Transaction { return nil }
+func (b *pqSubmitBackend) TxIndexDone() bool                                 { return true }
+
+func TestPQSubmitRPCUnknownTransactionIsNull(t *testing.T) {
+	var marshaler json.Marshaler = (*RPCTransaction)(nil)
+	data, err := marshaler.MarshalJSON()
+	if err != nil || string(data) != "null" {
+		t.Fatalf("nil transaction: %s %v", data, err)
+	}
+	client := pqSubmitClient(t, new(pqSubmitBackend))
+	var result json.RawMessage
+	if err := client.CallContext(context.Background(), &result, "eth_getTransactionByHash", common.HexToHash("0x1234")); err != nil {
+		t.Fatal(err)
+	}
+	if string(result) != "null" {
+		t.Fatalf("unknown transaction: %s", result)
+	}
+}
+
+func pqSubmitTx() *types.Transaction {
+	return types.NewTx(&types.PQMigrateTx{ChainID: big.NewInt(13376), LegacyAddress: common.HexToAddress("0x1234"),
+		AlgID: 1, PQPKCommit: common.HexToHash("0xab"), Expiry: 1000, MaxAccountFee: big.NewInt(1000000000),
+		GasTipCap: big.NewInt(1), GasFeeCap: big.NewInt(2), Gas: 100000, VerifierVersion: 0x80000005,
+		ProofCarrier: types.PQMigrationCarrier{Proof: []byte{1, 2, 3}}})
+}
+func pqSubmitClient(t *testing.T, b *pqSubmitBackend) *rpc.Client {
+	t.Helper()
+	s := rpc.NewServer()
+	if err := s.RegisterName("eth", NewTransactionAPI(b, nil)); err != nil {
+		t.Fatal(err)
+	}
+	c := rpc.DialInProc(s)
+	t.Cleanup(func() { c.Close(); s.Stop() })
+	return c
+}
+func pqSubmitCall(t *testing.T, b *pqSubmitBackend, raw []byte) (json.RawMessage, error) {
+	t.Helper()
+	var result json.RawMessage
+	err := pqSubmitClient(t, b).CallContext(context.Background(), &result, "eth_sendRawTransaction", hexutil.Encode(raw))
+	return result, err
+}
+func pqSubmitAssert(t *testing.T, err error, outer int, class, reason string, code interface{}, culprit bool) {
+	t.Helper()
+	rpcErr, ok := err.(rpc.Error)
+	if !ok || rpcErr.ErrorCode() != outer {
+		t.Fatalf("outer: %v", err)
+	}
+	dataErr, ok := err.(rpc.DataError)
+	if !ok {
+		t.Fatalf("missing error data: %v", err)
+	}
+	d, ok := dataErr.ErrorData().(map[string]interface{})
+	if !ok || len(d) != 5 {
+		t.Fatalf("wrong data: %#v", dataErr.ErrorData())
+	}
+	if d["failureClass"] != class || d["reason"] != reason || d["protocolCode"] != code {
+		t.Fatalf("wrong mapped outcome: %#v", d)
+	}
+	if culprit {
+		c, ok := d["culprit"].(map[string]interface{})
+		if !ok || len(c) != 3 || c["kind"] != "close" || c["txHash"] != pqSubmitTx().Hash().Hex() || c["factHash"] != nil || d["pendingFetch"] != false {
+			t.Fatalf("wrong culprit: %#v", d)
+		}
+	} else {
+		var retained interface{}
+		if outer == -32003 || outer == -32005 {
+			retained = false
+		}
+		if d["culprit"] != nil || d["pendingFetch"] != retained {
+			t.Fatalf("wrong retention observation: %#v", d)
+		}
+	}
+	encoded, _ := json.Marshal(d)
+	if strings.Contains(string(encoded), "private-path") || strings.Contains(err.Error(), "private-path") {
+		t.Fatal("local diagnostic leaked")
+	}
+}
+
+func TestPQSubmitRPCOutcomes(t *testing.T) {
+	raw, _ := pqSubmitTx().MarshalBinary()
+	cases := []struct {
+		name          string
+		err           error
+		outer         int
+		class, reason string
+		code          interface{}
+		culprit       bool
+	}{
+		{"nonce", &core.PQMigrationError{Name: "WRONG_MIGRATION_NONCE", Code: 0x105}, -32003, "chain-state", "WRONG_MIGRATION_NONCE", "0x105", false},
+		{"proof", &core.PQMigrationError{Name: "INVALID_PROOF", Code: 0x402, Cause: core.ErrPQInvalidFullProof}, -32003, "cryptography", "INVALID_PROOF", "0x402", false},
+		{"wrapped", fmt.Errorf("private-path: %w", &core.PQMigrationError{Name: "FEE_CAP_EXCEEDED", Code: 0x301}), -32003, "chain-state", "FEE_CAP_EXCEEDED", "0x301", false},
+		{"worker", fmt.Errorf("%w: private-path", core.ErrPQFullUnavailable), -32002, "local-unavailable", "LOCAL_UNAVAILABLE", nil, false},
+		{"storage", fmt.Errorf("%w: private-path", pqpool.ErrLocalUnavailable), -32002, "local-unavailable", "LOCAL_UNAVAILABLE", nil, false},
+		{"unknown", errors.New("private-path or arbitrary future error"), -32002, "local-unavailable", "LOCAL_UNAVAILABLE", nil, false},
+		{"local-first", &core.PQMigrationError{Name: "INVALID_PROOF", Code: 0x402, Cause: core.ErrPQFullUnavailable}, -32002, "local-unavailable", "LOCAL_UNAVAILABLE", nil, false},
+		{"capacity", txpool.ErrOutOfCapacity, -32005, "bounds", "LOCAL_LIMIT", nil, false},
+		{"work", txpool.ErrPQBusy, -32005, "bounds", "LOCAL_LIMIT", nil, false},
+		{"source", fmt.Errorf("%w: private-path", txpool.ErrPQSourceBudget), -32005, "bounds", "LOCAL_LIMIT", nil, false},
+		{"version-limit", pqpool.ErrVersionLimit, -32003, "chain-state", "VERSION_LIMIT", "0x306", false},
+		{"cap", errors.New("TX_GAS_CAP"), -32003, "chain-state", "STOCK_REJECTION", nil, false},
+		{"known", txpool.ErrAlreadyKnown, -32003, "chain-state", "REPLACEMENT_UNDERPRICED", "0x304", false},
+		{"replacement", txpool.ErrReplaceUnderpriced, -32003, "chain-state", "REPLACEMENT_UNDERPRICED", "0x304", false},
+		{"intrinsic", fmt.Errorf("%w: have 1 want 2", core.ErrIntrinsicGas), -32003, "chain-state", "STOCK_REJECTION", nil, false},
+		{"tip", core.ErrTipAboveFeeCap, -32003, "chain-state", "STOCK_REJECTION", nil, false},
+		{"fee", core.ErrFeeCapTooLow, -32003, "chain-state", "STOCK_REJECTION", nil, false},
+		{"unsupported", core.ErrTxTypeNotSupported, -32004, "unsupported", "UNSUPPORTED_CAPABILITY", nil, false},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			b := &pqSubmitBackend{err: c.err}
+			result, err := pqSubmitCall(t, b, raw)
+			if b.calls != 1 || len(result) != 0 {
+				t.Fatalf("calls=%d result=%s", b.calls, result)
+			}
+			pqSubmitAssert(t, err, c.outer, c.class, c.reason, c.code, c.culprit)
+		})
+	}
+}
+
+func TestPQSubmitRPCSuccessAndNoRetry(t *testing.T) {
+	raw, _ := pqSubmitTx().MarshalBinary()
+	b := new(pqSubmitBackend)
+	result, err := pqSubmitCall(t, b, raw)
+	if err != nil || string(result) != fmt.Sprintf("%q", pqSubmitTx().Hash().Hex()) || b.calls != 1 {
+		t.Fatalf("%s %v calls %d", result, err, b.calls)
+	}
+	b.err = txpool.ErrAlreadyKnown
+	result, err = pqSubmitCall(t, b, raw)
+	if b.calls != 2 || len(result) != 0 {
+		t.Fatal("cached success or retry")
+	}
+	pqSubmitAssert(t, err, -32003, "chain-state", "REPLACEMENT_UNDERPRICED", "0x304", false)
+}
+
+func TestPQSubmitRPCDecodeAndUnsupported(t *testing.T) {
+	b := new(pqSubmitBackend)
+	_, err := pqSubmitCall(t, b, []byte{0x7e, 0xc0})
+	pqSubmitAssert(t, err, -32003, "packet-format", "NON_CANONICAL_ENCODING", "0x3", false)
+	p, _ := pqSubmitTx().AsPQMigrate()
+	p.ProofCarrier.Route = 1
+	p.LaneAuthOption = &types.PQMigrationLaneAuth{}
+	raw, _ := types.NewTx(p).MarshalBinary()
+	_, err = pqSubmitCall(t, b, raw)
+	pqSubmitAssert(t, err, -32004, "unsupported", "UNSUPPORTED_CAPABILITY", nil, false)
+	if b.calls != 0 {
+		t.Fatal("decode or unsupported invoked admission")
+	}
+}
+
+func TestPQSubmitRPCLocalFeeCap(t *testing.T) {
+	raw, _ := pqSubmitTx().MarshalBinary()
+	b := &pqSubmitBackend{cap: 1e-14}
+	_, err := pqSubmitCall(t, b, raw)
+	pqSubmitAssert(t, err, -32005, "bounds", "LOCAL_LIMIT", nil, false)
+	if b.calls != 0 {
+		t.Fatal("fee cap bypassed")
+	}
+}
+
+func TestPQSubmitRPCLegacyAndFrameworkUnchanged(t *testing.T) {
+	b := &pqSubmitBackend{err: errors.New("legacy diagnostic")}
+	tx := types.NewTx(&types.LegacyTx{GasPrice: big.NewInt(1), Gas: 21000, Value: big.NewInt(0), V: big.NewInt(27), R: big.NewInt(1), S: big.NewInt(1)})
+	raw, _ := tx.MarshalBinary()
+	_, err := pqSubmitCall(t, b, raw)
+	if err == nil || err.Error() != "legacy diagnostic" {
+		t.Fatalf("legacy behavior changed: %v", err)
+	}
+	var result json.RawMessage
+	err = pqSubmitClient(t, b).CallContext(context.Background(), &result, "eth_sendRawTransaction", "0x7eg")
+	if e, ok := err.(rpc.Error); !ok || e.ErrorCode() != -32602 || b.calls != 1 {
+		t.Fatalf("framework behavior changed: %v", err)
+	}
+}
+
+func (b *pqSubmitBackend) SubscribeChainEvent(ch chan<- core.ChainEvent) event.Subscription {
+	return event.NewSubscription(func(quit <-chan struct{}) error { <-quit; return nil })
+}
+
+func TestPQSubmitSyncUsesSameAdmissionAndFailures(t *testing.T) {
+	raw, _ := pqSubmitTx().MarshalBinary()
+	for _, method := range []string{"eth_sendRawTransaction", "eth_sendRawTransactionSync"} {
+		for _, failure := range []struct {
+			err          error
+			reason, code string
+		}{
+			{pqpool.ErrSponsorLimit, "SPONSOR_PENDING_LIMIT", "0x303"},
+			{pqpool.ErrSponsorHorizon, "SPONSOR_EXPIRED", "0x309"},
+			{pqpool.ErrSponsorBan, "SPONSOR_BANNED", "0x30a"},
+			{errors.New("SPONSOR_NOT_ACTIVATED"), "NOT_PQ_ACCOUNT", "0x106"},
+			{txpool.ErrUnderpriced, "UNDERPRICED", "0x305"},
+		} {
+			b := &pqSubmitBackend{err: failure.err}
+			var result json.RawMessage
+			err := pqSubmitClient(t, b).CallContext(context.Background(), &result, method, hexutil.Encode(raw))
+			pqSubmitAssert(t, err, -32003, "chain-state", failure.reason, failure.code, false)
+			if b.calls != 1 || len(result) != 0 {
+				t.Fatal("submission repeated or success fabricated")
+			}
+		}
+		for kind := byte(0x7b); kind <= 0x7f; kind++ {
+			b := new(pqSubmitBackend)
+			var result json.RawMessage
+			err := pqSubmitClient(t, b).CallContext(context.Background(), &result, method, hexutil.Encode([]byte{kind, 0xc0}))
+			pqSubmitAssert(t, err, -32003, "packet-format", "NON_CANONICAL_ENCODING", "0x3", false)
+			if b.calls != 0 {
+				t.Fatal("malformed input reached admission")
+			}
+		}
+	}
+}
+func TestPQSubmissionCanonicalUnsupportedStatement(t *testing.T) {
+	payload, _ := rlp.EncodeToBytes(pqStatementEnvelope{big.NewInt(13378), common.Hash{1}, 50000, 0x80000008, 1, []byte{1}})
+	for _, method := range []string{"eth_sendRawTransaction", "eth_sendRawTransactionSync"} {
+		b := new(pqSubmitBackend)
+		var result json.RawMessage
+		err := pqSubmitClient(t, b).CallContext(context.Background(), &result, method, hexutil.Encode(append([]byte{0x7b}, payload...)))
+		pqSubmitAssert(t, err, -32004, "unsupported", "UNSUPPORTED_CAPABILITY", nil, false)
+		if b.calls != 0 {
+			t.Fatal("unsupported lane reached pool")
+		}
+	}
+}
+func TestPQSignedStockDuplicateAndProtocolClasses(t *testing.T) {
+	for _, kind := range []byte{0x7c, 0x7d} {
+		for _, err := range []error{txpool.ErrAlreadyKnown, txpool.ErrUnderpriced, txpool.ErrReplaceUnderpriced} {
+			got := mapPQTransactionError(err, kind).(*pqSubmitError)
+			if got.code != -32003 || got.data.Reason != "STOCK_REJECTION" || got.data.ProtocolCode != nil {
+				t.Fatalf("stock: %+v", got)
+			}
+		}
+	}
+	for _, c := range []struct {
+		name, class string
+		code        uint16
+	}{
+		{"WRONG_VERIFIER_VERSION", "chain-state", 6}, {"UNSUPPORTED_PQ_SCHEME", "chain-state", 7},
+		{"PROOF_TOO_LARGE", "bounds", 8}, {"LANE_MEMBER_INVALID", "packet-format", 0x602}, {"LANE_KEY_MISMATCH", "cryptography", 0x603},
+	} {
+		got := mapPQSubmitError(&core.PQMigrationError{Name: c.name, Code: c.code}, nil).(*pqSubmitError)
+		if got.code != -32003 || got.data.FailureClass != c.class || uint16(*got.data.ProtocolCode) != c.code {
+			t.Fatalf("class: %+v", got)
+		}
+	}
+}
diff --git a/internal/ethapi/pq_unsupported.go b/internal/ethapi/pq_unsupported.go
new file mode 100644
index 0000000000000000000000000000000000000000..7320218712f253d1ad543c7e58ac752942477ca8
--- /dev/null
+++ b/internal/ethapi/pq_unsupported.go
@@ -0,0 +1,90 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package ethapi
+
+import (
+	"bytes"
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/rlp"
+	"math/big"
+)
+
+// These are decoding-only envelopes. This research client enables neither a
+// Route B verifier nor aggregation. It never retains or executes these types.
+type pqStatementEnvelope struct {
+	ChainID       *big.Int
+	LaneID        common.Hash
+	Gas           uint64
+	Version       uint32
+	StatementType uint16
+	Statement     []byte
+}
+type pqBatchEntry struct {
+	Address      common.Address
+	Nonce        uint64
+	AlgID        uint8
+	Commitment   common.Hash
+	Expiry       uint64
+	MaxFee       *big.Int
+	FeeMode      uint8
+	FeeSponsor   common.Address
+	FeeAuthUntil uint64
+}
+type pqBatchEnvelope struct {
+	ChainID    *big.Int
+	Sponsor    common.Address
+	Nonce      uint64
+	ValidUntil uint64
+	Signature  []byte
+	Tip        *big.Int
+	Fee        *big.Int
+	Gas        uint64
+	Version    uint32
+	Entries    []pqBatchEntry
+	Carrier    types.PQMigrationCarrier
+}
+
+func pqU256(x *big.Int) bool { return x != nil && x.Sign() >= 0 && x.BitLen() <= 256 }
+func rejectUnimplementedPQEnvelope(input []byte) error {
+	malformed := func() error { return pqProtocolFailure("NON_CANONICAL_ENCODING") }
+	var canonical []byte
+	if input[0] == 0x7b {
+		var p pqStatementEnvelope
+		if rlp.DecodeBytes(input[1:], &p) != nil || !pqU256(p.ChainID) {
+			return malformed()
+		}
+		canonical, _ = rlp.EncodeToBytes(p)
+	} else {
+		var p pqBatchEnvelope
+		if rlp.DecodeBytes(input[1:], &p) != nil || !pqU256(p.ChainID) || !pqU256(p.Tip) || !pqU256(p.Fee) || len(p.Entries) == 0 || len(p.Entries) > 65535 {
+			return malformed()
+		}
+		seen := make(map[common.Address]bool)
+		var maxExpiry uint64
+		for _, entry := range p.Entries {
+			if seen[entry.Address] || entry.Address == p.Sponsor || entry.Commitment == (common.Hash{}) || !pqU256(entry.MaxFee) {
+				return malformed()
+			}
+			seen[entry.Address] = true
+			if entry.Expiry > maxExpiry {
+				maxExpiry = entry.Expiry
+			}
+			if entry.FeeMode == 0 || entry.FeeMode > 3 || entry.FeeAuthUntil > entry.Expiry {
+				return malformed()
+			}
+			if entry.FeeMode == 1 && entry.FeeSponsor == (common.Address{}) || entry.FeeMode != 1 && entry.FeeSponsor != (common.Address{}) || entry.FeeMode == 2 && entry.FeeAuthUntil != 0 {
+				return malformed()
+			}
+		}
+		if p.ValidUntil > maxExpiry {
+			return malformed()
+		}
+		canonical, _ = rlp.EncodeToBytes(p)
+	}
+	if !bytes.Equal(canonical, input[1:]) {
+		return malformed()
+	}
+	return pqSubmitFailure(-32004, "unsupported", "UNSUPPORTED_CAPABILITY")
+}
