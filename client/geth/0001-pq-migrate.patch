+			p.FeeMode, p.FeeSponsor, p.FeeAuthUntil = v.mode, v.payee, v.until
+			plan, e := validatePQMigrateState(finalStateSign(t, p, 0x22), s.Copy(), h, cfg)
+			if e != nil || plan.reimbursement.Uint64() != v.want {
+				t.Fatalf("fee %v plan %v", e, plan)
+			}
+		})
+	}
+	for _, v := range []struct {
+		name     string
+		mode     uint8
+		same     bool
+		boundary string
+		wantGas  uint64
+		wantErr  string
+	}{
+		{"override_changed", 1, false, "", 10000, ""}, {"override_same", 1, true, "", 7200, ""}, {"recommit_changed", 2, false, "", 10000, ""}, {"recommit_same", 2, true, "", 7200, ""}, {"override_before_end", 1, false, "before", 10000, ""}, {"override_at_end", 1, false, "at", 0, "OVERRIDE_WINDOW_CLOSED"},
+	} {
+		t.Run(v.name, func(t *testing.T) {
+			cfg := finalStateConfigCopy(cfg)
+			ss := s.Copy()
+			hh := *h
+			p := finalStateCarrier()
+			p.MigrationNonce = 1
+			commit := common.HexToHash("99")
+			if v.same {
+				commit = finalStateCommit
+			}
+			r := PQRecord{Mode: v.mode, AlgID: 1, EnrolledAt: h.Time - 100, MigrationNonce: 1, Commit: commit}
+			writePQRecord(ss, cfg.PQMigrate.Registry, finalStateLegacy, r)
