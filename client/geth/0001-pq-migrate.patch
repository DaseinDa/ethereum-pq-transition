+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+// Public-test attack fixture: a valid old ML-DSA signature loses authority after seed override.
+// Actual native F proof; no accepting proof stub, no cached admission substituted for execution.
+
+package miner
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
