+++ b/eth/protocols/eth/pq_batch_request_test.go
@@ -0,0 +1,64 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package eth
+
+import (
+	"math/big"
+	"testing"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/params"
+	"github.com/ethereum/go-ethereum/rlp"
+)
+
+// This is a framing and request-binding test, not a proof-validity claim.
+func TestPQBatchRequestedResponseCodec(t *testing.T) {
+	b := &types.PQBatchTx{ChainID: big.NewInt(13378), Sponsor: common.Address{0xff},
+		SponsorValidUntil: 1000, GasTipCap: big.NewInt(1), GasFeeCap: big.NewInt(2),
+		Gas: params.MaxTxGas, VerifierVersion: params.PQFinalVersion,
+		SponsorSignature: make([]byte, 2420), ProofCarrier: types.PQMigrationCarrier{Proof: make([]byte, 187797)}}
+	for i := byte(1); i <= 4; i++ {
+		b.Entries = append(b.Entries, types.PQBatchEntry{LegacyAddress: common.Address{i},
+			AlgID: 1, PQPKCommit: common.Hash{i}, Expiry: 1000, MaxAccountFee: new(big.Int), FeeMode: 2})
+	}
+	tx := types.NewTx(b)
+	cfg := *params.AllDevChainProtocolChanges
+	cfg.PQMigrate = &params.PQMigrateConfig{FullResearch: &params.PQFullResearchConfig{},
+		AggregateResearch: &params.PQAggregateResearchConfig{MaxTxBytes: params.PQAggregateMaxTxBytes}}
+	p := &Peer{chainConfig: &cfg, fullRequests: make(map[uint64]*fullProofRequest)}
+	list := new(rlp.RawList[*types.Transaction])
+	if err := list.Append(tx); err != nil {
+		t.Fatal(err)
+	}
+	encoded, err := rlp.EncodeToBytes(&PooledTransactionsPacket{RequestId: 1, List: *list})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(encoded) <= 128<<10 || len(encoded) > maxMessageSize {
+		t.Fatal("incorrect packet size", len(encoded))
+	}
+	var packet PooledTransactionsPacket
+	if err := rlp.DecodeBytes(encoded, &packet); err != nil {
+		t.Fatal(err)
+	}
+	items, err := packet.List.Items()
+	if err != nil || len(items) != 1 || items[0].Hash() != tx.Hash() {
+		t.Fatal("batch wire roundtrip", err)
+	}
+	if err := p.validateFullResponse(1, items); err == nil {
+		t.Fatal("unrequested batch accepted")
+	}
+	p.trackFullRequest(2, []common.Hash{tx.Hash()})
+	if err := p.validateFullResponse(2, items); err != nil {
+		t.Fatal(err)
+	}
+	if err := p.validateFullResponse(2, items); err == nil {
+		t.Fatal("batch response replay accepted")
+	}
+	p.trackFullRequest(3, []common.Hash{common.Hash{1}})
+	if err := p.validateFullResponse(3, items); err == nil {
+		t.Fatal("unrequested batch hash accepted")
+	}
+}
diff --git a/eth/protocols/eth/pq_delivery_clock_test.go b/eth/protocols/eth/pq_delivery_clock_test.go
