+func row7Reset(t *testing.T, p *LegacyPool, timestamp uint64) {
+	t.Helper()
+	h := types.CopyHeader(p.currentHead.Load())
+	h.Time = timestamp
+	if h.BaseFee == nil {
+		h.BaseFee = big.NewInt(1)
+	}
+	<-p.requestReset(nil, h)
+	if e := validatePoolInternals(p); e != nil {
+		t.Fatal(e)
+	}
+}
+func row7Add(t *testing.T, p *LegacyPool, txs ...*types.Transaction) {
+	t.Helper()
+	for _, e := range p.addRemotesSync(txs) {
+		if e != nil {
+			t.Fatal(e)
+		}
+	}
+}
+func TestPQLegacyResetFreezeAndRollback(t *testing.T) {
+	for _, kind := range []byte{types.LegacyTxType, types.DynamicFeeTxType} {
+		t.Run(big.NewInt(int64(kind)).String(), func(t *testing.T) {
+			cfg := *params.TestChainConfig
+			cfg.PQMigrate = &params.PQMigrateConfig{T0: 100, T: 2000, PoolSlotSeconds: 12, Registry: common.HexToAddress("800")}
+			p, key := setupPoolWithConfig(&cfg)
+			defer p.Close()
+			sender := crypto.PubkeyToAddress(key.PublicKey)
+			p.currentState.SetBalance(sender, uint256.NewInt(1000000000), tracing.BalanceChangeUnspecified)
+			row7Reset(t, p, cfg.PQMigrate.T-13)
+			makeTx := func(n uint64) *types.Transaction {
+				if kind == types.LegacyTxType {
+					return transaction(n, 21000, key)
+				}
+				tx, e := types.SignTx(types.NewTx(&types.DynamicFeeTx{ChainID: cfg.ChainID, Nonce: n, GasTipCap: big.NewInt(1), GasFeeCap: big.NewInt(1), Gas: 21000, To: &common.Address{}, Value: big.NewInt(100)}), types.LatestSignerForChainID(cfg.ChainID), key)
+				if e != nil {
+					t.Fatal(e)
+				}
+				return tx
+			}
+			txs := []*types.Transaction{makeTx(0), makeTx(1), makeTx(10)}
+			row7Add(t, p, txs...)
+			if pending, queued := p.Stats(); pending != 2 || queued != 1 {
+				t.Fatalf("setup %d/%d", pending, queued)
+			}
+			row7Reset(t, p, cfg.PQMigrate.T-12)
+			if pending, queued := p.Stats(); pending != 0 || queued != 0 {
+				t.Fatalf("T clock retained pending=%d queued=%d", pending, queued)
+			}
+			for _, tx := range txs {
+				if p.Get(tx.Hash()) != nil {
+					t.Fatal("lookup retained invalid tx")
+				}
+			}
+			if e := p.addRemotesSync(txs[:1])[0]; !errors.Is(e, core.ErrECDSADisabled) {
+				t.Fatalf("frozen admission: %v", e)
+			}
+			row7Reset(t, p, cfg.PQMigrate.T-13)
+			row7Add(t, p, txs...)
+			if pending, queued := p.Stats(); pending != 2 || queued != 1 {
+				t.Fatalf("rollback readmission %d/%d", pending, queued)
+			}
+			row7Reset(t, p, cfg.PQMigrate.T+12)
+			if pending, queued := p.Stats(); pending+queued != 0 {
+				t.Fatal("second freeze retained old authority")
+			}
+		})
+	}
+}
+
+func TestPQLegacyResetEnrollmentAndRollback(t *testing.T) {
+	cfg := *params.TestChainConfig
+	cfg.PQMigrate = &params.PQMigrateConfig{T0: 100, T: 2000, PoolSlotSeconds: 12, Registry: common.HexToAddress("800")}
+	p, key := setupPoolWithConfig(&cfg)
+	defer p.Close()
+	other, e := crypto.GenerateKey()
+	if e != nil {
+		t.Fatal(e)
+	}
+	for _, k := range []*ecdsa.PrivateKey{key, other} {
+		p.currentState.SetBalance(crypto.PubkeyToAddress(k.PublicKey), uint256.NewInt(1000000000), tracing.BalanceChangeUnspecified)
+	}
+	row7Reset(t, p, 200)
+	dead := []*types.Transaction{transaction(0, 21000, key), transaction(10, 21000, key)}
+	live := []*types.Transaction{transaction(0, 21000, other), transaction(10, 21000, other)}
+	row7Add(t, p, append(dead, live...)...)
+	slot, _ := core.PQRecordSlots(crypto.PubkeyToAddress(key.PublicKey))
+	p.currentState.SetState(cfg.PQMigrate.Registry, slot, common.BigToHash(big.NewInt(1)))
+	row7Reset(t, p, 212)
+	for _, tx := range dead {
+		if p.Get(tx.Hash()) != nil {
+			t.Fatal("enrolled sender retained")
+		}
+	}
+	for _, tx := range live {
+		if p.Get(tx.Hash()) == nil {
+			t.Fatal("unrelated sender evicted")
+		}
+	}
+	p.currentState.SetState(cfg.PQMigrate.Registry, slot, common.Hash{})
+	row7Reset(t, p, 200)
+	row7Add(t, p, dead...)
+	if pending, queued := p.Stats(); pending != 2 || queued != 2 {
+		t.Fatalf("rollback %d/%d", pending, queued)
+	}
+}
+
+// ML-DSA envelopes share LegacyPool; freezing old authority must preserve them.
+// Use real signatures and normal admission, including a nonce-gapped entry.
+func TestPQLegacyResetPreservesPQ(t *testing.T) {
+	cfg := *params.TestChainConfig
+	cfg.PQMigrate = &params.PQMigrateConfig{T0: 100, T: 2000, PoolSlotSeconds: 12, Registry: common.HexToAddress("800"), MaxPayloadBytes: 1048576}
+	p, _ := setupPoolWithConfig(&cfg)
+	defer p.Close()
+	seed := [mldsa44.SeedSize]byte{0x71}
+	pk, sk := mldsa44.NewKeyFromSeed(&seed)
+	addr := common.BytesToAddress(crypto.Keccak256([]byte("PQ-ADDR"), []byte{1}, pk.Bytes())[12:])
+	p.currentState.SetBalance(addr, uint256.NewInt(1000000000), tracing.BalanceChangeUnspecified)
+	row7Reset(t, p, 200)
+	var txs []*types.Transaction
+	for _, nonce := range []uint64{0, 10} {
+		pq := &types.PQTx{ChainID: cfg.ChainID, From: addr, Nonce: nonce, GasTipCap: big.NewInt(1), GasFeeCap: big.NewInt(1), Gas: 1000000, Value: new(big.Int), AlgID: 1, PublicKey: [][]byte{pk.Bytes()}, Signature: make([]byte, mldsa44.SignatureSize)}
+		digest := pq.SigningHash()
+		tag := []byte("ETH-PQ-TX/v1")
+		if err := mldsa44.SignTo(sk, append(append([]byte{}, tag...), digest[:]...), tag, false, pq.Signature); err != nil {
+			t.Fatal(err)
+		}
+		txs = append(txs, types.NewTx(pq))
+	}
+	row7Add(t, p, txs...)
+	for _, timestamp := range []uint64{cfg.PQMigrate.T - 12, cfg.PQMigrate.T + 12, 200} {
+		row7Reset(t, p, timestamp)
+		for _, tx := range txs {
+			if p.Get(tx.Hash()) == nil {
+				t.Fatal("PQ transaction evicted by old-authority reset")
+			}
+		}
+		if pending, queued := p.Stats(); pending != 1 || queued != 1 {
+			t.Fatalf("PQ pending/queued %d/%d", pending, queued)
+		}
+	}
+}
