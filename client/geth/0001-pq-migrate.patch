+func CheckPQAggregateConfig(c *params.PQMigrateConfig) error {
+	if c == nil || c.AggregateResearch == nil {
+		return nil
+	}
+	if c.FullResearch == nil || c.FullResearch.Backend != params.PQFinalBackend {
+		return fmt.Errorf("aggregate requires the pinned input F profile")
+	}
+	if e := c.AggregateResearch.Validate(); e != nil {
+		return e
+	}
+	key, status := pqAggregateReady()
+	if common.HexToHash(key) != params.PQAggregateKey || status != 0 {
+		return fmt.Errorf("%w: aggregate native key/readiness", ErrPQFullUnavailable)
+	}
+	return nil
+}
+func ValidatePQBatchProof(tx *types.Transaction, c *params.ChainConfig) error {
+	b, ok := tx.AsPQBatch()
+	if !ok || c == nil || c.PQMigrate == nil || c.PQMigrate.AggregateResearch == nil {
+		return ErrTxTypeNotSupported
+	}
+	if e := b.ValidateShape(); e != nil {
+		return pqMigrateError("NON_CANONICAL_ENCODING", 3)
+	}
+	if b.VerifierVersion != params.PQFinalVersion || b.ProofCarrier.Route != 0 {
+		return pqMigrateError("WRONG_VERIFIER_VERSION", 6)
+	}
+	if uint64(len(b.ProofCarrier.Proof)) > params.PQFinalMaxProofBytes {
+		return pqMigrateError("PROOF_TOO_LARGE", 8)
+	}
+	start := time.Now()
+	status := pqAggregateVerify(b.ProofCarrier.Proof, b.PublicInputs())
+	log.Info("PQ_C_NATIVE_RESULT", "tx", tx.Hash(), "batch", b.BatchID(), "status", status, "verifyElapsed", time.Since(start))
+	switch status {
+	case 0:
+		return nil
+	case 1, 2:
+		return pqMigrateError("INVALID_PROOF", 0x0402)
+	default:
+		return fmt.Errorf("%w: C native status %d", ErrPQFullUnavailable, status)
+	}
+}
+
+type pqBatchPlan struct {
+	old, next []PQRecord
+	skip      []uint16
+	used      uint64
+}
+
+// Entry failures are the closed E-class list, in checks 4,5,6 order. No
+// reimbursement, signature, lifetime upper bound or proof check can skip an entry.
+func pqBatchEntryCheck(e types.PQBatchEntry, r PQRecord, code []byte, h *types.Header, c *params.PQMigrateConfig) (uint16, error) {
+	if h.Time > e.Expiry {
+		return 0x0201, nil
+	}
+	err := validatePQMigrateOwnerState(&types.PQMigrateTx{MigrationNonce: e.MigrationNonce}, r, code, h.Time, c)
+	if err == nil {
+		return 0, nil
+	}
+	var failure *PQMigrationError
+	if errors.As(err, &failure) {
+		switch failure.Code {
+		case 0x0001, 0x0102, 0x0103, 0x0104, 0x0105:
+			return failure.Code, nil
+		}
+	}
+	return 0, err
+}
+
+// Nonce is exact for execution. Admission supplies the sequence's expected
+// nonce through a disposable state overlay, never by weakening this check.
+func validatePQBatch(tx *types.Transaction, s vm.StateDB, h *types.Header, c *params.ChainConfig, admission bool, checkSig pqSignatureCheck) (*pqBatchPlan, error) {
+	b, ok := tx.AsPQBatch()
+	if !ok {
+		return nil, ErrTxTypeNotSupported
+	}
+	fail := func(name string, code uint16) (*pqBatchPlan, error) { return nil, pqMigrateError(name, code) }
+	if c == nil || c.PQMigrate == nil || h.Time < c.PQMigrate.T0 {
+		return fail("FORK_NOT_ACTIVE", 1)
+	}
+	if b.ValidateShape() != nil {
+		return fail("NON_CANONICAL_ENCODING", 3)
+	}
+	cfg := c.PQMigrate
+	f := cfg.FullResearch
+	a := cfg.AggregateResearch
+	if a == nil || f == nil {
+		return nil, ErrTxTypeNotSupported
+	}
+	if c.IsAmsterdam(h.Number, h.Time) || c.IsEIP4762(h.Number, h.Time) || !c.IsOsaka(h.Number, h.Time) {
+		return nil, errors.New("PQ_RESEARCH_UNSUPPORTED_FORK")
+	}
+	if uint64(len(b.Entries)) != a.NMax {
+		return fail("NON_CANONICAL_ENCODING", 3)
+	}
+	if tx.Size() > a.MaxTxBytes {
+		return fail("NON_CANONICAL_ENCODING", 3)
+	}
+	if uint64(len(b.ProofCarrier.Proof)) > f.MaxProofBytes {
+		return fail("PROOF_TOO_LARGE", 8)
+	}
+	if b.ChainID.Cmp(c.ChainID) != 0 {
+		return fail("WRONG_CHAIN_ID", 4)
+	}
+	if b.VerifierVersion != f.Version || h.Time < f.Activation || h.Time >= f.Sunset || b.ProofCarrier.Route != 0 {
+		return fail("WRONG_VERIFIER_VERSION", 6)
+	}
+	for _, e := range b.Entries {
+		if e.AlgID != 1 {
+			return fail("UNSUPPORTED_PQ_SCHEME", 7)
+		}
+	}
+	pqWarm(s, cfg.Registry, b.Sponsor, true)
+	if !PQActivated(s, cfg, b.Sponsor) {
+		return fail("NOT_PQ_ACCOUNT", 0x0106)
+	}
+	if h.Time > b.SponsorValidUntil {
+		return fail("SPONSOR_EXPIRED", 0x0309)
+	}
+	if b.SponsorNonce == math.MaxUint64 || s.GetNonce(b.Sponsor) != b.SponsorNonce {
+		return fail("WRONG_SPONSOR_NONCE", 0x0308)
+	}
+	if b.Gas > params.MaxTxGas || b.Gas > f.TxGasCap {
+		return nil, ErrGasLimitTooHigh
+	}
+	if b.GasTipCap.Cmp(b.GasFeeCap) > 0 {
+		return nil, ErrTipAboveFeeCap
+	}
+	if h.BaseFee != nil && b.GasFeeCap.Cmp(h.BaseFee) < 0 {
+		return nil, ErrFeeCapTooLow
+	}
+	need := new(big.Int).Mul(new(big.Int).SetUint64(b.Gas), b.GasFeeCap)
+	if need.BitLen() > 256 || s.GetBalance(b.Sponsor).CmpBig(need) < 0 {
+		return fail("INSUFFICIENT_FEE_BALANCE", 0x0302)
+	}
+	plan := &pqBatchPlan{old: make([]PQRecord, len(b.Entries)), next: make([]PQRecord, len(b.Entries)), skip: make([]uint16, len(b.Entries))}
+	var actual, worst uint64
+	for i, e := range b.Entries {
+		pqWarm(s, cfg.Registry, e.LegacyAddress, true)
+		r := ReadPQRecord(s, cfg.Registry, e.LegacyAddress)
+		plan.old[i] = r
+		next := PQRecord{Mode: 2, AlgID: e.AlgID, EnrolledAt: r.EnrolledAt, MigrationNonce: r.MigrationNonce + 1, Commit: e.PQPKCommit}
+		plan.next[i] = next
+		code, err := pqBatchEntryCheck(e, r, s.GetCode(e.LegacyAddress), h, cfg)
+		if err != nil {
+			return nil, err
+		}
+		plan.skip[i] = code
+		writes := pqColdWriteGas(pqRecordWord(r), pqRecordWord(next)) + pqColdWriteGas(r.Commit, next.Commit)
+		worst += writes
+		if code == 0 {
+			actual += writes
+		}
+		if admission && (code != 0 || e.Expiry-h.Time > f.ProofLifetime) {
+			return fail("BATCH_ENTRY_NOT_ADMISSIBLE", 0x0307)
+		}
+	}
+	entries, err := rlp.EncodeToBytes(b.Entries)
+	if err != nil {
+		return nil, err
+	}
+	var tokens uint64
+	for _, data := range [][]byte{entries, b.SponsorSignature, b.ProofCarrier.Proof} {
+		for _, v := range data {
+			if v == 0 {
+				tokens++
+			} else {
+				tokens += 4
+			}
+		}
+	}
+	// Guard the worst-case writes once; actual writes never exceed them.
+	// This mirrors the checked 0x7e gas calculation before either formula.
+	if a.VerifyGas > math.MaxUint64-21000-PQSignatureGas-worst || tokens > (math.MaxUint64-21000-a.VerifyGas-PQSignatureGas-worst)/10 {
+		return nil, ErrGasUintOverflow
+	}
+	gas := func(w uint64) uint64 { return 21000 + max(4*tokens+a.VerifyGas+PQSignatureGas+w, 10*tokens) }
+	if b.Gas < gas(worst) {
+		return nil, fmt.Errorf("%w: have %d want %d", ErrIntrinsicGas, b.Gas, gas(worst))
+	}
+	plan.used = gas(actual)
+	if !checkSig(c, h, s.GetCode(b.Sponsor)[3:], "ETH-PQ-SPONSOR/v1", b.SponsorSigningHash(), b.SponsorSignature) {
+		return fail("BAD_SPONSOR_SIG", 0x0403)
+	}
+	return plan, nil
+}
+func ValidatePQBatchState(tx *types.Transaction, s *state.StateDB, h *types.Header, c *params.ChainConfig, admission bool) error {
+	_, e := validatePQBatch(tx, s, h, c, admission, verifyPQMigrationSignatureAt)
+	return e
+}
+func applyPQBatch(evm *vm.EVM, msg *Message, gp *GasPool) (*ExecutionResult, error) {
+	tx := msg.PQTransaction
+	b, _ := tx.AsPQBatch()
+	s := evm.StateDB
+	c := evm.ChainConfig()
+	s.Prepare(evm.GetRules(), b.Sponsor, evm.Context.Coinbase, tx.To(), vm.ActivePrecompiles(evm.GetRules()), nil)
+	snap := s.Snapshot()
+	h := &types.Header{Number: evm.Context.BlockNumber, Time: evm.Context.Time, BaseFee: evm.Context.BaseFee, Difficulty: new(big.Int), Coinbase: evm.Context.Coinbase}
+	plan, err := validatePQBatch(tx, s, h, c, false, verifyPQMigrationSignatureInBlock)
+	if err == nil {
+		err = ValidatePQBatchProof(tx, c)
+	}
+	if err != nil {
+		s.RevertToSnapshot(snap)
+		return nil, err
+	}
+	gasSnap := gp.Snapshot()
+	if err = gp.CheckGasLegacy(b.Gas); err == nil {
+		err = gp.ChargeGasLegacy(b.Gas-plan.used, plan.used)
+	}
+	if err != nil {
+		gp.Set(gasSnap)
+		s.RevertToSnapshot(snap)
+		return nil, err
+	}
+	applyPQBatchPlan(s, tx, h, c.PQMigrate, plan)
+	return &ExecutionResult{UsedGas: plan.used, MaxUsedGas: plan.used}, nil
+}
+
+// Apply an already validated plan. Keeping settlement and ordered entry writes
+// together permits state-only fee/skip vectors without bypassing native proof
+// verification in ApplyMessage or block import.
+func applyPQBatchPlan(s vm.StateDB, tx *types.Transaction, h *types.Header, cfg *params.PQMigrateConfig, plan *pqBatchPlan) {
+	b, _ := tx.AsPQBatch()
+	price := tx.EffectiveGasTipValue(h.BaseFee)
+	if h.BaseFee != nil {
+		price.Add(price, h.BaseFee)
+	}
+	s.SubBalance(b.Sponsor, new(uint256.Int).Mul(uint256.NewInt(b.Gas), uint256.MustFromBig(price)), tracing.BalanceDecreaseGasBuy)
+	s.SetNonce(b.Sponsor, b.SponsorNonce+1, tracing.NonceChangeEoACall)
+	for i, e := range b.Entries {
+		if code := plan.skip[i]; code != 0 {
+			data := make([]byte, 64)
+			binary.BigEndian.PutUint32(data[28:32], uint32(i))
+			binary.BigEndian.PutUint16(data[62:64], code)
+			s.AddLog(&types.Log{Address: cfg.Registry, Topics: []common.Hash{crypto.Keccak256Hash([]byte("BatchEntrySkipped(uint32,address,uint16)")), common.BytesToHash(e.LegacyAddress[:])}, Data: data})
+			continue
+		}
+		if h.Time <= e.FeeAuthUntil && (e.FeeMode == 3 || (e.FeeMode == 1 && e.FeeSponsor == b.Sponsor)) {
+			fee := new(uint256.Int).Set(s.GetBalance(e.LegacyAddress))
+			cap := uint256.MustFromBig(e.MaxAccountFee)
+			if fee.Cmp(cap) > 0 {
+				fee.Set(cap)
+			}
+			if !fee.IsZero() {
+				s.SubBalance(e.LegacyAddress, fee, tracing.BalanceChangeTransfer)
+				s.AddBalance(b.Sponsor, fee, tracing.BalanceChangeTransfer)
+			}
+		}
+		writePQRecord(s, cfg.Registry, e.LegacyAddress, plan.next[i])
+		s.SetCode(e.LegacyAddress, nil, tracing.CodeChangeUnspecified)
+		data := make([]byte, 160)
+		data[31] = e.AlgID
+		copy(data[32:64], e.PQPKCommit[:])
+		binary.BigEndian.PutUint64(data[88:96], plan.next[i].MigrationNonce)
+		if plan.old[i].Mode == 1 {
+			data[127] = 1
+		}
+		if plan.old[i].Mode == 2 {
+			data[159] = 1
+		}
+		s.AddLog(&types.Log{Address: cfg.Registry, Topics: []common.Hash{crypto.Keccak256Hash([]byte("Migrated(address,uint8,bytes32,uint64,bool,bool)")), common.BytesToHash(e.LegacyAddress[:])}, Data: data})
+	}
+	s.AddBalance(b.Sponsor, new(uint256.Int).Mul(uint256.NewInt(b.Gas-plan.used), uint256.MustFromBig(price)), tracing.BalanceIncreaseGasReturn)
+	tip := new(big.Int).Set(price)
+	if h.BaseFee != nil {
+		tip.Sub(tip, h.BaseFee)
+	}
+	s.AddBalance(h.Coinbase, new(uint256.Int).Mul(uint256.NewInt(plan.used), uint256.MustFromBig(tip)), tracing.BalanceIncreaseRewardTransactionFee)
+}
