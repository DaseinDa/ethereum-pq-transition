+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package core
+
+import (
+	"bytes"
+	"math/big"
+	"testing"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/consensus/beacon"
+	"github.com/ethereum/go-ethereum/consensus/ethash"
+	"github.com/ethereum/go-ethereum/core/rawdb"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/crypto"
+	"github.com/ethereum/go-ethereum/params"
+)
+
+// The 128-KiB propagation limit is pool policy. A builder can receive a larger
+// transaction directly, and block import must apply the consensus gas limit.
+func TestPQLargePayloadBlockImport(t *testing.T) {
+	cfg := nativeTestChain()
+	cfg.PQMigrate.FullResearch = finalTestProfile()
+	if err := cfg.CheckConfigForkOrder(); err != nil {
+		t.Fatal(err)
+	}
+	pk, sk := pqSeedKey(0xb2) // Public synthetic test seed.
+	owner := common.BytesToAddress(crypto.Keccak256([]byte("PQ-ADDR"), []byte{1}, pk.Bytes())[12:])
+	recipient := common.HexToAddress("0xb202")
+	sign := func(nonce uint64, data []byte, activate bool) *types.Transaction {
+		p := &types.PQTx{
+			ChainID: cfg.ChainID, From: owner, Nonce: nonce,
+			GasTipCap: big.NewInt(params.GWei), GasFeeCap: big.NewInt(10 * params.GWei),
+			Gas: 8000000, To: recipient, Value: new(big.Int), AlgID: 1, Data: data,
+		}
+		if activate {
+			p.PublicKey = [][]byte{pk.Bytes()}
+		} else {
+			p.Value = big.NewInt(7)
+		}
+		p.Signature = pqSignTag(t, sk, "ETH-PQ-TX/v1", p.SigningHash())
+		return types.NewTx(p)
+	}
+	activation := sign(0, nil, true)
+	large := sign(1, bytes.Repeat([]byte{1}, int(cfg.PQMigrate.MaxPayloadBytes)+1), false)
+	if uint64(large.Size()) <= cfg.PQMigrate.MaxPayloadBytes || large.Gas() > params.MaxTxGas {
+		t.Fatal("fixture must exceed propagation policy while remaining within the transaction gas cap")
+	}
+	genesis := &Genesis{
+		Config: cfg, GasLimit: 30000000,
+		Alloc: withSystemContracts(types.GenesisAlloc{
+			owner:                      {Balance: new(big.Int).Mul(big.NewInt(10), big.NewInt(params.Ether))},
+			cfg.PQMigrate.Registry:     {Balance: new(big.Int), Code: []byte{0}, Nonce: 1},
+			cfg.PQMigrate.FactRegistry: {Balance: new(big.Int), Code: []byte{0}, Nonce: 1},
+		}),
+	}
+	engine := beacon.New(ethash.NewFaker())
+	db, blocks, _ := GenerateChainWithGenesis(genesis, engine, 2, func(i int, b *BlockGen) {
+		if i == 0 {
+			b.AddTx(activation)
+		} else {
+			b.AddTx(large)
+		}
+	})
+	defer db.Close()
+	chain, err := NewBlockChain(rawdb.NewMemoryDatabase(), genesis, engine, &BlockChainConfig{ArchiveMode: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer chain.Stop()
+	if _, err := chain.InsertChain(blocks); err != nil {
+		t.Fatalf("valid large 0x7c rejected at import: %v", err)
+	}
+	state, err := chain.StateAt(blocks[1].Header())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if state.GetNonce(owner) != 2 || state.GetBalance(recipient).Uint64() != 7 || !PQActivated(state, cfg.PQMigrate, owner) {
+		t.Fatal("large transaction did not execute with the activated key")
+	}
+	if blocks[1].GasUsed() > large.Gas() {
+		t.Fatal("large transaction exceeded its gas limit")
+	}
+}
