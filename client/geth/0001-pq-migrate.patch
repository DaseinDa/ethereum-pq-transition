+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package fetcher
+
+import (
+	"math/big"
+	"testing"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/eth/protocols/eth"
+)
+
+func TestPQPacketDeliveryClockSurvivesFetcherBatches(t *testing.T) {
+	for _, earlierDispatch := range []bool{false, true} {
+		t.Run(map[bool]string{false: "enqueue-entry", true: "protocol-dispatch"}[earlierDispatch], func(t *testing.T) {
+			f := newTestTxFetcher()
+			// No background network loop is needed to consume this test delivery.
+			f.cleanup = make(chan *txDelivery, 1)
+			now, captures, batches := uint64(1012), 0, 0
+			expected := now
+			if earlierDispatch {
+				expected = 880
+			}
+			f.SetTimedSourceAdder(func() uint64 { captures++; return now }, func(peer string, txs []*types.Transaction, delivered uint64) []error {
+				if peer != "peer" || delivered != expected {
+					t.Fatalf("batch%d source/clock %s/%d, want peer/%d", batches, peer, delivered, expected)
+				}
+				batches++
+				now = 1144 // A head changes while the first admission is processing.
+				return make([]error, len(txs))
+			})
+			var txs []*types.Transaction
+			for i := 0; i < addTxsBatchSize+1; i++ {
+				txs = append(txs, types.NewTransaction(uint64(i), common.Address{}, new(big.Int), 21000, big.NewInt(1), nil))
+			}
+			var err error
+			if earlierDispatch {
+				err = f.EnqueueAt("peer", eth.ETH70, txs, true, expected)
+			} else {
+				err = f.Enqueue("peer", eth.ETH70, txs, true)
+			}
+			if err != nil || batches != 2 {
+				t.Fatal("packet batching", batches, err)
+			}
+			wantCaptures := 1
+			if earlierDispatch {
+				wantCaptures = 0
+			}
+			if captures != wantCaptures {
+				t.Fatal("packet clock recaptured", captures)
+			}
+		})
+	}
+}
