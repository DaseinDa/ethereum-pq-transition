@@ -0,0 +1,55 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package vm
+
+import (
+	"encoding/binary"
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core/tracing"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/params"
+)
+
+// Author decision 2026-11-02: S = T0 = D_reg. A provisional enrolled key
+// cannot exit/consolidate a validator through an exposed withdrawal address.
+// The same-day clarification includes PQ public-key markers as account code.
+// Ordinary contracts, system processing and empty-input fee reads keep upstream
+// behavior. This is a frame gate, not a replacement for the request contracts.
+func (evm *EVM) pqRequestGate(sender, target common.Address, input []byte, gas GasBudget) (GasBudget, error) {
+	c := evm.chainConfig.PQMigrate
+	if c == nil || evm.Context.Time < c.T0 || len(input) == 0 || sender == params.SystemAddress || (target != params.WithdrawalQueueAddress && target != params.ConsolidationQueueAddress) {
+		return gas, nil
+	}
+	code := evm.StateDB.GetCode(sender)
+	_, delegated := types.ParseDelegation(code)
+	if len(code) != 0 && !delegated && evm.pqMarkerCode(sender) == nil {
+		return gas, nil
+	}
+	key := pqAuthoritySlot(sender)
+	_, warm := evm.StateDB.SlotInAccessList(c.Registry, key)
+	cost := uint64(params.ColdSloadCostEIP2929)
+	if warm {
+		cost = params.WarmStorageReadCostEIP2929
+	}
+	prior, ok := gas.ChargeExecution(cost)
+	if !ok {
+		return gas, ErrOutOfGas
+	}
+	if evm.Config.Tracer.HasGasHook() {
+		evm.Config.Tracer.EmitGasChange(prior.AsTracing(), gas.AsTracing(), tracing.GasChangeCallPrecompiledContract)
+	}
+	evm.StateDB.AddSlotToAccessList(c.Registry, key)
+	word := evm.StateDB.GetState(c.Registry, key)
+	switch word[31] {
+	case 0:
+		return gas, ErrExecutionReverted
+	case 1:
+		start := max(c.T, binary.BigEndian.Uint64(word[22:30]))
+		// Subtraction after the ordering check avoids overflow in start+W.
+		if evm.Context.Time < start || evm.Context.Time-start < c.W {
+			return gas, ErrExecutionReverted
+		}
+	}
+	return gas, nil
+}
