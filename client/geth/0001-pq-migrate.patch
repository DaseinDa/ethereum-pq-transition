+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package pqpool
+
+import (
+	"errors"
+	"math/big"
+	"testing"
+	"time"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core"
+	"github.com/ethereum/go-ethereum/core/txpool"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/params"
+	"github.com/ethereum/go-ethereum/rpc"
+)
+
+func TestPQPoolComponentLifecycleLookup(t *testing.T) {
+	tx := componentTx(1, 20, 2, 20)
+	p, _, _, _, old, next := componentFork(t, tx)
+	api := NewAPI(p)
+	if api.Lookup(tx.Hash())["status"] != "unknown" {
+		t.Fatal("new hash known")
+	}
+	p.checkProof = func(*types.Transaction, *params.ChainConfig, string) error { return core.ErrPQFullUnavailable }
+	p.Reset(old.Header(), next.Header())
+	d := api.Lookup(tx.Hash())
+	if d["status"] != "deferred" || d["retryable"] != true || d["eligible"] != false || d["headHash"] != next.Hash() || p.Has(tx.Hash()) || p.Get(tx.Hash()) != nil {
+		t.Fatal("deferred lookup/eligibility", d)
+	}
+	if _, n := p.Pending(txpool.PendingFilter{OnlyPQ: true}); n != 0 {
+		t.Fatal("deferred served to builder")
+	}
+	p.checkProof = func(*types.Transaction, *params.ChainConfig, string) error { return nil }
+	p.verifyStart = time.Time{}
+	p.Reset(next.Header(), next.Header())
+	if d = api.Lookup(tx.Hash()); d["status"] != "pending" || d["eligible"] != true {
+		t.Fatal("pending not visible", d)
+	}
+	// Real local diagnostics distinguish deterministic rejection from inability
+	// to complete Full; they never assert canonical non-inclusion.
+	bad := changed(tx, func(m *types.PQMigrateTx) {
+		m.GasTipCap.SetInt64(4)
+		m.GasFeeCap.SetInt64(40)
+		m.ProofCarrier.Proof = []byte("distinct invalid proof")
+	})
+	p.checkProof = func(*types.Transaction, *params.ChainConfig, string) error { return core.ErrPQInvalidFullProof }
+	if !errors.Is(add(p, bad), core.ErrPQInvalidFullProof) {
+		t.Fatal("expected bad proof")
+	}
+	d = api.Lookup(bad.Hash())
+	if d["status"] != "rejected" || d["retryable"] != false || d["chainLookupRequired"] != true {
+		t.Fatal("rejection is not a local decision", d)
+	}
+	if !p.Has(tx.Hash()) {
+		t.Fatal("invalid replacement displaced good Pending")
+	}
+	for i := 0; i < 300; i++ {
+		p.mu.Lock()
+		p.rememberDecision(common.BigToHash(big.NewInt(int64(i+1))), "synthetic local rejection", false)
+		p.mu.Unlock()
+	}
+	if len(p.diagnostics) != p.cfg.MaxPending || api.Lookup(bad.Hash())["status"] != "unknown" {
+		t.Fatal("unbounded diagnostic history")
+	}
+	t.Logf("component hooks only: unknown->deferred(not eligible)->pending; rejected replacement stays local, head-bound, chain query required; diagnostic cap=%d", p.cfg.MaxPending)
+}
+
+func TestPQPoolComponentLookupRPC(t *testing.T) {
+	p, _, _ := componentPool(t)
+	tx := componentTx(1, 20, 2, 20)
+	if err := add(p, tx); err != nil {
+		t.Fatal(err)
+	}
+	server := rpc.NewServer()
+	defer server.Stop()
+	if err := server.RegisterName("pqpool", NewAPI(p)); err != nil {
+		t.Fatal(err)
+	}
+	client := rpc.DialInProc(server)
+	defer client.Close()
+	var got map[string]interface{}
+	if err := client.Call(&got, "pqpool_lookup", tx.Hash()); err != nil {
+		t.Fatal(err)
+	}
+	if got["status"] != "pending" || got["eligible"] != true || got["headHash"] != p.head.Hash().Hex() {
+		t.Fatal("RPC schema mismatch", got)
+	}
+	t.Logf("component JSON-RPC in-process actual method serialization: %+v", got)
+}
+
+func TestPQPoolComponentDeferredCapacityDiagnostic(t *testing.T) {
+	p, _, _ := componentPool(t)
+	tx := componentTx(1, 20, 2, 20)
+	if err := add(p, tx); err != nil {
+		t.Fatal(err)
+	}
+	p.cfg.MaxReorgBytes = 1
+	// Force a cache miss to exercise local verifier failure, not a prior pure success.
+	p.positiveCache = newProofResultCache(p.cfg.PositiveCacheBytes)
+	p.checkProof = func(*types.Transaction, *params.ChainConfig, string) error { return core.ErrPQFullUnavailable }
+	p.Reset(p.head, p.head)
+	got := NewAPI(p).Lookup(tx.Hash())
+	t.Logf("quarantine capacity rejection: %+v", got)
+	if got["status"] != "rejected" || got["retryable"] != true || got["reason"] != "deferred capacity limit; resubmit later" {
+		t.Fatal("temporary non-retention diagnostic mistaken for a definitive rejection")
+	}
+	if p.Has(tx.Hash()) || p.deferred[tx.Hash()] != nil {
+		t.Fatal("capacity exceeded")
+	}
+}
