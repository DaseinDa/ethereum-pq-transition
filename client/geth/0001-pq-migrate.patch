@@ -0,0 +1,511 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+// pqcheckpoint imports only the fixed research checkpoint into a NEW datadir.
+// It deliberately does not claim all state, historical receipts, or PoS finality.
+package main
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/json"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"math/big"
+	"os"
+	"path/filepath"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core"
+	"github.com/ethereum/go-ethereum/core/rawdb"
+	"github.com/ethereum/go-ethereum/core/state"
+	"github.com/ethereum/go-ethereum/core/stateless"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/crypto"
+	"github.com/ethereum/go-ethereum/ethdb"
+	"github.com/ethereum/go-ethereum/ethdb/pebble"
+	"github.com/ethereum/go-ethereum/params"
+	"github.com/ethereum/go-ethereum/rlp"
+	"github.com/ethereum/go-ethereum/trie"
+	"github.com/ethereum/go-ethereum/triedb"
+)
+
+func hash(b []byte) common.Hash { return common.Hash(sha256.Sum256(b)) }
+func readPinned(path, want string) ([]byte, error) {
+	b, e := os.ReadFile(path)
+	if e != nil {
+		return nil, e
+	}
+	if len(want) != 66 || want[:2] != "0x" || hash(b).Hex() != want {
+		return nil, fmt.Errorf("SHA-256 mismatch for %s: got %s expected %s", path, hash(b), want)
+	}
+	return b, nil
+}
+
+// Reject duplicates before struct decoding: encoding/json alone silently takes
+// the last occurrence, which is unacceptable for experiment identity files.
+func checkValue(d *json.Decoder) error {
+	t, e := d.Token()
+	if e != nil {
+		return e
+	}
+	delim, ok := t.(json.Delim)
+	if !ok {
+		return nil
+	}
+	switch delim {
+	case '{':
+		seen := map[string]bool{}
+		for d.More() {
+			t, e = d.Token()
+			if e != nil {
+				return e
+			}
+			key, ok := t.(string)
+			if !ok || seen[key] {
+				return errors.New("duplicate or invalid JSON key")
+			}
+			seen[key] = true
+			if e = checkValue(d); e != nil {
+				return e
+			}
+		}
+	case '[':
+		for d.More() {
+			if e = checkValue(d); e != nil {
+				return e
+			}
+		}
+	default:
+		return errors.New("unexpected JSON delimiter")
+	}
+	_, e = d.Token()
+	return e
+}
+func strictJSON(b []byte, v any) error {
+	d := json.NewDecoder(bytes.NewReader(b))
+	d.UseNumber()
+	if e := checkValue(d); e != nil {
+		return e
+	}
+	if _, e := d.Token(); e != io.EOF {
+		return errors.New("trailing JSON data")
+	}
+	d = json.NewDecoder(bytes.NewReader(b))
+	d.DisallowUnknownFields()
+	return d.Decode(v)
+}
+func openDB(dir string) (ethdb.Database, error) {
+	p, e := pebble.New(filepath.Join(dir, "geth", "chaindata"), 64, 64, "pq-checkpoint", false)
+	if e != nil {
+		return nil, e
+	}
+	return rawdb.NewDatabase(p), nil
+}
+
+func verifyDB(db ethdb.Database, cfg *params.ChainConfig) (map[string]any, error) {
+	p := cfg.PQStateBridge
+	if rawdb.ReadCanonicalHash(db, 0) != params.MainnetGenesisHash {
+		return nil, errors.New("real mainnet genesis missing")
+	}
+	b := rawdb.ReadBlock(db, p.AnchorHash, p.AnchorNumber)
+	if b == nil {
+		return nil, errors.New("anchor body missing")
+	}
+	if e := core.CheckCheckpointHeader(b.Header()); e != nil {
+		return nil, e
+	}
+	if rawdb.ReadHeadBlockHash(db) != p.AnchorHash || rawdb.ReadHeadHeaderHash(db) != p.AnchorHash || rawdb.ReadCanonicalHash(db, p.AnchorNumber) != p.AnchorHash {
+		return nil, errors.New("head/canonical index is not the fixed anchor")
+	}
+	diskCfg := rawdb.ReadChainConfig(db, params.MainnetGenesisHash)
+	if diskCfg == nil {
+		return nil, errors.New("local profile missing")
+	}
+	a, _ := json.Marshal(cfg)
+	z, _ := json.Marshal(diskCfg)
+	if !bytes.Equal(a, z) {
+		return nil, errors.New("stored local config differs")
+	}
+	tdb := triedb.NewDatabase(db, triedb.HashDefaults)
+	defer tdb.Close()
+	s, e := state.New(p.AnchorRoot, state.NewDatabase(tdb, state.NewCodeDB(db)))
+	if e != nil {
+		return nil, e
+	}
+	if root := s.IntermediateRoot(cfg.Rules(b.Number(), true, b.Time())); root != p.AnchorRoot {
+		return nil, errors.New("reopened checkpoint root differs")
+	}
+	if e = s.Error(); e != nil {
+		return nil, e
+	}
+	// A controlled absence probe is reported, not converted to a zero-valued
+	// account. Full init readiness remains separate from checkpoint identity.
+	probe := s.Copy()
+	rLab, initErr := core.ApplyLabInit(cfg, p.AnchorHash, new(big.Int).SetUint64(p.InitBlock), *cfg.OsakaTime, probe)
+	out := map[string]any{"anchor_hash": b.Hash(), "anchor_root": b.Root(), "head_number": b.NumberU64(), "sparse": true, "root_reopened": true, "initialization_ready": initErr == nil}
+	if initErr != nil {
+		out["initialization_error"] = initErr.Error()
+	} else {
+		out["R_lab"] = rLab
+		systemErr := core.InstallPQBridgeSystemImages(cfg, new(big.Int).SetUint64(p.InitBlock), *cfg.OsakaTime, probe)
+		out["system_images_ready"] = systemErr == nil
+		if systemErr != nil {
+			out["system_image_error"] = systemErr.Error()
+		} else {
+			out["R_system_image"] = probe.IntermediateRoot(cfg.Rules(new(big.Int).SetUint64(p.InitBlock), true, *cfg.OsakaTime))
+			out["registry_balance_preserved"] = probe.GetBalance(cfg.PQMigrate.Registry).Dec()
+			if probe.Error() != nil {
+				return nil, probe.Error()
+			}
+		}
+	}
+	return out, nil
+}
+
+func run() error {
+	datadir := flag.String("datadir", "", "new isolated geth datadir")
+	blockPath := flag.String("block", "", "fixed H block RLP")
+	witnessPath := flag.String("witness", "", "ExtWitness directly rooted at H")
+	profilePath := flag.String("profile", "", "strict ChainConfig JSON without pqStateBridge")
+	bridgePath := flag.String("bridge", "", "strict PQStateBridgeConfig JSON")
+	evidencePath := flag.String("historical-evidence", "", "previous successful historical replay result")
+	blockSHA := flag.String("block-sha256", "", "independently pinned 0x SHA-256")
+	witnessSHA := flag.String("witness-sha256", "", "independently pinned 0x SHA-256")
+	profileSHA := flag.String("profile-sha256", "", "independently pinned 0x SHA-256")
+	bridgeSHA := flag.String("bridge-sha256", "", "independently pinned file 0x SHA-256")
+	evidenceSHA := flag.String("historical-evidence-sha256", "", "independently pinned 0x SHA-256")
+	verifyOnly := flag.Bool("verify", false, "verify existing imported checkpoint without changing its trust record")
+	makeBridge := flag.Bool("make-bridge", false, "emit a bridge reading view with canonical delta hash; does not import or accept state")
+	creditAddress := flag.String("credit-address", "", "public experimental owner")
+	creditWei := flag.String("credit-wei", "", "explicit experimental credit in decimal wei")
+	makeProfile := flag.Bool("make-profile", false, "emit local profile retaining actual mainnet historical fork schedule")
+	templatePath := flag.String("template-genesis", "", "previous fixed Full research genesis")
+	templateSHA := flag.String("template-genesis-sha256", "", "pinned template SHA-256")
+	timingPath := flag.String("timing", "", "frozen network timing JSON")
+	timingSHA := flag.String("timing-sha256", "", "pinned timing SHA-256")
+	flag.Parse()
+	if *makeProfile {
+		tb, e := readPinned(*templatePath, *templateSHA)
+		if e != nil {
+			return e
+		}
+		nb, e := readPinned(*timingPath, *timingSHA)
+		if e != nil {
+			return e
+		}
+		var prior struct {
+			Config *params.ChainConfig `json:"config"`
+		}
+		if e = json.Unmarshal(tb, &prior); e != nil {
+			return e
+		}
+		var timing struct {
+			T0     uint64 `json:"T0"`
+			T      uint64 `json:"T"`
+			Osaka  uint64 `json:"osaka_time"`
+			Expiry uint64 `json:"proof_expiry"`
+		}
+		if e = json.Unmarshal(nb, &timing); e != nil {
+			return e
+		}
+		if prior.Config == nil || prior.Config.PQMigrate == nil || prior.Config.PQMigrate.FullResearch == nil || timing.T0 <= 1753185599 || timing.T <= timing.T0 || timing.Osaka != timing.T0 || timing.Expiry <= timing.T || timing.Expiry-timing.T > 604800 {
+			return errors.New("invalid Full template or frozen timing")
+		}
+		c := *params.MainnetChainConfig
+		c.ChainID = new(big.Int).SetUint64(params.PQR1ChainID) // E2 runs under R-1's chain id (spec section 23.2)
+		c.OsakaTime = &timing.Osaka
+		c.BPO1Time = nil
+		c.BPO2Time = nil
+		c.BPO3Time = nil
+		c.BPO4Time = nil
+		c.BPO5Time = nil
+		c.AmsterdamTime = nil
+		c.UBTTime = nil
+		c.PQMigrate = prior.Config.PQMigrate
+		c.PQMigrate.T0 = timing.T0
+		c.PQMigrate.T = timing.T
+		c.PQMigrate.ReceivingTime = timing.T0
+		c.PQMigrate.FullResearch.Activation = timing.T0
+		c.PQMigrate.FullResearch.Sunset = timing.Expiry + 86400
+		enc := json.NewEncoder(os.Stdout)
+		enc.SetIndent("", "  ")
+		return enc.Encode(&c)
+	}
+	pb, e := readPinned(*profilePath, *profileSHA)
+	if e != nil {
+		return e
+	}
+	var cfg params.ChainConfig
+	if e = strictJSON(pb, &cfg); e != nil {
+		return e
+	}
+	if cfg.PQStateBridge != nil {
+		return errors.New("profile must not contain a self-referential bridge")
+	}
+	if *makeBridge {
+		wb, e := readPinned(*witnessPath, *witnessSHA)
+		if e != nil {
+			return e
+		}
+		if len(*creditAddress) != 42 || !common.IsHexAddress(*creditAddress) {
+			return errors.New("full credit address required")
+		}
+		value, ok := new(big.Int).SetString(*creditWei, 10)
+		if !ok {
+			return errors.New("invalid decimal credit")
+		}
+		p := params.PQStateBridgeConfig{ResearchOnly: true, AnchorHash: params.PQBridgeAnchorHash, AnchorRoot: params.PQBridgeAnchorRoot, AnchorNumber: params.PQBridgeAnchorNumber, InitBlock: params.PQBridgeAnchorNumber + 1, ProfileSHA256: hash(pb), Credits: []params.PQStateBridgeCredit{{Address: common.HexToAddress(*creditAddress), Balance: value, AbsenceProofSHA256: hash(wb)}}}
+		delta, e := p.InitDeltaBytes()
+		if e != nil {
+			return e
+		}
+		p.InitDeltaSHA256 = hash(delta)
+		if e = p.Validate(); e != nil {
+			return e
+		}
+		enc := json.NewEncoder(os.Stdout)
+		enc.SetIndent("", "  ")
+		return enc.Encode(p)
+	}
+	bb, e := readPinned(*bridgePath, *bridgeSHA)
+	if e != nil {
+		return e
+	}
+	var bridge params.PQStateBridgeConfig
+	if e = strictJSON(bb, &bridge); e != nil {
+		return e
+	}
+	if bridge.ProfileSHA256 != hash(pb) {
+		return errors.New("bridge binds another profile")
+	}
+	cfg.PQStateBridge = &bridge
+	if e = cfg.CheckConfigForkOrder(); e != nil {
+		return e
+	}
+	if *verifyOnly {
+		db, e := openDB(*datadir)
+		if e != nil {
+			return e
+		}
+		defer db.Close()
+		out, e := verifyDB(db, &cfg)
+		if e != nil {
+			return e
+		}
+		record, e := core.ReadTrustedCheckpointRecord(db)
+		if e != nil {
+			return e
+		}
+		if !core.IsTrustedCheckpoint(db, bridge.AnchorHash, bridge.AnchorNumber, bridge.AnchorRoot, bridge.ProfileSHA256) {
+			return errors.New("checkpoint trust record mismatch")
+		}
+		if e = core.CheckTrustedCheckpointConfig(db, &cfg); e != nil {
+			return e
+		}
+		out["trusted_checkpoint"] = record
+		return json.NewEncoder(os.Stdout).Encode(out)
+	}
+	blockBytes, e := readPinned(*blockPath, *blockSHA)
+	if e != nil {
+		return e
+	}
+	witnessBytes, e := readPinned(*witnessPath, *witnessSHA)
+	if e != nil {
+		return e
+	}
+	evidenceBytes, e := readPinned(*evidencePath, *evidenceSHA)
+	if e != nil {
+		return e
+	}
+	var prior struct {
+		Accepted          bool        `json:"accepted"`
+		BlockHash         common.Hash `json:"block_hash"`
+		ExpectedStateRoot common.Hash `json:"expected_state_root"`
+	}
+	if e = json.Unmarshal(evidenceBytes, &prior); e != nil {
+		return e
+	}
+	if !prior.Accepted || prior.BlockHash != bridge.AnchorHash || prior.ExpectedStateRoot != bridge.AnchorRoot {
+		return errors.New("historical evidence is not an accepted replay of fixed H")
+	}
+	var b types.Block
+	if e = rlp.DecodeBytes(blockBytes, &b); e != nil {
+		return e
+	}
+	if e = core.CheckCheckpointHeader(b.Header()); e != nil {
+		return e
+	}
+	if types.DeriveSha(b.Transactions(), trie.NewStackTrie(nil)) != b.TxHash() || types.CalcUncleHash(b.Uncles()) != b.UncleHash() {
+		return errors.New("anchor body commitment mismatch")
+	}
+	if h := b.Header().WithdrawalsHash; h == nil || types.DeriveSha(types.Withdrawals(b.Withdrawals()), trie.NewStackTrie(nil)) != *h {
+		return errors.New("anchor withdrawals commitment mismatch")
+	}
+	var w stateless.Witness
+	if e = rlp.DecodeBytes(witnessBytes, &w); e != nil {
+		return e
+	}
+	if len(w.Headers) == 0 || w.Headers[0].Hash() != bridge.AnchorHash || w.Root() != bridge.AnchorRoot {
+		return errors.New("direct witness must start at original H poststate")
+	}
+	for i, h := range w.Headers {
+		if h == nil || h.Number == nil {
+			return errors.New("nil witness header")
+		}
+		if i > 0 && (w.Headers[i-1].ParentHash != h.Hash() || w.Headers[i-1].Number.Uint64() != h.Number.Uint64()+1) {
+			return errors.New("witness ancestors do not connect")
+		}
+	}
+	rootPresent := false
+	for node := range w.State {
+		if crypto.Keccak256Hash([]byte(node)) == bridge.AnchorRoot {
+			rootPresent = true
+		}
+	}
+	if !rootPresent {
+		return errors.New("anchor root node missing")
+	}
+	for _, c := range bridge.Credits {
+		if c.AbsenceProofSHA256 != hash(witnessBytes) {
+			return errors.New("credit absence source must bind this independently pinned witness bundle")
+		}
+	}
+	if *datadir == "" {
+		return errors.New("datadir required")
+	}
+	if e = os.Mkdir(*datadir, 0700); e != nil {
+		return fmt.Errorf("refusing non-new datadir: %w", e)
+	}
+	db, e := openDB(*datadir)
+	if e != nil {
+		return e
+	}
+	closeDB := true
+	defer func() {
+		if closeDB {
+			db.Close()
+		}
+	}()
+	tdb := triedb.NewDatabase(db, triedb.HashDefaults)
+	genesis := core.DefaultGenesisBlock()
+	genesis.Config = &cfg
+	// Historical schedules must preserve the actual genesis header, not create
+	// an all-forks-at-zero dev genesis with mainnet-looking metadata.
+	if genesis.ToBlock().Hash() != params.MainnetGenesisHash {
+		tdb.Close()
+		return errors.New("local profile changes actual mainnet genesis header")
+	}
+	if _, e = genesis.Commit(db, tdb, nil); e != nil {
+		tdb.Close()
+		return e
+	}
+	batch := db.NewBatch()
+	for node := range w.State {
+		rawdb.WriteLegacyTrieNode(batch, crypto.Keccak256Hash([]byte(node)), []byte(node))
+		if batch.ValueSize() > 8*1024*1024 {
+			if e = batch.Write(); e != nil {
+				return e
+			}
+			batch.Reset()
+		}
+	}
+	for code := range w.Codes {
+		rawdb.WriteCode(batch, crypto.Keccak256Hash([]byte(code)), []byte(code))
+		if batch.ValueSize() > 8*1024*1024 {
+			if e = batch.Write(); e != nil {
+				return e
+			}
+			batch.Reset()
+		}
+	}
+	for _, h := range w.Headers {
+		rawdb.WriteHeader(batch, h)
+		rawdb.WriteCanonicalHash(batch, h.Hash(), h.Number.Uint64())
+	}
+	rawdb.WriteBlock(batch, &b)
+	rawdb.WriteHeadHeaderHash(batch, b.Hash())
+	rawdb.WriteHeadBlockHash(batch, b.Hash())
+	rawdb.WriteHeadFastBlockHash(batch, b.Hash())
+	if e = batch.Write(); e != nil {
+		tdb.Close()
+		return e
+	}
+	s, e := state.New(bridge.AnchorRoot, state.NewDatabase(tdb, state.NewCodeDB(db)))
+	if e != nil {
+		tdb.Close()
+		return e
+	}
+	root, e := s.Commit(params.MainnetChainConfig.Rules(b.Number(), true, b.Time()), b.NumberU64())
+	if e != nil {
+		tdb.Close()
+		return e
+	}
+	if root != bridge.AnchorRoot {
+		tdb.Close()
+		return errors.New("unmodified sparse checkpoint Commit changed root")
+	}
+	if e = tdb.Commit(root, false); e != nil {
+		tdb.Close()
+		return e
+	}
+	if e = tdb.Close(); e != nil {
+		return e
+	}
+	if e = db.SyncKeyValue(); e != nil {
+		return e
+	}
+	if e = db.Close(); e != nil {
+		return e
+	}
+	closeDB = false
+	db, e = openDB(*datadir)
+	if e != nil {
+		return e
+	}
+	closeDB = true
+	out, e := verifyDB(db, &cfg)
+	if e != nil {
+		return e
+	}
+	record := &core.TrustedCheckpointRecord{Schema: "PQ-TRUSTED-CHECKPOINT-v1", ResearchOnly: true, BlockHash: b.Hash(), BlockNumber: b.NumberU64(), StateRoot: b.Root(), ProfileSHA256: hash(pb), BlockSHA256: hash(blockBytes), WitnessSHA256: hash(witnessBytes), HistoricalEvidenceSHA256: hash(evidenceBytes), GenesisHash: params.MainnetGenesisHash, Reopened: true, Sparse: true, TrustStatement: "Explicit fixed historical research anchor; historical replay evidence reused; no independent PoS finality validation; incomplete state and historical data"}
+	record.LocalConfigSHA256, e = core.PQBridgeConfigHash(&cfg)
+	if e != nil {
+		return e
+	}
+	if e = core.WriteTrustedCheckpointRecord(db, record); e != nil {
+		return e
+	}
+	if e = db.SyncKeyValue(); e != nil {
+		return e
+	}
+	gb, e := json.MarshalIndent(genesis, "", "  ")
+	if e != nil {
+		return e
+	}
+	if e = os.WriteFile(filepath.Join(*datadir, "override-genesis.json"), gb, 0600); e != nil {
+		return e
+	}
+	delta, e := bridge.InitDeltaBytes()
+	if e != nil {
+		return e
+	}
+	if e = os.WriteFile(filepath.Join(*datadir, "init-delta.rlp"), delta, 0600); e != nil {
+		return e
+	}
+	out["trusted_checkpoint"] = record
+	out["headers_loaded"] = len(w.Headers)
+	out["state_nodes_loaded"] = len(w.State)
+	out["codes_loaded"] = len(w.Codes)
+	out["historical_receipts_imported"] = false
+	return json.NewEncoder(os.Stdout).Encode(out)
+}
+
+func main() {
+	if e := run(); e != nil {
+		fmt.Fprintln(os.Stderr, e)
+		os.Exit(1)
+	}
+}
