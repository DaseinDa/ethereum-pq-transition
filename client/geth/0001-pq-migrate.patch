+
+func TestSponsorStrikeTableBoundsCancelOverflow(t *testing.T) {
+	p, _, _, _ := strikeFixture(t, 20)
+	for i := 0; i < maxSponsorStrikesPerSource+3; i++ {
+		rejectSponsor(t, p, "one-peer")
+	}
+	if len(p.sponsorStrikes) != maxSponsorStrikesPerSource || p.sources["one-peer"].failures != 0 {
+		t.Fatal("per-source cap charged or exceeded")
+	}
+	p.sponsorStrikes = make([]sponsorStrike, maxSponsorStrikes)
+	rejectSponsor(t, p, "other-peer")
+	if len(p.sponsorStrikes) != maxSponsorStrikes || p.sources["other-peer"].failures != 0 {
+		t.Fatal("total cap charged or exceeded")
+	}
+}
+
+func TestHeldRetryNeverChargesPureFailureOrRecordsStrike(t *testing.T) {
+	p, _, _, _ := strikeFixture(t, 20)
+	tx := componentTx(1, 20, 2, 20)
+	if errorName(p.addLocked("held", tx)) != "BAD_SPONSOR_SIG" || len(p.sponsorStrikes) != 0 || p.sources["held"] != nil {
+		t.Fatal("held signature charged")
+	}
+	p.checkState = func(*types.Transaction, *state.StateDB, *types.Header, *params.ChainConfig) error { return nil }
+	p.checkProof = func(*types.Transaction, *params.ChainConfig, string) error { return core.ErrPQInvalidFullProof }
+	if !errors.Is(p.addLocked("held", tx), core.ErrPQInvalidFullProof) || p.sources["held"] != nil {
+		t.Fatal("held proof charged")
+	}
+}
+
+func TestSponsorStrikeUnavailableEffectiveKeyCancels(t *testing.T) {
+	p, c, head, oldest := strikeFixture(t, 20)
+	rejectSponsor(t, p, "relay")
+	key, _ := core.PQRecordSlots(addr(20))
+	c.history[oldest.Hash()].SetState(c.cfg.PQMigrate.Registry, key, common.Hash{})
+	decision := c.block(head, 1120, 20)
+	p.Reset(head.Header(), decision.Header())
+	if len(p.sponsorStrikes) != 0 || p.sources["relay"].failures != 0 {
+		t.Fatal("unchanged code without activation confirmed a strike")
+	}
+}
+
+// Section 28.2 rule2 extends a coalesced reset's range through its deciding
+// head, not merely through max(td,tr)+hs. A later intervening rotation counts.
+func TestSponsorStrikeCoalescedHeadIncludesLaterRotation(t *testing.T) {
+	p, c, head, _ := strikeFixture(t, 20)
+	rejectSponsor(t, p, "relay") // td=tr1012; nominal decision pool clock1132
+	rotated := c.block(head, 1200, 21)
+	restored := c.block(rotated, 1212, 20)
+	decision := c.block(restored, 1260, 20)
+	p.Reset(head.Header(), decision.Header())
+	if len(p.sponsorStrikes) != 0 || p.sources["relay"].failures != 0 {
+		t.Fatal("coalesced confirmation ignored a rotation before the deciding head")
+	}
+}
