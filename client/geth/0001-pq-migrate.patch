+// Independent specification formula: calldata tokens, C verification, one
+// sponsor signature, and only the successful entries' actual cold writes.
+func batchExpectedGas(t *testing.T, b *types.PQBatchTx, writes uint64) uint64 {
+	t.Helper()
+	entries, err := rlp.EncodeToBytes(b.Entries)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var tokens uint64
+	for _, data := range [][]byte{entries, b.SponsorSignature, b.ProofCarrier.Proof} {
+		for _, value := range data {
+			tokens++
+			if value != 0 {
+				tokens += 3
+			}
+		}
+	}
+	return 21000 + max(4*tokens+11771000+50000+writes, 10*tokens)
