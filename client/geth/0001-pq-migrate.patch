+	"github.com/ethereum/go-ethereum/trie"
+	"math/big"
+	"os"
+	"testing"
+)
+
+// Bounded model table, not actual chain/network time travel. State comes from
+// genuine signed sponsor creation and attacker enrollment. Every head reruns
+// core.ValidatePQMigrateState including actual ML-DSA authorization. Only branch
+// headers / local threshold configuration / the final Full predicate are hooks.
+func TestPQPoolModelReorgBoundaryTable(t *testing.T) {
+	gen, bc, _, boot, mk := actualBase(t)
+	frozen, err := bc.StateAt(boot.Header())
+	if err != nil {
+		t.Fatal(err)
+	}
+	read := func(env string) *types.Transaction {
+		t.Helper()
+		raw, err := os.ReadFile(os.Getenv(env))
+		if err != nil {
+			t.Fatal(err)
+		}
+		tx := new(types.Transaction)
+		if err = tx.UnmarshalBinary(raw); err != nil {
+			t.Fatal(err)
+		}
+		return tx
+	}
+	enrollment := read("PQ_TEST_ENROLL_RAW")
+	enrolledBlock, _ := mk(boot, "real-enroll-before-T", enrollment, 1)
+	actualImport(t, bc, enrolledBlock, true)
+	enrolled, err := bc.StateAt(enrolledBlock.Header())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if r := core.ReadPQRecord(enrolled, gen.Config.PQMigrate.Registry, actualL); r.Mode != 1 || r.MigrationNonce != 1 {
+		t.Fatal("real enrolled fixture", r)
+	}
+	recovery, override := actualRead(t, "migrate"), read("PQ_TEST_RECOMMIT_RAW")
+	boundary := gen.Config.PQMigrate.T
+	type row struct {
+		name string
+		at   uint64
+		kind string
+		want string
+	}
+	rows := []row{{"before-T", boundary - 1, "freeze", "FORK_NOT_ACTIVE"}, {"at-T", boundary, "freeze", ""}, {"before-activation", boundary + 99, "activation", "WRONG_VERIFIER_VERSION"}, {"at-activation", boundary + 100, "activation", ""}, {"before-sunset", boundary + 99, "sunset", ""}, {"at-sunset", boundary + 100, "sunset", "WRONG_VERIFIER_VERSION"}, {"before-override-close", boundary + 47, "override", ""}, {"at-override-close", boundary + 48, "override", "OVERRIDE_WINDOW_CLOSED"}}
+	for _, r := range rows {
+		t.Run(r.name, func(t *testing.T) {
+			cfg := *gen.Config
+			pq := *cfg.PQMigrate
+			full := *pq.FullResearch
+			pq.FullResearch = &full
+			cfg.PQMigrate = &pq
+			snapshot, tx := frozen, recovery
+			if r.kind == "activation" {
+				full.Activation = boundary + 100
+			}
+			if r.kind == "sunset" {
+				full.Sunset = boundary + 100
+			}
+			if r.kind == "override" {
+				pq.W = 48
+				snapshot, tx = enrolled, override
+			}
+			block := func(parent *types.Block, at uint64, extra string, txs ...*types.Transaction) *types.Block {
+				h := &types.Header{Number: big.NewInt(1), Time: at, GasLimit: 120000000, GasUsed: 60000000, BaseFee: big.NewInt(1), Difficulty: new(big.Int), Extra: []byte(extra)}
+				if parent != nil {
+					h.ParentHash = parent.Hash()
+					h.Number = new(big.Int).Add(parent.Number(), big.NewInt(1))
+				}
+				return types.NewBlock(h, &types.Body{Transactions: txs}, nil, trie.NewStackTrie(nil))
+			}
+			ancestor := block(nil, boundary-100, "model-common")
+			old := block(ancestor, r.at+20, "model-old", tx)
+			head := block(ancestor, r.at-12, "model-new")
+			chain := &componentChain{cfg: &cfg, s: snapshot, blocks: map[common.Hash]*types.Block{ancestor.Hash(): ancestor, old.Hash(): old, head.Hash(): head}}
+			policy := DefaultConfig
+			policy.Datadir = t.TempDir()
+			p := New(policy, chain)
+			if err := p.Init(1, old.Header(), nil); err != nil {
+				t.Fatal(err)
+			}
+			defer p.Close()
+			calls := 0
+			p.checkProof = func(*types.Transaction, *params.ChainConfig, string) error { calls++; return nil }
+			// Retain real core state/signature checks; explicitly assert the test hook is
+			// only on the last ownership-proof predicate.
+			p.checkState = func(tx *types.Transaction, s *state.StateDB, h *types.Header, c *params.ChainConfig) error {
+				return core.ValidatePQMigrateState(tx, s, h, c)
+			}
+			p.Reset(old.Header(), head.Header())
+			actual := core.ValidatePQMigrateState(tx, snapshot.Copy(), p.nextHeader(), &cfg)
+			if errorName(actual) != r.want || p.Has(tx.Hash()) != (r.want == "") || calls != map[bool]int{true: 1, false: 0}[r.want == ""] || len(p.deferred) != 0 {
+				t.Fatalf("state gate=%v Pending=%v Full-hook calls=%d deferred=%d want=%s", actual, p.Has(tx.Hash()), calls, len(p.deferred), r.want)
+			}
+			record, _ := json.Marshal(map[string]interface{}{"layer": "model-heads; actual state and ML-DSA gates; Full hook", "case": r.name, "candidate_time": r.at, "T": boundary, "activation": full.Activation, "sunset": full.Sunset, "W": pq.W, "state_gate": errorName(actual), "pending": p.Has(tx.Hash()), "full_hook_calls": calls, "deferred": len(p.deferred)})
+			t.Log(string(record))
+		})
+	}
+}
diff --git a/core/txpool/pqpool/diagnostics.go b/core/txpool/pqpool/diagnostics.go
new file mode 100644
index 0000000000000000000000000000000000000000..fdfbde6d9d9d5a4e9f1a5fb077c95b4a5473367c
--- /dev/null
+++ b/core/txpool/pqpool/diagnostics.go
@@ -0,0 +1,80 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package pqpool
+
+import "github.com/ethereum/go-ethereum/common"
+
+// Local diagnostics are bounded, non-consensus and contain no witness/proof.
+// A remembered rejection may be a stale nonce after inclusion. It never means
+// the hash is absent from the canonical chain; callers must query the receipt.
+type localDecision struct {
+	reason    string
+	retryable bool
+	order     uint64
+}
+
+func diagnosticReason(reason string) string {
+	if len(reason) > 256 {
+		return reason[:256]
+	}
+	return reason
+}
+func (p *Pool) rememberDecision(hash common.Hash, reason string, retry bool) {
+	if p.diagnostics == nil {
+		p.diagnostics = make(map[common.Hash]localDecision)
+	}
+	p.diagnosticOrder++
+	p.diagnostics[hash] = localDecision{diagnosticReason(reason), retry, p.diagnosticOrder}
+	if len(p.diagnostics) > p.cfg.MaxPending {
+		var oldest common.Hash
+		var order uint64 = ^uint64(0)
+		for h, d := range p.diagnostics {
+			if d.order < order {
+				oldest = h
+				order = d.order
+			}
+		}
+		delete(p.diagnostics, oldest)
+	}
+}
+
+// Lookup is a local lifecycle diagnostic, NOT an inclusion oracle. Deferred
+// objects are not served by Get/Has/Pending and have not finished this head's
+// Full admission. Unknown also includes evicted diagnostic history/restarts.
+func (a *API) Lookup(hash common.Hash) map[string]interface{} {
+	p := a.pool
+	p.mu.RLock()
+	defer p.mu.RUnlock()
+	out := map[string]interface{}{"hash": hash, "status": "unknown", "reason": "not retained locally; query canonical receipt/block", "retryable": false, "eligible": false, "localOnly": true, "chainLookupRequired": true}
+	if p.head != nil {
+		out["headHash"] = p.head.Hash()
+		out["headNumber"] = p.head.Number.Uint64()
+		out["poolClock"] = p.nextHeader().Time
+	}
+	if e := p.entries[hash]; e != nil {
+		if p.stateErr != nil {
+			out["status"] = "deferred"
+			out["reason"] = "local canonical state unavailable"
+			out["retryable"] = true
+			return out
+		}
+		out["status"] = "pending"
+		out["reason"] = "Full admission complete for pool head and clock"
+		out["eligible"] = true
+		return out
+	}
+	if d := p.deferred[hash]; d != nil {
+		out["status"] = "deferred"
+		out["reason"] = d.reason
+		out["retryable"] = true
+		out["queueOrder"] = d.order
+		return out
+	}
+	if d, ok := p.diagnostics[hash]; ok {
+		out["status"] = "rejected"
+		out["reason"] = d.reason
+		out["retryable"] = d.retryable
+	}
+	return out
+}
diff --git a/core/txpool/pqpool/diagnostics_test.go b/core/txpool/pqpool/diagnostics_test.go
