+
+package vm
+
+import (
+	"bytes"
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core/tracing"
+	"github.com/holiman/uint256"
+	"testing"
+)
+
+// The public opcode entry points must refuse borrowed/static/deep/legacy
+// contexts before a registry read. A direct address match, not resolved code,
+// is required. These tests do not invoke a privileged rotate helper directly.
+func TestPQRotateEntryGates(t *testing.T) {
+	for _, name := range []string{"legacy", "callcode", "delegate", "static", "nested", "wrong-origin", "value", "pre-T0", "non-selector"} {
+		t.Run(name, func(t *testing.T) {
+			evm, s, _, _ := pqRecoveryFixture(t, 100)
+			c := evm.chainConfig.PQMigrate
+			a := common.HexToAddress("1234")
+			s.SetBalance(a, uint256.NewInt(100), tracing.BalanceChangeUnspecified)
+			s.SetCode(c.Registry, []byte{0}, tracing.CodeChangeUnspecified)
+			evm.SetTxContext(TxContext{Origin: a, PQRotateEligible: true})
+			input := bytes.Clone(pqRotateSelector)
+			value := new(uint256.Int)
+			if name == "legacy" {
+				evm.PQRotateEligible = false
+			}
+			if name == "nested" {
+				evm.depth = 1
+			}
+			if name == "wrong-origin" {
+				evm.Origin = common.Address{}
+			}
+			if name == "value" {
+				value.SetUint64(1)
+			}
+			if name == "pre-T0" {
+				c.T0 = 101
+			}
+			if name == "non-selector" {
+				input[3] ^= 1
+			}
+			before := s.GetBalance(c.Registry).Uint64()
+			budget := NewGasBudget(1000000, 0)
+			var out []byte
+			var left GasBudget
+			var err error
+			switch name {
+			case "callcode":
+				out, left, err = evm.CallCode(a, c.Registry, input, budget, value)
+			case "delegate":
+				out, left, err = evm.DelegateCall(a, a, c.Registry, input, budget, value)
+			case "static":
+				out, left, err = evm.StaticCall(a, c.Registry, input, budget)
+			default:
+				out, left, err = evm.Call(a, c.Registry, input, budget, value)
+			}
+			want := ErrExecutionReverted
+			if name == "pre-T0" || name == "non-selector" {
+				want = nil
+			}
+			if err != want || len(out) != 0 || left.Used(budget) != 0 {
+				t.Fatalf("err=%v want=%v gas=%d", err, want, left.Used(budget))
+			}
+			if s.GetBalance(c.Registry).Uint64() != before {
+				t.Fatal("refused value persisted")
+			}
+			k := pqAuthoritySlot(a)
+			if _, warm := s.SlotInAccessList(c.Registry, k); warm {
+				t.Fatal("bad caller read registry")
+			}
+		})
+	}
+}
