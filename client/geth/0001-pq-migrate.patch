+func TestPQEarlyR1PrecedesSenderRecovery(t *testing.T) {
+	s, evm, h := finalStateEnv(t, common.Address{})
+	// Every envelope has an invalid zero ECDSA signature. At T, R1 must win
+	// over sender/signature errors in validation and block-building execution.
+	for _, inner := range []types.TxData{&types.LegacyTx{}, &types.AccessListTx{}, &types.DynamicFeeTx{}, &types.BlobTx{}, &types.SetCodeTx{}} {
+		tx := types.NewTx(inner)
+		if err := ValidatePQTransaction(s, evm.ChainConfig(), h, tx, true); !errors.Is(err, ErrECDSADisabled) {
+			t.Fatalf("type %d validation: %v", tx.Type(), err)
+		}
+		if _, _, err := ApplyTransaction(context.Background(), evm, NewGasPool(h.GasLimit), s, h, tx); !errors.Is(err, ErrECDSADisabled) {
+			t.Fatalf("type %d execution: %v", tx.Type(), err)
+		}
+		if err := ValidatePQTransactionTime(evm.ChainConfig(), h.Time-1, tx); err != nil {
+			t.Fatal("pre-T time gate", err)
+		}
+	}
+	enroll := types.NewTx(&types.PQEnrollTx{ChainID: big.NewInt(13378), GasTipCap: new(big.Int), GasFeeCap: new(big.Int)})
+	if err := ValidatePQTransactionTime(evm.ChainConfig(), h.Time, enroll); err == nil || err.Error() != "ENROLL_AFTER_FORK" {
+		t.Fatal(err)
+	}
+}
