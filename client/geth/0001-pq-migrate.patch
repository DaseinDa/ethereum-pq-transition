+
+// Public SingleF replay at its original PI and historical timestamp. This test
+// uses the real native F verifier; it never replaces the proof or verifier hook.
+func TestPQPreTBlockOrdering(t *testing.T) {
+	migration, now := pqtest.SingleF(t, 0)
+	m, _ := migration.AsPQMigrate()
+	// Public BIP39 vector: abandon x11 + about, empty passphrase, m/44'/60'/0'/0/0.
+	key, err := crypto.HexToECDSA("1ab42cc412b618bdea3a599e3c9bae199ebf030895b039e9db1e30dafb12b727")
+	if err != nil {
+		t.Fatal(err)
+	}
+	owner := crypto.PubkeyToAddress(key.PublicKey)
+	if owner != m.LegacyAddress || m.MigrationNonce != 0 {
+		t.Fatal("unexpected public F owner fixture")
+	}
+	cfg := nativeTestChain()
+	cfg.PQMigrate.FullResearch = finalTestProfile()
+	cfg.PQMigrate.FullResearch.Sunset = math.MaxUint64
+	cfg.PQMigrate.T0, cfg.PQMigrate.ReceivingTime, cfg.PQMigrate.T = now-100, now-100, now+3600
+	cfg.PQMigrate.LegacySeedProofFromT0 = true
+	cfg.ChainID = new(big.Int).Set(m.ChainID)
+	recipient := common.HexToAddress("777")
+	ecdsa, err := types.SignTx(types.NewTx(&types.DynamicFeeTx{ChainID: cfg.ChainID, Nonce: 0, GasTipCap: big.NewInt(params.GWei), GasFeeCap: big.NewInt(2 * params.GWei), Gas: 21000, To: &recipient, Value: big.NewInt(1)}), types.LatestSignerForChainID(cfg.ChainID), key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	genesis := &Genesis{Config: cfg, Timestamp: now - 10, GasLimit: 60000000, Alloc: withSystemContracts(types.GenesisAlloc{
+		owner:                      {Balance: new(big.Int).Mul(big.NewInt(10), big.NewInt(params.Ether))},
+		cfg.PQMigrate.Registry:     {Code: []byte{0}, Nonce: 1, Balance: new(big.Int)},
+		cfg.PQMigrate.FactRegistry: {Code: []byte{0}, Nonce: 1, Balance: new(big.Int)},
+	})}
+	db, blocks, _ := GenerateChainWithGenesis(genesis, beacon.New(ethash.NewFaker()), 1, func(_ int, b *BlockGen) { b.AddTx(ecdsa); b.AddTx(migration) })
+	defer db.Close()
+	importBlocks := func(t *testing.T, bs []*types.Block) (*BlockChain, error) {
+		t.Helper()
+		chain, e := NewBlockChain(rawdb.NewMemoryDatabase(), genesis, beacon.New(ethash.NewFaker()), nil)
+		if e != nil {
+			t.Fatal(e)
+		}
+		t.Cleanup(chain.Stop)
+		_, e = chain.InsertChain(bs)
+		return chain, e
+	}
+	t.Run("ECDSA-before-proof-valid", func(t *testing.T) {
+		chain, err := importBlocks(t, blocks)
+		if err != nil {
+			t.Fatal(err)
+		}
+		s, err := chain.StateAt(blocks[0].Header())
+		if err != nil {
+			t.Fatal(err)
+		}
+		r := ReadPQRecord(s, cfg.PQMigrate.Registry, owner)
+		if r.Mode != 2 || r.MigrationNonce != 1 || s.GetNonce(owner) != 1 {
+			t.Fatalf("post-proof state: record=%+v account nonce=%d", r, s.GetNonce(owner))
+		}
+		// A correctly signed enrollment cannot reacquire old authority after 0x7e.
+		pk, sk := pqSeedKey(0xa4)
+		en := &types.PQEnrollTx{ChainID: cfg.ChainID, Nonce: 1, GasTipCap: big.NewInt(params.GWei), GasFeeCap: big.NewInt(2 * params.GWei), Gas: 1000000, AlgID: 1, PublicKey: pk.Bytes()}
+		en.PoPSignature = pqSignTag(t, sk, "ETH-PQ-ENROLL-POP/v1", PQEnrollmentDigest(cfg.ChainID, owner, 1, 1, en.PublicKey))
+		digest := en.SigningHash()
+		sig, err := crypto.Sign(digest[:], key)
+		if err != nil {
+			t.Fatal(err)
+		}
+		en.R, en.S, en.V = new(big.Int).SetBytes(sig[:32]), new(big.Int).SetBytes(sig[32:64]), new(big.Int).SetUint64(uint64(sig[64]))
+		if _, err := validatePQ(s, cfg, blocks[0].Header(), types.NewTx(en), owner, true, verifyPQMigrationSignatureAt); err == nil || err.Error() != "ALREADY_MIGRATED" {
+			t.Fatalf("post-proof enrollment: %v", err)
+		}
+	})
+	t.Run("ECDSA-after-proof-invalid", func(t *testing.T) {
+		reversed := types.NewBlock(blocks[0].Header(), &types.Body{Transactions: []*types.Transaction{migration, ecdsa}, Withdrawals: blocks[0].Withdrawals()}, nil, trie.NewStackTrie(nil))
+		if _, err := importBlocks(t, []*types.Block{reversed}); !errors.Is(err, ErrECDSADisabled) {
+			t.Fatalf("post-proof ECDSA import: %v", err)
+		}
+	})
+}
