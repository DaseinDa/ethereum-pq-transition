index 0000000000000000000000000000000000000000..1b0e3c84c84c5d2975ea9ff336612c408dbda7bf
--- /dev/null
+++ b/core/txpool/blobpool/pq_r1.go
@@ -0,0 +1,115 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+// Research client: R1 for type-3 envelopes in the blob subpool.
+
+package blobpool
+
+import (
+	"container/heap"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core"
+	"github.com/ethereum/go-ethereum/core/txpool"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/log"
+)
+
+// A type-3 envelope is an ECDSA envelope, so R1 applies to it at admission
+// (reinjection included) and at every reset (protocol spec v1.22 section 34.5
+// rule 2 (b); section 14.19 rule 2; section 28.4 rule 3; TP-1). The decision
+// is the shared predicate core.PQECDSADead, evaluated on the pool clock that
+// every subpool reads (txpool.PQPoolTime of the head, never wall time): from T
+// on for every sender, and in [T0, T) for a sender whose registry mode is not
+// LEGACY. Nothing latches: at a reset whose head moved back so that now < T,
+// the pre-T rule applies again. Pool policy only; block validity stays with
+// R1 in the shared state-processing path.
+
+// pqDeadByType is R1 after T, decided from the type and the pool clock before
+// any sender recovery and without a registry read (spec l. 360 and section
+// 14.27 rule (i)). core.PQECDSADead is true for every address there, so this
+// early check and the stateful check of validateTx never disagree.
+func (p *BlobPool) pqDeadByType(head *types.Header) bool {
+	config := p.chain.Config()
+	return config.PQMigrate != nil && head != nil && txpool.PQPoolTime(head, config) >= config.PQMigrate.T
+}
+
+// pqDead is R1 for a type-3 envelope of addr at the current head's pool clock.
+// The caller holds the pool lock (before T it reads the registry from p.state).
+func (p *BlobPool) pqDead(addr common.Address) bool {
+	config := p.chain.Config()
+	if config.PQMigrate == nil {
+		return false
+	}
+	return core.PQECDSADead(p.state, config.PQMigrate, addr, txpool.PQPoolTime(p.head.Load(), config))
+}
+
+// pqR1 is the admission form of pqDead, with the code and name of section
+// 14.14 (ECDSA_DISABLED, the error the nonce-ordered subpool returns too).
+func (p *BlobPool) pqR1(tx *types.Transaction) error {
+	if p.chain.Config().PQMigrate == nil {
+		return nil
+	}
+	from, err := types.Sender(p.signer, tx) // cached by ValidateTxBasics on the usual paths
+	if err != nil {
+		return err
+	}
+	if p.pqDead(from) {
+		return core.ErrECDSADisabled
+	}
+	return nil
+}
+
+// evictPQR1 removes every held type-3 envelope whose sender fails R1 at the
+// current head: the pending set (index, lookup, accounting and the on-disk
+// store, whose deletion also keeps a restart from resurrecting it) and the
+// gapped reorder buffer. All envelopes of one account share its sender, so an
+// account is removed whole or not at all. The limbo is not touched: it holds
+// envelopes already included in a block, kept until finality only so that a
+// reorg can reinject them, and reinject applies R1 before any of them can
+// re-enter the pool. The caller holds the pool lock; the eviction heap may not
+// exist yet (start-up), in which case it is built afterwards from the index.
+func (p *BlobPool) evictPQR1() {
+	if p.chain.Config().PQMigrate == nil {
+		return
+	}
+	for addr, txs := range p.index {
+		if !p.pqDead(addr) {
+			continue
+		}
+		ids := make([]uint64, 0, len(txs))
+		for _, meta := range txs {
+			ids = append(ids, meta.id)
+			p.stored -= uint64(meta.storageSize)
+			p.lookup.untrack(meta)
+		}
+		delete(p.index, addr)
+		delete(p.spent, addr)
+		p.updateBlocked(addr)
+		if p.evict != nil {
+			if i, ok := p.evict.index[addr]; ok {
+				heap.Remove(p.evict, i)
+			}
+		}
+		p.reserver.Release(addr)
+
+		log.Debug("Evicting blob transactions under R1", "from", addr, "ids", ids)
+		dropInvalidMeter.Mark(int64(len(ids)))
+		for _, id := range ids {
+			if err := p.store.Delete(id); err != nil {
+				log.Error("Failed to delete blob transaction", "from", addr, "id", id, "err", err)
+			}
+		}
+	}
+	for addr, txs := range p.gapped {
+		if !p.pqDead(addr) {
+			continue
+		}
+		for _, ptx := range txs {
+			delete(p.gappedSource, ptx.Tx.Hash())
+		}
+		delete(p.gapped, addr)
+		gappedEvictedMeter.Mark(int64(len(txs)))
+	}
+	gappedGauge.Update(int64(len(p.gappedSource)))
+}
