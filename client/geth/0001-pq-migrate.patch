+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package core
+
+import (
+	"errors"
+	"github.com/cloudflare/circl/sign/mldsa/mldsa44"
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core/state"
+	"github.com/ethereum/go-ethereum/core/tracing"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/params"
+	"github.com/holiman/uint256"
+	"math/big"
+	"testing"
+)
+
+// A component check of check-7 ordering with a real ML-DSA-44 signature.
+// The proof bytes are deliberately not a proof: no Full verifier is invoked.
+func TestPQPoolSponsorPolicyBeforeSignature(t *testing.T) {
+	cfg := *params.AllDevChainProtocolChanges
+	cfg.AmsterdamTime, cfg.BogotaTime, cfg.UBTTime = nil, nil, nil
+	cfg.PQMigrate = &params.PQMigrateConfig{T: 50, Registry: common.HexToAddress("800"), FullResearch: &params.PQFullResearchConfig{Version: 0x80000008, Sunset: 10000, ProofLifetime: 604800, MaxProofBytes: 196608, MaxTxBytes: 199332, TxGasCap: params.MaxTxGas, VerifyGas: params.PQFinalVerifyGas}}
+	sponsor := common.HexToAddress("1234")
+	pk, sk := pqSeedKey(0x72)
+	s, err := state.New(types.EmptyRootHash, state.NewDatabaseForTesting())
+	if err != nil {
+		t.Fatal(err)
+	}
+	s.SetCode(sponsor, append([]byte{0xef, 1, 1}, pk.Bytes()...), tracing.CodeChangeUnspecified)
+	slot, next := PQRecordSlots(sponsor)
+	word := common.Hash{}
+	word[31] = 3
+	word[30] = 1
+	s.SetState(cfg.PQMigrate.Registry, slot, word)
+	s.SetState(cfg.PQMigrate.Registry, next, PQKeyCommit(1, pk.Bytes()))
+	s.SetBalance(sponsor, uint256.NewInt(1000000000000000000), tracing.BalanceChangeUnspecified)
+	m := &types.PQMigrateTx{ChainID: cfg.ChainID, LegacyAddress: common.HexToAddress("abcd"), AlgID: 1, PQPKCommit: common.HexToHash("01"), Expiry: 1000, MaxAccountFee: big.NewInt(0), FeeMode: 2, GasTipCap: big.NewInt(1), GasFeeCap: big.NewInt(2), Gas: 16000000, SponsorOption: &types.PQMigrationSponsor{Sponsor: sponsor, ValidUntil: 1000}, VerifierVersion: 0x80000008, ProofCarrier: types.PQMigrationCarrier{Proof: []byte("not a proof")}}
+	m.SponsorOption.Signature = pqSignTag(t, sk, "ETH-PQ-SPONSOR/v1", m.SponsorSigningHash())
+	h := &types.Header{Number: big.NewInt(1), Time: 100, BaseFee: big.NewInt(1)}
+	good := types.NewTx(m)
+	badM, _ := types.NewTx(m).AsPQMigrate()
+	badM.SponsorOption.Signature[0] ^= 1
+	bad := types.NewTx(badM)
+	saved := pqSignatureFailures
+	t.Cleanup(func() { pqSignatureFailures = saved })
+	verifications := 0
+	pqSignatureFailures = newPQSignatureFailureCache(32, func(pk []byte, tag string, d common.Hash, sig []byte) bool {
+		verifications++
+		return verifyPQMigrationSignatureUncached(pk, tag, d, sig)
+	})
+	rejected := errors.New("INSUFFICIENT_FEE_BALANCE")
+	err = ValidatePQMigrateStateWithSponsorPolicy(bad, s.Copy(), h, &cfg, func() error { return rejected })
+	if !errors.Is(err, rejected) || verifications != 0 {
+		t.Fatalf("cheap failure must win without crypto: %v, %d", err, verifications)
+	}
+	err = ValidatePQMigrateStateWithSponsorPolicy(bad, s.Copy(), h, &cfg, func() error { return nil })
+	var rejection *PQMigrationError
+	if !errors.As(err, &rejection) || rejection.Name != "BAD_SPONSOR_SIG" || verifications != 1 {
+		t.Fatalf("policy cannot bypass signature: %v, %d", err, verifications)
+	}
+	err = ValidatePQMigrateStateWithSponsorPolicy(good, s.Copy(), h, &cfg, func() error { return nil })
+	if err != nil || verifications != 2 {
+		t.Fatalf("valid control: %v, %d", err, verifications)
+	}
+	if len(m.SponsorOption.Signature) != mldsa44.SignatureSize {
+		t.Fatal("wrong signature profile")
+	}
+}
