+// -32603 makes local verifier availability an internal JSON-RPC error. The
+// Engine API result is absent; it must not announce INVALID/VALID or cache a
+// failed proof verdict. Re-submitting after repair re-executes the whole block.
+type pqFullRPCError struct{ error }
+
+func (pqFullRPCError) ErrorCode() int { return -32603 }
+
+func logPQFullImported(block *types.Block, elapsed time.Duration) {
+	for position, tx := range block.Transactions() {
+		if m, ok := tx.AsPQMigrate(); ok {
+			log.Info("PQ_IMPORT_ACCEPT", "context", "import", "block", block.Hash(), "txhash", tx.Hash(), "position", position, "timestamp", block.Time(), "piHash", crypto.Keccak256Hash(m.PublicInputs()), "proofHash", crypto.Keccak256Hash(m.ProofCarrier.Proof), "blockProcessingElapsed", elapsed)
+		}
+	}
+}
