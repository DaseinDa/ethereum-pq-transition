+)
+
+func batchAtNonce(t *testing.T, tx *types.Transaction, nonce uint64) *types.Transaction {
+	t.Helper()
+	b, _ := tx.AsPQBatch()
+	owned := types.NewTx(b)
+	b, _ = owned.AsPQBatch()
+	b.SponsorNonce = nonce
+	return pqtest.SignBatch(t, b)
+}
+
+// This single is explicitly a policy component: its state/proof hooks are the
+// componentPool hooks. Batches below still use real ML-DSA and native C checks.
+func batchSponsorComponentSingle(batch *types.Transaction) *types.Transaction {
+	b, _ := batch.AsPQBatch()
+	cost := new(big.Int).Mul(new(big.Int).SetUint64(b.Gas), b.GasFeeCap)
+	return changed(componentTx(9, 20, params.GWei, params.GWei), func(m *types.PQMigrateTx) {
+		m.ChainID = new(big.Int).Set(b.ChainID)
+		m.VerifierVersion = b.VerifierVersion
+		m.Expiry = b.Entries[0].Expiry
+		m.GasFeeCap = new(big.Int).Div(cost, new(big.Int).SetUint64(m.Gas))
+		m.SponsorOption.Sponsor = b.Sponsor
+		m.SponsorOption.ValidUntil = b.SponsorValidUntil
+	})
+}
+
+func TestBatchResetLocalFaultThenSingleDoesNotBanSponsor(t *testing.T) {
+	p, c, batch, _ := realBatchPool(t)
+	b, _ := batch.AsPQBatch()
+	if err := p.Add([]*types.Transaction{batch}, true)[0]; err != nil {
+		t.Fatal("initial native admission", err)
+	}
+	healthy := c.s.Copy()
+	c.s.SetExternalError(errors.New("R1 missing state"))
+	p.Reset(nil, p.head)
+	held := p.batches[batch.Hash()]
+	if held == nil || held.admitted || held.pending || held.resetReady || held.deferredOrder == 0 || p.Has(batch.Hash()) || len(p.bans) != 0 {
+		t.Fatal("R1 local fault did not quarantine admitted batch without a ban")
+	}
+	// The storage fault clears between heads. There is room for either
+	// obligation alone, not for both; the held batch is not admitted liability.
+	c.s = healthy
+	cost := new(big.Int).Mul(new(big.Int).SetUint64(b.Gas), b.GasFeeCap)
+	c.s.SetBalance(b.Sponsor, uint256.MustFromBig(cost), tracing.BalanceChangeUnspecified)
+	p.state = c.s.Copy()
+	single := batchSponsorComponentSingle(batch)
+	if err := p.Add([]*types.Transaction{single}, true)[0]; err != nil {
+		t.Fatal("single after local recovery", err)
+	}
+	p.Reset(nil, p.head)
+	if !p.Has(single.Hash()) || p.batches[batch.Hash()] != nil || len(p.bans) != 0 {
+		t.Fatal("R2 treated a held retry's admission rejection as a sponsor ban")
+	}
+	if p.diagnostics[batch.Hash()].reason != "INSUFFICIENT_FEE_BALANCE (0x0302)" || p.sources["local"].failures != 0 || len(p.sponsorStrikes) != 0 {
+		t.Fatal("R2 retry rejection reason or source accounting")
+	}
+}
+
+func TestBatchAndSingleDeferredRetriesShareDeferralOrder(t *testing.T) {
+	for _, batchFirst := range []bool{false, true} {
+		t.Run(map[bool]string{false: "single-first", true: "batch-first"}[batchFirst], func(t *testing.T) {
+			p, c, batch, _ := realBatchPool(t)
+			b, _ := batch.AsPQBatch()
+			single := batchSponsorComponentSingle(batch)
+			cost := new(big.Int).Mul(new(big.Int).SetUint64(b.Gas), b.GasFeeCap)
+			c.s.SetBalance(b.Sponsor, uint256.MustFromBig(cost), tracing.BalanceChangeUnspecified)
+			first, second := single, batch
+			if batchFirst {
+				first, second = batch, single
+			}
+			p.deferTx(first, "first-held", ErrLocalUnavailable)
+			p.deferTx(second, "second-held", ErrLocalUnavailable)
+			p.deferTx(first, "retry-held", ErrLocalUnavailable)
+			queued := p.deferredRetries()
+			if len(queued) != 2 || queued[0].tx.Hash() != first.Hash() || queued[1].tx.Hash() != second.Hash() || queued[0].order >= queued[1].order || p.deferredOrder != 2 {
+				t.Fatal("types or repeated deferral changed the common retry order")
+			}
+			p.Reset(nil, p.head)
+			if !p.Has(first.Hash()) || p.Has(second.Hash()) || len(p.deferred) != 0 || len(p.bans) != 0 || len(p.sources) != 0 {
+				t.Fatal("shared sponsor balance did not preserve first deferral without penalty")
+			}
+		})
+	}
+}
+
+func resetBranchBlock(parent *types.Block, label string, txs ...*types.Transaction) *types.Block {
+	h := types.CopyHeader(parent.Header())
+	h.ParentHash = parent.Hash()
+	h.Number = new(big.Int).Add(parent.Number(), common.Big1)
+	h.Time += 12
+	h.Extra = []byte(label)
+	return types.NewBlock(h, &types.Body{Transactions: txs}, nil, trie.NewStackTrie(nil))
+}
+
+// A synthetic three-branch history drives two real Reset calls and real C
+// admission. It is pool-reinjection evidence, not a live consensus reorg.
+func TestBatchHeldAboveGapSurvivesTwoResets(t *testing.T) {
+	p, c, zero, _ := realBatchPool(t)
+	b, _ := zero.AsPQBatch()
+	one := batchAtNonce(t, zero, b.SponsorNonce+1)
+	genesis := types.NewBlockWithHeader(p.head)
+	a1 := resetBranchBlock(genesis, "A1", zero)
+	a2 := resetBranchBlock(a1, "A2", one)
+	b1 := resetBranchBlock(genesis, "B1", zero)
+	c1 := resetBranchBlock(genesis, "C1")
+	c.blocks = map[common.Hash]*types.Block{genesis.Hash(): genesis, a1.Hash(): a1, a2.Hash(): a2, b1.Hash(): b1, c1.Hash(): c1}
+	p.head = a2.Header()
+	healthy := c.s.Copy()
+	c.s.SetNonce(b.Sponsor, b.SponsorNonce+1, tracing.NonceChangeUnspecified)
+	c.s.SetExternalError(errors.New("R1 canonical state unavailable"))
+	p.Reset(a2.Header(), b1.Header()) // Only nonce1 is orphaned; nonce0 is in B1.
+	if held := p.batches[one.Hash()]; held == nil || held.admitted || held.pending || p.Has(one.Hash()) {
+		t.Fatal("R1 did not retain its locally unavailable orphan")
+	}
+	c.s = healthy                     // C1 has neither batch, so the sponsor nonce is zero again.
+	p.Reset(b1.Header(), c1.Header()) // Held nonce1 must precede reinjected nonce0.
+	if !p.Has(zero.Hash()) || !p.Has(one.Hash()) || p.Status(zero.Hash()) != txpool.TxStatusPending || p.Status(one.Hash()) != txpool.TxStatusPending || p.Nonce(b.Sponsor) != b.SponsorNonce+2 {
+		t.Fatal("R2 lost the held batch above the temporarily missing nonce")
+	}
+	if len(p.sources) != 0 || len(p.bans) != 0 || len(p.sponsorStrikes) != 0 || len(p.diagnostics) != 0 {
+		t.Fatal("internal two-reset reinjection charged or rejected a source")
+	}
+}
+
+func TestBatchHeldGapWithoutFillerIsNotAnnounced(t *testing.T) {
+	p, _, zero, _ := realBatchPool(t)
+	b, _ := zero.AsPQBatch()
+	one := batchAtNonce(t, zero, b.SponsorNonce+1)
+	announced := make(chan core.NewTxsEvent, 2)
+	defer p.SubscribeTransactions(announced, true).Unsubscribe()
+	p.deferBatch(one)
+	p.Reset(nil, p.head)
+	if p.batches[one.Hash()] != nil || p.Has(one.Hash()) || len(announced) != 0 || len(p.bans) != 0 {
+		t.Fatal("final gap sweep retained or announced its rejected held retry")
+	}
+}
+
+func setBatchSponsorKey(s *state.StateDB, registry, sponsor common.Address, pk []byte) {
+	s.SetCode(sponsor, append([]byte{0xef, 1, 1}, pk...), tracing.CodeChangeUnspecified)
+	_, slot := core.PQRecordSlots(sponsor)
+	s.SetState(registry, slot, core.PQKeyCommit(1, pk))
+}
+
+func TestBatchResetSignatureGapStillCountsHigherLiability(t *testing.T) {
+	p, c, zero, _ := realBatchPool(t)
+	b, _ := zero.AsPQBatch()
+	var oldSeed [mldsa44.SeedSize]byte
+	oldSeed[0] = 0x54 // Public alternate test authority.
+	oldPK, oldSK := mldsa44.NewKeyFromSeed(&oldSeed)
+	batches := []*types.Transaction{zero, batchAtNonce(t, zero, 1), batchAtNonce(t, zero, 2)}
+	middle, _ := batches[1].AsPQBatch()
+	digest, tag := middle.SponsorSigningHash(), []byte("ETH-PQ-SPONSOR/v1")
+	middle.SponsorSignature = make([]byte, mldsa44.SignatureSize)
+	if err := mldsa44.SignTo(oldSK, append(append([]byte{}, tag...), digest[:]...), tag, false, middle.SponsorSignature); err != nil {
+		t.Fatal(err)
+	}
+	batches[1] = types.NewTx(middle)
+	for i, tx := range batches {
+		// Each initial admission has a matching key and verifies real C.
+		// Only the middle signature is stale under the final canonical key.
+		p.state = c.s.Copy()
+		if i == 1 {
+			setBatchSponsorKey(p.state, c.cfg.PQMigrate.Registry, b.Sponsor, oldPK.Bytes())
+		}
+		if err := p.Add([]*types.Transaction{tx}, true)[0]; err != nil {
+			t.Fatal("initial admission", i, err)
+		}
+	}
+	cost := new(big.Int).Mul(new(big.Int).SetUint64(b.Gas), b.GasFeeCap)
+	c.s.SetBalance(b.Sponsor, uint256.MustFromBig(new(big.Int).Mul(cost, big.NewInt(2))), tracing.BalanceChangeUnspecified)
+	check := c.s.Copy()
+	check.SetNonce(b.Sponsor, 1, tracing.NonceChangeUnspecified)
+	if err := core.ValidatePQBatchState(batches[1], check, p.nextHeader(), c.cfg, false); errorName(err) != "BAD_SPONSOR_SIG" {
+		t.Fatal("middle batch must fail only the signature at this head", err)
+	}
+	p.Reset(nil, p.head)
+	if len(p.batches) != 0 || !time.Now().Before(p.bans[b.Sponsor]) || p.sources["local"].failures != 0 || len(p.sponsorStrikes) != 0 {
+		t.Fatal("signature-created gap hid nonce2 from the cumulative bound")
+	}
+}
