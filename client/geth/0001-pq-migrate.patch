+// The six-entry F-10 vector tests the settlement helper, not the four-owner
+// wire/verifier profile. Each individual entry has passed the owner gate; the
+// placeholder carrier is never presented as an accepted aggregate proof.
+func TestPQBatchFeeVectorF10(t *testing.T) {
+	b, s, cfg, h, sign := batchStateFixture(t)
+	for i := byte(5); i <= 6; i++ {
+		b.Entries = append(b.Entries, types.PQBatchEntry{LegacyAddress: common.Address{i}, AlgID: 1, PQPKCommit: common.Hash{i}, Expiry: 1000, MaxAccountFee: new(big.Int), FeeMode: 2})
+	}
+	modes := []uint8{1, 1, 1, 2, 3, 3}
+	fees := []uint64{100, 0, 0, 0, 100, 0}
+	plan := &pqBatchPlan{old: make([]PQRecord, 6), next: make([]PQRecord, 6), skip: make([]uint16, 6)}
+	for i := range b.Entries {
+		e := &b.Entries[i]
+		e.FeeMode = modes[i]
+		if e.FeeMode != 2 {
+			e.MaxAccountFee = big.NewInt(100)
+			e.FeeAuthUntil = h.Time
+		}
+		if e.FeeMode == 1 {
+			e.FeeSponsor = b.Sponsor
+		}
+		if i == 1 {
+			e.FeeSponsor = common.Address{99}
+		}
+		if i == 2 || i == 5 {
+			e.FeeAuthUntil = h.Time - 1
+		}
+		s.SetBalance(e.LegacyAddress, uint256.NewInt(1000), tracing.BalanceChangeUnspecified)
+		if code, err := pqBatchEntryCheck(*e, PQRecord{}, nil, h, cfg.PQMigrate); err != nil || code != 0 {
+			t.Fatal(code, err)
+		}
+		plan.next[i] = PQRecord{Mode: 2, AlgID: e.AlgID, MigrationNonce: 1, Commit: e.PQPKCommit}
+	}
+	tx := sign(b)
+	plan.used = batchExpectedGas(t, b, 6*44200)
+	h.Coinbase = common.Address{90}
+	before := new(uint256.Int).Set(s.GetBalance(b.Sponsor))
+	s.SetTxContext(tx.Hash(), 0, 1)
+	applyPQBatchPlan(s, tx, h, cfg.PQMigrate, plan)
+	logs := s.GetLogs(tx.Hash(), h.Number.Uint64(), common.Hash{}, h.Time)
+	if len(logs) != 6 {
+		t.Fatal("F-10 log count", len(logs))
+	}
+	for i, e := range b.Entries {
+		if s.GetBalance(e.LegacyAddress).Uint64() != 1000-fees[i] {
+			t.Fatal("F-10 reimbursement", i, s.GetBalance(e.LegacyAddress))
+		}
+		assertBatchLog(t, logs[i], cfg.PQMigrate.Registry, e, i, 0, 1, false, false)
+	}
+	want := new(uint256.Int).Sub(before, uint256.NewInt(2*plan.used))
+	want.Add(want, uint256.NewInt(200))
+	if s.GetBalance(b.Sponsor).Cmp(want) != 0 || s.GetBalance(h.Coinbase).Uint64() != plan.used || s.GetNonce(b.Sponsor) != 1 {
+		t.Fatal("F-10 payer/reward/nonce accounting")
+	}
+}
