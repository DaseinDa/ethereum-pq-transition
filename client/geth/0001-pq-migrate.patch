@@ -0,0 +1,177 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package pqpool
+
+import (
+	"encoding/binary"
+	"math/big"
+	"testing"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core"
+	"github.com/ethereum/go-ethereum/core/tracing"
+	"github.com/ethereum/go-ethereum/core/txpool"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/internal/pqtest"
+	"github.com/ethereum/go-ethereum/params"
+	"github.com/holiman/uint256"
+)
+
+func finalPoolRecord(c *componentChain, owner common.Address, record core.PQRecord) {
+	k, k1 := core.PQRecordSlots(owner)
+	var word common.Hash
+	word[31], word[30] = record.Mode, record.AlgID
+	binary.BigEndian.PutUint64(word[22:30], record.EnrolledAt)
+	binary.BigEndian.PutUint64(word[14:22], record.MigrationNonce)
+	c.s.SetState(c.cfg.PQMigrate.Registry, k, word)
+	c.s.SetState(c.cfg.PQMigrate.Registry, k1, record.Commit)
+}
+
+// Public F proofs retain their original PI and expiry. Explicit historical
+// timestamps exercise real default verification hooks on component chain state;
+// these tests do not renew proofs or establish live recovery evidence.
+func currentFPool(t *testing.T, mode uint8) (*Pool, *componentChain, *types.Transaction, uint64) {
+	t.Helper()
+	tx, now := pqtest.SingleF(t, mode)
+	m, _ := tx.AsPQMigrate()
+	p, c, _ := componentPool(t)
+	c.cfg.ChainID = new(big.Int).Set(m.ChainID)
+	c.cfg.AmsterdamTime, c.cfg.BogotaTime, c.cfg.UBTTime = nil, nil, nil
+	cfg := c.cfg.PQMigrate
+	cfg.T0, cfg.ReceivingTime, cfg.T = now-100, now-100, now-50
+	cfg.LegacySeedProofFromT0 = true
+	cfg.FullResearch = &params.PQFullResearchConfig{
+		Backend: params.PQFinalBackend, Version: params.PQFinalVersion,
+		NativeAlgorithmDigest: params.PQFinalAlgorithmDigest, FinalKeyDigest: params.PQFinalKeyDigest,
+		Sunset: ^uint64(0), ProofLifetime: 604800, MaxProofBytes: params.PQFinalMaxProofBytes,
+		MaxTxBytes: params.PQFinalMaxTxBytes, TxGasCap: params.MaxTxGas, VerifyGas: params.PQFinalVerifyGas,
+	}
+	c.s.SetBalance(m.LegacyAddress, uint256.NewInt(2000000000000000000), tracing.BalanceChangeUnspecified)
+	c.s.SetNonce(m.LegacyAddress, 9, tracing.NonceChangeUnspecified)
+	if m.MigrationNonce != 0 {
+		finalPoolRecord(c, m.LegacyAddress, core.PQRecord{Mode: 2, AlgID: 1, MigrationNonce: m.MigrationNonce, Commit: common.Hash{0x99}})
+	}
+	if sponsor := m.Sponsor(); sponsor != nil {
+		pk := pqtest.SponsorPublicKey()
+		finalPoolRecord(c, sponsor.Sponsor, core.PQRecord{Mode: 2, AlgID: 1, MigrationNonce: 1, Commit: core.PQKeyCommit(1, pk)})
+		c.s.SetCode(sponsor.Sponsor, append([]byte{0xef, 1, 1}, pk...), tracing.CodeChangeUnspecified)
+		c.s.SetBalance(sponsor.Sponsor, uint256.NewInt(5000000000000000000), tracing.BalanceChangeUnspecified)
+		c.s.SetNonce(sponsor.Sponsor, 7, tracing.NonceChangeUnspecified)
+	}
+	p.head = &types.Header{Number: big.NewInt(0), Time: now - txpool.PQPoolSlot(c.cfg), GasLimit: 45000000, GasUsed: 22500000, BaseFee: big.NewInt(params.GWei), Difficulty: new(big.Int)}
+	p.state = c.s.Copy()
+	p.deliveryClock.Store(now)
+	p.checkState, p.checkProof = nil, core.ValidatePQMigrateProof
+	return p, c, tx, now
+}
+
+func TestPQCurrentFPoolAdmissionBoundaries(t *testing.T) {
+	cases := []struct {
+		name string
+		mode uint8
+		want string
+	}{
+		{"before-T0", 0, "FORK_NOT_ACTIVE"},
+		{"at-T0", 0, ""},
+		{"before-T-legacy-profile", 0, "FORK_NOT_ACTIVE"},
+		{"at-T-legacy-profile", 0, ""},
+		{"before-verifier-activation", 0, "WRONG_VERIFIER_VERSION"},
+		{"at-verifier-activation", 0, ""},
+		{"before-verifier-sunset", 0, ""},
+		{"at-verifier-sunset", 0, "WRONG_VERIFIER_VERSION"},
+		{"before-T-plus-W", 1, ""},
+		{"at-T-plus-W", 1, "OVERRIDE_WINDOW_CLOSED"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			p, c, tx, now := currentFPool(t, tc.mode)
+			cfg := c.cfg.PQMigrate
+			switch tc.name {
+			case "before-T0":
+				cfg.T0, cfg.T = now+1, now+100
+			case "at-T0":
+				cfg.T0, cfg.T = now, now+100
+			case "before-T-legacy-profile":
+				cfg.LegacySeedProofFromT0, cfg.T = false, now+1
+			case "at-T-legacy-profile":
+				cfg.LegacySeedProofFromT0, cfg.T = false, now
+			case "before-verifier-activation":
+				cfg.FullResearch.Activation = now + 1
+			case "at-verifier-activation":
+				cfg.FullResearch.Activation = now
+			case "before-verifier-sunset":
+				cfg.FullResearch.Sunset = now + 1
+			case "at-verifier-sunset":
+				cfg.FullResearch.Sunset = now
+			case "before-T-plus-W", "at-T-plus-W":
+				cfg.T = now - cfg.W
+				if tc.want == "" {
+					cfg.T++
+				}
+				cfg.T0 = cfg.T - 100
+				m, _ := tx.AsPQMigrate()
+				finalPoolRecord(c, m.LegacyAddress, core.PQRecord{Mode: 1, AlgID: 1, EnrolledAt: cfg.T - 10, MigrationNonce: m.MigrationNonce, Commit: common.Hash{0x99}})
+			}
+			cfg.ReceivingTime = cfg.T0
+			p.state = c.s.Copy()
+			if got := errorName(p.Add([]*types.Transaction{tx}, true)[0]); got != tc.want {
+				t.Fatalf("got %q, want %q", got, tc.want)
+			}
+			if p.Has(tx.Hash()) != (tc.want == "") {
+				t.Fatal("incorrect pending state")
+			}
+			m, _ := tx.AsPQMigrate()
+			if c.s.GetNonce(m.LegacyAddress) != 9 || len(p.bans) != 0 || p.sources["local"].failures != 0 {
+				t.Fatal("boundary admission mutated state or penalized source")
+			}
+		})
+	}
+}
+
+func TestPQCurrentFHeldPoolRevalidatesBoundaryHeads(t *testing.T) {
+	for _, name := range []string{"T0-move-back", "T-crossing", "activation-move-back", "sunset", "T-plus-W"} {
+		t.Run(name, func(t *testing.T) {
+			mode := uint8(0)
+			if name == "T-plus-W" {
+				mode = 1
+			}
+			p, c, tx, now := currentFPool(t, mode)
+			cfg, target := c.cfg.PQMigrate, now+12
+			switch name {
+			case "T0-move-back":
+				cfg.T0, cfg.T, target = now, now+100, now-1
+			case "T-crossing":
+				cfg.T = now + 12
+			case "activation-move-back":
+				cfg.FullResearch.Activation, target = now, now-1
+			case "sunset":
+				cfg.FullResearch.Sunset = now + 12
+			case "T-plus-W":
+				cfg.T = now + 12 - cfg.W
+				cfg.T0 = cfg.T - 100
+				m, _ := tx.AsPQMigrate()
+				finalPoolRecord(c, m.LegacyAddress, core.PQRecord{Mode: 1, AlgID: 1, EnrolledAt: cfg.T - 10, MigrationNonce: m.MigrationNonce, Commit: common.Hash{0x99}})
+			}
+			cfg.ReceivingTime = cfg.T0
+			p.state = c.s.Copy()
+			if err := p.Add([]*types.Transaction{tx}, true)[0]; err != nil {
+				t.Fatal("initial current-F admission", err)
+			}
+			old := p.head
+			head := types.CopyHeader(old)
+			head.Number = big.NewInt(1)
+			head.ParentHash = old.Hash()
+			head.Time = target - txpool.PQPoolSlot(c.cfg)
+			// Missing ancestry makes the optional orphan scan unavailable; this
+			// fixture specifically tests held-state revalidation at the new head.
+			p.Reset(old, head)
+			if p.Has(tx.Hash()) != (name == "T-crossing") {
+				t.Fatal("held migration crossed a closed owner/verifier boundary")
+			}
+			if len(p.bans) != 0 || p.sources["local"].failures != 0 {
+				t.Fatal("held boundary eviction penalized source/sponsor")
+			}
+		})
+	}
+}
