+//go:build pq_historical
+
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package core
+
+// Actual core/Full boundary fixtures. Public test keys only. The deadline tests
+// use explicit synthetic component headers, not elapsed natural network time.
+//
+import (
+	"bytes"
+	"context"
+	"errors"
+	"math/big"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core/state"
+	"github.com/ethereum/go-ethereum/core/tracing"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/core/vm"
+	"github.com/holiman/uint256"
+)
+
+func overrideRead(t *testing.T, name string) *types.Transaction {
+	t.Helper()
+	dir := os.Getenv("PQ_OVERRIDE_FIXTURES")
+	if dir == "" {
+		t.Fatal("PQ_OVERRIDE_FIXTURES required; no mock/skip fallback")
+	}
+	raw, e := os.ReadFile(filepath.Join(dir, name+".bin"))
+	if e != nil {
+		t.Fatal(e)
+	}
+	tx := new(types.Transaction)
+	if e = tx.UnmarshalBinary(raw); e != nil {
+		t.Fatal(e)
+	}
+	again, e := tx.MarshalBinary()
+	if e != nil || !bytes.Equal(raw, again) {
+		t.Fatal("canonical raw mismatch")
+	}
+	return tx
+}
+
+func overrideReachable(t *testing.T) (*state.StateDB, *vm.EVM, *types.Header) {
+	t.Helper()
+	// Reuse the pinned worker/config validator, not its generated Registry state.
+	_, base, h := fullEnv(t, common.HexToAddress("900"))
+	cfg := base.ChainConfig()
+	cfg.PQMigrate.T = 1760572800 // Exactly 31536000 seconds before 1792108800.
+	h.Time = cfg.PQMigrate.T - 10
+	s, e := state.New(types.EmptyRootHash, state.NewDatabaseForTesting())
+	if e != nil {
+		t.Fatal(e)
+	}
+	s.SetCode(cfg.PQMigrate.Registry, []byte{0}, tracing.CodeChangeUnspecified)
+	s.SetNonce(cfg.PQMigrate.Registry, 1, tracing.NonceChangeUnspecified)
+	s.SetBalance(fullLegacy, uint256.NewInt(2000000000000000000), tracing.BalanceChangeUnspecified)
+	s.SetBalance(fullSponsor, uint256.NewInt(5000000000000000000), tracing.BalanceChangeUnspecified)
+	ctx := base.Context
+	ctx.Time = h.Time
+	evm := vm.NewEVM(ctx, s, cfg, vm.Config{})
+	t.Cleanup(evm.Release)
+	gp := NewGasPool(h.GasLimit)
+	for i, n := range []string{"sponsor-create", "attacker-enroll", "attacker-activate"} {
+		pqApply(t, s, evm, h, gp, overrideRead(t, n), i)
+	}
+	r := ReadPQRecord(s, cfg.PQMigrate.Registry, fullLegacy)
+	if r.Mode != 1 || r.MigrationNonce != 1 || r.EnrolledAt != h.Time || !PQActivated(s, cfg.PQMigrate, fullLegacy) || s.GetNonce(fullLegacy) != 2 {
+		t.Fatal("natural attacker setup")
+	}
+	return s, evm, h
+}
+
+func overrideAt(evm *vm.EVM, h *types.Header, when uint64) { h.Time = when; evm.Context.Time = when }
+func overrideReject(t *testing.T, s *state.StateDB, evm *vm.EVM, h *types.Header, tx *types.Transaction, want string) {
+	t.Helper()
+	root := s.IntermediateRoot(evm.GetRules())
+	s.SetTxContext(tx.Hash(), 9, 10)
+	_, _, e := ApplyTransaction(context.Background(), evm, NewGasPool(h.GasLimit), s, h, tx)
+	if e == nil || !strings.Contains(e.Error(), want) {
+		t.Fatalf("wanted %s, got %v", want, e)
+	}
+	if s.IntermediateRoot(evm.GetRules()) != root {
+		t.Fatal("rejection changed state")
+	}
+	t.Logf("rejected %s; state unchanged; actual raw=%s", want, tx.Hash())
+}
+
+func TestPQOverrideExactWindowActualFull(t *testing.T) {
+	for _, tc := range []struct {
+		name  string
+		delta int64
+		want  string
+	}{{"last_allowed_second", -1, ""}, {"at_deadline", 0, "OVERRIDE_WINDOW_CLOSED"}, {"after_deadline", 1, "OVERRIDE_WINDOW_CLOSED"}} {
+		t.Run(tc.name, func(t *testing.T) {
+			s, evm, h := overrideReachable(t)
+			deadline := evm.ChainConfig().PQMigrate.T + evm.ChainConfig().PQMigrate.W
+			overrideAt(evm, h, uint64(int64(deadline)+tc.delta))
+			tx := overrideRead(t, "override")
+			p, _ := tx.AsPQMigrate()
+			if h.Time > p.Expiry || p.Expiry-h.Time > evm.ChainConfig().PQMigrate.FullResearch.ProofLifetime {
+				t.Fatal("proof time obscures window boundary")
+			}
+			if tc.want != "" {
+				overrideReject(t, s, evm, h, tx, tc.want)
+				return
+			}
+			rec := ReadPQRecord(s, evm.ChainConfig().PQMigrate.Registry, fullLegacy)
+			rc := pqApply(t, s, evm, h, NewGasPool(h.GasLimit), tx, 3)
+			got := ReadPQRecord(s, evm.ChainConfig().PQMigrate.Registry, fullLegacy)
+			if got.Mode != 2 || got.MigrationNonce != 2 || got.EnrolledAt != rec.EnrolledAt || got.Commit != p.PQPKCommit || len(s.GetCode(fullLegacy)) != 0 || s.GetNonce(fullLegacy) != 2 || s.GetNonce(fullSponsor) != 1 {
+				t.Fatal("override transition")
+			}
+			if len(rc.Logs) != 1 || len(rc.Logs[0].Data) != 160 || rc.Logs[0].Data[127] != 1 || rc.Logs[0].Data[159] != 0 {
+				t.Fatal("override flags")
+			}
+			t.Logf("actual Full accepted at deadline-1=%d; W=%d; gas=%d; nonce1->2; code cleared; enrolledAt preserved", h.Time, evm.ChainConfig().PQMigrate.W, rc.GasUsed)
+		})
+	}
+}
+
+func TestPQOverrideAndRecommitCompetingOrdersActualFull(t *testing.T) {
+	for _, recommitFirst := range []bool{false, true} {
+		t.Run(map[bool]string{false: "activation_first_closes_recommit", true: "recommit_first_replaces_key"}[recommitFirst], func(t *testing.T) {
+			s, evm, h := overrideReachable(t)
+			overrideAt(evm, h, 1792108799)
+			overrideReject(t, s, evm, h, overrideRead(t, "recommit"), "WRONG_MIGRATION_NONCE")
+			pqApply(t, s, evm, h, NewGasPool(h.GasLimit), overrideRead(t, "override"), 3)
+			overrideReject(t, s, evm, h, overrideRead(t, "old-attacker-reactivate"), "BAD_ACTIVATION")
+			overrideReject(t, s, evm, h, overrideRead(t, "old-attacker-spend"), "BAD_ACTIVATION")
+			overrideReject(t, s, evm, h, overrideRead(t, "override"), "WRONG_MIGRATION_NONCE")
+			target := "owner"
+			if recommitFirst {
+				rc := pqApply(t, s, evm, h, NewGasPool(h.GasLimit), overrideRead(t, "recommit"), 4)
+				r := ReadPQRecord(s, evm.ChainConfig().PQMigrate.Registry, fullLegacy)
+				if r.MigrationNonce != 3 || len(s.GetCode(fullLegacy)) != 0 || s.GetNonce(fullLegacy) != 2 || rc.Logs[0].Data[127] != 0 || rc.Logs[0].Data[159] != 1 {
+					t.Fatal("recommit effects/flags")
+				}
+				overrideReject(t, s, evm, h, overrideRead(t, "owner-activate"), "BAD_ACTIVATION")
+				target = "recommit"
+			}
+			pqApply(t, s, evm, h, NewGasPool(h.GasLimit), overrideRead(t, target+"-activate"), 5)
+			if !recommitFirst {
+				overrideReject(t, s, evm, h, overrideRead(t, "recommit"), "ALREADY_MIGRATED")
+			}
+			pqApply(t, s, evm, h, NewGasPool(h.GasLimit), overrideRead(t, target+"-spend"), 6)
+			if s.GetNonce(fullLegacy) != 4 || s.GetBalance(pqRecipient).CmpBig(big.NewInt(4000000000000)) != 0 {
+				t.Fatal("actual successor spending")
+			}
+			t.Logf("%s order; actual owner activation and spending; EVM nonce4; transferred4e12 including initial attacker activation", target)
+		})
+	}
+}
+
+func TestPQOverrideWorkerUnavailableCannotApply(t *testing.T) {
+	s, evm, h := overrideReachable(t)
+	overrideAt(evm, h, 1792108799)
+	tx := overrideRead(t, "override")
+	root := s.IntermediateRoot(evm.GetRules())
+	t.Setenv("PQ_FULL_VERIFIER_PATH", filepath.Join(t.TempDir(), "missing-worker"))
+	s.SetTxContext(tx.Hash(), 3, 4)
+	_, _, e := ApplyTransaction(context.Background(), evm, NewGasPool(h.GasLimit), s, h, tx)
+	if !errors.Is(e, ErrPQFullUnavailable) || s.IntermediateRoot(evm.GetRules()) != root {
+		t.Fatalf("local verifier unavailability not isolated: %v", e)
+	}
+	t.Log("actual ApplyTransaction refused unavailable pinned worker; no state/fee transition")
+}
