+	idx := &txIndexer{limit: 0, cutoff: cutoff, db: db}
+	done := make(chan struct{})
+	idx.run(params.PQBridgeAnchorNumber, make(chan struct{}), done)
+	<-done
+	if rawdb.ReadTxIndexTail(db) != nil {
+		t.Fatal("anchor-only indexer scanned historical gap")
+	}
+	done = make(chan struct{})
+	idx.run(params.PQBridgeAnchorNumber+2, make(chan struct{}), done)
+	<-done
+	tail := rawdb.ReadTxIndexTail(db)
+	if tail == nil || *tail != cutoff {
+		t.Fatalf("wrong local lookup tail %v", tail)
+	}
+	if rawdb.ReadTxLookupEntry(db, blocks[0].Transactions()[0].Hash()) != nil {
+		t.Fatal("historical H lookup implied missing receipt availability")
+	}
+	for _, b := range blocks[1:] {
+		if n := rawdb.ReadTxLookupEntry(db, b.Transactions()[0].Hash()); n == nil || *n != b.NumberU64() {
+			t.Fatal("local descendant lookup missing")
+		}
+	}
+	// Rewinding to H clears only the transaction lookup namespace; real blocks remain.
+	idx.repair(params.PQBridgeAnchorNumber)
+	if rawdb.ReadTxIndexTail(db) != nil {
+		t.Fatal("reorg to anchor left impossible lookup tail")
+	}
+	if rawdb.ReadBlock(db, blocks[1].Hash(), blocks[1].NumberU64()) == nil {
+		t.Fatal("index repair deleted local block")
+	}
+}
