+
+// R-1's bounds at pool admission (spec section 23.2, row size bounds): a proof
+// of 224,256 bytes is admissible, one more byte is refused before any check of
+// state or proof, and so is a transaction longer than L_max of a 0x7e.
+func TestPQPoolR1SizeBounds(t *testing.T) {
+	p, c, calls := componentPool(t)
+	f := c.cfg.PQMigrate.FullResearch
+	f.MaxProofBytes, f.MaxTxBytes = params.PQSuccinctMaxProofBytes, params.PQSuccinctMaxTxBytes
+	proof := func(n uint64) *types.Transaction {
+		return changed(componentTx(1, 1, 2, 20), func(m *types.PQMigrateTx) { m.ProofCarrier.Proof = make([]byte, n) })
+	}
+	if err := p.ValidateTxBasics(proof(f.MaxProofBytes)); err != nil {
+		t.Fatal("proof at R-1's bound refused", err)
+	}
+	var typed *core.PQMigrationError
+	if err := p.ValidateTxBasics(proof(f.MaxProofBytes + 1)); !errors.As(err, &typed) || typed.Name != "PROOF_TOO_LARGE" || typed.Code != 0x0008 {
+		t.Fatalf("proof over R-1's bound: %v", err)
+	}
+	long := changed(proof(f.MaxProofBytes), func(m *types.PQMigrateTx) {
+		m.SponsorOption = &types.PQMigrationSponsor{Sponsor: addr(20), ValidUntil: 10000, Signature: make([]byte, f.MaxTxBytes-f.MaxProofBytes)}
+		m.FeeMode = 2
+	})
+	if uint64(long.Size()) <= f.MaxTxBytes {
+		t.Fatal("fixture is not longer than L_max")
+	}
+	if err := p.ValidateTxBasics(long); err == nil || err.Error() != "PQ_RESEARCH_SIZE_LIMIT" {
+		t.Fatalf("transaction over L_max: %v", err)
+	}
+	if err := add(p, proof(f.MaxProofBytes+1)); err == nil || *calls != 0 {
+		t.Fatalf("over-bound proof admitted or verified: %v, calls=%d", err, *calls)
+	}
+}
