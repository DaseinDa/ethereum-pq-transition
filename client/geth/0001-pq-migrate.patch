new file mode 100644
index 0000000000000000000000000000000000000000..6826261123136b5a4715ca01cbffd4a805ce20f4
--- /dev/null
+++ b/core/vm/pq_marker.go
@@ -0,0 +1,141 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package vm
+
+import (
+	"bytes"
+	"encoding/binary"
+
+	"github.com/cloudflare/circl/sign/mldsa/mldsa44"
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core/tracing"
+	"github.com/ethereum/go-ethereum/crypto"
+)
+
+// R5, spec sections 5.5 and 24.4. Detection reads the addressed account's
+// stored code, before EIP-7702 resolution, and never reads the registry.
+// This research client enables only ML-DSA-44. Known disabled algorithms keep
+// their marker shape and price, but cannot yield an ERC-1271 success magic.
+func pqMarkerShape(alg byte) (pkLen, sigLen int, cost uint64) {
+	switch alg {
+	case 1:
+		return 1312, 2420, 50000
+	case 2:
+		return 1952, 3309, 70000
+	case 3:
+		return 32, 7856, 500000
+	case 4:
+		return 897, 666, 30000
+	default:
+		return 0, 0, 0
+	}
+}
+
+func (evm *EVM) pqMarkerCode(addr common.Address) []byte {
+	cfg := evm.chainConfig.PQMigrate
+	if cfg == nil || evm.Context.Time < cfg.T0 {
+		return nil
+	}
+	code := evm.StateDB.GetCode(addr)
+	if len(code) < 3 || code[0] != 0xef || code[1] != 1 {
+		return nil
+	}
+	n, _, _ := pqMarkerShape(code[2])
+	if n == 0 || len(code) != n+3 {
+		return nil
+	}
+	return code
+}
+
+// Read a 256-bit ABI word only if it fits both the input and the supplied
+// nonnegative bound. No narrowing, slice, offset addition or rounding precedes
+// this check; attacker-controlled large words cannot wrap an index.
+func pqABIWord(cd []byte, at, bound int) (int, bool) {
+	if at < 0 || bound < 0 || len(cd) < 32 || at > len(cd)-32 {
+		return 0, false
+	}
+	for _, b := range cd[at : at+24] {
+		if b != 0 {
+			return 0, false
+		}
+	}
+	v := binary.BigEndian.Uint64(cd[at+24 : at+32])
+	if v > uint64(bound) {
+		return 0, false
+	}
+	return int(v), true
+}
+
+func pqDecode1271(cd []byte, sigMax int, dynamic bool) (common.Hash, []byte, bool) {
+	var h common.Hash
+	if len(cd) < 100 {
+		return h, nil, false
+	}
+	if !dynamic {
+		o, ok := pqABIWord(cd, 36, 64)
+		if !ok || o != 64 {
+			return h, nil, false
+		}
+		l, ok := pqABIWord(cd, 68, min(sigMax, len(cd)-100))
+		if !ok {
+			return h, nil, false
+		}
+		copy(h[:], cd[4:36])
+		return h, cd[100 : 100+l], true
+	}
+	o1, ok := pqABIWord(cd, 4, 64)
+	if !ok || o1 != 64 {
+		return h, nil, false
+	}
+	ld, ok := pqABIWord(cd, 68, len(cd)-100)
+	if !ok {
+		return h, nil, false
+	}
+	// The second tail's length word must fit before adding any offsets.
+	rounded := (ld + 31) / 32 * 32
+	if len(cd) < 132 || rounded > len(cd)-132 {
+		return h, nil, false
+	}
+	o2, ok := pqABIWord(cd, 36, len(cd)-36)
+	if !ok || o2 != 96+rounded {
+		return h, nil, false
+	}
+	l, ok := pqABIWord(cd, 4+o2, min(sigMax, len(cd)-36-o2))
+	if !ok {
+		return h, nil, false
+	}
+	return crypto.Keccak256Hash(cd[100 : 100+ld]), cd[36+o2 : 36+o2+l], true
+}
+
+func (evm *EVM) runPQMarker(kind OpCode, code, input []byte, gas GasBudget) ([]byte, GasBudget, error) {
+	// Ordinary calls and all borrowed-context calls are empty-account calls.
+	if kind == CALLCODE || kind == DELEGATECALL || len(input) < 4 {
+		return nil, gas, nil
+	}
+	selector := input[:4]
+	dynamic := bytes.Equal(selector, []byte{0x20, 0xc1, 0x3b, 0x0b})
+	if !dynamic && !bytes.Equal(selector, []byte{0x16, 0x26, 0xba, 0x7e}) {
+		return nil, gas, nil
+	}
+	_, sigMax, price := pqMarkerShape(code[2])
+	cost := price + 3*((uint64(len(input))+31)/32)
+	prior, ok := gas.ChargeExecution(cost)
+	if !ok {
+		return nil, gas, ErrOutOfGas
+	}
+	if evm.Config.Tracer.HasGasHook() {
+		evm.Config.Tracer.EmitGasChange(prior.AsTracing(), gas.AsTracing(), tracing.GasChangeCallPrecompiledContract)
+	}
+	out := make([]byte, 32)
+	copy(out, []byte{0xff, 0xff, 0xff, 0xff})
+	hash, sig, wellFormed := pqDecode1271(input, sigMax, dynamic)
+	if wellFormed && code[2] == 1 && len(sig) == mldsa44.SignatureSize {
+		var key mldsa44.PublicKey
+		const tag = "ETH-PQ-ERC1271/v1"
+		if key.UnmarshalBinary(code[3:]) == nil && mldsa44.Verify(&key, append([]byte(tag), hash[:]...), []byte(tag), sig) {
+			copy(out, selector)
+		}
+	}
+	return out, gas, nil
+}
