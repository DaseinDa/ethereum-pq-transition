+//go:build pq_historical
+
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package pqpool
+
+import (
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core"
+	"github.com/ethereum/go-ethereum/core/txpool"
+	"github.com/ethereum/go-ethereum/core/txpool/legacypool"
+	"github.com/ethereum/go-ethereum/core/types"
+	"os"
+	"strings"
+	"testing"
+	"time"
+)
+
+// Actual fixed Full worker + ML-DSA fixtures + real upstream head subscription.
+// GenerateChain is a local block construction harness, not a live network.
+func TestPQPoolActualRecoveryActivationSpendRollback(t *testing.T) {
+	gen, bc, _, boot, mk := actualBase(t)
+	pcfg := DefaultConfig
+	pcfg.Datadir = t.TempDir()
+	p := New(pcfg, bc)
+	ordinary := legacypool.New(legacypool.DefaultConfig, bc)
+	manager, err := txpool.New(1, bc, []txpool.SubPool{p, ordinary})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer manager.Close()
+	recovery, activate, spend := actualRead(t, "migrate"), actualRead(t, "activate"), actualRead(t, "spend")
+	awaitNonce := func(want uint64) {
+		t.Helper()
+		deadline := time.Now().Add(20 * time.Second)
+		for time.Now().Before(deadline) {
+			if ordinary.Nonce(actualL) == want {
+				return
+			}
+			time.Sleep(10 * time.Millisecond)
+		}
+		t.Fatal("ordinary pool did not follow state nonce", want)
+	}
+	include := func(parent *types.Block, label string, tx *types.Transaction) *types.Block {
+		t.Helper()
+		if err := manager.Add([]*types.Transaction{tx}, true)[0]; err != nil {
+			t.Fatalf("%s admission: %v", label, err)
+		}
+		b, _ := mk(parent, label, tx)
+		actualImport(t, bc, b, true)
+		actualAwaitHead(t, p, b.Hash())
+		return b
+	}
+	a := include(boot, "full-recovery", recovery)
+	b := include(a, "pq-activation", activate)
+	c := include(b, "pq-spend", spend)
+	awaitNonce(2)
+	stateBefore, err := bc.StateAt(c.Header())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if rec := core.ReadPQRecord(stateBefore, gen.Config.PQMigrate.Registry, actualL); rec.Mode != 2 || rec.MigrationNonce != 1 || len(stateBefore.GetCode(actualL)) == 0 {
+		t.Fatal("activation/spend did not complete", rec)
+	}
+	side, _ := mk(boot, "all-three-reverted", nil)
+	actualImport(t, bc, side, true)
+	actualAwaitHead(t, p, side.Hash())
+	awaitNonce(0)
+	back, err := bc.StateAt(side.Header())
+	if err != nil {
+		t.Fatal(err)
+	}
+	bootState, err := bc.StateAt(boot.Header())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if rec := core.ReadPQRecord(back, gen.Config.PQMigrate.Registry, actualL); rec.Mode != 0 || rec.MigrationNonce != 0 || len(back.GetCode(actualL)) != 0 || back.GetNonce(actualL) != 0 {
+		t.Fatal("rollback owner state", rec)
+	}
+	for _, addr := range []common.Address{actualL, actualS, *spend.To()} {
+		if back.GetBalance(addr).Cmp(bootState.GetBalance(addr)) != 0 {
+			t.Fatal("rollback balance", addr)
+		}
+	}
+	actualPending(t, p, recovery, true)
+	if ordinary.Has(activate.Hash()) || ordinary.Has(spend.Hash()) {
+		t.Fatal("dependent PQ tx requeued before recovery state exists")
+	}
+	for _, tx := range []*types.Transaction{recovery, activate, spend} {
+		if lookup, _ := bc.GetCanonicalTransaction(tx.Hash()); lookup != nil {
+			t.Fatal("old receipt/transaction still canonical", tx.Hash())
+		}
+	}
+	// The pool must not pretend recovery is already executed for its dependents.
+	for _, tx := range []*types.Transaction{activate, spend} {
+		if err := manager.Add([]*types.Transaction{tx}, true)[0]; err == nil {
+			t.Fatal("future dependency admitted before confirmation", tx.Hash())
+		} else {
+			t.Logf("predecessor absent: hash=%s admission=%v", tx.Hash(), err)
+		}
+	}
+	replay, _ := mk(side, "recovered-again", recovery)
+	actualImport(t, bc, replay, true)
+	actualAwaitHead(t, p, replay.Hash())
+	b2 := include(replay, "activation-after-recovery", activate)
+	c2 := include(b2, "spend-after-activation", spend)
+	awaitNonce(2)
+	final, err := bc.StateAt(c2.Header())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(final.GetCode(actualL)) == 0 || final.GetNonce(actualL) != 2 {
+		t.Fatal("ordered replay incomplete")
+	}
+	t.Logf("real-backend/component: old=%s/%s/%s fork=%s replay=%s/%s/%s; Full recovery auto-Pending; activation/spend dropped on current LEGACY gate and resubmitted only after predecessor confirmation; owner/sponsor/recipient balance, Registry, code and ordinary nonce rolled back", a.Hash(), b.Hash(), c.Hash(), side.Hash(), replay.Hash(), b2.Hash(), c2.Hash())
+}
+
+// Same-target nonce-1 recommit: the proof relation binds the nonce and target,
+// not the Registry mode. The real override fixture is reused transparently in
+// the recovered-but-unactivated state; this is not evidence of target rotation.
+func TestPQPoolActualRecoveryRecommitDependencyRollback(t *testing.T) {
+	actualHistoricalProfile(t)
+	path := os.Getenv("PQ_TEST_RECOMMIT_RAW")
+	if path == "" {
+		t.Fatal("PQ_TEST_RECOMMIT_RAW required: new real nonce-1 same-target fixture")
+	}
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	recommit := new(types.Transaction)
+	if err = recommit.UnmarshalBinary(raw); err != nil {
+		t.Fatal(err)
+	}
+	rm, ok := recommit.AsPQMigrate()
+	if !ok || rm.MigrationNonce != 1 || rm.LegacyAddress != actualL {
+		t.Fatal("wrong nonce-1 fixture")
+	}
+	gen, bc, _, boot, mk := actualBase(t)
+	p, manager := actualManagedPool(t, bc)
+	recovery := actualRead(t, "migrate")
+	old0, _ := mk(boot, "nonce0-recovery", recovery)
+	actualImport(t, bc, old0, true)
+	actualAwaitHead(t, p, old0.Hash())
+	if err = manager.Add([]*types.Transaction{recommit}, true)[0]; err != nil {
+		t.Fatal("real recommit admission", err)
+	}
+	old1, _ := mk(old0, "nonce1-same-target-recommit", recommit)
+	actualImport(t, bc, old1, true)
+	actualAwaitHead(t, p, old1.Hash())
+	before, err := bc.StateAt(old1.Header())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if rec := core.ReadPQRecord(before, gen.Config.PQMigrate.Registry, actualL); rec.Mode != 2 || rec.MigrationNonce != 2 || len(before.GetCode(actualL)) != 0 {
+		t.Fatal("recommit did not execute", rec)
+	}
+	side, _ := mk(boot, "both-nonces-reverted", nil)
+	actualImport(t, bc, side, true)
+	actualAwaitHead(t, p, side.Hash())
+	actualPending(t, p, recovery, true)
+	actualPending(t, p, recommit, false)
+	lookup := NewAPI(p).Lookup(recommit.Hash())
+	if lookup["status"] != "rejected" || !strings.HasPrefix(lookup["reason"].(string), "WRONG_MIGRATION_NONCE") || lookup["retryable"] != false {
+		t.Fatal("future nonce hidden/retained", lookup)
+	}
+	if p.deferred[recommit.Hash()] != nil {
+		t.Fatal("future migration nonce was queued")
+	}
+	for _, tx := range []*types.Transaction{recovery, recommit} {
+		if l, _ := bc.GetCanonicalTransaction(tx.Hash()); l != nil {
+			t.Fatal("orphan tx still canonical", tx.Hash())
+		}
+	}
+	replay0, _ := mk(side, "nonce0-confirmed-again", recovery)
+	actualImport(t, bc, replay0, true)
+	actualAwaitHead(t, p, replay0.Hash())
+	if p.Has(recommit.Hash()) {
+		t.Fatal("discarded future nonce resurrected without wallet resubmit")
+	}
+	if err = manager.Add([]*types.Transaction{recommit}, true)[0]; err != nil {
+		t.Fatal("wallet resubmit after predecessor", err)
+	}
+	replay1, _ := mk(replay0, "nonce1-resubmitted", recommit)
+	actualImport(t, bc, replay1, true)
+	actualAwaitHead(t, p, replay1.Hash())
+	final, err := bc.StateAt(replay1.Header())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if rec := core.ReadPQRecord(final, gen.Config.PQMigrate.Registry, actualL); rec.MigrationNonce != 2 {
+		t.Fatal("ordered nonce replay", rec)
+	}
+	t.Logf("real-backend/component same-target recommit: old=%s/%s side=%s replay=%s/%s tx=%s; nonce0 auto-Pending, nonce1 definitively dropped at current nonce0, no future/deferred queue, wallet resubmitted after nonce0 confirmation", old0.Hash(), old1.Hash(), side.Hash(), replay0.Hash(), replay1.Hash(), recommit.Hash())
+}
