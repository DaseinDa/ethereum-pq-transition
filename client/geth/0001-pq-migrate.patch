+func TestPQBridgeBlockHashAvailabilityAndValidWindow(t *testing.T) {
+	c := &pqRuntimeHeaderChain{headers: map[common.Hash]*types.Header{}}
+	parent := common.Hash{}
+	for n := uint64(743); n < 1000; n++ {
+		h := &types.Header{Number: new(big.Int).SetUint64(n), ParentHash: parent}
+		c.headers[h.Hash()] = h
+		parent = h.Hash()
+	}
+	ref := &types.Header{Number: big.NewInt(1000), ParentHash: parent}
+	var gotErr error
+	fn := GetHashFnChecked(ref, c, func(err error) { gotErr = err })
+	for _, n := range []uint64{1000, 1001, 743, 0} {
+		if fn(n) != (common.Hash{}) || gotErr != nil {
+			t.Fatalf("legitimate zero %d reported unavailable", n)
+		}
+	}
+	if c.reads != 0 {
+		t.Fatal("zero-result out-of-window read consulted chain")
+	}
+	if fn(999) != ref.ParentHash || gotErr != nil {
+		t.Fatal("immediate parent hash unavailable")
+	}
+	expected := c.headers[parent]
+	for expected.Number.Uint64() > 745 {
+		expected = c.headers[expected.ParentHash]
+	}
+	if fn(744) != expected.ParentHash || gotErr != nil {
+		t.Fatal("oldest legal block hash failed")
+	}
+	missing := &pqRuntimeHeaderChain{headers: map[common.Hash]*types.Header{}}
+	db := rawdb.NewMemoryDatabase()
+	defer db.Close()
+	td := triedb.NewDatabase(db, triedb.HashDefaults)
+	defer td.Close()
+	st, err := state.New(types.EmptyRootHash, state.NewDatabase(td, state.NewCodeDB(db)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if GetHashFnChecked(ref, missing, st.SetExternalError)(998) != (common.Hash{}) {
+		t.Fatal("missing path supplied fabricated hash")
+	}
+	if !errors.Is(st.Error(), ErrPQStateUnavailable) {
+		t.Fatalf("missing in-window ancestor not sticky LocalUnavailable: %v", st.Error())
+	}
