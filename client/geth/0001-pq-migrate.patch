@@ -0,0 +1,60 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package core
+
+import (
+	"testing"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core/state"
+	"github.com/ethereum/go-ethereum/core/types"
+)
+
+// Conditional storage/gas component test: zero is injected as a computed-key
+// commitment fixture, NOT obtained from a key or hash preimage. No signature or
+// key check is bypassed in a transaction path, and no new zero commitment is
+// made admissible in a PI. The test compares actual StateDB slot transitions
+// with the production per-slot and first-write accounting functions.
+func TestPQComputedCommitmentFirstWriteSlots(t *testing.T) {
+	registry := common.HexToAddress("800")
+	owner := common.HexToAddress("900")
+	for _, tc := range []struct {
+		name       string
+		mode       uint8
+		enrolledAt uint64
+		commit     common.Hash
+		wantSlot1  uint64
+		wantTotal  uint64
+	}{
+		{"enrollment_nonzero", 1, 123, common.Hash{31: 1}, 22100, 44200},
+		{"enrollment_conditional_zero", 1, 123, common.Hash{}, 2200, 24300},
+		{"native_nonzero", 3, 0, common.Hash{31: 1}, 22100, 44200},
+		{"native_conditional_zero", 3, 0, common.Hash{}, 2200, 24300},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			s, err := state.New(types.EmptyRootHash, state.NewDatabaseForTesting())
+			if err != nil {
+				t.Fatal(err)
+			}
+			slot0, slot1 := PQRecordSlots(owner)
+			before0, before1 := s.GetState(registry, slot0), s.GetState(registry, slot1)
+			record := PQRecord{Mode: tc.mode, AlgID: 1, EnrolledAt: tc.enrolledAt, MigrationNonce: 1, Commit: tc.commit}
+			snapshot := s.Snapshot()
+			writePQRecord(s, registry, owner, record)
+			after0, after1 := s.GetState(registry, slot0), s.GetState(registry, slot1)
+			if before0 != (common.Hash{}) || before1 != (common.Hash{}) || after0 != pqRecordWord(record) || after1 != tc.commit || ReadPQRecord(s, registry, owner) != record {
+				t.Fatal("unexpected actual registry storage transition")
+			}
+			gas0, gas1 := pqColdWriteGas(before0, after0), pqColdWriteGas(before1, after1)
+			if gas0 != 22100 || gas1 != tc.wantSlot1 || gas0+gas1 != tc.wantTotal || pqFirstRegistryWriteGas(tc.commit) != tc.wantTotal {
+				t.Fatalf("per-slot gas %d+%d, helper=%d want=%d", gas0, gas1, pqFirstRegistryWriteGas(tc.commit), tc.wantTotal)
+			}
+			s.RevertToSnapshot(snapshot)
+			if ReadPQRecord(s, registry, owner) != (PQRecord{}) {
+				t.Fatal("fixture rollback failed")
+			}
+			t.Logf("conditional StateDB fixture: slot0=%d slot1=%d total=%d; not an observed zero-hash public key", gas0, gas1, tc.wantTotal)
+		})
+	}
+}
