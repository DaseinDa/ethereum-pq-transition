+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package core
+
+import (
+	"errors"
+	"fmt"
+)
+
+// ErrPQStateUnavailable is a local execution-data failure, never proof invalidity.
+// It must not enter the Engine invalid-block cache or a peer's invalid budget.
+var ErrPQStateUnavailable = errors.New("PQ_STATE_UNAVAILABLE")
+
+func WrapPQStateUnavailable(err error) error {
+	if err == nil || errors.Is(err, ErrPQStateUnavailable) {
+		return err
+	}
+	return fmt.Errorf("%w: %w", ErrPQStateUnavailable, err)
+}
diff --git a/core/pq_state_durable.go b/core/pq_state_durable.go
new file mode 100644
index 0000000000000000000000000000000000000000..dde3e6dffdda63d6b3f69c38869bda0d5414c799
--- /dev/null
+++ b/core/pq_state_durable.go
@@ -0,0 +1,108 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package core
+
+import (
+	"encoding/json"
+	"fmt"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core/rawdb"
+	"github.com/ethereum/go-ethereum/core/state"
+	"github.com/ethereum/go-ethereum/core/types"
+)
+
+// This is local research persistence metadata, not a consensus or PI field.
+type pqExecutedStateRecord struct {
+	BlockHash, ParentHash, StateRoot, ReceiptRoot, ProfileSHA256 common.Hash
+	BlockNumber                                                  uint64
+}
+
+func pqExecutedStateKey(hash common.Hash) []byte {
+	return append([]byte("pq-bridge-executed-v1:"), hash[:]...)
+}
+
+// PQBridgeStateReady guards every known-block shortcut and forkchoice boundary.
+// Only the exact imported checkpoint is trusted without local execution.
+func (bc *BlockChain) PQBridgeStateReady(block *types.Block) bool {
+	if bc.chainConfig.PQStateBridge == nil {
+		return true
+	}
+	if block == nil || !bc.HasState(block.Root()) {
+		return false
+	}
+	if CheckTrustedCheckpointConfig(bc.db, bc.chainConfig) != nil {
+		return false
+	}
+	c := bc.chainConfig.PQStateBridge
+	if block.NumberU64() == c.AnchorNumber {
+		return block.Hash() == c.AnchorHash && block.Root() == c.AnchorRoot &&
+			IsTrustedCheckpoint(bc.db, block.Hash(), block.NumberU64(), block.Root(), c.ProfileSHA256)
+	}
+	if block.NumberU64() < c.AnchorNumber {
+		return false
+	}
+	raw, err := bc.db.Get(pqExecutedStateKey(block.Hash()))
+	if err != nil {
+		return false
+	}
+	var record pqExecutedStateRecord
+	if json.Unmarshal(raw, &record) != nil {
+		return false
+	}
+	return record.BlockHash == block.Hash() && record.ParentHash == block.ParentHash() &&
+		record.BlockNumber == block.NumberU64() && record.StateRoot == block.Root() &&
+		record.ReceiptRoot == block.ReceiptHash() && record.ProfileSHA256 == c.ProfileSHA256
+}
+
+// writePQBridgeBlockWithState deliberately orders durable state before block and
+// validated metadata. A crash may leave unreachable state nodes, never a block
+// that the known-block shortcut treats as executed without its state.
+func (bc *BlockChain) writePQBridgeBlockWithState(block *types.Block, receipts []*types.Receipt, s *state.StateDB) error {
+	if err := s.Error(); err != nil {
+		return WrapPQStateUnavailable(err)
+	}
+	if bc.triedb.Scheme() != rawdb.HashScheme {
+		return fmt.Errorf("PQ bridge requires hash state scheme")
+	}
+	preimages := s.Preimages()
+	rules := bc.chainConfig.Rules(block.Number(), block.Difficulty().Sign() == 0, block.Time())
+	root, update, err := s.CommitWithUpdate(rules, block.NumberU64())
+	if err != nil {
+		return WrapPQStateUnavailable(err)
+	}
+	if root != block.Root() {
+		return fmt.Errorf("PQ bridge committed root mismatch: %s != %s", root, block.Root())
+	}
+	if err := bc.triedb.Commit(root, false); err != nil {
+		return WrapPQStateUnavailable(err)
+	}
+	if err := bc.db.SyncKeyValue(); err != nil {
+		return WrapPQStateUnavailable(err)
+	}
+	if bc.logger != nil && bc.logger.OnStateUpdate != nil {
+		traceUpdate, err := update.ToTracingUpdate()
+		if err != nil {
+			return err
+		}
+		bc.logger.OnStateUpdate(traceUpdate)
+	}
+	record := pqExecutedStateRecord{block.Hash(), block.ParentHash(), root, block.ReceiptHash(), bc.chainConfig.PQStateBridge.ProfileSHA256, block.NumberU64()}
+	raw, err := json.Marshal(record)
+	if err != nil {
+		return err
+	}
+	batch := bc.db.NewBatch()
+	defer batch.Close()
+	rawdb.WriteBlock(batch, block)
+	rawdb.WriteReceipts(batch, block.Hash(), block.NumberU64(), receipts)
+	rawdb.WritePreimages(batch, preimages)
+	if err := batch.Put(pqExecutedStateKey(block.Hash()), raw); err != nil {
+		return WrapPQStateUnavailable(err)
+	}
+	if err := batch.Write(); err != nil {
+		return WrapPQStateUnavailable(err)
+	}
+	return WrapPQStateUnavailable(bc.db.SyncKeyValue())
+}
