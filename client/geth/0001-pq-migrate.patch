+func TestPQPoolProofCachePositiveHeadAndOuterFee(t *testing.T) {
+	p, _, calls := componentPool(t)
+	tx := componentTx(1, 20, 2, 20)
+	p.cfg.VerificationBurst = 1
+	if err := add(p, tx); err != nil {
+		t.Fatal(err)
+	}
+	for i := 0; i < 5; i++ {
+		h := types.CopyHeader(p.head)
+		h.Time += 12
+		p.Reset(p.head, h)
+		if !p.Has(tx.Hash()) {
+			t.Fatal("head reset exhausted verifier budget for cached proof")
+		}
+	}
+	replacement := changed(tx, func(m *types.PQMigrateTx) { m.GasTipCap.SetInt64(4); m.GasFeeCap.SetInt64(40) })
+	if err := add(p, replacement); err != nil {
+		t.Fatal(err)
+	}
+	if *calls != 1 || p.verifyCount != 1 || p.proofCacheHits != 6 {
+		t.Fatalf("calls=%d budget=%d hits=%d", *calls, p.verifyCount, p.proofCacheHits)
+	}
+	t.Logf("component verifier: admission + 5 heads + outer fee replacement -> Full calls=%d, cache hits=%d", *calls, p.proofCacheHits)
+}
