+++ b/core/txpool/pqpool/reorg.go
@@ -0,0 +1,192 @@
+// Copyright 2026 The go-ethereum Authors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package pqpool
+
+import (
+	"errors"
+	"fmt"
+	"sort"
+	"time"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core"
+	"github.com/ethereum/go-ethereum/core/txpool"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/log"
+)
+
+// orphaned obtains the complete old/new branch difference or no candidates at
+// all. Limits are local availability policy, never a statement of block validity.
+// No ordinary sender recovery or account-nonce ordering is involved.
+func (p *Pool) orphaned(old, head *types.Header) ([]*types.Transaction, error) {
+	if old == nil || old.Hash() == head.Hash() || old.Hash() == head.ParentHash {
+		return nil, nil
+	}
+	oldNumber, newNumber := old.Number.Uint64(), head.Number.Uint64()
+	if oldNumber > newNumber && oldNumber-newNumber > p.cfg.MaxReorgDepth || newNumber > oldNumber && newNumber-oldNumber > p.cfg.MaxReorgDepth {
+		return nil, errors.New("reorg depth exceeds local limit")
+	}
+	get := func(hash common.Hash, number uint64) (*types.Block, error) {
+		b := p.chain.GetBlock(hash, number)
+		if b == nil || b.Hash() != hash || b.NumberU64() != number {
+			return nil, fmt.Errorf("missing reorg block %s at %d", hash, number)
+		}
+		return b, nil
+	}
+	rem, err := get(old.Hash(), oldNumber)
+	if err != nil {
+		return nil, err
+	}
+	add, err := get(head.Hash(), newNumber)
+	if err != nil {
+		return nil, err
+	}
+	var discarded [][]*types.Transaction
+	included := make(map[common.Hash]struct{})
+	var oldDepth, newDepth, rawBytes uint64
+	var scanned, pqCount int
+	consume := func(b *types.Block, removing bool) error {
+		if len(b.Transactions()) > p.cfg.MaxReorgScan-scanned {
+			return errors.New("reorg transaction scan exceeds local limit")
+		}
+		scanned += len(b.Transactions())
+		var lost []*types.Transaction
+		for _, tx := range b.Transactions() {
+			if tx.Type() != types.PQMigrateTxType && tx.Type() != types.PQBatchTxType {
+				continue
+			}
+			m, ok := tx.AsPQMigrate()
+			if tx.Type() != types.PQBatchTxType && (!ok || m.ProofCarrier.Route != 0 || m.LaneAuthOption != nil) {
+				continue
+			}
+			if pqCount >= p.cfg.MaxReorgCandidates || tx.Size() > p.cfg.MaxReorgBytes-rawBytes {
+				return errors.New("reorg PQ count/raw bytes exceed local limit")
+			}
+			pqCount++
+			rawBytes += tx.Size()
+			if removing {
+				lost = append(lost, tx)
+			} else {
+				included[tx.Hash()] = struct{}{}
+			}
+		}
+		if removing {
+			discarded = append(discarded, lost)
+		}
+		return nil
+	}
+	for rem.Hash() != add.Hash() {
+		if rem.NumberU64() >= add.NumberU64() {
+			if oldDepth >= p.cfg.MaxReorgDepth || rem.NumberU64() == 0 {
+				return nil, errors.New("old branch has no common ancestor within local limit")
+			}
+			oldDepth++
+			if err = consume(rem, true); err != nil {
+				return nil, err
+			}
+			rem, err = get(rem.ParentHash(), rem.NumberU64()-1)
+		} else {
+			if newDepth >= p.cfg.MaxReorgDepth || add.NumberU64() == 0 {
+				return nil, errors.New("new branch has no common ancestor within local limit")
+			}
+			newDepth++
+			if err = consume(add, false); err != nil {
+				return nil, err
+			}
+			add, err = get(add.ParentHash(), add.NumberU64()-1)
+		}
+		if err != nil {
+			return nil, err
+		}
+	}
+	lost := make([]*types.Transaction, 0, pqCount)
+	seen := make(map[common.Hash]struct{})
+	for i := len(discarded) - 1; i >= 0; i-- {
+		for _, tx := range discarded[i] {
+			if _, ok := included[tx.Hash()]; ok {
+				continue
+			}
+			if _, ok := seen[tx.Hash()]; ok {
+				continue
+			}
+			seen[tx.Hash()] = struct{}{}
+			lost = append(lost, tx)
+		}
+	}
+	log.Info("PQPOOL_REORG_SCAN", "old", old.Hash(), "new", head.Hash(), "ancestor", rem.Hash(), "oldDepth", oldDepth, "newDepth", newDepth, "scanned", scanned, "pqCount", pqCount, "rawBytes", rawBytes, "orphans", len(lost))
+	return lost, nil
+}
+
+func retryable(err error) bool {
+	return errors.Is(err, core.ErrPQFullUnavailable) || errors.Is(err, ErrLocalUnavailable) || errors.Is(err, txpool.ErrPQBusy)
+}
+
+func (p *Pool) forgetDeferred(hash common.Hash) {
+	if d := p.deferred[hash]; d != nil {
+		p.deferredBytes -= d.tx.Size()
+		delete(p.deferred, hash)
+	}
+}
+
+func (p *Pool) deferTx(tx *types.Transaction, source string, reason error) {
+	if tx.Type() == types.PQBatchTxType {
+		p.deferBatch(tx)
+		return
+	}
+	if d := p.deferred[tx.Hash()]; d != nil {
+		d.reason = diagnosticReason(reason.Error())
+		return
+	}
+	if p.entries[tx.Hash()] != nil {
+		return
+	}
+	size := tx.Size()
+	if len(p.deferred) >= p.cfg.MaxReorgCandidates || len(p.entries)+len(p.batches)+len(p.deferred) >= p.cfg.MaxPending ||
+		size > p.cfg.MaxReorgBytes || p.deferredBytes > p.cfg.MaxReorgBytes-size ||
+		size > p.cfg.DataCap || p.bodyBytes+p.batchBytes+p.deferredBytes > p.cfg.DataCap-size {
+		p.rememberDecision(tx.Hash(), "deferred capacity limit; resubmit later", true)
+		log.Warn("PQPOOL_REORG_DEFER_LIMIT", "txhash", tx.Hash(), "err", reason, "rawBytes", size)
+		return
+	}
+	m, ok := tx.AsPQMigrate()
+	if !ok {
+		return
+	}
+	p.deferredOrder++
+	p.deferred[tx.Hash()] = &deferredEntry{tx: types.NewTx(m), source: source, order: p.deferredOrder, reason: diagnosticReason(reason.Error())}
+	p.deferredBytes += size
+	delete(p.diagnostics, tx.Hash())
+	log.Warn("PQPOOL_REORG_DEFER", "txhash", tx.Hash(), "err", reason, "deferred", len(p.deferred), "deferredBytes", p.deferredBytes)
+}
+
+// Singles and batches share one deferral order, regardless of their storage.
+// A snapshot keeps items deferred during this reset for a later retry.
+func (p *Pool) deferredRetries() []*deferredEntry {
+	queued := make([]*deferredEntry, 0, len(p.deferred)+len(p.batches))
+	for _, d := range p.deferred {
+		queued = append(queued, d)
+	}
+	for _, e := range p.batches {
+		if !e.admitted {
+			queued = append(queued, &deferredEntry{tx: e.tx, source: "held-batch", order: e.deferredOrder})
+		}
+	}
+	sort.Slice(queued, func(i, j int) bool { return queued[i].order < queued[j].order })
+	return queued
+}
+
+func (p *Pool) verificationBudget() error {
+	// time.Now/Sub retain Go's process-local monotonic clock. Neither chain
+	// timestamps nor NTP wall-clock adjustments refill this local work budget.
+	now := time.Now()
+	if now.Sub(p.verifyStart) >= p.cfg.VerificationWindow {
+		p.verifyStart = now
+		p.verifyCount = 0
+	}
+	if p.verifyCount >= p.cfg.VerificationBurst {
+		return txpool.ErrPQBusy
+	}
+	p.verifyCount++
+	return nil
+}
