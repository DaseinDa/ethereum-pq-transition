@@ -0,0 +1,356 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package ethapi
+
+import (
+	"context"
+	"encoding/binary"
+	"encoding/json"
+	"errors"
+	"math"
+	"math/big"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/cloudflare/circl/sign/mldsa/mldsa44"
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core"
+	"github.com/ethereum/go-ethereum/core/state"
+	"github.com/ethereum/go-ethereum/core/tracing"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/params"
+	"github.com/ethereum/go-ethereum/rpc"
+)
+
+// These are real geth API/JSON-RPC and StateDB component tests. The backend
+// resolves synthetic snapshots; it is not an independent execution client or
+// a network/reorganization acceptance test.
+type pqAccountContractBackend struct {
+	Backend
+	config       *params.ChainConfig
+	latest       *state.StateDB
+	old          *state.StateDB
+	pending      *state.StateDB
+	head         *types.Header
+	oldHead      *types.Header
+	pendingHead  *types.Header
+	refs         []rpc.BlockNumberOrHash
+	pendingError error
+	resolveError error
+	nilState     bool
+	nilHeader    bool
+	configReads  int
+}
+
+func (b *pqAccountContractBackend) ChainConfig() *params.ChainConfig {
+	b.configReads++
+	return b.config
+}
+
+func (b *pqAccountContractBackend) StateAndHeaderByNumberOrHash(_ context.Context, ref rpc.BlockNumberOrHash) (*state.StateDB, *types.Header, error) {
+	b.refs = append(b.refs, ref)
+	if b.resolveError != nil {
+		return nil, nil, b.resolveError
+	}
+	if b.nilState {
+		return nil, b.head, nil
+	}
+	if b.nilHeader {
+		return b.latest, nil, nil
+	}
+	if number, ok := ref.Number(); ok {
+		switch number {
+		case rpc.LatestBlockNumber:
+			return b.latest, b.head, nil
+		case rpc.PendingBlockNumber:
+			return b.pending, b.pendingHead, b.pendingError
+		case rpc.BlockNumber(b.oldHead.Number.Uint64()):
+			return b.old, b.oldHead, nil
+		default:
+			return nil, nil, errors.New("header not found")
+		}
+	}
+	if hash, ok := ref.Hash(); ok {
+		if hash == b.oldHead.Hash() {
+			return b.old, b.oldHead, nil
+		}
+		if hash == b.head.Hash() {
+			return b.latest, b.head, nil
+		}
+		if ref.RequireCanonical {
+			return nil, nil, errors.New("hash is not currently canonical")
+		}
+		return b.old, b.oldHead, nil
+	}
+	return nil, nil, errors.New("invalid block reference")
+}
+
+var pqAccountAddress = common.HexToAddress("0x1234")
+
+func pqAccountState(t *testing.T) *state.StateDB {
+	t.Helper()
+	s, err := state.New(types.EmptyRootHash, state.NewDatabaseForTesting())
+	if err != nil {
+		t.Fatal(err)
+	}
+	return s
+}
+
+func pqAccountBackend(t *testing.T) *pqAccountContractBackend {
+	t.Helper()
+	return &pqAccountContractBackend{
+		config: &params.ChainConfig{ChainID: big.NewInt(13376), PQMigrate: &params.PQMigrateConfig{
+			T0: 40, T: 100, W: 50, PoolSlotSeconds: 12, Registry: common.HexToAddress("0x800"),
+		}},
+		latest: pqAccountState(t), old: pqAccountState(t), pending: pqAccountState(t),
+		head: &types.Header{Number: big.NewInt(10), Time: 94}, oldHead: &types.Header{Number: big.NewInt(9), Time: 82},
+		pendingHead: &types.Header{Number: big.NewInt(11), Time: 106},
+	}
+}
+
+func pqAccountWrite(s *state.StateDB, registry common.Address, mode uint8, nonce uint64, commit common.Hash) {
+	k0, k1 := core.PQRecordSlots(pqAccountAddress)
+	var word common.Hash
+	word[31], word[30] = mode, 1
+	binary.BigEndian.PutUint64(word[22:30], 45)
+	binary.BigEndian.PutUint64(word[14:22], nonce)
+	s.SetState(registry, k0, word)
+	s.SetState(registry, k1, commit)
+}
+
+func pqAccountRPC(t *testing.T, b *pqAccountContractBackend) *rpc.Client {
+	t.Helper()
+	server := rpc.NewServer()
+	if err := server.RegisterName("eth", NewBlockChainAPI(b)); err != nil {
+		t.Fatal(err)
+	}
+	client := rpc.DialInProc(server)
+	t.Cleanup(func() { client.Close(); server.Stop() })
+	return client
+}
+
+func pqAccountQuery(t *testing.T, client *rpc.Client, block ...interface{}) map[string]interface{} {
+	t.Helper()
+	args := append([]interface{}{pqAccountAddress}, block...)
+	var out map[string]interface{}
+	if err := client.CallContext(context.Background(), &out, "eth_getPQAccount", args...); err != nil {
+		t.Fatal(err)
+	}
+	return out
+}
+
+func pqAccountExpected(mode, alg, at, nonce string, deadline interface{}, commit common.Hash, activated, dead bool) map[string]interface{} {
+	return map[string]interface{}{"mode": mode, "algId": alg, "enrolledAt": at, "overrideDeadline": deadline,
+		"migrationNonce": nonce, "pqPkCommit": commit.Hex(), "activated": activated, "ecdsaDead": dead}
+}
+
+func pqAccountEqual(t *testing.T, got, want map[string]interface{}) {
+	t.Helper()
+	if !reflect.DeepEqual(got, want) {
+		g, _ := json.Marshal(got)
+		w, _ := json.Marshal(want)
+		t.Fatalf("JSON result mismatch\n got %s\nwant %s", g, w)
+	}
+}
+
+func TestPQAccountRPCExactSchemaAndDefaults(t *testing.T) {
+	for _, block := range []string{"omitted", "latest", "0xa"} {
+		t.Run(block, func(t *testing.T) {
+			b := pqAccountBackend(t)
+			// The explicit block test uses the old snapshot with the same values.
+			if block == "0xa" {
+				b.oldHead.Number.SetInt64(10)
+			}
+			client := pqAccountRPC(t, b)
+			var got map[string]interface{}
+			if block == "omitted" {
+				got = pqAccountQuery(t, client)
+			} else {
+				got = pqAccountQuery(t, client, block)
+			}
+			pqAccountEqual(t, got, pqAccountExpected("0x0", "0x0", "0x0", "0x0", nil, common.Hash{}, false, false))
+			if len(b.refs) != 1 {
+				t.Fatalf("resolved %d snapshots", len(b.refs))
+			}
+		})
+	}
+}
+
+func TestPQAccountRPCHistoricalAndActivation(t *testing.T) {
+	b := pqAccountBackend(t)
+	registry := b.config.PQMigrate.Registry
+	oldCommit := common.HexToHash("0xab")
+	pqAccountWrite(b.old, registry, 1, 2, oldCommit)
+	pk := make([]byte, mldsa44.PublicKeySize)
+	pk[0], pk[len(pk)-1] = 1, 2
+	commit := core.PQKeyCommit(1, pk)
+	pqAccountWrite(b.latest, registry, 2, 3, commit)
+	b.latest.SetCode(pqAccountAddress, append([]byte{0xef, 1, 1}, pk...), tracing.CodeChangeUnspecified)
+	before := b.latest.Copy().IntermediateRoot(params.Rules{})
+	client := pqAccountRPC(t, b)
+	pqAccountEqual(t, pqAccountQuery(t, client, "0x9"), pqAccountExpected("0x1", "0x1", "0x2d", "0x2", "0x96", oldCommit, false, true))
+	pqAccountEqual(t, pqAccountQuery(t, client, "latest"), pqAccountExpected("0x2", "0x1", "0x2d", "0x3", nil, commit, true, true))
+	if b.latest.Copy().IntermediateRoot(params.Rules{}) != before {
+		t.Fatal("query changed the account state")
+	}
+	// Invalid activated-code binding does not produce a false positive.
+	b.latest.SetCode(pqAccountAddress, []byte{0xef, 1, 1}, tracing.CodeChangeUnspecified)
+	if pqAccountQuery(t, client, "latest")["activated"] != false {
+		t.Fatal("invalid key code was reported activated")
+	}
+}
