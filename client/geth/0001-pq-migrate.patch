@@ -0,0 +1,31 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package pqpool
+
+import (
+	"github.com/ethereum/go-ethereum/core/txpool"
+	"github.com/ethereum/go-ethereum/core/types"
+)
+
+// Sections 28.4 and 28.6: every held retry and orphan is dropped inside the
+// extra reset margin before policy/signatures/proofs can displace another item.
+// A margin drop is never a sponsor ban or a source penalty.
+func (p *Pool) resetCandidateExpired(tx *types.Transaction, h *types.Header) bool {
+	slot := txpool.PQPoolSlot(p.chain.Config())
+	if h.Time > ^uint64(0)-slot {
+		return true
+	}
+	margin := h.Time + slot
+	if m, ok := tx.AsPQMigrate(); ok {
+		return m.Expiry < margin || m.Sponsor() != nil && m.Sponsor().ValidUntil < margin
+	}
+	if b, ok := tx.AsPQBatch(); ok {
+		var expiry uint64
+		for _, entry := range b.Entries {
+			expiry = max(expiry, entry.Expiry)
+		}
+		return min(expiry, b.SponsorValidUntil) < margin
+	}
+	return false
+}
