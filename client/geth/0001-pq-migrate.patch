+func TestPQPoolStandardGasCap(t *testing.T) {
+	p, c, calls := componentPool(t)
+	// Ignore a malicious/stale 64M research override in every admission path.
+	c.cfg.PQMigrate.FullResearch.TxGasCap = 64000000
+	base := componentTx(1, 20, 2, 20)
+	at := changed(base, func(m *types.PQMigrateTx) { m.Gas = params.MaxTxGas })
+	if err := p.ValidateTxBasics(at); err != nil {
+		t.Fatal(err)
+	}
+	over := changed(base, func(m *types.PQMigrateTx) { m.Gas = params.MaxTxGas + 1 })
+	if err := p.ValidateTxBasics(over); err == nil {
+		t.Fatal("cheap validation accepted oversized gas")
+	}
+	if err := add(p, over); err == nil {
+		t.Fatal("pool accepted oversized gas")
+	}
+	if *calls != 0 {
+		t.Fatal("oversized gas consumed proof verification")
+	}
+	if err := add(p, at); err != nil {
+		t.Fatal(err)
+	}
+	_, n := p.Pending(txpool.PendingFilter{OnlyPQ: true, GasLimitCap: params.MaxTxGas})
+	if n != 1 {
+		t.Fatal("cap-boundary transaction omitted")
+	}
+	_, n = p.Pending(txpool.PendingFilter{OnlyPQ: true, GasLimitCap: params.MaxTxGas - 1})
+	if n != 0 {
+		t.Fatal("pending ignored miner cap")
+	}
+}
