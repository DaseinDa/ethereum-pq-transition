+func addr(n byte) common.Address                                        { return common.BytesToAddress([]byte{n}) }
+func componentPool(t *testing.T) (*Pool, *componentChain, *int) {
+	t.Helper()
+	cfg := *params.AllDevChainProtocolChanges
+	cfg.ChainID = big.NewInt(13375)
+	cfg.PQMigrate = &params.PQMigrateConfig{Registry: addr(8), T: 500, W: 31536000, FullResearch: &params.PQFullResearchConfig{Version: 0x80000002, Activation: 0, Sunset: 10000000, ProofLifetime: 604800, MaxProofBytes: 2 << 20, MaxTxBytes: 3 << 20, TxGasCap: params.MaxTxGas}}
+	s, err := state.New(types.EmptyRootHash, state.NewDatabaseForTesting())
+	if err != nil {
+		t.Fatal(err)
+	}
+	chain := &componentChain{cfg: &cfg, s: s}
+	for n := byte(20); n < 80; n++ {
+		a := addr(n)
+		code := make([]byte, 1315)
+		copy(code, []byte{0xef, 1, 1})
+		code[3] = n
+		s.SetCode(a, code, tracing.CodeChangeUnspecified)
+		s.SetBalance(a, uint256.NewInt(1000000000000000000), tracing.BalanceChangeUnspecified)
+		k, k1 := core.PQRecordSlots(a)
+		word := common.Hash{}
+		word[31] = 1
+		word[30] = 1
+		s.SetState(cfg.PQMigrate.Registry, k, word)
+		s.SetState(cfg.PQMigrate.Registry, k1, core.PQKeyCommit(1, code[3:]))
+	}
+	policy := DefaultConfig
+	policy.Datadir = t.TempDir()
+	policy.VerificationBurst = 10000
+	p := New(policy, chain)
+	if err = p.Init(1, &types.Header{Number: big.NewInt(0), Time: 1000, GasLimit: 120000000, GasUsed: 60000000, BaseFee: big.NewInt(1)}, nil); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { p.Close() })
+	count := new(int)
+	p.checkProof = func(*types.Transaction, *params.ChainConfig, string) error { *count++; return nil }
+	p.checkState = func(tx *types.Transaction, s *state.StateDB, h *types.Header, c *params.ChainConfig) error {
+		m, _ := tx.AsPQMigrate()
+		if m.Expiry < h.Time {
+			return &core.PQMigrationError{Name: "PROOF_EXPIRED", Code: 0x0201}
+		}
+		if core.ReadPQRecord(s, c.PQMigrate.Registry, m.LegacyAddress).MigrationNonce != m.MigrationNonce {
+			return &core.PQMigrationError{Name: "WRONG_MIGRATION_NONCE", Code: 0x0105}
+		}
+		if sponsor := m.Sponsor(); sponsor != nil && s.GetBalance(sponsor.Sponsor).CmpBig(liability(m)) < 0 {
+			return &core.PQMigrationError{Name: "INSUFFICIENT_FEE_BALANCE", Code: 0x0204}
+		}
+		return nil
+	}
+	return p, chain, count
+}
+func componentTx(legacy, payer byte, tip, fee int64) *types.Transaction {
+	m := &types.PQMigrateTx{ChainID: big.NewInt(13375), LegacyAddress: addr(legacy), AlgID: 1, PQPKCommit: common.HexToHash("01"), Expiry: 10000, MaxAccountFee: new(big.Int), FeeMode: 2, GasTipCap: big.NewInt(tip), GasFeeCap: big.NewInt(fee), Gas: 100, VerifierVersion: 0x80000002, ProofCarrier: types.PQMigrationCarrier{Proof: []byte("synthetic component proof")}}
+	if payer == legacy {
+		m.FeeMode = 0
+		m.MaxAccountFee = big.NewInt(100000)
+	} else {
+		m.SponsorOption = &types.PQMigrationSponsor{Sponsor: addr(payer), ValidUntil: 10000, Signature: []byte("synthetic signature")}
+	}
+	return types.NewTx(m)
+}
+func changed(tx *types.Transaction, f func(*types.PQMigrateTx)) *types.Transaction {
+	own := types.NewTx(func() *types.PQMigrateTx { m, _ := tx.AsPQMigrate(); return m }())
+	m, _ := own.AsPQMigrate()
+	f(m)
+	return types.NewTx(m)
+}
+func add(p *Pool, tx *types.Transaction) error {
+	return p.AddFrom("rpc:component", []*types.Transaction{tx}, true)[0]
+}
