@@ -0,0 +1,31 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package txpool
+
+import (
+	"math"
+
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/params"
+)
+
+// PQPoolSlot is the single slot configuration used by every research subpool.
+// A zero value preserves existing mainnet-slot research genesis files. This is
+// admission policy only; block execution always uses the actual header time.
+func PQPoolSlot(config *params.ChainConfig) uint64 {
+	if config != nil && config.PQMigrate != nil && config.PQMigrate.PoolSlotSeconds != 0 {
+		return config.PQMigrate.PoolSlotSeconds
+	}
+	return 12
+}
+
+// PQPoolTime uses the common TxPool head-event stream, never local wall time.
+// Saturation fails closed at the end of the timestamp range instead of wrapping.
+func PQPoolTime(head *types.Header, config *params.ChainConfig) uint64 {
+	slot := PQPoolSlot(config)
+	if head.Time > math.MaxUint64-slot {
+		return math.MaxUint64
+	}
+	return head.Time + slot
+}
diff --git a/core/txpool/pq_cross_t_test.go b/core/txpool/pq_cross_t_test.go
