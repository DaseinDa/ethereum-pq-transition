+}
+func actualBase(t *testing.T) (*core.Genesis, *core.BlockChain, ethdb.Database, *types.Block, func(*types.Block, string, *types.Transaction, ...int64) (*types.Block, types.Receipts)) {
+	t.Helper()
+	gen := actualGenesis(t)
+	engine := beacon.New(ethash.NewFaker())
+	genDB, boot, _ := core.GenerateChainWithGenesis(gen, engine, 1, func(_ int, b *core.BlockGen) {
+		b.OffsetTime(2)
+		b.SetPoS()
+		b.AddTx(actualRead(t, "sponsor-create"))
+		b.AddTx(actualRead(t, "other-sponsor-create"))
+	})
+	t.Cleanup(func() { genDB.Close() })
+	db, err := rawdb.Open(rawdb.NewMemoryDatabase(), rawdb.OpenOptions{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	bc, err := core.NewBlockChain(db, gen, engine, core.DefaultConfig().WithStateScheme(rawdb.HashScheme))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { bc.Stop(); db.Close() })
+	actualImport(t, bc, boot[0], true)
+	s, err := bc.StateAt(boot[0].Header())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if core.ReadPQRecord(s, gen.Config.PQMigrate.Registry, actualL).Mode != 0 || len(s.GetCode(actualL)) != 0 {
+		t.Fatal("owner not naturally LEGACY")
+	}
+	if core.ReadPQRecord(s, gen.Config.PQMigrate.Registry, actualS).Mode != 3 || s.GetNonce(actualS) != 1 {
+		t.Fatal("sponsor bootstrap not genuine PQ_NATIVE")
+	}
+	mk := func(parent *types.Block, extra string, tx *types.Transaction, offset ...int64) (*types.Block, types.Receipts) {
+		blocks, receipts := core.GenerateChain(gen.Config, parent, engine, genDB, 1, func(_ int, b *core.BlockGen) {
+			delay := int64(2)
+			if len(offset) != 0 {
+				delay = offset[0]
+			}
+			b.OffsetTime(delay)
+			b.SetPoS()
+			b.SetExtra([]byte(extra))
