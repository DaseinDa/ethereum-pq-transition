+
+// batchesInSponsorOrder snapshots the batch set by sponsor, sponsor nonce and
+// hash. A pass that defers several batches of one sponsor then stamps them in
+// nonce order, and section 20.17 (b) retries them in that order, not in map order.
+func (p *Pool) batchesInSponsorOrder() []*batchEntry {
+	out := make([]*batchEntry, 0, len(p.batches))
+	for _, e := range p.batches {
+		out = append(out, e)
+	}
+	sort.Slice(out, func(i, j int) bool {
+		bi, _ := out[i].tx.AsPQBatch()
+		bj, _ := out[j].tx.AsPQBatch()
+		if c := bi.Sponsor.Cmp(bj.Sponsor); c != 0 {
+			return c < 0
+		}
+		if ni, nj := out[i].tx.Nonce(), out[j].tx.Nonce(); ni != nj {
+			return ni < nj
+		}
+		return out[i].tx.Hash().Cmp(out[j].tx.Hash()) < 0
+	})
+	return out
+}
