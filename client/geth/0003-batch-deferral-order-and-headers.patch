+// One reset pass that defers several batches of a sponsor stamps their retry
+// order by sponsor nonce, not by map iteration (F-31). The entries go in in
+// reverse nonce order, which map iteration keeps or rotates, so a pass in
+// map order fails this test.
+func TestBatchResetDeferralOrderFollowsSponsorNonce(t *testing.T) {
+	p, c, batch, _ := realBatchPool(t)
+	b, _ := batch.AsPQBatch()
+	const n = 6
+	for i := n - 1; i >= 0; i-- {
+		tx := batchAtNonce(t, batch, b.SponsorNonce+uint64(i))
+		p.batches[tx.Hash()] = &batchEntry{tx: tx, seen: time.Now(), pending: i == 0, admitted: true, resetReady: true}
+	}
+	c.s.SetExternalError(errors.New("reset-time state fault"))
+	p.state = c.s.Copy()
+	p.pruneBatchReset(p.head)
+	queued := p.deferredRetries()
+	if len(queued) != n {
+		t.Fatalf("deferred %d of %d batches", len(queued), n)
+	}
+	for i, d := range queued {
+		if want := b.SponsorNonce + uint64(i); d.tx.Nonce() != want {
+			t.Fatalf("retry %d has sponsor nonce %d, want %d", i, d.tx.Nonce(), want)
+		}
+	}
+}
