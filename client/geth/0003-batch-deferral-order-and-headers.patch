+// stateUnavailableChain fails every state read, so Reset defers all batches
+// through its state-unavailable branch.
+type stateUnavailableChain struct{ *componentChain }
+
+func (stateUnavailableChain) StateAt(*types.Header) (*state.StateDB, error) {
+	return nil, errors.New("reset-time state unavailable")
+}
+
+// Reset's state-unavailable branch also stamps a sponsor's batches in nonce
+// order, not in map order (F-31).
+func TestBatchResetStateUnavailableDeferralOrderFollowsSponsorNonce(t *testing.T) {
+	p, c, batch, _ := realBatchPool(t)
+	b, _ := batch.AsPQBatch()
+	const n = 6
+	for i := n - 1; i >= 0; i-- {
+		tx := batchAtNonce(t, batch, b.SponsorNonce+uint64(i))
+		p.batches[tx.Hash()] = &batchEntry{tx: tx, seen: time.Now(), pending: true, admitted: true, resetReady: true}
+	}
+	p.chain = stateUnavailableChain{c}
+	p.Reset(nil, p.head)
+	queued := p.deferredRetries()
+	if p.stateErr == nil || len(queued) != n {
+		t.Fatalf("deferred %d of %d batches", len(queued), n)
+	}
+	for i, d := range queued {
+		if want := b.SponsorNonce + uint64(i); d.tx.Nonce() != want {
+			t.Fatalf("retry %d has sponsor nonce %d, want %d", i, d.tx.Nonce(), want)
+		}
+	}
+}
