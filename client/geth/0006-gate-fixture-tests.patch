+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package core
+
+import (
+	"math/big"
+	"testing"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/consensus/beacon"
+	"github.com/ethereum/go-ethereum/consensus/ethash"
+	"github.com/ethereum/go-ethereum/core/rawdb"
+	"github.com/ethereum/go-ethereum/core/state"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/crypto"
+	"github.com/ethereum/go-ethereum/internal/pqtest"
+	"github.com/ethereum/go-ethereum/params"
+	"github.com/holiman/uint256"
+)
+
+// TestPQBatchRealGateFixtureBlockImport imports two blocks with the public C
+// gate fixture and the real native verifier. Block 1 carries a real 0x7d by the
+// fourth owner's legacy key (the attacker's enrollment of the threat model), so
+// the record the batch then overrides is the ENROLLED, migration-nonce-1 state
+// a 0x7d reaches, not a constructed pre-state. Block 2, after the first entry's
+// expiry and inside the sponsor window, carries the batch: its receipt shows
+// the expiry skip 0x0201 end to end, the owner-money paths of fee modes 3 and 1
+// settled from real C acceptance, and the open override with was_override set
+// and 10,000 of registry writes, and its gas equals the independent formula.
+func TestPQBatchRealGateFixtureBlockImport(t *testing.T) {
+	tx, now := pqtest.BatchGates(t)
+	b, _ := tx.AsPQBatch()
+	cfg := nativeTestChain()
+	cfg.ChainID = new(big.Int).Set(b.ChainID)
+	cfg.PQMigrate.FullResearch = finalTestProfile()
+	cfg.PQMigrate.FullResearch.Sunset = ^uint64(0)
+	// The research binding keeps W at its configured 365 days (at least 180), so the
+	// override window of entry 3's enrollment in block 1 is open at block 2.
+	cfg.PQMigrate.T0, cfg.PQMigrate.ReceivingTime, cfg.PQMigrate.T = now-200, now-200, now-5
+	cfg.PQMigrate.LegacySeedProofFromT0 = true
+	cfg.PQMigrate.AggregateResearch = &params.PQAggregateResearchConfig{Key: params.PQAggregateKey, VerifyGas: params.PQAggregateVerifyGas, NMax: 4, MaxTxBytes: params.PQAggregateMaxTxBytes}
+	if err := cfg.CheckConfigForkOrder(); err != nil {
+		t.Fatal(err)
+	}
+	registry := cfg.PQMigrate.Registry
+	e := b.Entries
+	pk := pqtest.SponsorPublicKey()
+	k, k1 := PQRecordSlots(b.Sponsor)
+	sponsorRecord := PQRecord{Mode: 3, AlgID: 1, MigrationNonce: 1, Commit: PQKeyCommit(1, pk)}
+	owned := new(big.Int).Mul(big.NewInt(2), big.NewInt(params.Ether))
+	alloc := types.GenesisAlloc{
+		b.Sponsor:                  {Balance: new(big.Int).Mul(big.NewInt(10), big.NewInt(params.Ether)), Code: append([]byte{0xef, 1, 1}, pk...)},
+		registry:                   {Balance: new(big.Int), Code: []byte{0}, Nonce: 1, Storage: map[common.Hash]common.Hash{k: pqRecordWord(sponsorRecord), k1: sponsorRecord.Commit}},
+		cfg.PQMigrate.FactRegistry: {Balance: new(big.Int), Code: []byte{0}, Nonce: 1},
+	}
+	for _, entry := range e {
+		alloc[entry.LegacyAddress] = types.Account{Balance: new(big.Int).Set(owned)}
+	}
+	// The real enrollment: entry 3's legacy key enrolls an attacker's ML-DSA-44 key before T.
+	key, err := crypto.HexToECDSA(pqtest.GateOwnerKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	attacker, attackerSecret := pqSeedKey(0x5a)
+	en := &types.PQEnrollTx{ChainID: cfg.ChainID, GasTipCap: big.NewInt(params.GWei), GasFeeCap: big.NewInt(10 * params.GWei), Gas: 500000, AlgID: 1, PublicKey: attacker.Bytes()}
+	en.PoPSignature = pqSignTag(t, attackerSecret, "ETH-PQ-ENROLL-POP/v1", PQEnrollmentDigest(cfg.ChainID, e[3].LegacyAddress, 0, 1, en.PublicKey))
+	hash := en.SigningHash()
+	sig, err := crypto.Sign(hash[:], key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	en.R, en.S, en.V = new(big.Int).SetBytes(sig[:32]), new(big.Int).SetBytes(sig[32:64]), new(big.Int).SetUint64(uint64(sig[64]))
+	enroll := types.NewTx(en)
+	genesis := &Genesis{Config: cfg, Timestamp: now - 20, GasLimit: 45000000, Alloc: withSystemContracts(alloc)}
+	engine := beacon.New(ethash.NewFaker())
+	db, blocks, builtReceipts := GenerateChainWithGenesis(genesis, engine, 2, func(i int, block *BlockGen) {
+		if i == 0 {
+			block.AddTx(enroll)
+		} else {
+			block.AddTx(tx)
+		}
+	})
+	defer db.Close()
+	if blocks[0].Time() >= cfg.PQMigrate.T || blocks[1].Time() != now {
+		t.Fatal("block times", blocks[0].Time(), blocks[1].Time(), now)
+	}
+	chain, err := NewBlockChain(rawdb.NewMemoryDatabase(), genesis, engine, &BlockChainConfig{ArchiveMode: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer chain.Stop()
+	if _, err := chain.InsertChain(blocks); err != nil {
+		t.Fatal("native C gate fixture import", err)
+	}
+	enrolled, err := chain.StateAt(blocks[0].Header())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if r := ReadPQRecord(enrolled, registry, e[3].LegacyAddress); r != (PQRecord{Mode: 1, AlgID: 1, EnrolledAt: blocks[0].Time(), MigrationNonce: 1, Commit: PQKeyCommit(1, en.PublicKey)}) {
+		t.Fatalf("0x7d did not reach the ENROLLED nonce-1 record: %+v", r)
+	}
+	s, err := chain.StateAt(blocks[1].Header())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if s.GetNonce(b.Sponsor) != b.SponsorNonce+1 {
+		t.Fatal("import did not consume sponsor nonce")
+	}
+	// One skip, two frozen recoveries (44,200 each) and one override (10,000).
+	wantGas := batchExpectedGas(t, b, 2*44200+10000)
+	for _, receipts := range []types.Receipts{builtReceipts[1], chain.GetReceiptsByHash(blocks[1].Hash())} {
+		if len(receipts) != 1 {
+			t.Fatal("receipt count", len(receipts))
+		}
+		receipt := receipts[0]
+		if receipt.Type != types.PQBatchTxType || receipt.Status != types.ReceiptStatusSuccessful || receipt.GasUsed != wantGas || receipt.CumulativeGasUsed != wantGas || len(receipt.Logs) != 4 {
+			t.Fatalf("receipt: %#v, want gas %d", receipt, wantGas)
+		}
+		assertBatchLog(t, receipt.Logs[0], registry, e[0], 0, 0x0201, 0, false, false)
+		assertBatchLog(t, receipt.Logs[1], registry, e[1], 1, 0, 1, false, false)
+		assertBatchLog(t, receipt.Logs[2], registry, e[2], 2, 0, 1, false, false)
+		assertBatchLog(t, receipt.Logs[3], registry, e[3], 3, 0, 2, true, false)
+	}
+	if blocks[1].GasUsed() != wantGas {
+		t.Fatal("header gas", blocks[1].GasUsed(), wantGas)
+	}
+	if r := ReadPQRecord(s, registry, e[0].LegacyAddress); r != (PQRecord{}) {
+		t.Fatalf("expired entry wrote its owner: %+v", r)
+	}
+	for i := 1; i <= 2; i++ {
+		if r := ReadPQRecord(s, registry, e[i].LegacyAddress); r != (PQRecord{Mode: 2, AlgID: 1, MigrationNonce: 1, Commit: e[i].PQPKCommit}) {
+			t.Fatalf("entry %d record: %+v", i, r)
+		}
+	}
+	if r := ReadPQRecord(s, registry, e[3].LegacyAddress); r != (PQRecord{Mode: 2, AlgID: 1, EnrolledAt: blocks[0].Time(), MigrationNonce: 2, Commit: e[3].PQPKCommit}) {
+		t.Fatalf("override record: %+v", r)
+	}
+	// Owner money: fee mode 3 and fee mode 1 naming this sponsor reimburse
+	// min(max_account_fee, balance) before fee_auth_until; fee mode 2 pays nothing.
+	balance := func(st *state.StateDB, a common.Address) *uint256.Int { return new(uint256.Int).Set(st.GetBalance(a)) }
+	fee1, fee2 := uint256.MustFromBig(e[1].MaxAccountFee), uint256.MustFromBig(e[2].MaxAccountFee)
+	if balance(s, e[0].LegacyAddress).Cmp(uint256.MustFromBig(owned)) != 0 || balance(s, e[3].LegacyAddress).Cmp(balance(enrolled, e[3].LegacyAddress)) != 0 {
+		t.Fatal("fee mode 2 owners paid")
+	}
+	if new(uint256.Int).Sub(uint256.MustFromBig(owned), balance(s, e[1].LegacyAddress)).Cmp(fee1) != 0 || new(uint256.Int).Sub(uint256.MustFromBig(owned), balance(s, e[2].LegacyAddress)).Cmp(fee2) != 0 {
+		t.Fatal("owner reimbursements", balance(s, e[1].LegacyAddress), balance(s, e[2].LegacyAddress))
+	}
+	price := new(big.Int).Add(blocks[1].BaseFee(), b.GasTipCap)
+	charge := new(uint256.Int).Mul(uint256.NewInt(wantGas), uint256.MustFromBig(price))
+	wantSponsor := new(uint256.Int).Sub(balance(enrolled, b.Sponsor), charge)
+	wantSponsor.Add(wantSponsor, fee1)
+	wantSponsor.Add(wantSponsor, fee2)
+	if balance(s, b.Sponsor).Cmp(wantSponsor) != 0 {
+		t.Fatal("sponsor balance", balance(s, b.Sponsor), wantSponsor)
+	}
+	t.Logf("real C gate fixture: carrier=%d bytes, gas=%d, reimbursed %s and %s wei", len(b.ProofCarrier.Proof), wantGas, fee1, fee2)
+}
