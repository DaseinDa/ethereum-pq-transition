+++ b/internal/pqtest/gates.go
@@ -0,0 +1,82 @@
+// Copyright 2026 PQ-Migrate contributors
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+package pqtest
+
+import (
+	"bytes"
+	"encoding/binary"
+	"math/big"
+	"os"
+	"testing"
+
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/crypto"
+	"github.com/ethereum/go-ethereum/params"
+)
+
+// GateOwnerKey is the secp256k1 key of the gate fixture's fourth owner: the
+// public BIP-39 vector (abandon x11 + about, empty passphrase) at
+// m/44'/60'/0'/0/7. It is public test data, never a real key, and it signs the
+// real 0x7d whose ENROLLED record the override case of the fixture starts from.
+const GateOwnerKey = "dfb0930bcb8f6ca83296c1870e941998c641d3d0d413013c890b8b255dd537b5"
+
+// BatchGates returns the shipped public C gate fixture in a freshly signed
+// carrier. Its four owners belong to one public vector: entry 0 (fee mode 2)
+// expires before the other three, entry 1 is in fee mode 3, entry 2 is in fee
+// mode 1 naming the test sponsor, and entry 3 (fee mode 2) is bound to
+// migration nonce 1, the nonce a 0x7d enrollment leaves. The sponsor window
+// ends at the latest expiry, and the returned timestamp lies after entry 0's
+// expiry and before the others'. This is a fixture replay for component tests,
+// not a live batch or a claim that an expired proof is live.
+func BatchGates(t *testing.T) (*types.Transaction, uint64) {
+	t.Helper()
+	carrier, statement := os.Getenv("PQ_BATCH_GATES_CARRIER"), os.Getenv("PQ_BATCH_GATES_STATEMENT")
+	if carrier == "" || statement == "" {
+		t.Skip("requires the packaged public C gate fixture")
+	}
+	proof, err := os.ReadFile(carrier)
+	if err != nil {
+		t.Fatal(err)
+	}
+	pi, err := os.ReadFile(statement)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(pi) != 798 || binary.BigEndian.Uint16(pi[:2]) != 4 || binary.BigEndian.Uint32(pi[2:6]) != params.PQFinalVersion {
+		t.Fatal("wrong four-owner statement")
+	}
+	pk := SponsorPublicKey()
+	b := &types.PQBatchTx{
+		ChainID:   new(big.Int).SetBytes(pi[6:38]),
+		Sponsor:   common.BytesToAddress(crypto.Keccak256([]byte("PQ-ADDR"), []byte{1}, pk)[12:]),
+		GasTipCap: big.NewInt(params.GWei), GasFeeCap: big.NewInt(10 * params.GWei), Gas: 16000000,
+		VerifierVersion: params.PQFinalVersion, ProofCarrier: types.PQMigrationCarrier{Proof: proof},
+	}
+	for i := 0; i < 4; i++ {
+		p := pi[6+198*i : 6+198*(i+1)]
+		e := types.PQBatchEntry{LegacyAddress: common.BytesToAddress(p[64:84]), MigrationNonce: binary.BigEndian.Uint64(p[84:92]),
+			AlgID: p[92], PQPKCommit: common.BytesToHash(p[93:125]), Expiry: binary.BigEndian.Uint64(p[129:137]),
+			MaxAccountFee: new(big.Int).SetBytes(p[137:169]), FeeMode: p[169], FeeSponsor: common.BytesToAddress(p[170:190]), FeeAuthUntil: binary.BigEndian.Uint64(p[190:198])}
+		if !bytes.Equal(e.Migration(b.ChainID, b.VerifierVersion).PublicInputs(), p) {
+			t.Fatal("unexpected public owner fixture")
+		}
+		b.Entries = append(b.Entries, e)
+		b.SponsorValidUntil = max(b.SponsorValidUntil, e.Expiry)
+	}
+	e := b.Entries
+	first, rest := e[0].Expiry, e[1].Expiry
+	layout := e[0].FeeMode == 2 && e[0].MigrationNonce == 0 && first+3600 < rest &&
+		e[1].FeeMode == 3 && e[1].MigrationNonce == 0 && e[1].MaxAccountFee.Sign() > 0 && e[1].FeeAuthUntil == rest &&
+		e[2].FeeMode == 1 && e[2].MigrationNonce == 0 && e[2].MaxAccountFee.Sign() > 0 && e[2].FeeSponsor == b.Sponsor && e[2].FeeAuthUntil == rest && e[2].Expiry == rest &&
+		e[3].FeeMode == 2 && e[3].MigrationNonce == 1 && e[3].Expiry == rest
+	if !layout {
+		t.Fatal("unexpected gate fixture layout")
+	}
+	key, err := crypto.HexToECDSA(GateOwnerKey)
+	if err != nil || crypto.PubkeyToAddress(key.PublicKey) != e[3].LegacyAddress {
+		t.Fatal("gate fixture owner key", err)
+	}
+	return SignBatch(t, b), first + 1800
+}
